    # pc "Got it."
    pc "Capito."

# game/Scenes/Work/workdressbetter.rpy:18
translate italian workdressbetter_b643f08e:

    # bs "Good. Let's get to work."
    bs "Bene. Mettiamoci al lavoro."

# game/Scenes/Work/workdressbetter.rpy:19
translate italian workdressbetter_8c43722c:

    # "The rest of the day passes uneventfully. Until it's time to leave for the day."
    "Il resto della giornata trascorre senza intoppi. Finché non è ora di andare via."

