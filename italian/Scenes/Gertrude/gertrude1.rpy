# game/Scenes/Gertrude/gertrude1.rpy:12
translate italian gertrude1_b8ab60df:

    # sc "I had a kind of personal question for you today."
    sc "Oggi avevo una domanda un po’ personale da farti."

# game/Scenes/Gertrude/gertrude1.rpy:13
translate italian gertrude1_46f5a669:

    # pc "Okay, go ahead."
    pc "Ok, dai, chiedi pure."

# game/Scenes/Gertrude/gertrude1.rpy:14
translate italian gertrude1_f61c5e45:

    # sc "If you don't want to answer it, you don't have to."
    sc "Se non vuoi rispondere, non sei obbligata."

# game/Scenes/Gertrude/gertrude1.rpy:15
translate italian gertrude1_e2305d2c:

    # pc "Just ask."
    pc "Chiedi pure."

# game/Scenes/Gertrude/gertrude1.rpy:16
translate italian gertrude1_0cd2dbde:

    # sc "Are you sexually active?"
    sc "Hai una vita sessuale attiva?"

# game/Scenes/Gertrude/gertrude1.rpy:20
translate italian gertrude1_7b5b8bbb:

    # sc "I think that most people would say that."
    sc "Penso che la maggior parte delle persone risponderebbe di sì."

# game/Scenes/Gertrude/gertrude1.rpy:23
translate italian gertrude1_ebf7eccb:

    # sc "Good, I'm glad."
    sc "Bene, ne sono felice."

# game/Scenes/Gertrude/gertrude1.rpy:26
translate italian gertrude1_13162311:

    # sc "I'm sorry, I'm not trying to get involved in your personal life."
    sc "Scusa, non sto cercando di intromettermi nella tua vita privata."

# game/Scenes/Gertrude/gertrude1.rpy:27
translate italian gertrude1_dda22b21:

    # sc "But I do think that it is healthy to be sexually active at your age."
    sc "Ma penso davvero che sia salutare avere una vita sessuale attiva alla tua età."

# game/Scenes/Gertrude/gertrude1.rpy:29
translate italian gertrude1_5a649775:

    # sc "College is the perfect opportunity to experiment."
    sc "L’università è l’occasione perfetta per sperimentare."

# game/Scenes/Gertrude/gertrude1.rpy:30
translate italian gertrude1_b8b829eb:

    # sc "To figure out what you like and don't like."
    sc "Per capire cosa ti piace e cosa no."

# game/Scenes/Gertrude/gertrude1.rpy:32
translate italian gertrude1_8594ced1:

    # sc "You don't want to look back later in life and wonder about the things you missed out on."
    sc "Non vorrai mica guardarti indietro più avanti nella vita e chiederti quali sono le cose che ti sei persa."

# game/Scenes/Gertrude/gertrude1.rpy:36
translate italian gertrude1_639c8f25:

    # sc "Good."
    sc "Bene."

# game/Scenes/Gertrude/gertrude1.rpy:39
translate italian gertrude1_070c7224:

    # sc "As long as you're safe about it, yes."
    sc "A patto che tu stia attenta a proteggerti, sì."

# game/Scenes/Gertrude/gertrude1.rpy:40
translate italian gertrude1_9fc07896:

    # sc "I think that you should have lots of sex with a variety of people."
    sc "Penso che dovresti fare tanto sesso con persone diverse."

# game/Scenes/Gertrude/gertrude1.rpy:41
translate italian gertrude1_6bec941c:

    # sc "I believe that it gives you a healthier mindset when you're older, like me."
    sc "Credo che ti dia una mentalità più sana quando sarai più grande, come me."

# game/Scenes/Gertrude/gertrude1.rpy:43
translate italian gertrude1_a0193afd:

    # sc "Anyway, that is enough of this talk."
    sc "Comunque, basta con questa chiacchierata."

# game/Scenes/Gertrude/gertrude1.rpy:44
translate italian gertrude1_e11ba8d0:

    # sc "You should get to class, right?"
    sc "Dovresti andare a lezione, giusto?"

# game/Scenes/Gertrude/gertrude1.rpy:46
translate italian gertrude1_9f00d552:

    # pc "Yeah, I guess so."
    pc "Sì, immagino di sì."

# game/Scenes/Gertrude/gertrude1.rpy:47
translate italian gertrude1_8f9b25a7:

    # sc "Okay, well I'll see you next time, [pcname]."
    sc "Ok, beh, ci vediamo la prossima volta, [pcname]."

# game/Scenes/Gertrude/gertrude1.rpy:48
translate italian gertrude1_850ead77:

    # pc "Okay. Bye, Gertrude."
    pc "Ok. Ciao, Gertrude."

