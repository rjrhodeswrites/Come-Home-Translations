# game/Scenes/Tammy/TammyMMA/tammymma.rpy:17
translate italian tammymmanormal_55eb3e45:

    # tm "All right! I'm glad you came. Let's get to business."
    tm "Va bene! Sono contento che tu sia venuto. Mettiamoci al lavoro."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:18
translate italian tammymmanormal_095f6c6f:

    # tm "We're going to start with some stand-up. Get you started on the base punching and kicking technique."
    tm "Inizieremo con un po’ di posizione in piedi. Per farti prendere confidenza con le tecniche di base di pugni e calci."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:19
translate italian tammymmanormal_bccaba74:

    # pc "You're going to punch me, aren't you?"
    pc "Mi darai un pugno, vero?"

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:21
translate italian tammymmanormal_e526c3d8:

    # tm "Oh definitely."
    tm "Oh, sicuramente."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:23
translate italian tammymmanormal_98c55581:

    # "I get up into the ring with Tammy and she demonstrates punching."
    "Salgo sul ring con Tammy e lei mi mostra come si sferra un pugno."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:24
translate italian tammymmanormal_65f9479a:

    # "I try to block, but I just don't have the motions down yet."
    "Provo a parare, ma non ho ancora imparato bene i movimenti."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:26
translate italian tammymmanormal_295f5a57:

    # "And kicking."
    "E i calci."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:27
translate italian tammymmanormal_70863c7f:

    # "It hurts, but I can tell she's not going full-strength."
    "Fa male, ma capisco che non sta usando tutta la sua forza."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:29
translate italian tammymmanormal_8aa64221:

    # "Then she gives me a chance to try to hit her."
    "Poi mi dà la possibilità di provare a colpirla."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:30
translate italian tammymmanormal_90068145:

    # "But she blocks every punch I throw."
    "Ma lei para ogni pugno che sferro."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:32
translate italian tammymmanormal_dd5027d0:

    # tm "Focus on technique. Don't worry about actually hitting me, just make sure that your movements are correct."
    tm "Concentrati sulla tecnica. Non preoccuparti di colpirmi davvero, assicurati solo che i tuoi movimenti siano corretti."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:35
translate italian tammymmanormal_bfe308ae:

    # "Tammy and I spar in the ring for a while."
    "Io e Tammy ci alleniamo sul ring per un po’."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:39
translate italian tammymmanormal_0bc42d9a:

    # tm "You did good for a first session."
    tm "Sei andata bene per essere la prima sessione."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:42
translate italian tammymmanormal_a242518d:

    # tm "Good job. Keep training with me and you'll be a fighting machine in no time."
    tm "Ottimo lavoro. Continua ad allenarti con me e diventerai una macchina da combattimento in men che non si dica."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:45
translate italian tammymmanormal_cc85c375:

    # "Now I need to hurry and get to school."
    "Ora devo sbrigarmi ad andare a scuola."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:48
translate italian tammymmanormal_7844d429:

    # tm "Want to hit the showers with me?"
    tm "Ti va di fare una doccia con me?"

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:52
translate italian tammymmanormal_f7e04aed:

    # "I feel sore and tired, but it was fun and I did learn a lot."
    "Mi sento indolenzito e stanco, ma è stato divertente e ho imparato molto."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:53
translate italian tammymmanormal_37ff6d3e:

    # "We say our goodbyes and go our separate ways."
    "Ci salutiamo e prendiamo strade diverse."

