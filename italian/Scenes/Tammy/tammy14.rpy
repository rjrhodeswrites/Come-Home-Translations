# game/Scenes/Tammy/tammy14.rpy:171
translate italian tammy14_e8b49386:

    # "It doesn't take long, lying like that, for Tammy to fall asleep."
    "Non ci vuole molto, sdraiati così, perché Tammy si addormenti."

# game/Scenes/Tammy/tammy14.rpy:172
translate italian tammy14_815d66b7:

    # "And as soon as she's asleep, she immediately begins snoring loudly."
    "E non appena si addormenta, inizia subito a russare rumorosamente."

# game/Scenes/Tammy/tammy14.rpy:175
translate italian tammy14_055d080f:

    # ss "Dang, she's loud, huh?"
    ss "Cavolo, russa forte, eh?"

# game/Scenes/Tammy/tammy14.rpy:176
translate italian tammy14_593f6724:

    # "I nod, trying to stay quiet."
    "Annuisco, cercando di non fare rumore."

# game/Scenes/Tammy/tammy14.rpy:177
translate italian tammy14_536bf33b:

    # ss "When she's really tired like this, she passes out hard. You could shake her and she's not going to wake up."
    ss "Quando è davvero stanca come adesso, crolla profondamente. Potresti scuoterla e non si sveglierebbe comunque."

# game/Scenes/Tammy/tammy14.rpy:178
translate italian tammy14_20e84dbf:

    # pc "She deserves a good night sleep."
    pc "Si merita una bella dormita."

# game/Scenes/Tammy/tammy14.rpy:179
translate italian tammy14_e51a7dc2:

    # ss "Yeah. Thanks for being a good boyfriend tonight, [bro]."
    ss "Sì. Grazie per essere stato un bravo fidanzato stasera, [bro]."

# game/Scenes/Tammy/tammy14.rpy:180
translate italian tammy14_a248948f:

    # pc "Of course."
    pc "Ma certo."

# game/Scenes/Tammy/tammy14.rpy:181
translate italian tammy14_53a16996:

    # ss "Love you."
    ss "Ti amo."

# game/Scenes/Tammy/tammy14.rpy:182
translate italian tammy14_3213fe29:

    # pc "Love you too, [sis]."
    pc "Ti amo anch’io, [sis]."

# game/Scenes/Tammy/tammy14.rpy:185
translate italian tammy14_87d1006f:

    # "Suzy lies back down again and falls asleep."
    "Suzy si sdraia di nuovo e si addormenta."

# game/Scenes/Tammy/tammy14.rpy:188
translate italian tammy14_da5d00b9:

    # "Shortly after, despite Tammy's loud snoring, I fall asleep too."
    "Poco dopo, nonostante il forte russare di Tammy, mi addormento anch’io."

# game/Scenes/Tammy/tammy14.rpy:189
translate italian tammy14_2af8e2e3:

    # "I have great dreams all night, but somehow they don't even compare to my waking life."
    "Faccio sogni meravigliosi per tutta la notte, ma in qualche modo non reggono il confronto con la mia vita da sveglia."

# game/Scenes/Tammy/tammy14.rpy:192
translate italian tammy14_d8050fd9:

    # "I must have slept hard as well, because I don't wake up through the entire night."
    "Devo aver dormito profondamente anch’io, perché non mi sveglio per tutta la notte."

# game/Scenes/Tammy/tammy14.rpy:195
translate italian tammy14_6e97274e:

    # "And when I look around in the morning, they are both gone."
    "E quando mi guardo intorno al mattino, sono entrambe sparite."

# game/Scenes/Tammy/tammy14.rpy:201
translate italian tammy14_d1a14932:

    # "I get up and go to the bathroom, then walk downstairs."
    "Mi alzo e vado in bagno, poi scendo al piano di sotto."

# game/Scenes/Tammy/tammy14.rpy:204
translate italian tammy14_7279822b:

    # "In the dining room, Suzy greets me with a kiss."
    "In sala da pranzo, Suzy mi saluta con un bacio."

# game/Scenes/Tammy/tammy14.rpy:205
translate italian tammy14_ce46d3ed:

    # ss "There's some breakfast in the kitchen if you want any. Mom made way too much before she left."
    ss "C’è un po’ di colazione in cucina, se ne vuoi un po’. Mamma ne ha preparata decisamente troppa prima di uscire."

# game/Scenes/Tammy/tammy14.rpy:206
translate italian tammy14_03e500eb:

    # pc "Where's Tammy?"
    pc "Dov’è Tammy?"

# game/Scenes/Tammy/tammy14.rpy:207
translate italian tammy14_6a080cce:

    # ss "She had to leave early for work. I doubt we'll be seeing her for breakfast very often."
    ss "È dovuta uscire presto per andare al lavoro. Dubito che la vedremo spesso a colazione."

# game/Scenes/Tammy/tammy14.rpy:208
translate italian tammy14_34f75a54:

    # pc "Oh, okay."
    pc "Oh, va bene."

# game/Scenes/Tammy/tammy14.rpy:211
translate italian tammy14_eef7b49f:

    # ss "Did you want to eat breakfast with me... or maybe mess around some?"
    ss "Volevi fare colazione con me... o magari divertirti un po’?"

# game/Scenes/Tammy/tammy14.rpy:215
translate italian tammy14_6ae50746:

    # ss "Oh, alright then."
    ss "Oh, va bene allora."

# game/Scenes/Tammy/tammy14.rpy:218
translate italian tammy14_b9e9893b:

    # ss "I was hoping you would say that."
    ss "Speravo che lo dicessi."

# game/Scenes/Tammy/tammy14.rpy:222
translate italian tammy14_ca91b2cf:

    # ss "Oh, okay. See you later then, [bro]."
    ss "Oh, va bene. Ci vediamo più tardi allora, [bro]."

translate italian strings:

    # game/Scenes/Tammy/tammy14.rpy:2
    old "After you have gone out on a few dates with Tammy and Suzy together, including going to the ice-cream parlor,"
    new "Dopo che sarai uscito un paio di volte con Tammy e Suzy insieme, compreso un giro in gelateria,"

    # game/Scenes/Tammy/tammy14.rpy:3
    old "and you have talked to them about Tammy moving out of her parents house, this will happen automatically at home at night."
    new "e avrai parlato con loro del fatto che Tammy si trasferirà fuori dalla casa dei suoi genitori, questo accadrà automaticamente a casa la sera."

