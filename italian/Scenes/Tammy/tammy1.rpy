    # pc "Nothing for me today. I actually just came in to chat with you."
    pc "Niente per me oggi. In realtà sono solo passato per fare due chiacchiere con te."

# game/Scenes/Tammy/tammy1.rpy:16
translate italian tammy1_9e4a79ed:

    # tm "Oh yeah?"
    tm "Ah sì?"

# game/Scenes/Tammy/tammy1.rpy:17
