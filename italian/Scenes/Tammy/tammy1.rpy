translate italian tammy1_e9bdc9df:

    # tm "I've been doing really good actually."
    tm "In realtà sto davvero bene."

# game/Scenes/Tammy/tammy1.rpy:19
translate italian tammy1_d0fae397:

    # tm "Been training hard for my next fight."
    tm "Mi sto allenando duramente per il mio prossimo incontro."

# game/Scenes/Tammy/tammy1.rpy:20
translate italian tammy1_a2fac566:

    # pc "Fight?"
    pc "Incontro?"

# game/Scenes/Tammy/tammy1.rpy:22
translate italian tammy1_1b5b2325:

    # tm "Yeah, MMA man. I love it."
    tm "Sì, MMA, amico. Lo adoro."

# game/Scenes/Tammy/tammy1.rpy:24
translate italian tammy1_f58a7e3a:

    # tm "Hey, you should come work out with me sometime."
    tm "Ehi, dovresti venire ad allenarti con me qualche volta."

# game/Scenes/Tammy/tammy1.rpy:27
translate italian tammy1_dc1221bf:

    # tm "Awesome!"
    tm "Fantastico!"

# game/Scenes/Tammy/tammy1.rpy:31
translate italian tammy1_30e63ffa:

    # tm "Oh come on now, don't be a pussy."
    tm "Oh, dai, non fare la femminuccia."

# game/Scenes/Tammy/tammy1.rpy:32
translate italian tammy1_273bbe71:

    # tm "Just give it a try. For me?"
    tm "Prova almeno una volta. Per me?"

# game/Scenes/Tammy/tammy1.rpy:33
translate italian tammy1_2ad4955b:

    # pc "All right, I guess I could use a workout every once in a while."
    pc "Va bene, immagino che un po’ di allenamento ogni tanto mi farebbe bene."

# game/Scenes/Tammy/tammy1.rpy:35
translate italian tammy1_5d2aa8aa:

    # tm "We all need it."
    tm "Ne abbiamo tutti bisogno."

# game/Scenes/Tammy/tammy1.rpy:36
translate italian tammy1_a804b563:

    # tm "So the place I work out at isn't your normal gym."
    tm "Il posto dove mi alleno non è la solita palestra."

# game/Scenes/Tammy/tammy1.rpy:37
translate italian tammy1_7e8b0ee1:

    # tm "It's the boxing club over on the west side of town."
    tm "È il club di boxe nella zona ovest della città."

# game/Scenes/Tammy/tammy1.rpy:38
translate italian tammy1_40dda578:

    # pc "Isn't that place pretty rough?"
    pc "Ma quel posto non è un po’ troppo tosto?"

# game/Scenes/Tammy/tammy1.rpy:39
translate italian tammy1_6f117f59:

    # tm "It can be. It's a bunch of high-testosterone guys who like to fight."
    tm "A volte sì. È pieno di ragazzi con il testosterone alle stelle a cui piace combattere."

# game/Scenes/Tammy/tammy1.rpy:40
translate italian tammy1_851c2c59:

    # tm "But if you go over there with me, there won't be a problem."
    tm "Ma se ci vai con me, non ci saranno problemi."

# game/Scenes/Tammy/tammy1.rpy:41
translate italian tammy1_c0350021:

    # tm "I'm there in the afternoon every day."
    tm "Ci vado tutti i pomeriggi."

# game/Scenes/Tammy/tammy1.rpy:42
translate italian tammy1_e3da760c:

    # pc "I work in the afternoons."
    pc "Lavoro nel pomeriggio."

# game/Scenes/Tammy/tammy1.rpy:43
translate italian tammy1_b79833dd:

    # tm "Then come on the weekend."
    tm "Allora vieni nel fine settimana."

# game/Scenes/Tammy/tammy1.rpy:44
translate italian tammy1_f14b89df:

    # pc "I guess I could do that."
    pc "Immagino di poterlo fare."

# game/Scenes/Tammy/tammy1.rpy:45
translate italian tammy1_26cf52a7:

    # tm "Great! I can't wait to see you there. It's going to be so much fun."
    tm "Fantastico! Non vedo l’ora di vederti lì. Sarà davvero divertente."

# game/Scenes/Tammy/tammy1.rpy:46
translate italian tammy1_a5034e2d:

    # pc "You really think working out is fun?"
    pc "Pensi davvero che allenarsi sia divertente?"

# game/Scenes/Tammy/tammy1.rpy:48
translate italian tammy1_fca9b16a:

    # tm "It can be. Especially with me."
    tm "Può esserlo. Soprattutto con me."

# game/Scenes/Tammy/tammy1.rpy:49
translate italian tammy1_195d6734:

    # pc "All right, I'm sold."
    pc "Va bene, mi hai convinto."

# game/Scenes/Tammy/tammy1.rpy:50
translate italian tammy1_4047c36d:

    # "Tammy and I chit-chat for a little bit longer, then a crowd of customers comes in and she has to get back to work."
    "Io e Tammy chiacchieriamo ancora un po', poi entra una folla di clienti e lei deve tornare al lavoro."

# game/Scenes/Tammy/tammy1.rpy:51
translate italian tammy1_c0781de6:

    # "I tell her goodbye and head out to my car."
    "Le dico ciao e mi dirigo verso la mia auto."

# game/Scenes/Tammy/tammy1.rpy:52
translate italian tammy1_13dba231:

    # "Working out with Tammy could be fun. I could be in better shape anyway."
    "Allenarmi con Tammy potrebbe essere divertente. E comunque potrei stare più in forma."

# game/Scenes/Tammy/tammy1.rpy:53
translate italian tammy1_6f40d8bb:

    # "I should check out that boxing club in the afternoon on the weekend sometime."
    "Dovrei dare un'occhiata a quel club di boxe nel pomeriggio di un fine settimana, prima o poi."

# game/Scenes/Tammy/tammy1.rpy:57
translate italian tammy1_7a3c9e8d:

    # "For now, I have to go to class."
    "Per ora, devo andare a lezione."

