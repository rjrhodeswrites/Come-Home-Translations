# game/Scenes/Tammy/tammy3.rpy:15
translate italian tammy3_57a68160:

    # tm "Today we're going to learn about grappling."
    tm "Oggi impareremo il grappling."

# game/Scenes/Tammy/tammy3.rpy:16
translate italian tammy3_8bbac2a1:

    # tm "In a fight, 90 percent of the time the two combatants will end up on the mat."
    tm "In un combattimento, nel 90% dei casi i due combattenti finiscono a terra."

# game/Scenes/Tammy/tammy3.rpy:17
translate italian tammy3_ac91ad7e:

    # tm "When that happens, you need to know how to grapple, or you'll get a limb broken or get choked out."
    tm "Quando succede, devi sapere come lottare a terra, altrimenti ti romperanno un arto o ti metteranno in una presa di strangolamento."

# game/Scenes/Tammy/tammy3.rpy:18
translate italian tammy3_d672444d:

    # pc "What if I just don't go to the ground."
    pc "E se semplicemente non andassi a terra?"

# game/Scenes/Tammy/tammy3.rpy:19
translate italian tammy3_ad2a727b:

    # tm "Not an option."
    tm "Non è un'opzione."

# game/Scenes/Tammy/tammy3.rpy:20
translate italian tammy3_3b2e0784:

    # pc "Sure it is, if I don't want you to take me to the ground--"
    pc "Certo che lo è, se non voglio che tu mi porti a terra..."

# game/Scenes/Tammy/tammy3.rpy:23
translate italian tammy3_d5995587:

    # "What was I saying? All thought is knocked out of my mind as Tammy slams into me like a bullet."
    "Cosa stavo dicendo? Ogni pensiero mi svanisce dalla mente quando Tammy mi si scaglia addosso come un proiettile."

# game/Scenes/Tammy/tammy3.rpy:24
translate italian tammy3_6c3dcce2:

    # "I feel myself falling backwards."
    "Sento che sto cadendo all’indietro."

# game/Scenes/Tammy/tammy3.rpy:27
translate italian tammy3_2f96182c:

    # "Then I hit the mat hard. Tammy is on top of me in an instant."
    "Poi sbatto violentemente sul tappeto. Tammy mi è addosso in un istante."

# game/Scenes/Tammy/tammy3.rpy:28
translate italian tammy3_c46fa0c1:

    # pc "Ouch."
    pc "Ahi."

# game/Scenes/Tammy/tammy3.rpy:29
translate italian tammy3_cd6347a1:

    # tm "Now you're on the ground and you can't do anything."
    tm "Ora sei a terra e non puoi fare nulla."

# game/Scenes/Tammy/tammy3.rpy:32
translate italian tammy3_dae4a999:

    # "I attempt to push her off me, but I can't get any leverage from the position I'm in."
    "Provo a spingerla via da me, ma non riesco a fare leva dalla posizione in cui mi trovo."

# game/Scenes/Tammy/tammy3.rpy:33
translate italian tammy3_81be8aeb:

    # tm "Not going to happen."
    tm "Non succederà."

# game/Scenes/Tammy/tammy3.rpy:35
translate italian tammy3_a4fdb823:

    # tm "Good, I'm glad you understand."
    tm "Bene, sono contenta che tu capisca."

# game/Scenes/Tammy/tammy3.rpy:37
translate italian tammy3_03220617:

    # tm "Focus. Pretend I'm a 200-pound hairy man."
    tm "Concentrati. Immagina che io sia un uomo peloso di 200 libbre."

# game/Scenes/Tammy/tammy3.rpy:38
translate italian tammy3_6d1ff706:

    # pc "I'd rather not."
    pc "Preferirei di no."

# game/Scenes/Tammy/tammy3.rpy:39
translate italian tammy3_938b0434:

    # tm "This position is called a full mount."
    tm "Questa posizione si chiama «full mount»."

# game/Scenes/Tammy/tammy3.rpy:40
translate italian tammy3_ba765fb2:

    # tm "I have my knees bracing myself on both sides of your body and I keep your back pressed against the mat."
    tm "Ho le ginocchia che mi sostengono su entrambi i lati del tuo corpo e ti tengo la schiena premuta contro il tappeto."

# game/Scenes/Tammy/tammy3.rpy:41
translate italian tammy3_c6c5a568:

    # tm "It negates all of your strength and puts me in a position where I can do pretty much whatever I want."
    tm "Questo annulla tutta la tua forza e mi mette in una posizione in cui posso fare praticamente tutto quello che voglio."

# game/Scenes/Tammy/tammy3.rpy:44
translate italian tammy3_04908dac:

    # tm "See. Nothing you can do to stop me."
    tm "Vedi? Non c’è niente che tu possa fare per fermarmi."

# game/Scenes/Tammy/tammy3.rpy:47
translate italian tammy3_d9fe7a04:

    # tm "I'm a 200-pound hairy man, remember?"
    tm "Sono un uomo peloso di 200 libbre, ricordi?"

# game/Scenes/Tammy/tammy3.rpy:48
translate italian tammy3_7c4a85b3:

    # pc "My imagination is not that good."
    pc "La mia immaginazione non è così fervida."

# game/Scenes/Tammy/tammy3.rpy:50
translate italian tammy3_65ea559e:

    # tm "Sorry, you're right. I'll focus on the fighting."
    tm "Scusa, hai ragione. Mi concentrerò sul combattimento."

# game/Scenes/Tammy/tammy3.rpy:53
translate italian tammy3_9e2865cc:

    # tm "Okay, let's switch positions now. You're on top and I'm on bottom."
    tm "Ok, ora cambiamo posizione. Tu stai sopra e io sotto."

# game/Scenes/Tammy/tammy3.rpy:56
translate italian tammy3_90afe576:

    # "She lies down on her back and allows me to get on top of her."
    "Lei si sdraia sulla schiena e mi permette di mettermi sopra di lei."

# game/Scenes/Tammy/tammy3.rpy:57
translate italian tammy3_c97236f5:

    # tm "You can use your full weight, it's okay. I can take it."
    tm "Puoi usare tutto il tuo peso, va bene. Ce la faccio."

# game/Scenes/Tammy/tammy3.rpy:58
translate italian tammy3_66eb4b07:

    # tm "Okay, now I want you to do your best to hold me in this position and I'll show you how to escape it."
    tm "Ok, ora voglio che tu faccia del tuo meglio per tenermi in questa posizione e io ti mostrerò come liberarti."

# game/Scenes/Tammy/tammy3.rpy:61
translate italian tammy3_d4c215db:

    # "She grabs my arm and then suddenly slams her hips upwards."
    "Mi afferra il braccio e poi all’improvviso spinge i fianchi verso l’alto."

# game/Scenes/Tammy/tammy3.rpy:64
translate italian tammy3_b72fcb07:

    # "Then she rolls, knocking me onto my back once again."
    "Poi rotola, facendomi cadere di nuovo sulla schiena."

# game/Scenes/Tammy/tammy3.rpy:65
translate italian tammy3_d9c1adb2:

    # tm "See? Easy."
    tm "Visto? Facile."

# game/Scenes/Tammy/tammy3.rpy:66
translate italian tammy3_6a40f515:

    # tm "You just grab the arm to stop the person on top from posting up with it."
    tm "Basta afferrare il braccio per impedire alla persona sopra di fare leva con esso."

# game/Scenes/Tammy/tammy3.rpy:67
translate italian tammy3_46422fcf:

    # tm "You slam your hips upwards to create space, then roll."
    tm "Spingi i fianchi verso l’alto per creare spazio, poi rotola."

# game/Scenes/Tammy/tammy3.rpy:68
translate italian tammy3_e870d3d9:

    # tm "Got it?"
    tm "Capito?"

# game/Scenes/Tammy/tammy3.rpy:69
translate italian tammy3_1e770403:

    # pc "I think so."
    pc "Credo di sì."

# game/Scenes/Tammy/tammy3.rpy:70
translate italian tammy3_d4d7a636:

    # tm "Let's practice."
    tm "Esercitiamoci."

# game/Scenes/Tammy/tammy3.rpy:73
translate italian tammy3_72164a62:

    # "We return to the previous position."
    "Torniamo alla posizione precedente."

# game/Scenes/Tammy/tammy3.rpy:74
translate italian tammy3_a8e28fcc:

    # "Then I do what she said. I grab her arm and slam my hips upwards, then roll."
    "Poi faccio quello che mi ha detto. Le afferro il braccio e spingo i fianchi verso l’alto con forza, poi rotolo."

# game/Scenes/Tammy/tammy3.rpy:75
translate italian tammy3_b74e68d2:

    # "It takes a couple of tries to get the movements right, but then..."
    "Ci vogliono un paio di tentativi per eseguire correttamente i movimenti, ma poi..."

# game/Scenes/Tammy/tammy3.rpy:78
translate italian tammy3_004dfbf8:

    # "I knock her on her back and I'm on top of her."
    "La faccio cadere sulla schiena e mi ritrovo sopra di lei."

# game/Scenes/Tammy/tammy3.rpy:79
translate italian tammy3_591f67d4:

    # tm "That was perfect! Good job!"
    tm "È stato perfetto! Ottimo lavoro!"

# game/Scenes/Tammy/tammy3.rpy:80
translate italian tammy3_7d946eb7:

    # pc "Thanks. I think I got it."
    pc "Grazie. Credo di aver capito."

# game/Scenes/Tammy/tammy3.rpy:81
translate italian tammy3_7c97e1b9:

    # tm "Now that you got me in this position, you could do a lot of different things to me."
    tm "Ora che mi hai messo in questa posizione, potresti farmi un sacco di cose diverse."

# game/Scenes/Tammy/tammy3.rpy:84
translate italian tammy3_e35118d4:

    # tm "Right now, you're in what we call closed guard."
    tm "In questo momento sei in quella che chiamiamo guardia chiusa."

# game/Scenes/Tammy/tammy3.rpy:85
translate italian tammy3_14f2bacf:

    # tm "You could pass into a half-guard, or even a full mount."
    tm "Potresti passare alla mezza guardia, o addirittura alla posizione di montata completa."

# game/Scenes/Tammy/tammy3.rpy:86
translate italian tammy3_4b84023a:

    # tm "You could go for a leg-hold. Or you could just stand up and go back to trading blows."
    tm "Potresti provare una presa alla gamba. Oppure potresti semplicemente alzarti e tornare a scambiare colpi."

# game/Scenes/Tammy/tammy3.rpy:88
translate italian tammy3_9e4a79ed:

    # tm "Oh yeah?"
    tm "Ah sì?"

# game/Scenes/Tammy/tammy3.rpy:89
translate italian tammy3_ecca25fc:

    # tm "I think I can guess what you're thinking about."
    tm "Credo di poter indovinare a cosa stai pensando."

# game/Scenes/Tammy/tammy3.rpy:90
translate italian tammy3_ba505d9b:

    # tm "You're really going to have to start wearing a cup when we do this."
    tm "Dovrai davvero iniziare a indossare un sospensorio quando lo faremo."

# game/Scenes/Tammy/tammy3.rpy:91
translate italian tammy3_ef242433:

    # tm "I can see pretty much your whole thing flopping around there."
    tm "Riesco a vedere praticamente tutto il tuo coso che penzola lì."

# game/Scenes/Tammy/tammy3.rpy:92
translate italian tammy3_b2395364:

    # pc "Sorry."
    pc "Scusa."

# game/Scenes/Tammy/tammy3.rpy:93
translate italian tammy3_532ec656:

    # tm "Nah, it's alright."
    tm "No, va bene."

# game/Scenes/Tammy/tammy3.rpy:94
translate italian tammy3_54238a64:

    # tm "Okay, let me up."
    tm "Ok, fammi alzare."

# game/Scenes/Tammy/tammy3.rpy:98
translate italian tammy3_742a8c61:

    # tm "You did good today. We'll keep practicing and teach you more grappling and you'll get even better."
    tm "Sei andato bene oggi. Continueremo ad allenarci e ti insegneremo altre tecniche di lotta e diventerai ancora più bravo."

# game/Scenes/Tammy/tammy3.rpy:101
translate italian tammy3_00868774:

    # tm "You're welcome."
    tm "Non c'è di che."

# game/Scenes/Tammy/tammy3.rpy:104
translate italian tammy3_6ce6700e:

    # tm "I had fun too. Any time you want to roll around, you just let me know."
    tm "Mi sono divertita anch'io. Ogni volta che vuoi fare un po' di lotta, basta che me lo dici."

# game/Scenes/Tammy/tammy3.rpy:105
translate italian tammy3_5bc44b07:

    # pc "I will."
    pc "Lo farò."

# game/Scenes/Tammy/tammy3.rpy:106
translate italian tammy3_efc77bf1:

    # tm "Alright, well I'm going to wash up and head out."
    tm "Va bene, beh, vado a darmi una rinfrescata e poi esco."

# game/Scenes/Tammy/tammy3.rpy:107
translate italian tammy3_63a1cf3a:

    # tm "I'll see you next time, [pcname]."
    tm "Ci vediamo la prossima volta, [pcname]."

# game/Scenes/Tammy/tammy3.rpy:108
translate italian tammy3_67f3ea81:

    # pc "Okay. Bye, Tammy."
    pc "Ok. Ciao, Tammy."

# game/Scenes/Tammy/tammy3.rpy:109
translate italian tammy3_15a8a240:

    # "With that, I go to the showers and clean up, then leave the gym."
    "Detto questo, vado a farmi una doccia e a darmi una rinfrescata, poi esco dalla palestra."

translate italian strings:

    # game/Scenes/Tammy/tammy3.rpy:2
