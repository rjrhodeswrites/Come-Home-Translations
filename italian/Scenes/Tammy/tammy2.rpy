# game/Scenes/Tammy/tammy2.rpy:12
translate italian tammy2_58882cf4:

    # "I spend some time working out with Tammy."
    "Passo un po’ di tempo ad allenarmi con Tammy."

# game/Scenes/Tammy/tammy2.rpy:13
translate italian tammy2_f8739613:

    # "First I spot her."
    "Prima la vedo io."

# game/Scenes/Tammy/tammy2.rpy:16
translate italian tammy2_b03ba21e:

    # "Then she spots me."
    "Poi lei vede me."

# game/Scenes/Tammy/tammy2.rpy:20
translate italian tammy2_f59c8527:

    # "Then we start chatting a bit between reps."
    "A quel punto iniziamo a chiacchierare un po’ tra una serie e l’altra."

# game/Scenes/Tammy/tammy2.rpy:21
translate italian tammy2_e027ab69:

    # tm "You ever think about trying MMA?"
    tm "Hai mai pensato di provare le MMA?"

# game/Scenes/Tammy/tammy2.rpy:22
translate italian tammy2_08f599b9:

    # pc "MMA? Like fighting?"
    pc "Le MMA? Tipo combattere?"

# game/Scenes/Tammy/tammy2.rpy:23
translate italian tammy2_7ed92c4d:

    # tm "Yeah, like fighting. I train every weekend in the morning."
    tm "Sì, tipo combattere. Mi alleno ogni fine settimana al mattino."

# game/Scenes/Tammy/tammy2.rpy:24
translate italian tammy2_690f9781:

    # tm "You could come join me sometime."
    tm "Potresti venire ad allenarti con me qualche volta."

# game/Scenes/Tammy/tammy2.rpy:25
translate italian tammy2_50211aa2:

    # pc "You're just looking for an excuse to beat me up."
    pc "Stai solo cercando una scusa per picchiarmi."

# game/Scenes/Tammy/tammy2.rpy:27
translate italian tammy2_d669bb2f:

    # "She punches me hard in the arm."
    "Mi dà un pugno forte sul braccio."

# game/Scenes/Tammy/tammy2.rpy:28
translate italian tammy2_68bd08bc:

    # tm "Ha! I don't need an excuse for that."
    tm "Ah! Non ho bisogno di una scusa per quello."

# game/Scenes/Tammy/tammy2.rpy:29
translate italian tammy2_dedf8f6f:

    # pc "Ow! Damn."
    pc "Ahi! Cavolo."

# game/Scenes/Tammy/tammy2.rpy:31
translate italian tammy2_eb4630f0:

    # tm "See that's why you need to come train in MMA. You got a nice body, but you're too soft."
    tm "Vedi, è per questo che devi venire ad allenarti nelle MMA. Hai un bel fisico, ma sei troppo morbido."

# game/Scenes/Tammy/tammy2.rpy:32
translate italian tammy2_eb998a13:

    # pc "You think I have a nice body?"
    pc "Pensi che io abbia un bel fisico?"

# game/Scenes/Tammy/tammy2.rpy:33
translate italian tammy2_9ac6fb46:

    # tm "Well, yeah."
    tm "Beh, sì."

# game/Scenes/Tammy/tammy2.rpy:34
translate italian tammy2_cce51848:

    # pc "Alright, I'll come wrestle with you some time."
    pc "Va bene, verrò a lottare con te qualche volta."

# game/Scenes/Tammy/tammy2.rpy:35
translate italian tammy2_bdefbf8e:

    # tm "Good. I'm looking forward to it. Mornings and Afternoons on the weekends, I'll be here."
    tm "Bene. Non vedo l’ora. Nei fine settimana, al mattino e al pomeriggio, sarò qui."

# game/Scenes/Tammy/tammy2.rpy:39
translate italian tammy2_7cd89556:

    # "We finish our workout and say goodbye to each other."
    "Finiamo l’allenamento e ci salutiamo."

# game/Scenes/Tammy/tammy2.rpy:41
translate italian tammy2_d33670c7:

    # "I have to admit, rolling around on the mat with her has a certain appeal."
    "Devo ammettere che rotolarmi sul tappeto con lei ha un certo fascino."

# game/Scenes/Tammy/tammy2.rpy:42
translate italian tammy2_bf0d0df4:

    # "For now though, I leave the gym and go out to my car."
    "Per ora, però, esco dalla palestra e vado alla mia auto."

translate italian strings:

    # game/Scenes/Tammy/tammy2.rpy:2
    old "Workout with Tammy on the weekend again."
    new "Allenati di nuovo con Tammy nel fine settimana."

    # game/Scenes/Tammy/tammy2.rpy:3
    old "Then she will ask if you want to train MMA with her."
    new "Poi ti chiederà se vuoi allenarti nelle MMA con lei."

