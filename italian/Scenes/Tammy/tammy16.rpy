# TODO: Translation updated at 2026-08-03 11:18

# game/Scenes/Tammy/tammy16.rpy:20
translate italian tammy16_39bb639d:

    # tm "Oh hey, [pcname]!"
    tm "Oh ehi, [pcname]!"

# game/Scenes/Tammy/tammy16.rpy:22
translate italian tammy16_c7aa7331:

    # tm "I wanted to let you know that I got another fight!"
    tm "Volevo farti sapere che ho un altro incontro!"

# game/Scenes/Tammy/tammy16.rpy:23
translate italian tammy16_46fcf508:

    # pc "Oh yeah? Awesome!"
    pc "Ah sì? Fantastico!"

# game/Scenes/Tammy/tammy16.rpy:25
translate italian tammy16_537005d0:

    # tm "Yeah! I mean, it's the same opponent. Sara Death."
    tm "Sì! Cioè, è lo stesso avversario. Sara Death."

# game/Scenes/Tammy/tammy16.rpy:26
translate italian tammy16_ff4ca977:

    # tm "They couldn't find anybody else to fight me around here."
    tm "Non sono riusciti a trovare nessun altro da farmi combattere da queste parti."

# game/Scenes/Tammy/tammy16.rpy:27
translate italian tammy16_c040e3a2:

    # pc "Still. A rematch! That'll be fun."
    pc "Comunque sia. Una rivincita! Sarà divertente."

# game/Scenes/Tammy/tammy16.rpy:29
translate italian tammy16_65a45e79:

    # tm "Yeah, so it's Friday evening. You're going to come, right?"
    tm "Sì, è venerdì sera. Verrai, vero?"

# game/Scenes/Tammy/tammy16.rpy:30
translate italian tammy16_a248948f:

    # pc "Of course."
    pc "Certo."

# game/Scenes/Tammy/tammy16.rpy:31
translate italian tammy16_0d0b0b78:

    # tm "Good. Suzy's coming to this one too."
    tm "Bene. Anche Suzy verrà a questo incontro."

# game/Scenes/Tammy/tammy16.rpy:33
translate italian tammy16_a716e406:

    # tm "I'm so fucking excited!"
    tm "Sono così fottutamente eccitata!"

# game/Scenes/Tammy/tammy16.rpy:34
translate italian tammy16_c03b2498:

    # tm "Ready to work out?"
    tm "Pronta ad allenarti?"

# game/Scenes/Tammy/tammy16.rpy:35
translate italian tammy16_81e72625:

    # pc "Yeah, let's do it!"
    pc "Sì, diamoci da fare!"

# game/Scenes/Tammy/tammy16.rpy:46
translate italian tammy16b_d3127e62:

    # "Tonight is Tammy's fight. I better head over to the gym to support her."
    "Stasera c'è l'incontro di Tammy. È meglio che mi rechi in palestra per sostenerla."

# game/Scenes/Tammy/tammy16.rpy:50
translate italian tammy16b_fc7a2349:

    # "The place is packed tonight. Even more people than the first fight. I guess everybody wants to see the rematch."
    "Stasera il posto è pieno zeppo. C’è ancora più gente rispetto al primo incontro. Immagino che tutti vogliano vedere la rivincita."

# game/Scenes/Tammy/tammy16.rpy:51
translate italian tammy16b_c1a9fded:

    # "I spot Tammy and Suzy hanging out near the ring and walk over to them."
    "Vedo Tammy e Suzy che chiacchierano vicino al ring e mi avvicino a loro."

# game/Scenes/Tammy/tammy16.rpy:54
translate italian tammy16b_ef965655:

    # tm "Hey, [pcname]. You in my corner again?"
    tm "Ehi, [pcname]. Sei di nuovo nel mio angolo?"

# game/Scenes/Tammy/tammy16.rpy:55
translate italian tammy16b_351f8f78:

    # pc "I'm always in your corner, girl."
    pc "Sono sempre nel tuo angolo, ragazza."

# game/Scenes/Tammy/tammy16.rpy:58
translate italian tammy16b_7de5fb0a:

    # tm "I know you are. Love you!"
    tm "Lo so. Ti voglio bene!"

# game/Scenes/Tammy/tammy16.rpy:59
translate italian tammy16b_ce2ae2bf:

    # pc "Love you too."
    pc "Anch’io ti voglio bene."

# game/Scenes/Tammy/tammy16.rpy:60
translate italian tammy16b_fbdb8489:

    # "Chuck, the gym owner and referee, steps onto the stage and speaks into a microphone."
    "Chuck, il proprietario della palestra e arbitro, sale sul palco e parla al microfono."

# game/Scenes/Tammy/tammy16.rpy:61
translate italian tammy16b_03a792fe:

    # "Chuck" "All right, everybody. Fighters to the ring."
    "Chuck" "Va bene, gente. Combattenti sul ring."

# game/Scenes/Tammy/tammy16.rpy:64
translate italian tammy16b_bc20373a:

    # tm "Guess I gotta go. Wish me luck."
    tm "Credo di dover andare. Auguratemi buona fortuna."

# game/Scenes/Tammy/tammy16.rpy:65
translate italian tammy16b_70969e05:

    # ss "You don't need it. You're going to wipe the mat with her."
    ss "Non ne hai bisogno. La spazzerai via dal tappeto."

# game/Scenes/Tammy/tammy16.rpy:66
translate italian tammy16b_8407fcdb:

    # pc "You trained so hard. You're a beast."
    pc "Ti sei allenata così duramente. Sei una forza della natura."

# game/Scenes/Tammy/tammy16.rpy:67
translate italian tammy16b_0fc82d62:

    # tm "Thanks, guys."
    tm "Grazie, ragazzi."

# game/Scenes/Tammy/tammy16.rpy:70
translate italian tammy16b_4d3281d1:

    # ss "You better get up there in her corner. She needs you."
    ss "Faresti meglio a salire lì nel suo angolo. Ha bisogno di te."

# game/Scenes/Tammy/tammy16.rpy:71
translate italian tammy16b_2cda7690:

    # pc "You don't want to?"
    pc "Non vuoi?"

# game/Scenes/Tammy/tammy16.rpy:72
translate italian tammy16b_2475c65e:

    # ss "No, I'm going to go cheer from the back. I don't like to see her get hit."
    ss "No, andrò a tifare da dietro. Non mi piace vederla prendere colpi."

# game/Scenes/Tammy/tammy16.rpy:73
translate italian tammy16b_7ebf9a37:

    # ss "But you'll hear me, I'm sure."
    ss "Ma mi sentirai, ne sono sicuro."

# game/Scenes/Tammy/tammy16.rpy:76
translate italian tammy16b_8ba7b5ed:

    # "I climb up into Tammy's corner as Chuck introduces the fighters."
    "Mi arrampico nell’angolo di Tammy mentre Chuck presenta i combattenti."

# game/Scenes/Tammy/tammy16.rpy:77
translate italian tammy16b_263516ea:

    # "Sara Death looks somehow even bigger and more jacked than she did last time they fought."
    "Sara Death sembra in qualche modo ancora più massiccia e muscolosa rispetto all’ultima volta che hanno combattuto."

# game/Scenes/Tammy/tammy16.rpy:78
translate italian tammy16b_dd7b01f4:

    # "Tammy is so much smaller it's sometimes hard to believe that she can take an opponent like that down."
    "Tammy è talmente più piccola che a volte è difficile credere che possa mettere al tappeto un’avversaria del genere."

# game/Scenes/Tammy/tammy16.rpy:79
translate italian tammy16b_edae56fc:

    # "Chuck" "... Our return opponent in this rematch, Sara Death!"
    "Chuck" "... La nostra avversaria in questa rivincita, Sara Death!"

# game/Scenes/Tammy/tammy16.rpy:83
translate italian tammy16b_a31e4957:

    # "Chuck" "And in this corner, undefeated so far in her amateur fighting career and hoping to continue that streak tonight..."
    "Chuck" "E in questo angolo, finora imbattuta nella sua carriera da combattente dilettante e speranzosa di continuare questa serie positiva stasera..."

# game/Scenes/Tammy/tammy16.rpy:85
translate italian tammy16b_83b35d9b:

    # "Chuck" "And in this corner, looking to get revenge on the beating she took last fight..."
    "Chuck" "E in questo angolo, desiderosa di vendicarsi della sconfitta subita nell’ultimo incontro..."

# game/Scenes/Tammy/tammy16.rpy:86
translate italian tammy16b_96ba703d:

    # "Chuck" "... standing five-foot-six-inches tall and weighing in at 130 pounds..."
    "Chuck" "... alta cinque piedi e sei pollici e con un peso di 130 libbre..."

# game/Scenes/Tammy/tammy16.rpy:87
translate italian tammy16b_ec4b18ff:

    # "Chuck" "Tammy \"Wham! Bam!\" Zamora!"
    "Chuck" "Tammy \"Wham! Bam!\" Zamora!"

# game/Scenes/Tammy/tammy16.rpy:90
translate italian tammy16b_6f4f75f7:

    # "Chuck takes them to the middle of the ring and goes over the rules with them."
    "Chuck le accompagna al centro del ring e ripassa con loro le regole."

# game/Scenes/Tammy/tammy16.rpy:91
translate italian tammy16b_0b6f40cb:

    # "Sara smiles the whole time. I can see Sara and Tammy muttering something to each other and laughing."
    "Sara sorride per tutto il tempo. Vedo Sara e Tammy che si sussurrano qualcosa all’orecchio e ridono."

# game/Scenes/Tammy/tammy16.rpy:92
translate italian tammy16b_24d8b054:

    # "Even though they're about to beat the crap out of each other, it seems like they're having a good time."
    "Anche se stanno per picchiarsi a sangue, sembra che si stiano divertendo."

# game/Scenes/Tammy/tammy16.rpy:93
translate italian tammy16b_1b6ae11e:

    # "When they're done, they touch gloves and return to their corners."
    "Una volta finito, si toccano i guantoni e tornano ai propri angoli."

# game/Scenes/Tammy/tammy16.rpy:96
translate italian tammy16b_fcfdafdf:

    # pc "You got this."
    pc "Ce la puoi fare."

# game/Scenes/Tammy/tammy16.rpy:97
translate italian tammy16b_3caaf546:

    # tm "You're goddamn right."
    tm "Hai proprio ragione, cavolo."

# game/Scenes/Tammy/tammy16.rpy:98
translate italian tammy16b_0929120c:

    # "Chuck" "Three... Two... One... FIGHT!"
    "Chuck" "Tre... Due... Uno... COMBATTIMENTO!"

# game/Scenes/Tammy/tammy16.rpy:101
translate italian tammy16b_ec9b5571:

    # "They both rush to the middle of the ring and the crowd goes wild."
    "Entrambi si precipitano al centro del ring e la folla impazzisce."

# game/Scenes/Tammy/tammy16.rpy:104
translate italian tammy16b_679f2669:

    # "Even over the yells of all of those around me, I can hear Suzy in the back, cheering loudly for our girlfriend."
    "Anche al di sopra delle urla di tutti quelli che mi circondano, riesco a sentire Suzy in fondo alla sala che tifa a squarciagola per la nostra ragazza."

# game/Scenes/Tammy/tammy16.rpy:107
translate italian tammy16b_647f4a54:

    # "They circle around each other a bit, testing out their range, looking for openings."
    "Girano un po’ l’uno intorno all’altro, testando la distanza, alla ricerca di aperture."

# game/Scenes/Tammy/tammy16.rpy:110
translate italian tammy16b_5d7efc88:

    # "Tammy is trying to stay loose, moving in and out quickly to land leg kicks."
    "Tammy sta cercando di rimanere sciolta, avvicinandosi e allontanandosi rapidamente per sferrare calci alle gambe."

# game/Scenes/Tammy/tammy16.rpy:111
translate italian tammy16b_e3d4107b:

    # "She knows that getting too close would mean that she could be taken down to the ground."
    "Sa bene che avvicinarsi troppo significherebbe rischiare di essere atterrata a terra."

# game/Scenes/Tammy/tammy16.rpy:112
translate italian tammy16b_a88a4b4f:

    # "Having the much larger Sara on top of her could easily lead to her getting overwhelmed."
    "Avere Sara, molto più massiccia, sopra di sé potrebbe facilmente portarla a essere sopraffatta."

# game/Scenes/Tammy/tammy16.rpy:115
translate italian tammy16b_a3883dc3:

    # "Of course, taking one of those big fists on her chin could knock her down as well."
    "Naturalmente, anche incassare uno di quei grossi pugni sul mento potrebbe metterla al tappeto."

# game/Scenes/Tammy/tammy16.rpy:116
translate italian tammy16b_b3da4826:

    # "Every second she's in this fight, there's more of a chance of her getting hit and knocked out."
    "Ogni secondo che passa in questo incontro, aumenta la probabilità che venga colpita e messa KO."

# game/Scenes/Tammy/tammy16.rpy:119
translate italian tammy16b_cdd3604c:

    # "Tammy is able to land a few good hits, but Sara just takes them and keeps coming."
    "Tammy riesce a sferrare alcuni colpi efficaci, ma Sara li incassa e continua ad attaccare."

# game/Scenes/Tammy/tammy16.rpy:122
translate italian tammy16b_248b11e5:

    # "Then the referee calls the end of the round and steps in to separate them back to their corners."
    "Poi l’arbitro dichiara la fine del round e interviene per separarle e riportarle ai rispettivi angoli."

# game/Scenes/Tammy/tammy16.rpy:125
translate italian tammy16b_5dca43c0:

    # tm "How am I looking out there?"
    tm "Come sto andando là fuori?"

# game/Scenes/Tammy/tammy16.rpy:126
translate italian tammy16b_40609e22:

    # pc "You look great. Really fucking sexy."
    pc "Stai benissimo. Davvero fottutamente sexy."

# game/Scenes/Tammy/tammy16.rpy:127
translate italian tammy16b_4586870d:

    # tm "Haha, I need a real coach."
    tm "Haha, ho bisogno di un vero allenatore."

# game/Scenes/Tammy/tammy16.rpy:128
translate italian tammy16b_4e5ec89e:

    # pc "Seriously, you're looking good. Moving fast. Staying on your toes."
    pc "Seriamente, stai andando bene. Ti muovi velocemente. Rimani all’erta."

# game/Scenes/Tammy/tammy16.rpy:129
translate italian tammy16b_eafbc9cd:

    # pc "I liked those leg kicks. They seemed to slow her down a bit. Her being slow is good. You can take advantage of that."
    pc "Mi sono piaciuti quei calci alle gambe. Sembravano rallentarla un po’. Il fatto che sia lenta è un vantaggio. Puoi approfittarne."

# game/Scenes/Tammy/tammy16.rpy:130
translate italian tammy16b_2d3b068d:

    # pc "Just be careful about her taking you down."
    pc "Fai solo attenzione che non ti metta a terra."

# game/Scenes/Tammy/tammy16.rpy:131
translate italian tammy16b_ec4282cb:

    # tm "Yeah, that's what I'm scared of. I've never been on the ground with her before."
    tm "Sì, è proprio quello che temo. Non sono mai stata a terra con lei prima d’ora."

# game/Scenes/Tammy/tammy16.rpy:132
translate italian tammy16b_6ef7cd76:

    # pc "You got this. I'm pretty sure you won that first round. Just keep moving and stay hard to hit."
    pc "Ce la puoi fare. Sono abbastanza sicura che tu abbia vinto quel primo round. Continua a muoverti e resta difficile da colpire."

# game/Scenes/Tammy/tammy16.rpy:133
translate italian tammy16b_850254f5:

    # tm "You got it. Thanks, coach."
    tm "Ce l’hai fatta. Grazie, coach."

# game/Scenes/Tammy/tammy16.rpy:136
translate italian tammy16b_2221ccc4:

    # "When the bell rings, they're right back in the middle of the ring again, trading punches."
    "Quando suona la campana, tornano subito al centro del ring, scambiandosi pugni."

# game/Scenes/Tammy/tammy16.rpy:137
translate italian tammy16b_c6a976b0:

    # "Tammy is able to block most of Sara's punches and sneak in a few of her own."
    "Tammy riesce a parare la maggior parte dei pugni di Sara e a sferrarne alcuni a sua volta."

# game/Scenes/Tammy/tammy16.rpy:140
translate italian tammy16b_9dbf1b1c:

    # "Then Tammy hops back and gets another hard kick to Sara's leg, the slap of shin on thigh echoing through the gym."
    "Poi Tammy fa un balzo indietro e sferra un altro calcio potente alla gamba di Sara; lo schiocco dello stinco contro la coscia riecheggia in tutta la palestra."

# game/Scenes/Tammy/tammy16.rpy:141
translate italian tammy16b_4c60ba4c:

    # "Sara winces. That one hurt."
    "Sara fa una smorfia. Quello le ha fatto male."

# game/Scenes/Tammy/tammy16.rpy:144
translate italian tammy16b_e41ad8f5:

    # "The pain and the frustration gets to Sara then and she growls in anger as she charges forward."
    "Il dolore e la frustrazione prendono il sopravvento su Sara, che ringhia di rabbia mentre si lancia in avanti."

# game/Scenes/Tammy/tammy16.rpy:145
translate italian tammy16b_03576045:

    # "She's throwing haymakers now, backing Tammy up towards the ropes."
    "Ora sta sferrando pugni a caso, facendo indietreggiare Tammy verso le corde."

# game/Scenes/Tammy/tammy16.rpy:146
translate italian tammy16b_028976a4:

    # "Sara has lost all defense in this moment. If Tammy could take advantage of it, she might be able to end the fight."
    "In questo momento Sara ha perso ogni capacità difensiva. Se Tammy riuscisse ad approfittarne, potrebbe mettere fine all’incontro."

# game/Scenes/Tammy/tammy16.rpy:149
translate italian tammy16b_5dc11d33:

    # "But then one of the punches connects, cracking against Tammy's jaw and rolling her eyes back."
    "Ma poi uno dei pugni va a segno, colpendo la mascella di Tammy e facendola roteare gli occhi all’indietro."

# game/Scenes/Tammy/tammy16.rpy:150
translate italian tammy16b_ade70eed:

    # "I hear Suzy in the back cry out in shock as Tammy falls to the mat."
    "Sento Suzy, dietro le quinte, gridare per lo shock mentre Tammy cade sul tappeto."

# game/Scenes/Tammy/tammy16.rpy:153
translate italian tammy16b_76769a9d:

    # "At first, I think that's it, that Tammy is knocked out, but she quickly shakes her head and starts fighting back."
    "All’inizio penso che sia finita, che Tammy sia al tappeto, ma lei scuote rapidamente la testa e ricomincia a contrattaccare."

# game/Scenes/Tammy/tammy16.rpy:154
translate italian tammy16b_8cf6bab3:

    # "But now Sara is on top of her, raining punches down onto her."
    "Ma ora Sara è sopra di lei e le sta sferrando una raffica di pugni."

# game/Scenes/Tammy/tammy16.rpy:155
translate italian tammy16b_f5522b72:

    # "Chuck is close and I can tell he's about to stop the fight."
    "Chuck è vicino e capisco che sta per interrompere l’incontro."

# game/Scenes/Tammy/tammy16.rpy:158
translate italian tammy16b_12ebb29b:

    # "What happens next is so fast that I can barely follow it."
    "Quello che succede dopo è così veloce che riesco a malapena a seguirlo."

# game/Scenes/Tammy/tammy16.rpy:159
translate italian tammy16b_a46fd698:

    # "Tammy grabs Sara's wrist and bucks her hips, moving her legs up towards Sara's head."
    "Tammy afferra il polso di Sara e scatta con i fianchi, sollevando le gambe verso la testa di Sara."

# game/Scenes/Tammy/tammy16.rpy:162
translate italian tammy16b_14e97ff6:

    # "Then Tammy rotates and has Sara's arm fully stretched out."
    "Poi Tammy ruota su se stessa e allunga completamente il braccio di Sara."

# game/Scenes/Tammy/tammy16.rpy:163
translate italian tammy16b_ca12b0e7:

    # "Sara cries out in pain. If she doesn't tap soon, Tammy could easily break her arm."
    "Sara urla di dolore. Se non batte presto, Tammy potrebbe facilmente romperle il braccio."

# game/Scenes/Tammy/tammy16.rpy:166
translate italian tammy16b_f3df8ee4:

    # "She reluctantly taps and the crowd goes insane."
    "Lei batte a malincuore e la folla impazzisce."

# game/Scenes/Tammy/tammy16.rpy:169
translate italian tammy16b_2d3791c3:

    # "I can't hear anything, the room is so loud and suddenly Suzy is right there, jumping up onto my shoulder."
    "Non riesco a sentire nulla, la sala è così rumorosa e all’improvviso Suzy è proprio lì, che mi salta sulle spalle."

# game/Scenes/Tammy/tammy16.rpy:170
translate italian tammy16b_be32fa84:

    # "I hold her high while she cheers."
    "La tengo in alto mentre lei esulta."

# game/Scenes/Tammy/tammy16.rpy:173
translate italian tammy16b_411f816b:

    # "Chuck announces the winner, but it's impossible to hear him over the roaring crowd."
    "Chuck annuncia la vincitrice, ma è impossibile sentirlo con il boato della folla."

# game/Scenes/Tammy/tammy16.rpy:174
translate italian tammy16b_67d97e00:

    # "Tammy and Sara are both crying in the ring. Suzy's crying on my shoulder. Hell, I'm crying a little bit too."
    "Tammy e Sara stanno piangendo entrambe sul ring. Suzy sta piangendo sulla mia spalla. Cavolo, anch’io sto piangendo un po’."

# game/Scenes/Tammy/tammy16.rpy:177
translate italian tammy16b_09e2a5ca:

    # "Then Tammy runs over and kisses Suzy."
    "Poi Tammy corre da Suzy e la bacia."

# game/Scenes/Tammy/tammy16.rpy:178
translate italian tammy16b_5354153a:

    # ss "You're a fucking queen! I love you!"
    ss "Sei una fottuta regina! Ti adoro!"

# game/Scenes/Tammy/tammy16.rpy:179
translate italian tammy16b_4039bf0e:

    # tm "I love both of you so fucking much!"
    tm "Vi amo entrambe da morire!"

# game/Scenes/Tammy/tammy16.rpy:182
translate italian tammy16b_c191fa62:

    # "The next half hour passes by in a blur as everybody congratulates Tammy and wants to talk to her and Sara."
    "La mezz'ora successiva vola via in un lampo mentre tutti si congratulano con Tammy e vogliono parlare con lei e Sara."

# game/Scenes/Tammy/tammy16.rpy:183
translate italian tammy16b_693b77ad:

    # "I hear them already planning another fight. Maybe in Whiterock next time."
    "Li sento già pianificare un altro incontro. Magari a Whiterock la prossima volta."

# game/Scenes/Tammy/tammy16.rpy:187
translate italian tammy16b_3c502a36:

    # "Eventually the gym clears out. Tammy and Sara head back to the showers together, while Suzy and I wait up front for her."
    "Alla fine la palestra si svuota. Tammy e Sara tornano insieme alle docce, mentre Suzy e io la aspettiamo all'ingresso."

# game/Scenes/Tammy/tammy16.rpy:188
translate italian tammy16b_559ff5f9:

    # ss "Tonight was crazy."
    ss "Stasera è stata una follia."

# game/Scenes/Tammy/tammy16.rpy:189
translate italian tammy16b_c417e350:

    # pc "Yeah."
    pc "Sì."

# game/Scenes/Tammy/tammy16.rpy:190
translate italian tammy16b_90a33a46:

    # ss "I've never seen her take a punch that hard. That was scary."
    ss "Non l'ho mai vista incassare un pugno così forte. È stato spaventoso."

# game/Scenes/Tammy/tammy16.rpy:191
translate italian tammy16b_a0a77eb7:

    # ss "She's going to be really sore later. We might have to make her feel good back at home."
    ss "Più tardi avrà davvero i muscoli indolenziti. Forse dovremo farla stare meglio una volta tornati a casa."

# game/Scenes/Tammy/tammy16.rpy:192
translate italian tammy16b_649407a6:

