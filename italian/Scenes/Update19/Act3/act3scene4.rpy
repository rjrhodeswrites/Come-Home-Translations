# TODO: Translation updated at 2026-08-03 11:18

# game/Scenes/Update19/Act3/act3scene4.rpy:4
translate italian act3scene4_594c2912:

    # "In a blink, I'm suddenly back in the Ice Queen's throne room."
    "In un batter d’occhio, mi ritrovo improvvisamente nella sala del trono della Regina di Ghiaccio."

# game/Scenes/Update19/Act3/act3scene4.rpy:6
translate italian act3scene4_41d6859f:

    # "My friends are still frozen around me, but I feel my body thawing."
    "I miei amici sono ancora congelati intorno a me, ma sento il mio corpo scongelarsi."

# game/Scenes/Update19/Act3/act3scene4.rpy:9
translate italian act3scene4_785bdb9f:

    # "When I can move again, I stumble forward and almost fall."
    "Quando riesco di nuovo a muovermi, barcollo in avanti e quasi cado."

# game/Scenes/Update19/Act3/act3scene4.rpy:10
translate italian act3scene4_9fe7bb42:

    # "But I'm able to stop myself and it seems that the Ice Queen didn't notice."
    "Ma riesco a fermarmi e sembra che la Regina del Ghiaccio non se ne sia accorta."

# game/Scenes/Update19/Act3/act3scene4.rpy:11
translate italian act3scene4_269679eb:

    # "Time to make my move."
    "È ora di agire."

# game/Scenes/Update19/Act3/act3scene4.rpy:15
translate italian act3scene4_f4ddd564:

    # "I rush up and hug her from behind, pulling her close to me."
    "Mi precipito verso di lei e la abbraccio da dietro, stringendola a me."

# game/Scenes/Update19/Act3/act3scene4.rpy:16
translate italian act3scene4_6145e44f:

    # sp "WHAT!?"
    sp "COSA!?"

# game/Scenes/Update19/Act3/act3scene4.rpy:17
translate italian act3scene4_d519fcc2:

    # sp "{i}WHAT{/i} are you doing? Unhand me!"
    sp "{i}COSA{/i} stai facendo? Lasciami andare!"

# game/Scenes/Update19/Act3/act3scene4.rpy:20
translate italian act3scene4_0d90b60a:

    # pc "I'm sorry that you lost Suzy. I'm so sorry that happened to you."
    pc "Mi dispiace che tu abbia perso Suzy. Mi dispiace tantissimo che ti sia successo questo."

# game/Scenes/Update19/Act3/act3scene4.rpy:21
translate italian act3scene4_641a9d68:

    # sp "Don't say her name--"
    sp "Non dire il suo nome..."

# game/Scenes/Update19/Act3/act3scene4.rpy:22
translate italian act3scene4_ad5d8a1e:

    # pc "I know your heart is broken."
    pc "So che hai il cuore spezzato."

# game/Scenes/Update19/Act3/act3scene4.rpy:23
translate italian act3scene4_c39f9ad8:

    # pc "That just shows how much love you had."
    pc "Questo dimostra solo quanto amore provavi per lei."

# game/Scenes/Update19/Act3/act3scene4.rpy:24
translate italian act3scene4_eb5ca914:

    # sp "You don't know--"
    sp "Tu non sai..."

# game/Scenes/Update19/Act3/act3scene4.rpy:27
translate italian act3scene4_82d048f3:

    # pc "Suzy wants you to know that she loves you so much."
    pc "Suzy vuole che tu sappia che ti ama tantissimo."

# game/Scenes/Update19/Act3/act3scene4.rpy:28
translate italian act3scene4_acba1f83:

    # sp "Stop--"
    sp "Smettila..."

# game/Scenes/Update19/Act3/act3scene4.rpy:31
translate italian act3scene4_cdd644dd:

    # pc "She wants you to know that she's going to always be with you."
    pc "Vuole che tu sappia che sarà sempre con te."

# game/Scenes/Update19/Act3/act3scene4.rpy:32
translate italian act3scene4_10d0ad27:

    # sp "How do you--"
    sp "Come fai a..."

# game/Scenes/Update19/Act3/act3scene4.rpy:35
translate italian act3scene4_978f88d1:

    # pc "And she doesn't like seeing what you've become."
    pc "E non le piace vedere cosa sei diventato."

# game/Scenes/Update19/Act3/act3scene4.rpy:36
translate italian act3scene4_8144a68d:

    # pc "She wants you to be warm and loving again, like she remembers you."
    pc "Vuole che tu torni ad essere affettuoso e amorevole, come ti ricorda."

# game/Scenes/Update19/Act3/act3scene4.rpy:37
translate italian act3scene4_ad07f09a:

    # sp "I'm not--"
    sp "Non sono..."

# game/Scenes/Update19/Act3/act3scene4.rpy:40
translate italian act3scene4_38d06822:

    # "She doesn't finish her sentence, instead bursting into tears and crumpling in my arms."
    "Non finisce la frase, ma scoppia in lacrime e si accascia tra le mie braccia."

# game/Scenes/Update19/Act3/act3scene4.rpy:41
translate italian act3scene4_5b98a3b5:

    # pc "I'm sorry, Lisa. I'm sorry she's gone."
    pc "Mi dispiace, Lisa. Mi dispiace che se ne sia andata."

# game/Scenes/Update19/Act3/act3scene4.rpy:42
translate italian act3scene4_d761b7e0:

    # pc "I love you."
    pc "Ti voglio bene."

# game/Scenes/Update19/Act3/act3scene4.rpy:45
translate italian act3scene4_3689094d:

    # "I hold her for a long time while she cries."
    "La stringo a me a lungo mentre piange."

# game/Scenes/Update19/Act3/act3scene4.rpy:46
translate italian act3scene4_fcd85bea:

    # "I wonder if she's ever let herself really feel the loss."
    "Mi chiedo se si sia mai concessa di sentire davvero questa perdita."

# game/Scenes/Update19/Act3/act3scene4.rpy:47
translate italian act3scene4_6f05f3c1:

    # "I wonder if she's ever had anybody to hold her like this."
    "Mi chiedo se abbia mai avuto qualcuno che la tenesse così tra le braccia."

# game/Scenes/Update19/Act3/act3scene4.rpy:50
translate italian act3scene4_49651a35:

    # "After some time, she stops crying and sits up again."
    "Dopo un po’, smette di piangere e si raddrizza."

# game/Scenes/Update19/Act3/act3scene4.rpy:51
translate italian act3scene4_77d46c18:

    # sp "Who {i}are{/i} you?"
    sp "Chi {i}sei{/i}?"

# game/Scenes/Update19/Act3/act3scene4.rpy:52
translate italian act3scene4_22be1576:

    # pc "It's a long story..."
    pc "È una lunga storia..."

# game/Scenes/Update19/Act3/act3scene4.rpy:53
translate italian act3scene4_0eb855c9:

    # "So I tell her everything about the other world, about the bracelet, about coming here to see her."
    "Così le racconto tutto dell’altro mondo, del braccialetto, di come sono venuto qui per vederla."

# game/Scenes/Update19/Act3/act3scene4.rpy:56
translate italian act3scene4_299824e4:

    # sp "You did so much to find your father."
    sp "Hai fatto di tutto per trovare tuo padre."

# game/Scenes/Update19/Act3/act3scene4.rpy:57
translate italian act3scene4_4aa0965e:

    # pc "Well yeah... I love him."
    pc "Beh, sì... Lo amo."

# game/Scenes/Update19/Act3/act3scene4.rpy:58
translate italian act3scene4_2c93668b:

    # sp "I suppose so. I'd do anything to get Suzy back."
    sp "Immagino di sì. Farei qualsiasi cosa per riavere Suzy."

# game/Scenes/Update19/Act3/act3scene4.rpy:61
translate italian act3scene4_f8215d8f:

    # pc "I know, [mom]... but sometimes people can't come back."
    pc "Lo so, [mom]... ma a volte le persone non possono tornare."

# game/Scenes/Update19/Act3/act3scene4.rpy:62
translate italian act3scene4_2022e63e:

    # pc "We lose people that we love sometimes..."
    pc "A volte perdiamo le persone che amiamo..."

# game/Scenes/Update19/Act3/act3scene4.rpy:63
translate italian act3scene4_d1689608:

    # pc "...and we have to find a way to deal with that without hurting ourselves or others."
    pc "...e dobbiamo trovare un modo per affrontarlo senza ferire noi stessi o gli altri."

# game/Scenes/Update19/Act3/act3scene4.rpy:66
translate italian act3scene4_c3dfeaa2:

    # sp "How? How can a person deal with that sort of loss?"
    sp "Come? Come si può affrontare quel tipo di perdita?"

# game/Scenes/Update19/Act3/act3scene4.rpy:68
translate italian act3scene4_8b7fb492:

    # pc "Well, in my world..."
    pc "Beh, nel mio mondo..."

# game/Scenes/Update19/Act3/act3scene4.rpy:72
translate italian act3scene4_22817e0f:

    # pc "... Nora lost what she thought her life was going to be."
    pc "... Nora ha perso ciò che pensava sarebbe stata la sua vita."

# game/Scenes/Update19/Act3/act3scene4.rpy:73
translate italian act3scene4_a6290b41:

    # pc "The man that was supposed to love her treated her badly and she was forced into this new life."
    pc "L’uomo che avrebbe dovuto amarla l’ha trattata male e lei è stata costretta a intraprendere questa nuova vita."

# game/Scenes/Update19/Act3/act3scene4.rpy:74
translate italian act3scene4_1e07804a:

    # pc "But she dove in and accepted it and is thriving on her own now."
    pc "Ma si è buttata a capofitto, l’ha accettata e ora sta prosperando da sola."

# game/Scenes/Update19/Act3/act3scene4.rpy:75
translate italian act3scene4_03b53305:

    # pc "She's discovering that there's a lot of love out there if you let yourself be open to it."
    pc "Sta scoprendo che c’è tanto amore là fuori, se solo ci si lascia andare e ci si apre ad esso."

# game/Scenes/Update19/Act3/act3scene4.rpy:79
translate italian act3scene4_ff6ea314:

    # pc "... Reba's father passed away and it put her whole family in a sort of limbo."
    pc "... Il padre di Reba è venuto a mancare e questo ha gettato tutta la sua famiglia in una sorta di limbo."

# game/Scenes/Update19/Act3/act3scene4.rpy:80
translate italian act3scene4_0115c38f:

    # pc "Her mother seems to have given up on her own life and Reba has been forced to take care of her."
    pc "Sembra che sua madre abbia rinunciato alla propria vita e Reba si è vista costretta a prendersi cura di lei."

# game/Scenes/Update19/Act3/act3scene4.rpy:81
translate italian act3scene4_233c26c0:

    # pc "But she's trying her best to move on and be a better version of herself, while also not forgetting about her family."
    pc "Ma sta facendo del suo meglio per andare avanti ed essere una versione migliore di sé stessa, senza però dimenticare la sua famiglia."

# game/Scenes/Update19/Act3/act3scene4.rpy:85
translate italian act3scene4_b0752170:

    # pc "... Dana lost what she thought her life was going to be."
    pc "... Dana ha perso ciò che pensava sarebbe stata la sua vita."

# game/Scenes/Update19/Act3/act3scene4.rpy:86
translate italian act3scene4_4054bf2c:

    # pc "The man that was supposed to love her treated her badly and her family didn't support her."
    pc "L’uomo che avrebbe dovuto amarla l’ha trattata male e la sua famiglia non l’ha sostenuta."

# game/Scenes/Update19/Act3/act3scene4.rpy:87
translate italian act3scene4_e1dbd7a3:

    # pc "But she's finding herself again, and discovering that there's a lot of love out there if you let yourself be open to it."
    pc "Ma sta ritrovando se stessa e scoprendo che c’è tanto amore là fuori, se solo ci si lascia andare."

# game/Scenes/Update19/Act3/act3scene4.rpy:91
translate italian act3scene4_684ddcd7:

    # pc "... Adrian embraced her true self and some of the people she loved didn't support her."
    pc "... Adrian ha abbracciato la sua vera identità e alcune delle persone che amava non l’hanno sostenuta."

# game/Scenes/Update19/Act3/act3scene4.rpy:92
translate italian act3scene4_0baf3bdf:

    # pc "She lost her father because he loved {i}his{/i} idea of who she was more than her actual self."
    pc "Ha perso suo padre perché lui amava {i}la sua{/i} idea di chi lei fosse più della sua vera persona."

# game/Scenes/Update19/Act3/act3scene4.rpy:93
translate italian act3scene4_0778a7bc:

    # pc "But she's happier than she's ever been and finding people who love her for who she really is."
    pc "Ma è più felice che mai e sta trovando persone che la amano per quella che è davvero."

# game/Scenes/Update19/Act3/act3scene4.rpy:97
translate italian act3scene4_9eadd263:

    # pc "... Kendra is sick and will likely not live to be very old."
    pc "... Kendra è malata e probabilmente non vivrà a lungo."

# game/Scenes/Update19/Act3/act3scene4.rpy:98
translate italian act3scene4_5cec7ee5:

    # pc "When she dies, she will lose everybody and everybody will lose her."
    pc "Quando morirà, perderà tutti e tutti perderanno lei."

# game/Scenes/Update19/Act3/act3scene4.rpy:99
translate italian act3scene4_fa1731ad:

    # pc "But she's determined to still love as hard as she can and enjoy life as much as she can while she's alive."
    pc "Ma è determinata ad amare comunque con tutta se stessa e a godersi la vita il più possibile finché è in vita."

# game/Scenes/Update19/Act3/act3scene4.rpy:103
translate italian act3scene4_a64c27f0:

    # pc "... Juliana lost both of her parents and has grown up with her grandmother."
    pc "... Juliana ha perso entrambi i genitori ed è cresciuta con sua nonna."

# game/Scenes/Update19/Act3/act3scene4.rpy:104
translate italian act3scene4_1653b6af:

    # pc "She's had a hard time making friends and has a lot of fear about loving someone and losing them."
    pc "Ha avuto difficoltà a farsi degli amici e ha molta paura di amare qualcuno e di perderlo."

# game/Scenes/Update19/Act3/act3scene4.rpy:105
translate italian act3scene4_3e7f244a:

    # pc "But she's learning to put herself out there anyways, to make herself vulnerable."
    pc "Ma sta imparando comunque ad aprirsi, a mostrarsi vulnerabile."

# game/Scenes/Update19/Act3/act3scene4.rpy:106
translate italian act3scene4_57cb2c2d:

    # pc "Because the rewards are worth it."
    pc "Perché ne vale la pena."

# game/Scenes/Update19/Act3/act3scene4.rpy:110
translate italian act3scene4_6fd90af8:

    # pc "... Mi-Cha hasn't lost anything yet, but she knows she will."
    pc "... Mi-Cha non ha ancora perso nulla, ma sa che lo farà."

# game/Scenes/Update19/Act3/act3scene4.rpy:111
translate italian act3scene4_c726ce2f:

    # pc "She came to a place, gave her heart to somebody, and now she's being forced to leave that place and her love behind."
    pc "È arrivata in un posto, ha donato il suo cuore a qualcuno e ora è costretta a lasciare quel luogo e il suo amore alle spalle."

# game/Scenes/Update19/Act3/act3scene4.rpy:112
translate italian act3scene4_3d2ddad3:

    # pc "Maybe it'll work out, but in the end. She knows it's better to love and lose than never love at all."
    pc "Forse andrà tutto bene, ma alla fine... Sa che è meglio amare e perdere che non amare affatto."

# game/Scenes/Update19/Act3/act3scene4.rpy:119
translate italian act3scene4_322b87f1:

    # pc "... Mari has lost everything. Her whole family taken from her in a moment."
    pc "... Mari ha perso tutto. Le è stata strappata via l’intera famiglia in un attimo."

# game/Scenes/Update19/Act3/act3scene4.rpy:120
translate italian act3scene4_29625c9a:

    # pc "She still lives in the shadow of that tragedy, but she shines brightly anyways."
    pc "Vive ancora all’ombra di quella tragedia, ma brilla comunque di luce propria."

# game/Scenes/Update19/Act3/act3scene4.rpy:121
translate italian act3scene4_6a46eb5e:

    # pc "She carries on with their love inside of her, knowing that they would be proud of her."
    pc "Va avanti portando il loro amore dentro di sé, sapendo che sarebbero orgogliosi di lei."

# game/Scenes/Update19/Act3/act3scene4.rpy:125
translate italian act3scene4_62feec4d:

    # pc "... Izzy lost both of her parents and has been put into a position where she has to care for her two little brothers."
    pc "... Izzy ha perso entrambi i genitori e si è ritrovata nella situazione di doversi prendere cura dei suoi due fratellini."

# game/Scenes/Update19/Act3/act3scene4.rpy:126
translate italian act3scene4_e5564799:

    # pc "She could be resentful of this, but she loves those two boys so much."
    pc "Potrebbe provare risentimento per questo, ma ama tantissimo quei due ragazzini."

# game/Scenes/Update19/Act3/act3scene4.rpy:127
translate italian act3scene4_289024f9:

    # pc "When she thought she lost them, she fought so hard to get them back."
    pc "Quando pensava di averli persi, ha lottato con tutte le sue forze per riaverli con sé."

# game/Scenes/Update19/Act3/act3scene4.rpy:131
translate italian act3scene4_a06ddb36:

    # pc "... Jamie loved a boy so much, but he tossed her aside without a word."
    pc "... Jamie amava tantissimo un ragazzo, ma lui l’ha scaricata senza dire una parola."

# game/Scenes/Update19/Act3/act3scene4.rpy:132
translate italian act3scene4_9714d5b1:

    # pc "But she kept moving forward, just being herself."
    pc "Ma lei ha continuato ad andare avanti, rimanendo semplicemente se stessa."

# game/Scenes/Update19/Act3/act3scene4.rpy:133
translate italian act3scene4_7f79356e:

    # pc "And eventually, things came back around and worked out for her."
    pc "E alla fine, le cose sono tornate a posto e si sono sistemate per lei."

# game/Scenes/Update19/Act3/act3scene4.rpy:137
translate italian act3scene4_d7d23337:

    # pc "And then there's me..."
    pc "E poi ci sono io..."

# game/Scenes/Update19/Act3/act3scene4.rpy:139
translate italian act3scene4_6cc0d265:

    # pc "Well, I can only talk about myself..."
    pc "Beh, posso solo parlare di me stessa..."

# game/Scenes/Update19/Act3/act3scene4.rpy:140
translate italian act3scene4_cdb25042:

    # pc "I lost my mom when I was a teenager and it was really hard on me."
    pc "Ho perso mia madre quando ero un'adolescente ed è stata davvero dura per me."

# game/Scenes/Update19/Act3/act3scene4.rpy:141
translate italian act3scene4_739643a0:

    # pc "I took it out on the people around me and did things I regret."
    pc "Me la sono presa con le persone che mi stavano vicino e ho fatto cose di cui mi pento."

# game/Scenes/Update19/Act3/act3scene4.rpy:142
translate italian act3scene4_ac0e651a:

    # pc "But I've done my best to change that and make things right."
    pc "Ma ho fatto del mio meglio per cambiare e sistemare le cose."

# game/Scenes/Update19/Act3/act3scene4.rpy:145
translate italian act3scene4_e7e67352:

    # sp "I suppose that's what I should do now."
    sp "Immagino che sia quello che dovrei fare adesso."

# game/Scenes/Update19/Act3/act3scene4.rpy:146
translate italian act3scene4_1e770403:

    # pc "I think so."
    pc "Penso di sì."

# game/Scenes/Update19/Act3/act3scene4.rpy:147
translate italian act3scene4_2610ae2e:

    # sp "I feel so ashamed. How can I face people?"
    sp "Mi vergogno tantissimo. Come posso guardare in faccia le persone?"

# game/Scenes/Update19/Act3/act3scene4.rpy:150
translate italian act3scene4_5c7a5888:

    # pc "The ones that really matter still love you, Lisa."
    pc "Quelle che contano davvero ti vogliono ancora bene, Lisa."

# game/Scenes/Update19/Act3/act3scene4.rpy:151
translate italian act3scene4_34903c2d:

    # pc "They feel the same loss that you feel."
    pc "Provano la stessa perdita che provi tu."

# game/Scenes/Update19/Act3/act3scene4.rpy:152
translate italian act3scene4_a346789c:

    # pc "But they feel like they lost {i}you{/i} as well."
    pc "Ma sentono anche di aver perso {i}te{/i}."

# game/Scenes/Update19/Act3/act3scene4.rpy:155
translate italian act3scene4_02541c65:

    # tm "It's true, Your Majesty."
    tm "È vero, Vostra Maestà."

# game/Scenes/Update19/Act3/act3scene4.rpy:156
translate italian act3scene4_e56ac275:

    # tm "I miss Suzy so much."
    tm "Mi manca tantissimo Suzy."

# game/Scenes/Update19/Act3/act3scene4.rpy:157
translate italian act3scene4_2b1387cd:

    # tm "And I miss you too."
    tm "E mi manchi anche tu."

# game/Scenes/Update19/Act3/act3scene4.rpy:160
translate italian act3scene4_909876ef:

    # sp "Oh God, I'm so sorry, Tammy. Of course you miss her too."
    sp "Oh Dio, mi dispiace tantissimo, Tammy. Certo che anche a te manca."

# game/Scenes/Update19/Act3/act3scene4.rpy:161
translate italian act3scene4_ddc42ef4:

    # sp "I'll fix this. I'll make it better."
    sp "Ci penserò io. Sistemerò tutto."

# game/Scenes/Update19/Act3/act3scene4.rpy:165
translate italian act3scene4_f8a1c7af:

    # sp "Starting with this."
    sp "A cominciare da questo."

