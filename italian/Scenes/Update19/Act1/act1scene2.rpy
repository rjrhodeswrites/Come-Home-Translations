translate italian u19a1s2_cfe74df5:

    # "Dad" "You met Whitney?"
    "Dad" "Hai conosciuto Whitney?"

# game/Scenes/Update19/Act1/act1scene2.rpy:96
translate italian u19a1s2_5017d2dd:

    # pc "I did more than meet her."
    pc "L’ho fatto ben più che conoscerla."

# game/Scenes/Update19/Act1/act1scene2.rpy:97
translate italian u19a1s2_93ef5df5:

    # "Dad" "Oh yeah?"
    "Dad" "Ah sì?"

# game/Scenes/Update19/Act1/act1scene2.rpy:100
