    # "Dad" "Nice!"
    "Dad" "Fantastico!"

# game/Scenes/Update19/Act1/act1scene2.rpy:101
translate italian u19a1s2_9dee5a20:

    # "Dad" "She was a cutie."
    "Dad" "Era una ragazza carina."

# game/Scenes/Update19/Act1/act1scene2.rpy:103
