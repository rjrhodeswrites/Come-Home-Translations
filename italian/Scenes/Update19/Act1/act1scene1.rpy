    # rm "No... I'm not your mother."
    rm "No... non sono tua madre."

# game/Scenes/Update19/Act1/act1scene1.rpy:11
translate italian u19a1s1_16885205:

    # rm "You must have bumped your head or something."
    rm "Devi aver battuto la testa o qualcosa del genere."

# game/Scenes/Update19/Act1/act1scene1.rpy:14
translate italian u19a1s1_9afb66bb:

    # rm "You're freezing! It's much too cold to be up here without any clothes on."
    rm "Sei gelata! Fa troppo freddo per stare quassù senza vestiti."

# game/Scenes/Update19/Act1/act1scene1.rpy:15
translate italian u19a1s1_d41d5a0c:

    # rm "What are you doing out here?"
    rm "Cosa ci fai qui fuori?"

# game/Scenes/Update19/Act1/act1scene1.rpy:16
translate italian u19a1s1_19310f7a:

    # pc "Um… I must have gotten lost."
    pc "Ehm… devo essermi perso."

# game/Scenes/Update19/Act1/act1scene1.rpy:19
translate italian u19a1s1_71ca6c4f:

    # rm "I'd say so. I've never seen you around here before."
    rm "Direi proprio di sì. Non ti ho mai visto da queste parti prima d’ora."

# game/Scenes/Update19/Act1/act1scene1.rpy:20
translate italian u19a1s1_0c16d3f0:

    # rm "What's your name? Where are you from?"
    rm "Come ti chiami? Da dove vieni?"

# game/Scenes/Update19/Act1/act1scene1.rpy:21
translate italian u19a1s1_6488be43:

    # pc "My name is [pcname]... and I'm from uh… Skyhill?"
    pc "Mi chiamo [pcname]... e vengo da ehm… Skyhill?"

# game/Scenes/Update19/Act1/act1scene1.rpy:24
translate italian u19a1s1_21f41f15:

    # rm "Well, yes this is Sky Hill, I know."
    rm "Beh, sì, questa è Sky Hill, lo so."

# game/Scenes/Update19/Act1/act1scene1.rpy:25
translate italian u19a1s1_527e5c94:

    # rm "But surely you don't live on Sky Hill. There's nothing up here."
    rm "Ma di sicuro non vivi a Sky Hill. Qui sopra non c’è niente."

# game/Scenes/Update19/Act1/act1scene1.rpy:26
translate italian u19a1s1_aceb6340:

    # pc "No, I guess not. I don't remember."
    pc "No, immagino di no. Non me lo ricordo."

# game/Scenes/Update19/Act1/act1scene1.rpy:29
translate italian u19a1s1_5006110a:

    # rm "I like to come out here and walk sometimes."
    rm "Mi piace venire qui a fare una passeggiata ogni tanto."

# game/Scenes/Update19/Act1/act1scene1.rpy:30
translate italian u19a1s1_f806dd86:

    # rm "It's just so beautiful, isn't it?"
    rm "È proprio bellissimo, vero?"

# game/Scenes/Update19/Act1/act1scene1.rpy:31
translate italian u19a1s1_d9553c7b:

    # pc "Yes, it is."
    pc "Sì, lo è."

# game/Scenes/Update19/Act1/act1scene1.rpy:34
translate italian u19a1s1_387fe790:

    # rm "Are you okay?"
    rm "Sta bene?"

# game/Scenes/Update19/Act1/act1scene1.rpy:35
translate italian u19a1s1_daaf94c0:

    # pc "Yes. I'm sorry… you just remind me so much of my mother."
    pc "Sì. Mi scusi… è solo che mi ricorda tantissimo mia madre."

# game/Scenes/Update19/Act1/act1scene1.rpy:38
translate italian u19a1s1_56690d52:

    # rm "Well, I don't have a son."
    rm "Beh, io non ho un figlio."

# game/Scenes/Update19/Act1/act1scene1.rpy:39
translate italian u19a1s1_9528e26e:

    # rm "You do remind me of my husband though. You look just like he did when he was younger."
    rm "Mi ricorda mio marito, però. È identico a com’era lui da giovane."

# game/Scenes/Update19/Act1/act1scene1.rpy:40
translate italian u19a1s1_43a489f5:

    # pc "Your husband? Is he here with you?"
    pc "Tuo marito? È qui con te?"

# game/Scenes/Update19/Act1/act1scene1.rpy:41
translate italian u19a1s1_b7f2130e:

    # rm "No, he's back at our house in the village."
    rm "No, è tornato a casa nostra al villaggio."

# game/Scenes/Update19/Act1/act1scene1.rpy:42
translate italian u19a1s1_a0f51d59:

    # rm "Maybe you should come back with me."
    rm "Forse dovresti tornare con me."

# game/Scenes/Update19/Act1/act1scene1.rpy:43
translate italian u19a1s1_c1544c25:

    # rm "You definitely shouldn't be out here with no clothes. You wouldn't survive the night."
    rm "Non dovresti assolutamente stare qui fuori senza vestiti. Non sopravvivresti alla notte."

# game/Scenes/Update19/Act1/act1scene1.rpy:46
translate italian u19a1s1_98c524d6:

    # pc "Okay. Yes, I'd like to come back with you."
    pc "Va bene. Sì, mi piacerebbe tornare con te."

# game/Scenes/Update19/Act1/act1scene1.rpy:47
translate italian u19a1s1_b57591b1:

    # rm "It's just a short walk."
    rm "È solo una breve passeggiata."

# game/Scenes/Update19/Act1/act1scene1.rpy:48
translate italian u19a1s1_b086eca9:

    # pc "Can you tell me about yourself on the way?"
    pc "Puoi parlarmi di te lungo la strada?"

# game/Scenes/Update19/Act1/act1scene1.rpy:51
translate italian u19a1s1_3bf144be:

    # rm "Myself? Oh, I'm not very interesting."
    rm "Di me? Oh, non sono molto interessante."

# game/Scenes/Update19/Act1/act1scene1.rpy:52
translate italian u19a1s1_043fabfb:

    # rm "My name is Emilia. I live with my husband and our daughter in Whiterock."
    rm "Mi chiamo Emilia. Vivo con mio marito e nostra figlia a Whiterock."

# game/Scenes/Update19/Act1/act1scene1.rpy:53
translate italian u19a1s1_df823c21:

    # rm "I have a little garden and come out here foraging sometimes. He builds things."
    rm "Ho un piccolo giardino e ogni tanto vengo qui a raccogliere qualcosa. Lui costruisce oggetti."

# game/Scenes/Update19/Act1/act1scene1.rpy:54
translate italian u19a1s1_5546af9c:

    # rm "It's a simple life, but we have each other."
    rm "È una vita semplice, ma abbiamo l’un l’altro."

# game/Scenes/Update19/Act1/act1scene1.rpy:57
translate italian u19a1s1_739e52da:

    # rm "You keep staring at me. Do I really look so much like your mother?"
    rm "Continui a fissarmi. Assomiglio davvero così tanto a tua madre?"

# game/Scenes/Update19/Act1/act1scene1.rpy:58
translate italian u19a1s1_93661d4a:

    # pc "It's like looking at a photo."
    pc "È come guardare una foto."

# game/Scenes/Update19/Act1/act1scene1.rpy:59
translate italian u19a1s1_7092bc4c:

    # rm "A what?"
    rm "Un cosa?"

# game/Scenes/Update19/Act1/act1scene1.rpy:60
translate italian u19a1s1_104d0d8f:

    # pc "Sorry… like a painting. A beautiful painting."
    pc "Scusa… come un quadro. Un bellissimo quadro."

# game/Scenes/Update19/Act1/act1scene1.rpy:63
translate italian u19a1s1_0b24e95d:

    # rm "You even talk like my husband. It's so strange."
    rm "Parli persino come mio marito. È così strano."

# game/Scenes/Update19/Act1/act1scene1.rpy:64
translate italian u19a1s1_f09acb7a:

    # rm "Where {i}is{/i} your mother?"
    rm "Dove {i}si trova{/i} tua madre?"

# game/Scenes/Update19/Act1/act1scene1.rpy:65
translate italian u19a1s1_a4647cce:

    # pc "She… died. A few years ago."
    pc "È… morta. Qualche anno fa."

# game/Scenes/Update19/Act1/act1scene1.rpy:68
translate italian u19a1s1_e43de7c3:

    # rm "Oh, I'm sorry. Losing a parent so young is hard."
    rm "Oh, mi dispiace. Perdere un genitore così giovane è difficile."

# game/Scenes/Update19/Act1/act1scene1.rpy:69
translate italian u19a1s1_c417e350:

    # pc "Yeah."
    pc "Sì."

# game/Scenes/Update19/Act1/act1scene1.rpy:70
translate italian u19a1s1_d7040d44:

    # rm "What about your father?"
    rm "E tuo padre?"

# game/Scenes/Update19/Act1/act1scene1.rpy:71
translate italian u19a1s1_6adaa82e:

    # pc "That's why I'm here. He went missing and I'm looking for him."
    pc "È per questo che sono qui. È scomparso e lo sto cercando."

# game/Scenes/Update19/Act1/act1scene1.rpy:74
translate italian u19a1s1_59c5493d:

    # rm "In Whiterock?"
    rm "A Whiterock?"

# game/Scenes/Update19/Act1/act1scene1.rpy:75
translate italian u19a1s1_5b22d737:

    # pc "Maybe."
    pc "Forse."

# game/Scenes/Update19/Act1/act1scene1.rpy:76
translate italian u19a1s1_13782b59:

    # rm "Well, it's the only village around here, so if he's anywhere, he'd be there."
    rm "Beh, è l’unico villaggio da queste parti, quindi se si trova da qualche parte, dovrebbe essere lì."

# game/Scenes/Update19/Act1/act1scene1.rpy:77
translate italian u19a1s1_4924c360:

    # rm "It's close. Just over this peak."
    rm "È vicino. Appena oltre questa cima."

# game/Scenes/Update19/Act1/act1scene1.rpy:81
translate italian u19a1s1_ce59dba2:

    # pc "Wow."
    pc "Wow."

# game/Scenes/Update19/Act1/act1scene1.rpy:82
translate italian u19a1s1_b4846581:

    # rm "Pretty big village, huh?"
    rm "È un villaggio piuttosto grande, eh?"

# game/Scenes/Update19/Act1/act1scene1.rpy:83
translate italian u19a1s1_5d6a1e11:

    # rm "We've had a lot of people moving here in the past couple of years."
    rm "Negli ultimi due anni si sono trasferite qui un sacco di persone."

# game/Scenes/Update19/Act1/act1scene1.rpy:86
translate italian u19a1s1_eef83cc3:

    # "We walk through the village. People wave at my mother and look at me strangely."
    "Attraversiamo il villaggio. La gente saluta mia madre con la mano e mi guarda in modo strano."

# game/Scenes/Update19/Act1/act1scene1.rpy:87
translate italian u19a1s1_90deef05:

    # "Probably because I'm mostly naked."
    "Probabilmente perché sono quasi nudo."

# game/Scenes/Update19/Act1/act1scene1.rpy:90
translate italian u19a1s1_402c1d8a:

    # "I try not to stare, but this place is so weird."
    "Cerco di non fissare, ma questo posto è davvero strano."

# game/Scenes/Update19/Act1/act1scene1.rpy:91
translate italian u19a1s1_2775c974:

    # "I expected the world to be different, but not this different."
    "Mi aspettavo che il mondo fosse diverso, ma non così diverso."

# game/Scenes/Update19/Act1/act1scene1.rpy:92
translate italian u19a1s1_1f8bbd5e:

    # "This is like a village out of Souls of War, or some weird Dungeons and Dragons thing."
    "Sembra un villaggio uscito da Souls of War, o da qualche strano gioco di Dungeons and Dragons."

# game/Scenes/Update19/Act1/act1scene1.rpy:95
translate italian u19a1s1_20d2b55d:

    # rm "This is our house."
    rm "Questa è la nostra casa."

# game/Scenes/Update19/Act1/act1scene1.rpy:96
translate italian u19a1s1_e619e55e:

    # pc "It's beautiful."
    pc "È bellissima."

# game/Scenes/Update19/Act1/act1scene1.rpy:97
translate italian u19a1s1_d1f41d47:

    # rm "Thank you. My husband is probably in his workshop. You should come meet him."
    rm "Grazie. Mio marito probabilmente è nel suo laboratorio. Dovresti venire a conoscerlo."

# game/Scenes/Update19/Act1/act1scene1.rpy:98
translate italian u19a1s1_377d55f7:

    # rm "And maybe you can borrow some of his clothes."
    rm "E magari potresti prendere in prestito qualche suo vestito."

# game/Scenes/Update19/Act1/act1scene1.rpy:99
translate italian u19a1s1_995245af:

    # pc "Good idea."
    pc "Ottima idea."

