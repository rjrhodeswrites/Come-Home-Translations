    pc "Come state tutti?"

# game/Scenes/Izzy/izzy16.rpy:50
translate italian izzy16_04a47828:

    # moose "Just chillin' man."
    moose "Ci stiamo solo rilassando, amico."

# game/Scenes/Izzy/izzy16.rpy:51
translate italian izzy16_bacd00d2:

    # mal "I ain't been doing shit."
    mal "Non ho fatto un bel niente."

# game/Scenes/Izzy/izzy16.rpy:52
translate italian izzy16_e1fb06f0:

    # moose "Missing y'all."
    moose "Mi mancate tutti."

# game/Scenes/Izzy/izzy16.rpy:55
translate italian izzy16_bdc09ed2:

    # gl "Yeah, sorry I haven't been able to smoke and hang out with y'all as much anymore."
    gl "Sì, scusate se non sono più riuscito a fumare e a uscire con voi così spesso."

# game/Scenes/Izzy/izzy16.rpy:56
translate italian izzy16_b6562171:

    # moose "Girl, we don't have to smoke. I know why you can't do that anymore."
    moose "Ragazza, non dobbiamo per forza fumare. So perché non puoi più farlo."

# game/Scenes/Izzy/izzy16.rpy:57
translate italian izzy16_ecdc8e86:

    # mal "Yeah, we just miss seeing you. We don't have to get high to have a good time."
    mal "Sì, ci manca solo vederti. Non dobbiamo sballarci per divertirci."

# game/Scenes/Izzy/izzy16.rpy:58
translate italian izzy16_65034032:

    # moose "I mean, it helps, but yeah, we can have fun without it."
