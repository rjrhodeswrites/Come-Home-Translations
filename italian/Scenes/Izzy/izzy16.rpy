translate italian izzy16_5d7c40c3:

    # mal "Wait a second. I need that wood. Trade with me instead."
    mal "Aspetta un attimo. Mi serve quel pezzo di legno. Fai lo scambio con me invece."

# game/Scenes/Izzy/izzy16.rpy:122
translate italian izzy16_bc0a1ec8:

    # moose "Well, he asked first."
    moose "Beh, lui l’ha chiesto per primo."

# game/Scenes/Izzy/izzy16.rpy:123
translate italian izzy16_4bdd12e0:

    # mal "I'll give you two wools for it."
    mal "Ti darò due lane in cambio."

# game/Scenes/Izzy/izzy16.rpy:124
translate italian izzy16_98f16f12:

    # moose "Oh, well I guess I'll trade with you then."
    moose "Oh, beh, allora credo che farò lo scambio con te."

# game/Scenes/Izzy/izzy16.rpy:125
translate italian izzy16_c6ff5b4a:

