    # pc "Yeah, I'll stay."
    pc "Sì, resto."

# game/Scenes/Izzy/izzy16.rpy:346
translate italian izzy16_c6a7da14:

    # "We go back to her bed and lie down together."
    "Torniamo nel suo letto e ci sdraiamo insieme."

# game/Scenes/Izzy/izzy16.rpy:349
translate italian izzy16_033d9c0c:

    # "It doesn't take long before we're both asleep."
    "Non ci vuole molto prima che ci addormentiamo entrambi."

# game/Scenes/Izzy/izzy16.rpy:352
translate italian izzy16_1cee6238:

    # "I wake up to the sound of my phone alarm in the morning."
    "Al mattino mi sveglio al suono della sveglia del mio telefono."

# game/Scenes/Izzy/izzy16.rpy:355
translate italian izzy16_bc4ff6d9:

    # pc "Hey, Izzy. I have to go."
    pc "Ehi, Izzy. Devo andare."

# game/Scenes/Izzy/izzy16.rpy:356
translate italian izzy16_4511aa4e:

    # gl "Oh okay, baby."
    gl "Oh ok, tesoro."

# game/Scenes/Izzy/izzy16.rpy:357
translate italian izzy16_475c67d1:

    # gl "Hope you have a good day. Thanks for staying over."
    gl "Spero che tu passi una bella giornata. Grazie per essere rimasto qui."

# game/Scenes/Izzy/izzy16.rpy:360
translate italian izzy16_f4a8219d:

    # pc "I'll talk to you later."
    pc "Ci sentiamo più tardi."

# game/Scenes/Izzy/izzy16.rpy:361
translate italian izzy16_923d4965:

    # gl "Okay."
    gl "Ok."

# game/Scenes/Izzy/izzy16.rpy:364
translate italian izzy16_7db1b4d7:

    # "As I'm walking away, I hear her say, almost too low to make out the words..."
    "Mentre mi allontano, la sento dire, con una voce quasi troppo bassa per distinguere le parole..."

# game/Scenes/Izzy/izzy16.rpy:365
translate italian izzy16_968ee224:

    # gl "Love you, Twig."
    gl "Ti voglio bene, Twig."

# game/Scenes/Izzy/izzy16.rpy:366
translate italian izzy16_5236ef26:

    # "I leave Izzy's house, then head home to change and shower before starting my day."
    "Esco da casa di Izzy, poi torno a casa per cambiarmi e farmi una doccia prima di iniziare la giornata."

