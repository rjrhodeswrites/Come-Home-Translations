translate italian izzy16_838a37fd:

    # pc "I'll give you two ore for the two wood."
    pc "Ti darò due di minerale per i due di legna."

# game/Scenes/Izzy/izzy16.rpy:152
translate italian izzy16_4346e02a:

    # moose "Nice. I'll do that, unless you can do better, Izzy."
    moose "Ottimo. Accetto, a meno che tu non possa fare di meglio, Izzy."

# game/Scenes/Izzy/izzy16.rpy:154
translate italian izzy16_d41d8cd9_2:

    # voice 'voices/izzy_16_2.mp3'
    voice 'voices/izzy_16_2.mp3'

# game/Scenes/Izzy/izzy16.rpy:155
translate italian izzy16_02988a1e:

    # gl "Man, I ain't got two ore."
    gl "Cavolo, non ho due di minerale."

# game/Scenes/Izzy/izzy16.rpy:157
translate italian izzy16_d41d8cd9_3:

    # voice 'voices/izzy_16_3.mp3'
    voice 'voices/izzy_16_3.mp3'

# game/Scenes/Izzy/izzy16.rpy:158
translate italian izzy16_7154f0b2:

    # gl "I'll give you my one ore, but I'll pop my titties out."
    gl "Ti darò il mio unico minerale, ma ti mostrerò le tette."

