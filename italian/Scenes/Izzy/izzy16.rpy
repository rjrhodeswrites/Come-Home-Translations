    gl "Cazzo, sì! Haha!"

# game/Scenes/Izzy/izzy16.rpy:130
translate italian izzy16_7a25b164:

    # mal "You gotta stop trading with them, man. They're going to win."
    mal "Devi smetterla di fare scambi con loro, amico. Vinceranno loro."

# game/Scenes/Izzy/izzy16.rpy:131
translate italian izzy16_b8952c17:

    # gl "I ain't gonna win. Twig's gonna win. I'm still like four points away."
    gl "Non vincerò io. Vincerà Twig. Mi mancano ancora tipo quattro punti."

# game/Scenes/Izzy/izzy16.rpy:132
translate italian izzy16_5da39bcb:

    # pc "So am I."
    pc "Anche a me."

# game/Scenes/Izzy/izzy16.rpy:133
translate italian izzy16_740ae061:

    # gl "No you ain't. You got the longest road. So you're two points away."
    gl "No, non è vero. Hai la strada più lunga. Quindi ti mancano due punti."

# game/Scenes/Izzy/izzy16.rpy:134
translate italian izzy16_d49ac5a8:

    # moose "What is this longest road, shit?"
    moose "Cos’è questa storia della strada più lunga, cazzo?"

# game/Scenes/Izzy/izzy16.rpy:137
translate italian izzy16_c63a510c:

    # gl "Man, he told you about this at the beginning. The person who has the longest road gets that card and gets 2 points."
    gl "Amico, te l’aveva detto all’inizio. Chi ha la strada più lunga prende quella carta e ottiene 2 punti."

# game/Scenes/Izzy/izzy16.rpy:138
translate italian izzy16_0da2fb5f:

    # moose "Why you get points for having a long road?"
    moose "Perché si ottengono punti per avere una strada lunga?"

# game/Scenes/Izzy/izzy16.rpy:139
translate italian izzy16_a4a72943:

    # mal "Yeah dawg, it ain't the length of the road that matters."
    mal "Sì, amico, non è la lunghezza della strada che conta."

# game/Scenes/Izzy/izzy16.rpy:140
translate italian izzy16_a8d04144:

    # moose "That's right. Just because it's long, don't mean nothing. How girthy is that road?"
    moose "Esatto. Solo perché è lunga, non significa niente. Quanto è larga quella strada?"

# game/Scenes/Izzy/izzy16.rpy:141
translate italian izzy16_3d5ec17a:

    # mal "Do I get two points for having the chodiest road?"
    mal "Prendo due punti per avere la strada più larga?"

# game/Scenes/Izzy/izzy16.rpy:144
translate italian izzy16_8145f187:

    # gl "Oh my God, shut up. Y'all so stupid."
    gl "Oh mio Dio, state zitti. Siete tutti così stupidi."

# game/Scenes/Izzy/izzy16.rpy:148
translate italian izzy16_d41d8cd9_1:

    # voice 'voices/izzy_16_1.mp3'
