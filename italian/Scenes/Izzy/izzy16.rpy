    moose "È una stronzata, amico. Non mi escono mai i miei numeri."

# game/Scenes/Izzy/izzy16.rpy:111
translate italian izzy16_6272aba7:

    # mal "You set up your towns on twos and twelves man, what do you expect?"
    mal "Hai piazzato le tue città sui due e sui dodici, amico, cosa ti aspettavi?"

# game/Scenes/Izzy/izzy16.rpy:112
translate italian izzy16_b1545219:

    # moose "What does that matter?"
    moose "Che importanza ha?"

# game/Scenes/Izzy/izzy16.rpy:113
translate italian izzy16_74990813:

    # mal "Those numbers don't get rolled as much, dawg."
    mal "Quei numeri escono meno spesso, amico."

# game/Scenes/Izzy/izzy16.rpy:114
translate italian izzy16_2eeda9f1:

    # moose "What the fuck, why not?"
    moose "Ma che cazzo, perché no?"

# game/Scenes/Izzy/izzy16.rpy:115
translate italian izzy16_0957cc6d:

    # mal "Man, I ain't got time to explain dice odds to you."
    mal "Amico, non ho tempo per spiegarti le probabilità dei dadi."

# game/Scenes/Izzy/izzy16.rpy:116
translate italian izzy16_bf6b13ad:

    # moose "Fuck you, man. Roll and get me some damn wood this time."
    moose "Vaffanculo, amico. Lancia i dadi e dammi un po’ di maledetto legno questa volta."

# game/Scenes/Izzy/izzy16.rpy:119
translate italian izzy16_790ffa79:

