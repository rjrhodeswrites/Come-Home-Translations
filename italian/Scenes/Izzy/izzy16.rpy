# game/Scenes/Izzy/izzy16.rpy:103
translate italian izzy16_51e89ffe:

    # mal "Are we seriously going to play this? It's like the nerdiest thing I've ever seen."
    mal "Vogliamo davvero giocare a questo? È la cosa più da nerd che abbia mai visto."

# game/Scenes/Izzy/izzy16.rpy:104
translate italian izzy16_2245c52c:

    # moose "It looks fun to me. You ever play Trouble? Man, I fucking love Trouble."
    moose "A me sembra divertente. Hai mai giocato a Trouble? Cavolo, adoro da morire Trouble."

# game/Scenes/Izzy/izzy16.rpy:105
translate italian izzy16_50e6a2c6:

    # mal "Such a dork."
    mal "Che sfigato."

