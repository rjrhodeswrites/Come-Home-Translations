translate italian izzy11_e30d15b5:

    # gl "We taste so good together."
    gl "Insieme abbiamo un sapore così buono."

# game/Scenes/Izzy/izzy11.rpy:168
translate italian izzy11_4be9cb45:

    # "After we have cleaned up, we lie down together in her bed to sleep."
    "Dopo esserci ripuliti, ci sdraiamo insieme nel suo letto per dormire."

# game/Scenes/Izzy/izzy11.rpy:169
translate italian izzy11_12bbe6a9:

    # gl "Thank you for being here for me, [pcname]."
    gl "Grazie per esserci stata per me, [pcname]."

# game/Scenes/Izzy/izzy11.rpy:170
translate italian izzy11_eab1a7c7:

    # gl "The house is so quiet. I'm not sure I'd be able to get any sleep here alone."
    gl "La casa è così silenziosa. Non sono sicuro che riuscirei a dormire qui da solo."

# game/Scenes/Izzy/izzy11.rpy:171
translate italian izzy11_ed4d1a05:

    # pc "It's no problem. It was nice to spend time with just me and you."
    pc "Non c’è problema. È stato bello passare del tempo solo io e te."

# game/Scenes/Izzy/izzy11.rpy:172
translate italian izzy11_d1f60530:

    # gl "Yeah, it was nice."
    gl "Sì, è stato bello."

# game/Scenes/Izzy/izzy11.rpy:173
translate italian izzy11_02b88afc:

    # gl "I'm going to get things sorted out. I'm going to change."
    gl "Mi sistemerò le cose. Cambierò."

# game/Scenes/Izzy/izzy11.rpy:174
translate italian izzy11_274abca9:

    # pc "I know, Izzy. I'm here for you, if you need me."
    pc "Lo so, Izzy. Sono qui per te, se hai bisogno di me."

# game/Scenes/Izzy/izzy11.rpy:177
translate italian izzy11_43dea266:

    # "She falls asleep very quickly. It's been a rough day for her. I know she's exhausted."
    "Si addormenta molto in fretta. È stata una giornata dura per lei. So che è esausta."

# game/Scenes/Izzy/izzy11.rpy:178
translate italian izzy11_ef175c38:

    # "It takes longer for me to fall asleep. Her neighborhood is loud - I hear music playing somewhere, and what sounds like an argument in the distance."
    "A me ci vuole più tempo per addormentarmi. Il suo quartiere è rumoroso: sento della musica da qualche parte e quello che sembra un litigio in lontananza."

# game/Scenes/Izzy/izzy11.rpy:179
translate italian izzy11_9cc81585:

    # "Her bed is not as comfortable as mine either."
    "Anche il suo letto non è comodo come il mio."

# game/Scenes/Izzy/izzy11.rpy:182
translate italian izzy11_86f8f1ac:

    # "But after lying there for I don't know how long, eventually I fall asleep as well."
    "Ma dopo essere rimasta lì sdraiata per non so quanto tempo, alla fine mi addormento anch’io."

# game/Scenes/Izzy/izzy11.rpy:185
translate italian izzy11_4dc9ce92:

    # "In the morning, I wake up to the sound of the alarm on my phone."
    "Al mattino, mi sveglio al suono della sveglia sul mio telefono."

# game/Scenes/Izzy/izzy11.rpy:186
translate italian izzy11_28d8e363:

    # "I look over and see that Izzy is still asleep."
    "Guardo di lato e vedo che Izzy sta ancora dormendo."

# game/Scenes/Izzy/izzy11.rpy:189
translate italian izzy11_7ea0c206:

    # pc "Hey, Izzy."
    pc "Ehi, Izzy."

# game/Scenes/Izzy/izzy11.rpy:190
translate italian izzy11_6c3c347d:

    # gl "Huh?"
    gl "Eh?"

# game/Scenes/Izzy/izzy11.rpy:191
translate italian izzy11_79dd1fe0:

    # pc "I have to go. I have to get to school."
    pc "Devo andare. Devo andare a scuola."

# game/Scenes/Izzy/izzy11.rpy:192
translate italian izzy11_ed764c8a:

    # gl "Oh okay, Twig."
    gl "Oh, ok, Twig."

# game/Scenes/Izzy/izzy11.rpy:193
translate italian izzy11_1227be7b:

    # gl "Thanks for last night. You were great."
    gl "Grazie per ieri sera. Sei stata fantastica."

# game/Scenes/Izzy/izzy11.rpy:196
translate italian izzy11_60a26718:

    # "I lean in and kiss her temple."
    "Mi chino e le do un bacio sulla tempia."

# game/Scenes/Izzy/izzy11.rpy:197
translate italian izzy11_38c79251:

    # pc "Call me if you need me, okay?"
    pc "Chiamami se hai bisogno di me, ok?"

# game/Scenes/Izzy/izzy11.rpy:198
translate italian izzy11_923d4965:

    # gl "Okay."
    gl "Ok."

# game/Scenes/Izzy/izzy11.rpy:199
translate italian izzy11_f4a8219d:

    # pc "I'll talk to you later."
    pc "Ci sentiamo più tardi."

# game/Scenes/Izzy/izzy11.rpy:201
translate italian izzy11_d41d8cd9_8:

    # voice 'voices/izzy_seeya.mp3'
    voice 'voices/izzy_seeya.mp3'

# game/Scenes/Izzy/izzy11.rpy:202
translate italian izzy11_cb6c5e7b:

    # gl "Okay, Twig. See ya."
    gl "Ok, Twig. Ci vediamo."

# game/Scenes/Izzy/izzy11.rpy:205
translate italian izzy11_826e63a8:

    # "I leave Izzy's house, hoping that she'll be okay. Hoping that I helped her in some way last night."
    "Esco da casa di Izzy, sperando che stia bene. Sperando di averla aiutata in qualche modo ieri sera."

# game/Scenes/Izzy/izzy11.rpy:206
translate italian izzy11_7d7221ce:

    # "Then I rush home and get ready for school."
    "Poi corro a casa e mi preparo per andare a scuola."

translate italian strings:

    # game/Scenes/Izzy/izzy11.rpy:2
    old "This scene happens automatically a few days after the previous scene."
    new "Questa scena si svolge automaticamente pochi giorni dopo quella precedente."

    # game/Scenes/Izzy/izzy11.rpy:3
    old "Then she will call you in the evening."
    new "Poi ti chiamerà in serata."

