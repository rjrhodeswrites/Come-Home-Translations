# game/Scenes/Izzy/izzy18.rpy:13
translate italian izzy18_48f73cbb:

    # "My phone buzzes in my pocket. I pull it out and see Izzy is calling."
    "Il mio telefono vibra in tasca. Lo tiro fuori e vedo che è Izzy che chiama."

# game/Scenes/Izzy/izzy18.rpy:17
translate italian izzy18_0b193747:

    # pc "Hey, Izzy!"
    pc "Ehi, Izzy!"

# game/Scenes/Izzy/izzy18.rpy:18
translate italian izzy18_67747f91:

    # gl "Hey, [pcname]. Do you think you could come over?"
    gl "Ehi, [pcname]. Pensi di poter passare da me?"

# game/Scenes/Izzy/izzy18.rpy:19
translate italian izzy18_079eca90:

    # pc "Sure. Is everything okay?"
    pc "Certo. Va tutto bene?"

# game/Scenes/Izzy/izzy18.rpy:21
translate italian izzy18_994c37aa:

    # gl "Yeah, it's okay. Great actually."
    gl "Sì, va tutto bene. Anzi, alla grande."

# game/Scenes/Izzy/izzy18.rpy:22
translate italian izzy18_7bc637d7:

    # gl "I was approved to get custody of my brothers. They're coming home today."
    gl "Mi è stata concessa la custodia dei miei fratelli. Tornano a casa oggi."

# game/Scenes/Izzy/izzy18.rpy:23
translate italian izzy18_bcb1c8ac:

    # pc "Wow! That's awesome!"
    pc "Wow! È fantastico!"

# game/Scenes/Izzy/izzy18.rpy:25
translate italian izzy18_f7e9774e:

    # gl "Yeah... I'm just really nervous."
    gl "Sì... Sono solo molto nervosa."

# game/Scenes/Izzy/izzy18.rpy:26
translate italian izzy18_1abab176:

    # gl "So, could you come over? For support?"
    gl "Allora, potresti passare da me? Per darmi un po’ di sostegno?"

# game/Scenes/Izzy/izzy18.rpy:27
translate italian izzy18_7b21993a:

    # pc "Of course. I'll be there in ten."
    pc "Certo. Sarò lì tra dieci minuti."

# game/Scenes/Izzy/izzy18.rpy:29
translate italian izzy18_ac4baa1d:

    # gl "Thanks, [pcname]. See you when you get here."
    gl "Grazie, [pcname]. Ci vediamo quando arrivi."

# game/Scenes/Izzy/izzy18.rpy:33
translate italian izzy18_42aac3f3:

    # "We hang up, and a few minutes later I arrive at her house."
    "Riattacciamo e, pochi minuti dopo, arrivo a casa sua."

# game/Scenes/Izzy/izzy18.rpy:34
translate italian izzy18_44049f47:

    # "She stands nervously in the kitchen."
    "Lei è in piedi in cucina, visibilmente nervosa."

# game/Scenes/Izzy/izzy18.rpy:35
translate italian izzy18_ae9ec1ae:

    # gl "I'm sorry, I just feel so anxious about this."
    gl "Mi dispiace, è solo che mi sento così in ansia per questa cosa."

# game/Scenes/Izzy/izzy18.rpy:36
translate italian izzy18_e9fa4b62:

    # pc "What are you worried about?"
    pc "Di cosa ti preoccupi?"

# game/Scenes/Izzy/izzy18.rpy:39
translate italian izzy18_24491b47:

    # gl "I'm scared they're going to hate me, [pcname]."
    gl "Ho paura che mi odieranno, [pcname]."

# game/Scenes/Izzy/izzy18.rpy:40
translate italian izzy18_d8ca02d0:

    # gl "What if they don't want to come back here?"
    gl "E se non volessero tornare qui?"

# game/Scenes/Izzy/izzy18.rpy:41
translate italian izzy18_77345d17:

    # gl "I'm so broke. I can't afford to fix the house. We have to buy cheap food and thrift-store clothes."
    gl "Sono al verde. Non posso permettermi di sistemare la casa. Dobbiamo comprare cibo a buon mercato e vestiti di seconda mano."

# game/Scenes/Izzy/izzy18.rpy:42
translate italian izzy18_976944f0:

    # gl "Why would they want to come back here?"
    gl "Perché dovrebbero voler tornare qui?"

# game/Scenes/Izzy/izzy18.rpy:45
translate italian izzy18_1c46df37:

    # pc "Because you're here, Izzy."
    pc "Perché ci sei tu, Izzy."

# game/Scenes/Izzy/izzy18.rpy:46
translate italian izzy18_b64f93b8:

    # pc "Because you love them. They know that."
    pc "Perché li ami. Lo sanno."

# game/Scenes/Izzy/izzy18.rpy:47
translate italian izzy18_a520fca4:

    # pc "They will want to be with you. You're their sister. They love you."
    pc "Vorranno stare con te. Sei la loro sorella. Ti vogliono bene."

# game/Scenes/Izzy/izzy18.rpy:48
translate italian izzy18_268fd7eb:

    # gl "I hope you're right, [pcname]. I really do."
    gl "Spero che tu abbia ragione, [pcname]. Lo spero davvero."

# game/Scenes/Izzy/izzy18.rpy:52
translate italian izzy18_5722cdcb:

    # gl "I guess we're about to find out."
    gl "Immagino che lo scopriremo tra poco."

# game/Scenes/Izzy/izzy18.rpy:53
translate italian izzy18_0fb2d05f:

    # "She takes a deep breath."
    "Fa un respiro profondo."

# game/Scenes/Izzy/izzy18.rpy:54
translate italian izzy18_fcfdafdf:

    # pc "You got this."
    pc "Ce la puoi fare."

# game/Scenes/Izzy/izzy18.rpy:55
translate italian izzy18_027e66f0:

    # gl "Okay... here we go."
    gl "Ok... ci siamo."

# game/Scenes/Izzy/izzy18.rpy:58
translate italian izzy18_e277f99d:

    # "As soon as Izzy opens the door, her brothers charge through, hugging her, almost tackling her to the ground."
    "Non appena Izzy apre la porta, i suoi fratelli si precipitano dentro, abbracciandola, quasi buttandola a terra."

# game/Scenes/Izzy/izzy18.rpy:59
translate italian izzy18_d5005b33:

    # "Stanley" "Sissy!"
    "Stanley" "Sorellina!"

# game/Scenes/Izzy/izzy18.rpy:62
translate italian izzy18_29392a48:

    # gl "I missed you two so much."
    gl "Mi siete mancati tantissimo, voi due."

# game/Scenes/Izzy/izzy18.rpy:63
translate italian izzy18_b3c27f06:

    # "Paul" "We missed you too, Sis."
    "Paul" "Anche tu ci sei mancata, sorellina."

# game/Scenes/Izzy/izzy18.rpy:64
translate italian izzy18_5e663f52:

    # "Stanley" "Don't ever let them take us again."
    "Stanley" "Non lasciare mai più che ci portino via."

# game/Scenes/Izzy/izzy18.rpy:65
translate italian izzy18_4b2a23f0:

    # gl "I won't. You're home now."
    gl "Non lo farò. Ora sei a casa."

# game/Scenes/Izzy/izzy18.rpy:68
translate italian izzy18_079c6442:

    # "The social worker steps in after them."
    "L’assistente sociale entra dopo di loro."

# game/Scenes/Izzy/izzy18.rpy:69
translate italian izzy18_54f57576:

    # "Social Worker" "We just have some paperwork to take care of and I have to do the routine search through the house."
    "Social Worker" "Dobbiamo solo sbrigare un po’ di pratiche e devo fare la perquisizione di routine in casa."

# game/Scenes/Izzy/izzy18.rpy:70
translate italian izzy18_1e34149c:

    # gl "Yes, ma'am."
    gl "Sì, signora."

# game/Scenes/Izzy/izzy18.rpy:71
translate italian izzy18_e2ef09a8:

    # gl "Why don't you two go watch some TV in the living room, okay?"
    gl "Perché voi due non andate a guardare un po’ di TV in salotto, va bene?"

# game/Scenes/Izzy/izzy18.rpy:72
translate italian izzy18_6330802a:

    # "Paul" "Okay, Sis."
    "Paul" "Va bene, sorellina."

# game/Scenes/Izzy/izzy18.rpy:75
translate italian izzy18_b3f92cd5:

    # "The boys go to the living room and we sit in the kitchen, Izzy holding my hand under the table."
    "I ragazzi vanno in salotto e noi ci sediamo in cucina, con Izzy che mi tiene la mano sotto il tavolo."

# game/Scenes/Izzy/izzy18.rpy:76
translate italian izzy18_3083cd34:

    # "Social Worker" "You're looking good, Isabel. The house looks good too."
    "Social Worker" "Stai benissimo, Isabel. Anche la casa è in ordine."

# game/Scenes/Izzy/izzy18.rpy:77
translate italian izzy18_9df6bcf7:

    # gl "Thank you."
    gl "Grazie."

# game/Scenes/Izzy/izzy18.rpy:78
translate italian izzy18_e9ec6fe9:

    # "Social Worker" "And this is?"
    "Social Worker" "E lui chi è?"

# game/Scenes/Izzy/izzy18.rpy:81
translate italian izzy18_d425bfc9:

    # gl "Oh, this is my boyfriend, [pcname]. He's just here to give me some support."
    gl "Oh, è il mio ragazzo, [pcname]. È qui solo per darmi un po’ di sostegno."

# game/Scenes/Izzy/izzy18.rpy:82
translate italian izzy18_1162fb74:

    # "Social Worker" "Is he living here?"
    "Social Worker" "Vive qui?"

# game/Scenes/Izzy/izzy18.rpy:83
translate italian izzy18_03e12495:

    # gl "No, he just comes over occasionally."
    gl "No, viene solo ogni tanto."

# game/Scenes/Izzy/izzy18.rpy:84
translate italian izzy18_7ab89bd3:

    # "Social Worker" "I'm going to need his information as well."
    "Social Worker" "Avrò bisogno anche dei suoi dati."

# game/Scenes/Izzy/izzy18.rpy:87
translate italian izzy18_c72b1f7c:

    # gl "Is that okay?"
    gl "Va bene?"

# game/Scenes/Izzy/izzy18.rpy:88
translate italian izzy18_977f18ad:

    # pc "Sure, I don't have a criminal history or anything."
    pc "Certo, non ho precedenti penali né altro."

# game/Scenes/Izzy/izzy18.rpy:89
translate italian izzy18_37c22e5c:

    # gl "All right, stop bragging."
    gl "Va bene, smettila di vantarti."

# game/Scenes/Izzy/izzy18.rpy:92
translate italian izzy18_4a5d20ed:

    # "We go through some very boring paperwork, filling out a dozen forms."
    "Ci occupiamo di un po’ di scartoffie molto noiose, compilando una dozzina di moduli."

# game/Scenes/Izzy/izzy18.rpy:95
translate italian izzy18_407d8bc5:

    # "Then the social worker asks Izzy a lot of questions."
    "Poi l’assistente sociale fa un sacco di domande a Izzy."

# game/Scenes/Izzy/izzy18.rpy:96
translate italian izzy18_f60332fb:

    # "I can tell Izzy is nervous. Like if she answers one thing wrong, she's going to lose her brothers again."
    "Si vede che Izzy è nervosa. Come se, se rispondesse male a una sola domanda, perdesse di nuovo i suoi fratelli."

# game/Scenes/Izzy/izzy18.rpy:99
translate italian izzy18_ff06b03c:

    # "But I give her hand a reassuring squeeze and she makes it through."
    "Ma le stringo la mano in segno di rassicurazione e lei ce la fa."

# game/Scenes/Izzy/izzy18.rpy:102
translate italian izzy18_9eab5eb8:

    # "Then I sit in the living room with Paul and Stanley and we watch some cartoons while the social worker does her search through the house."
    "Poi mi siedo in salotto con Paul e Stanley e guardiamo dei cartoni animati mentre l’assistente sociale fa la sua ispezione in casa."

# game/Scenes/Izzy/izzy18.rpy:105
translate italian izzy18_2d767d13:

    # "Social Worker" "Everything looks good."
    "Social Worker" "Sembra tutto a posto."

# game/Scenes/Izzy/izzy18.rpy:106
translate italian izzy18_a15cf495:

    # "Social Worker" "You're doing great, Isabel. I'm really happy to see how much you've improved things around here."
    "Social Worker" "Stai andando alla grande, Isabel. Sono davvero felice di vedere quanto hai migliorato le cose qui."

# game/Scenes/Izzy/izzy18.rpy:107
translate italian izzy18_9df6bcf7_1:

    # gl "Thank you."
    gl "Grazie."

# game/Scenes/Izzy/izzy18.rpy:108
translate italian izzy18_49402ae6:

    # "Social Worker" "Take care and I'll see you again in two weeks."
    "Social Worker" "Abbi cura di te e ci rivediamo tra due settimane."

# game/Scenes/Izzy/izzy18.rpy:109
translate italian izzy18_09005e13:

    # gl "Yes, ma'am. Thank you."
    gl "Sì, signora. Grazie."

# game/Scenes/Izzy/izzy18.rpy:112
translate italian izzy18_b3abd917:

    # "Then the social worker leaves and Izzy gasps, like she's been holding her breath the whole time."
    "Poi l’assistente sociale se ne va e Izzy fa un sussulto, come se avesse trattenuto il respiro per tutto il tempo."

# game/Scenes/Izzy/izzy18.rpy:113
translate italian izzy18_fa75bbc3:

    # pc "Are you okay?"
    pc "Stai bene?"

# game/Scenes/Izzy/izzy18.rpy:116
translate italian izzy18_0d5fc033:

    # gl "I did it! Oh my fucking God, I did it!"
    gl "Ce l’ho fatta! Oh mio Dio, cazzo, ce l’ho fatta!"

# game/Scenes/Izzy/izzy18.rpy:117
translate italian izzy18_a279b5e1:

    # gl "Thank you!"
    gl "Grazie!"

# game/Scenes/Izzy/izzy18.rpy:118
translate italian izzy18_781ab01e:

    # pc "You did amazing, Izzy."
    pc "Sei stata fantastica, Izzy."

# game/Scenes/Izzy/izzy18.rpy:119
translate italian izzy18_119e2fab:

    # pc "Want to take them out somewhere to celebrate?"
    pc "Ti va di portarli fuori da qualche parte per festeggiare?"

# game/Scenes/Izzy/izzy18.rpy:120
translate italian izzy18_1ac539d0:

    # gl "I would love that."
    gl "Mi piacerebbe tantissimo."

# game/Scenes/Izzy/izzy18.rpy:123
translate italian izzy18_c6477fda:

    # "We decide to all go to the arcade together."
    "Decidiamo di andare tutti insieme alla sala giochi."

# game/Scenes/Izzy/izzy18.rpy:124
translate italian izzy18_273332a9:

    # "Stanley and Paul had never been before and they have a blast playing all the different games there."
    "Stanley e Paul non c’erano mai stati prima e si divertono un mondo a provare tutti i diversi giochi che ci sono."

# game/Scenes/Izzy/izzy18.rpy:127
translate italian izzy18_f36e0cea:

    # "There's a lot of laughing and joking."
    "Si ride e si scherza un sacco."

# game/Scenes/Izzy/izzy18.rpy:128
translate italian izzy18_c6bbc8d4:

    # "I don't think I've ever seen Izzy smile this much."
    "Non credo di aver mai visto Izzy sorridere così tanto."

# game/Scenes/Izzy/izzy18.rpy:131
translate italian izzy18_b84de43e:

    # "Then we have a dance-off and Paul wipes the floor with all of us."
    "Poi facciamo una gara di ballo e Paul ci surclassa tutti."

# game/Scenes/Izzy/izzy18.rpy:132
translate italian izzy18_e649e772:

    # gl "Man, this ain't the kind of dancing I know how to do."
    gl "Cavolo, questo non è il tipo di ballo che so fare."

# game/Scenes/Izzy/izzy18.rpy:133
translate italian izzy18_c726dcf4:

    # "Stanley" "What kind of dancing do you know, Sis?"
    "Stanley" "Che tipo di ballo sai fare, sorellina?"

# game/Scenes/Izzy/izzy18.rpy:136
translate italian izzy18_b8613348:

    # pc "Let's go get burgers!"
    pc "Andiamo a mangiare degli hamburger!"

# game/Scenes/Izzy/izzy18.rpy:139
translate italian izzy18_cbc41878:

    # "When we're done at the arcade, we go to Jackson Burger together."
    "Quando abbiamo finito alla sala giochi, andiamo insieme da Jackson Burger."

# game/Scenes/Izzy/izzy18.rpy:140
translate italian izzy18_52fef02b:

    # "Stanley" "Dang, these are good."
    "Stanley" "Cavolo, questi sono buonissimi."

# game/Scenes/Izzy/izzy18.rpy:141
translate italian izzy18_1058b1e6:

    # "Paul" "You work here now, Sis?"
    "Paul" "Lavori qui adesso, sorellina?"

# game/Scenes/Izzy/izzy18.rpy:142
translate italian izzy18_ffeeb947:

    # gl "Yeah, I do. Here comes my boss right now."
    gl "Sì, è vero. Ecco che arriva il mio capo."

# game/Scenes/Izzy/izzy18.rpy:145
translate italian izzy18_c1593b1c:

    # jk "How are you doing, Izzy? These are your brothers?"
    jk "Come va, Izzy? Questi sono i tuoi fratelli?"

# game/Scenes/Izzy/izzy18.rpy:146
translate italian izzy18_3dc4d4e6:

    # gl "Yeah, this is them. I got custody back today."
    gl "Sì, sono proprio loro. Oggi ho riottenuto la custodia."

# game/Scenes/Izzy/izzy18.rpy:147
translate italian izzy18_ce588c4b:

    # "Paul" "Since she works here, we get free burgers now, right?"
    "Paul" "Visto che lavora qui, adesso abbiamo gli hamburger gratis, giusto?"

# game/Scenes/Izzy/izzy18.rpy:148
translate italian izzy18_32d684f0:

    # jk "Haha, well sometimes, sure."
    jk "Ah ah, beh, a volte, certo."

# game/Scenes/Izzy/izzy18.rpy:151
translate italian izzy18_a6caef49:

    # jk "I'm proud of you, kid. You're doing great."
    jk "Sono orgoglioso di te, ragazzina. Stai andando alla grande."

# game/Scenes/Izzy/izzy18.rpy:152
translate italian izzy18_d815f7ea:

    # gl "Thanks, boss."
    gl "Grazie, capo."

# game/Scenes/Izzy/izzy18.rpy:153
translate italian izzy18_3e93b6aa:

    # jk "Y'all have fun now."
    jk "Divertitevi, ragazzi."

# game/Scenes/Izzy/izzy18.rpy:156
translate italian izzy18_762c6ed4:

    # "Full of burgers now, we get back to Izzy's house."
    "A pancia piena di hamburger, torniamo a casa di Izzy."

# game/Scenes/Izzy/izzy18.rpy:157
translate italian izzy18_04954375:

    # gl "Time to get ready for bed, boys."
    gl "È ora di prepararsi per andare a letto, ragazzi."

# game/Scenes/Izzy/izzy18.rpy:158
translate italian izzy18_f0cc05be:

    # "Paul" "Yeah, okay."
    "Paul" "Sì, va bene."

# game/Scenes/Izzy/izzy18.rpy:159
translate italian izzy18_890945a8:

    # "Stanley" "I'm sleepy."
    "Stanley" "Ho sonno."

# game/Scenes/Izzy/izzy18.rpy:162
translate italian izzy18_8e435665:

    # gl "Tell [pcname] thank you, first."
    gl "Prima di tutto, dite grazie a [pcname]."

# game/Scenes/Izzy/izzy18.rpy:163
translate italian izzy18_7c71e313:

    # "Paul" "Thanks for taking us out, [pcname]. See you later."
    "Paul" "Grazie per averci portato fuori, [pcname]. Ci vediamo più tardi."

# game/Scenes/Izzy/izzy18.rpy:164
translate italian izzy18_f0c7cd78:

    # "Stanley" "Bye, [pcname]! Thank you!"
    "Stanley" "Ciao, [pcname]! Grazie!"

# game/Scenes/Izzy/izzy18.rpy:167
translate italian izzy18_edb80472:

    # "Her brothers run off to their room and Izzy turns to look at me."
    "I suoi fratelli corrono nelle loro camere e Izzy si gira a guardarmi."

# game/Scenes/Izzy/izzy18.rpy:169
translate italian izzy18_d41d8cd9:

    # voice 'voices/izzy_18_1.mp3'
    voice 'voices/izzy_18_1.mp3'

# game/Scenes/Izzy/izzy18.rpy:170
translate italian izzy18_5fa69c8d:

    # gl "Thank you. Seriously. For everything."
    gl "Grazie. Davvero. Per tutto."

# game/Scenes/Izzy/izzy18.rpy:171
translate italian izzy18_c46a0b54:

    # pc "Any time."
    pc "Quando vuoi."

# game/Scenes/Izzy/izzy18.rpy:175
translate italian izzy18_d41d8cd9_1:

    # voice 'voices/izzy_18_2.mp3'
    voice 'voices/izzy_18_2.mp3'

# game/Scenes/Izzy/izzy18.rpy:176
translate italian izzy18_709c5077:

    # gl "I love you."
    gl "Ti voglio bene."

# game/Scenes/Izzy/izzy18.rpy:177
translate italian izzy18_94fa29a3:

    # pc "I love you too, Izzy."
    pc "Anch’io ti voglio bene, Izzy."

# game/Scenes/Izzy/izzy18.rpy:180
translate italian izzy18_6d9bb252:

    # gl "You should probably go, though."
    gl "Probabilmente dovresti andare, però."

# game/Scenes/Izzy/izzy18.rpy:181
translate italian izzy18_ec0cf9f3:

    # gl "I'd love to have you stay the night, but things are probably going to be a little different with my brothers here now."
    gl "Mi piacerebbe che restassi qui stanotte, ma le cose probabilmente saranno un po’ diverse ora che ci sono i miei fratelli."

# game/Scenes/Izzy/izzy18.rpy:182
translate italian izzy18_fc7890c0:

    # gl "We can't just be fucking like crazy with them in the other room, you know?"
    gl "Non possiamo semplicemente scopare come matti con loro nell’altra stanza, lo sai?"

# game/Scenes/Izzy/izzy18.rpy:183
translate italian izzy18_34b44705:

    # pc "I understand."
    pc "Capisco."

# game/Scenes/Izzy/izzy18.rpy:186
translate italian izzy18_fc89ad79:

    # gl "But I'm still going to find time to get some of that dick."
    gl "Ma troverò comunque il tempo per farmi un po’ di quel cazzo."

# game/Scenes/Izzy/izzy18.rpy:187
translate italian izzy18_07324fcb:

    # gl "Trust."
    gl "Fidati."

# game/Scenes/Izzy/izzy18.rpy:190
translate italian izzy18_7791a395:

    # "We say our goodbyes, then I leave to go on with my night."
    "Ci salutiamo, poi me ne vado per continuare la mia serata."

# game/Scenes/Izzy/izzy18.rpy:191
translate italian izzy18_f06e0923:

    # "I just like seeing Izzy happy again."
    "Mi piace solo vedere Izzy di nuovo felice."

