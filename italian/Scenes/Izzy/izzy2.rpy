# game/Scenes/Izzy/izzy2.rpy:32
translate italian izzy2_6e6d4843:

    # gl "Not many people who have the guts to stand their ground against Moose."
    gl "Non sono in molti ad avere il coraggio di tenere testa a Moose."

# game/Scenes/Izzy/izzy2.rpy:34
translate italian izzy2_d41d8cd9_2:

    # voice 'voices/izzy_2_3.mp3'
    voice 'voices/izzy_2_3.mp3'

# game/Scenes/Izzy/izzy2.rpy:35
translate italian izzy2_728d74b7:

    # gl "You're alright. You can hang with us."
    gl "Sei a posto. Puoi stare con noi."

# game/Scenes/Izzy/izzy2.rpy:37
translate italian izzy2_d41d8cd9_3:

    # voice 'voices/izzy_2_4.mp3'
    voice 'voices/izzy_2_4.mp3'

# game/Scenes/Izzy/izzy2.rpy:38
translate italian izzy2_e3c5fbdd:

    # gl "I'm Izzy. These guys are my gang."
    gl "Io sono Izzy. Questi ragazzi sono la mia banda."

# game/Scenes/Izzy/izzy2.rpy:39
translate italian izzy2_a0189c31:

    # moose "YOUR gang?"
    moose "La TUA banda?"

# game/Scenes/Izzy/izzy2.rpy:40
translate italian izzy2_f87a2e20:

    # gl "Yeah, Moose. MY gang. You have a problem with that?"
    gl "Sì, Moose. La MIA banda. Ti crea qualche problema?"

# game/Scenes/Izzy/izzy2.rpy:41
translate italian izzy2_bf630c9b:

    # moose "Naw, sis. No problem."
    moose "No, sorella. Nessun problema."

# game/Scenes/Izzy/izzy2.rpy:43
translate italian izzy2_d41d8cd9_4:

    # voice 'voices/izzy_2_5.mp3'
    voice 'voices/izzy_2_5.mp3'

# game/Scenes/Izzy/izzy2.rpy:44
translate italian izzy2_b260b0b6:

    # gl "You know Moose. The shirtless Bruce Lee-looking boy-toy over there is Mal."
    gl "Conosci Moose. Quel ragazzo a torso nudo che sembra Bruce Lee laggiù è Mal."

# game/Scenes/Izzy/izzy2.rpy:45
translate italian izzy2_3e106586:

    # mal "Wassup?"
    mal "Come va?"

# game/Scenes/Izzy/izzy2.rpy:47
translate italian izzy2_d41d8cd9_5:

    # voice 'voices/izzy_2_7.mp3'
    voice 'voices/izzy_2_7.mp3'

# game/Scenes/Izzy/izzy2.rpy:48
translate italian izzy2_45725a14:

    # gl "And tall, dark and skinny behind me is Devon. He don't talk much."
    gl "E quello alto, moro e magro dietro di me è Devon. Non parla molto."

# game/Scenes/Izzy/izzy2.rpy:49
translate italian izzy2_dc8cb990:

    # "Devon nods his head slightly at me."
    "Devon mi fa un leggero cenno con la testa."

# game/Scenes/Izzy/izzy2.rpy:50
translate italian izzy2_522e1448:

    # gl "And that's the gang. Except now there's you - Twig."
    gl "E questa è la banda. Tranne che ora ci sei tu, Twig."

# game/Scenes/Izzy/izzy2.rpy:51
translate italian izzy2_8b86df4b:

    # pc "My name is--"
    pc "Mi chiamo..."

# game/Scenes/Izzy/izzy2.rpy:52
translate italian izzy2_28bea8fd:

    # "Just then the chirp of a police siren and a flashing light in the distance catches everyone's attention."
    "Proprio in quel momento, il suono di una sirena della polizia e una luce lampeggiante in lontananza attirano l’attenzione di tutti."

# game/Scenes/Izzy/izzy2.rpy:55
translate italian izzy2_40384605:

    # mal "Cops!"
    mal "Poliziotti!"

# game/Scenes/Izzy/izzy2.rpy:56
translate italian izzy2_3a4267e8:

    # moose "Oh shit, I gotta get out of here!"
    moose "Oh merda, devo andarmene da qui!"

# game/Scenes/Izzy/izzy2.rpy:57
translate italian izzy2_db9ea3d3:

    # gl "Damn, gotta split."
    gl "Cavolo, devo sparire."

# game/Scenes/Izzy/izzy2.rpy:60
translate italian izzy2_84f98777:

    # gl "You come back and hang out with us sometime."
    gl "Torna a trovarci qualche volta."

# game/Scenes/Izzy/izzy2.rpy:61
translate italian izzy2_37f4bf94:

    # gl "We know how to have a good time."
    gl "Sappiamo come divertirci."

# game/Scenes/Izzy/izzy2.rpy:62
translate italian izzy2_d2b269a7:

    # gl "See you later, Twig."
    gl "Ci vediamo più tardi, Twig."

# game/Scenes/Izzy/izzy2.rpy:65
translate italian izzy2_dbce667a:

    # "With that, she runs off in the same direction as the others."
    "Detto questo, lei scappa nella stessa direzione degli altri."

# game/Scenes/Izzy/izzy2.rpy:66
translate italian izzy2_4f647b81:

    # "I turn and walk back to my car."
    "Mi volto e torno alla mia auto."

# game/Scenes/Izzy/izzy2.rpy:67
translate italian izzy2_56b73e22:

    # "The police sirens and lights fade away. I'm not even sure they were aware of Izzy and her gang."
    "Le sirene e le luci della polizia si allontanano. Non sono nemmeno sicuro che si siano accorti di Izzy e della sua banda."

# game/Scenes/Izzy/izzy2.rpy:68
translate italian izzy2_b8cda32c:

    # "I wonder why they are so jumpy?"
    "Mi chiedo perché siano così nervosi?"

# game/Scenes/Izzy/izzy2.rpy:69
translate italian izzy2_b0b60482:

    # "I'll have to come back and hang out with them some other time. For now I get in my car and drive away."
    "Dovrò tornare a passare un po’ di tempo con loro un’altra volta. Per ora salgo in macchina e me ne vado."

