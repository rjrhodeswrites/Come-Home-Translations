# game/Scenes/Izzy/izzy2.rpy:13
translate italian izzy2_b51311fa:

    # "I'm not going to run though. I'm confident in myself."
    "Non ho intenzione di scappare, però. Ho fiducia in me stesso."

# game/Scenes/Izzy/izzy2.rpy:14
translate italian izzy2_a9a2f7bf:

    # "Maybe he'll kick my ass, but I'm not running."
    "Forse mi farà il culo, ma non scapperò."

# game/Scenes/Izzy/izzy2.rpy:17
translate italian izzy2_da02f2e6:

    # "When Moose is about to slam into me, I quickly step aside and instead he trips forward, tumbling through the air."
    "Quando Moose sta per piombarmi addosso, faccio rapidamente un passo di lato e lui invece inciampa in avanti, volteggiando in aria."

# game/Scenes/Izzy/izzy2.rpy:20
translate italian izzy2_4a1e9586:

    # "He slams hard into the ground and lies there moaning."
    "Si schianta violentemente a terra e rimane lì a gemere."

# game/Scenes/Izzy/izzy2.rpy:21
translate italian izzy2_7575cb2e:

    # "Izzy and the others burst into laughter, pointing at him."
    "Izzy e gli altri scoppiano a ridere, indicandolo."

# game/Scenes/Izzy/izzy2.rpy:22
translate italian izzy2_58f4b0c6:

    # moose "S'not funny, man."
    moose "Non è divertente, amico."

# game/Scenes/Izzy/izzy2.rpy:23
translate italian izzy2_fa71cc47:

    # mal "I don't know about that."
    mal "Non ne sono così sicuro."

# game/Scenes/Izzy/izzy2.rpy:24
translate italian izzy2_0a29e854:

    # gl "Pretty damn funny to me."
    gl "A me sembra dannatamente divertente."

# game/Scenes/Izzy/izzy2.rpy:28
