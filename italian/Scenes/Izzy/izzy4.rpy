translate italian izzy4_4024ac17:

    # "I hang out with Izzy and her gang for a while."
    "Passo un po’ di tempo con Izzy e la sua banda."

# game/Scenes/Izzy/izzy4.rpy:15
translate italian izzy4_13ec06b7:

    # gl "You know, Twig, I like you."
    gl "Sai, Twig, mi piaci."

# game/Scenes/Izzy/izzy4.rpy:18
translate italian izzy4_6eac563e:

    # gl "You start coming around here even though you don't quite fit in and you just force your way into my group."
    gl "Cominci a venire da queste parti anche se non ti integri del tutto e ti imponi a forza nel mio gruppo."

# game/Scenes/Izzy/izzy4.rpy:19
translate italian izzy4_587e3e94:

    # gl "I like that tenacity. It's pretty hot actually."
    gl "Mi piace quella tenacia. In realtà è piuttosto sexy."

# game/Scenes/Izzy/izzy4.rpy:20
translate italian izzy4_5997026a:

    # gl "Anyway, here's my phone number."
    gl "Comunque, ecco il mio numero di telefono."

# game/Scenes/Izzy/izzy4.rpy:21
translate italian izzy4_9efb5f7a:

    # gl "So we can talk sometime without these knuckle-heads hanging around."
    gl "Così possiamo parlare qualche volta senza questi idioti tra i piedi."

# game/Scenes/Izzy/izzy4.rpy:22
translate italian izzy4_ef3bfa78:

    # pc "What about Devon? Isn't he your boyfriend?"
    pc "E Devon? Non è il tuo ragazzo?"

# game/Scenes/Izzy/izzy4.rpy:23
translate italian izzy4_ae3aabd6:

    # gl "I told you. I do what I want."
    gl "Te l’ho detto. Faccio quello che voglio."

# game/Scenes/Izzy/izzy4.rpy:24
translate italian izzy4_3cb128b8:

    # gl "And I want to talk to you solo sometime."
    gl "E voglio parlarti da sola qualche volta."

# game/Scenes/Izzy/izzy4.rpy:25
translate italian izzy4_136391eb:

    # gl "That okay?"
    gl "Ti sta bene?"

# game/Scenes/Izzy/izzy4.rpy:26
translate italian izzy4_4f1735dd:

    # pc "Sounds good to me."
    pc "Per me va bene."

# game/Scenes/Izzy/izzy4.rpy:27
translate italian izzy4_74f6beab:

    # gl "Good. Call me sometime."
    gl "Bene. Chiamami qualche volta."

# game/Scenes/Izzy/izzy4.rpy:28
translate italian izzy4_08551511:

    # pc "You got it."
    pc "Ci puoi contare."

# game/Scenes/Izzy/izzy4.rpy:32
translate italian izzy4_41084d43:

    # "I add Izzy's phone number into my contacts list."
    "Aggiungo il numero di telefono di Izzy alla mia rubrica."

# game/Scenes/Izzy/izzy4.rpy:34
translate italian izzy4_ade661fa:

    # "We hang out a little longer, smoking and dancing."
    "Restiamo insieme ancora un po’, fumando e ballando."

# game/Scenes/Izzy/izzy4.rpy:36
translate italian izzy4_2c51ee8c:

    # "We hang out a little longer, just chatting and dancing."
    "Restiamo ancora un po' insieme, chiacchierando e ballando."

# game/Scenes/Izzy/izzy4.rpy:37
translate italian izzy4_a42d0c9d:

    # "The cops don't even show up tonight. They must be busy working some actual crimes."
    "Stasera la polizia non si fa nemmeno vedere. Devono essere impegnati a occuparsi di veri crimini."

# game/Scenes/Izzy/izzy4.rpy:38
translate italian izzy4_fce6a84a:

    # "It's a good time."
    "È una bella serata."

# game/Scenes/Izzy/izzy4.rpy:39
translate italian izzy4_efe3ccf0:

    # "Then when it's time to leave, everybody goes their separate ways and I head back to the car and drive off."
    "Poi, quando è ora di andarsene, ognuno va per la propria strada e io torno alla macchina e me ne vado."

