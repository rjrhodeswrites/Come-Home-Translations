# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:66
translate italian izzyluigisdatestart_dcbc938c_1:

    # gl "Cool, let's go."
    gl "Fantastico, andiamo."

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:69
translate italian izzyluigisdatestart_a9bda5cf:

    # gl "Damn, a girl can hope. Thanks for the food anyway, Twig. See ya later."
    gl "Cavolo, una ragazza può sempre sperare. Grazie comunque per la cena, Twig. Ci vediamo dopo."

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:70
translate italian izzyluigisdatestart_63fc4244:

    # pc "Bye, Izzy."
    pc "Ciao, Izzy."

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:73
translate italian izzyluigisdatestart_8b93ebfd:

