# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:33
translate italian izzyluigisdatestart_7abda82a:

    # gl "What's up, Twig. Let's go get some fucking pizza."
    gl "Come va, Twig. Andiamo a mangiarci un po’ di fottuta pizza."

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:37
translate italian izzyluigisdatestart_008f10b6:

    # gl "Wow, this place is a little more fancy than I expected."
    gl "Wow, questo posto è un po’ più elegante di quanto mi aspettassi."

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:38
translate italian izzyluigisdatestart_8fffd4a0:

    # gl "Maybe I should have put on some makeup or something."
    gl "Forse avrei dovuto truccarmi un po’ o qualcosa del genere."

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:39
translate italian izzyluigisdatestart_560798c7:

    # pc "You look great. Don't worry about it."
    pc "Stai benissimo. Non preoccuparti."

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:41
translate italian izzyluigisdatestart_5efd3620:

    # gl "Alright then. Thanks, Twig."
    gl "Va bene allora. Grazie, Twig."

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:45
translate italian izzyluigisdatestart_868de71e:

    # "We sit at the booth and order a pizza."
    "Ci sediamo al tavolo e ordiniamo una pizza."

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:46
translate italian izzyluigisdatestart_a675496b:

    # "We start talking and don't stop the whole time we're there."
    "Iniziamo a parlare e non smettiamo per tutto il tempo che restiamo lì."

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:53
translate italian izzyluigisdatestart_d0143732:

    # "When we're done eating, I drive Izzy back to her house."
    "Quando abbiamo finito di mangiare, accompagno Izzy a casa sua."

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:54
translate italian izzyluigisdatestart_2a5b6b89:

    # "I pull into her driveway and she turns to look at me."
    "Entro nel suo vialetto e lei si gira a guardarmi."

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:56
translate italian izzyluigisdatestart_6dd86d8c:

    # gl "So, do you want to come inside and fuck a little?"
    gl "Allora, ti va di entrare e scopare un po’?"

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:63
translate italian izzyluigisdatestart_dcbc938c:

    # gl "Cool, let's go."
