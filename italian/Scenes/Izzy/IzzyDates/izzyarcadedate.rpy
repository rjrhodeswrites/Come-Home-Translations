# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:30
translate italian izzyarcadedatestart_515d2991:

    # gl "What's up, Twig. Let's go play some games."
    gl "Come va, Twig? Andiamo a giocare un po'."

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:36
translate italian izzyarcadedatestart_605a4d9f:

    # gl "Hey, this place is pretty cool. I bet Stanley and Paul would love it."
    gl "Ehi, questo posto è davvero figo. Scommetto che a Stanley e Paul piacerebbe un sacco."

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:37
translate italian izzyarcadedatestart_b1581a15:

    # gl "Maybe we could bring them sometime, when I'm able to."
    gl "Magari potremmo portarli qui qualche volta, quando ne avrò la possibilità."

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:38
translate italian izzyarcadedatestart_8de112f2:

    # pc "Yeah for sure, that sounds fun."
    pc "Sì, certo, sembra divertente."

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:45
translate italian izzyarcadedatestart_f9357be7:

    # "We play games and chat for a while."
    "Giochiamo e chiacchieriamo per un po'."

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:49
translate italian izzyarcadedatestart_66506ca5:

    # "We try out a few different games."
    "Proviamo alcuni giochi diversi."

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:57
translate italian izzyarcadedatestart_726fbd6c:

    # "It's all fun and she seems to have a good time."
    "È tutto divertente e lei sembra divertirsi."

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:59
translate italian izzyarcadedatestart_84d584ed:

    # "When we're done playing, I drive Izzy back to her house."
    "Quando finiamo di giocare, riaccompagno Izzy a casa sua."

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:60
translate italian izzyarcadedatestart_2a5b6b89:

    # "I pull into her driveway and she turns to look at me."
    "Entro nel suo vialetto e lei si gira a guardarmi."

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:62
translate italian izzyarcadedatestart_6dd86d8c:

    # gl "So, do you want to come inside and fuck a little?"
    gl "Allora, vuoi entrare e scopare un po’?"

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:69
translate italian izzyarcadedatestart_dcbc938c:

    # gl "Cool, let's go."
    gl "Fantastico, andiamo."

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:72
translate italian izzyarcadedatestart_dcbc938c_1:

    # gl "Cool, let's go."
    gl "Fantastico, andiamo."

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:75
translate italian izzyarcadedatestart_7c186cf5:

    # gl "Damn. Well thanks for hanging out anyway. It was fun."
    gl "Cavolo. Beh, grazie comunque per aver passato un po’ di tempo con me. È stato divertente."

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:76
translate italian izzyarcadedatestart_63fc4244:

    # pc "Bye, Izzy."
    pc "Ciao, Izzy."

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:79
translate italian izzyarcadedatestart_8b93ebfd:

    # "I wait until she gets out and walks into her house before I drive away."
    "Aspetto che esca ed entri in casa prima di andarmene in macchina."

