# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:34
translate italian izzymoviedatestart_01687529:

    # gl "What's up, Twig. Let's go see this movie."
    gl "Come va, Twig? Andiamo a vedere questo film."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:38
translate italian izzymoviedatestart_00bfd309:

    # gl "This is kinda fun actually. Been a while since I've gone to the movies."
    gl "In realtà è piuttosto divertente. È da un po’ che non vado al cinema."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:39
translate italian izzymoviedatestart_3746eb4d:

    # gl "Except taking my brothers to see Shrek and shit."
    gl "A parte quando ho portato i miei fratelli a vedere Shrek e roba del genere."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:40
translate italian izzymoviedatestart_fefe72bc:

    # gl "Not on a date or anything, anyways."
    gl "Non è un appuntamento o roba del genere, comunque."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:41
translate italian izzymoviedatestart_a14fd1a7:

    # pc "So it is a date?"
    pc "Quindi è un appuntamento?"

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:43
translate italian izzymoviedatestart_92636968:

    # gl "You want to date me? Like, seriously?"
    gl "Vuoi uscire con me? Cioè, sul serio?"

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:46
translate italian izzymoviedatestart_4e0b05f2:

    # gl "You know I'm not into the whole monogamy thing though, right?"
    gl "Sai che non mi interessa tutta quella storia della monogamia, vero?"

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:47
translate italian izzymoviedatestart_e9418800:

    # pc "I'm not really either."
    pc "Neanch’io, in realtà."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:48
translate italian izzymoviedatestart_4dabe89e:

    # gl "So you keep fucking who you want and I keep fucking who I want, but we also go on dates and fuck each other?"
    gl "Quindi tu continui a scoparti chi vuoi e io continuo a scoparmi chi voglio, ma usciamo insieme e ci scopiamo a vicenda?"

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:49
translate italian izzymoviedatestart_0aa625bf:

    # pc "I mean, that sounds cool to me."
    pc "Insomma, a me sembra una cosa figa."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:51
translate italian izzymoviedatestart_0933ffde:

    # gl "Me too. Let's just keep it simple. As long as you're not trying to chain me down, I'm happy with the situation."
    gl "Anche a me. Facciamo in modo che sia semplice. Finché non cerchi di incatenarmi, mi va bene così."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:52
translate italian izzymoviedatestart_2843a332:

    # gl "The moment you tell me I can't do what I want to do, we'll have problems."
    gl "Nel momento in cui mi dici che non posso fare quello che voglio, avremo dei problemi."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:53
translate italian izzymoviedatestart_0d652c29:

    # pc "I wouldn't do that."
    pc "Non lo farei mai."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:55
translate italian izzymoviedatestart_2e09af75:

    # gl "Cool. We can date then. We're dating."
    gl "Perfetto. Allora possiamo uscire insieme. Stiamo uscendo insieme."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:56
translate italian izzymoviedatestart_9900eca8:

    # pc "Cool."
    pc "Perfetto."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:60
translate italian izzymoviedatestart_208b86a1:

    # gl "Cool, that's all I want. You fuck who you want, and I fuck who I want."
    gl "Perfetto, è tutto quello che voglio. Tu ti scopi chi vuoi e io mi scopo chi voglio."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:61
translate italian izzymoviedatestart_92ed55df:

    # gl "And if we want to go see a movie, or grab dinner together, we don't have to call it dating."
    gl "E se vogliamo andare a vedere un film o cenare insieme, non dobbiamo per forza chiamarlo “uscire insieme”."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:62
translate italian izzymoviedatestart_df196688:

    # gl "We're just watching a movie."
    gl "Stiamo solo guardando un film."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:63
translate italian izzymoviedatestart_7acad64a:

    # pc "Right."
    pc "Giusto."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:64
translate italian izzymoviedatestart_3dff977c:

    # gl "Cool."
    gl "Fantastico."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:68
translate italian izzymoviedatestart_62737a7b:

    # "We find a seat in the back and chat a bit until the movie starts."
    "Troviamo un posto in fondo alla sala e chiacchieriamo un po’ finché non inizia il film."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:73
translate italian izzymoviedatestart_56f38f5f:

    # "The movie starts and we go quiet."
    "Il film inizia e restiamo in silenzio."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:75
translate italian izzymoviedatestart_4c04d5aa:

    # "It's a fun movie and Izzy laughs a lot."
    "È un film divertente e Izzy ride un sacco."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:77
translate italian izzymoviedatestart_0edfdae0:

    # "When it ends, she turns to me."
    "Quando finisce, si gira verso di me."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:78
translate italian izzymoviedatestart_4746d3c6:

    # gl "That was pretty damn good, huh?"
    gl "Era davvero fantastico, eh?"

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:79
translate italian izzymoviedatestart_5867f7ce:

    # "We hang out and chat some while the credits roll."
    "Restiamo lì a chiacchierare un po’ mentre scorrono i titoli di coda."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:83
translate italian izzymoviedatestart_28be3ae8:

    # "When the credits end, I drive Izzy back to her house."
    "Quando finiscono i titoli di coda, accompagno Izzy a casa sua."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:84
translate italian izzymoviedatestart_2a5b6b89:

    # "I pull into her driveway and she turns to look at me."
    "Mi fermo nel suo vialetto e lei si gira a guardarmi."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:86
translate italian izzymoviedatestart_6dd86d8c:

    # gl "So, do you want to come inside and fuck a little?"
    gl "Allora, ti va di entrare e scopare un po’?"

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:92
translate italian izzymoviedatestart_dcbc938c:

    # gl "Cool, let's go."
    gl "Fantastico, andiamo."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:95
translate italian izzymoviedatestart_dcbc938c_1:

    # gl "Cool, let's go."
    gl "Fantastico, andiamo."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:98
translate italian izzymoviedatestart_9a2ffc1c:

    # gl "Damn, fingers it is then. Thanks for the movie anyway, Twig. See ya later."
    gl "Cavolo, allora ci accontenteremo delle dita. Grazie comunque per il film, Twig. Ci vediamo dopo."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:99
translate italian izzymoviedatestart_63fc4244:

    # pc "Bye, Izzy."
    pc "Ciao, Izzy."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:102
translate italian izzymoviedatestart_8b93ebfd:

    # "I wait until she gets out and walks into her house before I drive away."
    "Aspetto che scenda dall’auto ed entri in casa prima di andarmene."

