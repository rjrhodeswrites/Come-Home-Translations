translate italian izzys9_ae437aea:

    # gl "The fuck you talking about, Twig?"
    gl "Ma di che cazzo stai parlando, Twig?"

# game/Scenes/Izzy/izzyconversations/izzys9.rpy:46
translate italian izzys9_2d0ab043:

    # pc "Oh, it's just a board game... nevermind."
    pc "Oh, è solo un gioco da tavolo.... lascia perdere."

