# game/Scenes/Jez/jez5.rpy:9
translate italian jez5_98ca1a51:

    # "My phone buzzes in my pocket."
    "Il mio telefono vibra in tasca."

# game/Scenes/Jez/jez5.rpy:13
translate italian jez5_450455fc:

    # "It's Detective Rodriguez. I wonder if she's found something out about my dad."
    "È la detective Rodriguez. Mi chiedo se abbia scoperto qualcosa su mio padre."

# game/Scenes/Jez/jez5.rpy:16
translate italian jez5_bea5e8cb:

    # pc "Hello?"
    pc "Pronto?"

# game/Scenes/Jez/jez5.rpy:18
translate italian jez5_d41d8cd9:

    # voice 'voices/jez_hey.mp3'
    voice 'voices/jez_hey.mp3'

# game/Scenes/Jez/jez5.rpy:19
translate italian jez5_31f304d3:

    # det "Hey, [pcname]."
    det "Ehi, [pcname]."

# game/Scenes/Jez/jez5.rpy:20
translate italian jez5_704218da:

    # pc "Did you find anything?"
    pc "Hai scoperto qualcosa?"

# game/Scenes/Jez/jez5.rpy:22
translate italian jez5_dd220c64:

    # det "What? Oh! About your dad?"
    det "Cosa? Oh! Su tuo padre?"

# game/Scenes/Jez/jez5.rpy:24
translate italian jez5_e8fe8a8c:

    # det "Oh God, no I'm sorry. I wasn't calling about your dad, but I can understand why you'd think that."
    det "Oh Dio, no, mi dispiace. Non ti stavo chiamando per tuo padre, ma capisco perché l’hai pensato."

# game/Scenes/Jez/jez5.rpy:25
translate italian jez5_1559f8f9:

    # det "With me being a detective and on your dad's case and all."
    det "Visto che sono un detective e mi occupo del caso di tuo padre e tutto il resto."

# game/Scenes/Jez/jez5.rpy:26
translate italian jez5_8c3ac124:

    # det "God, I'm a horrible detective aren't I?"
    det "Dio, sono un detective terribile, vero?"

# game/Scenes/Jez/jez5.rpy:27
translate italian jez5_a807c23e:

    # pc "No, I don't think so. What did you call for then?"
    pc "No, non credo. Allora perché mi hai chiamato?"

# game/Scenes/Jez/jez5.rpy:30
translate italian jez5_d41d8cd9_1:

    # voice 'voices/jez_5_1.mp3'
    voice 'voices/jez_5_1.mp3'

# game/Scenes/Jez/jez5.rpy:31
translate italian jez5_0a63889f:

    # det "Well, I had kind of a rough day and I wanted to talk to somebody."
    det "Beh, ho avuto una giornata un po’ difficile e volevo parlare con qualcuno."

# game/Scenes/Jez/jez5.rpy:33
translate italian jez5_d41d8cd9_2:

    # voice 'voices/jez_5_2.mp3'
    voice 'voices/jez_5_2.mp3'

# game/Scenes/Jez/jez5.rpy:34
translate italian jez5_ea09e714:

    # det "And you were nice to me in the past, when we went out for drinks."
    det "E in passato sei stato gentile con me, quando siamo usciti a bere qualcosa."

# game/Scenes/Jez/jez5.rpy:36
translate italian jez5_d41d8cd9_3:

    # voice 'voices/jez_5_3.mp3'
    voice 'voices/jez_5_3.mp3'

# game/Scenes/Jez/jez5.rpy:37
translate italian jez5_307d2b53:

    # det "And I don't really have anybody else to talk to."
    det "E non ho davvero nessun altro con cui parlare."

# game/Scenes/Jez/jez5.rpy:39
translate italian jez5_d41d8cd9_4:

    # voice 'voices/jez_5_4.mp3'
    voice 'voices/jez_5_4.mp3'

# game/Scenes/Jez/jez5.rpy:40
translate italian jez5_0f2cd5d3:

    # det "So I was wondering if you would want to just talk some?"
    det "Quindi mi chiedevo se ti andasse di fare due chiacchiere?"

# game/Scenes/Jez/jez5.rpy:46
translate italian jez5_47059538:

    # det "You're right. This was a mistake, I'm sorry."
    det "Hai ragione. È stato un errore, mi dispiace."

# game/Scenes/Jez/jez5.rpy:47
translate italian jez5_ec16f7c0:

    # det "I won't bother you any more until I have information on your dad."
    det "Non ti darò più fastidio finché non avrò informazioni su tuo padre."

# game/Scenes/Jez/jez5.rpy:48
translate italian jez5_07fc1b9f:

    # det "Bye, [pcname]."
    det "Ciao, [pcname]."

# game/Scenes/Jez/jez5.rpy:52
translate italian jez5_5429a27f:

    # "She hangs up and I lie down to go to sleep."
    "Lei riattacca e io mi sdraio per andare a dormire."

# game/Scenes/Jez/jez5.rpy:53
translate italian jez5_ceaf3431:

    # "I can hardly believe that she wants to call me and dump her problems on me. Don't I have enough of my own to deal with?"
    "Faccio fatica a credere che voglia chiamarmi per scaricare i suoi problemi su di me. Non ne ho già abbastanza da affrontare?"

# game/Scenes/Jez/jez5.rpy:54
translate italian jez5_0a396100:

    # "I mean, my dad is missing and it doesn't seem like she's doing much of anything to find him."
    "Insomma, mio padre è scomparso e non mi sembra che lei stia facendo granché per ritrovarlo."

# game/Scenes/Jez/jez5.rpy:55
translate italian jez5_a9441b54:

    # "Maybe I was a little harsh with her, but she needs to do her damn job."
    "Forse sono stato un po’ duro con lei, ma deve fare il suo maledetto lavoro."

# game/Scenes/Jez/jez5.rpy:56
translate italian jez5_437235da:

    # "I fall asleep, still upset about the whole thing."
    "Mi addormento, ancora arrabbiato per tutta la faccenda."

# game/Scenes/Jez/jez5.rpy:62
translate italian jez5_9f04dd80:

    # det "My Chief is yelling at me all the time because I haven't been able to track down this meth manufacturer."
    det "Il mio capo mi sgrida continuamente perché non sono riuscito a rintracciare questo produttore di metanfetamine."

# game/Scenes/Jez/jez5.rpy:63
translate italian jez5_2edb985d:

    # det "It's like, I'm trying. There's only so much I can do."
    det "È che ci sto provando. C’è un limite a quello che posso fare."

# game/Scenes/Jez/jez5.rpy:64
translate italian jez5_d637e4b1:

    # det "I spend most of my day on stakeouts watching drug handoffs."
    det "Passo la maggior parte della giornata in appostamento a osservare le consegne di droga."

# game/Scenes/Jez/jez5.rpy:65
translate italian jez5_b65d63fc:

    # det "Or interrogating people, trying to push them into telling me something."
    det "Oppure a interrogare le persone, cercando di spingerle a dirmi qualcosa."

# game/Scenes/Jez/jez5.rpy:66
translate italian jez5_e4fde77f:

    # det "But nobody's giving anything up and I'm running out of leads."
    det "Ma nessuno confessa nulla e sto esaurendo le piste."

# game/Scenes/Jez/jez5.rpy:67
translate italian jez5_45b6d6aa:

    # det "There's only two detectives on this case. A big meth ring and just two of us."
    det "Ci sono solo due detective su questo caso. Un grande giro di metanfetamine e solo noi due."

# game/Scenes/Jez/jez5.rpy:68
translate italian jez5_77a9cef6:

    # det "I mean Skyhill is a small town, so I get it, but I need more help here."
    det "Insomma, Skyhill è una piccola città, quindi lo capisco, ma ho bisogno di più aiuto qui."

# game/Scenes/Jez/jez5.rpy:69
translate italian jez5_72d52a4d:

    # det "I wish we could call in the state police, or the FBI or something, but the Chief won't have it. Says we have to handle this ourselves."
    det "Vorrei poter chiamare la polizia di Stato, o l’FBI o qualcosa del genere, ma il capo non ne vuole sapere. Dice che dobbiamo gestirlo da soli."

# game/Scenes/Jez/jez5.rpy:70
translate italian jez5_d8b3de1e:

    # det "But there's only so much I can do. I have other cases too - like your dad's - that I'm having to neglect because of this meth thing."
    det "Ma c’è un limite a quello che posso fare. Ho anche altri casi – come quello di tuo padre – che sto trascurando a causa di questa faccenda della metanfetamina."

# game/Scenes/Jez/jez5.rpy:72
translate italian jez5_88d7e875:

    # det "And today I had to raid the house of this methhead."
    det "E oggi ho dovuto fare irruzione a casa di questa tossica."

# game/Scenes/Jez/jez5.rpy:73
translate italian jez5_d5874b9e:

    # det "It was horrible. This woman, her house was disgusting. Her baby, a three-year-old girl, was sitting in the middle of a bunch of filth naked."
    det "È stato orribile. La casa di questa donna era disgustosa. La sua bambina, una bimba di tre anni, era seduta nuda in mezzo a un mucchio di sporcizia."

# game/Scenes/Jez/jez5.rpy:74
translate italian jez5_2823a872:

    # det "And I had to take this child, who was screaming and crying that she didn't want to leave her mom, and give the child to protective services."
    det "E ho dovuto prendere questa bambina, che urlava e piangeva perché non voleva lasciare la mamma, e affidarla ai servizi sociali."

# game/Scenes/Jez/jez5.rpy:75
translate italian jez5_e5dd6ea8:

    # det "The girl will probably have a better life in foster care than she would have with her mother, but who knows. She could end up with some abusive assholes or something."
    det "Probabilmente la bambina avrà una vita migliore in affidamento rispetto a quella che avrebbe avuto con sua madre, ma chi lo sa. Potrebbe finire con qualche stronzo violento o qualcosa del genere."

# game/Scenes/Jez/jez5.rpy:76
translate italian jez5_5e97fe72:

    # det "That little girl's life is messed up no matter what happens now."
    det "La vita di quella bambina è rovinata, qualunque cosa accada ora."

# game/Scenes/Jez/jez5.rpy:77
translate italian jez5_a1286de7:

    # det "And it just makes me so sad."
    det "E questo mi rende davvero triste."

# game/Scenes/Jez/jez5.rpy:78
translate italian jez5_89052a8b:

    # pc "I'm sorry. That's awful."
    pc "Mi dispiace. È terribile."

# game/Scenes/Jez/jez5.rpy:80
translate italian jez5_97380cd0:

    # det "So I get the woman back to the station and start interrogating her."
    det "Quindi ho portato la donna alla stazione di polizia e ho iniziato a interrogarla."

# game/Scenes/Jez/jez5.rpy:81
translate italian jez5_3e4784a1:

    # det "She's going to jail for at least five years for possession, probably will get a child endangerment charge as well, but she won't give up her dealer."
    det "Andrà in galera per almeno cinque anni per possesso, probabilmente le verrà contestato anche il reato di maltrattamento di minori, ma non vuole fare il nome del suo spacciatore."

# game/Scenes/Jez/jez5.rpy:82
translate italian jez5_19e09092:

    # det "I don't fucking get it."
    det "Non ci capisco un cazzo."

# game/Scenes/Jez/jez5.rpy:83
translate italian jez5_59760784:

    # det "She's scared that something will happen to her family if she snitches."
    det "Ha paura che succeda qualcosa alla sua famiglia se fa la spia."

# game/Scenes/Jez/jez5.rpy:84
translate italian jez5_c0f63ffe:

    # det "Spits in my face, calls me a pig. I wanted to beat her fucking head in."
    det "Mi sputa in faccia, mi chiama maiale. Avrei voluto spaccarle quella cazzo di testa."

# game/Scenes/Jez/jez5.rpy:85
translate italian jez5_c36e96d1:

    # det "Then I get chewed out by the Chief because I didn't get anything out of her."
    det "Poi mi sono fatto sgridare dal capo perché non sono riuscito a tirarle fuori niente."

# game/Scenes/Jez/jez5.rpy:87
translate italian jez5_2288ac26:

    # det "And that was my day."
    det "E questa è stata la mia giornata."

# game/Scenes/Jez/jez5.rpy:88
translate italian jez5_2074c381:

    # det "I'm just so tired of all of it. I want to find this meth manufacturer and shut that shit down."
    det "Sono proprio stanca di tutto questo. Voglio trovare questo produttore di metanfetamine e smantellare quella merda."

# game/Scenes/Jez/jez5.rpy:90
translate italian jez5_3a7bef84:

    # "I think about telling her about the bunker that Izzy had sent me to."
    "Penso di dirle del bunker in cui Izzy mi aveva mandata."

# game/Scenes/Jez/jez5.rpy:91
translate italian jez5_35c47a4d:

    # "But I'm not sure that is really what she's looking for."
    "Ma non sono sicura che sia proprio quello che sta cercando."

# game/Scenes/Jez/jez5.rpy:92
translate italian jez5_7dda6c8a:

    # "Plus, I'm not sure if me and Izzy might get in some serious trouble for our part in whatever they were doing."
    "Inoltre, non so se io e Izzy potremmo finire in guai seri per il nostro coinvolgimento in qualunque cosa stessero facendo."

# game/Scenes/Jez/jez5.rpy:93
translate italian jez5_9fcbf4b8:

    # "I may tell Jez about it later, but for now I stay quiet."
    "Potrei parlarne con Jez più tardi, ma per ora tengo la bocca chiusa."

# game/Scenes/Jez/jez5.rpy:95
translate italian jez5_6387c117:

    # "I think about telling her about the bunker that Reba had taken me to."
    "Penso di dirle del bunker in cui Reba mi aveva portato."

# game/Scenes/Jez/jez5.rpy:96
translate italian jez5_35c47a4d_1:

    # "But I'm not sure that is really what she's looking for."
    "Ma non sono sicuro che sia proprio quello che sta cercando."

# game/Scenes/Jez/jez5.rpy:97
translate italian jez5_306cf091:

    # "Plus, I'm not sure if Reba might get in some serious trouble for our part in whatever they were doing."
    "Inoltre, non so se Reba potrebbe finire in guai seri per il nostro coinvolgimento in qualunque cosa stessero facendo."

# game/Scenes/Jez/jez5.rpy:98
translate italian jez5_9fcbf4b8_1:

    # "I may tell Jez about it later, but for now I stay quiet."
    "Potrei parlarne con Jez più tardi, ma per ora tengo la bocca chiusa."

# game/Scenes/Jez/jez5.rpy:99
translate italian jez5_a3049ca4:

    # det "Anyway, thanks for listening to me vent."
    det "Comunque, grazie per avermi ascoltato sfogarmi."

# game/Scenes/Jez/jez5.rpy:100
translate italian jez5_732596c5:

    # det "I needed to get all that off my chest."
    det "Avevo bisogno di togliermi tutto questo peso dallo stomaco."

# game/Scenes/Jez/jez5.rpy:101
translate italian jez5_d957ecb7:

    # pc "You feeling better now?"
    pc "Ti senti meglio adesso?"

# game/Scenes/Jez/jez5.rpy:103
translate italian jez5_880af095:

    # det "A little, yeah."
    det "Un po’, sì."

# game/Scenes/Jez/jez5.rpy:104
translate italian jez5_566089d7:

    # det "You're a pretty good listener, [pcname]. Thank you."
    det "Sei un ottimo ascoltatore, [pcname]. Grazie."

# game/Scenes/Jez/jez5.rpy:105
translate italian jez5_c46a0b54:

    # pc "Any time."
    pc "Quando vuoi."

# game/Scenes/Jez/jez5.rpy:107
translate italian jez5_1d1792a8:

    # det "I can be a good listener too, if you ever want to chat."
    det "Anch’io so ascoltare bene, se mai volessi chiacchierare."

# game/Scenes/Jez/jez5.rpy:108
translate italian jez5_d87a672d:

    # det "You could call me at nights and we could just talk or something."
    det "Potresti chiamarmi la sera e potremmo semplicemente parlare o qualcosa del genere."

# game/Scenes/Jez/jez5.rpy:110
translate italian jez5_b7c62ab4:

    # pc "That sounds good. I'll do that."
    pc "Mi sembra una buona idea. Lo farò."

# game/Scenes/Jez/jez5.rpy:112
translate italian jez5_fc19b673:

    # det "Good."
    det "Bene."

# game/Scenes/Jez/jez5.rpy:114
translate italian jez5_d41d8cd9_5:

    # voice 'voices/jez_5_5.mp3'
    voice 'voices/jez_5_5.mp3'

# game/Scenes/Jez/jez5.rpy:115
translate italian jez5_22567fb7:

    # det "Okay, [pcname], I better get to bed. Thanks for listening to me."
    det "Ok, [pcname], è meglio che vada a letto. Grazie per avermi ascoltato."

# game/Scenes/Jez/jez5.rpy:117
translate italian jez5_d41d8cd9_6:

    # voice 'voices/jez_5_6.mp3'
    voice 'voices/jez_5_6.mp3'

# game/Scenes/Jez/jez5.rpy:118
translate italian jez5_22b369a9:

    # det "I'll talk to you later."
    det "Ci sentiamo più tardi."

# game/Scenes/Jez/jez5.rpy:119
translate italian jez5_31e08f47:

    # pc "Okay, good night, Jez."
    pc "Ok, buonanotte, Jez."

# game/Scenes/Jez/jez5.rpy:121
translate italian jez5_d41d8cd9_7:

    # voice 'voices/jez_night.mp3'
    voice 'voices/jez_night.mp3'

# game/Scenes/Jez/jez5.rpy:122
translate italian jez5_8669dcbe:

    # det "Night."
    det "Notte."

# game/Scenes/Jez/jez5.rpy:125
translate italian jez5_52d6e3cf:

    # "We hang up and I get ready for bed."
    "Riattacchiamo e mi preparo per andare a letto."

# game/Scenes/Jez/jez5.rpy:126
translate italian jez5_73bafe8e:

    # "It must be hard having to deal with the things that she deals with, see the things that she sees every day."
    "Deve essere difficile dover affrontare le cose che lei affronta, vedere le cose che vede ogni giorno."

# game/Scenes/Jez/jez5.rpy:127
translate italian jez5_63d39c7b:

    # "I like that she is opening up to me though, becoming more friendly."
    "Mi piace però che si stia aprendo con me, che stia diventando più amichevole."

# game/Scenes/Jez/jez5.rpy:128
translate italian jez5_00f887ed:

    # "I actually really like her."
    "In realtà mi piace davvero tanto."

# game/Scenes/Jez/jez5.rpy:129
translate italian jez5_c6ddf2e1:

    # "I fall asleep thinking about how I'd like to spend more time with her. Hopefully we'll get a chance soon."
    "Mi addormento pensando a quanto mi piacerebbe passare più tempo con lei. Spero che ne avremo presto l’occasione."

