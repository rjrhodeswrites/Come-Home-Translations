translate italian jezs1_1078dfd4:

    # det "I grew up in St. Augustine, Florida. Right on the beach."
    det "Sono cresciuto a St. Augustine, in Florida. Proprio sulla spiaggia."

# game/Scenes/Jez/JezConversation/jezs1.rpy:17
translate italian jezs1_feca1b00:

    # pc "Wow, I bet that was nice."
    pc "Wow, immagino fosse bellissimo."

# game/Scenes/Jez/JezConversation/jezs1.rpy:19
translate italian jezs1_2c4afca9:

    # det "It was a fun place to live as a teenager."
    det "Era un posto divertente in cui vivere da adolescente."

# game/Scenes/Jez/JezConversation/jezs1.rpy:20
translate italian jezs1_1761ad9e:

    # det "I was on the beach every single day."
    det "Andavo in spiaggia ogni singolo giorno."

# game/Scenes/Jez/JezConversation/jezs1.rpy:22
translate italian jezs1_3e02f843:

    # det "Then I moved here to be with some guy. The guy who ended up being my son's father."
    det "Poi mi sono trasferita qui per stare con un ragazzo. Il ragazzo che alla fine è diventato il padre di mio figlio."

# game/Scenes/Jez/JezConversation/jezs1.rpy:23
translate italian jezs1_8cb370d1:

    # det "Then the asshole up and leaves town with a seventeen year old girl when I was six months pregnant."
    det "Poi quel cretino se n’è andato dalla città con una ragazza di diciassette anni quando ero incinta di sei mesi."

# game/Scenes/Jez/JezConversation/jezs1.rpy:24
translate italian jezs1_0d16d49e:

    # det "And seven years later, I'm still here."
    det "E sette anni dopo, sono ancora qui."

# game/Scenes/Jez/JezConversation/jezs1.rpy:25
translate italian jezs1_cd394fa1:

    # pc "That's rough. What a dick."
    pc "Che brutta storia. Che stronzo."

# game/Scenes/Jez/JezConversation/jezs1.rpy:27
translate italian jezs1_b0f07c8a:

    # det "Yeah. My mom moved here to help out."
    det "Sì. Mia mamma si è trasferita qui per darmi una mano."

# game/Scenes/Jez/JezConversation/jezs1.rpy:28
translate italian jezs1_bc8b3b93:

    # pc "You ever think about moving back to St. Augustine?"
    pc "Hai mai pensato di tornare a St. Augustine?"

# game/Scenes/Jez/JezConversation/jezs1.rpy:29
translate italian jezs1_b6fb88ef:

    # det "Nah, I don't think so."
    det "No, non credo proprio."

# game/Scenes/Jez/JezConversation/jezs1.rpy:30
translate italian jezs1_82bc3eda:

    # det "We're all set up here now and I've put too much work into this job to give it all up."
    det "Ormai ci siamo sistemati bene qui e ho investito troppo in questo lavoro per mollare tutto."

# game/Scenes/Jez/JezConversation/jezs1.rpy:32
translate italian jezs1_f209a7c1:

    # det "Plus, I kind of like the small-town vibe here in Skyhill."
    det "Inoltre, mi piace l’atmosfera da piccola città che si respira qui a Skyhill."

# game/Scenes/Jez/JezConversation/jezs1.rpy:33
translate italian jezs1_675949a8:

    # pc "Well I'm glad you're here anyway. Glad we could meet."
    pc "Beh, comunque sono contenta che tu sia qui. Sono felice che ci siamo conosciuti."

# game/Scenes/Jez/JezConversation/jezs1.rpy:35
translate italian jezs1_0cbeeb2d:

    # det "Yeah?"
    det "Davvero?"

# game/Scenes/Jez/JezConversation/jezs1.rpy:36
translate italian jezs1_92da07e2:

    # det "I guess I'm glad about that too."
    det "Credo di esserne felice anch’io."

