translate italian jezq4_0bc3d079:

    # det "I feel like I'm ready to start getting more serious."
    det "Sento di essere pronta a fare un passo più serio."

# game/Scenes/Jez/JezConversation/jezq4.rpy:28
translate italian jezq4_d024735b:

    # det "So yeah, I'd like you to move in. I'd like you to start thinking about us being exclusive, too."
    det "Quindi sì, mi piacerebbe che venissi a vivere da me. Mi piacerebbe anche che iniziassi a pensare a una relazione esclusiva tra noi."

# game/Scenes/Jez/JezConversation/jezq4.rpy:30
translate italian jezq4_ef825207:

    # det "When you're my man, I don't think I could share you anymore."
    det "Quando sarai il mio ragazzo, non credo che potrei più condividere te con altre."

# game/Scenes/Jez/JezConversation/jezq4.rpy:31
translate italian jezq4_44237835:

    # det "And I'm ready for you to be my man."
    det "E sono pronta a farti diventare il mio ragazzo."

# game/Scenes/Jez/JezConversation/jezq4.rpy:33
translate italian jezq4_9946d1c0:

    # det "So maybe you could keep some of your stuff over at my place. Stay the night a little more often..."
    det "Quindi magari potresti tenere alcune delle tue cose a casa mia. Passare la notte da me un po’ più spesso..."

# game/Scenes/Jez/JezConversation/jezq4.rpy:35
translate italian jezq4_caa20347:

    # det "Then, after you finish school, you could move in?"
    det "Poi, quando avrai finito gli studi, potresti trasferirti da me?"

# game/Scenes/Jez/JezConversation/jezq4.rpy:36
translate italian jezq4_1afac86b:

    # det "We could get more serious... maybe even think about marriage?"
    det "Potremmo fare una relazione più seria... magari anche pensare al matrimonio?"

# game/Scenes/Jez/JezConversation/jezq4.rpy:37
translate italian jezq4_ce300ccd:

    # pc "Marriage?"
    pc "Matrimonio?"

