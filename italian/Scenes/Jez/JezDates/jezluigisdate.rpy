# game/Scenes/Jez/JezDates/jezluigisdate.rpy:29
translate italian jezluigisstartdate_ec0fa6ca:

    # "I meet Jez at Luigi's and we sit and order our meals."
    "Mi incontro con Jez da Luigi's, ci sediamo e ordiniamo da mangiare."

# game/Scenes/Jez/JezDates/jezluigisdate.rpy:30
translate italian jezluigisstartdate_c57a5228:

    # "Then we chat for a while."
    "Poi chiacchieriamo per un po'."

# game/Scenes/Jez/JezDates/jezluigisdate.rpy:33
translate italian jezluigisstartdate_0875967f:

    # "The server brings our food out, and we continue talking while we eat."
    "Il cameriere ci porta il cibo e continuiamo a parlare mentre mangiamo."

# game/Scenes/Jez/JezDates/jezluigisdate.rpy:35
translate italian jezluigisstartdate_3c0f7991:

    # "When we're done eating, we just hang around and talk for a while longer."
    "Quando abbiamo finito di mangiare, restiamo lì a chiacchierare ancora un po'."

# game/Scenes/Jez/JezDates/jezluigisdate.rpy:38
translate italian jezluigisstartdate_e9a5d339:

    # "We could probably sit and chat all night, but it's starting to get late."
    "Probabilmente potremmo stare seduti a chiacchierare tutta la notte, ma si sta facendo tardi."

