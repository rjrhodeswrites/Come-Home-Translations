translate italian jezenddate_687d0176:

    # det "So, do you want to come back to my place for a while?"
    det "Allora, ti va di venire da me per un po’?"

# game/Scenes/Jez/JezDates/jezenddate.rpy:9
translate italian jezenddate_30d6b817:

    # det "Mamá's got Javi for a bit. We could spend some time together."
    det "La mamma si occupa di Javi per un po’. Potremmo passare un po’ di tempo insieme."

# game/Scenes/Jez/JezDates/jezenddate.rpy:12
translate italian jezenddate_3ba845d3:

    # det "Good, let's go."
    det "Bene, andiamo."

# game/Scenes/Jez/JezDates/jezenddate.rpy:15
translate italian jezenddate_588b9a6e:

    # "We get in our cars and I follow her back to her house, where we quickly make our way inside to her bedroom."
    "Saliamo sulle nostre auto e io la seguo fino a casa sua, dove entriamo rapidamente e ci dirigiamo verso la sua camera da letto."

# game/Scenes/Jez/JezDates/jezenddate.rpy:19
translate italian jezenddate_77b42da9:

    # det "Oh, alright then. Well I had a nice date anyway. I'll see you later, [pcname]."
    det "Oh, va bene allora. Beh, comunque è stato un bel appuntamento. Ci vediamo più tardi, [pcname]."

# game/Scenes/Jez/JezDates/jezenddate.rpy:21
translate italian jezenddate_b4d69820:

    # "I lean in and we kiss, my arms wrapped around her."
    "Mi avvicino e ci baciamo, con le mie braccia che la stringono."

# game/Scenes/Jez/JezDates/jezenddate.rpy:22
translate italian jezenddate_3091dff1:

    # pc "Bye, Jez. See you again soon."
    pc "Ciao, Jez. Ci vediamo presto."

# game/Scenes/Jez/JezDates/jezenddate.rpy:25
translate italian jezenddate_f48c2630:

    # "She leaves, and I go back out to my car and drive away."
    "Se ne va, io torno alla mia auto e me ne vado."

# game/Scenes/Jez/JezDates/jezenddate.rpy:29
translate italian jezenddate_716db417:

    # det "I had a really good time. I'm looking forward to doing this again soon."
    det "Mi sono divertito davvero tanto. Non vedo l’ora di rifarlo presto."

# game/Scenes/Jez/JezDates/jezenddate.rpy:30
translate italian jezenddate_03eaad50:

    # pc "Me too."
    pc "Anch’io."

# game/Scenes/Jez/JezDates/jezenddate.rpy:33
translate italian jezenddate_398aacb4:

    # det "I'd invite you over to my place, but I'm not quite ready for my son to meet you yet."
    det "Ti inviterei a casa mia, ma non sono ancora pronta a farti conoscere mio figlio."

# game/Scenes/Jez/JezDates/jezenddate.rpy:34
translate italian jezenddate_70367ea3:

    # det "I don't want him to get confused by male figures being in his life for only a short time."
    det "Non voglio che si senta confuso dalla presenza di figure maschili nella sua vita solo per un breve periodo."

# game/Scenes/Jez/JezDates/jezenddate.rpy:35
translate italian jezenddate_6cf8b822:

    # det "I want to make sure that this thing between me and you is real before we do that. I hope you understand."
    det "Voglio assicurarmi che questa cosa tra me e te sia reale prima di farlo. Spero che tu capisca."

# game/Scenes/Jez/JezDates/jezenddate.rpy:36
translate italian jezenddate_cca20d9e:

    # pc "I do understand."
    pc "Capisco perfettamente."

# game/Scenes/Jez/JezDates/jezenddate.rpy:38
translate italian jezenddate_3239d4cf:

    # det "Thanks."
    det "Grazie."

# game/Scenes/Jez/JezDates/jezenddate.rpy:41
translate italian jezenddate_b4d69820_1:

