translate italian jezparkstartdate_afd4a633:

    # "I meet Jez at the park for our date and we take a quiet stroll."
    "Mi incontro con Jez al parco per il nostro appuntamento e facciamo una passeggiata tranquilla."

# game/Scenes/Jez/JezDates/jezparkdate.rpy:27
translate italian jezparkstartdate_4aaf219b:

    # "We take it slow, stopping every once in a while just to talk and take in the evening air."
    "Ce la prendiamo comoda, fermandoci ogni tanto solo per chiacchierare e goderci l’aria della sera."

# game/Scenes/Jez/JezDates/jezparkdate.rpy:38
translate italian jezparkstartdate_bcda10ba:

    # "Then our talking turns into kissing."
    "Poi le nostre chiacchiere si trasformano in baci."

# game/Scenes/Jez/JezDates/jezparkdate.rpy:39
translate italian jezparkstartdate_0a0545cd:

    # det "Fuck, it's so hard for me to keep my hands off of you."
    det "Cazzo, è così difficile per me tenere le mani lontane da te."

# game/Scenes/Jez/JezDates/jezparkdate.rpy:42
translate italian jezparkstartdate_6fe2a545:

    # "Then a little more than kissing."
    "Poi qualcosa di più dei baci."

# game/Scenes/Jez/JezDates/jezparkdate.rpy:43
translate italian jezparkstartdate_56c7b013:

    # det "We should go, before I get into trouble."
    det "Dovremmo andare, prima che mi metta nei guai."

# game/Scenes/Jez/JezDates/jezparkdate.rpy:44
translate italian jezparkstartdate_c0c0e82f:

    # det "It would look pretty bad for an officer to be arrested for public indecency."
    det "Non farebbe una bella figura se un agente venisse arrestato per atti osceni in luogo pubblico."

# game/Scenes/Jez/JezDates/jezparkdate.rpy:47
translate italian jezparkstartdate_d18dd0f8:

    # "We walk back to our cars together."
    "Torniamo insieme alle nostre auto."

