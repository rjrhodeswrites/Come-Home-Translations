# game/Scenes/Jez/jez3.rpy:16
translate italian jez3_b7d0283a:

    # "Detective Rodriguez picks up the phone after a single ring, as if she had been holding her phone in her hand."
    "La detective Rodriguez risponde al telefono dopo un solo squillo, come se lo tenesse già in mano."

# game/Scenes/Jez/jez3.rpy:18
translate italian jez3_d41d8cd9:

    # voice 'voices/jez_answering.mp3'
    voice 'voices/jez_answering.mp3'

# game/Scenes/Jez/jez3.rpy:19
translate italian jez3_6673062e:

    # det "Detective Rodriguez."
    det "Detective Rodriguez."

# game/Scenes/Jez/jez3.rpy:20
translate italian jez3_416b4b28:

    # pc "Hello, this is [pcname]."
    pc "Ciao, sono [pcname]."

# game/Scenes/Jez/jez3.rpy:22
translate italian jez3_d41d8cd9_1:

    # voice 'voices/jez_hey.mp3'
    voice 'voices/jez_hey.mp3'

# game/Scenes/Jez/jez3.rpy:23
translate italian jez3_5f1522eb:

    # det "Hey, [pcname]. What's up?"
    det "Ehi, [pcname]. Come va?"

# game/Scenes/Jez/jez3.rpy:24
translate italian jez3_eb667b3e:

    # pc "I had some new information about my dad's case. I was able to get into his laptop."
    pc "Ho delle nuove informazioni sul caso di mio padre. Sono riuscito ad accedere al suo portatile."

# game/Scenes/Jez/jez3.rpy:25
translate italian jez3_a1187622:

    # pc "I found a bunch of e-mails between him and this Whitney person."
    pc "Ho trovato un sacco di e-mail tra lui e questa Whitney."

# game/Scenes/Jez/jez3.rpy:26
translate italian jez3_d2f98bdb:

    # det "Hey, [pcname]. Hold on a second."
    det "Ehi, [pcname]. Aspetta un attimo."

# game/Scenes/Jez/jez3.rpy:28
translate italian jez3_77774b9f:

    # det "I'll be honest with you. I've had a really bad day and I have a migraine from hell."
    det "Sarò sincero con te. Ho avuto una giornata davvero pessima e ho un'emicrania da urlo."

# game/Scenes/Jez/jez3.rpy:29
translate italian jez3_b0a1faa8:

    # det "Your voice on this phone is making my head pound. What do you say we meet up in person."
    det "La tua voce al telefono mi fa martellare la testa. Che ne dici di vederci di persona?"

# game/Scenes/Jez/jez3.rpy:30
translate italian jez3_7cfb0b0e:

    # det "Do you know where The Pit is?"
    det "Sai dove si trova The Pit?"

# game/Scenes/Jez/jez3.rpy:31
translate italian jez3_5a003c29:

    # pc "The bar downtown?"
    pc "Il bar in centro?"

# game/Scenes/Jez/jez3.rpy:32
translate italian jez3_c60f38c7:

    # det "That's it. Want to meet me there and have this conversation over drinks?"
    det "Esatto. Ti va di incontrarmi lì e fare questa chiacchierata davanti a un drink?"

# game/Scenes/Jez/jez3.rpy:33
translate italian jez3_a5c9c049:

    # det "I could really use a drink."
    det "Un drink mi farebbe davvero comodo."

# game/Scenes/Jez/jez3.rpy:36
translate italian jez3_2ba5f0eb:

    # det "Great, I'll be there in two."
    det "Perfetto, ci sarò tra due minuti."

# game/Scenes/Jez/jez3.rpy:38
translate italian jez3_cd4d07e3:

    # det "Come on man, give me a break."
    det "Dai, amico, dammi tregua."

# game/Scenes/Jez/jez3.rpy:39
translate italian jez3_84d27d16:

    # det "I just got finished working a 24-hour shift."
    det "Ho appena finito un turno di 24 ore."

# game/Scenes/Jez/jez3.rpy:40
translate italian jez3_cd598c64:

    # pc "Alright, I'll be there in five minutes."
    pc "Va bene, ci sarò tra cinque minuti."

# game/Scenes/Jez/jez3.rpy:41
translate italian jez3_2ba5f0eb_1:

    # det "Great, I'll be there in two."
    det "Perfetto, ci sarò tra due minuti."

# game/Scenes/Jez/jez3.rpy:44
translate italian jez3_d1ed5b1b:

    # "She hangs up and I quickly get ready and head out to the car."
    "Lei riattacca e io mi preparo in fretta e mi dirigo verso l’auto."

# game/Scenes/Jez/jez3.rpy:45
translate italian jez3_5ddb21e5:

    # "Only a few minutes later, I park in front of the bar."
    "Pochi minuti dopo, parcheggio davanti al bar."

# game/Scenes/Jez/jez3.rpy:47
translate italian jez3_23e3b6db:

    # "I walk in and am met with a cloud of cigarette smoke, the dull roar of conversation, and a jukebox playing some rock song I've never heard."
    "Entro e vengo accolto da una nuvola di fumo di sigaretta, dal brusio sordo delle conversazioni e da un jukebox che suona una canzone rock che non ho mai sentito."

# game/Scenes/Jez/jez3.rpy:48
translate italian jez3_64d6327f:

    # "It takes a few moments for me to notice Detective Rodriguez waving at me from a booth in the back of the bar."
    "Mi ci vuole qualche istante per notare la detective Rodriguez che mi fa cenno da un tavolo in fondo al bar."

# game/Scenes/Jez/jez3.rpy:49
translate italian jez3_398f4ad8:

    # "I walk over and sit down across from her."
    "Mi avvicino e mi siedo di fronte a lei."

# game/Scenes/Jez/jez3.rpy:53
translate italian jez3_71bded69:

    # det "Thanks for meeting me here. I know it's not very professional, but I need a drink real bad and I hate drinking alone."
    det "Grazie per avermi raggiunto qui. So che non è molto professionale, ma ho davvero bisogno di un drink e odio bere da solo."

# game/Scenes/Jez/jez3.rpy:54
translate italian jez3_ac23b499:

    # det "I ordered you a beer too. You're twenty-one, right?"
    det "Ho ordinato una birra anche per te. Hai ventun anni, vero?"

# game/Scenes/Jez/jez3.rpy:55
translate italian jez3_c2113814:

    # pc "Twenty-two."
    pc "Ventidue."

# game/Scenes/Jez/jez3.rpy:56
translate italian jez3_da9af380:

    # det "Good. Drink up then."
    det "Bene. Allora bevi."

# game/Scenes/Jez/jez3.rpy:59
translate italian jez3_899cb188:

    # "I take a drink of the beer in front of me. It's nice and smooth."
    "Bevo un sorso della birra che ho davanti. È buona e morbida."

# game/Scenes/Jez/jez3.rpy:62
translate italian jez3_cfdfe09b:

    # pc "I'm just here to talk."
    pc "Sono qui solo per parlare."

# game/Scenes/Jez/jez3.rpy:64
translate italian jez3_a023156a:

    # det "So I'm just going to be drinking alone anyway. So be it."
    det "Quindi finirò comunque per bere da sola. Pazienza."

# game/Scenes/Jez/jez3.rpy:68
translate italian jez3_e5c2530c:

    # det "Okay, so you got into your dad's laptop and found some correspondence?"
    det "Ok, quindi hai frugato nel portatile di tuo padre e hai trovato della corrispondenza?"

# game/Scenes/Jez/jez3.rpy:69
translate italian jez3_66708b9a:

    # pc "Yeah, and it's crazy."
    pc "Sì, ed è pazzesco."

# game/Scenes/Jez/jez3.rpy:70
translate italian jez3_08461fea:

    # det "Give me the summary. You can send the entire thing over to my e-mail later."
    det "Fammi un riassunto. Puoi mandarmi tutto via e-mail più tardi."

# game/Scenes/Jez/jez3.rpy:71
translate italian jez3_2af7a240:

    # pc "Well the gist is that he and Whitney were planning a trip."
    pc "Beh, in sostanza lui e Whitney stavano organizzando un viaggio."

# game/Scenes/Jez/jez3.rpy:72
translate italian jez3_b2a62e0b:

    # det "So he did run off with her?"
    det "Quindi è scappato con lei?"

# game/Scenes/Jez/jez3.rpy:73
translate italian jez3_d0c263e4:

    # pc "No, he was the only one going on this trip."
    pc "No, era l’unico a partire per questo viaggio."

# game/Scenes/Jez/jez3.rpy:74
translate italian jez3_2908401f:

    # det "Okay, so where did he go?"
    det "Ok, allora dove è andato?"

# game/Scenes/Jez/jez3.rpy:75
translate italian jez3_0a1d6430:

    # pc "I'm not sure, but the strangest part is how he got there."
    pc "Non ne sono sicura, ma la cosa più strana è come ci è arrivato."

# game/Scenes/Jez/jez3.rpy:76
translate italian jez3_09d6eafc:

    # det "Explain."
    det "Spiegami."

# game/Scenes/Jez/jez3.rpy:77
translate italian jez3_61000743:

    # pc "He built some sort of device. I found it in the basement. It looks like a hula hoop."
    pc "Ha costruito una specie di dispositivo. L’ho trovato in cantina. Sembra un hula hoop."

# game/Scenes/Jez/jez3.rpy:79
translate italian jez3_b0e7f9ea:

    # det "What? You lost me."
    det "Cosa? Non ti seguo."

# game/Scenes/Jez/jez3.rpy:80
translate italian jez3_40d85287:

    # pc "I don't know how to explain it. It looks like a hoop. He and Whitney built it together. When it's activated, it's supposed to transport you somewhere."
    pc "Non so come spiegarlo. Sembra un cerchio. L’hanno costruito insieme, lui e Whitney. Quando viene attivato, dovrebbe trasportarti da qualche parte."

# game/Scenes/Jez/jez3.rpy:81
translate italian jez3_1f06310c:

    # pc "He needed the diamonds to activate it. That's why he stole them."
    pc "Aveva bisogno dei diamanti per attivarlo. Ecco perché li ha rubati."

# game/Scenes/Jez/jez3.rpy:82
translate italian jez3_35f3019c:

    # det "And the meth too?"
    det "E anche la metanfetamina?"

# game/Scenes/Jez/jez3.rpy:83
translate italian jez3_ff210007:

    # pc "Right. He used the meth to speed his heart rate up so his heart didn't stop during the transportation."
    pc "Giusto. Ha usato la metanfetamina per accelerare il battito cardiaco, in modo che il cuore non si fermasse durante il teletrasporto."

# game/Scenes/Jez/jez3.rpy:84
translate italian jez3_22ea6d6f:

    # det "You know this is the dumbest fucking thing I've ever heard right?"
    det "Lo sai che questa è la cosa più stupida che abbia mai sentito, vero?"

# game/Scenes/Jez/jez3.rpy:85
translate italian jez3_a2fed6c2:

    # pc "I'm just telling you what they were talking about."
    pc "Ti sto solo riferendo quello di cui parlavano."

# game/Scenes/Jez/jez3.rpy:87
translate italian jez3_1b198a7a:

    # det "Well I did look into the diamond theft."
    det "Beh, ho indagato sul furto dei diamanti."

# game/Scenes/Jez/jez3.rpy:88
translate italian jez3_0768d1c5:

    # det "There was a jewelry store over in Whiterock that was broken into only a few days before your dad went missing."
    det "C’era una gioielleria a Whiterock che è stata scassinata solo pochi giorni prima che tuo padre scomparisse."

# game/Scenes/Jez/jez3.rpy:89
translate italian jez3_727a0b8a:

    # det "It was just like you described. The security was disabled for only a minute."
    det "È successo proprio come hai descritto. Il sistema di sicurezza è stato disattivato solo per un minuto."

# game/Scenes/Jez/jez3.rpy:90
translate italian jez3_75b55784:

    # det "The thief entered through the back door, walked in, took two three-carat diamond rings, then walked back out."
    det "Il ladro è entrato dalla porta sul retro, è entrato, ha preso due anelli con diamanti da tre carati, poi è uscito."

# game/Scenes/Jez/jez3.rpy:91
translate italian jez3_a0cd13f9:

    # det "Security kicked back on. There would have been no trace that anybody was even there, except the rings were gone."
    det "Il sistema di sicurezza si è riattivato. Non ci sarebbe stata alcuna traccia del fatto che qualcuno fosse stato lì, se non per la scomparsa degli anelli."

# game/Scenes/Jez/jez3.rpy:92
translate italian jez3_a595c814:

    # pc "So he did it."
    pc "Quindi è stato lui."

# game/Scenes/Jez/jez3.rpy:93
translate italian jez3_2cf2afa7:

    # det "It seems that way."
    det "Sembra proprio di sì."

# game/Scenes/Jez/jez3.rpy:94
translate italian jez3_7b6c844b:

    # pc "Any clue where he got the meth?"
    pc "Qualche indizio su dove abbia preso la metanfetamina?"

# game/Scenes/Jez/jez3.rpy:96
translate italian jez3_6063143c:

    # det "God, there's no telling. That shit is all over Skyhill."
    det "Dio, non si può dire. Quella roba è ovunque a Skyhill."

# game/Scenes/Jez/jez3.rpy:97
translate italian jez3_399bdc0f:

    # pc "Really?"
    pc "Davvero?"

# game/Scenes/Jez/jez3.rpy:99
translate italian jez3_94032961:

    # det "Yes. That's what I've been working on. That's my primary job."
    det "Sì. È proprio quello su cui sto lavorando. È il mio compito principale."

# game/Scenes/Jez/jez3.rpy:100
translate italian jez3_91bebae5:

    # det "We know a few dealers and we can find people who buy meth."
    det "Conosciamo alcuni spacciatori e possiamo trovare chi compra la metanfetamina."

# game/Scenes/Jez/jez3.rpy:101
translate italian jez3_ec847758:

    # det "But we can't seem to locate where the shit is coming from. Somebody around here is cooking it, and I don't know where."
    det "Ma non riusciamo a individuare da dove provenga quella roba. Qualcuno da queste parti la produce, e non so dove."

# game/Scenes/Jez/jez3.rpy:102
translate italian jez3_ea875425:

    # pc "I had no idea it was that bad around here."
    pc "Non avevo idea che la situazione fosse così grave da queste parti."

# game/Scenes/Jez/jez3.rpy:103
translate italian jez3_49c82960:

    # det "Yeah. So I'm not sure exactly where your dad got it at, but I've been questioning people."
    det "Sì. Quindi non so esattamente dove tuo padre l’abbia presa, ma sto interrogando alcune persone."

# game/Scenes/Jez/jez3.rpy:104
translate italian jez3_5d188bd8:

    # det "Look [pcname], it sounds to me like your dad was having some sort of psychotic break."
    det "Senti [pcname], a me sembra che tuo padre abbia avuto una sorta di crisi psicotica."

# game/Scenes/Jez/jez3.rpy:105
translate italian jez3_7a8cf8a1:

    # det "Teleporting hula-hoops, diamond theft, using meth to speed up your heart rate."
    det "Hula-hoop che si teletrasportano, furto di diamanti, uso di metanfetamine per accelerare il battito cardiaco."

# game/Scenes/Jez/jez3.rpy:106
translate italian jez3_8ebd5686:

    # det "That sounds like a bunch of nonsense to me."
    det "A me sembrano tutte sciocchezze."

# game/Scenes/Jez/jez3.rpy:107
translate italian jez3_c417e350:

    # pc "Yeah."
    pc "Sì."

# game/Scenes/Jez/jez3.rpy:108
translate italian jez3_4c3ec6a3:

    # det "But the more we dig into it, the more likely we're going to find him."
    det "Ma più approfondiamo la questione, più probabilità abbiamo di trovarlo."

# game/Scenes/Jez/jez3.rpy:109
translate italian jez3_e004b1ab:

    # det "So keep digging."
    det "Quindi continua a indagare."

# game/Scenes/Jez/jez3.rpy:110
translate italian jez3_58f0fc2d:

    # det "Send me the info that you found on the laptop and I'll see if I can find this Whitney person."
    det "Mandami le informazioni che hai trovato sul portatile e vedrò se riesco a rintracciare questa Whitney."

# game/Scenes/Jez/jez3.rpy:111
translate italian jez3_955d194d:

    # det "Assuming that she's real and not somebody that your dad made up."
    det "Sempre che sia una persona reale e non qualcuno inventato da tuo padre."

# game/Scenes/Jez/jez3.rpy:112
translate italian jez3_25bfd7d2:

    # pc "It seems like she's real to me, based on the e-mails."
    pc "A me sembra che esista davvero, a giudicare dalle e-mail."

# game/Scenes/Jez/jez3.rpy:113
translate italian jez3_2fc85b75:

    # det "Alright. Well let's find her."
    det "Va bene. Allora cerchiamola."

# game/Scenes/Jez/jez3.rpy:114
translate italian jez3_e70c1658:

    # pc "I could e-mail her from Dad's laptop."
    pc "Potrei scriverle un’e-mail dal portatile di papà."

# game/Scenes/Jez/jez3.rpy:116
translate italian jez3_3997e2c3:

    # det "That's not a bad idea. Give it a shot. Start up a conversation with her, see if you can find out more about her."
    det "Non è una cattiva idea. Provaci. Avvia una conversazione con lei, vedi se riesci a scoprire qualcosa di più su di lei."

# game/Scenes/Jez/jez3.rpy:117
translate italian jez3_4d9bef33:

    # det "And let me know anything you find."
    det "E fammi sapere tutto quello che scopri."

# game/Scenes/Jez/jez3.rpy:119
translate italian jez3_5bc44b07:

    # pc "I will."
    pc "Lo farò."

# game/Scenes/Jez/jez3.rpy:121
translate italian jez3_b734eba7:

    # det "Thanks for meeting me here. I needed this."
    det "Grazie per avermi raggiunto qui. Ne avevo proprio bisogno."

# game/Scenes/Jez/jez3.rpy:122
translate italian jez3_ba520f30:

    # det "Now I have to get home. I haven't seen my kid in two days."
    det "Ora devo tornare a casa. Sono due giorni che non vedo mio figlio."

# game/Scenes/Jez/jez3.rpy:123
translate italian jez3_ce82357f:

    # pc "You have a kid?"
    pc "Hai un figlio?"

# game/Scenes/Jez/jez3.rpy:125
translate italian jez3_71fc0e0c:

    # det "Yeah, Javi. He's seven. My mom's taking care of him right now."
    det "Sì, Javi. Ha sette anni. In questo momento se ne sta occupando mia madre."

# game/Scenes/Jez/jez3.rpy:126
translate italian jez3_798c23ff:

    # det "You surprised that I have a kid?"
    det "Ti sorprende che io abbia un figlio?"

# game/Scenes/Jez/jez3.rpy:130
translate italian jez3_632e262d:

    # det "Thanks. I had him when I was 17."
    det "Grazie. L'ho avuto quando avevo 17 anni."

# game/Scenes/Jez/jez3.rpy:133
translate italian jez3_ae370b70:

    # det "I'm not. You don't have to be married to have a kid, you know."
    det "No, per niente. Non è necessario essere sposati per avere un figlio, lo sai."

# game/Scenes/Jez/jez3.rpy:134
translate italian jez3_2356fff3:

    # pc "Right, I didn't mean anything by it."
    pc "Giusto, non volevo dire nulla di particolare."

# game/Scenes/Jez/jez3.rpy:137
translate italian jez3_a82f6cf9:

    # det "Oh, I thought you seemed surprised."
    det "Oh, mi sembrava che fossi sorpresa."

# game/Scenes/Jez/jez3.rpy:139
translate italian jez3_12633b63:

    # det "Anyway, I better get home."
    det "Comunque, è meglio che torni a casa."

# game/Scenes/Jez/jez3.rpy:140
translate italian jez3_d0fa7dfb:

    # det "I'll see you later, [pcname]."
    det "Ci vediamo più tardi, [pcname]."

# game/Scenes/Jez/jez3.rpy:141
translate italian jez3_7b4cad00:

    # pc "Bye Detective Rodriguez."
    pc "Ciao, detective Rodriguez."

# game/Scenes/Jez/jez3.rpy:144
translate italian jez3_d41d8cd9_2:

    # voice 'voices/jez_3_1.mp3'
    voice 'voices/jez_3_1.mp3'

# game/Scenes/Jez/jez3.rpy:145
translate italian jez3_e7adfac5:

    # det "You can call me Jez, okay? That's my first name."
    det "Puoi chiamarmi Jez, ok? È il mio nome di battesimo."

# game/Scenes/Jez/jez3.rpy:146
translate italian jez3_db79b546:

    # pc "Okay. Bye Jez."
    pc "Ok. Ciao, Jez."

# game/Scenes/Jez/jez3.rpy:151
translate italian jez3_d41d8cd9_3:

    # voice 'voices/jez_goodnight.mp3'
    voice 'voices/jez_goodnight.mp3'

# game/Scenes/Jez/jez3.rpy:152
translate italian jez3_2f6a1cc2:

    # det "Good night."
    det "Buona notte."

# game/Scenes/Jez/jez3.rpy:155
translate italian jez3_40a94195:

    # "She stands up and walks out of the bar. I sit there alone for a few minutes, thinking about our conversation."
    "Si alza e esce dal bar. Rimango lì seduto da solo per qualche minuto, ripensando alla nostra conversazione."

# game/Scenes/Jez/jez3.rpy:156
translate italian jez3_06361269:

    # "She thinks Dad was crazy. I'm not so sure."
    "Lei pensa che papà fosse pazzo. Io non ne sono così sicuro."

# game/Scenes/Jez/jez3.rpy:157
translate italian jez3_d8c1ec54:

    # "The things in his notes and in his conversations with Whitney were wild, but there is so much there that seems true."
    "Le cose che ha scritto nei suoi appunti e nelle sue conversazioni con Whitney erano assurde, ma c’è così tanto lì dentro che sembra vero."

# game/Scenes/Jez/jez3.rpy:158
translate italian jez3_3da12785:

    # "Whitney definitely seems like a real person. I just need to find out who she is."
    "Whitney sembra decisamente una persona reale. Devo solo scoprire chi è."

# game/Scenes/Jez/jez3.rpy:159
translate italian jez3_8298e18a:

    # "Then maybe I can find out where my dad went."
    "Allora forse potrò scoprire dove è andato mio padre."

# game/Scenes/Jez/jez3.rpy:160
translate italian jez3_bc8a9774:

    # "Eventually, I stand up and walk out of the bar, then head home for the night."
    "Alla fine, mi alzo e esco dal bar, poi torno a casa per la notte."

translate italian strings:

    # game/Scenes/Jez/jez3.rpy:2
    old "You need to get into your dad's computer. Talk to Adrian about it. She's been at the grocery store trying to find a new game."
    new "Devi accedere al computer di tuo padre. Parla con Adrian a riguardo. È al supermercato a cercare un nuovo gioco."

    # game/Scenes/Jez/jez3.rpy:3
    old "Once you search your dad's laptop, call Detective Rodriguez from your bedroom in the evening."
    new "Una volta che avrai controllato il portatile di tuo padre, chiama il detective Rodriguez dalla tua camera da letto in serata."

    # game/Scenes/Jez/jez3.rpy:35
    old "Sure, I'll be there in five minutes"
    new "Certo, sarò lì tra cinque minuti"

    # game/Scenes/Jez/jez3.rpy:37
    old "That doesn't seem very professional"
    new "Non mi sembra molto professionale"

    # game/Scenes/Jez/jez3.rpy:58
