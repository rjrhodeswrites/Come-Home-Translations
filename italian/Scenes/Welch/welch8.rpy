    # sst "Oh yeah?"
    sst "Ah sì?"

# game/Scenes/Welch/welch8.rpy:142
translate italian welch8date_32607601:

    # fr "Yeah."
    fr "Sì."

# game/Scenes/Welch/welch8.rpy:143
translate italian welch8date_005e936c:

    # sst "Are you two serious?"
    sst "È una cosa seria tra voi due?"

# game/Scenes/Welch/welch8.rpy:145
translate italian welch8date_0c4a9fc4:

    # "Mari blushes a little."
    "Mari arrossisce un po'."

# game/Scenes/Welch/welch8.rpy:146
translate italian welch8date_d8e78862:

    # fr "Kinda serious, yeah."
    fr "Più o meno, sì."

# game/Scenes/Welch/welch8.rpy:147
translate italian welch8date_918ecf60:

    # fr "Not exclusive or anything, but we enjoy each other's company."
    fr "Non è una cosa esclusiva o altro, ma ci piace stare insieme."

# game/Scenes/Welch/welch8.rpy:148
translate italian welch8date_fef9522c:

    # sst "Ah, I get it. Say no more."
    sst "Ah, capisco. Non dire altro."

# game/Scenes/Welch/welch8.rpy:150
translate italian welch8date_0c4a9fc4_1:

    # "Mari blushes a little."
    "Mari arrossisce un po'."

# game/Scenes/Welch/welch8.rpy:151
translate italian welch8date_1e997bea:

    # fr "Not yet, but we'll see where things go."
    fr "Non ancora, ma vedremo come andranno le cose."

# game/Scenes/Welch/welch8.rpy:152
translate italian welch8date_3b101359:

    # sst "Ooh, a little romance. I like it. Say no more."
    sst "Ooh, un po' di romanticismo. Mi piace. Non dire altro."

# game/Scenes/Welch/welch8.rpy:154
translate italian welch8date_59aa8d7d:

    # fr "Oh, he's another frequent customer. I'm surprised you two haven't bumped into each other here."
    fr "Oh, è un altro cliente abituale. Mi sorprende che voi due non vi siate mai incontrati qui."

# game/Scenes/Welch/welch8.rpy:155
translate italian welch8date_857dd542:

    # sst "That's what I was saying earlier!"
    sst "È proprio quello che stavo dicendo prima!"

# game/Scenes/Welch/welch8.rpy:156
translate italian welch8date_aa0dc8a1:

    # fr "Well, I'll go get your meals ready. Be back in a bit."
    fr "Beh, vado a prepararvi da mangiare. Torno tra un attimo."

# game/Scenes/Welch/welch8.rpy:161
translate italian welch8date_cd2d7012:

    # sst "Man, I can't believe you blew it with her."
    sst "Cavolo, non riesco a credere che tu abbia rovinato tutto con lei."

# game/Scenes/Welch/welch8.rpy:162
translate italian welch8date_52d2fdd9:

    # sst "Big oof there."
    sst "Che gaffe, quella lì."

# game/Scenes/Welch/welch8.rpy:164
translate italian welch8date_6ab19db4:

    # sst "Good job with her. She's a sweet girl. Super hot too."
    sst "Complimenti per come ti sei comportato con lei. È una ragazza dolce. E anche super sexy."

# game/Scenes/Welch/welch8.rpy:165
translate italian welch8date_1c722351:

    # pc "Yeah she is."
    pc "Sì, lo è."

# game/Scenes/Welch/welch8.rpy:167
translate italian welch8date_a5af6fb9:

    # "Izzy comes over to take our order."
    "Izzy si avvicina per prendere la nostra ordinazione."

# game/Scenes/Welch/welch8.rpy:170
translate italian welch8date_0d87a734:

    # gl "Yo, what's up, Nora?"
    gl "Ehi, come va, Nora?"

