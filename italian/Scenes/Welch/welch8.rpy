    # sst "That's cool!"
    sst "Che bello!"

# game/Scenes/Welch/welch8.rpy:190
translate italian welch8date_59ad4e63:

    # gl "Well, anyways, it's good seeing you. What do y'all want to eat?"
    gl "Beh, comunque, è bello vederti. Cosa volete mangiare?"

# game/Scenes/Welch/welch8.rpy:191
translate italian welch8date_f35deb44:

    # "She quickly takes our orders and then rushes to the back."
    "Prende velocemente le nostre ordinazioni e poi si precipita nel retro."

# game/Scenes/Welch/welch8.rpy:194
translate italian welch8date_26f19da2:

