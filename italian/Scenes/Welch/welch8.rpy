    # pc "Um, how do you two know each other?"
    pc "Ehm, voi due come vi conoscete?"

# game/Scenes/Welch/welch8.rpy:182
translate italian welch8date_d69080bf:

    # sst "We met at a Black Lives Matters protest once and hung out."
    sst "Ci siamo incontrati una volta a una manifestazione di Black Lives Matter e siamo usciti insieme."

# game/Scenes/Welch/welch8.rpy:183
translate italian welch8date_75eaadd9:

    # gl "Yeah, man. Sometimes you just gotta march. I got thrown in jail for that one."
    gl "Sì, amico. A volte bisogna proprio scendere in piazza. Per quella volta mi hanno sbattuto in galera."

# game/Scenes/Welch/welch8.rpy:184
