    sst "Oh ciao, Izzy! Non sapevo nemmeno che lavorassi qui!"

# game/Scenes/Welch/welch8.rpy:172
translate italian welch8date_92415954:

    # gl "Yeah, [pcname] got me the job actually!"
    gl "Sì, in realtà è stata [pcname] a farmi avere questo lavoro!"

# game/Scenes/Welch/welch8.rpy:173
translate italian welch8date_cf30c7d8:

    # sst "Really? That's cool! How have you been?"
    sst "Davvero? Che figata! Come stai?"

# game/Scenes/Welch/welch8.rpy:174
translate italian welch8date_36c577be:

    # gl "Ah, you know how it goes. Ups and downs. Doing okay right now though."
    gl "Ah, sai com’è. Alti e bassi. Per ora me la cavo bene, però."

# game/Scenes/Welch/welch8.rpy:175
translate italian welch8date_87c52185:

    # sst "I'm glad to hear that."
    sst "Mi fa piacere sentirlo."

# game/Scenes/Welch/welch8.rpy:178
translate italian welch8date_ba4b70c8:

    # gl "How do you know [pcname]?"
    gl "Come conosci [pcname]?"

# game/Scenes/Welch/welch8.rpy:179
translate italian welch8date_eef5640a_1:

    # sst "Oh, well he's in my class. We just went to go vote and figured we'd get a bite to eat."
    sst "Oh, beh, è nella mia classe. Siamo appena andati a votare e abbiamo pensato di mangiare un boccone."

# game/Scenes/Welch/welch8.rpy:180
translate italian welch8date_6473eb14:

    # gl "Oh, cool."
    gl "Oh, fico."

# game/Scenes/Welch/welch8.rpy:181
