translate italian welchs1_90640fc0:

    # sst "But I do still talk to my ex-husband's family pretty often."
    sst "Ma parlo ancora abbastanza spesso con la famiglia del mio ex marito."

# game/Scenes/Welch/WelchConversations/welchs1.rpy:19
translate italian welchs1_b8887ab1:

    # pc "You were married?"
    pc "Eri sposata?"

# game/Scenes/Welch/WelchConversations/welchs1.rpy:24
translate italian welchmarried_c27601eb:

    # sst "Oh yeah. Right out of high school. Lasted about two years."
    sst "Oh sì. Subito dopo il liceo. È durato circa due anni."

# game/Scenes/Welch/WelchConversations/welchs1.rpy:25
translate italian welchmarried_d6a910a0:

    # sst "But he was controlling and emotionally abusive..."
    sst "Ma era prepotente e mi maltrattava emotivamente..."

# game/Scenes/Welch/WelchConversations/welchs1.rpy:27
translate italian welchmarried_6cf00ff4:

    # sst "So, I left his ass."
    sst "Quindi l’ho mollato."

# game/Scenes/Welch/WelchConversations/welchs1.rpy:29
translate italian welchmarried_5314674d:

    # sst "The whole thing made me stronger though. I don't think I'd be the same person today if I hadn't married that asshole."
    sst "Tutta quella storia mi ha reso più forte, però. Non credo che oggi sarei la stessa persona se non avessi sposato quello stronzo."

# game/Scenes/Welch/WelchConversations/welchs1.rpy:31
translate italian welchmarried_a405651c:

    # sst "Plus, I got a pretty sweet house out of the divorce."
    sst "Inoltre, dal divorzio mi sono beccata una casa davvero carina."

# game/Scenes/Welch/WelchConversations/welchs1.rpy:32
translate italian welchmarried_7acc68d6:

    # pc "Hey, that's cool."
    pc "Ehi, che bello."

# game/Scenes/Welch/WelchConversations/welchs1.rpy:34
translate italian welchmarried_5d0c7d8f:

    # sst "His parents and I always got along."
    sst "Io e i suoi genitori siamo sempre andati d’accordo."

# game/Scenes/Welch/WelchConversations/welchs1.rpy:35
translate italian welchmarried_c3bfaae0:

    # sst "They helped me a lot when I was leaving him, and we still go out for dinner once a month or so."
    sst "Mi hanno aiutata tantissimo quando l’ho lasciato, e usciamo ancora a cena insieme una volta al mese o giù di lì."

# game/Scenes/Welch/WelchConversations/welchs1.rpy:37
translate italian welchmarried_9b93bf6c:

    # sst "So, I guess I took his family in the divorce too! Hah!"
    sst "Quindi, immagino di essermi presa anche la sua famiglia con il divorzio! Ah ah!"

# game/Scenes/Welch/WelchConversations/welchs1.rpy:38
translate italian welchmarried_201d5764:

    # pc "Nice."
    pc "Bello."

