# game/Scenes/Bai/BaiConversations/baip1.rpy:13
translate italian baip1_4fa21f8f:

    # bai "Oof, probably telling my last girlfriend that I might be interested in guys."
    bai "Uff, probabilmente quando ho detto alla mia ultima ragazza che forse mi interessavano i ragazzi."

# game/Scenes/Bai/BaiConversations/baip1.rpy:15
translate italian baip1_ffbd6fca:

    # bai "I knew that the reaction was not going to be good, but I didn't expect her to completely turn against me and take all my friends with her."
    bai "Sapevo che la reazione non sarebbe stata positiva, ma non mi aspettavo che si mettesse completamente contro di me e si portasse via tutti i miei amici."

# game/Scenes/Bai/BaiConversations/baip1.rpy:16
translate italian baip1_d3859f56:

    # bai "I wish I would have just broken up with her and kept it a secret until I left for college."
    bai "Vorrei averla semplicemente lasciata e aver tenuto il segreto fino a quando non sono partito per l’università."

# game/Scenes/Bai/BaiConversations/baip1.rpy:18
translate italian baip1_8b41827b:

    # bai "I don't know. I guess it helped me find who my real friends were… which was none of them."
    bai "Non lo so. Immagino che mi abbia aiutato a capire chi fossero i miei veri amici… ovvero nessuno di loro."

# game/Scenes/Bai/BaiConversations/baip1.rpy:20
translate italian baip1_ddc15c60:

    # bai "I don't regret coming out, or at least partially coming out, but I regret doing it at that time."
    bai "Non mi pento di aver fatto coming out, o almeno di averlo fatto in parte, ma mi pento di averlo fatto in quel momento."

# game/Scenes/Bai/BaiConversations/baip1.rpy:21
translate italian baip1_e386481e:

    # bai "Should have waited until I was in a better place."
    bai "Avrei dovuto aspettare di trovarmi in una situazione migliore."

# game/Scenes/Bai/BaiConversations/baip1.rpy:23
translate italian baip1_0d4610a1:

    # bai "Though I expect there would be drama no matter when I chose to do it."
    bai "Anche se immagino che ci sarebbero stati dei drammi indipendentemente da quando avessi deciso di farlo."

# game/Scenes/Bai/BaiConversations/baip1.rpy:24
translate italian baip1_9c2f65a6:

    # bai "It would have always been hard."
    bai "Sarebbe stato comunque difficile."

# game/Scenes/Bai/BaiConversations/baip1.rpy:25
translate italian baip1_8ac655b7:

    # pc "Well I'm here for you man, if you need support."
    pc "Beh, io ci sono per te, amico, se hai bisogno di sostegno."

# game/Scenes/Bai/BaiConversations/baip1.rpy:27
translate italian baip1_ae9dc969:

    # bai "Thanks, man. I appreciate it."
    bai "Grazie, amico. Lo apprezzo molto."

