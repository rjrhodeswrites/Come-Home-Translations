# game/Scenes/Bai/BaiConversations/bais8.rpy:13
translate italian bais8_d217cd50:

    # bai "Pretty traditional."
    bai "Piuttosto tradizionale."

# game/Scenes/Bai/BaiConversations/bais8.rpy:14
translate italian bais8_0af84505:

    # bai "My parents are both strict and very interested in me doing well."
    bai "I miei genitori sono entrambi severi e ci tengono molto che io ottenga buoni risultati."

# game/Scenes/Bai/BaiConversations/bais8.rpy:15
translate italian bais8_6f109caf:

    # bai "I have one older sister, who's a doctor, and a younger brother who qualified for a private school when he was 10 and graduated high school at age 15, a year before me."
    bai "Ho una sorella maggiore, che è medico, e un fratello minore che è stato ammesso a una scuola privata quando aveva 10 anni e si è diplomato al liceo a 15 anni, un anno prima di me."

# game/Scenes/Bai/BaiConversations/bais8.rpy:16
translate italian bais8_1cbbec02:

    # pc "Sounds competitive."
    pc "Sembra un ambiente competitivo."

# game/Scenes/Bai/BaiConversations/bais8.rpy:18
translate italian bais8_0b766f52:

    # bai "It sort of is."
    bai "In un certo senso lo è."

# game/Scenes/Bai/BaiConversations/bais8.rpy:19
translate italian bais8_e3b5d935:

    # bai "I love my siblings, but it does feel like we're constantly competing for our parent's approval."
    bai "Adoro i miei fratelli, ma mi sembra che siamo costantemente in competizione per ottenere l’approvazione dei nostri genitori."

# game/Scenes/Bai/BaiConversations/bais8.rpy:20
translate italian bais8_c840f06f:

    # bai "And I'm losing, badly."
    bai "E io sto perdendo, alla grande."

# game/Scenes/Bai/BaiConversations/bais8.rpy:22
translate italian bais8_721a2c39:

    # bai "It would be even worse if they knew everything about me."
    bai "Sarebbe ancora peggio se sapessero tutto di me."

# game/Scenes/Bai/BaiConversations/bais8.rpy:23
translate italian bais8_a2a6fb65:

    # pc "What do you mean?"
    pc "Cosa intendi?"

# game/Scenes/Bai/BaiConversations/bais8.rpy:25
translate italian bais8_270bb5fd:

    # bai "You know. That I'm into guys."
    bai "Lo sai. Che mi piacciono i ragazzi."

# game/Scenes/Bai/BaiConversations/bais8.rpy:26
translate italian bais8_91b5dbc2:

    # pc "You don't think they would approve?"
    pc "Non pensi che non lo approverebbero?"

# game/Scenes/Bai/BaiConversations/bais8.rpy:27
translate italian bais8_8652bd37:

    # bai "I don't know for sure. Like I said, they're pretty traditional."
    bai "Non lo so con certezza. Come ho detto, sono piuttosto tradizionalisti."

# game/Scenes/Bai/BaiConversations/bais8.rpy:29
translate italian bais8_0ee24748:

    # bai "Maybe I'll come out to them eventually, but for now I just want to see where things go."
    bai "Forse prima o poi glielo dirò, ma per ora voglio solo vedere come vanno le cose."

# game/Scenes/Bai/BaiConversations/bais8.rpy:30
translate italian bais8_a11c288d:

    # pc "Well, I hope it all goes well for you."
    pc "Beh, spero che tutto vada per il meglio per te."

# game/Scenes/Bai/BaiConversations/bais8.rpy:32
translate italian bais8_badd9121:

    # bai "Thanks, [pcname]."
    bai "Grazie, [pcname]."

