# game/Scenes/Bai/bai2.rpy:10
translate italian bai2_98ca1a51:

    # "My phone buzzes in my pocket."
    "Il mio telefono vibra in tasca."

# game/Scenes/Bai/bai2.rpy:14
translate italian bai2_a13b13a8:

    # "It's Bai. I guess I have time to chat a bit."
    "È Bai. Immagino di avere tempo per chiacchierare un po'."

# game/Scenes/Bai/bai2.rpy:17
translate italian bai2_c0d6b27a:

    # pc "Hey Bai, what's up?"
    pc "Ehi Bai, come va?"

# game/Scenes/Bai/bai2.rpy:18
translate italian bai2_ca2e0cd6:

    # bai "Hey, [pcname]. I was just lying here bored and wondered what you were up to?"
    bai "Ehi, [pcname]. Me ne stavo qui sdraiata annoiata e mi chiedevo cosa stessi facendo?"

# game/Scenes/Bai/bai2.rpy:19
translate italian bai2_f020dde3:

    # pc "Just getting ready for bed, but I can talk for a while."
    pc "Mi sto preparando per andare a letto, ma posso chiacchierare un po’."

# game/Scenes/Bai/bai2.rpy:20
translate italian bai2_b9768b08:

    # bai "That's cool. I've just been thinking a lot."
    bai "Perfetto. È solo che stavo riflettendo molto."

# game/Scenes/Bai/bai2.rpy:21
translate italian bai2_e61255db:

    # pc "About what?"
    pc "Su cosa?"

# game/Scenes/Bai/bai2.rpy:23
translate italian bai2_67224ed1:

    # bai "Just stuff mostly."
    bai "Solo cose varie, per lo più."

# game/Scenes/Bai/bai2.rpy:24
translate italian bai2_19828c08:

    # pc "You're going to have to be a little more specific than that or this conversation isn't going to go anywhere."
    pc "Dovrai essere un po’ più specifica, altrimenti questa conversazione non porterà da nessuna parte."

# game/Scenes/Bai/bai2.rpy:25
translate italian bai2_64de84cd:

    # bai "Okay, well."
    bai "Ok, beh."

# game/Scenes/Bai/bai2.rpy:26
translate italian bai2_d7d9d996:

    # bai "I uh... I've only dated girls in the past."
    bai "Io, ehm... In passato sono uscito solo con ragazze."

# game/Scenes/Bai/bai2.rpy:27
translate italian bai2_36470b3e:

    # bai "I've had sex and stuff. With girls."
    bai "Ho fatto sesso e cose del genere. Con ragazze."

# game/Scenes/Bai/bai2.rpy:28
translate italian bai2_41c2c9e2:

    # bai "But uh... I think I might be into guys too."
    bai "Ma ehm... penso che potrebbero piacermi anche i ragazzi."

# game/Scenes/Bai/bai2.rpy:30
translate italian bai2_8833a2ab:

    # pc "So, you're bisexual?"
    pc "Quindi sei bisessuale?"

# game/Scenes/Bai/bai2.rpy:31
translate italian bai2_61b09772:

    # bai "Maybe?"
    bai "Forse?"

# game/Scenes/Bai/bai2.rpy:32
translate italian bai2_0e63d7c1:

    # bai "What about you? Are you into guys at all?"
    bai "E tu? Ti piacciono i ragazzi?"

# game/Scenes/Bai/bai2.rpy:36
translate italian bai2_bde64ebd:

    # bai "Oh okay. I thought maybe we had a thing. It's okay though."
    bai "Oh, ok. Pensavo che forse ci fosse qualcosa tra noi. Ma va bene così."

# game/Scenes/Bai/bai2.rpy:37
translate italian bai2_0fe323b5:

    # pc "Sorry, man. Chicks only for me."
    pc "Mi dispiace, amico. Per me solo ragazze."

# game/Scenes/Bai/bai2.rpy:38
translate italian bai2_83d8b883:

    # bai "It's cool. I understand."
    bai "Va bene. Capisco."

# game/Scenes/Bai/bai2.rpy:40
translate italian bai2_ecf05d77:

    # bai "Still friends though?"
    bai "Restiamo comunque amici?"

# game/Scenes/Bai/bai2.rpy:41
translate italian bai2_71d4cebe:

    # pc "Sure, we're still friends."
    pc "Certo, siamo ancora amici."

# game/Scenes/Bai/bai2.rpy:44
translate italian bai2_e26b3f90:

    # bai "Cool."
    bai "Fantastico."

# game/Scenes/Bai/bai2.rpy:47
translate italian bai2_b66cc0ac:

    # bai "Really? I thought maybe we had a thing, but I wasn't sure."
    bai "Davvero? Pensavo che forse ci fosse qualcosa tra noi, ma non ne ero sicuro."

# game/Scenes/Bai/bai2.rpy:49
translate italian bai2_f39ae0a2:

    # bai "Are you into me?"
    bai "Ti piaccio?"

# game/Scenes/Bai/bai2.rpy:53
translate italian bai2_99a03550:

    # bai "That makes me so happy."
    bai "Questo mi rende davvero felice."

# game/Scenes/Bai/bai2.rpy:55
translate italian bai2_99b1838b:

    # bai "So do you maybe want to actually go on a date sometime?"
    bai "Allora, ti andrebbe di uscire insieme qualche volta?"

# game/Scenes/Bai/bai2.rpy:56
translate italian bai2_39757b54:

    # pc "Yeah, let's do it."
    pc "Sì, facciamolo."

# game/Scenes/Bai/bai2.rpy:57
translate italian bai2_8c98f2da:

    # bai "Okay, just give me a call in the evening sometime then. I'm available almost every day."
    bai "Ok, chiamami una sera, allora. Sono disponibile quasi tutti i giorni."

# game/Scenes/Bai/bai2.rpy:58
translate italian bai2_58a87bc2:

    # pc "Sounds good. I'm looking forward to it."
    pc "Mi sembra una buona idea. Non vedo l’ora."

# game/Scenes/Bai/bai2.rpy:59
translate italian bai2_10a70856:

    # bai "Me too. Really."
    bai "Anche io. Davvero."

# game/Scenes/Bai/bai2.rpy:60
translate italian bai2_4d74a398:

    # bai "This is new territory for me, but I'm really looking forward to exploring it with you."
    bai "Per me è un territorio inesplorato, ma non vedo l’ora di esplorarlo con te."

# game/Scenes/Bai/bai2.rpy:63
translate italian bai2_c0a43543:

    # bai "Oh, so you're into guys, but you're not into me."
    bai "Oh, quindi ti piacciono i ragazzi, ma io non ti piaccio."

# game/Scenes/Bai/bai2.rpy:64
translate italian bai2_27247fe1:

    # bai "Gotta say, that hurts man."
    bai "Devo dire che mi fa male, amico."

# game/Scenes/Bai/bai2.rpy:65
translate italian bai2_c31c7975:

    # pc "Sorry, just being honest."
    pc "Scusa, sono solo sincero."

# game/Scenes/Bai/bai2.rpy:66
translate italian bai2_40a3eff2:

    # bai "Yeah okay. Well that sucks."
    bai "Sì, va bene. Beh, che schifo."

# game/Scenes/Bai/bai2.rpy:67
translate italian bai2_0cce2b18:

    # pc "We can still be friends though."
    pc "Possiamo comunque rimanere amici."

# game/Scenes/Bai/bai2.rpy:68
translate italian bai2_46106a33:

    # bai "Yeah, okay. I'm going to bed."
    bai "Sì, va bene. Vado a letto."

# game/Scenes/Bai/bai2.rpy:70
translate italian bai2_14a17911:

    # "He hangs up. I guess that didn't go so well."
    "Riattacca. Immagino che non sia andata molto bene."

# game/Scenes/Bai/bai2.rpy:71
translate italian bai2_a0d6f0f3:

    # "Oh well. He'll get over it. Or not, whatever."
    "Vabbè. Gli passerà. O forse no, chi se ne frega."

# game/Scenes/Bai/bai2.rpy:72
translate italian bai2_ef88129a:

    # "I put the phone away and get ready for bed."
    "Metto via il telefono e mi preparo per andare a letto."

# game/Scenes/Bai/bai2.rpy:75
translate italian bai2_17d3424c:

    # "We chat a little longer about our days, until we are both tired."
    "Chiacchieriamo ancora un po’ della nostra giornata, finché non siamo entrambi stanchi."

# game/Scenes/Bai/bai2.rpy:77
translate italian bai2_3898d259:

    # bai "I better get some sleep man."
    bai "È meglio che dorma un po’, amico."

# game/Scenes/Bai/bai2.rpy:78
translate italian bai2_89c07fc5:

    # bai "I'll talk to you later."
    bai "Ci sentiamo più tardi."

# game/Scenes/Bai/bai2.rpy:79
translate italian bai2_d2381b62:

    # pc "Okay. See ya, Bai."
    pc "Ok. Ci vediamo, Bai."

# game/Scenes/Bai/bai2.rpy:82
translate italian bai2_52d6e3cf:

    # "We hang up and I get ready for bed."
    "Riattacchiamo e mi preparo per andare a letto."

