# game/Scenes/Bai/BaiDates/baigrottodate.rpy:19
translate italian baigrottodate_d3715341:

    # pc "Do you want to come out to a fancy restaurant with me?"
    pc "Ti va di venire con me in un ristorante di lusso?"

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:20
translate italian baigrottodate_4243d9c3:

    # pc "It's called The Grotto. It's out on the lake."
    pc "Si chiama The Grotto. È sul lago."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:23
translate italian baigrottodate_4f7f94cb:

    # bai "Is it expensive?"
    bai "È costoso?"

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:24
translate italian baigrottodate_3308b177:

    # pc "Pretty expensive, yeah."
    pc "Piuttosto costoso, sì."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:26
translate italian baigrottodate_fb59b9b7:

    # bai "Aw, what the hell. Might as well spend it, right?"
    bai "Ah, al diavolo. Tanto vale spendere un po', no?"

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:27
translate italian baigrottodate_f82e580f:

    # bai "I eat cheap every other day, let's get some fancy food!"
    bai "Mangio economico un giorno sì e uno no, concediamoci un pasto di lusso!"

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:28
translate italian baigrottodate_5f71dc40:

    # pc "All right! I'll text you the address and meet you out there."
    pc "Va bene! Ti mando l’indirizzo via SMS e ci vediamo lì."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:29
translate italian baigrottodate_1bda0dbe:

    # bai "Sounds good! See you there."
    bai "Mi sembra una buona idea! Ci vediamo lì."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:32
translate italian baigrottodate_cf65d098:

    # "I get ready and text Bai the address, then about an hour later we're sitting down to eat at The Grotto."
    "Mi preparo e mando l’indirizzo a Bai via SMS, poi circa un’ora dopo siamo seduti a mangiare al The Grotto."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:35
translate italian baigrottodate_79872e14:

    # bai "That sounds great. Are we going to get all dressed up in suits and stuff?"
    bai "Sembra fantastico. Ci vestiamo tutti in giacca e cravatta e roba del genere?"

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:36
translate italian baigrottodate_a9dc377e:

    # pc "Damn right, we are."
    pc "Certo che sì."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:38
translate italian baigrottodate_bfaba4a8:

    # bai "Oh man. I have to find my suit then. I know I have one in the closet somewhere."
    bai "Oh cavolo. Allora devo trovare il mio completo. So di averne uno da qualche parte nell’armadio."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:39
translate italian baigrottodate_b5cc83ae:

    # bai "I'll go find it."
    bai "Vado a cercarlo."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:40
translate italian baigrottodate_ffb27a81:

    # pc "Okay. Send me a text when you're ready and I'll come pick you up, okay?"
    pc "Ok. Mandami un messaggio quando sei pronto e verrò a prenderti, va bene?"

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:42
translate italian baigrottodate_9e815b71:

    # bai "Okay! I'm really excited!"
    bai "Ok! Sono davvero emozionata!"

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:43
translate italian baigrottodate_f07574ec:

    # pc "Good."
    pc "Bene."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:44
translate italian baigrottodate_412f6c55:

    # bai "Okay, see you in a bit."
    bai "Ok, ci vediamo tra poco."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:47
translate italian baigrottodate_9bcd7a72:

    # "I get ready to go and wait for Bai's text."
    "Mi preparo per uscire e aspetto il messaggio di Bai."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:48
translate italian baigrottodate_9173db50:

    # "About an hour later, he texts me and I go pick him up, then we walk into The Grotto together."
    "Circa un’ora dopo, mi manda un messaggio e vado a prenderlo, poi entriamo insieme al The Grotto."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:51
translate italian baigrottodate_9131d6c6:

    # bai "Sounds good! I'll see you there."
    bai "Mi sembra perfetto! Ci vediamo lì."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:52
translate italian baigrottodate_5d3d77d3:

    # pc "Cool. See you."
    pc "Fantastico. Ci vediamo."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:54
translate italian baigrottodate_299409d0:

    # bai "That sounds great! I'll start getting ready. Come get me."
    bai "Sembra fantastico! Comincio a prepararmi. Vieni a prendermi."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:55
translate italian baigrottodate_e3948ee8:

    # pc "Alright, I'll be there in a bit."
    pc "Va bene, arrivo tra poco."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:69
translate italian baigrottostartdate_ba211ff8:

    # "We walk in together, holding hands."
    "Entriamo insieme, tenendoci per mano."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:70
translate italian baigrottostartdate_fb0e2e4f:

    # bai "This feels very public. More public than we usually are."
    bai "Mi sembra tutto molto in pubblico. Più in pubblico di quanto siamo di solito."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:71
translate italian baigrottostartdate_a674eec0:

    # pc "Are you okay with that?"
    pc "Ti sta bene?"

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:72
translate italian baigrottostartdate_023cf823:

    # bai "Yeah, with you, I think I am."
    bai "Sì, con te, penso di sì."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:73
translate italian baigrottostartdate_e39c1441:

    # pc "Good. You look like a fucking stud right now. I'm proud to be here with you."
    pc "Bene. In questo momento sembri un fottuto stallone. Sono orgoglioso di essere qui con te."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:74
translate italian baigrottostartdate_bb37df29:

    # bai "Me too."
    bai "Anch’io."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:81
translate italian baigrottostartdate_a5785e55:

    # "We sit at a table and begin looking over the menus."
    "Ci sediamo a un tavolo e iniziamo a dare un’occhiata ai menu."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:82
translate italian baigrottostartdate_a395082c:

    # "Then a server comes by and takes our order."
    "Poi arriva un cameriere e prende la nostra ordinazione."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:91
translate italian baigrottostartdate_32733c2f:

    # "After we chat for a while, our food is brought out."
    "Dopo aver chiacchierato un po’, ci portano il cibo."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:92
translate italian baigrottostartdate_501f942a:

    # bai "Wow, this looks amazing."
    bai "Wow, sembra fantastico."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:98
translate italian baigrottostartdate_28b42b01:

    # "We continue chatting while we eat our meal. Just hanging out and enjoying some good food together."
    "Continuiamo a chiacchierare mentre mangiamo. Ci rilassiamo e ci godiamo del buon cibo insieme."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:101
translate italian baigrottostartdate_7150c85d:

    # "When we're done eating, we split the bill and say our goodbyes."
    "Quando abbiamo finito di mangiare, dividiamo il conto e ci salutiamo."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:105
translate italian baigrottostartdate_25d6d119:

    # bai "That was fun, man. Good food. Thanks for inviting me."
    bai "È stato divertente, amico. Ottimo cibo. Grazie per avermi invitato."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:106
translate italian baigrottostartdate_0c975e99:

    # pc "No problem. Good to hang out and talk for a while."
    pc "Non c’è di che. È stato bello stare insieme e chiacchierare un po’."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:107
translate italian baigrottostartdate_49b45846:

    # bai "Yeah it was."
    bai "Sì, è vero."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:108
translate italian baigrottostartdate_01c7ca57:

    # bai "Alright, well I'll see you later. Take care."
    bai "Va bene, allora ci vediamo più tardi. Stammi bene."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:109
translate italian baigrottostartdate_22fbafdc:

    # pc "You too. See ya."
    pc "Anche tu. Ci vediamo."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:112
translate italian baigrottostartdate_0c8ca28d:

    # "We get in our cars and go our separate directions."
    "Saliamo sulle nostre auto e prendiamo strade diverse."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:120
translate italian baigrottostartdate_bfde7d54:

    # "We continue chatting and eating."
    "Continuiamo a chiacchierare e a mangiare."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:126
translate italian baigrottostartdate_1ef0c0b5:

    # "Bai insists that we split the bill, then we get ready to leave."
    "Bai insiste perché dividiamo il conto, poi ci prepariamo ad andarcene."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:132
translate italian baigrottostartdate_ca01422f:

    # bai "It's so pretty out here, isn't it?"
    bai "È così bello qui fuori, vero?"

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:133
translate italian baigrottostartdate_44eeaf1a:

    # pc "Yeah it is."
    pc "Sì, è vero."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:139
translate italian baigrottostartdate_7c70709c:

    # "I lean in and kiss him, uncaring about anybody who might be watching us."
    "Mi avvicino e lo bacio, senza curarmi di chi possa guardarci."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:140
translate italian baigrottostartdate_61700a7a:

    # "He is surprised at first, but doesn't pull away."
    "All’inizio è sorpreso, ma non si tira indietro."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:143
translate italian baigrottostartdate_4a0dd6f7:

    # bai "I can't believe I just did that. Right in front of everybody."
    bai "Non riesco a credere di averlo appena fatto. Proprio davanti a tutti."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:144
translate italian baigrottostartdate_6e718b73:

    # pc "How did it feel?"
    pc "Com’è stato?"

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:145
translate italian baigrottostartdate_3696af55:

    # bai "It felt great."
    bai "È stato fantastico."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:150
translate italian baigrottostartdate_d90b231d:

    # bai "Want to go back to my apartment now?"
    bai "Vuoi tornare a casa mia adesso?"

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:153
translate italian baigrottostartdate_4861bda5:

    # bai "Aw, okay. Well it was a good date, anyway. Thanks for bringing me."
    bai "Oh, va bene. Beh, è stato comunque un bel appuntamento. Grazie per avermi portato qui."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:156
translate italian baigrottostartdate_29d9625f:

    # "We leave and I drive him to his aparment and say goodbye."
    "Ce ne andiamo e lo accompagno in auto a casa sua, poi ci salutiamo."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:157
translate italian baigrottostartdate_f1413fe1:

    # "Then I drive away to do something else with my night."
    "Poi me ne vado in macchina per fare qualcos’altro stasera."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:164
translate italian baigrottostartdate_ebdfbc55:

    # "We rush out to the car and drive back to his apartment."
    "Corriamo fuori verso la macchina e torniamo al suo appartamento."

