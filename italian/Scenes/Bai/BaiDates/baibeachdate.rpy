# game/Scenes/Bai/BaiDates/baibeachdate.rpy:19
translate italian baibeachdate_caf334cd:

    # "I pick Bai up and we drive out towards the beach."
    "Vado a prendere Bai e partiamo in auto verso la spiaggia."

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:21
translate italian baibeachdate_8ebfb187:

    # pc "Have you been out here before?"
    pc "Sei già stato qui prima d’ora?"

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:22
translate italian baibeachdate_64336c0b:

    # bai "Yeah, I sometimes come out here to run in the mornings."
    bai "Sì, ogni tanto vengo qui a correre la mattina."

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:23
translate italian baibeachdate_5f0b57d2:

    # bai "But I've never been out here with a cute guy before."
    bai "Ma non sono mai stata qui con un ragazzo carino prima d’ora."

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:29
translate italian baibeachdate_e914bd34:

    # "When we get to the beach, Bai pulls his shirt off."
    "Quando arriviamo in spiaggia, Bai si toglie la maglietta."

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:30
translate italian baibeachdate_835e0f75:

    # "He's already put suntan lotion on and his skin glistens in the light."
    "Si è già messo la crema solare e la sua pelle brilla alla luce."

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:31
translate italian baibeachdate_4cb4deb6:

    # bai "Ready to get in the water?"
    bai "Pronto a entrare in acqua?"

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:32
translate italian baibeachdate_39757b54:

    # pc "Yeah, let's do it."
    pc "Sì, facciamolo."

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:35
translate italian baibeachdate_67fe8962:

    # "We swim around for a while. Bai gets really into it."
    "Nuotiamo un po’ in giro. Bai ci si dà davvero dentro."

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:36
translate italian baibeachdate_eaa7bafe:

    # "We try racing a bit, but even though I'm a good swimmer, Bai is way too fast for me to keep up with."
    "Proviamo a fare una gara, ma anche se sono un buon nuotatore, Bai è troppo veloce per me e non riesco a stargli dietro."

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:39
translate italian baibeachdate_c4765999:

    # "After a while, we're both tired from swimming and the sun is starting to set, so we lie on the beach and dry off."
    "Dopo un po’, siamo entrambi stanchi per aver nuotato e il sole sta cominciando a tramontare, quindi ci sdraiamo sulla spiaggia e ci asciugiamo."

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:40
translate italian baibeachdate_3d2f7709:

    # "We lean back and talk for a while about whatever comes to mind."
    "Ci rilassiamo e chiacchieriamo un po’ di tutto ciò che ci passa per la testa."

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:47
translate italian baibeachdate_fb5239af:

    # bai "Well, I guess we should head back."
    bai "Beh, credo che dovremmo tornare indietro."

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:48
translate italian baibeachdate_e0511e98:

    # bai "This was fun though, man. Maybe next time there will be more girls out here, you know?"
    bai "È stato divertente, però, amico. Magari la prossima volta ci saranno più ragazze qui, sai?"

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:51
translate italian baibeachdate_9291d328:

    # "I drive Bai back to his apartment, then leave to go on with the rest of my day."
    "Accompagno Bai al suo appartamento, poi me ne vado per continuare la mia giornata."

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:62
translate italian baibeachdate_67f91a9e:

    # "When the sun starts to dip below the horizon, we take a moment to watch it together."
    "Quando il sole inizia a calare sotto l’orizzonte, ci prendiamo un momento per guardarlo insieme."

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:64
translate italian baibeachdate_c710bd77:

    # bai "This is so beautiful."
    bai "È così bello."

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:65
translate italian baibeachdate_409aa835:

    # "I can see his eyes tear up a bit."
    "Vedo che gli si inumidiscono un po’ gli occhi."

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:66
translate italian baibeachdate_7a029997:

    # bai "You make me feel so safe."
    bai "Mi fai sentire così al sicuro."

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:67
translate italian baibeachdate_fe07fc02:

    # pc "You're always safe with me."
    pc "Con me sei sempre al sicuro."

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:72
translate italian baibeachdate_e1672a1f:

    # bai "I'm so happy that we found each other."
    bai "Sono così felice che ci siamo trovati."

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:73
translate italian baibeachdate_afdaf298:

    # bai "I can't wait to get you back to my place."
    bai "Non vedo l’ora di portarti a casa mia."

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:78
translate italian baibeachdate_123df4e4:

    # bai "After the sun sets though."
    bai "Ma solo dopo il tramonto."

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:79
translate italian baibeachdate_63409295:

    # bai "I'm really enjoying this moment."
    bai "Mi sto davvero godendo questo momento."

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:83
translate italian baibeachdate_67ce83d2:

    # "After the sun sets, I drive us back to his apartment."
    "Dopo il tramonto, lo accompagno in auto al suo appartamento."

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:84
translate italian baibeachdate_64712708:

    # bai "Are you coming inside?"
    bai "Entri?"

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:89
translate italian baibeachdate_0ac06427:

    # bai "Cool. Let's go."
    bai "Perfetto. Andiamo."

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:92
translate italian baibeachdate_b7437714:

    # bai "Cool, let's go."
    bai "Perfetto, andiamo."

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:95
translate italian baibeachdate_32755ff3:

    # bai "Okay. Well, I had a good time with you anyway."
    bai "Ok. Beh, mi sono comunque divertito con te."

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:96
translate italian baibeachdate_5d4a4d14:

    # bai "I'll see you later."
    bai "Ci vediamo più tardi."

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:97
translate italian baibeachdate_1aff6c8c:

    # pc "See ya, Bai."
    pc "Ci vediamo, Bai."

