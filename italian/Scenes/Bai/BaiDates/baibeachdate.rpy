    # "He gets out and walks into his apartment building."
    "Scende dall’auto ed entra nel suo condominio."

# game/Scenes/Bai/BaiDates/baibeachdate.rpy:101
translate italian baibeachdate_5b3fbfe7:

    # "Then I drive away."
    "Poi me ne vado in auto."

