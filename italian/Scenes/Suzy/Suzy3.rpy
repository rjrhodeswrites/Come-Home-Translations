    # "Seems like Suzy may be interested in me as more than just her [brother]."
    "Sembra che Suzy possa essere interessata a me per qualcosa di più che essere solo la sua [brother]."

# game/Scenes/Suzy/Suzy3.rpy:78
translate italian suzy3_a3202b26:

    # "I'd definitely fuck her if I got the chance."
    "Me la scoperei sicuramente se ne avessi l’occasione."

# game/Scenes/Suzy/Suzy3.rpy:81
translate italian suzy3_c85b6a64:

    # "I should put a stop to this next time I talk to her."
    "Dovrei porre fine a questa situazione la prossima volta che le parlo."

# game/Scenes/Suzy/Suzy3.rpy:82
