translate italian suzyq1_3054faea:

    # ss "I love you, [bro]."
    ss "Ti amo, [bro]."

# game/Scenes/Suzy/SuzyConversations/suzyq1.rpy:58
translate italian suzyq1_2733b4a2:

    # pc "I love you too, [sis]."
    pc "Ti amo anch’io, [sis]."

