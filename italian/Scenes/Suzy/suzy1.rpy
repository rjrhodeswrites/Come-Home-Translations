# game/Scenes/Suzy/suzy1.rpy:13
translate italian suzy1_b52dca5a:

    # "I go to the kitchen and make a plate with what's left, then sit down across from her at the table."
    "Vado in cucina e mi preparo un piatto con quello che è rimasto, poi mi siedo di fronte a lei a tavola."

# game/Scenes/Suzy/suzy1.rpy:14
translate italian suzy1_c4e96a72:

    # "She puts her phone away and looks up at me."
    "Lei mette via il telefono e mi guarda."

# game/Scenes/Suzy/suzy1.rpy:17
translate italian suzy1_43f2e75d:

    # ss "So how's it been going [bro]?"
    ss "Allora, come sta andando [bro]?"

# game/Scenes/Suzy/suzy1.rpy:18
translate italian suzy1_d48b3188:

    # pc "Pretty good, I guess."
    pc "Abbastanza bene, credo."

# game/Scenes/Suzy/suzy1.rpy:19
translate italian suzy1_c84b49b4:

    # ss "Have you found out anything about Dad?"
    ss "Hai scoperto qualcosa su papà?"

# game/Scenes/Suzy/suzy1.rpy:20
translate italian suzy1_0b7558fc:

    # pc "Not yet."
    pc "Non ancora."

# game/Scenes/Suzy/suzy1.rpy:22
translate italian suzy1_e47fa0f8:

    # ss "I miss him."
    ss "Mi manca."

# game/Scenes/Suzy/suzy1.rpy:23
translate italian suzy1_0b941cef:

    # pc "You got along with him well?"
    pc "Andavi d’accordo con lui?"

# game/Scenes/Suzy/suzy1.rpy:24
translate italian suzy1_0442c0e0:

    # ss "Yeah."
    ss "Sì."

# game/Scenes/Suzy/suzy1.rpy:25
translate italian suzy1_d244b907:

    # ss "I mean, we didn't spend a lot of time together. He was down in that basement a lot."
    ss "Cioè, non passavamo molto tempo insieme. Stava spesso in quel seminterrato."

# game/Scenes/Suzy/suzy1.rpy:26
translate italian suzy1_34edb007:

    # ss "But he would have breakfast with me every morning before school. He was funny. He'd make me laugh every day."
    ss "Ma faceva colazione con me ogni mattina prima di andare a scuola. Era divertente. Mi faceva ridere ogni giorno."

# game/Scenes/Suzy/suzy1.rpy:27
translate italian suzy1_85af114e:

    # pc "Kind of like this, huh?"
    pc "Un po’ come adesso, eh?"

# game/Scenes/Suzy/suzy1.rpy:29
translate italian suzy1_226f4904:

    # ss "I said he was funny, not obnoxious. Plus, he wore pants. Why are you walking around in your boxers?"
    ss "Ho detto che era divertente, non odioso. E poi, lui indossava i pantaloni. Perché vai in giro in boxer?"

# game/Scenes/Suzy/suzy1.rpy:30
translate italian suzy1_4cc016bf:

    # pc "It's morning, I don't want to get dressed yet. You can eat breakfast in your underwear if you want."
    pc "È mattina, non ho ancora voglia di vestirmi. Puoi fare colazione in mutande se vuoi."

# game/Scenes/Suzy/suzy1.rpy:31
translate italian suzy1_bd01965a:

    # ss "Yeah, I bet you'd like that. You'd just stare at me the whole time."
    ss "Sì, scommetto che ti piacerebbe. Mi fisseresti per tutto il tempo."

# game/Scenes/Suzy/suzy1.rpy:35
translate italian suzy1_d7a0aba4:

    # ss "You're such a perv."
    ss "Sei proprio un pervertito."

# game/Scenes/Suzy/suzy1.rpy:38
translate italian suzy1_0ca3339d:

    # ss "You're such a jerk."
    ss "Sei proprio un idiota."

# game/Scenes/Suzy/suzy1.rpy:39
translate italian suzy1_a976ce63:

    # pc "Besides, you act like you don't stare at me when I'm in my boxers."
    pc "E poi, fai finta di non fissarmi quando sono in boxer."

# game/Scenes/Suzy/suzy1.rpy:40
translate italian suzy1_23992985:

    # ss "What!? I do not!"
    ss "Cosa!? Non è vero!"

# game/Scenes/Suzy/suzy1.rpy:41
translate italian suzy1_25e7a80f:

    # pc "Come on now [sis], I've seen you."
    pc "Dai, [sis], ti ho visto."

# game/Scenes/Suzy/suzy1.rpy:43
translate italian suzy1_873662ce:

    # ss "You're out of your mind. I've never stared at you. Like you have anything to stare at anyways."
    ss "Sei fuori di testa. Non ti ho mai fissato. Come se avessi qualcosa da guardare, comunque."

# game/Scenes/Suzy/suzy1.rpy:44
translate italian suzy1_6e7bc529:

    # pc "Oh I don't have anything to stare at?"
    pc "Oh, non ho niente da guardare?"

# game/Scenes/Suzy/suzy1.rpy:45
translate italian suzy1_ec7a8238:

    # ss "Nope."
    ss "No."

# game/Scenes/Suzy/suzy1.rpy:48
translate italian suzy1_7745b76d:

    # ss "Yeah, whatever."
    ss "Sì, come ti pare."

# game/Scenes/Suzy/suzy1.rpy:51
translate italian suzy1_24166e5d:

    # ss "No! I don't want to see!"
    ss "No! Non voglio vedere!"

# game/Scenes/Suzy/suzy1.rpy:52
translate italian suzy1_483160a9:

    # ss "Sit down. Stop playing around."
    ss "Siediti. Smettila di scherzare."

# game/Scenes/Suzy/suzy1.rpy:53
translate italian suzy1_ce7899d2:

    # pc "I'm not playing. I'll show you."
    pc "Non sto scherzando. Te lo faccio vedere."

# game/Scenes/Suzy/suzy1.rpy:54
translate italian suzy1_626bbd17:

    # ss "I don't want to see it. I believe you have something there, but I don't want to see it."
    ss "Non voglio vederlo. Credo che tu abbia qualcosa lì, ma non voglio vederlo."

# game/Scenes/Suzy/suzy1.rpy:55
translate italian suzy1_c1226f21:

    # ss "Put it away, sit down."
    ss "Mettilo via, siediti."

# game/Scenes/Suzy/suzy1.rpy:56
translate italian suzy1_02b8ec2b:

    # pc "Alright, I'm sitting."
    pc "Va bene, mi siedo."

# game/Scenes/Suzy/suzy1.rpy:58
translate italian suzy1_c7580a8a:

    # ss "You're such a weirdo."
    ss "Sei proprio uno strano."

# game/Scenes/Suzy/suzy1.rpy:59
translate italian suzy1_086a625f:

    # "We spend the rest of the breakfast talking about school and work and joking around."
    "Passiamo il resto della colazione a parlare di scuola e di lavoro e a scherzare."

# game/Scenes/Suzy/suzy1.rpy:60
translate italian suzy1_74d7aff9:

    # "Then we finish eating and it's time to go to school."
    "Poi finiamo di mangiare ed è ora di andare a scuola."

# game/Scenes/Suzy/suzy1.rpy:65
translate italian suzy1_74b357a7:

    # ss "Have a good day [bro]. See you later."
    ss "Buona giornata [bro]. Ci vediamo più tardi."

# game/Scenes/Suzy/suzy1.rpy:66
translate italian suzy1_7dee10c4:

    # pc "Bye [sis]."
    pc "Ciao [sis]."

# game/Scenes/Suzy/suzy1.rpy:71
translate italian suzy1_015cad61:

    # "She leaves for school and I follow right after her."
    "Lei parte per la scuola e io la seguo subito dopo."

