# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:18
translate italian suzytammyicecreamdate_4ffc27b3:

    # "When Suzy is ready, we leave and meet Tammy at the ice cream parlor."
    "Quando Suzy è pronta, usciamo e incontriamo Tammy alla gelateria."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:21
translate italian suzytammyicecreamdate_52a33e67:

    # ss "Oh my God, they have coconut. I want that please."
    ss "Oh mio Dio, hanno il gusto al cocco. Lo voglio, per favore."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:22
translate italian suzytammyicecreamdate_26a56ba4:

    # tm "I'll get the cappuccino chocolate chunk frozen yogurt."
    tm "Prenderò lo yogurt gelato al cappuccino con pezzetti di cioccolato."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:23
translate italian suzytammyicecreamdate_4dc17a69:

    # ss "Don't you get enough coffee at work? I kinda hate the smell of it now."
    ss "Non bevi già abbastanza caffè al lavoro? Ormai ne detesto quasi l’odore."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:24
translate italian suzytammyicecreamdate_d1ff38f6:

    # tm "I think I'm the opposite. I love it. The smell, the taste, everything."
    tm "Penso di essere l’opposto. Lo adoro. L’odore, il sapore, tutto."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:25
translate italian suzytammyicecreamdate_10f4b187:

    # ss "Blech!"
    ss "Che schifo!"

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:31
translate italian suzytammyicecreamdate_a716a63e:

    # "We sit down and enjoy our ice cream and chat for a while."
    "Ci sediamo, ci godiamo il gelato e chiacchieriamo un po’."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:39
translate italian suzytammyicecreamdate_d478079d:

    # "When the ice cream is gone, our conversation slows down."
    "Quando il gelato è finito, la nostra conversazione rallenta."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:41
translate italian suzytammyicecreamdate_76de8536:

    # tm "Well, it's getting late. I better head home."
    tm "Beh, si sta facendo tardi. È meglio che torni a casa."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:43
translate italian suzytammyicecreamdate_6e8b8aa4:

    # ss "Aw, you don't want to come back to the house with us?"
    ss "Oh, non vuoi venire a casa con noi?"

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:44
translate italian suzytammyicecreamdate_a1afa737:

    # tm "I can't, baby. Sorry."
    tm "Non posso, tesoro. Mi dispiace."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:49
translate italian suzytammyicecreamdate_7661b3c0:

    # tm "I had fun though. Love you both. Have a good night without me."
    tm "Mi sono divertita comunque. Vi voglio bene. Passate una bella serata senza di me."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:52
translate italian suzytammyicecreamdate_38516bbc:

    # ss "Oh, we will."
    ss "Oh, lo faremo."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:53
translate italian suzytammyicecreamdate_fb8e986c:

    # pc "But not as much fun as if you were there too."
    pc "Ma non ci divertiremo tanto quanto se ci fossi anche tu."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:56
translate italian suzytammyicecreamdate_05f57ea7:

    # "Tammy leaves, then Suzy and I drive back home."
    "Tammy se ne va, poi io e Suzy torniamo a casa in macchina."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:61
translate italian suzytammyicecreamdate_d41d8cd9:

    # voice 'voices/suzy_enditproperly.mp3'
    voice 'voices/suzy_enditproperly.mp3'

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:62
translate italian suzytammyicecreamdate_643c2201:

    # ss "Looks like Mom is already asleep. So, do you want to end the date here, or head up to your room and end it properly?"
    ss "Sembra che la mamma stia già dormendo. Allora, vuoi concludere l’appuntamento qui, o salire in camera tua e concluderlo come si deve?"

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:65
translate italian suzytammyicecreamdate_b9e9893b:

    # ss "I was hoping you would say that."
    ss "Speravo che lo dicessi."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:68
translate italian suzytammyicecreamdate_60c94072:

    # "We quietly go upstairs together, go into my bedroom, and lock the door."
    "Saliamo insieme in silenzio, entriamo nella mia camera da letto e chiudiamo la porta a chiave."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:71
translate italian suzytammyicecreamdate_acfb634b:

    # ss "Okay, well I had a fun date, [bro]."
    ss "Ok, beh, è stato un appuntamento divertente, [bro]."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:72
translate italian suzytammyicecreamdate_1fea12f8:

    # ss "Sleep well. I'll see you tomorrow."
    ss "Dormi bene. Ci vediamo domani."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:79
translate italian suzytammyicecreamdate_65007bab:

    # tm "I don't know about you two, but I'm ready to head back home."
    tm "Non so voi due, ma io sono pronto a tornare a casa."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:80
translate italian suzytammyicecreamdate_f89287b0:

    # ss "That sounds good to me. You ready to take this date back to the house, [bro]?"
    ss "Per me va bene. Sei pronto a portare questa ragazza a casa, [bro]?"

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:81
translate italian suzytammyicecreamdate_a400a310:

    # pc "Sure, let's go home."
    pc "Certo, andiamo a casa."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:86
translate italian suzytammyicecreamdate_d41d8cd9_1:

    # voice 'voices/suzy_enditproperly.mp3'
    voice 'voices/suzy_enditproperly.mp3'

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:87
translate italian suzytammyicecreamdate_643c2201_1:

    # ss "Looks like Mom is already asleep. So, do you want to end the date here, or head up to your room and end it properly?"
    ss "Sembra che la mamma stia già dormendo. Allora, vuoi concludere l’appuntamento qui, o salire in camera tua e finirlo come si deve?"

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:90
translate italian suzytammyicecreamdate_df8719cf:

    # tm "Fuck yes."
    tm "Cazzo, sì."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:93
translate italian suzytammyicecreamdate_60c94072_1:

    # "We quietly go upstairs together, go into my bedroom, and lock the door."
    "Saliamo insieme in silenzio, entriamo nella mia camera da letto e chiudiamo la porta a chiave."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:97
translate italian suzytammyicecreamdate_acfb634b_1:

    # ss "Okay, well I had a fun date, [bro]."
    ss "Ok, beh, mi sono divertita durante l’appuntamento, [bro]."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:98
translate italian suzytammyicecreamdate_be17834a:

    # tm "Yeah, me too."
    tm "Sì, anch’io."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:99
translate italian suzytammyicecreamdate_644a5289:

    # ss "Sleep well. See you tomorrow."
    ss "Dormi bene. Ci vediamo domani."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:100
translate italian suzytammyicecreamdate_d35669a0:

    # tm "Good night, [pcname]."
    tm "Buonanotte, [pcname]."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:103
translate italian suzytammyicecreamdate_d747330a:

    # "They go up to Suzy's bedroom, leaving me to decide what I want to do with my night."
    "Salgono nella camera da letto di Suzy, lasciandomi decidere cosa fare della mia serata."

