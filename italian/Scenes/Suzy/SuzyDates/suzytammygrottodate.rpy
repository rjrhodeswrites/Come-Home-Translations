translate italian suzytammygrottodate_edef91a3:

    # "We get ready and go out to The Grotto together."
    "Ci prepariamo e usciamo insieme per andare al Grotto."

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:19
translate italian suzytammygrottodate_a118cb72:

    # ss "I love this place."
    ss "Adoro questo posto."

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:21
translate italian suzytammygrottodate_f556393a:

    # tm "Me too. Thanks for taking us, [pcname]."
    tm "Anch'io. Grazie per averci portato qui, [pcname]."

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:23
translate italian suzytammygrottodate_ad1121f0:

    # ss "Yeah, thanks [bro]."
    ss "Sì, grazie [bro]."

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:25
translate italian suzytammygrottodate_a91a4522:

    # "We chat while we eat and enjoy the atmosphere."
    "Chiacchieriamo mentre mangiamo e ci godiamo l’atmosfera."

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:33
translate italian suzytammygrottodate_a306e385:

    # "After we eat, we dance to a couple of songs."
    "Dopo aver mangiato, balliamo al ritmo di un paio di canzoni."

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:36
translate italian suzytammygrottodate_ffb49b98:

    # "Fuck, they're gorgeous. I can't help but to stare at them and wonder how I got to be so lucky."
    "Cazzo, sono bellissime. Non posso fare a meno di fissarle e chiedermi come ho fatto ad essere così fortunato."

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:39
translate italian suzytammygrottodate_7909898e:

    # ss "You ready to take us home, [bro]?"
    ss "Sei pronto a riportarci a casa, [bro]?"

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:40
translate italian suzytammygrottodate_3dae9d31:

    # pc "Uh, yeah... we should go."
    pc "Ehm, sì... dovremmo andare."

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:46
translate italian suzytammygrottodate_d41d8cd9:

    # voice 'voices/suzy_enditproperly.mp3'
    voice 'voices/suzy_enditproperly.mp3'

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:47
translate italian suzytammygrottodate_643c2201:

    # ss "Looks like Mom is already asleep. So, do you want to end the date here, or head up to your room and end it properly?"
    ss "Sembra che la mamma stia già dormendo. Allora, vuoi concludere l’appuntamento qui, o salire in camera tua e finirlo come si deve?"

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:50
translate italian suzytammygrottodate_df8719cf:

    # tm "Fuck yes."
    tm "Cazzo, sì."

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:53
translate italian suzytammygrottodate_621e1461:

    # "We quietly walk upstairs together, go into my bedroom, and lock the door."
    "Saliamo insieme in silenzio le scale, entriamo nella mia camera da letto e chiudiamo la porta a chiave."

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:58
translate italian suzytammygrottodate_acfb634b:

    # ss "Okay, well I had a fun date, [bro]."
    ss "Ok, beh, mi sono divertita, [bro]."

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:59
translate italian suzytammygrottodate_be17834a:

    # tm "Yeah, me too."
    tm "Sì, anch’io."

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:60
translate italian suzytammygrottodate_644a5289:

    # ss "Sleep well. See you tomorrow."
    ss "Dormi bene. Ci vediamo domani."

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:61
translate italian suzytammygrottodate_d35669a0:

    # tm "Good night, [pcname]."
    tm "Buonanotte, [pcname]."

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:64
translate italian suzytammygrottodate_d747330a:

    # "They go up to Suzy's bedroom, leaving me to decide what I want to do with my night."
    "Salgono nella camera da letto di Suzy, lasciandomi decidere cosa fare della mia serata."

