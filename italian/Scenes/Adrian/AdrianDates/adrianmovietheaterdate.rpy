translate italian adrianmovietheaterstartdate_13ddb197:

    # "We get to the theater and find seats in the back."
    "Arriviamo al cinema e troviamo dei posti in fondo."

# game/Scenes/Adrian/AdrianDates/adrianmovietheaterdate.rpy:26
translate italian adrianmovietheaterstartdate_6cc4cd44:

    # "There's a little time to chat before the movie starts."
    "C'è un po' di tempo per chiacchierare prima che inizi il film."

# game/Scenes/Adrian/AdrianDates/adrianmovietheaterdate.rpy:32
translate italian adrianmovietheaterstartdate_c6fd13bc:

    # "Finally lights dim and she leans over against me while we watch the movie."
    "Finalmente le luci si abbassano e lei si appoggia a me mentre guardiamo il film."

# game/Scenes/Adrian/AdrianDates/adrianmovietheaterdate.rpy:33
translate italian adrianmovietheaterstartdate_d2fbe7b2:

    # "It's pretty good and it's nice just being there with her."
    "È piuttosto bello ed è piacevole stare lì con lei."

# game/Scenes/Adrian/AdrianDates/adrianmovietheaterdate.rpy:38
translate italian adrianmovietheaterstartdate_9dc3692e:

    # "Finally the lights dim and the movie starts. It's not bad."
    "Finalmente le luci si abbassano e il film inizia. Non è male."

# game/Scenes/Adrian/AdrianDates/adrianmovietheaterdate.rpy:40
translate italian adrianmovietheaterstartdate_9b19c90f:

    # gg "That was pretty good, huh?"
    gg "È stato piuttosto bello, eh?"

# game/Scenes/Adrian/AdrianDates/adrianmovietheaterdate.rpy:41
translate italian adrianmovietheaterstartdate_a57bb1cd:

    # "We chat a little through the credits."
    "Chiacchieriamo un po’ durante i titoli di coda."

# game/Scenes/Adrian/AdrianDates/adrianmovietheaterdate.rpy:46
translate italian adrianmovietheaterstartdate_cb13127e:

    # "Afterwards, I drive her home and walk her up to her door."
    "Dopo, la accompagno a casa in auto e la accompagno fino alla porta."

