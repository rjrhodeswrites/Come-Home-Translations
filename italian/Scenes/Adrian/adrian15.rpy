    "Il mio telefono inizia a vibrare in tasca. Lo tiro fuori e vedo che è Adrian a chiamarmi."

# game/Scenes/Adrian/adrian15.rpy:20
translate italian adrian15_bea5e8cb:

    # pc "Hello?"
    pc "Pronto?"

# game/Scenes/Adrian/adrian15.rpy:21
translate italian adrian15_f9cf1bde:

    # gg "Hey, [pcname]. You busy?"
    gg "Ehi, [pcname]. Sei occupato?"

# game/Scenes/Adrian/adrian15.rpy:22
translate italian adrian15_e74e5c12:

    # pc "Not really. What's up?"
    pc "Non proprio. Che succede?"

# game/Scenes/Adrian/adrian15.rpy:24
translate italian adrian15_aa2be04d:

    # gg "Want to come over and play some games or something? Hang out for a bit?"
    gg "Ti va di passare da me a giocare un po' o qualcosa del genere? Stare un po' insieme?"

# game/Scenes/Adrian/adrian15.rpy:26
translate italian adrian15_e5c1fea0:

    # gg "My mom's not home."
    gg "Mia mamma non è a casa."

# game/Scenes/Adrian/adrian15.rpy:32
translate italian adrian15_75da4880:

    # gg "Aw, alright."
    gg "Oh, va bene."

# game/Scenes/Adrian/adrian15.rpy:34
translate italian adrian15_29cb8792:

    # gg "Maybe next weekend then."
    gg "Magari il prossimo fine settimana, allora."

# game/Scenes/Adrian/adrian15.rpy:35
translate italian adrian15_ba01fe47:

    # pc "Okay, see you later, Adrian."
    pc "Ok, ci vediamo più tardi, Adrian."

# game/Scenes/Adrian/adrian15.rpy:36
translate italian adrian15_225cc39e:

    # gg "See ya."
    gg "Ci vediamo."

# game/Scenes/Adrian/adrian15.rpy:42
translate italian adrian15_997826d2:

    # pc "I'll be right over."
    pc "Arrivo subito."

# game/Scenes/Adrian/adrian15.rpy:44
translate italian adrian15_1f3fc4dd:

    # gg "Awesome! See you then."
    gg "Fantastico! Ci vediamo allora."

# game/Scenes/Adrian/adrian15.rpy:48
translate italian adrian15_3415b62c:

    # "I get ready real quick and drive over to Adrian's house to hang out with her."
    "Mi preparo in un attimo e vado in macchina a casa di Adrian per passare un po’ di tempo con lei."

# game/Scenes/Adrian/adrian15.rpy:52
translate italian adrian15_0be6e60c:

    # "She greets me in the kitchen with a deep kiss."
    "Mi accoglie in cucina con un bacio appassionato."

# game/Scenes/Adrian/adrian15.rpy:53
translate italian adrian15_19e9b3da:

    # gg "We {i}could{/i} just skip straight to the sex today, but I do really want to play some games."
    gg "Oggi {i}potremmo{/i} saltare direttamente al sesso, ma ho davvero voglia di giocare un po’."

# game/Scenes/Adrian/adrian15.rpy:54
translate italian adrian15_216dab98:

    # gg "Is that okay?"
    gg "Ti va bene?"

# game/Scenes/Adrian/adrian15.rpy:55
translate italian adrian15_e1f76998:

    # pc "Of course. I was looking forward to playing games with you too."
    pc "Certo. Anch’io non vedevo l’ora di giocare con te."

# game/Scenes/Adrian/adrian15.rpy:59
translate italian adrian15_abe6c25e:

    # "We go upstairs and start playing."
    "Saliamo al piano di sopra e iniziamo a giocare."

# game/Scenes/Adrian/adrian15.rpy:61
translate italian adrian15_c8f89ecf:

    # "As soon as I get there, we go upstairs and start playing."
    "Appena arrivo, saliamo al piano di sopra e iniziamo a giocare."

# game/Scenes/Adrian/adrian15.rpy:62
translate italian adrian15_d2b3fa04:

    # "As usual, she's just a little bit better than me at just about everything we play."
    "Come al solito, è solo un po’ più brava di me in praticamente tutto quello a cui giochiamo."

# game/Scenes/Adrian/adrian15.rpy:64
translate italian adrian15_1c125346:

    # gg "Ooh, you're getting frustrated. I want you to take that out on me later."
    gg "Ooh, ti stai innervosendo. Voglio che te la prenda con me più tardi."

# game/Scenes/Adrian/adrian15.rpy:65
translate italian adrian15_49db3af1:

    # pc "Oh I will. I'm going to fucking pound you."
    pc "Oh, lo farò. Ti scoperò a morte."

# game/Scenes/Adrian/adrian15.rpy:66
translate italian adrian15_05fc893c:

    # gg "Not as hard as I'm pounding you right now."
    gg "Non così forte come ti sto scopando in questo momento."

# game/Scenes/Adrian/adrian15.rpy:68
translate italian adrian15_23cf97cd:

    # gg "You're getting frustrated. Want me to take it easy on you?"
    gg "Ti stai innervosendo. Vuoi che ci vada piano con te?"

# game/Scenes/Adrian/adrian15.rpy:69
translate italian adrian15_07b12e2a:

    # pc "Absolutely not."
    pc "Assolutamente no."

# game/Scenes/Adrian/adrian15.rpy:70
translate italian adrian15_61c39868:

    # gg "Okay then."
    gg "Va bene allora."

# game/Scenes/Adrian/adrian15.rpy:73
translate italian adrian15_e6bf8cf8:

    # gg "Get wrecked!"
    gg "Fatti distruggere!"

# game/Scenes/Adrian/adrian15.rpy:74
translate italian adrian15_458a16fb:

    # pc "Damn it!"
    pc "Dannazione!"

# game/Scenes/Adrian/adrian15.rpy:75
translate italian adrian15_e2f2f564:

    # "Just then, Adrian's phone starts to ring."
    "Proprio in quel momento, il telefono di Adrian inizia a squillare."

# game/Scenes/Adrian/adrian15.rpy:78
translate italian adrian15_1ff26783:

    # gg "Oh hold on, my cousin is calling. I gotta answer this."
    gg "Oh aspetta, mi sta chiamando mia cugina. Devo rispondere."

# game/Scenes/Adrian/adrian15.rpy:79
translate italian adrian15_9b761d73:

    # pc "Okay, no problem."
    pc "Ok, nessun problema."

# game/Scenes/Adrian/adrian15.rpy:82
translate italian adrian15_993631a3:

    # gg "Hey, cuz. What's up?"
    gg "Ehi, cugina. Come va?"

# game/Scenes/Adrian/adrian15.rpy:83
translate italian adrian15_55836b8e:

    # gg "Not really, just hanging out with a friend."
    gg "Non di particolare, sto solo passando un po’ di tempo con un’amica."

# game/Scenes/Adrian/adrian15.rpy:84
translate italian adrian15_1717d990:

    # gg "You're almost here already?"
    gg "Sei già quasi arrivata?"

# game/Scenes/Adrian/adrian15.rpy:85
translate italian adrian15_82261785:

    # gg "Okay then, see you in a few minutes."
    gg "Va bene allora, ci vediamo tra pochi minuti."

# game/Scenes/Adrian/adrian15.rpy:88
translate italian adrian15_d0342fde:

    # gg "She's coming over to see me."
    gg "Sta venendo a trovarmi."

# game/Scenes/Adrian/adrian15.rpy:89
translate italian adrian15_241b8044:

    # gg "Sorry, this is completely unexpected."
    gg "Scusa, è una cosa del tutto inaspettata."

# game/Scenes/Adrian/adrian15.rpy:90
translate italian adrian15_58426ace:

    # gg "But I'm excited that you're going to get to meet her!"
    gg "Ma sono entusiasta che tu possa conoscerla!"

# game/Scenes/Adrian/adrian15.rpy:91
translate italian adrian15_6f1ff7f5:

    # pc "You two get along, I guess?"
    pc "Voi due andate d’accordo, immagino?"

# game/Scenes/Adrian/adrian15.rpy:92
translate italian adrian15_56ba3372:

    # gg "Yeah, she's amazing. I love her so much."
    gg "Sì, è fantastica. Le voglio tantissimo bene."

# game/Scenes/Adrian/adrian15.rpy:93
translate italian adrian15_f36cae87:

    # gg "Come on, let's go down and greet her."
    gg "Dai, scendiamo a salutarla."

# game/Scenes/Adrian/adrian15.rpy:96
translate italian adrian15_e520b635:

    # "We go downstairs and wait outside for a few minutes before a woman pulls up on a motorcycle and parks in Adrian's driveway."
    "Scendiamo e aspettiamo fuori per qualche minuto prima che una donna arrivi in moto e parcheggi nel vialetto di Adrian."

# game/Scenes/Adrian/adrian15.rpy:97
translate italian adrian15_327f8422:

    # gg "There she is!"
    gg "Eccola lì!"

# game/Scenes/Adrian/adrian15.rpy:98
translate italian adrian15_80f73ec8:

    # gg "Thena!"
    gg "Thena!"

# game/Scenes/Adrian/adrian15.rpy:101
translate italian adrian15_41689eaf:

    # gg "What's going on, cuz?"
    gg "Che succede, cugina?"

# game/Scenes/Adrian/adrian15.rpy:103
translate italian adrian15_bdbb7e4a:

    # ath "Ugh, I have so much to tell you."
    ath "Uff, ho tantissime cose da raccontarti."

# game/Scenes/Adrian/adrian15.rpy:106
translate italian adrian15_f34f39f9:

    # "Adrian rushes towards her and they hug."
    "Adrian le corre incontro e si abbracciano."

# game/Scenes/Adrian/adrian15.rpy:107
translate italian adrian15_8a2ad9ef:

    # ath "Can we go inside and talk for a bit?"
    ath "Possiamo entrare e parlare un po’?"

# game/Scenes/Adrian/adrian15.rpy:108
translate italian adrian15_6cec5501:

    # gg "Sure."
    gg "Certo."

# game/Scenes/Adrian/adrian15.rpy:111
translate italian adrian15_40382c6b:

    # ath "Oh, who's this?"
    ath "Oh, chi è questo?"

# game/Scenes/Adrian/adrian15.rpy:113
translate italian adrian15_f248dcf0:

    # gg "This is my boyfriend, [pcname]. [pcname], this is my cousin, Athena."
    gg "Questo è il mio ragazzo, [pcname]. [pcname], questa è mia cugina, Athena."

# game/Scenes/Adrian/adrian15.rpy:115
translate italian adrian15_2fec0547:

    # gg "This is my friend, [pcname]. [pcname], this is my cousin, Athena."
    gg "Questo è un mio amico, [pcname]. [pcname], questa è mia cugina, Athena."

# game/Scenes/Adrian/adrian15.rpy:116
translate italian adrian15_bc87a0d4:

    # pc "Nice to meet you."
    pc "Piacere di conoscerti."

# game/Scenes/Adrian/adrian15.rpy:117
translate italian adrian15_15faa5ea:

    # ath "Yeah, you too."
    ath "Sì, anche a me."

# game/Scenes/Adrian/adrian15.rpy:122
translate italian adrian15_7ac147ee:

    # "We go in and go upstairs and sit in the bedroom and the tone immediately changes to something more somber and uncomfortable."
    "Entriamo, saliamo al piano di sopra e ci sediamo in camera da letto; l’atmosfera cambia immediatamente, diventando più cupa e imbarazzante."

# game/Scenes/Adrian/adrian15.rpy:123
translate italian adrian15_da185fde:

    # pc "Should I go? Do you two need to talk?"
    pc "Dovrei andarmene? Voi due avete bisogno di parlare?"

# game/Scenes/Adrian/adrian15.rpy:124
translate italian adrian15_6b5e2f35:

    # gg "No, you don't have to go."
    gg "No, non devi andartene."

# game/Scenes/Adrian/adrian15.rpy:125
translate italian adrian15_ff42571e:

    # gg "Right, Athena? What's going on? Did something happen?"
    gg "Giusto, Athena? Che succede? È successo qualcosa?"

# game/Scenes/Adrian/adrian15.rpy:128
translate italian adrian15_cd5138a1:

    # ath "Yeah, but I'm not allowed to tell you everything."
    ath "Sì, ma non mi è permesso dirti tutto."

# game/Scenes/Adrian/adrian15.rpy:129
translate italian adrian15_0937f8ec:

    # ath "I'm going to be leaving for a while. For my own protection."
    ath "Me ne andrò per un po’. Per la mia sicurezza."

# game/Scenes/Adrian/adrian15.rpy:132
translate italian adrian15_ea61cda2:

    # gg "What do you mean? Are you in trouble?"
    gg "Cosa intendi? Sei nei guai?"

# game/Scenes/Adrian/adrian15.rpy:134
translate italian adrian15_d6235708:

    # ath "I got mixed up in something. I can't tell you any more about it right now."
    ath "Mi sono ritrovata coinvolta in una faccenda. Per ora non posso dirti altro."

# game/Scenes/Adrian/adrian15.rpy:135
translate italian adrian15_a6ace00b:

    # ath "Hopefully some day. Whenever it all blows over."
    ath "Spero di potertelo raccontare un giorno. Quando tutto si sarà calmato."

# game/Scenes/Adrian/adrian15.rpy:137
translate italian adrian15_8643f80d:

    # gg "What do you mean you have to leave?"
    gg "Cosa vuol dire che devi andartene?"

# game/Scenes/Adrian/adrian15.rpy:139
translate italian adrian15_666954cc:

    # ath "I have to cut contact with everybody. Witness protection."
    ath "Devo interrompere ogni contatto con tutti. Programma di protezione testimoni."

# game/Scenes/Adrian/adrian15.rpy:141
translate italian adrian15_479d733b:

    # gg "Cut contact? So we're not going to be able to talk? At all?"
    gg "Interrompere ogni contatto? Quindi non potremo più parlare? Proprio per niente?"

# game/Scenes/Adrian/adrian15.rpy:144
translate italian adrian15_dc747734:

    # ath "Not for a while."
    ath "Non per un po'."

# game/Scenes/Adrian/adrian15.rpy:145
translate italian adrian15_49c637e0:

    # gg "How long?"
    gg "Per quanto tempo?"

# game/Scenes/Adrian/adrian15.rpy:146
translate italian adrian15_7b465be2:

    # ath "I don't know."
    ath "Non lo so."

# game/Scenes/Adrian/adrian15.rpy:147
translate italian adrian15_024a8128:

    # gg "Are you in danger?"
    gg "Sei in pericolo?"

# game/Scenes/Adrian/adrian15.rpy:148
translate italian adrian15_619b8851:

    # gg "Because you know I would burn the whole world down for you."
    gg "Perché lo sai che per te darei fuoco al mondo intero."

# game/Scenes/Adrian/adrian15.rpy:151
translate italian adrian15_10475b4e:

    # ath "I know. I'd do the same for you too."
    ath "Lo so. Anch’io farei lo stesso per te."

# game/Scenes/Adrian/adrian15.rpy:152
translate italian adrian15_db6c9ba9:

    # gg "Do we need to? Go on a Thelma and Louise style cross-country escape?"
    gg "Dobbiamo farlo? Partire per una fuga attraverso il Paese in stile “Thelma e Louise”?"

# game/Scenes/Adrian/adrian15.rpy:153
translate italian adrian15_938aadfc:

    # ath "No, it's okay, Adrian."
    ath "No, va tutto bene, Adrian."

# game/Scenes/Adrian/adrian15.rpy:156
translate italian adrian15_9d14717d:

    # ath "I'll be safe. And I'll be with people I love."
    ath "Sarò al sicuro. E sarò con le persone che amo."

# game/Scenes/Adrian/adrian15.rpy:157
translate italian adrian15_ad669f44:

    # ath "I'll just be... hidden for a while."
    ath "Starò solo... nascosta per un po’."

# game/Scenes/Adrian/adrian15.rpy:160
translate italian adrian15_ab7ecd37:

    # ath "But you don't have to worry about me, I promise."
    ath "Ma non devi preoccuparti per me, te lo prometto."

# game/Scenes/Adrian/adrian15.rpy:161
translate italian adrian15_6fc1467e:

    # ath "And as soon as I'm able to, I'll contact you."
    ath "E non appena potrò, ti contatterò."

# game/Scenes/Adrian/adrian15.rpy:162
translate italian adrian15_f33637a0:

    # ath "This isn't a goodbye. Just a see you later. Okay?"
    ath "Questo non è un addio. È solo un \"ci vediamo presto\". Ok?"

# game/Scenes/Adrian/adrian15.rpy:165
translate italian adrian15_97b198b3:

    # gg "It feels like a goodbye."
    gg "Sembra proprio un addio."

# game/Scenes/Adrian/adrian15.rpy:166
translate italian adrian15_1ba8b0dd:

    # ath "Oh don't cry, cuz, please. You'll make me cry too."
    ath "Oh, non piangere, cugino, ti prego. Mi farai piangere anch'io."

# game/Scenes/Adrian/adrian15.rpy:169
translate italian adrian15_0e2cfb70:

    # gg "I just don't know what I'm going to do without being able to talk to you and play games with you every night."
    gg "È solo che non so cosa farò senza poter parlare con te e giocare con te ogni sera."

# game/Scenes/Adrian/adrian15.rpy:170
translate italian adrian15_0b0416f8:

    # gg "I'm going to miss you so much."
    gg "Mi mancherai tantissimo."

# game/Scenes/Adrian/adrian15.rpy:171
translate italian adrian15_4851e337:

    # ath "I'll miss you too, Adrian."
    ath "Mi mancherai anche tu, Adrian."

# game/Scenes/Adrian/adrian15.rpy:172
translate italian adrian15_decbe2a6:

    # ath "You'll be okay though. You have friends. You are loved."
    ath "Ma starai bene. Hai degli amici. Sei amato."

# game/Scenes/Adrian/adrian15.rpy:173
translate italian adrian15_b994f8f3:

    # ath "And one day I'll call you and we'll hang out and I'll tell you everything."
    ath "E un giorno ti chiamerò, usciremo insieme e ti racconterò tutto."

# game/Scenes/Adrian/adrian15.rpy:176
translate italian adrian15_baad95b7:

    # gg "You better."
    gg "Faresti meglio."

# game/Scenes/Adrian/adrian15.rpy:177
translate italian adrian15_e694fdb2:

    # gg "Or I might come looking for you, and I'll take out anybody in my way."
    gg "Altrimenti potrei venire a cercarti e farò fuori chiunque mi si metta in mezzo."

# game/Scenes/Adrian/adrian15.rpy:178
translate italian adrian15_0cebbbe1:

    # gg "I have a very particular set of skills."
    gg "Ho un set di abilità molto particolare."

# game/Scenes/Adrian/adrian15.rpy:179
translate italian adrian15_46263ea2:

    # ath "I'm not sure how mob management with ice magic or looking amazing in a tank top is going to help you there."
    ath "Non sono sicura di come gestire le folle con la magia del ghiaccio o apparire fantastica in canottiera possa aiutarti in quel caso."

# game/Scenes/Adrian/adrian15.rpy:180
translate italian adrian15_5b9f42ef:

    # gg "Fine. I might need to obtain more skills."
    gg "Va bene. Forse dovrò acquisire altre abilità."

# game/Scenes/Adrian/adrian15.rpy:183
translate italian adrian15_297bbe15:

    # ath "So, my ride is going to be here to pick me up soon. I don't have a lot of time."
    ath "Allora, la macchina che mi viene a prendere arriverà tra poco. Non ho molto tempo."

# game/Scenes/Adrian/adrian15.rpy:184
translate italian adrian15_083bd235:

    # ath "But I do have some good news for you too."
    ath "Ma ho anche una bella notizia per te."

# game/Scenes/Adrian/adrian15.rpy:185
translate italian adrian15_5f5f9537:

    # gg "Oh really?"
    gg "Davvero?"

# game/Scenes/Adrian/adrian15.rpy:188
translate italian adrian15_c24bc319:

    # ath "I'm not going to need my bike anymore. So it's all yours."
    ath "Non avrò più bisogno della mia bici. Quindi è tutta tua."

# game/Scenes/Adrian/adrian15.rpy:189
translate italian adrian15_9e813a25:

    # gg "What!? You're just giving it to me!?"
    gg "Cosa!? Me la regali e basta!?"

# game/Scenes/Adrian/adrian15.rpy:190
translate italian adrian15_ca7279be:

    # ath "Sure. You had a blast riding it when you visited me last and I can't take it with me."
    ath "Certo. Ti sei divertita un mondo a usarla quando sei venuta a trovarmi l’ultima volta e io non posso portarla con me."

# game/Scenes/Adrian/adrian15.rpy:191
translate italian adrian15_f0112aa2:

    # ath "So I wanted you to have it."
    ath "Quindi volevo che la tenessi tu."

# game/Scenes/Adrian/adrian15.rpy:194
translate italian adrian15_6fb0514f:

    # gg "You're amazing, Thena. I love you."
    gg "Sei fantastica, Thena. Ti voglio bene."

# game/Scenes/Adrian/adrian15.rpy:195
translate italian adrian15_a77a6e8c:

    # ath "I love you too, cuz."
    ath "Anch’io ti voglio bene, cugina."

# game/Scenes/Adrian/adrian15.rpy:196
translate italian adrian15_04259593:

    # ath "Take care of it, okay? And be careful."
    ath "Prenditene cura, ok? E stai attenta."

# game/Scenes/Adrian/adrian15.rpy:197
translate italian adrian15_62a41927:

    # gg "I will, I promise."
    gg "Lo farò, te lo prometto."

# game/Scenes/Adrian/adrian15.rpy:198
translate italian adrian15_1339b17c:

    # ath "We should probably go downstairs. My ride will be here any minute."
    ath "Probabilmente dovremmo scendere. La mia auto arriverà da un momento all’altro."

# game/Scenes/Adrian/adrian15.rpy:201
translate italian adrian15_1192b455:

    # ath "Be sure to tell your mom what's going on, okay? I was hoping she'd be here so I could say goodbye to her too."
    ath "Assicurati di dire a tua mamma cosa sta succedendo, ok? Speravo che fosse qui, così avrei potuto salutare anche lei."

# game/Scenes/Adrian/adrian15.rpy:202
translate italian adrian15_e8147df6:

    # gg "I will. She's going to be as confused as I am about it, I'm sure."
    gg "Lo farò. Sono sicura che sarà confusa quanto me al riguardo."

# game/Scenes/Adrian/adrian15.rpy:203
translate italian adrian15_43503f58:

    # ath "Yeah, I'm really sorry that I can't tell you more. It's better to know as little as possible for everybody's safety."
    ath "Sì, mi dispiace davvero non poterti dire di più. È meglio sapere il meno possibile, per la sicurezza di tutti."

# game/Scenes/Adrian/adrian15.rpy:206
translate italian adrian15_b0be2693:

    # ath "And I'm sorry that we couldn't meet under better circumstances."
    ath "E mi dispiace che non ci siamo potute incontrare in circostanze migliori."

# game/Scenes/Adrian/adrian15.rpy:207
translate italian adrian15_488c149e:

    # gg "Yeah, usually when Athena and I are together, it's all laughs and playing games and stuff."
    gg "Sì, di solito quando io e Athena siamo insieme, è tutto un ridere, giocare e cose del genere."

# game/Scenes/Adrian/adrian15.rpy:208
translate italian adrian15_3dedfad6:

    # gg "It would have been fun to hang out for a while with all three of us and play some Smash or something."
    gg "Sarebbe stato divertente passare un po’ di tempo tutti e tre insieme e giocare a Smash o qualcosa del genere."

# game/Scenes/Adrian/adrian15.rpy:211
translate italian adrian15_a29880ae:

    # ath "Do you still main Kirby? I'd love to kick that little pink ball's ass sometime."
    ath "Usi ancora Kirby come personaggio principale? Mi piacerebbe prendere a calci nel sedere quella pallina rosa, prima o poi."

# game/Scenes/Adrian/adrian15.rpy:212
translate italian adrian15_c75ca3d4:

    # gg "You wish."
    gg "Ti piacerebbe."

# game/Scenes/Adrian/adrian15.rpy:213
translate italian adrian15_9882e4ae:

    # ath "We might have time to fit in a quick game, if we hurry. It won't take me long to wipe the floor with you."
    ath "Potremmo avere il tempo di infilare una partita veloce, se ci sbrighiamo. Non mi ci vorrà molto a farti a pezzi."

# game/Scenes/Adrian/adrian15.rpy:214
translate italian adrian15_36bb3cc8:

    # gg "Let's go then, bitch!"
    gg "Allora andiamo, stronzo!"

# game/Scenes/Adrian/adrian15.rpy:217
translate italian adrian15_b7c027eb:

    # "Just then, a police car parks in front of the house and a man in a suit steps out, looking grim and official."
    "Proprio in quel momento, una macchina della polizia si ferma davanti a casa e ne scende un uomo in giacca e cravatta, con un'aria severa e ufficiale."

# game/Scenes/Adrian/adrian15.rpy:218
translate italian adrian15_b3e6504f:

    # ath "Rain check, I guess. Time to go."
    ath "Rimandiamo a un'altra volta, immagino. È ora di andare."

# game/Scenes/Adrian/adrian15.rpy:221
translate italian adrian15_d5f4dd84:

    # ath "I love you, cuz. I'll see you again soon."
    ath "Ti voglio bene, cugino. Ci rivedremo presto."

# game/Scenes/Adrian/adrian15.rpy:222
translate italian adrian15_b13e0d25:

    # gg "I love you too."
    gg "Anch'io ti voglio bene."

# game/Scenes/Adrian/adrian15.rpy:223
translate italian adrian15_96dc14b2:

    # gg "I hate this so much. I don't want to let you go."
    gg "Odio tantissimo tutto questo. Non voglio lasciarti andare."

# game/Scenes/Adrian/adrian15.rpy:224
translate italian adrian15_1edb5510:

    # ath "I know. We'll be okay though."
    ath "Lo so. Ma andrà tutto bene."

# game/Scenes/Adrian/adrian15.rpy:225
translate italian adrian15_e2fe510e:

    # ath "And when I see you again, we'll hang out for days, okay?"
    ath "E quando ci rivedremo, staremo insieme per giorni, ok?"

# game/Scenes/Adrian/adrian15.rpy:226
translate italian adrian15_c5cc5eaf:

    # gg "Okay, but if there's anything I can do to help, please call me."
    gg "Ok, ma se c’è qualcosa che posso fare per aiutarti, chiamami, per favore."

# game/Scenes/Adrian/adrian15.rpy:227
translate italian adrian15_20fcca99:

    # ath "I will."
    ath "Lo farò."

# game/Scenes/Adrian/adrian15.rpy:230
translate italian adrian15_170b7c68:

    # ath "And [pcname], it was nice to meet you."
    ath "E [pcname], è stato un piacere conoscerti."

# game/Scenes/Adrian/adrian15.rpy:231
translate italian adrian15_61906ded:

    # pc "Nice to meet you too, Athena."
    pc "Anche per me è stato un piacere, Athena."

# game/Scenes/Adrian/adrian15.rpy:235
translate italian adrian15_84825cda:

    # "Suddenly, she pulls my hand, yanking me closer, then whispers in my ear."
    "All’improvviso, mi tira per la mano, avvicinandomi a sé, poi mi sussurra all’orecchio."

# game/Scenes/Adrian/adrian15.rpy:236
translate italian adrian15_46517656:

    # ath "Be good to her. If you hurt my cousin, I will find you."
    ath "Sii gentile con lei. Se fai del male a mia cugina, ti troverò."

# game/Scenes/Adrian/adrian15.rpy:237
translate italian adrian15_17a1cb32:

    # pc "Uh, I will."
    pc "Ehm, lo farò."

# game/Scenes/Adrian/adrian15.rpy:240
translate italian adrian15_05763882:

    # ath "Bye, Adrian! Love you!"
    ath "Ciao, Adrian! Ti voglio bene!"

# game/Scenes/Adrian/adrian15.rpy:241
translate italian adrian15_11b6245f:

    # gg "Bye! Love you too!"
    gg "Ciao! Ti voglio bene anch’io!"

# game/Scenes/Adrian/adrian15.rpy:242
translate italian adrian15_fd99ecee:

    # ath "Tell your mom I love her too!"
    ath "Di’ a tua mamma che le voglio bene anch’io!"

# game/Scenes/Adrian/adrian15.rpy:243
translate italian adrian15_b909935e:

    # gg "I will!"
    gg "Lo farò!"

# game/Scenes/Adrian/adrian15.rpy:244
translate italian adrian15_124dcc1b:

    # ath "I'll kick your pink Kirby ass real soon!"
    ath "Ti prenderò a calci nel tuo culo rosa da Kirby molto presto!"

# game/Scenes/Adrian/adrian15.rpy:248
translate italian adrian15_4829e0da:

    # "As soon as Athena is in the car and it starts to pull away, Adrian turns towards me, tears in her eyes."
    "Non appena Athena sale in macchina e questa inizia ad allontanarsi, Adrian si gira verso di me, con le lacrime agli occhi."

# game/Scenes/Adrian/adrian15.rpy:249
translate italian adrian15_5928d159:

    # gg "Ugh, this fucking sucks."
    gg "Uffa, che schifo."

# game/Scenes/Adrian/adrian15.rpy:250
translate italian adrian15_72615de3:

    # gg "I'm sorry, [pcname]. I don't much feel like playing games anymore."
    gg "Mi dispiace, [pcname]. Non ho più molta voglia di giocare."

# game/Scenes/Adrian/adrian15.rpy:251
translate italian adrian15_fd83325a:

    # gg "I'll see you later, okay?"
    gg "Ci vediamo più tardi, ok?"

# game/Scenes/Adrian/adrian15.rpy:252
translate italian adrian15_e576c8b5:

    # pc "Are you going to be all right."
    pc "Starai bene?"

# game/Scenes/Adrian/adrian15.rpy:253
translate italian adrian15_0da71ea1:

    # gg "Yeah. I'll have to be."
    gg "Sì. Dovrò starlo."

# game/Scenes/Adrian/adrian15.rpy:254
translate italian adrian15_4004410a:

    # gg "But I need some time alone now."
    gg "Ma ora ho bisogno di stare un po' da sola."

# game/Scenes/Adrian/adrian15.rpy:255
translate italian adrian15_b21f0baf:

    # pc "No problem. Let me know if I can help. See you later, Adrian."
    pc "Nessun problema. Fammi sapere se posso aiutarti. Ci vediamo più tardi, Adrian."

# game/Scenes/Adrian/adrian15.rpy:256
translate italian adrian15_9d092ee2:

    # gg "Thanks, [pcname]. See ya."
    gg "Grazie, [pcname]. Ci vediamo."

# game/Scenes/Adrian/adrian15.rpy:259
translate italian adrian15_25d8780e:

    # "I leave Adrian's house, hoping that she'll be okay."
    "Esco da casa di Adrian, sperando che stia bene."

# game/Scenes/Adrian/adrian15.rpy:267
translate italian adrian15_d9f27044:

    # "As soon as Athena is in the car and it starts to pull away, Adrian turns and collapses into my arms, crying against my shoulder."
    "Non appena Athena sale in macchina e questa inizia ad allontanarsi, Adrian si gira e si riversa tra le mie braccia, piangendo sulla mia spalla."

# game/Scenes/Adrian/adrian15.rpy:268
translate italian adrian15_0e12d7d2:

    # gg "This fucking sucks!!!"
    gg "Che situazione di merda!!!"

# game/Scenes/Adrian/adrian15.rpy:269
translate italian adrian15_182f9ad8:

    # "I rub her back and hold her and let her cry it out."
    "Le accarezzo la schiena, la stringo a me e la lascio sfogarsi."

# game/Scenes/Adrian/adrian15.rpy:272
translate italian adrian15_8bf9515c:

    # "A few minutes later, she sniffs up her tears and looks at me."
    "Qualche minuto dopo, si asciuga le lacrime e mi guarda."

# game/Scenes/Adrian/adrian15.rpy:273
translate italian adrian15_3d955406:

    # gg "Okay, feeling slightly better."
    gg "Ok, mi sento un po’ meglio."

# game/Scenes/Adrian/adrian15.rpy:274
translate italian adrian15_58a70a56:

    # gg "I want to go for a ride. Do you want to come with me?"
    gg "Voglio fare un giro. Vuoi venire con me?"

# game/Scenes/Adrian/adrian15.rpy:275
translate italian adrian15_2b3b24ff:

    # "I think I probably should stay with her, with how upset she is."
    "Penso che probabilmente dovrei restare con lei, visto quanto è sconvolta."

# game/Scenes/Adrian/adrian15.rpy:276
translate italian adrian15_2d17893f:

    # pc "Sure, let's do it, if you're okay to drive?"
    pc "Certo, facciamolo, se te la cavi alla guida?"

# game/Scenes/Adrian/adrian15.rpy:277
translate italian adrian15_28404c62:

    # gg "Yeah, I'm okay."
    gg "Sì, me la cavo."

# game/Scenes/Adrian/adrian15.rpy:280
translate italian adrian15_58afc396:

    # gg "Here, I found her old helmet in the storage under the seat. You should probably wear it."
    gg "Ecco, ho trovato il suo vecchio casco nel vano sotto la sella. Probabilmente dovresti indossarlo."

# game/Scenes/Adrian/adrian15.rpy:281
translate italian adrian15_4fb22de7:

    # pc "Dear lord, this thing is huge."
    pc "Santo cielo, questo coso è enorme."

# game/Scenes/Adrian/adrian15.rpy:282
translate italian adrian15_2409eb5c:

    # gg "That's what she... nevermind, let's just go."
    gg "È quello che lei... non importa, andiamo e basta."

# game/Scenes/Adrian/adrian15.rpy:283
translate italian adrian15_9b4e9f4c:

    # pc "You know how to ride this thing?"
    pc "Sai come si guida questo coso?"

# game/Scenes/Adrian/adrian15.rpy:284
translate italian adrian15_12315e04:

    # gg "Yeah, Athena taught me when I visited her last time. We rode all over the place on it."
    gg "Sì, me l’ha insegnato Athena l’ultima volta che sono andata a trovarla. Abbiamo girato dappertutto con quella."

# game/Scenes/Adrian/adrian15.rpy:285
translate italian adrian15_c4bccc9f:

    # gg "I'm the only person she'd ever let drive it."
    gg "Sono l’unica persona a cui ha mai permesso di guidarla."

# game/Scenes/Adrian/adrian15.rpy:289
translate italian adrian15_65c8468c:

    # "I wrap my arms around her and hold on as she pulls out into the street."
    "La stringo tra le braccia e mi tengo forte mentre lei si immette in strada."

# game/Scenes/Adrian/adrian15.rpy:290
translate italian adrian15_a4cc4d56:

    # pc "Where are we going?"
    pc "Dove stiamo andando?"

# game/Scenes/Adrian/adrian15.rpy:291
translate italian adrian15_33da7917:

    # gg "I just feel like riding for a while. Clear my head, you know."
    gg "Ho solo voglia di guidare per un po’. Per schiarirmi le idee, sai."

# game/Scenes/Adrian/adrian15.rpy:292
translate italian adrian15_61f77a4c:

    # pc "Sure."
    pc "Certo."

# game/Scenes/Adrian/adrian15.rpy:294
translate italian adrian15_df03bfba:

    # "It feels like we're riding forever. We leave town and take a rarely used highway out towards the lake."
    "Sembra che stiamo guidando da un’eternità. Lasciamo la città e prendiamo un’autostrada poco trafficata che porta verso il lago."

# game/Scenes/Adrian/adrian15.rpy:295
translate italian adrian15_ba48df36:

    # "After a while, I'm not even sure where we are anymore. Hopefully Adrian knows. I guess I have GPS on the phone if we get lost."
    "Dopo un po’, non so nemmeno più dove ci troviamo. Spero che Adrian lo sappia. Immagino di avere il GPS sul telefono se dovessimo perderci."

# game/Scenes/Adrian/adrian15.rpy:296
translate italian adrian15_0bac7b03:

    # "But I don't say anything. I just hold on and let Adrian clear her mind of everything."
    "Ma non dico nulla. Mi tengo solo stretta e lascio che Adrian si svuoti la mente da ogni pensiero."

# game/Scenes/Adrian/adrian15.rpy:297
translate italian adrian15_76cd1d73:

    # "She seems calm now, like this is exactly what she needed to get through this."
    "Ora sembra calma, come se questo fosse esattamente ciò di cui aveva bisogno per superare la situazione."

# game/Scenes/Adrian/adrian15.rpy:298
translate italian adrian15_f0b56a2e:

    # "Then, after what must have been at least an hour, she pulls off the highway and drives a little ways up towards the cliffside near the lake."
    "Poi, dopo quella che deve essere stata almeno un’ora, esce dall’autostrada e guida per un po’ verso la scogliera vicino al lago."

# game/Scenes/Adrian/adrian15.rpy:301
translate italian adrian15_135327af:

    # "We sit and I hold her close, trying to provide whatever comfort I can."
    "Ci sediamo e la stringo a me, cercando di darle tutto il conforto possibile."

# game/Scenes/Adrian/adrian15.rpy:302
translate italian adrian15_fa24fdf7:

    # gg "I'm sorry I'm being such a bummer. This was supposed to be a fun day."
    gg "Mi dispiace di essere così deprimente. Doveva essere una giornata divertente."

# game/Scenes/Adrian/adrian15.rpy:303
translate italian adrian15_cfd80ee8:

    # pc "It's okay, Adrian. I'm here for you. Whatever you need."
    pc "Va tutto bene, Adrian. Sono qui per te. Qualunque cosa ti serva."

# game/Scenes/Adrian/adrian15.rpy:304
translate italian adrian15_64ee3ae6:

    # gg "Thanks, [pcname]. I just need a friend really."
    gg "Grazie, [pcname]. In realtà ho solo bisogno di un’amica."

# game/Scenes/Adrian/adrian15.rpy:306
translate italian adrian15_d41d8cd9:

    # voice 'voices/adrian_whenitransitioned.mp3'
    voice 'voices/adrian_whenitransitioned.mp3'

# game/Scenes/Adrian/adrian15.rpy:307
translate italian adrian15_ec81d936:

    # gg "When I transitioned, besides my mom, Athena was the only person who was there for me."
    gg "Quando ho iniziato la transizione, oltre a mia mamma, Athena è stata l’unica persona che mi è stata vicina."

# game/Scenes/Adrian/adrian15.rpy:309
translate italian adrian15_d41d8cd9_1:

    # voice 'voices/adrian_nohesitation.mp3'
    voice 'voices/adrian_nohesitation.mp3'

# game/Scenes/Adrian/adrian15.rpy:310
translate italian adrian15_b76e91f4:

    # gg "No hesitation, no questions, just a ton of support and love."
    gg "Nessuna esitazione, nessuna domanda, solo tantissimo sostegno e amore."

# game/Scenes/Adrian/adrian15.rpy:312
translate italian adrian15_d41d8cd9_2:

    # voice 'voices/adrian_shewastheonly.mp3'
    voice 'voices/adrian_shewastheonly.mp3'

# game/Scenes/Adrian/adrian15.rpy:313
translate italian adrian15_5be20e3b:

    # gg "She was the only friend I had for a long time."
    gg "È stata l’unica amica che ho avuto per molto tempo."

# game/Scenes/Adrian/adrian15.rpy:317
translate italian adrian15_d41d8cd9_3:

    # voice 'voices/adrian_untilyou.mp3'
    voice 'voices/adrian_untilyou.mp3'

# game/Scenes/Adrian/adrian15.rpy:318
translate italian adrian15_b79560a9:

    # gg "Until you."
    gg "Fino a te."

# game/Scenes/Adrian/adrian15.rpy:320
translate italian adrian15_d41d8cd9_4:

    # voice 'voices/adrian_missherlikecrazy.mp3'
    voice 'voices/adrian_missherlikecrazy.mp3'

# game/Scenes/Adrian/adrian15.rpy:321
translate italian adrian15_65372d0d:

    # gg "So, I'm going to miss her like crazy, and I'm going to worry about her until I hear from her again."
    gg "Quindi mi mancherà da morire e mi preoccuperò per lei finché non avrò sue notizie."

# game/Scenes/Adrian/adrian15.rpy:323
translate italian adrian15_d41d8cd9_5:

    # voice 'voices/adrian_butimsoglad.mp3'
    voice 'voices/adrian_butimsoglad.mp3'

# game/Scenes/Adrian/adrian15.rpy:324
translate italian adrian15_4de0338c:

    # gg "But I'm so glad that you're here."
    gg "Ma sono così felice che tu sia qui."

# game/Scenes/Adrian/adrian15.rpy:326
translate italian adrian15_d41d8cd9_6:

    # voice 'voices/adrian_iloveyou1.mp3'
    voice 'voices/adrian_iloveyou1.mp3'

# game/Scenes/Adrian/adrian15.rpy:327
translate italian adrian15_9c8fbba1:

    # gg "I love you, [pcname]."
    gg "Ti amo, [pcname]."

# game/Scenes/Adrian/adrian15.rpy:330
translate italian adrian15_456cffdf:

    # pc "I love you too, Adrian."
    pc "Ti amo anch’io, Adrian."

# game/Scenes/Adrian/adrian15.rpy:333
translate italian adrian15_e9e54f9a:

    # "We sit and watch the sun set, holding each other, enjoying the quiet evening."
    "Ci sediamo a guardare il tramonto, abbracciati, godendoci la quiete della serata."

# game/Scenes/Adrian/adrian15.rpy:334
translate italian adrian15_5a0d166e:

    # "I just want to be whatever she needs now."
    "Voglio solo essere tutto ciò di cui ha bisogno in questo momento."

# game/Scenes/Adrian/adrian15.rpy:335
translate italian adrian15_46b97a11:

    # "I realize how hard I've fallen for her. I'd do anything to make her happy."
    "Mi rendo conto di quanto mi sia innamorato di lei. Farei qualsiasi cosa per renderla felice."

# game/Scenes/Adrian/adrian15.rpy:338
translate italian adrian15_7f8ffd28:

    # "After the sun sets, we drive back to her house."
    "Dopo il tramonto, torniamo in auto a casa sua."

# game/Scenes/Adrian/adrian15.rpy:341
translate italian adrian15_78e6be93:

    # gg "It looks like my mom is home now. I'm going to have to explain everything to her."
    gg "Sembra che mia madre sia tornata a casa. Dovrò spiegarle tutto."

# game/Scenes/Adrian/adrian15.rpy:342
translate italian adrian15_f3610339:

    # gg "This is not going to be fun."
    gg "Non sarà affatto divertente."

# game/Scenes/Adrian/adrian15.rpy:343
translate italian adrian15_20cd9dd9:

    # pc "Want some backup?"
    pc "Vuoi un po’ di sostegno?"

# game/Scenes/Adrian/adrian15.rpy:344
translate italian adrian15_0c91a1a8:

    # gg "No, I think I better do this on my own."
    gg "No, penso sia meglio che me la cavi da solo."

# game/Scenes/Adrian/adrian15.rpy:345
translate italian adrian15_cf913627:

    # gg "Thanks for everything though, [pcname]. You've been amazing."
    gg "Grazie di tutto comunque, [pcname]. Sei stato fantastico."

# game/Scenes/Adrian/adrian15.rpy:346
translate italian adrian15_c46a0b54:

    # pc "Any time."
    pc "Quando vuoi."

# game/Scenes/Adrian/adrian15.rpy:347
translate italian adrian15_ee13ba27:

    # gg "I'll call you soon, okay?"
    gg "Ti chiamo presto, ok?"

# game/Scenes/Adrian/adrian15.rpy:350
translate italian adrian15_1f2a71e7:

    # pc "Okay. Good night, Adrian."
    pc "Ok. Buonanotte, Adrian."

# game/Scenes/Adrian/adrian15.rpy:351
translate italian adrian15_f27d9018:

    # gg "Good night, [pcname]."
    gg "Buonanotte, [pcname]."

# game/Scenes/Adrian/adrian15.rpy:352
translate italian adrian15_80adb898:

    # "I kiss her goodbye."
    "Le do un bacio d'addio."

# game/Scenes/Adrian/adrian15.rpy:355
translate italian adrian15_0cbac92b:

    # "Then I get in my car and drive away, hoping that everything will be okay."
    "Poi salgo in macchina e me ne vado, sperando che tutto vada per il meglio."

# game/Scenes/Adrian/adrian15.rpy:356
translate italian adrian15_339d053a:

    # "And if she needs me, I'll do anything I can to help her."
    "E se avrà bisogno di me, farò tutto il possibile per aiutarla."

translate italian strings:

    # game/Scenes/Adrian/adrian15.rpy:6
    old "After you have checked out a local arcade with Adrian,"
    new "Dopo aver dato un'occhiata a una sala giochi locale con Adrian,"

    # game/Scenes/Adrian/adrian15.rpy:7
    old "she will call and invite you to hang out in the afternoon on the weekend."
    new "lei ti chiamerà per invitarti a uscire nel pomeriggio del fine settimana."

    # game/Scenes/Adrian/adrian15.rpy:28
    old "Oh heck yeah"
    new "Oh, cavolo, sì!"

