# TODO: Translation updated at 2026-08-03 11:17

# game/Scenes/Adrian/Adrian2b.rpy:15
translate italian adrian2b_fe1843ee:

    # "After work, I check the address that Adrian had sent me and put it into the GPS."
    "Dopo il lavoro, controllo l’indirizzo che Adrian mi ha mandato e lo inserisco nel GPS."

# game/Scenes/Adrian/Adrian2b.rpy:16
translate italian adrian2b_220b39e6:

    # "It doesn't take long to get to her house. She actually lives really close to my home."
    "Non ci vuole molto per arrivare a casa sua. In realtà abita proprio vicino a casa mia."

# game/Scenes/Adrian/Adrian2b.rpy:20
translate italian adrian2b_614acdee:

    # "I park on the street, then walk up to the front door and knock. A woman answers almost immediately."
    "Parcheggio in strada, poi mi avvicino alla porta d’ingresso e busso. Una donna mi apre quasi subito."

# game/Scenes/Adrian/Adrian2b.rpy:21
translate italian adrian2b_3dafc9b9:

    # "Woman" "Hello? Can I help you?"
    "Woman" "«Salve? Posso aiutarla?»"

# game/Scenes/Adrian/Adrian2b.rpy:22
translate italian adrian2b_966e8fef:

    # pc "I'm looking for Adrian. Does she live here?"
    pc "«Sto cercando Adrian. Abita qui?»"

# game/Scenes/Adrian/Adrian2b.rpy:23
translate italian adrian2b_b542dd0a:

    # "Woman" "Yes she does."
    "Woman" "«Sì, abita qui.»"

# game/Scenes/Adrian/Adrian2b.rpy:24
translate italian adrian2b_acfd1a5a:

    # pc "She invited me over to play some video games."
    pc "«Mi ha invitato a casa sua per giocare ai videogiochi.»"

# game/Scenes/Adrian/Adrian2b.rpy:25
translate italian adrian2b_172cc6dd:

    # "Woman" "Oh she did? She didn't tell me that anybody was coming."
    "Woman" "«Ah, davvero? Non mi aveva detto che sarebbe venuto qualcuno.»"

# game/Scenes/Adrian/Adrian2b.rpy:26
translate italian adrian2b_2fdb51d6:

    # "Woman" "You just stay there and I'll go get her."
    "Woman" "«Rimani lì, vado a chiamarla.»"

# game/Scenes/Adrian/Adrian2b.rpy:27
translate italian adrian2b_cddf2662:

    # "Then, I hear footsteps coming down the stairs and Adrian calls out."
    "Poi sento dei passi che scendono le scale e Adrian mi chiama."

# game/Scenes/Adrian/Adrian2b.rpy:28
translate italian adrian2b_9899eaa9:

    # gg "He's my friend, Mom, let him in."
    gg "«È un mio amico, mamma, fallo entrare.»"

# game/Scenes/Adrian/Adrian2b.rpy:33
translate italian adrian2b_c583a608:

    # "Woman" "You're supposed to tell me if somebody is coming over, Adrian."
    "Woman" "Dovresti dirmi se viene qualcuno, Adrian."

# game/Scenes/Adrian/Adrian2b.rpy:34
translate italian adrian2b_6c01d4fd:

    # gg "I know, Mom. I meant to, but I was just busy... with schoolwork. I forgot."
    gg "Lo so, mamma. Volevo farlo, ma ero impegnato... con i compiti. Me ne sono dimenticato."

# game/Scenes/Adrian/Adrian2b.rpy:35
translate italian adrian2b_e878210c:

    # "Adrian's Mom" "Okay, well he can stay until 10."
    "Adrian's Mom" "Ok, beh, può restare fino alle 10."

# game/Scenes/Adrian/Adrian2b.rpy:36
translate italian adrian2b_326f12bf:

    # gg "Okay, Mom. Thank you."
    gg "Ok, mamma. Grazie."

# game/Scenes/Adrian/Adrian2b.rpy:39
translate italian adrian2b_8f7ebec7:

    # "I follow her inside the house and we walk up the stairs."
    "La seguo in casa e saliamo le scale."

# game/Scenes/Adrian/Adrian2b.rpy:44
translate italian adrian2b_d41d8cd9:

    # voice 'voices/adrian_sorry.mp3'
    voice 'voices/adrian_sorry.mp3'

# game/Scenes/Adrian/Adrian2b.rpy:45
translate italian adrian2b_c03425eb:

    # gg "I'm sorry about that. She can be a bit overbearing sometimes."
    gg "Mi dispiace per l’altra volta. A volte può essere un po’ prepotente."

# game/Scenes/Adrian/Adrian2b.rpy:46
translate italian adrian2b_3ed1d973:

    # gg "She's just very protective of me. Only child and all."
    gg "È solo molto protettiva nei miei confronti. Sono figlio unico e tutto il resto."

# game/Scenes/Adrian/Adrian2b.rpy:49
translate italian adrian2b_04c7f126:

    # pc "My dad could be the same way sometimes when I was growing up. I'm an only child too."
    pc "Anche mio padre a volte si comportava così quando ero piccolo. Anch’io sono figlio unico."

# game/Scenes/Adrian/Adrian2b.rpy:50
translate italian adrian2b_f7e6c62b:

    # gg "Then you understand."
    gg "Allora capisci."

# game/Scenes/Adrian/Adrian2b.rpy:52
translate italian adrian2b_636661b2:

    # gg "It does sometimes."
    gg "A volte è così."

# game/Scenes/Adrian/Adrian2b.rpy:53
translate italian adrian2b_2900eca8:

    # gg "But I love her and she's been really good to me through a lot of hard times."
    gg "Ma le voglio bene ed è stata davvero brava con me in tanti momenti difficili."

# game/Scenes/Adrian/Adrian2b.rpy:54
translate italian adrian2b_c07d0332:

    # pc "That's good. Always good to have people there for you."
    pc "Meno male. È sempre bello avere persone che ti stanno vicino."

# game/Scenes/Adrian/Adrian2b.rpy:55
translate italian adrian2b_a560b57e:

    # gg "Want to check out the game?"
    gg "Vuoi dare un'occhiata al gioco?"

# game/Scenes/Adrian/Adrian2b.rpy:56
translate italian adrian2b_39757b54:

    # pc "Yeah, let's do it."
    pc "Sì, facciamolo."

# game/Scenes/Adrian/Adrian2b.rpy:59
translate italian adrian2b_5c242d3c:

    # gg "Okay, so this is my character. Her name is Trenoxa and she's a mage."
    gg "Ok, questo è il mio personaggio. Si chiama Trenoxa ed è una maga."

# game/Scenes/Adrian/Adrian2b.rpy:60
translate italian adrian2b_290fa501:

    # pc "She looks badass."
    pc "Sembra una tosta."

# game/Scenes/Adrian/Adrian2b.rpy:61
translate italian adrian2b_eecdf621:

    # gg "Oh she definitely is. Watch me kill all these kobolds."
    gg "Oh, lo è sicuramente. Guardami mentre uccido tutti questi coboldi."

# game/Scenes/Adrian/Adrian2b.rpy:66
translate italian adrian2b_8a0ec2b0:

    # "Using the keyboard and mouse, she guides her character into the middle of a group of small monsters and proceeds to blow them all up."
    "Usando la tastiera e il mouse, guida il suo personaggio in mezzo a un gruppo di piccoli mostri e procede a farli saltare tutti in aria."

# game/Scenes/Adrian/Adrian2b.rpy:68
translate italian adrian2b_c9d9899a:

    # "I barely look at the screen, unable to take my eyes off of her."
    "Guardo a malapena lo schermo, incapace di distogliere lo sguardo da lei."

# game/Scenes/Adrian/Adrian2b.rpy:69
translate italian adrian2b_c68ec5f4:

    # "She really gets into this stuff, and it's cute to see her so excited about it."
    "Si appassiona davvero a queste cose, ed è carino vederla così entusiasta."

# game/Scenes/Adrian/Adrian2b.rpy:72
translate italian adrian2b_f57aeacc:

    # gg "Do you want to give it a try?"
    gg "Vuoi provarci anche tu?"

# game/Scenes/Adrian/Adrian2b.rpy:73
translate italian adrian2b_e3e97310:

    # pc "What if I get your character killed?"
    pc "E se facessi morire il tuo personaggio?"

# game/Scenes/Adrian/Adrian2b.rpy:74
translate italian adrian2b_03db2857:

    # gg "It's no big deal. You just revive at the nearest respawn point and are weakened for a few minutes."
    gg "Non è un problema. Ti rianimi semplicemente al punto di respawn più vicino e rimani indebolito per qualche minuto."

# game/Scenes/Adrian/Adrian2b.rpy:75
translate italian adrian2b_9a5eb084:

    # gg "Come on, give it a try, see if you like it."
    gg "Dai, provaci, vedi se ti piace."

# game/Scenes/Adrian/Adrian2b.rpy:76
translate italian adrian2b_63023601:

    # pc "Okay."
    pc "Ok."

# game/Scenes/Adrian/Adrian2b.rpy:79
translate italian adrian2b_2d53ff69:

    # "We switch seats and I play for a bit, trying to learn all the buttons."
    "Ci scambiamo i posti e gioco un po' io, cercando di imparare tutti i comandi."

# game/Scenes/Adrian/Adrian2b.rpy:80
translate italian adrian2b_b0a6ba6f:

    # gg "Okay, all of your powers are the number keys up top. You move with WASD and look around with the mouse."
    gg "Ok, tutti i tuoi poteri sono sui tasti numerici in alto. Ti muovi con WASD e ti guardi intorno con il mouse."

# game/Scenes/Adrian/Adrian2b.rpy:81
translate italian adrian2b_3b25da4f:

    # gg "Just click on what you want to kill and then use one of your powers to kill it."
    gg "Basta cliccare su quello che vuoi uccidere e poi usare uno dei tuoi poteri per eliminarlo."

# game/Scenes/Adrian/Adrian2b.rpy:82
translate italian adrian2b_b4a8a49d:

    # gg "Super easy. Barely an inconvenience."
    gg "Facilissimo. Non è quasi un inconveniente."

# game/Scenes/Adrian/Adrian2b.rpy:83
translate italian adrian2b_babb66b4:

    # pc "You say that, but I'm still wondering what a WASD is."
    pc "Lo dici tu, ma mi chiedo ancora cosa sia un WASD."

# game/Scenes/Adrian/Adrian2b.rpy:86
translate italian adrian2b_055f2992:

    # "A little bit later, I have pretty much figured out the controls and am demolishing enemies."
    "Poco dopo, ho praticamente capito i comandi e sto facendo a pezzi i nemici."

# game/Scenes/Adrian/Adrian2b.rpy:87
translate italian adrian2b_4915d075:

    # gg "You like it?"
    gg "Ti piace?"

# game/Scenes/Adrian/Adrian2b.rpy:88
translate italian adrian2b_3b7f3448:

    # pc "I have to admit, it's pretty fun."
    pc "Devo ammetterlo, è piuttosto divertente."

# game/Scenes/Adrian/Adrian2b.rpy:89
translate italian adrian2b_a82592f5:

    # gg "I'm glad. If you bought a copy sometime, we could even play together."
    gg "Ne sono felice. Se un giorno ne comprassi una copia, potremmo anche giocare insieme."

# game/Scenes/Adrian/Adrian2b.rpy:90
translate italian adrian2b_c0437e5d:

    # pc "That would be fun."
    pc "Sarebbe divertente."

# game/Scenes/Adrian/Adrian2b.rpy:93
translate italian adrian2b_ee920117:

    # gg "I think so too. I'd love to explore and kill goblins with you."
    gg "Lo penso anch’io. Mi piacerebbe esplorare e uccidere i goblin con te."

# game/Scenes/Adrian/Adrian2b.rpy:94
translate italian adrian2b_efa756f8:

    # pc "Maybe I'll get it sometime then."
    pc "Allora forse un giorno lo comprerò."

# game/Scenes/Adrian/Adrian2b.rpy:95
translate italian adrian2b_ce14f6da:

    # gg "Good."
    gg "Bene."

# game/Scenes/Adrian/Adrian2b.rpy:96
translate italian adrian2b_6a346fe1:

    # gg "It's about time for you to go. I wouldn't mind hanging out longer, but it's nearly 10 and my mom will be mad."
    gg "È ora che tu vada. Non mi dispiacerebbe restare ancora un po', ma sono quasi le 10 e mia mamma si arrabbierà."

# game/Scenes/Adrian/Adrian2b.rpy:97
translate italian adrian2b_8f70c6ec:

    # pc "Okay, I'll go then. Don't want to get you in trouble."
    pc "Ok, allora me ne vado. Non voglio metterti nei guai."

# game/Scenes/Adrian/Adrian2b.rpy:98
translate italian adrian2b_45175d50:

    # gg "I had a good time though. Thank you for coming over."
    gg "Mi sono divertita comunque. Grazie per essere venuta."

# game/Scenes/Adrian/Adrian2b.rpy:99
translate italian adrian2b_1b5489ad:

    # pc "Thanks for inviting me, I had fun too."
    pc "Grazie per avermi invitata, mi sono divertita anch'io."

# game/Scenes/Adrian/Adrian2b.rpy:103
translate italian adrian2b_6a658ffa:

    # "She walks me down to the front door."
    "Mi accompagna fino alla porta d'ingresso."

# game/Scenes/Adrian/Adrian2b.rpy:104
translate italian adrian2b_2c7e0e7e:

    # gg "I could probably get you a copy of the game. If I did, would you play with me?"
    gg "Potrei procurarti una copia del gioco. Se lo facessi, giocheresti con me?"

# game/Scenes/Adrian/Adrian2b.rpy:105
translate italian adrian2b_7f0c6c37:

    # pc "Yeah, I think I could do that."
    pc "Sì, penso di poterlo fare."

# game/Scenes/Adrian/Adrian2b.rpy:107
translate italian adrian2b_d41d8cd9_1:

    # voice 'voices/adrian_seeyou.mp3'
    voice 'voices/adrian_seeyou.mp3'

# game/Scenes/Adrian/Adrian2b.rpy:108
translate italian adrian2b_c8b2cdfc:

    # gg "Okay cool. I'll see you in class, [pcname]."
    gg "Ok, fantastico. Ci vediamo a lezione, [pcname]."

# game/Scenes/Adrian/Adrian2b.rpy:109
translate italian adrian2b_9bfc226b:

    # pc "Alright. Bye, Adrian."
    pc "Va bene. Ciao, Adrian."

