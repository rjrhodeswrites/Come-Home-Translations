# TODO: Translation updated at 2026-08-03 11:17

# game/Scenes/Adrian/adrian11.rpy:14
translate italian adrian11_e6b6169b:

    # "Adrian and I have a little time to talk before class."
    "Adrian e io abbiamo un po’ di tempo per parlare prima della lezione."

# game/Scenes/Adrian/adrian11.rpy:15
translate italian adrian11_584cd980:

    # pc "Haven't seen you in Souls of War as much lately. Everything okay?"
    pc "Ultimamente non ti ho visto molto su Souls of War. Va tutto bene?"

# game/Scenes/Adrian/adrian11.rpy:16
translate italian adrian11_c8aa5afa:

    # gg "Oh! Yeah, everything is great actually."
    gg "Oh! Sì, in realtà va tutto alla grande."

# game/Scenes/Adrian/adrian11.rpy:17
translate italian adrian11_93e26893:

    # gg "I've been kind of busy with this arcade idea though."
    gg "Sono stato un po’ impegnato con questa idea della sala giochi, però."

# game/Scenes/Adrian/adrian11.rpy:18
translate italian adrian11_37a88e09:

    # gg "I talked to Gertrude, one of the school counselors, you know?"
    gg "Ho parlato con Gertrude, una delle consulenti scolastiche, sai?"

# game/Scenes/Adrian/adrian11.rpy:20
translate italian adrian11_25ef1d29:

    # pc "Oh, yeah. I know her."
    pc "Oh, sì. La conosco."

# game/Scenes/Adrian/adrian11.rpy:21
translate italian adrian11_e7b7b41e:

    # gg "She helped me change up all my classes for next semester. It's all set up now."
    gg "Mi ha aiutato a cambiare tutti i miei corsi per il prossimo semestre. Ora è tutto a posto."

# game/Scenes/Adrian/adrian11.rpy:22
translate italian adrian11_f428f0b6:

    # pc "Oh, cool!"
    pc "Oh, fantastico!"

# game/Scenes/Adrian/adrian11.rpy:23
translate italian adrian11_f224267b:

    # gg "And in my spare time at home I've been doing a lot of research."
    gg "E nel tempo libero a casa ho fatto un sacco di ricerche."

# game/Scenes/Adrian/adrian11.rpy:24
translate italian adrian11_b9375b6a:

    # gg "I even wrote up a formal business plan. Want to see?"
    gg "Ho persino redatto un business plan formale. Vuoi vederlo?"

# game/Scenes/Adrian/adrian11.rpy:25
translate italian adrian11_61f77a4c:

    # pc "Sure."
    pc "Certo."

# game/Scenes/Adrian/adrian11.rpy:28
translate italian adrian11_8dfefed2:

    # "She puts a folder with typed papers in front of me, and I flip through it."
    "Mi mette davanti una cartellina con dei fogli dattiloscritti e io la sfoglio."

# game/Scenes/Adrian/adrian11.rpy:29
translate italian adrian11_37adcdf0:

    # "There's so much information here, so much detail. She knows far more about this stuff than I do, obviously. I'm not even sure where to begin."
    "Ci sono tantissime informazioni qui, tantissimi dettagli. Ovviamente lei ne sa molto più di me su queste cose. Non so nemmeno da dove cominciare."

# game/Scenes/Adrian/adrian11.rpy:30
translate italian adrian11_6d5e4bce:

    # gg "How does it look?"
    gg "Che ne pensi?"

# game/Scenes/Adrian/adrian11.rpy:31
translate italian adrian11_08f3eb16:

    # pc "I mean, I'm no expert here, but it looks great to me."
    pc "Insomma, non sono un esperto, ma a me sembra fantastico."

# game/Scenes/Adrian/adrian11.rpy:32
translate italian adrian11_f9c7e107:

    # gg "The goal is to get people to invest so that I can get some startup money."
    gg "L’obiettivo è convincere le persone a investire, così da poter ottenere un po’ di capitale iniziale."

# game/Scenes/Adrian/adrian11.rpy:33
translate italian adrian11_10293973:

    # pc "If I had the money, I'd invest for sure."
    pc "Se avessi i soldi, investirei di sicuro."

# game/Scenes/Adrian/adrian11.rpy:36
translate italian adrian11_c4fb707b:

    # gg "Awesome! That makes me super happy."
    gg "Fantastico! Questo mi rende davvero felice."

# game/Scenes/Adrian/adrian11.rpy:37
translate italian adrian11_0c2c19e9:

    # gg "I'm actually feeling like, really good about myself right now."
    gg "In realtà mi sento davvero bene con me stessa in questo momento."

# game/Scenes/Adrian/adrian11.rpy:38
translate italian adrian11_1c658d00:

    # gg "Better than I've ever felt, maybe."
    gg "Meglio di quanto mi sia mai sentita, forse."

# game/Scenes/Adrian/adrian11.rpy:41
translate italian adrian11_75dceae8:

    # gg "I feel like I'm accepted for who I am."
    gg "Mi sento accettata per quella che sono."

# game/Scenes/Adrian/adrian11.rpy:43
translate italian adrian11_ae80f6d3:

    # gg "I have a pretty cool boyfriend."
    gg "Ho un ragazzo davvero fantastico."

# game/Scenes/Adrian/adrian11.rpy:44
translate italian adrian11_cfc70d4a:

    # gg "And I feel like my life is heading in the right direction, for once."
    gg "E mi sembra che la mia vita stia andando nella direzione giusta, per una volta."

# game/Scenes/Adrian/adrian11.rpy:45
translate italian adrian11_07e7c552:

    # pc "I'm really happy for you."
    pc "Sono davvero felice per te."

# game/Scenes/Adrian/adrian11.rpy:49
translate italian adrian11_c7d52788:

    # gg "Thanks, [pcname]. I'm glad you're behind me."
    gg "Grazie, [pcname]. Sono contenta che tu mi sostenga."

# game/Scenes/Adrian/adrian11.rpy:50
translate italian adrian11_c46a0b54:

    # pc "Any time."
    pc "Quando vuoi."

# game/Scenes/Adrian/adrian11.rpy:53
translate italian adrian11_380ece13:

    # "She looks away, blushing a bit."
    "Lei distoglie lo sguardo, arrossendo un po'."

# game/Scenes/Adrian/adrian11.rpy:54
translate italian adrian11_91c10599:

    # "Then Ms. Welch starts her lecture and we have to focus on school work."
    "Poi la signora Welch inizia la lezione e dobbiamo concentrarci sui compiti."

# game/Scenes/Adrian/adrian11.rpy:57
translate italian adrian11_b3da124f:

    # "The rest of the school day passes by pretty quick, then it's time for work."
    "Il resto della giornata scolastica passa piuttosto in fretta, poi è ora di andare al lavoro."

translate italian strings:

    # game/Scenes/Adrian/adrian11.rpy:2
    old "After Adrian talks with you about her plans for the future,"
    new "Dopo che Adrian ti ha parlato dei suoi progetti per il futuro,"

    # game/Scenes/Adrian/adrian11.rpy:3
    old "This scene will happen sometimes before Ms. Welch's class."
    new "Questa scena si svolgerà qualche volta prima della lezione della signora Welch."

