# game/Scenes/Micha/MichaDates/michamovietheaterdate.rpy:24
translate italian michamovietheaterstartdate_929c1af5:

    # "I head over to the movie theater to meet Mi-Cha."
    "Mi dirigo al cinema per incontrare Mi-Cha."

# game/Scenes/Micha/MichaDates/michamovietheaterdate.rpy:27
translate italian michamovietheaterstartdate_53aa213e:

    # "I meet Mi-Cha in the movie theater parking lot."
    "Incontro Mi-Cha nel parcheggio del cinema."

# game/Scenes/Micha/MichaDates/michamovietheaterdate.rpy:29
translate italian michamovietheaterstartdate_1696084c:

    # pc "You look very cute."
    pc "Sei davvero carina."

# game/Scenes/Micha/MichaDates/michamovietheaterdate.rpy:32
translate italian michamovietheaterstartdate_d41d8cd9:

    # voice 'voices/micha_thankyou1.mp3'
    voice 'voices/micha_thankyou1.mp3'

# game/Scenes/Micha/MichaDates/michamovietheaterdate.rpy:33
translate italian michamovietheaterstartdate_bb0eeaf4:

    # mc "Thank you."
    mc "Grazie."

# game/Scenes/Micha/MichaDates/michamovietheaterdate.rpy:34
translate italian michamovietheaterstartdate_17670cf3:

    # mc "You look nice also."
    mc "Anche tu stai bene."

# game/Scenes/Micha/MichaDates/michamovietheaterdate.rpy:37
translate italian michamovietheaterstartdate_88edd4ad:

    # "Then we go inside and sit in the back."
    "Poi entriamo e ci sediamo in fondo."

# game/Scenes/Micha/MichaDates/michamovietheaterdate.rpy:39
translate italian michamovietheaterstartdate_90b2b501:

    # "She's so quiet. I should try to start up a conversation."
    "È così silenziosa. Dovrei provare a fare conversazione."

# game/Scenes/Micha/MichaDates/michamovietheaterdate.rpy:44
translate italian michamovietheaterstartdate_56f38f5f:

    # "The movie starts and we go quiet."
    "Il film inizia e restiamo in silenzio."

# game/Scenes/Micha/MichaDates/michamovietheaterdate.rpy:45
translate italian michamovietheaterstartdate_0a855fcc:

    # "Throughout the movie, it feels like she starts to relax some."
    "Durante il film, mi sembra che inizi a rilassarsi un po’."

# game/Scenes/Micha/MichaDates/michamovietheaterdate.rpy:47
translate italian michamovietheaterstartdate_914a9aa2:

    # "It's a fun movie and she's nice company, if a little quiet."
    "È un film divertente e lei è di buona compagnia, anche se un po’ silenziosa."

# game/Scenes/Micha/MichaDates/michamovietheaterdate.rpy:49
translate italian michamovietheaterstartdate_0edfdae0:

    # "When it ends, she turns to me."
    "Quando finisce, si gira verso di me."

# game/Scenes/Micha/MichaDates/michamovietheaterdate.rpy:51
translate italian michamovietheaterstartdate_bab5119d:

    # mc "Did you like the movie?"
    mc "Ti è piaciuto il film?"

# game/Scenes/Micha/MichaDates/michamovietheaterdate.rpy:52
translate italian michamovietheaterstartdate_f4477343:

    # pc "Yeah I enjoyed it."
    pc "Sì, mi è piaciuto."

# game/Scenes/Micha/MichaDates/michamovietheaterdate.rpy:53
translate italian michamovietheaterstartdate_e4993620:

    # mc "Me too. I thought it was very good."
    mc "Anche a me. L’ho trovato davvero bello."

# game/Scenes/Micha/MichaDates/michamovietheaterdate.rpy:54
translate italian michamovietheaterstartdate_365db8f9:

    # "We hang out during the credits and chat a little bit more."
    "Restiamo lì durante i titoli di coda e chiacchieriamo ancora un po’."

# game/Scenes/Micha/MichaDates/michamovietheaterdate.rpy:59
translate italian michamovietheaterstartdate_63e18d0b:

    # "When the credits end, we go outside to the parking lot and stand near her car."
    "Quando finiscono i titoli di coda, usciamo nel parcheggio e ci fermiamo vicino alla sua auto."

# game/Scenes/Micha/MichaDates/michamovietheaterdate.rpy:60
translate italian michamovietheaterstartdate_725fffe9:

    # mc "I had a very good time. Thank you for taking me."
    mc "Mi sono divertita tantissimo. Grazie per avermi portato."

# game/Scenes/Micha/MichaDates/michamovietheaterdate.rpy:61
translate italian michamovietheaterstartdate_07c9c5ab:

    # pc "You're welcome."
    pc "Prego."

# game/Scenes/Micha/MichaDates/michamovietheaterdate.rpy:65
translate italian michamovietheaterstartdate_5f014a7b:

    # "She rushes up to me, leans up and gives me a tiny peck of a kiss on the mouth, our lips barely touching."
    "Si avvicina di corsa a me, si sporge in avanti e mi dà un bacio piccolissimo sulla bocca, le nostre labbra si sfiorano appena."

# game/Scenes/Micha/MichaDates/michamovietheaterdate.rpy:67
translate italian michamovietheaterstartdate_5ac477c2:

    # "Then she pulls back once again."
    "Poi si allontana di nuovo."

# game/Scenes/Micha/MichaDates/michamovietheaterdate.rpy:68
translate italian michamovietheaterstartdate_50afc9a0:

    # mc "Okay goodbye, [pcname]."
    mc "Ok, ciao, [pcname]."

# game/Scenes/Micha/MichaDates/michamovietheaterdate.rpy:70
translate italian michamovietheaterstartdate_0488daa1:

    # "And before I can say anything in response, she rushes to her car, starts it up, and drives away."
    "E prima che io possa dire qualcosa in risposta, lei corre alla sua auto, la mette in moto e se ne va."

# game/Scenes/Micha/MichaDates/michamovietheaterdate.rpy:72
translate italian michamovietheaterstartdate_6cbf222e:

    # "Well, I guess we're making some progress at least?"
    "Beh, immagino che almeno stiamo facendo qualche progresso?"

# game/Scenes/Micha/MichaDates/michamovietheaterdate.rpy:78
translate italian michamovietheaterstartdate_2674be8c:

    # mc "Would you mind taking me back to my dorm?"
    mc "Ti dispiacerebbe riaccompagnarmi al mio dormitorio?"

# game/Scenes/Micha/MichaDates/michamovietheaterdate.rpy:79
translate italian michamovietheaterstartdate_a274c9a4:

    # pc "Of course not."
    pc "Certo che no."

