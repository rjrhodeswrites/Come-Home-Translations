# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:113
translate italian michaarcadestartdate_1df83f78:

    # "We dance for a while, working up a sweat."
    "Balliamo per un po', sudando un po'."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:114
translate italian michaarcadestartdate_93d87356:

    # "I can barely take my eyes off her."
    "Riesco a malapena a staccarle gli occhi di dosso."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:119
translate italian michaarcadestartdate_17d62fc5:

    # "After a few songs, we take a break, catch our breath and chat for a while."
    "Dopo qualche canzone, ci prendiamo una pausa, riprendiamo fiato e chiacchieriamo un po’."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:127
translate italian michaarcadestartdate_e717916b:

    # mc "Want to dance a little more?"
    mc "Ti va di ballare ancora un po’?"

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:128
translate italian michaarcadestartdate_61f77a4c:

    # pc "Sure."
    pc "Certo."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:134
translate italian michaarcadestartdate_cba53581:

    # "We dance for a while longer, until I'm so tired, I can barely move."
    "Balliamo ancora per un po’, finché non sono così stanco che riesco a malapena a muovermi."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:135
translate italian michaarcadestartdate_66adc21b:

    # "But it's worth it to see her having so much fun."
    "Ma ne vale la pena per vederla divertirsi così tanto."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:143
translate italian michaarcadestartdate_6c3d27ae:

    # "After a while, we leave together and I drive her back to the dorms."
    "Dopo un po’, ce ne andiamo insieme e la riaccompagno in auto al dormitorio."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:144
translate italian michaarcadestartdate_fdab3f40:

    # mc "Would you come inside and spend some time with me?"
    mc "Ti andrebbe di entrare e passare un po’ di tempo con me?"

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:149
translate italian michaarcadestartdate_bc4fd44d:

    # mc "Oh, okay."
    mc "Oh, va bene."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:150
translate italian michaarcadestartdate_c5fbc007:

    # mc "Thank you for taking me out. I had a very nice time."
    mc "Grazie per avermi portato fuori. Mi sono divertita molto."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:151
translate italian michaarcadestartdate_5794bc3e:

    # pc "You're welcome. I'll see you later, Mi-Cha."
