translate italian michap2_d0e76a7c:

    # mc "SKY."
    mc "SKY."

# game/Scenes/Micha/MichaConversations/michap2.rpy:24
translate italian michap2_002489ae:

    # mc "That's what we call the three big universities in Korea."
    mc "È così che chiamiamo le tre grandi università in Corea."

# game/Scenes/Micha/MichaConversations/michap2.rpy:25
translate italian michap2_8360ab7c:

