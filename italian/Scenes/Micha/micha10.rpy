# TODO: Translation updated at 2026-08-03 11:17

# game/Scenes/Micha/micha10.rpy:15
translate italian micha10_53d7eff6:

    # "She gets in my car and we drive back towards the school and park near the dorms."
    "Sale in macchina e torniamo verso la scuola, parcheggiando vicino ai dormitori."

# game/Scenes/Micha/micha10.rpy:18
translate italian micha10_0ba0ce57:

    # mc "Would you walk to my dorm with me?"
    mc "Ti andrebbe di accompagnarmi a piedi fino al mio dormitorio?"

# game/Scenes/Micha/micha10.rpy:19
translate italian micha10_61f77a4c:

    # pc "Sure."
    pc "Certo."

# game/Scenes/Micha/micha10.rpy:26
translate italian micha10_fc5b71e7:

    # "We walk through the school courtyard, towards her dorm building."
    "Attraversiamo il cortile della scuola, diretti verso il suo dormitorio."

# game/Scenes/Micha/micha10.rpy:27
translate italian micha10_9c8bddba:

    # "The night air is cool, and the school is surprisingly peaceful and quiet."
    "L’aria notturna è fresca e la scuola è sorprendentemente tranquilla e silenziosa."

# game/Scenes/Micha/micha10.rpy:34
translate italian micha10_8f3659cb:

    # "She glances over at me and then slides her hand into mine."
    "Mi lancia un’occhiata e poi infila la mano nella mia."

# game/Scenes/Micha/micha10.rpy:35
translate italian micha10_b17081d9:

    # "Her hand is cold and small and soft. I hold it gently as we continue walking."
    "La sua mano è fredda, piccola e morbida. La stringo delicatamente mentre continuiamo a camminare."

# game/Scenes/Micha/micha10.rpy:42
translate italian micha10_9207436c:

    # mc "Would you maybe want to sit and chat for a while before I go inside?"
    mc "Ti andrebbe magari di sederti a chiacchierare un po’ prima che io entri?"

# game/Scenes/Micha/micha10.rpy:43
translate italian micha10_8fefe090:

    # mc "I had such a good time with you today. I am not quite ready for it to end."
    mc "Mi sono divertito tantissimo con te oggi. Non sono ancora pronto perché finisca."

# game/Scenes/Micha/micha10.rpy:44
translate italian micha10_4476e592:

    # pc "Sure, we can do that."
    pc "Certo, possiamo farlo."

# game/Scenes/Micha/micha10.rpy:51
translate italian micha10_d96ba613:

    # "We sit on the bench together, her hand still enveloped in mine."
    "Ci sediamo insieme sulla panchina, con la sua mano ancora avvolta nella mia."

# game/Scenes/Micha/micha10.rpy:52
translate italian micha10_5e2207f4:

    # "I wonder what she would want to talk about? She barely talks about anything at all."
    "Mi chiedo di cosa vorrebbe parlare? Non parla quasi mai di nulla."

# game/Scenes/Micha/micha10.rpy:59
translate italian micha10_5ec89b3b:

    # mc "I like it here."
    mc "Mi piace stare qui."

# game/Scenes/Micha/micha10.rpy:60
translate italian micha10_00ff76ff:

    # pc "Yeah, the fresh air feels really nice. And the trees are pretty."
    pc "Sì, l’aria fresca è davvero piacevole. E gli alberi sono belli."

# game/Scenes/Micha/micha10.rpy:61
translate italian micha10_277d368d:

    # mc "No. I meant I like it here... in America."
    mc "No. Volevo dire che mi piace stare qui... in America."

# game/Scenes/Micha/micha10.rpy:62
translate italian micha10_193e6392:

    # mc "I wish that I could stay."
    mc "Vorrei poter restare."

# game/Scenes/Micha/micha10.rpy:69
translate italian micha10_4354fa16:

    # pc "What do you mean? You have to go back to Korea?"
    pc "Cosa intendi? Devi tornare in Corea?"

# game/Scenes/Micha/micha10.rpy:71
translate italian micha10_d41d8cd9:

    # voice 'voices/micha_yes2.mp3'
    voice 'voices/micha_yes2.mp3'

# game/Scenes/Micha/micha10.rpy:72
translate italian micha10_b63541c5:

    # mc "Yes. I have to return and become married after I finish this semester."
    mc "Sì. Devo tornare e sposarmi dopo aver finito questo semestre."

# game/Scenes/Micha/micha10.rpy:73
translate italian micha10_1ae5f5f0:

    # pc "What? Why?"
    pc "Cosa? Perché?"

# game/Scenes/Micha/micha10.rpy:74
translate italian micha10_97c2ea57:

    # mc "My parents have arranged it. They have chosen a man. I will become his wife when I return."
    mc "L’hanno deciso i miei genitori. Hanno scelto un uomo. Diventerò sua moglie quando tornerò."

# game/Scenes/Micha/micha10.rpy:75
translate italian micha10_29f911d6:

    # pc "Is that what you want? Do you even like him?"
    pc "È quello che vuoi? Ma almeno ti piace?"

# game/Scenes/Micha/micha10.rpy:76
translate italian micha10_e1f07ca9:

    # mc "I have never met him. I am sure that he is nice though. My parents chose him."
    mc "Non l'ho mai incontrato. Sono sicura che sia un bravo ragazzo, però. L'hanno scelto i miei genitori."

# game/Scenes/Micha/micha10.rpy:77
translate italian micha10_51e20623:

    # pc "You want that though?"
    pc "Ma è quello che vuoi?"

# game/Scenes/Micha/micha10.rpy:78
translate italian micha10_4989970d:

    # mc "I want to be a wife, yes. But I do like it here."
    mc "Voglio diventare una moglie, sì. Ma mi piace stare qui."

# game/Scenes/Micha/micha10.rpy:79
translate italian micha10_22cefe33:

    # pc "Why don't you just stay then? Why don't you tell your parents no, and stay here?"
    pc "Allora perché non resti qui e basta? Perché non dici di no ai tuoi genitori e resti qui?"

# game/Scenes/Micha/micha10.rpy:86
translate italian micha10_d64f1fa7:

    # mc "It does not work that way."
    mc "Non funziona così."

# game/Scenes/Micha/micha10.rpy:89
translate italian micha10_14baa1d2:

    # mc "I really like you too, [pcname]."
    mc "Anche tu mi piaci davvero tanto, [pcname]."

# game/Scenes/Micha/micha10.rpy:91
translate italian micha10_24676458:

    # mc "Yes, I guess so."
    mc "Sì, credo di sì."

# game/Scenes/Micha/micha10.rpy:98
translate italian micha10_52765170:

    # "We grow silent again, looking up at the stars."
    "Torniamo in silenzio, guardando le stelle."

# game/Scenes/Micha/micha10.rpy:99
translate italian micha10_9e978195:

    # "She has to go back to Korea after this semester. I doubt I would see her again."
    "Dopo questo semestre dovrà tornare in Corea. Dubito che la rivedrò mai più."

# game/Scenes/Micha/micha10.rpy:100
translate italian micha10_494d2b9e:

    # "I can't help but feel really sad about that."
    "Non posso fare a meno di sentirmi davvero triste per questo."

# game/Scenes/Micha/micha10.rpy:107
translate italian micha10_06878b88:

    # "As we're watching the sky, a shooting star flies past. She gasps."
    "Mentre guardiamo il cielo, una stella cadente sfreccia davanti a noi. Lei trattiene il respiro."

# game/Scenes/Micha/micha10.rpy:108
translate italian micha10_05fba3d4:

    # mc "Oh! It's so beautiful."
    mc "Oh! È così bella."

# game/Scenes/Micha/micha10.rpy:109
translate italian micha10_013ea0ef:

    # pc "You should make a wish."
    pc "Dovresti esprimere un desiderio."

# game/Scenes/Micha/micha10.rpy:110
translate italian micha10_9d8e700d:

    # mc "A wish?"
    mc "Un desiderio?"

# game/Scenes/Micha/micha10.rpy:111
translate italian micha10_10994647:

    # pc "Yeah, when you see a shooting star, you make a wish and it might come true."
    pc "Sì, quando vedi una stella cadente, esprimi un desiderio e potrebbe avverarsi."

# game/Scenes/Micha/micha10.rpy:118
translate italian micha10_74c726d2:

    # "She looks at me and speaks in a low, shy voice."
    "Mi guarda e parla con voce bassa e timida."

# game/Scenes/Micha/micha10.rpy:120
translate italian micha10_d41d8cd9_1:

    # voice 'voices/micha_10_1.mp3'
    voice 'voices/micha_10_1.mp3'

# game/Scenes/Micha/micha10.rpy:121
translate italian micha10_c0a252cf:

    # mc "I wish you would kiss me."
    mc "Vorrei che mi baciassi."

# game/Scenes/Micha/micha10.rpy:122
translate italian micha10_2b10aa09:

    # pc "Oh. Well you're not supposed to tell anybody, or it won't happen."
    pc "Oh. Beh, non devi dirlo a nessuno, altrimenti non si avvererà."

# game/Scenes/Micha/micha10.rpy:123
translate italian micha10_23b76a7a:

    # mc "Oh... I did not know that."
    mc "Oh... non lo sapevo."

# game/Scenes/Micha/micha10.rpy:139
translate italian micha10kiss_4cdfc044:

    # "I lean in and kiss her."
    "Mi avvicino e la bacio."

# game/Scenes/Micha/micha10.rpy:140
translate italian micha10kiss_ca40b1c0:

    # pc "It's just dumb superstition anyway."
    pc "È solo una stupida superstizione, comunque."

# game/Scenes/Micha/micha10.rpy:141
translate italian micha10kiss_39894277:

    # "At first, she is stiff, not moving at all as I kiss her lips. It's like kissing a mannequin."
    "All’inizio è rigida, non si muove affatto mentre le bacio le labbra. È come baciare un manichino."

# game/Scenes/Micha/micha10.rpy:154
translate italian micha10kiss_4319b810:

    # "But then I feel her body loosen, she puts her hand on my arm and leans in further, her lips moving against mine, breath coming quicker."
    "Ma poi sento il suo corpo rilassarsi, mi mette una mano sul braccio e si avvicina ancora di più, le sue labbra si muovono contro le mie, il respiro si fa più affannoso."

# game/Scenes/Micha/micha10.rpy:155
translate italian micha10kiss_b9bbd6df:

    # "We kiss like that, under the stars, until the moment turns into minutes, and time seems to float away on the cool night breeze."
    "Ci baciamo così, sotto le stelle, finché quel momento non si trasforma in minuti, e il tempo sembra scivolare via sulla fresca brezza notturna."

# game/Scenes/Micha/micha10.rpy:167
translate italian micha10kiss_a2abceb1:

    # "I have no idea how much time has passed when she finally, reluctantly, pulls away."
    "Non ho idea di quanto tempo sia passato quando lei, alla fine, a malincuore, si stacca da me."

# game/Scenes/Micha/micha10.rpy:168
translate italian micha10kiss_e9b48769:

    # mc "I should go."
    mc "Dovrei andare."

# game/Scenes/Micha/micha10.rpy:169
translate italian micha10kiss_7cf89165:

    # pc "You have to?"
    pc "Devi proprio?"

# game/Scenes/Micha/micha10.rpy:170
translate italian micha10kiss_1145978d:

    # mc "Yes, I apologize."
    mc "Sì, mi dispiace."

# game/Scenes/Micha/micha10.rpy:173
translate italian micha10kiss_d89f8402:

    # pc "I should probably go home."
    pc "Probabilmente dovrei tornare a casa."

# game/Scenes/Micha/micha10.rpy:174
translate italian micha10kiss_2148e939:

    # mc "Okay. Me too then."
    mc "Va bene. Allora anch’io."

# game/Scenes/Micha/micha10.rpy:186
translate italian micha10kiss_53fd2d63:

    # mc "I had a very good time tonight, [pcname]. Thank you."
    mc "Mi sono divertita tantissimo stasera, [pcname]. Grazie."

# game/Scenes/Micha/micha10.rpy:187
translate italian micha10kiss_445c1419:

    # pc "I'm glad. I did too."
    pc "Ne sono felice. Anch’io."

# game/Scenes/Micha/micha10.rpy:188
translate italian micha10kiss_7aea7a63:

    # mc "I hope we can do this again soon."
    mc "Spero che potremo rifarlo presto."

# game/Scenes/Micha/micha10.rpy:190
translate italian micha10kiss_d41d8cd9:

    # voice 'voices/micha_goodnight1.mp3'
    voice 'voices/micha_goodnight1.mp3'

# game/Scenes/Micha/micha10.rpy:191
translate italian micha10kiss_9b0423ef:

    # mc "Good night."
    mc "Buonanotte."

# game/Scenes/Micha/micha10.rpy:192
translate italian micha10kiss_c2ed5d6f:

    # pc "Good night, Mi-Cha."
    pc "Buonanotte, Mi-Cha."

# game/Scenes/Micha/micha10.rpy:195
translate italian micha10kiss_17735f99:

    # "With that, she goes inside of her dorm building and I walk back to my car and drive away."
    "Detto questo, lei entra nel suo dormitorio e io torno alla mia auto e me ne vado."

# game/Scenes/Micha/micha10.rpy:196
translate italian micha10kiss_de8a7413:

    # "Maybe Mi-Cha and I will only get the rest of the semester together, but we'll be sure to make it count."
    "Forse io e Mi-Cha passeremo insieme solo il resto del semestre, ma faremo in modo che valga la pena."

translate italian strings:

    # game/Scenes/Micha/micha10.rpy:3
    old "Take Mi-Cha on more dates by calling her in the evening. Eventually she will ask you to walk her back to her dorm after one."
    new "Porta Mi-Cha a più appuntamenti chiamandola la sera. Alla fine ti chiederà di accompagnarla al dormitorio dopo l’una."

    # game/Scenes/Micha/micha10.rpy:4
    old "Take your opportunity and kiss her when the moment arises."
    new "Cogli l’occasione e baciala quando si presenta il momento giusto."

    # game/Scenes/Micha/micha10.rpy:88
    old "That sucks, because I really like you"
    new "Che peccato, perché mi piaci davvero tanto"

    # game/Scenes/Micha/micha10.rpy:90
    old "I guess we're just temporary friends then, huh?"
    new "Immagino che allora saremo solo amici per un po’, eh?"

    # game/Scenes/Micha/micha10.rpy:172
    old "Tell her good night"
    new "Dille buonanotte"

