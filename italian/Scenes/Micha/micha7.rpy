# game/Scenes/Micha/micha7.rpy:11
translate italian micha7a_be31aa9e:

    # "I spend some time talking to Gertrude about the things that have been on my mind. Then when I am about to leave and head to class, she stops me."
    "Passo un po’ di tempo a parlare con Gertrude delle cose che mi passano per la testa. Poi, quando sto per andarmene e dirigermi a lezione, lei mi ferma."

# game/Scenes/Micha/micha7.rpy:12
translate italian micha7a_039a0a46:

    # sc "Hey, before you leave, I wanted to tell you that I talked to Mi-Cha about you."
    sc "Ehi, prima che tu te ne vada, volevo dirti che ho parlato di te con Mi-Cha."

# game/Scenes/Micha/micha7.rpy:13
translate italian micha7a_ae871f39:

    # pc "Oh yeah?"
    pc "Ah sì?"

# game/Scenes/Micha/micha7.rpy:14
translate italian micha7a_13380f5e:

    # sc "She's very shy, but I talked her into having a little coffee meet-up with you. Can you meet her this evening?"
    sc "È molto timida, ma l’ho convinta a fare un piccolo incontro per un caffè con te. Puoi incontrarla stasera?"

# game/Scenes/Micha/micha7.rpy:18
translate italian micha7a_5ec9bea1:

    # sc "Great! I'll let her know to meet you in the school café this evening."
    sc "Fantastico! Le dirò di incontrarti al bar della scuola stasera."

# game/Scenes/Micha/micha7.rpy:19
translate italian micha7a_a8af18a8:

    # pc "Cool, I'm looking forward to it."
    pc "Fantastico, non vedo l’ora."

# game/Scenes/Micha/micha7.rpy:20
translate italian micha7a_e4769446:

    # sc "Okay, I'll see you later, [pcname]."
    sc "Ok, ci vediamo più tardi, [pcname]."

# game/Scenes/Micha/micha7.rpy:23
translate italian micha7a_9669528e:

    # "Later..."
    "A dopo..."

# game/Scenes/Micha/micha7.rpy:29
translate italian micha7a_6750acb1:

    # sc "Oh, I'm sorry. I thought you were."
    sc "Oh, scusa. Pensavo che lo fossi."

# game/Scenes/Micha/micha7.rpy:30
translate italian micha7a_9f1153c2:

    # sc "Okay then. She'll be disappointed, but I'll let her know."
    sc "Va bene allora. Lei rimarrà delusa, ma glielo dirò."

# game/Scenes/Micha/micha7.rpy:31
translate italian micha7a_9c57fd84:

    # sc "I'll see you later, [pcname]."
    sc "Ci vediamo più tardi, [pcname]."

# game/Scenes/Micha/micha7.rpy:39
translate italian micha7_617439f0:

    # "I head over to the café for my coffee date with Mi-Cha."
    "Mi dirigo al bar per il mio appuntamento con Mi-Cha."

# game/Scenes/Micha/micha7.rpy:44
translate italian micha7_046f6d25:

    # "When I walk into the café, I spot Mi-Cha sitting alone at one of the tables. She sees me immediately, as if she has been staring at the door waiting for me to enter."
    "Quando entro nel bar, vedo Mi-Cha seduta da sola a uno dei tavoli. Mi vede immediatamente, come se fosse rimasta a fissare la porta in attesa che entrassi."

# game/Scenes/Micha/micha7.rpy:47
translate italian micha7_715a3be9:

    # "She immediately stands and walks up towards me."
    "Si alza subito e viene verso di me."

# game/Scenes/Micha/micha7.rpy:49
translate italian micha7_d41d8cd9:

    # voice 'voices/micha_7_1.mp3'
    voice 'voices/micha_7_1.mp3'

# game/Scenes/Micha/micha7.rpy:50
translate italian micha7_b81c6f86:

    # mc "Hello, [pcname]. My name is Mi-Cha. It is very nice to meet you."
    mc "Ciao, [pcname]. Mi chiamo Mi-Cha. È un vero piacere conoscerti."

# game/Scenes/Micha/micha7.rpy:51
translate italian micha7_65b65cd2:

    # pc "Hi, Mi-Cha. We've met already in the lobby remember?"
    pc "Ciao, Mi-Cha. Ci siamo già incontrati nella hall, ricordi?"

# game/Scenes/Micha/micha7.rpy:53
translate italian micha7_d41d8cd9_1:

    # voice 'voices/micha_yes1.mp3'
    voice 'voices/micha_yes1.mp3'

# game/Scenes/Micha/micha7.rpy:54
translate italian micha7_076877b6:

    # mc "Yes, I remember."
    mc "Sì, me lo ricordo."

# game/Scenes/Micha/micha7.rpy:55
translate italian micha7_1d573332:

    # pc "Do you want a coffee?"
    pc "Vuoi un caffè?"

# game/Scenes/Micha/micha7.rpy:57
translate italian micha7_bf8efb1f:

    # "She doesn't say anything in response, instead just nodding her head slightly."
    "Lei non risponde a parole, ma si limita ad annuire leggermente con la testa."

# game/Scenes/Micha/micha7.rpy:60
translate italian micha7_b6487666:

    # bn "Hi there. What can I get for you?"
    bn "Ciao. Cosa posso portarti?"

# game/Scenes/Micha/micha7.rpy:61
translate italian micha7_fa4d4666:

    # pc "What would you like, Mi-Cha? I'll pay. Anything you want."
    pc "Cosa ti va, Mi-Cha? Offro io. Quello che vuoi."

# game/Scenes/Micha/micha7.rpy:62
translate italian micha7_816eccbd:

    # mc "You first, please."
    mc "Prima tu, per favore."

# game/Scenes/Micha/micha7.rpy:63
translate italian micha7_c24a94ff:

    # pc "Okay. I'll have a hot vanilla latte."
    pc "Va bene. Prenderò un latte alla vaniglia caldo."

# game/Scenes/Micha/micha7.rpy:64
translate italian micha7_0515f2bf:

    # mc "I will have the same."
    mc "Prenderò lo stesso."

# game/Scenes/Micha/micha7.rpy:65
translate italian micha7_a4c27a52:

    # bn "Sure thing. Two hot vanilla lattes coming right up."
    bn "Certo. Due latte alla vaniglia caldi in arrivo."

# game/Scenes/Micha/micha7.rpy:68
translate italian micha7_9e1b5b12:

    # "We wait for our drinks, I pay, then we go to a table and sit down."
    "Aspettiamo le nostre bevande, pago, poi andiamo a un tavolo e ci sediamo."

# game/Scenes/Micha/micha7.rpy:69
translate italian micha7_c8eefb91:

    # "Mi-Cha doesn't say anything, just looking down at her coffee and smiling nervously."
    "Mi-Cha non dice nulla, guarda solo il suo caffè e sorride nervosamente."

# game/Scenes/Micha/micha7.rpy:74
translate italian micha7_2aebf130:

    # mc "Very good, thank you."
    mc "Molto buono, grazie."

# game/Scenes/Micha/micha7.rpy:80
translate italian micha7_2aebf130_1:

    # mc "Very good, thank you."
    mc "Molto buono, grazie."

# game/Scenes/Micha/micha7.rpy:83
translate italian micha7_fa75bbc3:

    # pc "Are you okay?"
    pc "Stai bene?"

# game/Scenes/Micha/micha7.rpy:84
translate italian micha7_dc52a31e:

    # pc "You seem a little nervous."
    pc "Sembri un po’ nervosa."

# game/Scenes/Micha/micha7.rpy:86
translate italian micha7_d41d8cd9_2:

    # voice 'voices/micha_yes2.mp3'
    voice 'voices/micha_yes2.mp3'

# game/Scenes/Micha/micha7.rpy:87
translate italian micha7_d1bf83b5:

    # mc "Yes. I am."
    mc "Sì. Lo sono."

# game/Scenes/Micha/micha7.rpy:88
translate italian micha7_fb27d9a1:

    # pc "You don't have to be nervous around me. I'm not going to hurt you."
    pc "Non devi essere nervosa con me. Non ti farò del male."

# game/Scenes/Micha/micha7.rpy:89
translate italian micha7_27577933:

    # mc "I know. I really want you to like me."
    mc "Lo so. Voglio davvero piacerti."

# game/Scenes/Micha/micha7.rpy:90
translate italian micha7_fcf5ae2f:

    # pc "I do like you."
    pc "Mi piaci."

# game/Scenes/Micha/micha7.rpy:93
translate italian micha7_81709362:

    # mc "You do?"
    mc "Davvero?"

# game/Scenes/Micha/micha7.rpy:94
translate italian micha7_423fa223:

    # pc "Sure. That's why I asked Gertrude to set up this date."
    pc "Certo. È per questo che ho chiesto a Gertrude di organizzare questo appuntamento."

# game/Scenes/Micha/micha7.rpy:95
translate italian micha7_6af12bd8:

    # mc "This is a date?"
    mc "Questo è un appuntamento?"

# game/Scenes/Micha/micha7.rpy:96
translate italian micha7_c1f89784:

    # pc "A coffee date, yeah."
    pc "Un appuntamento per un caffè, sì."

# game/Scenes/Micha/micha7.rpy:99
translate italian micha7_57067727:

    # mc "Not the kind of date that ends in bed though?"
    mc "Non il tipo di appuntamento che finisce a letto, però?"

# game/Scenes/Micha/micha7.rpy:102
translate italian micha7_7d70b936:

    # mc "Good. I do not think I am ready for that yet."
    mc "Bene. Non credo di essere ancora pronta per quello."

# game/Scenes/Micha/micha7.rpy:104
translate italian micha7_8d1c80ad:

    # mc "No!"
    mc "No!"

# game/Scenes/Micha/micha7.rpy:105
translate italian micha7_8413dde0:

    # mc "I'm sorry. I do not think I am ready for that yet."
    mc "Mi dispiace. Non credo di essere ancora pronta per questo."

# game/Scenes/Micha/micha7.rpy:108
translate italian micha7_7d63d9da:

    # mc "I am very sorry. Did I offend you?"
    mc "Mi dispiace tantissimo. Ti ho offeso?"

# game/Scenes/Micha/micha7.rpy:109
translate italian micha7_8b131ed8:

    # mc "I did not mean I would not want to go to bed with you. But I feel uncomfortable about it right now."
    mc "Non volevo dire che non vorrei andare a letto con te. Ma in questo momento mi sento a disagio all’idea."

# game/Scenes/Micha/micha7.rpy:110
translate italian micha7_0d2c9d39:

    # pc "It's okay, I wasn't suggesting that. You didn't offend me."
    pc "Va bene, non stavo suggerendo questo. Non mi hai offeso."

# game/Scenes/Micha/micha7.rpy:113
translate italian micha7_0e8b4e1b:

    # mc "Oh no, I am making things worse aren't I?"
    mc "Oh no, sto peggiorando le cose, vero?"

# game/Scenes/Micha/micha7.rpy:114
translate italian micha7_c767c9ce:

    # mc "I am so bad at this."
    mc "Sono così incapace in queste cose."

# game/Scenes/Micha/micha7.rpy:115
translate italian micha7_c1e312a1:

    # pc "It's okay, really. Just calm down."
    pc "Va tutto bene, davvero. Calmati."

# game/Scenes/Micha/micha7.rpy:118
translate italian micha7_87a0b25e:

    # "I reach over and place my hand over hers. She starts to pull away at first, then relaxes."
    "Allungo la mano e la poso sulla sua. All’inizio lei cerca di ritrarsi, poi si rilassa."

# game/Scenes/Micha/micha7.rpy:121
translate italian micha7_7c1c3cc4:

    # mc "Miss Spann did not tell me that you asked for this date. I thought that she set it up because she wanted me to meet people."
    mc "La signorina Spann non mi ha detto che eri stata tu a chiedere questo appuntamento. Pensavo che l’avesse organizzato lei perché voleva farmi conoscere delle persone."

# game/Scenes/Micha/micha7.rpy:122
translate italian micha7_36fab42e:

    # mc "It does make me feel better that you requested it."
    mc "Mi fa davvero sentire meglio sapere che sei stata tu a chiederlo."

# game/Scenes/Micha/micha7.rpy:123
translate italian micha7_f3c20824:

    # mc "Why did you want to buy me coffee?"
    mc "Perché volevi offrirmi un caffè?"

# game/Scenes/Micha/micha7.rpy:124
translate italian micha7_f0ffbaf0:

    # pc "I don't know. I thought you were cute and could use a friend."
    pc "Non lo so. Pensavo fossi carina e che ti servisse un’amica."

# game/Scenes/Micha/micha7.rpy:127
translate italian micha7_41d2c325:

    # mc "You think that I am cute?"
    mc "Pensi che io sia carina?"

# game/Scenes/Micha/micha7.rpy:128
translate italian micha7_d54e19e4:

    # pc "Yeah. You're very cute."
    pc "Sì. Sei davvero carina."

# game/Scenes/Micha/micha7.rpy:132
translate italian micha7_d41d8cd9_3:

    # voice 'voices/micha_thankyou1.mp3'
    voice 'voices/micha_thankyou1.mp3'

# game/Scenes/Micha/micha7.rpy:133
translate italian micha7_5b61e929:

    # mc "Thank you, [pcname]."
    mc "Grazie, [pcname]."

# game/Scenes/Micha/micha7.rpy:134
translate italian micha7_61a02886:

    # mc "I… think that you are cute as well."
    mc "Io… penso che anche tu sia carino."

# game/Scenes/Micha/micha7.rpy:137
translate italian micha7_3b1b3410:

    # mc "Oh no, I should not have said that. I can't believe I said that."
    mc "Oh no, non avrei dovuto dirlo. Non riesco a credere di averlo detto."

# game/Scenes/Micha/micha7.rpy:138
translate italian micha7_84587f43:

    # pc "What? It's okay that you think I'm cute."
    pc "Cosa? Va bene se pensi che io sia carina."

# game/Scenes/Micha/micha7.rpy:139
translate italian micha7_a67a4bd1:

    # mc "No. I can't. I should go."
    mc "No. Non posso. Devo andare."

# game/Scenes/Micha/micha7.rpy:140
translate italian micha7_59ee5f3a:

    # pc "Why? You've barely drunk your coffee. I'd like to talk to you more."
    pc "Perché? Hai bevuto a malapena il tuo caffè. Mi piacerebbe parlare ancora con te."

# game/Scenes/Micha/micha7.rpy:142
translate italian micha7_d41d8cd9_4:

    # voice 'voices/micha_imsorry2.mp3'
    voice 'voices/micha_imsorry2.mp3'

# game/Scenes/Micha/micha7.rpy:143
translate italian micha7_918fea83:

    # mc "I'm sorry."
    mc "Mi dispiace."

# game/Scenes/Micha/micha7.rpy:146
translate italian micha7_6305b1a7:

    # mc "Is it okay if I leave?"
    mc "Va bene se me ne vado?"

# game/Scenes/Micha/micha7.rpy:151
translate italian micha7_d7eacc92:

    # mc "I know better than to be so forward."
    mc "So bene che non dovrei essere così sfacciata."

# game/Scenes/Micha/micha7.rpy:152
translate italian micha7_cafb4599:

    # mc "I have been taught better than to say things like that."
    mc "Mi è stato insegnato a non dire cose del genere."

# game/Scenes/Micha/micha7.rpy:153
translate italian micha7_f3946300:

    # mc "I am very sorry, but I would like to go now."
    mc "Mi dispiace molto, ma vorrei andarmene ora."

# game/Scenes/Micha/micha7.rpy:157
translate italian micha7_bb0eeaf4:

    # mc "Thank you."
    mc "Grazie."

# game/Scenes/Micha/micha7.rpy:158
translate italian micha7_c5f761de:

    # mc "I'm very sorry."
    mc "Mi dispiace molto."

# game/Scenes/Micha/micha7.rpy:161
translate italian micha7_3ac8722a:

    # pc "There's no reason to apologize. You haven't done anything wrong."
    pc "Non c’è motivo di scusarsi. Non hai fatto nulla di male."

# game/Scenes/Micha/micha7.rpy:163
translate italian micha7_d41d8cd9_5:

    # voice 'voices/micha_thankyou1.mp3'
    voice 'voices/micha_thankyou1.mp3'

# game/Scenes/Micha/micha7.rpy:164
translate italian micha7_024933de:

    # mc "Thank you. You're very kind."
    mc "Grazie. Sei molto gentile."

# game/Scenes/Micha/micha7.rpy:165
translate italian micha7_26dc8eb0:

    # pc "Can we at least try this again sometime?"
    pc "Possiamo almeno riprovarci un’altra volta?"

# game/Scenes/Micha/micha7.rpy:168
translate italian micha7_d6451512:

    # "She makes a squeaking sound somewhere deep in her throat, as if the words are being forcefully pushed out."
    "Emette un suono stridulo dal profondo della gola, come se le parole le venissero espulse con forza."

# game/Scenes/Micha/micha7.rpy:169
translate italian micha7_f800bed0:

    # mc "Yes."
    mc "Sì."

# game/Scenes/Micha/micha7.rpy:172
translate italian micha7_f5c4b536:

    # "Then she practically runs out of the café."
    "Poi praticamente scappa fuori dal bar."

# game/Scenes/Micha/micha7.rpy:175
translate italian micha7_b95ac3d7:

    # "Well that was definitely one of the weirder first dates I've had. Not sure what was going on with her."
    "Beh, questo è stato sicuramente uno dei primi appuntamenti più strani che abbia mai avuto. Non so bene cosa le stesse succedendo."

# game/Scenes/Micha/micha7.rpy:176
translate italian micha7_9788c24f:

    # "But she did say yes to another date."
    "Ma ha detto di sì a un altro appuntamento."

# game/Scenes/Micha/micha7.rpy:179
translate italian micha7_2b06c7c2:

    # "Maybe that one will go a little more smoothly."
    "Forse quello andrà un po’ più liscio."

