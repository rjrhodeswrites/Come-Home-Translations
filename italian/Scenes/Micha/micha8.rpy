translate italian micha8_5f9760c9:

    # "Before I go to Gertrude's office, Mi-Cha stops me in the lobby."
    "Prima di andare nell'ufficio di Gertrude, Mi-Cha mi ferma nell'atrio."

# game/Scenes/Micha/micha8.rpy:15
translate italian micha8_ed6bde86:

    # mc "Hello, [pcname]."
    mc "Ciao, [pcname]."

# game/Scenes/Micha/micha8.rpy:16
translate italian micha8_f481dcaa:

    # pc "Hi, Mi-Cha. How are you?"
    pc "Ciao, Mi-Cha. Come stai?"

# game/Scenes/Micha/micha8.rpy:17
translate italian micha8_72cb11f5:

    # mc "I am good, thank you."
    mc "Sto bene, grazie."

# game/Scenes/Micha/micha8.rpy:19
translate italian micha8_bdbd1fa8:

    # mc "I want to tell you that I enjoyed our coffee date."
    mc "Volevo dirti che mi è piaciuto il nostro appuntamento per un caffè."

# game/Scenes/Micha/micha8.rpy:20
translate italian micha8_8a7120da:

    # mc "I apologize for rushing off early and would like to again another sometime."
    mc "Mi dispiace di essermela svignata così presto e mi piacerebbe rifarlo un'altra volta."

# game/Scenes/Micha/micha8.rpy:21
translate italian micha8_3171636b:

    # mc "If you would like to this evening?"
    mc "Che ne dici di stasera?"

# game/Scenes/Micha/micha8.rpy:25
translate italian micha8_2d186b97:

    # mc "Good. I will meet you in the Skyhill Cafe this evening then."
    mc "Bene. Ci vediamo stasera allo Skyhill Cafe, allora."

# game/Scenes/Micha/micha8.rpy:29
translate italian micha8_2f88594e:

    # mc "Oh. Okay. Yes, I'm sure you're busy."
    mc "Oh. Va bene. Sì, sono sicuro che sei impegnata."

# game/Scenes/Micha/micha8.rpy:31
translate italian micha8_08d0510d:

    # mc "Enjoy your visit with Mrs. Spann."
    mc "Goditi la visita dalla signora Spann."

# game/Scenes/Micha/micha8.rpy:32
translate italian micha8_32a03447:

    # pc "Okay. I'll see you later, Mi-Cha."
    pc "Va bene. Ci vediamo più tardi, Mi-Cha."

