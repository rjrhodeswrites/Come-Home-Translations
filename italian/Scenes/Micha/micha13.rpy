# game/Scenes/Micha/micha13.rpy:10
translate italian micha13_66a911ed:

    # "When I get to the counselor's office, I'm surprised to see Gertrude behind the counter instead of Mi-Cha."
    "Quando arrivo all’ufficio della consulente, sono sorpreso di vedere Gertrude dietro il bancone al posto di Mi-Cha."

# game/Scenes/Micha/micha13.rpy:11
translate italian micha13_51f359cb:

    # sc "Good morning, [pcname]. If you're here for a counseling session, I'm sorry. I have to work reception today."
    sc "Buongiorno, [pcname]. Se sei qui per una seduta di consulenza, mi dispiace. Oggi devo lavorare alla reception."

# game/Scenes/Micha/micha13.rpy:12
translate italian micha13_320f7ecc:

    # pc "Where's Mi-Cha?"
    pc "Dov’è Mi-Cha?"

# game/Scenes/Micha/micha13.rpy:13
translate italian micha13_f822911c:

    # sc "She called this morning saying she couldn't come in for some reason. She sounded upset."
    sc "Ha chiamato stamattina dicendo che per qualche motivo non poteva venire. Sembrava turbata."

# game/Scenes/Micha/micha13.rpy:14
translate italian micha13_d6ed663d:

    # sc "If you have time, maybe you could go check on her? I know you two have become friends."
    sc "Se hai tempo, potresti andare a vedere come sta? So che voi due siete diventate amiche."

# game/Scenes/Micha/micha13.rpy:15
translate italian micha13_477e82cd:

    # pc "Yeah, I think I have a little time before class. I'll go do that."
    pc "Sì, credo di avere un po’ di tempo prima della lezione. Ci vado subito."

# game/Scenes/Micha/micha13.rpy:18
translate italian micha13_cfda0a84:

    # "I leave the counselor's office, walk over to the dorms, and make my way up to Mi-Cha's door."
    "Esco dall’ufficio della consulente, mi dirigo verso i dormitori e salgo fino alla porta di Mi-Cha."

# game/Scenes/Micha/micha13.rpy:22
translate italian micha13_90464c94:

    # "She answers after a couple of knocks."
    "Mi apre dopo un paio di colpi alla porta."

# game/Scenes/Micha/micha13.rpy:23
translate italian micha13_94a711d9:

    # mc "Oh, [pcname]! Why are you here?"
    mc "Oh, [pcname]! Perché sei qui?"

# game/Scenes/Micha/micha13.rpy:24
translate italian micha13_36eedc65:

    # pc "Gertrude asked me to come check on you. She said you called in. Are you sick?"
    pc "Gertrude mi ha chiesto di venire a vedere come stavi. Ha detto che hai chiamato per avvisare che non venivi. Sei malata?"

# game/Scenes/Micha/micha13.rpy:25
translate italian micha13_2e46b23a:

    # mc "No, I'm not sick."
    mc "No, non sono malata."

# game/Scenes/Micha/micha13.rpy:26
translate italian micha13_cb45e08c:

    # pc "Well, what's going on?"
    pc "Beh, allora cosa succede?"

# game/Scenes/Micha/micha13.rpy:29
translate italian micha13_98c909b0:

    # "I follow her inside and we sit on her bed."
    "La seguo dentro e ci sediamo sul suo letto."

# game/Scenes/Micha/micha13.rpy:30
translate italian micha13_2f43efba:

    # mc "I argued with my parents last night. They told me to quit dance class. They say that it interferes with my studies."
    mc "Ieri sera ho litigato con i miei genitori. Mi hanno detto di smettere di frequentare il corso di danza. Dicono che interferisca con i miei studi."

# game/Scenes/Micha/micha13.rpy:31
translate italian micha13_6282a1b7:

    # pc "But you like dancing."
    pc "Ma a te piace ballare."

# game/Scenes/Micha/micha13.rpy:34
translate italian micha13_44899e27:

    # mc "I love dancing. And I have a performance soon that I was very much looking forward to."
    mc "Adoro ballare. E presto avrò uno spettacolo che aspettavo con tanta ansia."

# game/Scenes/Micha/micha13.rpy:35
translate italian micha13_4624f9be:

    # mc "But they say that I have to stop."
    mc "Ma dicono che devo smettere."

# game/Scenes/Micha/micha13.rpy:36
translate italian micha13_ff3c6bab:

    # pc "So what?"
    pc "E allora?"

# game/Scenes/Micha/micha13.rpy:37
translate italian micha13_f0ac6ad2:

    # mc "I can't just not do what they say."
    mc "Non posso semplicemente non fare quello che mi dicono."

# game/Scenes/Micha/micha13.rpy:40
translate italian micha13_23d549c1:

    # pc "But I want you to dance."
    pc "Ma io voglio che tu balli."

# game/Scenes/Micha/micha13.rpy:41
translate italian micha13_81709362:

    # mc "You do?"
    mc "Davvero?"

# game/Scenes/Micha/micha13.rpy:42
translate italian micha13_6dba6230:

    # pc "Yes."
    pc "Sì."

# game/Scenes/Micha/micha13.rpy:43
translate italian micha13_27a4c741:

    # mc "Are you telling me to?"
    mc "Me lo stai dicendo tu?"

# game/Scenes/Micha/micha13.rpy:44
translate italian micha13_f43da382:

    # pc "Yes, Mi-Cha. I'm telling you to dance."
    pc "Sì, Mi-Cha. Ti sto dicendo di ballare."

# game/Scenes/Micha/micha13.rpy:49
translate italian micha13_d41d8cd9:

    # voice 'voices/micha_yessir.mp3'
    voice 'voices/micha_yessir.mp3'

# game/Scenes/Micha/micha13.rpy:50
translate italian micha13_620baac7:

    # mc "Yes, [mcsir]."
    mc "Sì, [mcsir]."

# game/Scenes/Micha/micha13.rpy:51
translate italian micha13_929f424d:

    # pc "So you will?"
    pc "Quindi lo farai?"

# game/Scenes/Micha/micha13.rpy:54
translate italian micha13_d41d8cd9_1:

    # voice 'voices/micha_yessir.mp3'
    voice 'voices/micha_yessir.mp3'

# game/Scenes/Micha/micha13.rpy:55
translate italian micha13_620baac7_1:

    # mc "Yes, [mcsir]."
    mc "Sì, [mcsir]."

# game/Scenes/Micha/micha13.rpy:56
translate italian micha13_536da0ad:

    # mc "I will keep dancing. For you."
    mc "Continuerò a ballare. Per te."

# game/Scenes/Micha/micha13.rpy:57
translate italian micha13_f07574ec:

    # pc "Good."
    pc "Bene."

# game/Scenes/Micha/micha13.rpy:61
translate italian micha13_d41d8cd9_2:

    # voice 'voices/micha_thankyou1.mp3'
    voice 'voices/micha_thankyou1.mp3'

# game/Scenes/Micha/micha13.rpy:62
translate italian micha13_5b61e929:

    # mc "Thank you, [pcname]."
    mc "Grazie, [pcname]."

# game/Scenes/Micha/micha13.rpy:63
translate italian micha13_e3b6df4e:

    # pc "Do you feel better now?"
    pc "Ti senti meglio adesso?"

# game/Scenes/Micha/micha13.rpy:64
translate italian micha13_c324b928:

    # mc "Yes. I feel much better now."
    mc "Sì. Ora mi sento molto meglio."

# game/Scenes/Micha/micha13.rpy:65
translate italian micha13_63023601:

    # pc "Okay."
    pc "Ok."

# game/Scenes/Micha/micha13.rpy:66
translate italian micha13_c98760d6:

    # mc "I'll get dressed and go to the office."
    mc "Mi vesto e vado in ufficio."

# game/Scenes/Micha/micha13.rpy:70
translate italian micha13_d41d8cd9_3:

    # voice 'voices/micha_imsorry2.mp3'
    voice 'voices/micha_imsorry2.mp3'

# game/Scenes/Micha/micha13.rpy:71
translate italian micha13_5fbcf7dd:

    # mc "I'm sorry you had to see me like this. In my pajamas with no makeup."
    mc "Mi dispiace che tu mi abbia vista così. In pigiama e senza trucco."

# game/Scenes/Micha/micha13.rpy:72
translate italian micha13_57c13e1f:

    # pc "Don't be silly. You're gorgeous."
    pc "Non dire sciocchezze. Sei bellissima."

# game/Scenes/Micha/micha13.rpy:75
translate italian micha13_d41d8cd9_4:

    # voice 'voices/micha_thankyousir2.mp3'
    voice 'voices/micha_thankyousir2.mp3'

# game/Scenes/Micha/micha13.rpy:76
translate italian micha13_b00529b9:

    # mc "Thank you, [mcsir]."
    mc "Grazie, [mcsir]."

# game/Scenes/Micha/micha13.rpy:79
translate italian micha13_80adb898:

    # "I kiss her goodbye."
    "Le do un bacio d’addio."

# game/Scenes/Micha/micha13.rpy:80
translate italian micha13_bed52260:

    # "If I had time, I'd do more."
    "Se avessi tempo, farei di più."

# game/Scenes/Micha/micha13.rpy:83
translate italian micha13_1a383b4b:

    # "But I have to get to class, so we pull apart and I tell her goodbye."
    "Ma devo andare a lezione, quindi ci separiamo e le dico addio."

