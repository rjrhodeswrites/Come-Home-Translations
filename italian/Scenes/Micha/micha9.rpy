translate italian micha9_d615e831:

    # mc "Yes, I would like that very much."
    mc "Sì, mi farebbe molto piacere."

# game/Scenes/Micha/micha9.rpy:21
translate italian micha9_85b1cb90:

    # pc "Okay, we should do that then."
    pc "Ok, allora dovremmo farlo."

# game/Scenes/Micha/micha9.rpy:22
translate italian micha9_1914313d:

    # "She writes her phone number down on a piece of paper and hands it to me."
    "Mi scrive il suo numero di telefono su un foglietto e me lo porge."

# game/Scenes/Micha/micha9.rpy:24
translate italian micha9_8c687fe9:

    # mc "You can call me when you want to go."
    mc "Puoi chiamarmi quando vuoi uscire."

# game/Scenes/Micha/micha9.rpy:25
translate italian micha9_64c8cb1f:

    # pc "Okay, I will."
    pc "Ok, lo farò."

# game/Scenes/Micha/micha9.rpy:26
translate italian micha9_2510ca8f:

    # mc "I'm very much looking forward to it."
    mc "Non vedo l’ora."

# game/Scenes/Micha/micha9.rpy:27
translate italian micha9_03eaad50:

    # pc "Me too."
    pc "Anch’io."

# game/Scenes/Micha/micha9.rpy:28
translate italian micha9_a8f0ee70:

    # pc "I better get to class, I guess."
    pc "È meglio che vada a lezione, immagino."

# game/Scenes/Micha/micha9.rpy:30
translate italian micha9_9df13c81:

    # mc "Okay, [pcname]. I hope you have a nice day."
    mc "Ok, [pcname]. Ti auguro una buona giornata."

# game/Scenes/Micha/micha9.rpy:31
translate italian micha9_d656f4df:

    # pc "Thanks Mi-Cha, you too."
    pc "Grazie Mi-Cha, anche a te."

# game/Scenes/Micha/micha9.rpy:34
