# game/Scenes/Micha/micha18.rpy:15
translate italian micha18_688d0c7f:

    # "My phone starts buzzing in my pocket. I check and see that Mi-Cha is calling."
    "Il mio telefono inizia a vibrare in tasca. Controllo e vedo che è Mi-Cha che mi chiama."

# game/Scenes/Micha/micha18.rpy:20
translate italian micha18_3f3890ee:

    # pc "Hey, Mi-Cha. How are you doing?"
    pc "Ehi, Mi-Cha. Come stai?"

# game/Scenes/Micha/micha18.rpy:21
translate italian micha18_871ef5af:

    # mc "I am feeling very nervous, but also excited."
    mc "Mi sento molto nervosa, ma anche emozionata."

# game/Scenes/Micha/micha18.rpy:22
translate italian micha18_e61255db:

    # pc "About what?"
    pc "Per cosa?"

# game/Scenes/Micha/micha18.rpy:24
translate italian micha18_0366f1bc:

    # mc "My dance performance is tonight. Will you come?"
    mc "Stasera ho lo spettacolo di danza. Verrai?"

# game/Scenes/Micha/micha18.rpy:25
translate italian micha18_33cc462a:

    # pc "What? Of course! Why didn't you tell me already? I didn't know it was tonight!"
    pc "Cosa? Ma certo! Perché non me l’hai detto prima? Non sapevo fosse stasera!"

# game/Scenes/Micha/micha18.rpy:27
translate italian micha18_b360fd8d:

    # mc "I'm sorry, [mcsir]."
    mc "Mi dispiace, [mcsir]."

# game/Scenes/Micha/micha18.rpy:28
translate italian micha18_c2363c70:

    # mc "I have been shy to talk about it."
    mc "Non ho avuto il coraggio di parlartene."

# game/Scenes/Micha/micha18.rpy:30
translate italian micha18_a4fac60b:

    # mc "It is only a small performance. Nothing to get excited about."
    mc "È solo un piccolo spettacolo. Niente di cui entusiasmarsi."

# game/Scenes/Micha/micha18.rpy:32
translate italian micha18_0bb075ff:

    # pc "That's nonsense! You should be excited about it!"
    pc "Ma che sciocchezze! Dovresti esserne entusiasta!"

# game/Scenes/Micha/micha18.rpy:33
translate italian micha18_16694b2f:

    # pc "I'm really happy for you and I'll be in the audience supporting you."
    pc "Sono davvero felice per te e sarò tra il pubblico a tifare per te."

# game/Scenes/Micha/micha18.rpy:35
translate italian micha18_7c591fc4:

    # mc "Okay. I am happy that you will be there."
    mc "Ok. Sono felice che tu ci sarai."

# game/Scenes/Micha/micha18.rpy:36
translate italian micha18_5f7f4323:

    # mc "It is at 7pm on the school's stage."
    mc "È alle 19:00 sul palco della scuola."

# game/Scenes/Micha/micha18.rpy:37
translate italian micha18_9d74725b:

    # pc "I'll be there. As close as I can get to the front row."
    pc "Ci sarò. Il più vicino possibile alla prima fila."

# game/Scenes/Micha/micha18.rpy:39
translate italian micha18_02124621:

    # mc "Thank you, [pcname]. I will see you there."
    mc "Grazie, [pcname]. Ci vediamo lì."

# game/Scenes/Micha/micha18.rpy:42
translate italian micha18_25a2f290:

    # "We say our goodbyes, then later that evening, I drive to the school to watch her performance."
    "Ci salutiamo, poi più tardi quella sera vado in macchina a scuola per vedere la sua esibizione."

# game/Scenes/Micha/micha18.rpy:45
translate italian micha18_ebb5885b:

    # "I show up a little early and am able to get a front row seat. There's a few other people in the audience, but it's pretty empty."
    "Arrivo un po’ in anticipo e riesco a trovare un posto in prima fila. Ci sono poche altre persone tra il pubblico, ma la sala è piuttosto vuota."

# game/Scenes/Micha/micha18.rpy:48
translate italian micha18_9b44beaa:

    # "A few minutes later, Gertrude comes in and smiles at me."
    "Pochi minuti dopo, Gertrude entra e mi sorride."

# game/Scenes/Micha/micha18.rpy:49
translate italian micha18_734ac2ed:

    # sc "Hey, [pcname]. I didn't expect to see you here. I've never seen you at any of the other performances."
    sc "Ehi, [pcname]. Non mi aspettavo di vederti qui. Non ti ho mai visto a nessuna delle altre esibizioni."

# game/Scenes/Micha/micha18.rpy:50
translate italian micha18_c2b482c4:

    # pc "Oh, I'm here to support Mi-Cha."
    pc "Oh, sono qui per sostenere Mi-Cha."

# game/Scenes/Micha/micha18.rpy:51
translate italian micha18_6fc91d73:

    # sc "That's nice of you. I'm looking forward to seeing her perform."
    sc "Che gentile da parte tua. Non vedo l’ora di vederla esibirsi."

# game/Scenes/Micha/micha18.rpy:52
translate italian micha18_0d7c2170:

    # sc "Do you mind if I sit next to you?"
    sc "Ti dispiace se mi siedo accanto a te?"

# game/Scenes/Micha/micha18.rpy:53
translate italian micha18_6912ead3:

    # pc "Not at all."
    pc "Per niente."

# game/Scenes/Micha/micha18.rpy:57
translate italian micha18_618925b1:

    # sc "So are you two dating now?"
    sc "Quindi voi due state insieme adesso?"

# game/Scenes/Micha/micha18.rpy:58
translate italian micha18_f78d20fe:

    # pc "Yeah, we've been seeing each other a bit."
    pc "Sì, ci frequentiamo da un po’."

# game/Scenes/Micha/micha18.rpy:59
translate italian micha18_5ab35b8c:

    # sc "That's great!"
    sc "È fantastico!"

# game/Scenes/Micha/micha18.rpy:60
translate italian micha18_a0b30b82:

    # sc "How serious is it between you two?"
    sc "Quanto è seria la cosa tra voi due?"

# game/Scenes/Micha/micha18.rpy:61
translate italian micha18_b8162d87:

    # pc "Oh I don't know... I think she's great and I like spending time with her."
    pc "Oh, non lo so... Penso che sia fantastica e mi piace passare del tempo con lei."

# game/Scenes/Micha/micha18.rpy:63
translate italian micha18_8094ff46:

    # sc "We both know she's not the only one you're seeing though..."
    sc "Sappiamo entrambi che non è l’unica con cui esci, però..."

# game/Scenes/Micha/micha18.rpy:64
translate italian micha18_c417e350:

    # pc "Yeah."
    pc "Sì."

# game/Scenes/Micha/micha18.rpy:65
translate italian micha18_eda2d229:

    # sc "Just be careful with her. She's a little naive."
    sc "Stai attento con lei. È un po’ ingenua."

# game/Scenes/Micha/micha18.rpy:66
translate italian micha18_11144671:

    # sc "Don't hurt her, okay?"
    sc "Non ferirla, ok?"

# game/Scenes/Micha/micha18.rpy:67
translate italian micha18_dd9a629d:

    # pc "I won't."
    pc "Non lo farò."

# game/Scenes/Micha/micha18.rpy:70
translate italian micha18_0a52de10:

    # "As time grows closer to the start of the show, the seats begin to fill up more."
    "Man mano che si avvicina l’inizio dello spettacolo, i posti a sedere cominciano a riempirsi sempre di più."

# game/Scenes/Micha/micha18.rpy:73
translate italian micha18_14f8d7ae:

    # "I see Ms. Welch walk in and sit down."
    "Vedo la signora Welch entrare e sedersi."

# game/Scenes/Micha/micha18.rpy:77
translate italian micha18_5868bd91:

    # "She spots me and gives me a wave and a wink."
    "Mi nota e mi fa un cenno con la mano e un occhiolino."

# game/Scenes/Micha/micha18.rpy:80
translate italian micha18_f6954d22:

    # "Then I look over and see Mrs. McGee sitting as well."
    "Poi guardo dall’altra parte e vedo anche la signora McGee seduta."

# game/Scenes/Micha/micha18.rpy:81
translate italian micha18_e5a0cf64:

    # "It's more people than I expected to see."
    "C’è più gente di quanto mi aspettassi."

# game/Scenes/Micha/micha18.rpy:85
translate italian micha18_f05e2763:

    # "She and Pete both smile and wave at me."
    "Sia lei che Pete mi sorridono e mi salutano con la mano."

# game/Scenes/Micha/micha18.rpy:89
translate italian micha18_29bbeb02:

    # "Then the lights dim, a spotlight shines on the stage, and music begins to play."
    "Poi le luci si abbassano, un riflettore illumina il palco e la musica inizia a suonare."

# game/Scenes/Micha/micha18.rpy:92
translate italian micha18_16e9fa91:

    # "The curtains open and the ballet starts."
    "Il sipario si apre e il balletto ha inizio."

# game/Scenes/Micha/micha18.rpy:93
translate italian micha18_5069de6b:

    # "I'm not really sure what is happening, but everybody on stage moves in a well-choreographed dance along with the music."
    "Non so bene cosa stia succedendo, ma tutti sul palco si muovono in una danza ben coreografata al ritmo della musica."

# game/Scenes/Micha/micha18.rpy:94
translate italian micha18_e615adbc:

    # "Everybody else seems to fade into the background as my eyes lock onto Mi-Cha, though."
    "Tutti gli altri sembrano svanire sullo sfondo mentre i miei occhi si fissano su Mi-Cha, però."

# game/Scenes/Micha/micha18.rpy:95
translate italian micha18_f7a5d1fe:

    # "She's gorgeous in her costume and her movements are almost hypnotizing in their beauty."
    "È splendida nel suo costume e i suoi movimenti sono di una bellezza quasi ipnotica."

# game/Scenes/Micha/micha18.rpy:98
translate italian micha18_9d2a99c2:

    # "One of the male dancers spins her, then lifts her up like she's flying."
    "Uno dei ballerini la fa volteggiare, poi la solleva come se stesse volando."

# game/Scenes/Micha/micha18.rpy:101
translate italian micha18_b95ea171:

    # "Amazingly, she doesn't look nervous at all."
    "Incredibilmente, non sembra affatto nervosa."

# game/Scenes/Micha/micha18.rpy:102
translate italian micha18_728386fb:

    # "Her usual self-conscious and timid attitude is gone, as if she's in her own world and none of us are even here."
    "Il suo solito atteggiamento timido e impacciato è sparito, come se fosse nel suo mondo e nessuno di noi fosse nemmeno qui."

# game/Scenes/Micha/micha18.rpy:105
translate italian micha18_ffb4c520:

    # "Part of the way through the performance - I've long lost the story by now - the lights dim once again and only Mi-Cha is illuminated."
    "A un certo punto dello spettacolo – ormai ho perso da tempo il filo della storia – le luci si abbassano di nuovo e solo Mi-Cha rimane illuminata."

# game/Scenes/Micha/micha18.rpy:106
translate italian micha18_ee38e730:

    # "The rest of the cast falls back into the shadows and all eyes are on her."
    "Il resto del cast torna nell’ombra e tutti gli occhi sono puntati su di lei."

# game/Scenes/Micha/micha18.rpy:110
translate italian micha18_235a0510:

    # "And she dances."
    "E lei balla."

# game/Scenes/Micha/micha18.rpy:111
translate italian micha18_af3cfdb9:

    # "I'm sure her dance is telling the story of her character in the ballet, but I feel like it's telling Mi-Cha's story as well."
    "Sono sicura che la sua danza racconti la storia del suo personaggio nel balletto, ma mi sembra che racconti anche la storia di Mi-Cha."

# game/Scenes/Micha/micha18.rpy:112
translate italian micha18_b3efe8d7:

    # "I feel like I can see right through to her heart. She's wearing clothes, but she is also naked, baring her soul."
    "Mi sembra di poter vedere dritto nel suo cuore. Indossa dei vestiti, ma è anche nuda, mette a nudo la sua anima."

# game/Scenes/Micha/micha18.rpy:113
translate italian micha18_cd9f512f:

    # "There's only been a couple of times where I've felt like Mi-Cha has been completely free and uninhibited - when she's dancing, and when we're fucking."
    "Ci sono state solo un paio di volte in cui ho sentito che Mi-Cha fosse completamente libera e disinibita: quando balla e quando scopiamo."

# game/Scenes/Micha/micha18.rpy:114
translate italian micha18_9b3a0aea:

    # "In both cases, she's absolutely beautiful."
    "In entrambi i casi, è assolutamente bellissima."

# game/Scenes/Micha/micha18.rpy:120
translate italian micha18_abeb9237:

    # "When the show is over, the whole crowd stands up and applauds."
    "Quando lo spettacolo finisce, tutto il pubblico si alza in piedi e applaude."

# game/Scenes/Micha/micha18.rpy:121
translate italian micha18_aca55a3d:

    # "I'm just so happy that everybody can see how amazing Mi-Cha is."
    "Sono così felice che tutti possano vedere quanto sia straordinaria Mi-Cha."

# game/Scenes/Micha/micha18.rpy:124
translate italian micha18_f1614496:

    # sc "Wow, that was incredible. She is so talented!"
    sc "Wow, è stato incredibile. Ha davvero un grande talento!"

# game/Scenes/Micha/micha18.rpy:125
translate italian micha18_6c11c780:

    # pc "Yeah. I'm going to go find her."
    pc "Sì. Vado a cercarla."

# game/Scenes/Micha/micha18.rpy:126
translate italian micha18_9b70b49a:

    # sc "Okay. You two have a good night."
    sc "Ok. Buona serata a voi due."

# game/Scenes/Micha/micha18.rpy:130
translate italian micha18_72d6b54c:

    # "I look backstage, but the cast tells me that she's already left."
    "Guardo dietro le quinte, ma il cast mi dice che se n’è già andata."

# game/Scenes/Micha/micha18.rpy:131
translate italian micha18_d18e5603:

    # "So I rush out towards her dorm, looking for her."
    "Così mi precipito verso il suo dormitorio, cercandola."

# game/Scenes/Micha/micha18.rpy:134
translate italian micha18_9cd32c90:

    # "When I find her, she's sitting on the bench outside her dorm, sobbing into her hands."
    "Quando la trovo, è seduta sulla panchina fuori dal dormitorio, singhiozzando con le mani sul viso."

# game/Scenes/Micha/micha18.rpy:135
translate italian micha18_0003d575:

    # pc "Hey, what's wrong? Are you okay?"
    pc "Ehi, cosa c’è che non va? Stai bene?"

# game/Scenes/Micha/micha18.rpy:137
translate italian micha18_d41d8cd9:

    # voice 'voices/micha_18_1.mp3'
    voice 'voices/micha_18_1.mp3'

# game/Scenes/Micha/micha18.rpy:138
translate italian micha18_918fea83:

    # mc "I'm sorry."
    mc "Mi dispiace."

# game/Scenes/Micha/micha18.rpy:141
translate italian micha18_2db90f14:

    # pc "What's wrong? You were amazing. They all loved you."
    pc "Cosa c’è che non va? Sei stata fantastica. Ti hanno adorata tutti."

# game/Scenes/Micha/micha18.rpy:143
translate italian micha18_d41d8cd9_1:

    # voice 'voices/micha_18_2.mp3'
    voice 'voices/micha_18_2.mp3'

# game/Scenes/Micha/micha18.rpy:144
translate italian micha18_cd855510:

    # mc "I don't want this to be over."
    mc "Non voglio che finisca tutto qui."

# game/Scenes/Micha/micha18.rpy:146
translate italian micha18_d41d8cd9_2:

    # voice 'voices/micha_18_3.mp3'
    voice 'voices/micha_18_3.mp3'

# game/Scenes/Micha/micha18.rpy:147
translate italian micha18_b624d3b4:

    # mc "I have to go back home. No more dancing."
    mc "Devo tornare a casa. Niente più balli."

# game/Scenes/Micha/micha18.rpy:151
translate italian micha18_d41d8cd9_3:

    # voice 'voices/micha_18_4.mp3'
    voice 'voices/micha_18_4.mp3'

# game/Scenes/Micha/micha18.rpy:152
translate italian micha18_4a94d1aa:

    # mc "And no more of you."
    mc "E niente più te."

# game/Scenes/Micha/micha18.rpy:154
translate italian micha18_d41d8cd9_4:

    # voice 'voices/micha_18_5.mp3'
    voice 'voices/micha_18_5.mp3'

# game/Scenes/Micha/micha18.rpy:155
translate italian micha18_b954ffce:

    # mc "I'm so happy. I don't want to leave."
    mc "Sono così felice. Non voglio andarmene."

# game/Scenes/Micha/micha18.rpy:158
translate italian micha18_6d39e617:

    # "I hold her for a while. Squeezing her close until she stops crying."
    "La stringo a me per un po’. La stringo forte finché non smette di piangere."

# game/Scenes/Micha/micha18.rpy:159
translate italian micha18_c40fa025:

    # pc "What if you just stay?"
    pc "E se restassi?"

# game/Scenes/Micha/micha18.rpy:161
translate italian micha18_d41d8cd9_5:

    # voice 'voices/micha_18_6.mp3'
    voice 'voices/micha_18_6.mp3'

# game/Scenes/Micha/micha18.rpy:162
translate italian micha18_fe1e7b75:

    # mc "I can't. I'm only authorized until the end of the semester. If I stay longer, I will be illegal."
    mc "Non posso. Ho il permesso solo fino alla fine del semestre. Se resto più a lungo, sarò qui illegalmente."

# game/Scenes/Micha/micha18.rpy:163
translate italian micha18_dcbbb7ed:

    # pc "Yeah, I guess that's bad."
    pc "Sì, immagino che sia un problema."

# game/Scenes/Micha/micha18.rpy:166
translate italian micha18_e22cecb4:

    # pc "Could you get your date extended?"
    pc "Potresti far prorogare il tuo permesso?"

# game/Scenes/Micha/micha18.rpy:168
translate italian micha18_d41d8cd9_6:

    # voice 'voices/micha_18_7.mp3'
    voice 'voices/micha_18_7.mp3'

# game/Scenes/Micha/micha18.rpy:169
translate italian micha18_6be2096b:

    # mc "I don't know. I will talk to Mrs. Spann about it. She knows better than me."
    mc "Non lo so. Ne parlerò con la signora Spann. Lei ne sa più di me."

# game/Scenes/Micha/micha18.rpy:171
translate italian micha18_d41d8cd9_7:

    # voice 'voices/micha_18_8.mp3'
    voice 'voices/micha_18_8.mp3'

# game/Scenes/Micha/micha18.rpy:172
translate italian micha18_708ee42e:

    # mc "I think I have to have a reason to extend though."
    mc "Penso però di dover avere un motivo valido per la proroga."

# game/Scenes/Micha/micha18.rpy:174
translate italian micha18_d41d8cd9_8:

    # voice 'voices/micha_18_9.mp3'
    voice 'voices/micha_18_9.mp3'

# game/Scenes/Micha/micha18.rpy:175
translate italian micha18_d4d465f0:

    # mc "Like taking more school. Or marriage."
    mc "Tipo continuare gli studi. O il matrimonio."

# game/Scenes/Micha/micha18.rpy:179
translate italian micha18_d41d8cd9_9:

    # voice 'voices/micha_18_10.mp3'
    voice 'voices/micha_18_10.mp3'

# game/Scenes/Micha/micha18.rpy:180
translate italian micha18_1cf758a9:

    # mc "I'm sorry. I said I wouldn't mention it again, and I did."
    mc "Mi dispiace. Avevo detto che non ne avrei più parlato, e invece l’ho fatto."

# game/Scenes/Micha/micha18.rpy:182
translate italian micha18_d41d8cd9_10:

    # voice 'voices/micha_18_11.mp3'
    voice 'voices/micha_18_11.mp3'

# game/Scenes/Micha/micha18.rpy:183
translate italian micha18_d88ba6c6:

    # mc "I don't want to pressure you."
    mc "Non voglio metterti sotto pressione."

# game/Scenes/Micha/micha18.rpy:185
translate italian micha18_d41d8cd9_11:

    # voice 'voices/micha_18_12.mp3'
    voice 'voices/micha_18_12.mp3'

# game/Scenes/Micha/micha18.rpy:186
translate italian micha18_0a8cc307:

    # mc "I just love you so much."
    mc "È solo che ti amo tantissimo."

# game/Scenes/Micha/micha18.rpy:189
translate italian micha18_5735beae:

    # pc "I love you too, Mi-Cha."
    pc "Ti amo anch’io, Mi-Cha."

# game/Scenes/Micha/micha18.rpy:190
translate italian micha18_83eef187:

    # pc "We'll figure this out, one way or another."
    pc "Troveremo una soluzione, in un modo o nell’altro."

# game/Scenes/Micha/micha18.rpy:191
translate italian micha18_39f98ad4:

    # pc "Everything will be okay."
    pc "Andrà tutto bene."

# game/Scenes/Micha/micha18.rpy:192
translate italian micha18_2c147205:

    # pc "I just want you to keep dancing. I just want you to be happy."
    pc "Voglio solo che tu continui a ballare. Voglio solo che tu sia felice."

# game/Scenes/Micha/micha18.rpy:196
translate italian micha18_d41d8cd9_12:

    # voice 'voices/micha_18_13.mp3'
    voice 'voices/micha_18_13.mp3'

# game/Scenes/Micha/micha18.rpy:197
translate italian micha18_06801be0:

    # mc "I am. So happy."
    mc "Lo sono. Sono felicissima."

# game/Scenes/Micha/micha18.rpy:201
translate italian micha18_d41d8cd9_13:

    # voice 'voices/micha_18_14.mp3'
    voice 'voices/micha_18_14.mp3'

# game/Scenes/Micha/micha18.rpy:202
translate italian micha18_bb0eeaf4:

    # mc "Thank you."
    mc "Grazie."

# game/Scenes/Micha/micha18.rpy:204
translate italian micha18_d41d8cd9_14:

    # voice 'voices/micha_18_15.mp3'
    voice 'voices/micha_18_15.mp3'

# game/Scenes/Micha/micha18.rpy:205
translate italian micha18_4d562fad:

    # mc "Even if we are not together forever. You have changed me."
    mc "Anche se non staremo insieme per sempre. Mi hai cambiata."

# game/Scenes/Micha/micha18.rpy:207
translate italian micha18_d41d8cd9_15:

    # voice 'voices/micha_18_16.mp3'
    voice 'voices/micha_18_16.mp3'

# game/Scenes/Micha/micha18.rpy:208
translate italian micha18_4a1f6929:

    # mc "I am better because of you."
    mc "Sono una persona migliore grazie a te."

# game/Scenes/Micha/micha18.rpy:211
translate italian micha18_b3c8f504:

    # "We stay there for a while, until it's time for her to get back to her dorm and for me to get back home."
