# game/Scenes/Update20/u20j.rpy:2
translate italian u20j_be7d1e50:

    # "For now, I should go see Adrian."
    "Per ora, dovrei andare a trovare Adrian."

# game/Scenes/Update20/u20j.rpy:5
translate italian u20j_33260fe1:

    # "I drive over to Adrian's house and ring the doorbell."
    "Guido fino a casa di Adrian e suono il campanello."

# game/Scenes/Update20/u20j.rpy:6
translate italian u20j_4fc89239:

    # "It's late and I hate to wake her, but I need to see her."
    "È tardi e mi dispiace svegliarla, ma ho bisogno di vederla."

# game/Scenes/Update20/u20j.rpy:9
translate italian u20j_494a3331:

    # "Adrian's Mom" "Hello? Do you know how late it is?"
    "Adrian's Mom" "Ehi? Sai che ora è?"

# game/Scenes/Update20/u20j.rpy:10
translate italian u20j_7d43c485:

    # pc "I'm sorry, I know. I'm a friend of Adrian's."
    pc "Mi dispiace, lo so. Sono un'amica di Adrian."

# game/Scenes/Update20/u20j.rpy:11
translate italian u20j_87309e2a:

    # pc "Could I talk to her, please?"
    pc "Potrei parlare con lei, per favore?"

# game/Scenes/Update20/u20j.rpy:12
translate italian u20j_ad012933:

    # "Adrian's Mom" "Oh, are you [pcname]? She's been worried about you for weeks."
    "Adrian's Mom" "Oh, sei [pcname]? Sono settimane che è preoccupata per te."

# game/Scenes/Update20/u20j.rpy:13
translate italian u20j_332de7e5:

    # pc "Yes, I'm sorry. That's me."
    pc "Sì, mi dispiace. Sono proprio io."

# game/Scenes/Update20/u20j.rpy:16
translate italian u20j_1a0d366a:

    # "Adrian's Mom" "She's going to be really happy to see you."
    "Adrian's Mom" "Sarà davvero felice di vederti."

# game/Scenes/Update20/u20j.rpy:17
translate italian u20j_1108c1b8:

    # "Adrian's Mom" "You can go up and see her, just keep things PG, okay?"
    "Adrian's Mom" "Puoi salire a trovarla, ma comportati bene, ok?"

# game/Scenes/Update20/u20j.rpy:18
translate italian u20j_e170ff6c:

    # pc "Yes, ma'am. Thank you."
    pc "Sì, signora. Grazie."

# game/Scenes/Update20/u20j.rpy:22
translate italian u20j_f5638052:

    # "I walk quietly up the stairs and into Adrian's room. She's in bed, sleeping."
    "Salgo silenziosamente le scale ed entro nella stanza di Adrian. È a letto, che dorme."

# game/Scenes/Update20/u20j.rpy:25
translate italian u20j_cbba5bfa:

    # "Trying not to wake her immediately, I lie next to her and wrap my arms around her."
    "Cercando di non svegliarla subito, mi sdraio accanto a lei e la stringo tra le braccia."

# game/Scenes/Update20/u20j.rpy:28
translate italian u20j_c981bd85:

    # "She jolts awake and looks at me, shocked."
    "Si sveglia di soprassalto e mi guarda, scioccata."

# game/Scenes/Update20/u20j.rpy:29
translate italian u20j_a857ee55:

    # gg "What the fuck? [pcname]?"
    gg "Ma che cazzo? [pcname]?"

# game/Scenes/Update20/u20j.rpy:32
translate italian u20j_0f0952fe:

    # "I don't answer. I just pull her close and kiss her deeply."
    "Non rispondo. La stringo forte a me e la bacio appassionatamente."

# game/Scenes/Update20/u20j.rpy:33
translate italian u20j_09b23034:

    # gg "Fuck, I was so worried about you. I thought you weren't ever coming back."
    gg "Cazzo, ero così preoccupata per te. Pensavo che non saresti mai tornato."

# game/Scenes/Update20/u20j.rpy:36
translate italian u20j_b1adfb65:

    # gg "So you went to another world, for real?"
    gg "Quindi sei andato davvero in un altro mondo?"

# game/Scenes/Update20/u20j.rpy:37
translate italian u20j_e5f2498c:

    # pc "Yeah, I did."
    pc "Sì, ci sono andato."

# game/Scenes/Update20/u20j.rpy:38
translate italian u20j_29a8b357:

    # gg "And you saw your dad?"
    gg "E hai visto tuo padre?"

# game/Scenes/Update20/u20j.rpy:39
translate italian u20j_c417e350:

    # pc "Yeah."
    pc "Sì."

# game/Scenes/Update20/u20j.rpy:40
translate italian u20j_fa6e7016:

    # gg "You have to tell me everything."
    gg "Devi raccontarmi tutto."

# game/Scenes/Update20/u20j.rpy:41
translate italian u20j_0bb899f2:

    # pc "I will, I promise. Tomorrow."
    pc "Lo farò, te lo prometto. Domani."

# game/Scenes/Update20/u20j.rpy:44
translate italian u20j_92c42e64:

    # gg "Right. Tomorrow. I'm just glad you're back!"
    gg "Va bene. Domani. Sono solo felice che tu sia tornato!"

# game/Scenes/Update20/u20j.rpy:45
translate italian u20j_d2639c3b:

    # gg "I can't believe you're back."
    gg "Non riesco a credere che tu sia tornato."

# game/Scenes/Update20/u20j.rpy:46
translate italian u20j_c01c395d:

    # gg "I'm so happy, I can't stand it."
    gg "Sono così felice che non lo sopporto."

# game/Scenes/Update20/u20j.rpy:49
translate italian u20j_f432b969:

    # "I pull her close and kiss her again, feeling her warmth."
    "La stringo a me e la bacio di nuovo, sentendo il suo calore."

# game/Scenes/Update20/u20j.rpy:50
translate italian u20j_bf4f63bf:

    # gg "Good idea. Shut me up with your mouth."
    gg "Ottima idea. Zittiscimi con la tua bocca."

# game/Scenes/Update20/u20j.rpy:51
translate italian u20j_1530bf0e:

    # gg "I just missed you so much."
    gg "Mi sei mancato tantissimo."

# game/Scenes/Update20/u20j.rpy:52
translate italian u20j_9c24a5ca:

    # pc "I missed you too, Adrian."
    pc "Anche tu mi sei mancato, Adrian."

