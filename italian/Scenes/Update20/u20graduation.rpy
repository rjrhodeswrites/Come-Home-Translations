# game/Scenes/Update20/u20graduation.rpy:4
translate italian graduation_fcda8f21:

    # "That weekend, the time has come. I'm finally going to graduate."
    "Quel fine settimana, è arrivato il momento. Finalmente mi laureerò."

# game/Scenes/Update20/u20graduation.rpy:7
translate italian graduation_9322fbe2:

    # "I'm pretty nervous. Not for the walking across the stage, but for what comes after."
    "Sono piuttosto nervosa. Non per il momento in cui salirò sul palco, ma per quello che verrà dopo."

# game/Scenes/Update20/u20graduation.rpy:8
translate italian graduation_b5eb6fe8:

    # "I'm going to have to make a lot of decisions."
    "Dovrò prendere un sacco di decisioni."

# game/Scenes/Update20/u20graduation.rpy:9
translate italian graduation_3c7f2f57:

    # "What career path I'm going to take."
    "Quale percorso professionale intraprenderò."

# game/Scenes/Update20/u20graduation.rpy:10
translate italian graduation_292aaa1a:

    # "Where I'm going to live."
    "Dove andrò a vivere."

# game/Scenes/Update20/u20graduation.rpy:11
translate italian graduation_6f7a21ba:

    # "And most importantly..."
    "E, cosa più importante..."

# game/Scenes/Update20/u20graduation.rpy:12
translate italian graduation_6dec3447:

    # "... who I'm going to be with."
    "... con chi starò."

# game/Scenes/Update20/u20graduation.rpy:15
translate italian graduation_bb5d5c1b:

    # "I see Jamie graduate. She looks so happy. Her dad cheers for her in the audience."
    "Vedo Jamie laurearsi. Sembra così felice. Suo padre la incita tra il pubblico."

# game/Scenes/Update20/u20graduation.rpy:16
translate italian graduation_ddb94435:

    # "I wonder who is here to cheer for me."
    "Mi chiedo chi sia qui a tifare per me."

# game/Scenes/Update20/u20graduation.rpy:19
translate italian graduation_c59ac221:

    # "When it's my turn, I walk across the stage to take my diploma."
    "Quando arriva il mio turno, attraverso il palco per ritirare il mio diploma."

# game/Scenes/Update20/u20graduation.rpy:21
translate italian graduation_43c2c1fd:

    # "I hear a roar of applause and cheering from the crowd."
    "Sento un boato di applausi e urla di incoraggiamento dalla folla."

# game/Scenes/Update20/u20graduation.rpy:23
translate italian graduation_ba624ddd:

    # "I hear people in the audience applauding and cheering for me."
    "Sento le persone tra il pubblico che applaudono e tifano per me."

# game/Scenes/Update20/u20graduation.rpy:25
translate italian graduation_50c87cd2:

    # "I hear a few claps and cheers from the audience."
    "Sento qualche applauso e qualche urlo di incoraggiamento dal pubblico."

# game/Scenes/Update20/u20graduation.rpy:27
translate italian graduation_dc5c5344:

    # "The audience is embarrassingly quiet. I don't hear anybody cheering for me."
    "Il pubblico è imbarazzantemente silenzioso. Non sento nessuno che tifa per me."

# game/Scenes/Update20/u20graduation.rpy:65
translate italian graduation_a1216c7c:

    # "I look out and see my cheering section in the audience and give them a wave."
    "Mi guardo intorno e vedo la mia sezione di tifosi tra il pubblico e li saluto con la mano."

# game/Scenes/Update20/u20graduation.rpy:68
translate italian graduation_379ce65b:

    # "The dean shakes my hand and gives me my diploma."
    "Il preside mi stringe la mano e mi consegna il diploma."

# game/Scenes/Update20/u20graduation.rpy:69
translate italian graduation_185e2b9c:

    # "I don't think I've ever met him before, but he looks so familiar."
    "Non credo di averlo mai incontrato prima, ma mi sembra così familiare."

# game/Scenes/Update20/u20graduation.rpy:72
translate italian graduation_48469141:

    # "I can't believe I did it. Even with all the other things going on..."
    "Non riesco a credere di avercela fatta. Nonostante tutto quello che è successo..."

# game/Scenes/Update20/u20graduation.rpy:73
translate italian graduation_ca6a8913:

    # "... I graduated college."
    "... mi sono laureato."

# game/Scenes/Update20/u20graduation.rpy:74
translate italian graduation_464c98b1:

    # "It's a huge accomplishment."
    "È un risultato straordinario."

# game/Scenes/Update20/u20graduation.rpy:75
translate italian graduation_9194429e:

    # "But now the real challenge begins. I have to live the rest of my life."
    "Ma ora inizia la vera sfida. Devo vivere il resto della mia vita."

# game/Scenes/Update20/u20graduation.rpy:79
translate italian graduation_88f825fa:

    # "And I have to make a choice."
    "E devo fare una scelta."

# game/Scenes/Update20/u20graduation.rpy:80
translate italian graduation_35304928:

    # "After the ceremony finishes, I'm approached by people who want to congratulate me."
    "Al termine della cerimonia, vengo avvicinato da persone che vogliono congratularsi con me."

# game/Scenes/Update20/u20graduation.rpy:86
translate italian graduation_1b8bc31b:

    # sp "I'm so proud of you, [pcname]."
    sp "Sono così orgoglioso di te, [pcname]."

# game/Scenes/Update20/u20graduation.rpy:87
translate italian graduation_edf6ed48:

    # sp "I know your father would be too."
    sp "So che lo sarebbe anche tuo padre."

# game/Scenes/Update20/u20graduation.rpy:91
translate italian graduation_ac0c2fb4:

    # ss "Wow, [bro]. You actually graduated!"
    ss "Wow, [bro]. Ti sei davvero laureato!"

# game/Scenes/Update20/u20graduation.rpy:92
translate italian graduation_c8fc7fac:

    # ss "I'm so proud of you!"
    ss "Sono così orgoglioso di te!"

# game/Scenes/Update20/u20graduation.rpy:93
translate italian graduation_e7a915a9:

    # tm "Yeah, good job [pcname]! Glad you didn't lose too many brain cells in the ring with me."
    tm "Sì, ben fatto [pcname]! Sono contento che tu non abbia perso troppi neuroni sul ring con me."

# game/Scenes/Update20/u20graduation.rpy:97
translate italian graduation_c04f8b26:

    # cw "Congratulations, [pcname]. I knew you could do it. You're so smart."
    cw "Congratulazioni, [pcname]. Sapevo che ce l’avresti fatta. Sei così intelligente."

# game/Scenes/Update20/u20graduation.rpy:101
translate italian graduation_329f830b:

    # bs "Congratulations, [fuckboy]. Always knew you were smarter than you looked."
    bs "Congratulazioni, [fuckboy]. Ho sempre saputo che eri più intelligente di quanto sembrassi."

# game/Scenes/Update20/u20graduation.rpy:102
translate italian graduation_f878f94a:

    # pc "Thanks, Mrs. Mills. Are you going to stay to celebrate?"
    pc "Grazie, signora Mills. Rimarrai a festeggiare?"

# game/Scenes/Update20/u20graduation.rpy:105
translate italian graduation_3becdb7b:

    # bs "Nah, that's not for me. You have fun though."
    bs "No, non fa per me. Divertiti lo stesso, però."

# game/Scenes/Update20/u20graduation.rpy:106
translate italian graduation_2d81c45d:

    # bs "Seriously... I'm proud of you and I hope you get everything you want out of life."
    bs "Sul serio... sono orgogliosa di te e spero che tu ottenga tutto ciò che desideri dalla vita."

# game/Scenes/Update20/u20graduation.rpy:107
translate italian graduation_4bd7bc94:

    # bs "Bye, [pcname]."
    bs "Ciao, [pcname]."

# game/Scenes/Update20/u20graduation.rpy:112
translate italian graduation_d62fed7f:

    # gnd "Can you believe we actually did it?"
    gnd "Riesci a credere che ce l’abbiamo davvero fatta?"

# game/Scenes/Update20/u20graduation.rpy:113
translate italian graduation_7af6eec9:

    # pc "Barely."
    pc "A malapena."

# game/Scenes/Update20/u20graduation.rpy:114
translate italian graduation_70db59f2:

    # gnd "Thanks for all your help. I'm happy I get to walk across the stage with my best friend."
    gnd "Grazie per tutto il tuo aiuto. Sono felice di poter attraversare il palco con la mia migliore amica."

# game/Scenes/Update20/u20graduation.rpy:118
translate italian graduation_574568d3:

    # fr "Wow, [pcname]! You're a college graduate now!"
    fr "Wow, [pcname]! Ora sei una laureata!"

# game/Scenes/Update20/u20graduation.rpy:119
translate italian graduation_d4964952:

    # fr "I'm so proud of you!"
    fr "Sono così orgogliosa di te!"

# game/Scenes/Update20/u20graduation.rpy:123
translate italian graduation_81a7f5e2:

    # et "Congratulations, [pcname]. You did a great job this year."
    et "Congratulazioni, [pcname]. Hai fatto un ottimo lavoro quest’anno."

# game/Scenes/Update20/u20graduation.rpy:124
translate italian graduation_2ff53a2d:

    # mrmg "Yeah, Edie and I are both very proud of you."
    mrmg "Sì, sia io che Edie siamo molto orgogliosi di te."

# game/Scenes/Update20/u20graduation.rpy:125
translate italian graduation_046748d2:

    # pc "Thanks, you two."
    pc "Grazie, voi due."

# game/Scenes/Update20/u20graduation.rpy:128
translate italian graduation_f61c3028:

    # mrmg "We're going to take off, but if you ever want to come by, feel free."
    mrmg "Stiamo per partire, ma se mai volessi passare a trovarci, sentiti libero di farlo."

# game/Scenes/Update20/u20graduation.rpy:129
translate italian graduation_d3a78723:

    # et "Bye, [pcname]. I hope to see you again soon."
    et "Ciao, [pcname]. Spero di rivederti presto."

# game/Scenes/Update20/u20graduation.rpy:134
translate italian graduation_bece76e0:

    # bn "Congratulations, [pcname]! I'm happy that you were able to make it."
    bn "Congratulazioni, [pcname]! Sono felice che tu ce l’abbia fatta."

# game/Scenes/Update20/u20graduation.rpy:135
translate italian graduation_73f0d30c:

    # pc "Not sure I could have done it without some help on those essays."
    pc "Non so se ce l’avrei fatta senza un po’ di aiuto con quei saggi."

# game/Scenes/Update20/u20graduation.rpy:136
translate italian graduation_a995bba0:

    # bn "You really have improved a lot since then. I'm glad I could help."
    bn "Sei davvero migliorato tantissimo da allora. Sono contento di averti aiutato."

# game/Scenes/Update20/u20graduation.rpy:140
translate italian graduation_7379e0ab:

    # gl "Damn, Twig! You a college graduate now!"
    gl "Cavolo, Twig! Ora sei un laureato!"

# game/Scenes/Update20/u20graduation.rpy:141
translate italian graduation_4d0b6de5:

    # gl "That's pretty fuckin cool. Good job, man."
    gl "È davvero fottutamente fantastico. Ottimo lavoro, amico."

# game/Scenes/Update20/u20graduation.rpy:145
translate italian graduation_c1d7fd4b:

    # sg "Wow, congratulations! I knew you could do it."
    sg "Wow, congratulazioni! Sapevo che ce l’avresti fatta."

# game/Scenes/Update20/u20graduation.rpy:146
translate italian graduation_0cde929c:

    # sg "My [kdaddy] is super smart."
    sg "Il mio [kdaddy] è super intelligente."

# game/Scenes/Update20/u20graduation.rpy:150
translate italian graduation_25ea1d82:

    # gg "Good job [pcname]! I'm really proud of you."
    gg "Ottimo lavoro [pcname]! Sono davvero orgoglioso di te."

# game/Scenes/Update20/u20graduation.rpy:154
translate italian graduation_9bb0179c:

    # sst "Congratulations, [pcname]. I've seen how bright you are and I know you'll accomplish big things."
    sst "Congratulazioni, [pcname]. Ho visto quanto sei brillante e so che realizzerai grandi cose."

# game/Scenes/Update20/u20graduation.rpy:155
translate italian graduation_cf39cc04:

    # sst "Plus... I'm not your teacher anymore, so I'm looking forward to spending a {i}lot{/i} more time with you."
    sst "Inoltre... non sono più il tuo insegnante, quindi non vedo l’ora di passare {i}molto{/i} più tempo con te."

# game/Scenes/Update20/u20graduation.rpy:159
translate italian graduation_7758b810:

    # fd "Congratulations, [pcname]! What a big accomplishment."
    fd "Congratulazioni, [pcname]! Che grande risultato."

# game/Scenes/Update20/u20graduation.rpy:160
translate italian graduation_e2fac1f5:

    # fd "So proud of you."
    fd "Sono così orgogliosa di te."

# game/Scenes/Update20/u20graduation.rpy:164
