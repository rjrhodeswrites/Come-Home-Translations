    # rb "Dang, [pcname]! You graduated!"
    rb "Cavolo, [pcname]! Ti sei diplomato!"

# game/Scenes/Update20/u20graduation.rpy:165
translate italian graduation_193230c7:

    # rb "I'm super proud of you. I hope I can do that one day too."
    rb "Sono super orgogliosa di te. Spero di poterlo fare anch’io un giorno."

# game/Scenes/Update20/u20graduation.rpy:169
translate italian graduation_3f04f91d:

    # wt "Congratulations, [pcname]. Now the real work begins."
    wt "Congratulazioni, [pcname]. Ora inizia il vero lavoro."

# game/Scenes/Update20/u20graduation.rpy:173
translate italian graduation_99a6a955:

    # bai "Congratulations, [pcname]! I'm very proud of you."
    bai "Congratulazioni, [pcname]! Sono molto orgogliosa di te."

# game/Scenes/Update20/u20graduation.rpy:177
translate italian graduation_098f36f3:

    # det "Good job, [pcname]. I'm so proud of you."
    det "Ottimo lavoro, [pcname]. Sono così orgogliosa di te."

# game/Scenes/Update20/u20graduation.rpy:178
translate italian graduation_ce2f89e3:

    # det "Plus, now I don't have to feel weird anymore about dating a guy who is still in school."
    det "Inoltre, ora non devo più sentirmi a disagio all’idea di uscire con un ragazzo che frequenta ancora la scuola."

# game/Scenes/Update20/u20graduation.rpy:182
translate italian graduation_1af6aa31:

    # mc "Congratulations, [pcname]. You have made a huge accomplishment today."
    mc "Congratulazioni, [pcname]. Oggi hai raggiunto un traguardo straordinario."

# game/Scenes/Update20/u20graduation.rpy:183
translate italian graduation_8189962e:

    # mc "Just one more step on a long and successful life."
    mc "Solo un altro passo verso una vita lunga e piena di successi."

# game/Scenes/Update20/u20graduation.rpy:184
translate italian graduation_e019ba6d:

    # mc "Oh I also wanted to tell you that Mrs. Spann has taken care of things. I do not have to go back to Korea until at least next year."
    mc "Oh, volevo anche dirti che la signora Spann si è occupata di tutto. Non dovrò tornare in Corea almeno fino al prossimo anno."

# game/Scenes/Update20/u20graduation.rpy:185
translate italian graduation_e73708a0:

    # pc "That's great!"
    pc "È fantastico!"

# game/Scenes/Update20/u20graduation.rpy:186
translate italian graduation_aea2d457:

    # mc "Yes, I am very happy. I wanted you to know before you make your choice."
    mc "Sì, sono molto felice. Volevo che lo sapessi prima di prendere la tua decisione."

# game/Scenes/Update20/u20graduation.rpy:190
translate italian graduation_3251ea55:

    # sc "Congratulations, [pcname]. I knew you could do it."
    sc "Congratulazioni, [pcname]. Sapevo che ce l’avresti fatta."

# game/Scenes/Update20/u20graduation.rpy:191
translate italian graduation_5ef55c33:

    # pc "Thanks, Gertrude. Are you going to stay to celebrate?"
    pc "Grazie, Gertrude. Rimarrai a festeggiare?"

# game/Scenes/Update20/u20graduation.rpy:194
translate italian graduation_d43e5efb:

    # sc "I'm sorry, but no. I hope you have a great time though."
    sc "Mi dispiace, ma no. Spero comunque che ti diverta un mondo."

# game/Scenes/Update20/u20graduation.rpy:195
translate italian graduation_1d485803:

    # sc "I'm actually going to be leaving soon."
    sc "In realtà me ne andrò presto."

# game/Scenes/Update20/u20graduation.rpy:196
translate italian graduation_0d75ddc6:

    # pc "Leaving?"
    pc "Te ne vai?"

# game/Scenes/Update20/u20graduation.rpy:197
translate italian graduation_5aba87b6:

    # sc "Yes, I'm going on a bit of a journey. But I'll keep in touch, I promise."
    sc "Sì, partirò per un piccolo viaggio. Ma mi terrò in contatto, te lo prometto."

# game/Scenes/Update20/u20graduation.rpy:200
translate italian graduation_aaca6d60:

    # pc "Well, good luck. I hope you find what you're looking for... and I'll miss you."
    pc "Beh, buona fortuna. Spero che tu trovi quello che stai cercando... e mi mancherai."

# game/Scenes/Update20/u20graduation.rpy:201
