# game/Scenes/Update20/u20n.rpy:2
translate italian u20n_0157cb27:

    # "For now, I should go see Bai."
    "Per ora, dovrei andare a trovare Bai."

# game/Scenes/Update20/u20n.rpy:5
translate italian u20n_5e377e6b:

    # "I drive to Bai's apartment and knock on the door."
    "Guido fino all’appartamento di Bai e busso alla porta."

# game/Scenes/Update20/u20n.rpy:6
translate italian u20n_cd826cbc:

    # "It's late, but I have to see him."
    "È tardi, ma devo vederlo."

# game/Scenes/Update20/u20n.rpy:10
translate italian u20n_435415c3:

    # "After a few moments, Bai opens the door."
    "Dopo qualche istante, Bai apre la porta."

# game/Scenes/Update20/u20n.rpy:11
translate italian u20n_fce568f9:

    # bai "Holy shit, [pcname]! You're back!"
    bai "Porca miseria, [pcname]! Sei tornata!"

# game/Scenes/Update20/u20n.rpy:14
translate italian u20n_7e7c2a33:

    # "I wrap my arms around Bai, pulling him in tight."
    "Abbraccio Bai, stringendolo forte a me."

# game/Scenes/Update20/u20n.rpy:15
translate italian u20n_e660f3f5:

    # bai "I thought that machine killed you!"
    bai "Pensavo che quella macchina ti avesse ucciso!"

# game/Scenes/Update20/u20n.rpy:16
translate italian u20n_52e92c2d:

    # bai "I thought I might never see you again."
    bai "Pensavo che non ti avrei mai più rivisto."

# game/Scenes/Update20/u20n.rpy:19
translate italian u20n_e99c4913:

    # bai "So what happened? Did you really go to another universe?"
    bai "Allora, cos’è successo? Sei davvero andato in un altro universo?"

# game/Scenes/Update20/u20n.rpy:20
translate italian u20n_4859fa2f:

    # pc "Yeah, I did. I saw my dad."
    pc "Sì, ci sono andato. Ho visto mio padre."

# game/Scenes/Update20/u20n.rpy:21
translate italian u20n_d8ec5a44:

    # bai "Wow. Are you okay?"
    bai "Wow. Stai bene?"

# game/Scenes/Update20/u20n.rpy:22
translate italian u20n_3c3fa8e3:

    # pc "Yeah, I'm great. I'll tell you everything tomorrow, I promise."
    pc "Sì, sto benissimo. Domani ti racconterò tutto, te lo prometto."

# game/Scenes/Update20/u20n.rpy:25
translate italian u20n_feac206a:

    # bai "I'm just glad you're back."
    bai "Sono solo felice che tu sia tornato."

# game/Scenes/Update20/u20n.rpy:26
translate italian u20n_03eaad50:

    # pc "Me too."
    pc "Anch’io."

# game/Scenes/Update20/u20n.rpy:29
translate italian u20n_61ae245c:

    # "He leans in and kisses me softly."
    "Si avvicina e mi bacia dolcemente."

# game/Scenes/Update20/u20n.rpy:30
translate italian u20n_8466d1ae:

    # bai "Whoo, damn, you smell pretty bad though."
    bai "Cavolo, però puzzi parecchio."

# game/Scenes/Update20/u20n.rpy:31
translate italian u20n_dfccd340:

    # bai "Let's take a shower and go to bed."
    bai "Facciamoci una doccia e andiamo a letto."

