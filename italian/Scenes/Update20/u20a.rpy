    # wt "Juliana has been after me every day."
    wt "Juliana mi sta dando la corda ogni giorno."

# game/Scenes/Update20/u20a.rpy:54
translate italian u20a_9dc19f81_3:

    # wt "She's really not happy with me and she really misses you."
    wt "È davvero arrabbiata con me e le manchi tantissimo."

# game/Scenes/Update20/u20a.rpy:55
translate italian u20a_ddfe6239:

    # wt "I've done everything I could to keep her from telling anybody else about it."
    wt "Ho fatto tutto il possibile per impedirle di dirlo a qualcun altro."

# game/Scenes/Update20/u20a.rpy:59
translate italian u20a_8e83980e:

    # wt "Izzy has been after me every day."
    wt "Izzy mi sta dando la caccia ogni giorno."

# game/Scenes/Update20/u20a.rpy:60
translate italian u20a_531c13bb:

    # wt "She's really angry with me. Did you know she has a gang? There have been some threats."
    wt "È davvero arrabbiata con me. Lo sapevi che ha una banda? Ci sono state alcune minacce."

# game/Scenes/Update20/u20a.rpy:61
translate italian u20a_09720660:

    # wt "I've done everything I could to keep her from doing anything drastic."
    wt "Ho fatto tutto il possibile per impedirle di compiere gesti estremi."

# game/Scenes/Update20/u20a.rpy:65
translate italian u20a_a7898338:

    # wt "Kendra has been really upset with me."
    wt "Kendra è davvero arrabbiata con me."

# game/Scenes/Update20/u20a.rpy:66
translate italian u20a_2c6742f7:

    # wt "She hasn't told the police yet, but I think she would soon."
    wt "Non l’ha ancora detto alla polizia, ma penso che lo farà presto."

# game/Scenes/Update20/u20a.rpy:67
translate italian u20a_1baaa415:

    # wt "She'll be very happy to see you back home."
    wt "Sarà felicissima di vederti tornare a casa."

# game/Scenes/Update20/u20a.rpy:71
translate italian u20a_009b3a35:

    # wt "Adrian has been asking every day for me to send her in after you."
    wt "Adrian mi chiede ogni giorno di mandarla a cercarti."

# game/Scenes/Update20/u20a.rpy:72
translate italian u20a_4a9286c6:

    # wt "I might have too. Although, it seems like an endless chain at this point. I send you after your father, then her after you. Who would I have to send after her?"
    wt "Forse dovrei farlo anch’io. Anche se, a questo punto, sembra una catena senza fine. Mando te a cercare tuo padre, poi lei a cercare te. Chi dovrei mandare a cercare lei?"

# game/Scenes/Update20/u20a.rpy:76
translate italian u20a_85722b6f:

    # wt "Your friend Nora has been quite a handful. She's very angry with me."
    wt "La tua amica Nora mi sta dando un bel po’ di filo da torcere. È molto arrabbiata con me."

# game/Scenes/Update20/u20a.rpy:77
translate italian u20a_29032600:

    # wt "She's threatened with everything from the police and lawsuits to physical harm."
    wt "Ha minacciato di tutto, dalla polizia alle cause legali fino alle aggressioni fisiche."

# game/Scenes/Update20/u20a.rpy:78
translate italian u20a_ad9edb7c:

    # wt "So far I've been able to keep her from doing anything drastic, but I'm really glad you're back. Things could have gotten really bad."
    wt "Finora sono riuscita a impedirle di fare qualcosa di drastico, ma sono davvero contenta che tu sia tornato. Le cose avrebbero potuto mettersi davvero male."

# game/Scenes/Update20/u20a.rpy:82
translate italian u20a_961fd311:

    # wt "Brandi has been after me every day. I don't think I could hold her off from calling the police for much longer."
    wt "Brandi mi sta dando la caccia ogni giorno. Non credo di riuscire a impedirle di chiamare la polizia ancora per molto."

# game/Scenes/Update20/u20a.rpy:83
translate italian u20a_9dc19f81_4:

    # wt "She's really not happy with me and she really misses you."
    wt "È davvero arrabbiata con me e le manchi tantissimo."

# game/Scenes/Update20/u20a.rpy:87
translate italian u20a_188c6ab6:

    # wt "Reba has been after me every day. She's been threatening to quote \"Whoop my butt.\""
    wt "Reba mi sta dando la caccia ogni giorno. Minaccia di, cito testualmente, “darmi una bella lezione”."

# game/Scenes/Update20/u20a.rpy:88
translate italian u20a_9dc19f81_5:

    # wt "She's really not happy with me and she really misses you."
    wt "È davvero arrabbiata con me e le manchi tantissimo."

# game/Scenes/Update20/u20a.rpy:92
translate italian u20a_129be4b0:

    # wt "Nobody's tracked you down to here yet, but I knew it was only a matter of time."
    wt "Nessuno ti ha ancora rintracciato fin qui, ma sapevo che fosse solo questione di tempo."

# game/Scenes/Update20/u20a.rpy:93
translate italian u20a_ab459ea2:

    # wt "I'm really glad you made it back."
    wt "Sono davvero felice che tu sia tornato."

# game/Scenes/Update20/u20a.rpy:97
translate italian u20a_ecc127cf:

    # wt "Bai has been after me every day. I don't think I could hold him off from calling the police for much longer."
    wt "Bai mi sta dando la caccia ogni giorno. Non credo di riuscire a impedirgli di chiamare la polizia ancora per molto."

# game/Scenes/Update20/u20a.rpy:98
translate italian u20a_aad92e9b:

    # wt "He's really not happy with me and he really misses you."
    wt "È davvero arrabbiato con me e gli manchi tantissimo."

# game/Scenes/Update20/u20a.rpy:102
translate italian u20a_a080881c:

    # wt "Jez has been after me every day. You didn't tell me that she was a cop."
    wt "Jez mi sta dando la caccia ogni giorno. Non mi avevi detto che fosse una poliziotta."

# game/Scenes/Update20/u20a.rpy:103
translate italian u20a_3a528bbc:

    # wt "She's been threatening to put me in prison for murdering you and your father with my \"crazy machines\"."
    wt "Mi sta minacciando di mandarmi in prigione per aver ucciso te e tuo padre con le mie “macchine folli”."

# game/Scenes/Update20/u20a.rpy:104
translate italian u20a_9dc19f81_6:

    # wt "She's really not happy with me and she really misses you."
    wt "È davvero arrabbiata con me e le manchi tantissimo."

# game/Scenes/Update20/u20a.rpy:108
translate italian u20a_97329d78:

    # wt "Mi-Cha has been after me every day. I don't think I could hold her off from calling the police for much longer."
    wt "Mi-Cha mi sta dando la caccia ogni giorno. Non credo di riuscire a impedirle di chiamare la polizia ancora per molto."

# game/Scenes/Update20/u20a.rpy:109
translate italian u20a_9dc19f81_7:

    # wt "She's really not happy with me and she really misses you."
    wt "È davvero arrabbiata con me e le manchi tantissimo."

# game/Scenes/Update20/u20a.rpy:113
translate italian u20a_69f192ed:

    # wt "Can I get a hug or something? I've missed you."
    wt "Posso avere un abbraccio o qualcosa del genere? Mi sei mancata."

# game/Scenes/Update20/u20a.rpy:116
translate italian u20a_20a98a8a:

    # wt "I'm so glad that you're safe."
    wt "Sono così felice che tu stia bene."

# game/Scenes/Update20/u20a.rpy:117
translate italian u20a_e2431baa:

    # pc "Me too. Thanks for all your help, Whitney."
    pc "Anch’io. Grazie per tutto il tuo aiuto, Whitney."

# game/Scenes/Update20/u20a.rpy:120
translate italian u20a_b931c84d:

    # wt "Your car and your cell phone are still here. I hid them out back."
    wt "La tua auto e il tuo cellulare sono ancora qui. Li ho nascosti sul retro."

# game/Scenes/Update20/u20a.rpy:121
translate italian u20a_167b4558:

    # wt "You should go home and notify everyone that you are safe."
    wt "Dovresti andare a casa e far sapere a tutti che stai bene."

# game/Scenes/Update20/u20a.rpy:122
translate italian u20a_bab6484a:

    # pc "Yeah, I suppose you're right."
    pc "Sì, immagino tu abbia ragione."

# game/Scenes/Update20/u20a.rpy:124
translate italian u20a_9672a6f0:

    # wt "But I'll want you to fill me in on everything as soon as you're able. I have many questions."
    wt "Ma vorrei che mi raccontassi tutto non appena possibile. Ho tante domande."

# game/Scenes/Update20/u20a.rpy:125
translate italian u20a_a248948f:

    # pc "Of course."
    pc "Certo."

# game/Scenes/Update20/u20a.rpy:128
translate italian u20a_1c0aff07:

    # "I swap into my old clothes, get my phone and my car and leave Whitney's."
    "Mi cambio, indosso i miei vecchi vestiti, prendo il telefono e la macchina e me ne vado da Whitney."

# game/Scenes/Update20/u20a.rpy:129
translate italian u20a_b8c37593:

    # "The phone is dead. I'll have to charge it before calling anyone tomorrow."
    "Il telefono è scarico. Dovrò ricaricarlo prima di chiamare qualcuno domani."

