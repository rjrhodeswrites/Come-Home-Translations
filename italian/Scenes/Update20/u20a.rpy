# game/Scenes/Update20/u20a.rpy:7
translate italian u20a_744243a9:

    # "It's Whitney's laboratory, but it's dark and quiet."
    "È il laboratorio di Whitney, ma è buio e silenzioso."

# game/Scenes/Update20/u20a.rpy:8
translate italian u20a_730217b4:

    # "I hope that I'm in the right world. I hope that nothing bad has happened."
    "Spero di essere nel mondo giusto. Spero che non sia successo nulla di grave."

# game/Scenes/Update20/u20a.rpy:11
translate italian u20a_96c9481d:

    # "Then the lights kick on and the door opens."
    "Poi le luci si accendono e la porta si apre."

# game/Scenes/Update20/u20a.rpy:14
translate italian u20a_45da60e7:

    # wt "Finally, you're back. Took you long enough."
    wt "Finalmente sei tornato. Ci hai messo un bel po’."

# game/Scenes/Update20/u20a.rpy:15
translate italian u20a_fd9e8f88:

    # wt "I really thought I might be going to jail!"
    wt "Pensavo davvero che sarei finita in prigione!"

# game/Scenes/Update20/u20a.rpy:18
translate italian u20a_a33db221:

    # pc "How long have I been gone?"
    pc "Da quanto tempo sono via?"

# game/Scenes/Update20/u20a.rpy:19
translate italian u20a_e000eef8:

    # wt "Thirty days."
    wt "Trenta giorni."

# game/Scenes/Update20/u20a.rpy:22
translate italian u20a_8d8b1bd7:

    # pc "THIRTY!?"
    pc "TRENTA!?"

# game/Scenes/Update20/u20a.rpy:23
translate italian u20a_d92a0cb0:

    # wt "Yes. It's been a difficult time for me as well."
    wt "Sì. È stato un periodo difficile anche per me."

# game/Scenes/Update20/u20a.rpy:27
translate italian u20a_c77aa2a4:

    # wt "Lisa has been very persistent and is nearing her breaking point. I suspect she may involve the police soon."
    wt "Lisa è stata molto insistente e sta per arrivare al limite. Sospetto che presto potrebbe coinvolgere la polizia."

# game/Scenes/Update20/u20a.rpy:28
translate italian u20a_c1e86e55:

    # wt "She thinks I killed both you and your dad."
    wt "Pensa che io abbia ucciso sia te che tuo padre."

# game/Scenes/Update20/u20a.rpy:32
translate italian u20a_9a9b3000:

    # wt "Suzy and Tammy have been after me every day. I don't think I could hold them off from calling the police for much longer."
    wt "Suzy e Tammy mi stanno dando la caccia ogni giorno. Non credo di riuscire a impedire loro di chiamare la polizia ancora per molto."

# game/Scenes/Update20/u20a.rpy:33
translate italian u20a_24d0649b:

    # wt "They brought in Suzy's mom too, Lisa."
    wt "Hanno coinvolto anche la mamma di Suzy, Lisa."

# game/Scenes/Update20/u20a.rpy:34
translate italian u20a_c0b726db:

    # wt "They are not happy with me. Tammy has threatened me with physical violence. I'd prefer to avoid that."
    wt "Non sono contente di me. Tammy mi ha minacciato di violenza fisica. Preferirei evitarlo."

# game/Scenes/Update20/u20a.rpy:38
translate italian u20a_0904113a:

    # wt "Jamie has been after me every day. I don't think I could hold her off from calling the police for much longer."
    wt "Jamie mi sta dando la caccia ogni giorno. Non credo di riuscire a impedirle di chiamare la polizia ancora per molto."

# game/Scenes/Update20/u20a.rpy:39
translate italian u20a_9dc19f81:

    # wt "She's really not happy with me and she really misses you."
    wt "È davvero arrabbiata con me e le manchi tantissimo."

# game/Scenes/Update20/u20a.rpy:43
