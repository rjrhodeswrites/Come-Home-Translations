translate italian u20e_ee43eaac:

    # "For now, I should go see Dana."
    "Per ora, dovrei andare a trovare Dana."

# game/Scenes/Update20/u20e.rpy:5
translate italian u20e_8200a66a:

    # "I drive over to Dana's apartment and knock on her door."
    "Guido fino all’appartamento di Dana e busso alla sua porta."

# game/Scenes/Update20/u20e.rpy:6
translate italian u20e_4fc89239:

    # "It's late and I hate to wake her, but I need to see her."
    "È tardi e mi dispiace svegliarla, ma ho bisogno di vederla."

# game/Scenes/Update20/u20e.rpy:10
translate italian u20e_92b16112:

    # cw "[pcname]? Oh my God!"
    cw "[pcname]? Oh mio Dio!"

# game/Scenes/Update20/u20e.rpy:13
translate italian u20e_da2e1dbd:

    # "She rushes to me and wraps her arms around me tightly."
    "Si precipita verso di me e mi stringe forte tra le braccia."

# game/Scenes/Update20/u20e.rpy:14
translate italian u20e_140e4956:

    # "I hug her back, feeling her warmth and the softness of her body."
    "La abbraccio a mia volta, sentendo il suo calore e la morbidezza del suo corpo."

# game/Scenes/Update20/u20e.rpy:15
translate italian u20e_ed44c8a5:

    # pc "I missed you."
    pc "Mi sei mancata."

# game/Scenes/Update20/u20e.rpy:18
translate italian u20e_35280183:

    # cw "I missed you too. What happened? I thought that machine killed you."
    cw "Anche tu mi sei mancato. Che cosa è successo? Pensavo che quella macchina ti avesse ucciso."

# game/Scenes/Update20/u20e.rpy:19
translate italian u20e_b4f81641:

    # pc "I'm sorry. I didn't mean to leave for so long."
    pc "Mi dispiace. Non volevo stare via così a lungo."

# game/Scenes/Update20/u20e.rpy:20
translate italian u20e_356f7f42:

    # pc "I'll tell you everything tomorrow, I promise."
    pc "Domani ti racconterò tutto, te lo prometto."

# game/Scenes/Update20/u20e.rpy:23
translate italian u20e_1569fad0:

    # cw "I'm just glad you're back."
    cw "Sono solo felice che tu sia tornato."

# game/Scenes/Update20/u20e.rpy:24
translate italian u20e_634678a9:

    # cw "Wow, your hair grew a lot."
    cw "Wow, ti sono cresciuti tantissimo i capelli."

# game/Scenes/Update20/u20e.rpy:25
translate italian u20e_ab3cf051:

    # cw "It looks awful."
    cw "Sono orribili."

# game/Scenes/Update20/u20e.rpy:28
translate italian u20e_7d64063d:

    # "She kisses me softly, her lips warm and inviting."
    "Mi bacia dolcemente, le sue labbra sono calde e invitanti."

# game/Scenes/Update20/u20e.rpy:29
translate italian u20e_9cf9ef15:

    # cw "But I don't care. You came home."
    cw "Ma non mi importa. Sei tornata a casa."

# game/Scenes/Update20/u20e.rpy:30
translate italian u20e_ad7289ff:

    # cw "I missed you so much, [pcname]."
    cw "Mi sei mancata tantissimo, [pcname]."

# game/Scenes/Update20/u20e.rpy:31
translate italian u20e_0ea8f604:

    # cw "Let's go to bed. We can talk in the morning."
    cw "Andiamo a letto. Possiamo parlare domani mattina."

