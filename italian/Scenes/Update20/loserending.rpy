# game/Scenes/Update20/loserending.rpy:20
translate italian loser_ending_4d4aa8f2:

    # "Maybe I'll find somebody to love one day."
    "Forse un giorno troverò qualcuno da amare."

# game/Scenes/Update20/loserending.rpy:21
translate italian loser_ending_c3bf8e82:

