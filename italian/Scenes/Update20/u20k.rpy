# game/Scenes/Update20/u20k.rpy:3
translate italian u20k_3f1cfb62:

    # "For now, I should go see Nora."
    "Per ora, dovrei andare a trovare Nora."

# game/Scenes/Update20/u20k.rpy:6
translate italian u20k_4d7966b5:

    # "I drive to Nora's house and ring her doorbell."
    "Guido fino a casa di Nora e suono il campanello."

# game/Scenes/Update20/u20k.rpy:7
translate italian u20k_4238613f:

    # "It's late, but I have to see her, and I think she'll want to see me."
    "È tardi, ma devo vederla, e penso che anche lei voglia vedermi."

# game/Scenes/Update20/u20k.rpy:11
translate italian u20k_69b62070:

    # "After a few moments, I hear her running down the stairs, then she answers the door."
    "Dopo qualche istante, la sento correre giù per le scale, poi va ad aprire la porta."

# game/Scenes/Update20/u20k.rpy:12
translate italian u20k_f8d211b5:

    # sst "Holy shit, [pcname]! You're back!"
    sst "Porca miseria, [pcname]! Sei tornato!"

# game/Scenes/Update20/u20k.rpy:15
translate italian u20k_eccf68ff:

    # sst "I thought that stupid machine killed you!"
    sst "Pensavo che quella stupida macchina ti avesse ucciso!"

# game/Scenes/Update20/u20k.rpy:16
translate italian u20k_ee6c5ba9:

    # sst "I was going to the police tomorrow to tell them everything!"
    sst "Domani sarei andata alla polizia per raccontare tutto!"

# game/Scenes/Update20/u20k.rpy:17
translate italian u20k_0ea0e7d1:

    # sst "Whitney's been talking me out of it for days."
    sst "Whitney è da giorni che cerca di dissuadermi."

# game/Scenes/Update20/u20k.rpy:20
translate italian u20k_65904dc5:

    # sst "What the hell happened? What was all that shit?"
    sst "Che diavolo è successo? Che cavolo era tutta quella roba?"

# game/Scenes/Update20/u20k.rpy:21
translate italian u20k_04446d5f:

    # pc "I'll tell you all about it tomorrow, but yeah... I went to another world and saw my dad."
    pc "Te lo racconterò tutto domani, ma sì... sono andata in un altro mondo e ho visto mio padre."

# game/Scenes/Update20/u20k.rpy:22
translate italian u20k_641bbc8f:

    # sst "That's ridiculous. So fucking stupid."
    sst "È ridicolo. È fottutamente stupido."

# game/Scenes/Update20/u20k.rpy:25
translate italian u20k_f6493f5d:

    # sst "But, whatever! I'm just glad you're back."
    sst "Ma, chi se ne frega! Sono solo contenta che tu sia tornata."

# game/Scenes/Update20/u20k.rpy:26
translate italian u20k_fc4e92ee:

    # sst "You look and smell like you crawled out of a dumpster, but you're back!"
    sst "Sembri e puzzi come se fossi strisciata fuori da un cassonetto, ma sei tornata!"

# game/Scenes/Update20/u20k.rpy:29
translate italian u20k_e5a41f4c:

    # sst "Damn I missed you."
    sst "Cavolo, mi sei mancata."

# game/Scenes/Update20/u20k.rpy:30
translate italian u20k_919f8db7:

    # sst "Come on... let's take a shower and get in bed."
    sst "Dai... facciamo una doccia e andiamo a letto."

