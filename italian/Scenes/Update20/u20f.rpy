# game/Scenes/Update20/u20f.rpy:2
translate italian u20f_7d92946f:

    # "For now, I should go see Mari."
    "Per ora, dovrei andare a trovare Mari."

# game/Scenes/Update20/u20f.rpy:5
translate italian u20f_2bb3b023:

    # "I drive to Mari's house and knock on her door."
    "Guido fino a casa di Mari e busso alla sua porta."

# game/Scenes/Update20/u20f.rpy:6
translate italian u20f_0b175aad:

    # "Her dogs start barking at the door and I hear footsteps approaching."
    "I suoi cani iniziano ad abbaiare alla porta e sento dei passi avvicinarsi."

# game/Scenes/Update20/u20f.rpy:7
translate italian u20f_be91a4c9:

    # fr "Who is it?"
    fr "Chi è?"

# game/Scenes/Update20/u20f.rpy:8
translate italian u20f_1063bb8b:

    # pc "It's me! [pcname]."
    pc "Sono io! [pcname]."

# game/Scenes/Update20/u20f.rpy:12
translate italian u20f_a9b3d399:

    # fr "Oh my God, [pcname]!"
    fr "Oh mio Dio, [pcname]!"

# game/Scenes/Update20/u20f.rpy:13
translate italian u20f_ea03fec2:

    # "She opens the door and stares at me for a moment, shocked."
    "Lei apre la porta e mi fissa per un attimo, scioccata."

# game/Scenes/Update20/u20f.rpy:14
translate italian u20f_40412d0f:

    # "I can see her eyes welling up with tears."
    "Vedo i suoi occhi riempirsi di lacrime."

# game/Scenes/Update20/u20f.rpy:15
translate italian u20f_23647146:

    # fr "I thought..."
    fr "Pensavo..."

# game/Scenes/Update20/u20f.rpy:18
translate italian u20f_540e25ed:

    # "She rushes into my arms and hugs me tightly."
    "Si getta tra le mie braccia e mi stringe forte."

# game/Scenes/Update20/u20f.rpy:19
translate italian u20f_140e4956:

    # "I hug her back, feeling her warmth and the softness of her body."
    "La stringo a mia volta, sentendo il suo calore e la morbidezza del suo corpo."

# game/Scenes/Update20/u20f.rpy:20
translate italian u20f_dddaeb84:

    # pc "I missed you, Mari. I'm sorry I was gone for so long."
    pc "Mi sei mancata, Mari. Mi dispiace di essere stato via così a lungo."

# game/Scenes/Update20/u20f.rpy:23
translate italian u20f_b77230d2:

    # fr "I was so worried about you. I thought that machine killed you."
    fr "Ero così preoccupata per te. Pensavo che quella macchina ti avesse ucciso."

# game/Scenes/Update20/u20f.rpy:24
translate italian u20f_40e4fe9b:

    # pc "I fought so hard to get back."
    pc "Ho lottato con tutte le mie forze per tornare."

# game/Scenes/Update20/u20f.rpy:25
translate italian u20f_356f7f42:

    # pc "I'll tell you everything tomorrow, I promise."
    pc "Domani ti racconterò tutto, te lo prometto."

# game/Scenes/Update20/u20f.rpy:28
translate italian u20f_e5e85df6:

    # fr "I'm just glad you're back."
    fr "Sono solo felice che tu sia tornato."

# game/Scenes/Update20/u20f.rpy:29
translate italian u20f_1f943087:

    # fr "Wow, your hair grew a lot."
    fr "Wow, i tuoi capelli sono cresciuti tantissimo."

# game/Scenes/Update20/u20f.rpy:30
translate italian u20f_c49af8d0:

    # fr "It makes you look all rugged."
    fr "Ti danno un aspetto davvero rude."

# game/Scenes/Update20/u20f.rpy:33
translate italian u20f_7d64063d:

    # "She kisses me softly, her lips warm and inviting."
    "Mi bacia dolcemente, le sue labbra sono calde e invitanti."

# game/Scenes/Update20/u20f.rpy:34
translate italian u20f_e6ca1864:

    # fr "I'm so happy you came home."
    fr "Sono così felice che tu sia tornato a casa."

# game/Scenes/Update20/u20f.rpy:35
translate italian u20f_402e55b1:

    # fr "Let's go to bed. We can talk in the morning."
    fr "Andiamo a letto. Possiamo parlare domani mattina."

