# game/Scenes/Juliana/juliana0.rpy:13
translate italian juliana0_bbf5158a:

    # "I walk up to the counter and see the barista. It takes me a couple of moments to recognize her as the girl that sits near me in my English class."
    "Mi avvicino al bancone e vedo la barista. Mi ci vuole un attimo per riconoscerla come la ragazza che siede vicino a me al corso di inglese."

# game/Scenes/Juliana/juliana0.rpy:15
translate italian juliana0_d0776203:

    # bn "Don't I know you from somewhere?"
    bn "Non ti ho già vista da qualche parte?"

# game/Scenes/Juliana/juliana0.rpy:16
translate italian juliana0_06bb7787:

    # pc "Yeah, we sit next to each other in Mrs. McGee's English class."
    pc "Sì, siamo seduti uno accanto all’altra al corso di inglese della signora McGee."

# game/Scenes/Juliana/juliana0.rpy:18
translate italian juliana0_6e99a05f:

    # bn "Oh yeah, I remember now. My name is Juliana, by the way."
    bn "Oh sì, ora mi ricordo. A proposito, mi chiamo Juliana."

# game/Scenes/Juliana/juliana0.rpy:19
translate italian juliana0_cb77909a:

    # pc "I'm [pcname]."
    pc "Io sono [pcname]."

# game/Scenes/Juliana/juliana0.rpy:20
translate italian juliana0_a756212a:

    # bn "What do you want to drink? I'll give you a freebie this time, since we're classmates."
    bn "Cosa vuoi bere? Questa volta te lo offro, visto che siamo compagni di classe."

# game/Scenes/Juliana/juliana0.rpy:21
translate italian juliana0_bd06b050:

    # pc "Wow that's cool of you. I'll take a vanilla latte."
    pc "Wow, che gentile da parte tua. Prenderò un latte alla vaniglia."

# game/Scenes/Juliana/juliana0.rpy:22
translate italian juliana0_33319ea5:

    # bn "You got it."
    bn "Come vuoi."

# game/Scenes/Juliana/juliana0.rpy:24
translate italian juliana0_8555b0f3:

    # bn "So are you liking Mrs. McGee's class?"
    bn "Allora, ti piace la lezione della signora McGee?"

# game/Scenes/Juliana/juliana0.rpy:27
translate italian juliana0_c9fb3e54:

    # bn "You think so?"
    bn "Lo pensi davvero?"

# game/Scenes/Juliana/juliana0.rpy:28
translate italian juliana0_03040401:

    # bn "I've been a little disappointed."
    bn "Sono rimasta un po’ delusa."

# game/Scenes/Juliana/juliana0.rpy:29
translate italian juliana0_69e22abf:

    # pc "Disappointed? Why?"
    pc "Delusa? Perché?"

# game/Scenes/Juliana/juliana0.rpy:31
translate italian juliana0_7a8e06d3:

    # bn "Yeah, that's kind of how I feel."
    bn "Sì, mi sento più o meno così."

# game/Scenes/Juliana/juliana0.rpy:32
translate italian juliana0_03040401_1:

    # bn "I've been a little disappointed."
    bn "Sono rimasta un po’ delusa."

# game/Scenes/Juliana/juliana0.rpy:33
translate italian juliana0_69e22abf_1:

    # pc "Disappointed? Why?"
    pc "Delusa? Perché?"

# game/Scenes/Juliana/juliana0.rpy:35
translate italian juliana0_c3f4d210:

    # bn "Yeah, me either, which sucks because English class is usually my favorite class."
    bn "Sì, anch’io, il che è un peccato perché di solito la lezione di inglese è la mia preferita."

# game/Scenes/Juliana/juliana0.rpy:36
translate italian juliana0_6263773d:

    # bn "I've just been disappointed so far."
    bn "Finora sono rimasta delusa."

# game/Scenes/Juliana/juliana0.rpy:37
translate italian juliana0_69e22abf_2:

    # pc "Disappointed? Why?"
    pc "Delusa? Perché?"

# game/Scenes/Juliana/juliana0.rpy:38
translate italian juliana0_bbd0ff9f:

    # bn "Well I love English class usually. I love reading."
    bn "Beh, di solito adoro la lezione di inglese. Adoro leggere."

# game/Scenes/Juliana/juliana0.rpy:39
translate italian juliana0_c585f65a:

    # bn "But I've already read all the stories that she's assigned us to read this semester."
    bn "Ma ho già letto tutte le storie che ci ha assegnato per questo semestre."

# game/Scenes/Juliana/juliana0.rpy:40
translate italian juliana0_4063816c:

    # bn "And the composition and rhetoric she's teaching is all basic middle school stuff."
    bn "E la composizione e la retorica che insegna sono tutte cose di base da scuola media."

# game/Scenes/Juliana/juliana0.rpy:42
translate italian juliana0_dd005069:

    # bn "There you go. Vanilla latte, hope you enjoy."
    bn "Ecco qua. Latte alla vaniglia, spero ti piaccia."

# game/Scenes/Juliana/juliana0.rpy:43
translate italian juliana0_d7ecde63:

    # pc "Thanks, it looks great."
    pc "Grazie, sembra ottimo."

# game/Scenes/Juliana/juliana0.rpy:44
translate italian juliana0_75ee9c51:

    # bn "Nice to chat with you. I'll see you in class. Or up here, I guess. I work every weekday evening."
    bn "È stato bello chiacchierare con te. Ci vediamo in classe. O qui sopra, immagino. Lavoro tutte le sere nei giorni feriali."

# game/Scenes/Juliana/juliana0.rpy:45
translate italian juliana0_8eb194d2:

    # pc "Cool, I'll see you around then."
    pc "Fantastico, ci vediamo in giro allora."

# game/Scenes/Juliana/juliana0.rpy:47
translate italian juliana0_13a2bfee:

    # bn "See you later."
    bn "A più tardi."

# game/Scenes/Juliana/juliana0.rpy:49
translate italian juliana0_53f5f429:

    # "I take the latte and go sit at a table to enjoy it."
    "Prendo il latte e vado a sedermi a un tavolo per gustarmelo."

# game/Scenes/Juliana/juliana0.rpy:50
translate italian juliana0_f133a224:

    # "It's perfectly blended. She's really good at her job."
    "È miscelato alla perfezione. È davvero brava nel suo lavoro."

# game/Scenes/Juliana/juliana0.rpy:51
translate italian juliana0_712c8527:

    # "She seems nice too and really smart. Maybe I could spend some more time chatting with her sometime."
    "Sembra anche simpatica e molto intelligente. Magari potrei passare un po’ più di tempo a chiacchierare con lei qualche volta."

# game/Scenes/Juliana/juliana0.rpy:55
translate italian juliana0_1b83941c:

    # "I take my coffee and head to class."
    "Prendo il mio caffè e mi dirigo verso l’aula."

# game/Scenes/Juliana/juliana0.rpy:58
translate italian juliana0_7e33f586:

    # "I sit around and listen to the music, playing on my phone a bit while drinking the coffee and watching the other customers."
    "Mi siedo e ascolto la musica, giocherello un po’ con il telefono mentre bevo il caffè e osservo gli altri clienti."

# game/Scenes/Juliana/juliana0.rpy:59
translate italian juliana0_e5dea2ba:

    # "Then, after I finish, I wave goodbye to Juliana and head outside to my car."
    "Poi, una volta finito, saluto Juliana con la mano e esco verso la mia auto."

