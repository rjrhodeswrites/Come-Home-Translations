# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:32
translate italian julianamovietheaterstartdate_0f1c479d:

    # "We get to the theater and get seats in the back."
    "Arriviamo al cinema e ci sediamo nelle ultime file."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:33
translate italian julianamovietheaterstartdate_cd1f1d61:

    # bn "What kind of movie are we watching?"
    bn "Che tipo di film andiamo a vedere?"

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:37
translate italian julianamovietheaterstartdate_9753ecc6:

    # bn "That sounds very nice."
    bn "Sembra molto bello."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:38
translate italian julianamovietheaterstartdate_08edcd3e:

    # bn "I like romantic movies."
    bn "Mi piacciono i film romantici."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:43
translate italian julianamovietheaterstartdate_22be6204:

    # bn "Oh really?"
    bn "Oh, davvero?"

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:44
translate italian julianamovietheaterstartdate_a7aa68a8:

    # bn "I'm not really interested dumb action movies, but okay."
    bn "Non mi interessano molto gli stupidi film d’azione, ma va bene."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:50
translate italian julianamovietheaterstartdate_a36785e7:

    # bn "Oh really? I don't really like scary movies at all."
    bn "Oh, davvero? I film horror non mi piacciono proprio per niente."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:51
translate italian julianamovietheaterstartdate_5b88690f:

    # bn "Unless they're about hauntings, or they have some sort of romance in them."
    bn "A meno che non parlino di fantasmi o che abbiano una storia d’amore."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:52
translate italian julianamovietheaterstartdate_ffedd8a3:

    # bn "Most horror movies are really dumb."
    bn "La maggior parte dei film horror è davvero stupida."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:58
translate italian julianamovietheaterstartdate_352ba7de:

    # bn "Oh okay."
    bn "Oh, ok."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:59
translate italian julianamovietheaterstartdate_9c6a96f5:

    # bn "I try to enjoy comedies, but I don't always get the jokes."
    bn "Cerco di godermi le commedie, ma non sempre capisco le battute."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:60
translate italian julianamovietheaterstartdate_74eb3e05:

    # bn "There's a lot of times that I just don't understand what is supposed to be funny and what's not."
    bn "Molte volte semplicemente non capisco cosa dovrebbe essere divertente e cosa no."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:61
translate italian julianamovietheaterstartdate_cf50250b:

    # bn "But I'll try my best to laugh at the parts I'm supposed to."
    bn "Ma farò del mio meglio per ridere nelle parti in cui dovrei."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:63
translate italian julianamovietheaterstartdate_2fcc7df5:

    # "There's a little time before the movie starts for us to chat some."
    "C'è un po' di tempo prima che il film inizi per chiacchierare un po'."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:67
translate italian julianamovietheaterstartdate_592835a4:

    # "Finally the movie starts up and we go silent."
    "Finalmente il film inizia e restiamo in silenzio."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:70
translate italian julianamovietheaterstartdate_fd60e14c:

    # "She reaches over and holds my hand on top of the arm rest."
    "Lei si avvicina e mi prende la mano appoggiata sul bracciolo."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:74
translate italian julianamovietheaterstartdate_aee76b2d:

    # "The trailers take up about fifteen minutes, then the movie really gets started."
    "I trailer durano circa quindici minuti, poi il film inizia davvero."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:78
translate italian julianamovietheaterstartdate_17eefcb1:

    # "During the movie, she leans on my shoulder, really getting into the story."
    "Durante il film, lei si appoggia alla mia spalla, lasciandosi coinvolgere dalla storia."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:80
translate italian julianamovietheaterstartdate_1b60b301:

    # "Then during a particularly romantic scene, she raises her head and puts her lips to mine."
    "Poi, durante una scena particolarmente romantica, alza la testa e avvicina le sue labbra alle mie."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:81
translate italian julianamovietheaterstartdate_787192bc:

    # "We don't really watch a lot of the rest of the movie, instead focusing on making out."
    "Non guardiamo gran parte del resto del film, concentrandoci invece sui baci."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:84
translate italian julianamovietheaterstartdate_d17a4ae6:

    # "During the movie, she leans against my shoulder, really getting into the story."
    "Durante il film, lei si appoggia alla mia spalla, lasciandosi coinvolgere dalla storia."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:86
translate italian julianamovietheaterstartdate_610dce56:

    # "She seems to be liking the movie okay."
    "Sembra che il film le piaccia abbastanza."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:89
translate italian julianamovietheaterstartdate_dcbaecf4:

    # "Juliana watches the movie, but she looks annoyed the entire time."
    "Juliana guarda il film, ma sembra infastidita per tutto il tempo."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:92
translate italian julianamovietheaterstartdate_40670365:

    # "Eventually, she turns towards me."
    "Alla fine, si gira verso di me."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:93
translate italian julianamovietheaterstartdate_b867ff88:

    # bn "This movie is really bad, isn't it? It might be the worst movie I've ever seen."
    bn "Questo film è davvero pessimo, vero? Potrebbe essere il peggior film che abbia mai visto."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:94
translate italian julianamovietheaterstartdate_e3d0d8a6:

    # "She does not speak quietly, and some people in front of us turn and look at us."
    "Non parla a bassa voce, e alcune persone davanti a noi si girano a guardarci."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:95
translate italian julianamovietheaterstartdate_d58327fc:

    # pc "Do you want to leave?"
    pc "Vuoi andartene?"

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:97
translate italian julianamovietheaterstartdate_25b2e9a4:

    # bn "No, can we just kiss or something instead? I don't care about watching this."
    bn "No, possiamo invece baciarci o qualcosa del genere? Non mi interessa guardare questo film."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:98
translate italian julianamovietheaterstartdate_4f1735dd:

    # pc "Sounds good to me."
    pc "Per me va bene."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:100
translate italian julianamovietheaterstartdate_d0a52fcf:

    # "I lean in and kiss her and we don't really watch much else of the movie, instead focusing on each other."
    "Mi avvicino e la bacio e non guardiamo più granché del film, concentrandoci invece l’uno sull’altra."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:103
translate italian julianamovietheaterstartdate_c1b8c885:

    # "The horror movie was not about hauntings and had no romance in it."
    "Il film horror non parlava di fantasmi e non c’era nessuna storia d’amore."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:104
translate italian julianamovietheaterstartdate_003c9dc3:

    # "I'm pretty sure Juliana hated it."
    "Sono abbastanza sicuro che a Juliana non sia piaciuto per niente."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:105
translate italian julianamovietheaterstartdate_27d6edde:

    # "At one point, I even tried holding her hand, but she was not interested."
    "A un certo punto, ho anche provato a tenerle la mano, ma lei non era interessata."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:106
translate italian julianamovietheaterstartdate_d58327fc_1:

    # pc "Do you want to leave?"
    pc "Vuoi andartene?"

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:107
translate italian julianamovietheaterstartdate_4aa1d16b:

    # bn "We're already too far in. I have to know which of these dumb girls is going to live."
    bn "Siamo già troppo avanti. Devo sapere quale di queste ragazze stupide sopravviverà."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:108
translate italian julianamovietheaterstartdate_880b4aa8:

    # pc "Okay..."
    pc "Ok..."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:111
translate italian julianamovietheaterstartdate_92b7555a:

    # "At first, I'm not sure that Juliana is going to like the movie at all."
    "All’inizio non sono sicura che a Juliana piacerà il film."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:112
translate italian julianamovietheaterstartdate_c421db42:

    # "She looks frustrated through the beginning."
    "All’inizio sembra frustrata."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:113
translate italian julianamovietheaterstartdate_4e4b3a2b:

    # "But then..."
    "Ma poi..."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:115
translate italian julianamovietheaterstartdate_bd97c290:

    # "During one of the dumb jokes, she bursts into a fit of laughter that seems to go on forever."
    "Durante una di quelle battute stupide, scoppia in una risata che sembra non finire mai."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:116
translate italian julianamovietheaterstartdate_fa75bbc3:

    # pc "Are you okay?"
    pc "Stai bene?"

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:117
translate italian julianamovietheaterstartdate_5b62109c:

    # bn "Yes. I'm sorry. It's so funny though."
    bn "Sì. Scusa. È che è troppo divertente."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:118
translate italian julianamovietheaterstartdate_6ecb5d88:

    # bn "It's funny because he farted in a place where it was awkward to fart."
    bn "È divertente perché ha scoreggiato in un posto in cui era imbarazzante farlo."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:119
translate italian julianamovietheaterstartdate_b59d1ff2:

    # bn "And he couldn't stop farting!"
    bn "E non riusciva a smettere di scoreggiare!"

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:120
translate italian julianamovietheaterstartdate_9ef4273c:

    # "Once she starts laughing, she barely stops throughout the rest of the movie."
    "Una volta che ha iniziato a ridere, non si è quasi più fermata per il resto del film."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:124
translate italian julianamovietheaterstartdate_e42d81a7:

    # bn "I really liked that. I love when they go through some hardships, but stay together in the end."
    bn "Mi è piaciuto davvero tanto. Adoro quando affrontano delle difficoltà, ma alla fine restano insieme."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:125
translate italian julianamovietheaterstartdate_fe15de53:

    # bn "Thank you for bringing me. I enjoyed all of it."
    bn "Grazie per avermi portato. Mi è piaciuto tutto."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:129
translate italian julianamovietheaterstartdate_71eb6066:

    # bn "Well, thanks for bringing me, but maybe not an action movie next time?"
    bn "Beh, grazie per avermi portato, ma magari la prossima volta non un film d’azione?"

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:130
translate italian julianamovietheaterstartdate_6f6931a9:

    # bn "Even the noise of it was giving me a headache."
    bn "Anche solo il rumore mi faceva venire il mal di testa."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:134
translate italian julianamovietheaterstartdate_5bf0a9a9:

    # bn "That was the dumbest thing I've ever seen in my life."
    bn "È stata la cosa più stupida che abbia mai visto in vita mia."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:135
translate italian julianamovietheaterstartdate_2f39e364:

    # pc "It was pretty bad."
    pc "Era piuttosto brutto."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:136
translate italian julianamovietheaterstartdate_02a07558:

    # bn "I hated it."
    bn "L’ho odiato."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:137
translate italian julianamovietheaterstartdate_09c476ba:

    # bn "No more horror movies. They're all trash."
    bn "Basta con i film horror. Sono tutti spazzatura."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:138
translate italian julianamovietheaterstartdate_459e0f19:

    # pc "Okay. No more horror movies."
    pc "Ok. Basta con i film horror."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:141
translate italian julianamovietheaterstartdate_850f6df3:

    # bn "That was so funny."
    bn "È stato divertentissimo."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:142
translate italian julianamovietheaterstartdate_4083c4d8:

    # bn "I'm sorry if I laughed too much."
    bn "Scusa se ho riso troppo."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:143
translate italian julianamovietheaterstartdate_cd4369b1:

    # pc "No, it was fun to see you cut loose like that."
    pc "No, è stato divertente vederti scatenarti così."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:144
translate italian julianamovietheaterstartdate_f50c4948:

    # bn "I guess I don't laugh very often, huh?"
    bn "Immagino di non ridere molto spesso, eh?"

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:145
translate italian julianamovietheaterstartdate_b459f5c7:

    # bn "But when I do... wow, you have to look out."
    bn "Ma quando lo faccio... wow, devi stare attenta."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:146
translate italian julianamovietheaterstartdate_985a02fd:

    # "We hang out after the movie and chat during the credits."
    "Dopo il film usciamo insieme e chiacchieriamo durante i titoli di coda."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:150
translate italian julianamovietheaterstartdate_972891e3:

    # "When the credits end, we walk outside together and out to my car."
    "Quando finiscono i titoli di coda, usciamo insieme e ci dirigiamo verso la mia auto."

