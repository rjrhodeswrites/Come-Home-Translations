# game/Scenes/Juliana/JulianaDates/julianaluigisdate.rpy:34
translate italian julianaluigisstartdate_8b40ce2d:

    # "She gets in the car wearing a pretty dress and a wig."
    "Sale in macchina indossando un bel vestito e una parrucca."

# game/Scenes/Juliana/JulianaDates/julianaluigisdate.rpy:37
translate italian julianaluigisstartdate_c178e9aa:

    # bn "Oh, thank you."
    bn "Oh, grazie."

# game/Scenes/Juliana/JulianaDates/julianaluigisdate.rpy:38
translate italian julianaluigisstartdate_c91b3eb2:

    # bn "I sometimes like to wear it when I'm going out on a nice date."
    bn "A volte mi piace indossarla quando esco per un bel appuntamento."

# game/Scenes/Juliana/JulianaDates/julianaluigisdate.rpy:39
translate italian julianaluigisstartdate_c295710b:

    # bn "Not that I've had many dates."
    bn "Non che ne abbia avuti molti."

# game/Scenes/Juliana/JulianaDates/julianaluigisdate.rpy:40
translate italian julianaluigisstartdate_a71bf22a:

    # pc "Well it's very pretty."
    pc "Beh, è davvero carina."

# game/Scenes/Juliana/JulianaDates/julianaluigisdate.rpy:41
translate italian julianaluigisstartdate_3dc0e34e:

    # "She turns away and blushes a little."
    "Si gira dall’altra parte e arrossisce un po’."

# game/Scenes/Juliana/JulianaDates/julianaluigisdate.rpy:43
translate italian julianaluigisstartdate_313b6a1f:

    # bn "Oh, um. I don't know."
    bn "Oh, ehm. Non lo so."

# game/Scenes/Juliana/JulianaDates/julianaluigisdate.rpy:44
translate italian julianaluigisstartdate_2f29693a:

    # bn "I like to wear them when I go out somewhere nice."
    bn "Mi piace indossarle quando esco in un posto carino."

# game/Scenes/Juliana/JulianaDates/julianaluigisdate.rpy:47
translate italian julianaluigisstartdate_1431cc27:

    # bn "Thank you."
    bn "Grazie."

# game/Scenes/Juliana/JulianaDates/julianaluigisdate.rpy:48
translate italian julianaluigisstartdate_3dc0e34e_1:

    # "She turns away and blushes a little."
    "Lei distoglie lo sguardo e arrossisce un po'."

# game/Scenes/Juliana/JulianaDates/julianaluigisdate.rpy:50
translate italian julianaluigisstartdate_563fa2c8:

    # bn "Okay. Well I prefer the wig when I go somewhere nice."
    bn "Ok. Beh, io preferisco la parrucca quando vado in un posto carino."

# game/Scenes/Juliana/JulianaDates/julianaluigisdate.rpy:51
translate italian julianaluigisstartdate_e256026f:

    # "I'm not really sure how to respond, so we end up driving the rest of the way to the restaurant in an awkward silence."
    "Non so bene come rispondere, quindi finiamo per percorrere il resto del tragitto fino al ristorante in un silenzio imbarazzante."

# game/Scenes/Juliana/JulianaDates/julianaluigisdate.rpy:54
translate italian julianaluigisstartdate_62345451:

    # "When we get to Luigi's, we sit and order our meals."
    "Quando arriviamo da Luigi's, ci sediamo e ordiniamo da mangiare."

# game/Scenes/Juliana/JulianaDates/julianaluigisdate.rpy:55
translate italian julianaluigisstartdate_c57a5228:

    # "Then we chat for a while."
    "Poi chiacchieriamo per un po'."

# game/Scenes/Juliana/JulianaDates/julianaluigisdate.rpy:58
translate italian julianaluigisstartdate_0875967f:

    # "The server brings our food out, and we continue talking while we eat."
    "Il cameriere ci porta il cibo e continuiamo a parlare mentre mangiamo."

# game/Scenes/Juliana/JulianaDates/julianaluigisdate.rpy:60
translate italian julianaluigisstartdate_dbe7b11f:

    # "When we're done eating, we just hang around and talk for a little more."
    "Quando abbiamo finito di mangiare, restiamo lì ancora un po’ a chiacchierare."

# game/Scenes/Juliana/JulianaDates/julianaluigisdate.rpy:63
translate italian julianaluigisstartdate_018a4945:

    # "After our conversation, I pay for the food and we leave the restaurant and drive back to Juliana's house."
    "Dopo la nostra conversazione, pago il conto, usciamo dal ristorante e torniamo in auto a casa di Juliana."

