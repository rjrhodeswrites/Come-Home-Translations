    # bn "I'll have vanilla please."
    bn "Prenderò quella alla vaniglia, per favore."

# game/Scenes/Juliana/JulianaDates/julianaicecreamdate.rpy:29
translate italian julianaicecreamstartdate_e28b03b7:

    # pc "Just vanilla? You don't want a flavor?"
    pc "Solo vaniglia? Non vuoi un gusto particolare?"

# game/Scenes/Juliana/JulianaDates/julianaicecreamdate.rpy:30
translate italian julianaicecreamstartdate_c049ae90:

    # bn "I like vanilla. It's the finest of the flavors."
    bn "Mi piace la vaniglia. È il gusto più raffinato."

# game/Scenes/Juliana/JulianaDates/julianaicecreamdate.rpy:32
translate italian julianaicecreamstartdate_bf0f1fe7:

    # pc "\"Gotta see the show, 'cause then you'll know the vertigo is gonna grow 'cause it's so dangerous, you'll have to sign a waiver?\""
    pc " “Devi vedere lo spettacolo, perché allora capirai che le vertigini aumenteranno, perché è così pericoloso che dovrai firmare una liberatoria?”"

# game/Scenes/Juliana/JulianaDates/julianaicecreamdate.rpy:33
translate italian julianaicecreamstartdate_3a694dff:

    # bn "Uh... what?"
    bn "Ehm... cosa?"

# game/Scenes/Juliana/JulianaDates/julianaicecreamdate.rpy:34
translate italian julianaicecreamstartdate_3efc5a94:

    # pc "Oh, it's from a song. I thought you were making a reference."
    pc "Oh, è da una canzone. Pensavo stessi facendo un riferimento."

# game/Scenes/Juliana/JulianaDates/julianaicecreamdate.rpy:35
translate italian julianaicecreamstartdate_43de1e25:

    # bn "I'm sorry, I don't know the song."
    bn "Mi dispiace, non conosco la canzone."

# game/Scenes/Juliana/JulianaDates/julianaicecreamdate.rpy:36
translate italian julianaicecreamstartdate_385889cf:

    # pc "Oh... okay. Ignore that then."
    pc "Oh... ok. Allora non farci caso."

# game/Scenes/Juliana/JulianaDates/julianaicecreamdate.rpy:41
translate italian julianaicecreamstartdate_a716a63e:

    # "We sit down and enjoy our ice cream and chat for a while."
    "Ci sediamo, ci godiamo il gelato e chiacchieriamo un po'."

# game/Scenes/Juliana/JulianaDates/julianaicecreamdate.rpy:49
translate italian julianaicecreamstartdate_bec02a72:

    # "With the ice cream finished, our conversation slows down."
    "Finito il gelato, la nostra conversazione rallenta."

# game/Scenes/Juliana/JulianaDates/julianaicecreamdate.rpy:50
translate italian julianaicecreamstartdate_1b4b54ec:

    # bn "I think I'm ready for you to come back to my house now."
    bn "Penso di essere pronta per farti tornare a casa mia adesso."

# game/Scenes/Juliana/JulianaDates/julianaicecreamdate.rpy:51
translate italian julianaicecreamstartdate_18e0895f:

    # pc "Okay, let's go."
    pc "Ok, andiamo."

