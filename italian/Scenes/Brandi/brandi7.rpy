# game/Scenes/Brandi/brandi7.rpy:64
translate italian brandi7_6c990091:

    # pc "Let's do it."
    pc "Facciamolo."

# game/Scenes/Brandi/brandi7.rpy:67
translate italian brandi7_d3883cc2:

    # fd "Hello everybody and welcome!"
    fd "Ciao a tutti e benvenuti!"

# game/Scenes/Brandi/brandi7.rpy:68
translate italian brandi7_bda69350:

    # fd "[pcname] is here with me again, on our second date. We're at a new ice cream parlor in Skyhill."
    fd "[pcname] è di nuovo qui con me, al nostro secondo appuntamento. Siamo in una nuova gelateria a Skyhill."

# game/Scenes/Brandi/brandi7.rpy:69
translate italian brandi7_cc8a9142:

    # fd "Say hi, [pcname]."
    fd "Saluta, [pcname]."

# game/Scenes/Brandi/brandi7.rpy:70
translate italian brandi7_89523da1:

    # pc "Hi everybody."
    pc "Ciao a tutti."

# game/Scenes/Brandi/brandi7.rpy:71
translate italian brandi7_f1460d12:

    # fd "Okay, first taste, here we go."
    fd "Ok, primo assaggio, ci siamo."

# game/Scenes/Brandi/brandi7.rpy:74
translate italian brandi7_4504ebee:

    # fd "Oh mine is really good. How's yours?"
    fd "Oh, il mio è davvero buono. E il tuo?"

# game/Scenes/Brandi/brandi7.rpy:75
translate italian brandi7_48398008:

    # pc "It's great."
    pc "È fantastico."

# game/Scenes/Brandi/brandi7.rpy:76
translate italian brandi7_e0c06ef5:

    # fd "Can I have a taste? You can have some of mine too if you want."
    fd "Posso assaggiarlo? Puoi prendere anche un po’ del mio, se vuoi."

# game/Scenes/Brandi/brandi7.rpy:77
translate italian brandi7_61f77a4c:

