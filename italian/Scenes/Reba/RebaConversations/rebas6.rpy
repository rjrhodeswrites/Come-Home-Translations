# game/Scenes/Reba/RebaConversations/rebas6.rpy:16
translate italian rebas6_a96f8fd8:

    # rb "Honestly, no. Not really."
    rb "Onestamente, no. Non proprio."

# game/Scenes/Reba/RebaConversations/rebas6.rpy:18
translate italian rebas6_8dd8348c:

    # rb "I have to cook almost every night, because Mama can't stand in the kitchen with her bad knees."
    rb "Devo cucinare quasi tutte le sere, perché la mamma non riesce a stare in piedi in cucina a causa delle sue ginocchia malandate."

# game/Scenes/Reba/RebaConversations/rebas6.rpy:19
translate italian rebas6_5b8374d8:

    # rb "I'm just tired of it."
    rb "Sono solo stanca di farlo."

# game/Scenes/Reba/RebaConversations/rebas6.rpy:21
translate italian rebas6_5f43b423:

    # rb "A lot of nights, by the time I finish cooking, I'm so hot and exhausted that I don't even feel like eating."
    rb "Molte sere, quando finisco di cucinare, ho così caldo e sono così esausta che non ho nemmeno voglia di mangiare."

# game/Scenes/Reba/RebaConversations/rebas6.rpy:23
translate italian rebas6_ec93f7a6:

    # pc "That sucks. I can understand how that can get tiring."
    pc "Che seccatura. Capisco che possa diventare stancante."

# game/Scenes/Reba/RebaConversations/rebas6.rpy:24
translate italian rebas6_c32ce8f1:

    # pc "What is your mom going to do when you move out?"
    pc "Cosa farà tua madre quando te ne andrai di casa?"

# game/Scenes/Reba/RebaConversations/rebas6.rpy:25
translate italian rebas6_1ebef723:

    # rb "We've talked about it."
    rb "Ne abbiamo parlato."

# game/Scenes/Reba/RebaConversations/rebas6.rpy:27
translate italian rebas6_8c648ee8:

    # rb "She's grumpy about it and tries to make me feel guilty for leaving."
    rb "È di cattivo umore al riguardo e cerca di farmi sentire in colpa per andarmene."

# game/Scenes/Reba/RebaConversations/rebas6.rpy:28
translate italian rebas6_6027de22:

    # rb "I can't cook for her every night if I'm not living there."
    rb "Non posso cucinare per lei tutte le sere se non vivo lì."

# game/Scenes/Reba/RebaConversations/rebas6.rpy:30
translate italian rebas6_8958a6a8:

    # rb "But I'm still planning on going over there once a week and cooking a few meals and putting them in Tupperware so she can warm them up when she wants to eat."
    rb "Ma ho comunque intenzione di andare da lei una volta alla settimana, preparare qualche pasto e metterlo nei Tupperware così potrà riscaldarlo quando vorrà mangiare."

# game/Scenes/Reba/RebaConversations/rebas6.rpy:31
translate italian rebas6_450ed4c8:

    # pc "Well that's a little easier on you at least."
    pc "Beh, almeno così è un po’ più facile per te."

# game/Scenes/Reba/RebaConversations/rebas6.rpy:33
translate italian rebas6_c89b1de1:

    # rb "Yeah."
    rb "Sì."

# game/Scenes/Reba/RebaConversations/rebas6.rpy:34
translate italian rebas6_ee963e53:

    # rb "Maybe when she gets knee surgery she'll be able to do more on her own again."
    rb "Forse quando si farà l’intervento al ginocchio riuscirà di nuovo a fare più cose da sola."

# game/Scenes/Reba/RebaConversations/rebas6.rpy:36
translate italian rebas6_3c790017:

    # rb "And maybe once I don't have to cook and clean every night, I'll start to enjoy it again."
    rb "E forse, una volta che non dovrò più cucinare e pulire ogni sera, ricomincerò a divertirmi."

# game/Scenes/Reba/RebaConversations/rebas6.rpy:38
translate italian rebas6_5ca7ea49:

    # rb "I don't want you to think I'm not good wife material."
    rb "Non voglio che tu pensi che non sia una brava moglie."

# game/Scenes/Reba/RebaConversations/rebas6.rpy:39
translate italian rebas6_c5653eaa:

    # rb "I would cook for you."
    rb "Io cucinerei per te."

# game/Scenes/Reba/RebaConversations/rebas6.rpy:40
translate italian rebas6_93b41ed7:

    # pc "I'd cook for you too."
    pc "Anch’io cucinerei per te."

# game/Scenes/Reba/RebaConversations/rebas6.rpy:42
translate italian rebas6_7538b8de:

    # rb "Oh, I like that even better!"
    rb "Oh, questa mi piace ancora di più!"

translate italian strings:

    # game/Scenes/Reba/RebaConversations/rebas6.rpy:2
    old "This is a surface conversation that you can have with Reba on a date or on the phone."
    new "Questa è una conversazione superficiale che puoi avere con Reba durante un appuntamento o al telefono."

    # game/Scenes/Reba/RebaConversations/rebas6.rpy:3
    old "To unlock this conversation, you have to have had sex with her."
    new "Per sbloccare questa conversazione, devi aver fatto sesso con lei."

