    rb "Faccio fatica persino ad aspettare fino a stasera perché tu me lo infili dentro, lo voglio da morire."

# game/Scenes/Reba/reba12.rpy:112
translate italian reba12_98b4fc31:

    # rb "But I want my first time to be under the moonlight."
    rb "Ma voglio che la mia prima volta sia al chiaro di luna."

# game/Scenes/Reba/reba12.rpy:115
