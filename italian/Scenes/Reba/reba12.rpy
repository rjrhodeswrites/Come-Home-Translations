# game/Scenes/Reba/reba12.rpy:28
translate italian reba12_24d432d5:

    # rb "Oh okay."
    rb "Oh, ok."

# game/Scenes/Reba/reba12.rpy:29
translate italian reba12_98c9309b:

    # rb "Well, um... maybe next week then."
    rb "Beh, ehm... magari la prossima settimana, allora."

# game/Scenes/Reba/reba12.rpy:30
translate italian reba12_7a49d7a7:

    # pc "Okay, see you later, Reba."
    pc "Ok, ci vediamo più tardi, Reba."

# game/Scenes/Reba/reba12.rpy:31
translate italian reba12_2aeade94:

    # "We hang up and I go back to what I was doing."
    "Riattacciamo e torno a quello che stavo facendo."

# game/Scenes/Reba/reba12.rpy:35
translate italian reba12_b1ace31a:

    # rb "Yay!"
    rb "Evviva!"

# game/Scenes/Reba/reba12.rpy:36
translate italian reba12_655d7cf0:

    # rb "I'll head over and pick you up now. Get ready!"
    rb "Vado a prenderti subito. Preparati!"

# game/Scenes/Reba/reba12.rpy:37
translate italian reba12_b56b8704:

    # rb "We're gonna have a great weekend!"
    rb "Sarà un weekend fantastico!"

# game/Scenes/Reba/reba12.rpy:38
translate italian reba12_4f71e606:

    # "We hang up the phone and I get my things ready to go on this camping trip. Spending the night with Reba, alone this time, sounds incredible."
    "Riattacciamo e preparo le mie cose per questa gita in campeggio. Passare la notte con Reba, da sole questa volta, sembra incredibile."

# game/Scenes/Reba/reba12.rpy:42
translate italian reba12_371c7789:

    # "A little while later, she picks me up and we start out towards the lake."
    "Poco dopo, viene a prendermi e partiamo verso il lago."

# game/Scenes/Reba/reba12.rpy:43
translate italian reba12_acd8e955:

    # rb "Oh man, this is gonna be fun! We can go fishing. Go swimming. You know, same stuff we did last time..."
    rb "Oh cavolo, sarà divertentissimo! Possiamo andare a pescare. A nuotare. Insomma, le stesse cose che abbiamo fatto l’ultima volta..."

# game/Scenes/Reba/reba12.rpy:44
translate italian reba12_3e721e5a:

    # rb "But this time, my dumb-butt brother won't be around and we can sleep in the same tent."
    rb "Ma questa volta, quel mio stupido fratello non ci sarà e potremo dormire nella stessa tenda."

# game/Scenes/Reba/reba12.rpy:45
translate italian reba12_b0435202:

