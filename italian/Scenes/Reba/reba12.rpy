    rb "Oh, siamo una coppia, ed è come se avessimo pescato una coppia."

# game/Scenes/Reba/reba12.rpy:78
translate italian reba12_e3203266:

    # pc "That's kind of sweet."
    pc "È piuttosto carino."

# game/Scenes/Reba/reba12.rpy:79
translate italian reba12_d69a39b4:

