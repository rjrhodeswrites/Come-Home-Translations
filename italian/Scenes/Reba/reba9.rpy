# game/Scenes/Reba/reba9.rpy:5
translate italian reba9_4a2deb47:

    # "My phone starts buzzing. Reba is calling."
    "Il mio telefono inizia a vibrare. È Reba che chiama."

# game/Scenes/Reba/reba9.rpy:9
translate italian reba9_62aee7f1:

    # rb "Hey, [pcname]. You know how we talked about hanging out in town some time?"
    rb "Ehi, [pcname]. Ti ricordi che avevamo parlato di uscire in città qualche volta?"

# game/Scenes/Reba/reba9.rpy:10
translate italian reba9_28c6d658:

    # rb "Are you busy right now? I'm really craving a burger."
    rb "Sei occupato adesso? Ho proprio voglia di un hamburger."

# game/Scenes/Reba/reba9.rpy:14
translate italian reba9_15d1a1d2:

    # rb "Awesome! I'll meet you at Jackson Burger, alright?"
    rb "Fantastico! Ci vediamo da Jackson Burger, va bene?"

# game/Scenes/Reba/reba9.rpy:15
translate italian reba9_b0ab0038:

    # pc "Sounds good. See you there."
    pc "Mi sembra una buona idea. Ci vediamo lì."

# game/Scenes/Reba/reba9.rpy:19
translate italian reba9_e23feda5:

    # rb "Aw alright. Well if you change your mind, just give me a call sometime."
    rb "Ok, va bene. Beh, se cambi idea, chiamami quando vuoi."

# game/Scenes/Reba/reba9.rpy:20
translate italian reba9_24b552e3:

    # rb "I'm available most evenings."
    rb "Sono disponibile quasi tutte le sere."

# game/Scenes/Reba/reba9.rpy:21
translate italian reba9_64c8cb1f:

    # pc "Okay, I will."
    pc "Ok, lo farò."

# game/Scenes/Reba/reba9.rpy:22
translate italian reba9_e0e1ea50:

    # rb "See you later, [pcname]."
    rb "Ci vediamo più tardi, [pcname]."

# game/Scenes/Reba/reba9.rpy:34
translate italian reba9b_0e02b106:

    # "My phone buzzes. It looks like I got a text from Reba."
    "Il mio telefono vibra. Sembra che abbia ricevuto un messaggio da Reba."

# game/Scenes/Reba/reba9.rpy:49
translate italian reba9b_bce9991d:

    # "Wow."
    "Wow."

# game/Scenes/Reba/reba9.rpy:53
translate italian reba9b_ab930a7e:

    # "Just wow."
    "Semplicemente wow."

# game/Scenes/Reba/reba9.rpy:59
translate italian reba9b_cb625026:

    # "I put the phone away and go to sleep, thinking about burying my face between those big tits."
    "Metto via il telefono e vado a dormire, pensando di affondare il viso tra quelle tette enormi."

translate italian strings:

    # game/Scenes/Reba/reba9.rpy:26
    old "A few days after you go mudding with Reba, she will call and ask if you want to go out for a burger."
    new "Qualche giorno dopo che sarai andato a divertirti nel fango con Reba, lei ti chiamerà per chiederti se vuoi uscire a mangiare un hamburger."

    # game/Scenes/Reba/reba9.rpy:27
    old "Go on the date with her and she will send you a text at night."
    new "Esci con lei e la sera ti manderà un messaggio."

