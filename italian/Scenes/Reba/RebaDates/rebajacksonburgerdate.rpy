# game/Scenes/Reba/RebaDates/rebajacksonburgerdate.rpy:26
translate italian rebajacksonburgerstartdate_65a4a9d8:

    # "I meet Reba in front of Jackson Burger and we walk in together."
    "Incontro Reba davanti al Jackson Burger ed entriamo insieme."

# game/Scenes/Reba/RebaDates/rebajacksonburgerdate.rpy:29
translate italian rebajacksonburgerstartdate_aee9ac2a:

    # "We sit in the back in my usual booth."
    "Ci sediamo in fondo, al mio solito tavolo."

# game/Scenes/Reba/RebaDates/rebajacksonburgerdate.rpy:31
translate italian rebajacksonburgerstartdate_3f6c7563:

    # rb "I love this place. I don't get to come here very often, but it's so good when I do."
    rb "Adoro questo posto. Non mi capita spesso di venire qui, ma quando lo faccio è fantastico."

# game/Scenes/Reba/RebaDates/rebajacksonburgerdate.rpy:34
translate italian rebajacksonburgerstartdate_e0d8209b:

    # "A few moments after we sit down, Mari walks up to take our order."
    "Pochi istanti dopo che ci siamo seduti, Mari si avvicina per prendere la nostra ordinazione."

# game/Scenes/Reba/RebaDates/rebajacksonburgerdate.rpy:36
translate italian rebajacksonburgerstartdate_32aad169:

    # fr "Hey, [pcname]. Who's your date?"
    fr "Ehi, [pcname]. Chi è la tua accompagnatrice?"

# game/Scenes/Reba/RebaDates/rebajacksonburgerdate.rpy:37
translate italian rebajacksonburgerstartdate_293f257d:

    # pc "This is Reba. We met a little while back and have started dating a bit."
    pc "Lei è Reba. Ci siamo conosciuti qualche tempo fa e abbiamo iniziato a frequentarci un po'."

# game/Scenes/Reba/RebaDates/rebajacksonburgerdate.rpy:38
translate italian rebajacksonburgerstartdate_50370da8:

    # fr "Hi, Reba. Nice to meet you."
    fr "Ciao, Reba. Piacere di conoscerti."

# game/Scenes/Reba/RebaDates/rebajacksonburgerdate.rpy:41
translate italian rebajacksonburgerstartdate_b8319afc:

    # "Reba stands up and throws her arms around Mari, pulling her into a tight hug."
    "Reba si alza e getta le braccia al collo di Mari, stringendola in un abbraccio forte."

# game/Scenes/Reba/RebaDates/rebajacksonburgerdate.rpy:42
translate italian rebajacksonburgerstartdate_fb8c8e3b:

    # rb "Aw girl, it's nice to meet you too."
    rb "Oh ragazza, anche per me è un piacere conoscerti."

# game/Scenes/Reba/RebaDates/rebajacksonburgerdate.rpy:43
translate italian rebajacksonburgerstartdate_9ab5b8d9:

    # rb "I guess you're another one of [pcname]'s friends?"
    rb "Immagino che tu sia un'altra delle amiche di [pcname]?"

# game/Scenes/Reba/RebaDates/rebajacksonburgerdate.rpy:45
translate italian rebajacksonburgerstartdate_8a01148f:

    # fr "Yep, that I am."
    fr "Sì, esatto."

# game/Scenes/Reba/RebaDates/rebajacksonburgerdate.rpy:47
translate italian rebajacksonburgerstartdate_eedef566:

    # fr "Yeah we're friends. Hopefully more eventually."
    fr "Sì, siamo amiche. Speriamo di diventare qualcosa di più col tempo."

# game/Scenes/Reba/RebaDates/rebajacksonburgerdate.rpy:49
translate italian rebajacksonburgerstartdate_c260d345:

    # fr "Yeah, we're friends."
    fr "Sì, siamo amiche."

# game/Scenes/Reba/RebaDates/rebajacksonburgerdate.rpy:52
translate italian rebajacksonburgerstartdate_d628d3cf:

    # rb "Well he sure knows how to pick them, huh?"
    rb "Beh, di sicuro sa come sceglierle, eh?"

# game/Scenes/Reba/RebaDates/rebajacksonburgerdate.rpy:53
translate italian rebajacksonburgerstartdate_32597348:

    # rb "You're just adorable."
    rb "Sei proprio adorabile."

# game/Scenes/Reba/RebaDates/rebajacksonburgerdate.rpy:54
translate italian rebajacksonburgerstartdate_39dfd60b:

    # fr "Thanks! You're quite the cutie yourself."
    fr "Grazie! Anche tu sei proprio carina."

# game/Scenes/Reba/RebaDates/rebajacksonburgerdate.rpy:57
translate italian rebajacksonburgerstartdate_a33dd63e:

    # fr "Well, I hope you two have a great date. I'll go get your food ready."
    fr "Beh, spero che voi due abbiate un appuntamento fantastico. Vado a prepararvi da mangiare."

# game/Scenes/Reba/RebaDates/rebajacksonburgerdate.rpy:58
translate italian rebajacksonburgerstartdate_099fcc61:

    # fr "Let me know if you need anything else."
    fr "Fammi sapere se hai bisogno di qualcos'altro."

# game/Scenes/Reba/RebaDates/rebajacksonburgerdate.rpy:61
translate italian rebajacksonburgerstartdate_fe54d255:

    # rb "So, you're dating her too?"
    rb "Quindi, anche tu esci con lei?"

# game/Scenes/Reba/RebaDates/rebajacksonburgerdate.rpy:63
translate italian rebajacksonburgerstartdate_19c47387:

    # pc "Yeah, we've been together some. I like Mari a lot."
    pc "Sì, stiamo insieme da un po'. Mari mi piace molto."

# game/Scenes/Reba/RebaDates/rebajacksonburgerdate.rpy:64
translate italian rebajacksonburgerstartdate_3b2e5030:

    # rb "I get it. I'm not usually into girls, but she's real pretty."
    rb "Capisco. Di solito non mi piacciono le ragazze, ma lei è davvero carina."

# game/Scenes/Reba/RebaDates/rebajacksonburgerdate.rpy:66
translate italian rebajacksonburgerstartdate_fed76fa3:

    # pc "Not dating really, just flirting a bit."
    pc "Non stiamo proprio insieme, ci stiamo solo scambiando qualche battuta."

# game/Scenes/Reba/RebaDates/rebajacksonburgerdate.rpy:67
