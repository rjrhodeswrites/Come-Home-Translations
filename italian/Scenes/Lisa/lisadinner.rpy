# game/Scenes/Lisa/lisadinner.rpy:3
translate italian lisadinner_e20dd2c0:

    # "Usually Lisa would be cooking dinner here on the weekend, but she's not here."
    "Di solito Lisa cucinerebbe la cena qui nel fine settimana, ma non è qui."

# game/Scenes/Lisa/lisadinner.rpy:4
translate italian lisadinner_7b04e990:

    # "I wonder if she's still upset about before?"
    "Mi chiedo se sia ancora arrabbiata per prima?"

# game/Scenes/Lisa/lisadinner.rpy:5
translate italian lisadinner_6a8bd90c:

    # "I guess she just needs some more time."
    "Immagino che abbia solo bisogno di un po’ più di tempo."

# game/Scenes/Lisa/lisadinner.rpy:8
translate italian lisadinner_17ebb7b6:

    # "Lisa stands in the kitchen, cooking dinner at the stove."
    "Lisa è in cucina, intenta a preparare la cena ai fornelli."

# game/Scenes/Lisa/lisadinner.rpy:9
translate italian lisadinner_622e58a4:

    # "She looks tired, but still turns towards me with a smile."
    "Sembra stanca, ma si gira comunque verso di me con un sorriso."

# game/Scenes/Lisa/lisadinner.rpy:12
translate italian lisadinner_dbdf9d75:

    # sp "Hey honey. You joining me for dinner?"
    sp "Ehi, tesoro. Ti unisci a me per cena?"

# game/Scenes/Lisa/lisadinner.rpy:21
translate italian lisadinner_d0417e78:

    # sp "Okay honey, let me know if you change your mind."
    sp "Ok, tesoro, fammi sapere se cambi idea."

# game/Scenes/Lisa/lisadinner.rpy:67
translate italian lisadinnerconversation_18c6396f:

    # sp "I'm glad. It gets lonely eating by myself."
    sp "Ne sono felice. Mangiare da solo mi fa sentire solo."

# game/Scenes/Lisa/lisadinner.rpy:69
translate italian lisadinnerconversation_f7385cce:

    # "She returns to the stove and cooks us both dinner."
    "Lei torna ai fornelli e prepara la cena per entrambi."

# game/Scenes/Lisa/lisadinner.rpy:73
translate italian lisadinnerconversation_2aba8403:

    # "Then we sit together in the dining room and have a nice conversation while eating."
    "Poi ci sediamo insieme in sala da pranzo e facciamo una bella chiacchierata mentre mangiamo."

# game/Scenes/Lisa/lisadinner.rpy:76
translate italian lisadinnerconversation_ac9094b5:

    # "Afterwards, we go to the kitchen and I help with the dishes."
    "Dopo, andiamo in cucina e io la aiuto a lavare i piatti."

# game/Scenes/Lisa/lisadinner.rpy:77
translate italian lisadinnerconversation_74aec54b:

    # sp "Thanks for having dinner with me honey. I really enjoyed it."
    sp "Grazie per aver cenato con me, tesoro. Mi è piaciuto davvero tanto."

# game/Scenes/Lisa/lisadinner.rpy:78
translate italian lisadinnerconversation_6ecfecf0:

    # pc "Any time, [mom]."
    pc "Quando vuoi, [mom]."

# game/Scenes/Lisa/lisadinner.rpy:80
translate italian lisadinnerconversation_79c86a4f:

    # sp "Love you, baby."
    sp "Ti amo, tesoro."

# game/Scenes/Lisa/lisadinner.rpy:81
translate italian lisadinnerconversation_ce2ae2bf:

    # pc "Love you too."
    pc "Ti amo anch’io."

# game/Scenes/Lisa/lisadinner.rpy:82
translate italian lisadinnerconversation_db14aa5a:

    # "We finish up and Lisa goes to her bedroom for the night."
    "Finito tutto, Lisa va in camera sua per la notte."

