# game/Scenes/Lisa/lisabreakfast.rpy:20
translate italian lisabreakfast_09b21b2a:

    # sp "Good morning honey. Want some breakfast?"
    sp "Buongiorno tesoro. Vuoi fare colazione?"

# game/Scenes/Lisa/lisabreakfast.rpy:35
translate italian nottodaymom_d0417e78:

    # sp "Okay honey, let me know if you change your mind."
    sp "Va bene tesoro, fammi sapere se cambi idea."

# game/Scenes/Lisa/lisabreakfast.rpy:45
translate italian lisabreakfastconvo_c299cac3:

    # sp "I'll cook you some eggs and bacon."
    sp "Ti preparerò delle uova e della pancetta."

# game/Scenes/Lisa/lisabreakfast.rpy:46
translate italian lisabreakfastconvo_e45e3b16:

    # "She returns to the stove and cooks us both breakfast."
    "Torna ai fornelli e prepara la colazione per entrambi."

# game/Scenes/Lisa/lisabreakfast.rpy:49
translate italian lisabreakfastconvo_2ccb9eb9:

    # "Then we sit down together and have a nice conversation while eating breakfast."
    "Poi ci sediamo insieme e facciamo una bella chiacchierata mentre facciamo colazione."

# game/Scenes/Lisa/lisabreakfast.rpy:51
translate italian lisabreakfastconvo_280140a3:

    # "Afterwards, she cleans up the plates and I head upstairs and get dressed for the day."
    "Dopodiché, lei lava i piatti e io salgo al piano di sopra a vestirmi per la giornata."

