translate italian lisabreakfast_b90ab6dc:

    # "Lisa must have gone to work early. She didn't cook any breakfast. I guess she's still upset."
    "Lisa deve essere andata al lavoro presto. Non ha preparato la colazione. Immagino sia ancora arrabbiata."

# game/Scenes/Lisa/lisabreakfast.rpy:12
translate italian lisabreakfast_5ba2cbf3:

    # "Lisa stands in the kitchen, cooking some eggs in a pan on the stove."
    "Lisa è in cucina e sta cucinando delle uova in una padella sul fornello."

# game/Scenes/Lisa/lisabreakfast.rpy:19
translate italian lisabreakfast_d41d8cd9:

    # voice 'voices/lisa_goodmorning.wav'
