# game/Scenes/Whitney/whitney10.rpy:10
translate italian whitney10_be5af3f7:

    # "My phone buzzes in my pocket. It's Whitney calling."
    "Il mio telefono vibra in tasca. È Whitney che chiama."

# game/Scenes/Whitney/whitney10.rpy:15
translate italian whitney10_cabe2426:

    # pc "Hey, Whitney. What's up?"
    pc "Ehi, Whitney. Come va?"

# game/Scenes/Whitney/whitney10.rpy:16
translate italian whitney10_b9006bbe:

    # wt "Oh hey. Are you busy?"
    wt "Oh, ciao. Sei occupata?"

# game/Scenes/Whitney/whitney10.rpy:17
translate italian whitney10_bc1428f9:

    # pc "Not really."
    pc "Non proprio."

# game/Scenes/Whitney/whitney10.rpy:19
translate italian whitney10_87d76db1:

    # wt "I have this craving for that burger place we went to before. Would you want to go get dinner with me again?"
    wt "Ho una voglia matta di quel locale di hamburger dove siamo stati prima. Ti andrebbe di venire a cena con me di nuovo?"

# game/Scenes/Whitney/whitney10.rpy:20
translate italian whitney10_240f7709:

    # pc "Are you asking me out on a date?"
    pc "Mi stai chiedendo di uscire con te?"

# game/Scenes/Whitney/whitney10.rpy:22
translate italian whitney10_b86f93de:

    # wt "You can call it whatever you like. I just want a burger."
    wt "Chiamalo come vuoi. Voglio solo un hamburger."

# game/Scenes/Whitney/whitney10.rpy:23
translate italian whitney10_91e1bb14:

    # wt "And your company is nice as well."
    wt "E poi è bello stare in tua compagnia."

# game/Scenes/Whitney/whitney10.rpy:27
translate italian whitney10_7c538ce6:

    # wt "Great! I'll drive over and pick you up at your place in about half an hour."
    wt "Fantastico! Passo a prenderti a casa tua tra circa mezz'ora."

# game/Scenes/Whitney/whitney10.rpy:28
translate italian whitney10_ac8c00ba:

    # pc "Sounds good. See you then."
    pc "Mi sembra una buona idea. Ci vediamo allora."

# game/Scenes/Whitney/whitney10.rpy:29
translate italian whitney10_2c71ca5c:

    # "We hang up and I go home and get ready."
    "Riattacchiamo e io torno a casa a prepararmi."

# game/Scenes/Whitney/whitney10.rpy:33
translate italian whitney10_2aaf9014:

    # wt "Oh, okay then."
    wt "Oh, va bene allora."

# game/Scenes/Whitney/whitney10.rpy:34
translate italian whitney10_f7a5b1c0:

    # wt "Well, if you want to sometime, just give me a call in the evening. I'm usually free."
    wt "Beh, se ti va di vederci qualche volta, chiamami la sera. Di solito sono libera."

# game/Scenes/Whitney/whitney10.rpy:35
translate italian whitney10_bf0c9413:

    # pc "Okay, Whitney. Talk to you later."
    pc "Ok, Whitney. Ci sentiamo più tardi."

# game/Scenes/Whitney/whitney10.rpy:36
translate italian whitney10_a7e7a8bf:

    # wt "Bye, [pcname]."
    wt "Ciao, [pcname]."

