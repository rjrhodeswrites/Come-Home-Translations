    voice 'voices/kendra_whoa.wav'

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:32
translate italian kendragrottostartdate_cbfbb13b:

    # sg "Woah, you're wearing a suit. So fancy! You look like a fucking stud!"
    sg "Wow, indossi un completo. Che eleganza! Sembri un vero figo!"

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:33
translate italian kendragrottostartdate_93be84d9:

    # pc "Thanks! You look amazing too."
    pc "Grazie! Anche tu stai benissimo."

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:34
translate italian kendragrottostartdate_f9a9256b:

    # sg "Yeah, I got all dressed up and shit. No big. Let's go eat!"
    sg "Sì, mi sono vestita tutta elegante e roba del genere. Niente di che. Andiamo a mangiare!"

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:36
translate italian kendragrottostartdate_eddccec4:

    # sg "I'm so hungry! Let's eat!"
    sg "Ho tanta fame! Mangiamo!"

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:40
translate italian kendragrottostartdate_92e5e80f:

    # "We drive to The Grotto and are led to a table by the host."
    "Andiamo in macchina al The Grotto e veniamo accompagnati a un tavolo dal maître."

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:45
translate italian kendragrottostartdate_2e543208:

    # "We sit at our table and begin looking over the menus."
    "Ci sediamo al nostro tavolo e iniziamo a dare un'occhiata ai menu."

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:46
translate italian kendragrottostartdate_5508ff55:

    # sg "Wow this place is so fancy. Is the food here any good?"
    sg "Wow, questo posto è davvero elegante. Ma il cibo qui è buono?"

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:47
translate italian kendragrottostartdate_494fc97b:

    # pc "Yeah, it's amazing."
    pc "Sì, è fantastico."

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:48
translate italian kendragrottostartdate_f3f82f77:

    # sg "That's good. Whenever my parents took me to fancy restaurants like this, the food would always end up looking super pretty, but tasting gross."
    sg "Meno male. Ogni volta che i miei genitori mi portavano in ristoranti eleganti come questo, il cibo finiva sempre per avere un aspetto bellissimo, ma un sapore orribile."

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:49
translate italian kendragrottostartdate_720f2b03:

    # sg "Like they want to put some weird spices on it or something to make it different from other places, but I just want some dang chicken nuggets, you know?"
    sg "È come se volessero metterci delle spezie strane o qualcosa del genere per renderlo diverso dagli altri posti, ma io voglio solo dei maledetti bocconcini di pollo, capisci?"

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:50
translate italian kendragrottostartdate_039e7c94:

    # pc "Ha, you order whatever you'd like."
    pc "Ah, ordina quello che vuoi."

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:56
translate italian kendragrottostartdate_45ee2ac4:

    # "A couple of minutes later the server approaches us to take our order."
    "Un paio di minuti dopo il cameriere si avvicina per prendere la nostra ordinazione."

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:57
translate italian kendragrottostartdate_477af30d:

    # "Server" "Are you ready to place your order, or would you like some more time to look over the menu? I can answer any questions you have."
    "Server" "Siete pronti a ordinare o volete un po’ più di tempo per dare un’occhiata al menu? Posso rispondere a qualsiasi domanda."

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:58
translate italian kendragrottostartdate_11cbd844:

    # sg "Do y'all have any chicken nuggets?"
    sg "Avete dei bocconcini di pollo?"

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:59
translate italian kendragrottostartdate_2e8784f2:

    # "Server" "We have pan-fried buttermilk and panko chicken breast medallions, served over shingled potatoes with a creamy thyme sauce."
    "Server" "Abbiamo medaglioni di petto di pollo fritti in padella con latticello e panko, serviti su un letto di patate a scaglie con una salsa cremosa al timo."

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:60
translate italian kendragrottostartdate_e04bae2d:

    # sg "Is that kinda like chicken nuggets?"
    sg "È un po’ come i bocconcini di pollo?"

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:61
translate italian kendragrottostartdate_b16a388e:

    # "Server" "Yes ma'am. It's like chicken nuggets."
    "Server" "Sì, signora. È come i bocconcini di pollo."

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:62
translate italian kendragrottostartdate_f57e52c6:

    # sg "Gimme some of them then. And a Dr. Pepper."
    sg "Allora me ne dia un po’. E una Dr. Pepper."

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:65
translate italian kendragrottostartdate_3d97b32c:

    # "After the server takes our orders, Kendra and I chat for a while."
    "Dopo che il cameriere ha preso le nostre ordinazioni, io e Kendra chiacchieriamo per un po’."

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:68
translate italian kendragrottostartdate_55bc048d:

    # "After we talk for a while, our food is brought out."
    "Dopo aver parlato un po’, ci portano il cibo."

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:72
translate italian kendragrottostartdate_12bdb83d:

    # sg "I don't think these people know what chicken nuggets are."
    sg "Non credo che questa gente sappia cosa siano i bocconcini di pollo."

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:75
translate italian kendragrottostartdate_84073847:

    # sg "Oh well. I'm hungry. I'll give it a try."
    sg "Vabbè. Ho fame. Li proverò."

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:78
translate italian kendragrottostartdate_bfde7d54:

    # "We continue chatting and eating."
    "Continuiamo a chiacchierare e a mangiare."

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:88
translate italian kendragrottostartdate_35489cf9:

    # "When the waiter brings the bill out, Kendra quickly snatches it up."
    "Quando il cameriere porta il conto, Kendra lo afferra al volo."

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:89
translate italian kendragrottostartdate_618f396f:

    # sg "Wait, these chicken nuggets were thirty bucks!?"
    sg "Aspetta, questi bocconcini di pollo costavano trenta dollari!?"

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:90
translate italian kendragrottostartdate_4853a04c:

    # sg "That's crazy! They were good, but I could get like 200 nuggies from McDonalds for that price."
    sg "È pazzesco! Erano buoni, ma con quella cifra potrei comprarmi tipo 200 bocconcini da McDonald's."

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:91
translate italian kendragrottostartdate_011e7134:

    # pc "You're paying for the atmosphere here too. Can't get a view like this at McDonalds."
    pc "Qui si paga anche per l'atmosfera. Da McDonald's non si gode una vista come questa."

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:92
translate italian kendragrottostartdate_5895d784:

    # sg "Yeah I guess. But dang, thirty dollars?"
    sg "Sì, immagino di sì. Ma cavolo, trenta dollari?"

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:93
translate italian kendragrottostartdate_7ceb71ac:

    # pc "Don't worry about that. I got it."
    pc "Non preoccuparti. Ci penso io."

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:94
translate italian kendragrottostartdate_738449bb:

    # sg "If you say so. Just know, you don't have to take me anywhere fancy and expensive. I'd be just as happy anywhere else with you."
    sg "Se lo dici tu. Sappi solo che non devi portarmi in nessun posto elegante e costoso. Sarei felice lo stesso ovunque con te."

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:100
translate italian kendragrottostartdate_99c80cd6:

    # "After I pay, we start to walk out and stop to look over the lake for a moment."
    "Dopo aver pagato, usciamo e ci fermiamo un attimo a guardare il lago."

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:101
translate italian kendragrottostartdate_a1d66bdf:

    # sg "It {i}is{/i} really pretty though."
    sg "È {i}davvero{/i} bello, però."

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:110
translate italian kendragrottostartdate_cd966f27:

    # "I lean in and kiss her. She returns the kiss passionately, pressing hard into my mouth, her hands climbing up my body."
    "Mi chino verso di lei e la bacio. Lei ricambia il bacio con passione, premendosi con forza contro la mia bocca, mentre le sue mani mi accarezzano il corpo."

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:111
translate italian kendragrottostartdate_f0046ea4:

    # pc "Do you want to dance?"
    pc "Ti va di ballare?"

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:112
translate italian kendragrottostartdate_3f909766:

    # sg "Not really. I want you to take me back to your place and pound me into your bed."
    sg "Non proprio. Voglio che tu mi porti a casa tua e mi scopi nel tuo letto."

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:113
translate italian kendragrottostartdate_1909f58c:

    # pc "That sounds good too."
    pc "Anche quello mi sembra una buona idea."

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:120
translate italian kendragrottostartdate_72295199:

    # "We leave, then drive back to my house and rush up to my bedroom, barely able to keep our hands off each other."
    "Ce ne andiamo, poi torniamo in macchina a casa mia e ci precipitiamo in camera da letto, riuscendo a malapena a tenere le mani lontane l’uno dall’altra."

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:127
translate italian kendragrottostartdate_72295199_1:

    # "We leave, then drive back to my house and rush up to my bedroom, barely able to keep our hands off each other."
    "Usciamo, poi torniamo in macchina a casa mia e ci precipitiamo in camera da letto, riuscendo a malapena a tenere le mani lontane l’uno dall’altra."

# game/Scenes/Kendra/KendraDates/kendragrottodate.rpy:130
translate italian kendragrottostartdate_60db26d1:

    # "We go get in the car, then I drive her back to her house and tell her goodnight."
    "Saliamo in macchina, poi la riaccompagno a casa sua e le do la buonanotte."

