    # "She pulls away from me and starts putting her clothes back on."
    "Si allontana da me e inizia a rivestirsi."

# game/Scenes/Dana/dana11.rpy:198
translate italian dana11_183edbf1:

    # cw "I'm sorry. I don't have an answer right now."
    cw "Mi dispiace. Al momento non ho una risposta."

# game/Scenes/Dana/dana11.rpy:199
translate italian dana11_f647e814:

    # cw "I have a lot to think about."
    cw "Ho molto a cui pensare."

# game/Scenes/Dana/dana11.rpy:202
translate italian dana11_6b75f05e:

    # "We don't talk any more as we get dressed and ready to leave for the night."
    "Non parliamo più mentre ci vestiamo e ci prepariamo per andare via per la serata."

# game/Scenes/Dana/dana11.rpy:203
translate italian dana11_cd427378:

    # voice dana_notsure
    # cw "I'm not sure what I want right now, [pcname]. I'm sorry."
    voice dana_notsure
    cw ""

# game/Scenes/Dana/dana11.rpy:205
translate italian dana11_07d66e97:

    # cw "I like you a lot though. And that felt absolutely incredible."
    cw "Mi piaci davvero tanto, però. E quello è stato assolutamente incredibile."

# game/Scenes/Dana/dana11.rpy:206
translate italian dana11_f5a40ed7:

    # cw "I know that I'd love more of it. I'd love a whole night with you."
    cw "So che mi piacerebbe farlo ancora. Mi piacerebbe passare un'intera notte con te."

# game/Scenes/Dana/dana11.rpy:207
translate italian dana11_d5f27966:

    # cw "A night full of sweat and cum. Just us, naked, making each other feel good."
    cw "Una notte piena di sudore e sperma. Solo noi due, nudi, a darci piacere a vicenda."

# game/Scenes/Dana/dana11.rpy:210
translate italian dana11_472e747d:

    # voice dana_somanythings
    # cw "There are so many things that I want to do, but I just can't right now..."
    voice dana_somanythings
    cw ""

# game/Scenes/Dana/dana11.rpy:212
translate italian dana11_4f64b943:

    # cw "Maybe things will be different soon."
    cw "Forse le cose cambieranno presto."

# game/Scenes/Dana/dana11.rpy:213
translate italian dana11_f38cb539:

    # pc "If you ever need me, if you need help with anything, just give me a call okay?"
    pc "Se mai avessi bisogno di me, se avessi bisogno di aiuto per qualsiasi cosa, chiamami, ok?"

# game/Scenes/Dana/dana11.rpy:214
translate italian dana11_076e215f:

    # cw "Thank you, [pcname]. I will."
    cw "Grazie, [pcname]. Lo farò."

# game/Scenes/Dana/dana11.rpy:217
translate italian dana11_b835f48d:

    # "We lock up and walk out of the office together. I don't want her to go."
    "Chiudiamo a chiave e usciamo insieme dall’ufficio. Non voglio che se ne vada."

# game/Scenes/Dana/dana11.rpy:218
translate italian dana11_42eaf199:

    # "I don't want her to have to go home and deal with Terry."
    "Non voglio che debba tornare a casa e avere a che fare con Terry."

# game/Scenes/Dana/dana11.rpy:219
translate italian dana11_17e8cfa0:

    # "I want her to come with me. To let me make her happy."
    "Voglio che venga con me. Che mi permetta di renderla felice."

# game/Scenes/Dana/dana11.rpy:222
translate italian dana11_95d10884:

    # "But she gets into her car and drives away anyway."
    "Ma lei sale comunque in macchina e se ne va."

# game/Scenes/Dana/dana11.rpy:223
translate italian dana11_9c915406:

    # "She had said that maybe things will be different soon..."
    "Aveva detto che forse le cose saranno diverse presto..."

# game/Scenes/Dana/dana11.rpy:224
translate italian dana11_d2b281d8:

    # "I hope so."
    "Lo spero."

