    # gnd "I probably shouldn't. But I don't feel like moving right now."
    gnd "Probabilmente non dovrei. Ma non ho voglia di muovermi in questo momento."

# game/Scenes/Jamie/jamie13.rpy:192
translate italian jamie13_f1a6c37e:

    # pc "You should stay."
    pc "Dovresti restare."

# game/Scenes/Jamie/jamie13.rpy:193
translate italian jamie13_6d9c381a:

    # gnd "Okay. I think I will."
    gnd "Ok. Penso che lo farò."

# game/Scenes/Jamie/jamie13.rpy:195
translate italian jamie13_d41d8cd9_8:

    # voice "voices/jamie_028.mp3"
    voice "voices/jamie_028.mp3"

# game/Scenes/Jamie/jamie13.rpy:196
translate italian jamie13_b095ff70:

    # gnd "Like you said. I'm an adult. I can do what I want."
    gnd "Come hai detto tu. Sono un adulto. Posso fare quello che voglio."

# game/Scenes/Jamie/jamie13.rpy:199
translate italian jamie13_94cd612d:

    # "She moves to look at me, her eyes locked onto mine."
    "Si gira a guardarmi, i suoi occhi fissi sui miei."

# game/Scenes/Jamie/jamie13.rpy:201
translate italian jamie13_d41d8cd9_9:

    # voice "voices/jamie_022.mp3"
    voice "voices/jamie_022.mp3"

# game/Scenes/Jamie/jamie13.rpy:202
translate italian jamie13_f9831d1e:

    # gnd "I love you, [pcname]."
    gnd "Ti amo, [pcname]."

# game/Scenes/Jamie/jamie13.rpy:203
translate italian jamie13_5e3e613a:

    # pc "I love you too, Jamie."
    pc "Ti amo anch’io, Jamie."

# game/Scenes/Jamie/jamie13.rpy:204
translate italian jamie13_59e15393:

    # "We lie there like that, sweat cooling on our skin, until I hear her soft snoring."
    "Restiamo lì distesi così, con il sudore che si raffredda sulla nostra pelle, finché non sento il suo leggero russare."

# game/Scenes/Jamie/jamie13.rpy:207
translate italian jamie13_ae4b475d:

    # "Then I fall asleep shortly after."
    "Poi mi addormento poco dopo."

# game/Scenes/Jamie/jamie13.rpy:215
translate italian jamie13_f6d0406e:

    # "In the morning, I wake up to her face, sleeping next to me."
    "Al mattino, mi sveglio con il suo viso accanto al mio, mentre dorme."

# game/Scenes/Jamie/jamie13.rpy:216
translate italian jamie13_fc00fd18:

    # "I softly caress her cheek to wake her up."
    "Le accarezzo delicatamente la guancia per svegliarla."

# game/Scenes/Jamie/jamie13.rpy:219
translate italian jamie13_a336655c:

    # pc "Hey beautiful."
    pc "Ehi, bellissima."

# game/Scenes/Jamie/jamie13.rpy:221
translate italian jamie13_d41d8cd9_10:

    # voice "voices/jamie_029a.mp3"
    voice "voices/jamie_029a.mp3"

# game/Scenes/Jamie/jamie13.rpy:222
translate italian jamie13_c59c4cdd:

    # gnd "Oh geez, what time is it?"
    gnd "Oh cavolo, che ore sono?"

# game/Scenes/Jamie/jamie13.rpy:224
translate italian jamie13_d41d8cd9_11:

    # voice "voices/jamie_029b.mp3"
    voice "voices/jamie_029b.mp3"

# game/Scenes/Jamie/jamie13.rpy:225
translate italian jamie13_9a2ed43d:

    # gnd "I have to get home before Dad gets upset."
    gnd "Devo tornare a casa prima che papà si arrabbi."

# game/Scenes/Jamie/jamie13.rpy:227
translate italian jamie13_d41d8cd9_12:

    # voice "voices/jamie_029c.mp3"
    voice "voices/jamie_029c.mp3"

# game/Scenes/Jamie/jamie13.rpy:228
translate italian jamie13_c042afc8:

    # gnd "I need a shower too. I smell like sex so bad."
    gnd "Anch’io ho bisogno di una doccia. Puzzo terribilmente di sesso."

# game/Scenes/Jamie/jamie13.rpy:231
translate italian jamie13_dffd2cad:

    # "She jumps up out of bed, seemingly completely awake now, and starts getting dressed."
    "Lei balza giù dal letto, apparentemente completamente sveglia ora, e inizia a vestirsi."

# game/Scenes/Jamie/jamie13.rpy:232
translate italian jamie13_8d3da257:

    # gnd "Seriously though, [pcname], last night was amazing."
    gnd "Seriamente, però, [pcname], ieri sera è stato fantastico."

# game/Scenes/Jamie/jamie13.rpy:233
translate italian jamie13_ec35244f:

    # gnd "I wish I could sleep with you every night."
    gnd "Vorrei poter dormire con te ogni notte."

# game/Scenes/Jamie/jamie13.rpy:234
translate italian jamie13_ef7afd6d:

    # pc "You could if you wanted."
    pc "Potresti, se volessi."

# game/Scenes/Jamie/jamie13.rpy:235
translate italian jamie13_bbd8e0f5:

    # gnd "Maybe one day."
    gnd "Magari un giorno."

# game/Scenes/Jamie/jamie13.rpy:238
translate italian jamie13_b00d8df6:

    # "I put on my pajamas and walk her down the stairs."
    "Mi metto il pigiama e la accompagno giù per le scale."

# game/Scenes/Jamie/jamie13.rpy:239
translate italian jamie13_9b857853:

    # "The morning light shining on her from the front windows of the house makes her seem like she's glowing."
    "La luce del mattino che la illumina dalle finestre anteriori della casa la fa sembrare quasi radiosa."

# game/Scenes/Jamie/jamie13.rpy:242
translate italian jamie13_5eb86a54:

    # "We stop at the door, kissing goodbye before we open it."
    "Ci fermiamo sulla porta, ci diamo un bacio d’addio prima di aprirla."

# game/Scenes/Jamie/jamie13.rpy:243
translate italian jamie13_9cdd394e:

    # gnd "Bye, [pcname]. We'll talk later."
    gnd "Ciao, [pcname]. Ci sentiamo più tardi."

# game/Scenes/Jamie/jamie13.rpy:244
translate italian jamie13_92be29ee:

    # gnd "And hopefully do this again very soon."
    gnd "E speriamo di rifarlo molto presto."

# game/Scenes/Jamie/jamie13.rpy:245
translate italian jamie13_72475059:

    # pc "I can't wait."
    pc "Non vedo l’ora."

# game/Scenes/Jamie/jamie13.rpy:249
translate italian jamie13_7660a175:

    # "Then she turns and opens the door and her father is standing on my front porch."
    "Poi lei si gira e apre la porta e suo padre è in piedi sul mio portico."

# game/Scenes/Jamie/jamie13.rpy:251
translate italian jamie13_d41d8cd9_13:

    # voice "voices/jamie_030.mp3"
    voice "voices/jamie_030.mp3"

# game/Scenes/Jamie/jamie13.rpy:252
translate italian jamie13_a60f4c8e:

    # gnd "Oh! Daddy, I just..."
    gnd "Oh! Papà, stavo solo..."

# game/Scenes/Jamie/jamie13.rpy:253
translate italian jamie13_d6386a6a:

    # "Jamie's Dad" "Let's go."
    "Jamie's Dad" "Andiamo."

# game/Scenes/Jamie/jamie13.rpy:254
translate italian jamie13_64554391:

    # gnd "...okay."
    gnd "...ok."

# game/Scenes/Jamie/jamie13.rpy:257
translate italian jamie13_c5786232:

    # "They walk away. I can't see Jamie's face, but I can tell she's crying."
    "Se ne vanno. Non riesco a vedere il viso di Jamie, ma capisco che sta piangendo."

# game/Scenes/Jamie/jamie13.rpy:258
translate italian jamie13_d519e179:

    # "I don't know what to do, so I just let them go."
    "Non so cosa fare, quindi li lascio semplicemente andare."

# game/Scenes/Jamie/jamie13.rpy:259
translate italian jamie13_0833f49b:

    # "He needs to get over this shit. I know I hurt her in the past, but it was so long ago. And she's an adult now. I just wish she would stand up to him."
    "Deve superare questa stronzata. So di averle fatto del male in passato, ma è successo tanto tempo fa. E ora è un’adulta. Vorrei solo che gli tenesse testa."

# game/Scenes/Jamie/jamie13.rpy:260
translate italian jamie13_fe41f349:

    # "Hopefully, she will talk to him and get this all sorted out."
    "Spero che gli parli e che riescano a risolvere tutto."

# game/Scenes/Jamie/jamie13.rpy:263
translate italian jamie13_1dc304ca:

    # "I shut the door and go back inside and get ready for my day."
    "Chiudo la porta, torno dentro e mi preparo per la giornata."

# game/Scenes/Jamie/jamie13.rpy:264
translate italian jamie13_6888669d:

    # "I try to focus on the amazing night and not the bad morning."
    "Cerco di concentrarmi sulla serata fantastica e non sulla brutta mattinata."

# game/Scenes/Jamie/jamie13.rpy:266
translate italian jamie13_ab079190:

    # "Later that night..."
    "Più tardi quella sera..."

# game/Scenes/Jamie/jamie13.rpy:278
translate italian jamie13b_e331f532:

    # "My phone starts buzzing in my pocket. Jamie's calling. I hope she worked out stuff with her dad."
    "Il mio telefono inizia a vibrare in tasca. È Jamie che chiama. Spero che abbia risolto le cose con suo padre."

# game/Scenes/Jamie/jamie13.rpy:282
translate italian jamie13b_db1adf95:

    # pc "Hey, baby."
    pc "Ehi, tesoro."

# game/Scenes/Jamie/jamie13.rpy:284
translate italian jamie13b_d41d8cd9:

    # voice "voices/jamie_084.mp3"
    voice "voices/jamie_084.mp3"

# game/Scenes/Jamie/jamie13.rpy:285
translate italian jamie13b_db3d91ac:

    # gnd "I need to tell you something, [pcname]."
    gnd "Devo dirti una cosa, [pcname]."

# game/Scenes/Jamie/jamie13.rpy:287
translate italian jamie13b_d41d8cd9_1:

    # voice "voices/jamie_085.mp3"
    voice "voices/jamie_085.mp3"

# game/Scenes/Jamie/jamie13.rpy:288
translate italian jamie13b_ec3e201c:

    # gnd "I'm sorry, but our relationship is not going to work out."
    gnd "Mi dispiace, ma la nostra relazione non funzionerà."

# game/Scenes/Jamie/jamie13.rpy:289
translate italian jamie13b_a2a6fb65:

    # pc "What do you mean?"
    pc "Cosa intendi?"

# game/Scenes/Jamie/jamie13.rpy:291
translate italian jamie13b_d41d8cd9_2:

    # voice "voices/jamie_086.mp3"
    voice "voices/jamie_086.mp3"

# game/Scenes/Jamie/jamie13.rpy:292
translate italian jamie13b_cab545aa:

    # gnd "I have to choose between you and my dad. I'm choosing my dad."
    gnd "Devo scegliere tra te e mio padre. Scelgo mio padre."

# game/Scenes/Jamie/jamie13.rpy:294
translate italian jamie13b_d41d8cd9_3:

    # voice "voices/jamie_087.mp3"
    voice "voices/jamie_087.mp3"

# game/Scenes/Jamie/jamie13.rpy:295
translate italian jamie13b_9a5ae475:

    # gnd "I'm sorry. It's over."
    gnd "Mi dispiace. È finita."

# game/Scenes/Jamie/jamie13.rpy:298
translate italian jamie13b_d41d8cd9_4:

    # voice "voices/jamie_088.mp3"
    voice "voices/jamie_088.mp3"

# game/Scenes/Jamie/jamie13.rpy:299
translate italian jamie13b_77f7fa61:

    # gnd "Good luck with everything. Please don't try to contact me anymore."
    gnd "Buona fortuna per tutto. Per favore, non provare più a contattarmi."

# game/Scenes/Jamie/jamie13.rpy:300
translate italian jamie13b_33949145:

    # pc "What? Wait..."
    pc "Cosa? Aspetta..."

# game/Scenes/Jamie/jamie13.rpy:303
translate italian jamie13b_bcbbe2f1:

    # "She hung up."
    "Ha riattaccato."

# game/Scenes/Jamie/jamie13.rpy:304
translate italian jamie13b_439a8efe:

    # "What the fuck? What am I supposed to do now?"
    "Ma che cazzo? Cosa dovrei fare adesso?"

# game/Scenes/Jamie/jamie13.rpy:305
translate italian jamie13b_a1814c52:

    # "I guess if she doesn't want to be with me, and doesn't want me to talk to her, I have to respect her wishes."
    "Immagino che se non vuole stare con me e non vuole che le parli, devo rispettare i suoi desideri."

# game/Scenes/Jamie/jamie13.rpy:306
translate italian jamie13b_f87ec8ec:

    # "But it's bullshit!"
    "Ma è una stronzata!"

# game/Scenes/Jamie/jamie13.rpy:309
translate italian jamie13b_18c2def7:

    # "I feel like screaming. Like punching something."
    "Ho voglia di urlare. Di dare un pugno a qualcosa."

# game/Scenes/Jamie/jamie13.rpy:310
translate italian jamie13b_32c163d2:

    # "But instead, I lie in bed and seethe in anger until I fall asleep."
    "Invece, resto sdraiato a letto e ribollo di rabbia finché non mi addormento."

