# game/Scenes/Jamie/jamie8.rpy:13
translate italian jamie8_98ca1a51:

    # "My phone buzzes in my pocket."
    "Il mio telefono vibra in tasca."

# game/Scenes/Jamie/jamie8.rpy:15
translate italian jamie8_7a608d10:

    # "It's Jamie. I lie on my bed and answer the phone."
    "È Jamie. Sono sdraiata sul letto e rispondo al telefono."

# game/Scenes/Jamie/jamie8.rpy:19
translate italian jamie8_80c674d7:

    # pc "Hey, Jamie."
    pc "Ehi, Jamie."

# game/Scenes/Jamie/jamie8.rpy:20
translate italian jamie8_3d698c03:

    # gnd "Hey. You busy?"
    gnd "Ehi. Sei occupata?"

# game/Scenes/Jamie/jamie8.rpy:21
translate italian jamie8_4474e21b:

    # pc "Nah. What's up?"
    pc "No. Che succede?"

# game/Scenes/Jamie/jamie8.rpy:22
translate italian jamie8_34eb8872:

    # gnd "Nothing really. Just wanted to talk to you. Miss you."
    gnd "Niente di che. Volevo solo parlarti. Mi manchi."

# game/Scenes/Jamie/jamie8.rpy:23
translate italian jamie8_71edcec9:

    # pc "Well.. you could come over?"
    pc "Beh... potresti passare da me?"

# game/Scenes/Jamie/jamie8.rpy:25
translate italian jamie8_a38e761a:

    # gnd "You know I can't really do that. My dad would be so mad."
    gnd "Sai che non posso proprio farlo. Mio padre si arrabbierebbe tantissimo."

# game/Scenes/Jamie/jamie8.rpy:26
translate italian jamie8_9f0961af:

    # pc "Why? You're an adult. Why does he get a say in what you do?"
    pc "Perché? Sei adulta. Perché deve avere voce in capitolo su quello che fai?"

# game/Scenes/Jamie/jamie8.rpy:27
translate italian jamie8_57cb5e24:

    # gnd "I know. I just don't want him to be mad."
    gnd "Lo so. È solo che non voglio che si arrabbi."

# game/Scenes/Jamie/jamie8.rpy:28
translate italian jamie8_0833b2b4:

    # gnd "I'll talk to him soon though, I promise."
    gnd "Gli parlerò presto, però, te lo prometto."

# game/Scenes/Jamie/jamie8.rpy:29
translate italian jamie8_b1a2e372:

    # gnd "I know I need to. It's just hard, because I know he's not going to like what I have to say."
    gnd "So che devo farlo. È solo che è difficile, perché so che non gli piacerà quello che ho da dirgli."

# game/Scenes/Jamie/jamie8.rpy:30
translate italian jamie8_6cd88cb3:

    # gnd "And he works so hard, and I love him so much. I just hate to make him upset."
    gnd "E poi lavora così tanto, e gli voglio così tanto bene. Odio proprio farlo arrabbiare."

# game/Scenes/Jamie/jamie8.rpy:32
translate italian jamie8_dbc86daf:

    # gnd "But you mean so much to me. I don't want to have to keep sneaking around, keeping us a secret."
    gnd "Ma tu significhi così tanto per me. Non voglio dover continuare a nascondermi, a tenere segreta la nostra relazione."

# game/Scenes/Jamie/jamie8.rpy:33
translate italian jamie8_aa61dfea:

    # gnd "I just need to build up the courage to do it."
    gnd "Devo solo trovare il coraggio di farlo."

# game/Scenes/Jamie/jamie8.rpy:37
translate italian jamie8_07bcbb36:

    # gnd "Thank you. I'm glad. You've been very patient with me."
    gnd "Grazie. Ne sono felice. Sei stato molto paziente con me."

# game/Scenes/Jamie/jamie8.rpy:39
translate italian jamie8_a5d0737c:

    # gnd "I'll make it worth it for you, I promise."
    gnd "Farò in modo che ne valga la pena per te, te lo prometto."

# game/Scenes/Jamie/jamie8.rpy:40
translate italian jamie8_5de186d8:

    # pc "It's already worth it, Jamie."
    pc "Ne vale già la pena, Jamie."

# game/Scenes/Jamie/jamie8.rpy:43
translate italian jamie8_911c62b3:

    # gnd "You're right. I'm sorry."
    gnd "Hai ragione. Mi dispiace."

# game/Scenes/Jamie/jamie8.rpy:44
translate italian jamie8_d5112d06:

    # gnd "You shouldn't have to deal with all of this drama. I know you're dealing with your own things, with your dad missing and all."
    gnd "Non dovresti dover affrontare tutto questo dramma. So che hai già le tue cose a cui pensare, con tuo padre scomparso e tutto il resto."

# game/Scenes/Jamie/jamie8.rpy:45
translate italian jamie8_5a747778:

    # gnd "I should be there for you more."
    gnd "Dovrei starti più vicino."

# game/Scenes/Jamie/jamie8.rpy:47
translate italian jamie8_9d979554:

    # gnd "And I will be. I promise. I'll tell him soon."
    gnd "E lo farò. Te lo prometto. Glielo dirò presto."

# game/Scenes/Jamie/jamie8.rpy:49
translate italian jamie8_d41d8cd9:

    # voice "voices/jamie_022.mp3"        
    voice "voices/jamie_022.mp3"        

# game/Scenes/Jamie/jamie8.rpy:50
translate italian jamie8_f9831d1e:

    # gnd "I love you, [pcname]."
    gnd "Ti amo, [pcname]."

# game/Scenes/Jamie/jamie8.rpy:56
translate italian jamie8_b629d4db:

    # gnd "That feels good to say... and to hear."
    gnd "È bello dirlo... e sentirlo."

# game/Scenes/Jamie/jamie8.rpy:58
translate italian jamie8_4d7bfc98:

    # gnd "I really mean it too."
    gnd "E lo penso davvero."

# game/Scenes/Jamie/jamie8.rpy:60
translate italian jamie8_d41d8cd9_1:

    # voice "voices/jamie_019.mp3"
    voice "voices/jamie_019.mp3"

# game/Scenes/Jamie/jamie8.rpy:61
translate italian jamie8_8cee1605:

    # gnd "Ever since you came back, I've been feeling it building up, like my heart is growing bigger and bigger until it's close to bursting."
    gnd "Da quando sei tornato, sento che questo sentimento cresce, come se il mio cuore diventasse sempre più grande fino a sembrare sul punto di scoppiare."

# game/Scenes/Jamie/jamie8.rpy:63
translate italian jamie8_d41d8cd9_2:

    # voice "voices/jamie_020.mp3"
    voice "voices/jamie_020.mp3"

# game/Scenes/Jamie/jamie8.rpy:64
translate italian jamie8_55ac6cf8:

    # gnd "I smile every time I think about you, and I find myself thinking about you all the time."
    gnd "Sorrido ogni volta che penso a te, e mi ritrovo a pensare a te in continuazione."

# game/Scenes/Jamie/jamie8.rpy:67
translate italian jamie8_d41d8cd9_3:

    # voice "voices/jamie_021.mp3"
    voice "voices/jamie_021.mp3"

# game/Scenes/Jamie/jamie8.rpy:68
translate italian jamie8_a90d9888:

    # gnd "I'm completely in love with you, [pcname]. I just wanted you to know that."
    gnd "Sono completamente innamorata di te, [pcname]. Volevo solo che lo sapessi."

# game/Scenes/Jamie/jamie8.rpy:69
translate italian jamie8_9fc0bac9:

    # pc "I feel the same way, Jamie. You're amazing."
    pc "Provo la stessa cosa, Jamie. Sei fantastico."

# game/Scenes/Jamie/jamie8.rpy:71
translate italian jamie8_ff198159:

    # gnd "I'm so happy."
    gnd "Sono così felice."

# game/Scenes/Jamie/jamie8.rpy:72
translate italian jamie8_69aafc54:

    # "We talk a little longer about other less important things, until we're both practically falling asleep on the phone."
    "Parliamo ancora un po’ di altre cose meno importanti, finché non ci addormentiamo praticamente entrambi al telefono."

# game/Scenes/Jamie/jamie8.rpy:74
translate italian jamie8_fcdf2655:

    # gnd "I better get some sleep."
    gnd "È meglio che vada a dormire."

# game/Scenes/Jamie/jamie8.rpy:75
translate italian jamie8_fdc5f0f0:

    # pc "Yeah, me too."
    pc "Sì, anch’io."

# game/Scenes/Jamie/jamie8.rpy:77
translate italian jamie8_d41d8cd9_4:

    # voice "voices/jamie_010.mp3"
    voice "voices/jamie_010.mp3"

# game/Scenes/Jamie/jamie8.rpy:78
translate italian jamie8_63e5a3ef:

    # gnd "Good night, [pcname]. Love you."
    gnd "Buonanotte, [pcname]. Ti voglio bene."

# game/Scenes/Jamie/jamie8.rpy:79
translate italian jamie8_727173cd:

    # pc "Love you too, Jamie. Good night."
    pc "Anch’io ti voglio bene, Jamie. Buonanotte."

# game/Scenes/Jamie/jamie8.rpy:82
translate italian jamie8_a25f5d31:

    # gnd "I mean it."
    gnd "Dico sul serio."

# game/Scenes/Jamie/jamie8.rpy:84
translate italian jamie8_d41d8cd9_5:

    # voice "voices/jamie_019.mp3"
    voice "voices/jamie_019.mp3"

# game/Scenes/Jamie/jamie8.rpy:85
translate italian jamie8_796c0fbd:

    # gnd "Ever since you came back, I've been feeling it building up, like my heart growing bigger and bigger until it's almost bursting now."
    gnd "Da quando sei tornato, sento che questo sentimento cresce, come se il mio cuore diventasse sempre più grande, al punto che ora sta quasi per scoppiare."

# game/Scenes/Jamie/jamie8.rpy:87
translate italian jamie8_d41d8cd9_6:

    # voice "voices/jamie_020.mp3"
    voice "voices/jamie_020.mp3"

# game/Scenes/Jamie/jamie8.rpy:88
translate italian jamie8_0d1296eb:

    # gnd "I smile every time I think about you, and I find myself thinking about you a lot."
    gnd "Sorrido ogni volta che penso a te, e mi ritrovo a pensarti spesso."

# game/Scenes/Jamie/jamie8.rpy:90
translate italian jamie8_d41d8cd9_7:

    # voice "voices/jamie_021.mp3"
    voice "voices/jamie_021.mp3"

# game/Scenes/Jamie/jamie8.rpy:91
translate italian jamie8_a90d9888_1:

    # gnd "I'm completely in love with you, [pcname]. I just wanted you to know that."
    gnd "Sono completamente innamorata di te, [pcname]. Volevo solo che lo sapessi."

# game/Scenes/Jamie/jamie8.rpy:92
translate italian jamie8_fb4ce796:

    # pc "Oh, okay. Good to know."
    pc "Oh, ok. Buono a sapersi."

# game/Scenes/Jamie/jamie8.rpy:94
translate italian jamie8_5b0a7e45:

    # "We talk awkwardly a little bit longer about less important things, then there's just silence between us for a while."
    "Parliamo un po’ ancora, un po’ a disagio, di cose meno importanti, poi tra noi c’è solo silenzio per un po’."

# game/Scenes/Jamie/jamie8.rpy:95
translate italian jamie8_fcdf2655_1:

    # gnd "I better get some sleep."
    gnd "È meglio che vada a dormire."

# game/Scenes/Jamie/jamie8.rpy:96
translate italian jamie8_fdc5f0f0_1:

    # pc "Yeah, me too."
    pc "Sì, anch’io."

# game/Scenes/Jamie/jamie8.rpy:97
translate italian jamie8_76e2f41b:

    # gnd "Okay. Good night, [pcname]."
    gnd "Ok. Buonanotte, [pcname]."

# game/Scenes/Jamie/jamie8.rpy:98
translate italian jamie8_6fd39c33:

    # pc "Night!"
    pc "Notte!"

# game/Scenes/Jamie/jamie8.rpy:99
translate italian jamie8_39ca4ede:

    # "I hang up and go to sleep."
    "Riattacco e vado a dormire."

