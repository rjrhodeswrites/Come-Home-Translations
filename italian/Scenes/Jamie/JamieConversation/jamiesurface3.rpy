translate italian jamies3_93f44801:

    # gnd "Does coffee count?"
    gnd "Il caffè conta?"

# game/Scenes/Jamie/JamieConversation/jamiesurface3.rpy:17
translate italian jamies3_2cdd0d03:

    # pc "I mean, I guess. It's kind of a drink though, not a food."
