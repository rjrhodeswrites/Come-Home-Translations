    gnd "Ti è piaciuta?"

# game/Scenes/Jamie/jamie0.rpy:109
translate italian tvchatwithjamie_28b82c1c:

    # pc "Honestly, I couldn't really follow it, but what I saw was okay."
    pc "Onestamente, non sono riuscito a seguirla bene, ma quello che ho visto mi è piaciuto."

# game/Scenes/Jamie/jamie0.rpy:110
translate italian tvchatwithjamie_82d9fc6f:

