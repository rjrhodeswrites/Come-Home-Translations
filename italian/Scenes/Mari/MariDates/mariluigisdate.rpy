# game/Scenes/Mari/MariDates/mariluigisdate.rpy:28
translate italian mariluigisstartdate_1ee44fe2:

    # "Mari and I sit next to each other at one of the booths at Luigi's."
    "Io e Mari siamo sedute una accanto all’altra in uno dei separé da Luigi’s."

# game/Scenes/Mari/MariDates/mariluigisdate.rpy:29
translate italian mariluigisstartdate_0d18b373:

    # "We are chatting the whole time about this and that."
    "Chiacchieriamo per tutto il tempo di questo e quello."

# game/Scenes/Mari/MariDates/mariluigisdate.rpy:30
translate italian mariluigisstartdate_5bdbd1f6:

    # "The waitress comes by and takes our order, we continue talking."
    "La cameriera passa a prendere le nostre ordinazioni, noi continuiamo a parlare."

# game/Scenes/Mari/MariDates/mariluigisdate.rpy:34
translate italian mariluigisstartdate_f9e372f9:

    # "After a short time, the waitress brings our food out to us and we continue talking while we eat."
    "Dopo poco, la cameriera ci porta il cibo e continuiamo a parlare mentre mangiamo."

# game/Scenes/Mari/MariDates/mariluigisdate.rpy:37
translate italian mariluigisstartdate_54f7ac2e:

    # "We take our time eating while we talk, just enjoying one another's company."
    "Mangiamo con calma mentre chiacchieriamo, godendoci semplicemente la reciproca compagnia."

# game/Scenes/Mari/MariDates/mariluigisdate.rpy:40
translate italian mariluigisstartdate_764eafa0:

    # fr "Good salad, but the service here isn't great huh?"
    fr "L’insalata è buona, ma il servizio qui non è un granché, eh?"

# game/Scenes/Mari/MariDates/mariluigisdate.rpy:41
translate italian mariluigisstartdate_407731d1:

    # fr "Waiter didn't even face the dang silverware the correct way."
    fr "Il cameriere non ha nemmeno sistemato le posate nel modo giusto."

# game/Scenes/Mari/MariDates/mariluigisdate.rpy:42
translate italian mariluigisstartdate_c54b50c7:

    # pc "Well they can't all be as good as you."
    pc "Beh, non possono essere tutti bravi come te."

# game/Scenes/Mari/MariDates/mariluigisdate.rpy:44
translate italian mariluigisstartdate_a4da275d:

    # fr "Aww..."
    fr "Oh..."

# game/Scenes/Mari/MariDates/mariluigisdate.rpy:48
translate italian mariluigisstartdate_360f4aaa:

    # "When we're done with the meal, I pay the waitress and Mari and I walk out to the car together and start back towards her house."
    "Finito di mangiare, pago la cameriera e io e Mari usciamo insieme verso la macchina e ci dirigiamo verso casa sua."

