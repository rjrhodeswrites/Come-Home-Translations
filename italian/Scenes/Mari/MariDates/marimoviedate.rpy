# game/Scenes/Mari/MariDates/marimoviedate.rpy:26
translate italian marimovietheaterstartdate_0f1c479d:

    # "We get to the theater and get seats in the back."
    "Arriviamo al cinema e ci sediamo in fondo."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:27
translate italian marimovietheaterstartdate_d03e5a70:

    # fr "So what are we watching anyway?"
    fr "Allora, cosa andiamo a vedere?"

# game/Scenes/Mari/MariDates/marimoviedate.rpy:31
translate italian marimovietheaterstartdate_346436bf:

    # fr "Oh yeah?"
    fr "Ah sì?"

# game/Scenes/Mari/MariDates/marimoviedate.rpy:32
translate italian marimovietheaterstartdate_3aed9093:

    # fr "I love romance movies. As long as they're not too corny."
    fr "Adoro i film romantici. A patto che non siano troppo sdolcinati."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:35
translate italian marimovietheaterstartdate_337ed84d:

    # fr "Hrm, okay well that sounds fun."
    fr "Mmm, ok, beh, sembra divertente."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:36
translate italian marimovietheaterstartdate_7a1524b8:

    # fr "As long as it isn't just two buff guys slapping their meat together."
    fr "A patto che non siano solo due ragazzi muscolosi che si scambiano qualche pugno."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:38
translate italian marimovietheaterstartdate_d3cf7e4e:

    # fr "Actually, that sounds pretty fun too."
    fr "In realtà, anche quello sembra piuttosto divertente."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:43
translate italian marimovietheaterstartdate_d41d8cd9:

    # voice 'voices/mari_really.mp3'
    voice 'voices/mari_really.mp3'

# game/Scenes/Mari/MariDates/marimoviedate.rpy:44
translate italian marimovietheaterstartdate_67fd9cd9:

    # fr "Really?"
    fr "Davvero?"

# game/Scenes/Mari/MariDates/marimoviedate.rpy:45
translate italian marimovietheaterstartdate_8b77409f:

    # fr "I don't really do scary movies very well."
    fr "Non me la cavo molto bene con i film horror."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:46
translate italian marimovietheaterstartdate_cb84ad92:

    # fr "I might just have my eyes closed and be holding you through the whole thing."
    fr "Potrei semplicemente tenere gli occhi chiusi e stringerti a me per tutto il tempo."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:51
translate italian marimovietheaterstartdate_321fa232:

    # fr "Oh good, I need a good laugh."
    fr "Oh bene, ho proprio bisogno di farmi una bella risata."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:52
translate italian marimovietheaterstartdate_76b9da8b:

    # fr "As long as it's not one of those gross-out sex comedies. I'm not really into those."
    fr "Basta che non sia una di quelle commedie sessuali disgustose. Non mi piacciono molto."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:56
translate italian marimovietheaterstartdate_f3087137:

    # fr "Oh good! You know what I like."
    fr "Oh bene! Sai cosa mi piace."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:57
translate italian marimovietheaterstartdate_3224e393:

    # fr "I love animated stuff. Especially when it's about talking animals."
    fr "Adoro i film d’animazione. Soprattutto quando si tratta di animali parlanti."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:60
translate italian marimovietheaterstartdate_f45af0c0:

    # "There's a little time before the movie starts for us to chat."
    "C’è un po’ di tempo prima che inizi il film per chiacchierare un po’."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:64
translate italian marimovietheaterstartdate_592835a4:

    # "Finally the movie starts up and we go silent."
    "Finalmente il film inizia e restiamo in silenzio."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:66
translate italian marimovietheaterstartdate_fd60e14c:

    # "She reaches over and holds my hand on top of the arm rest."
    "Lei allunga la mano e mi prende la mano appoggiata sul bracciolo."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:67
translate italian marimovietheaterstartdate_aee76b2d:

    # "The trailers take up about fifteen minutes, then the movie really gets started."
    "I trailer durano circa quindici minuti, poi il film inizia davvero."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:71
translate italian marimovietheaterstartdate_17eefcb1:

    # "During the movie, she leans on my shoulder, really getting into the story."
    "Durante il film, lei si appoggia alla mia spalla, lasciandosi coinvolgere dalla storia."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:73
translate italian marimovietheaterstartdate_1b60b301:

    # "Then during a particularly romantic scene, she raises her head and puts her lips to mine."
    "Poi, durante una scena particolarmente romantica, alza la testa e avvicina le sue labbra alle mie."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:74
translate italian marimovietheaterstartdate_787192bc:

    # "We don't really watch a lot of the rest of the movie, instead focusing on making out."
    "Non guardiamo gran parte del resto del film, concentrandoci invece sui baci."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:77
translate italian marimovietheaterstartdate_d17a4ae6:

    # "During the movie, she leans against my shoulder, really getting into the story."
    "Durante il film, lei si appoggia alla mia spalla, lasciandosi coinvolgere dalla storia."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:80
translate italian marimovietheaterstartdate_284094da:

    # "Mari watches the movie, but I'm not really sure how much she likes it."
    "Mari guarda il film, ma non sono proprio sicuro di quanto le piaccia."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:83
translate italian marimovietheaterstartdate_26b74708:

    # "Eventually, she turns towards me and whispers."
    "Alla fine, si gira verso di me e mi sussurra."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:84
translate italian marimovietheaterstartdate_5aa661f3:

    # fr "I'm not really into this movie. Want to just make out?"
    fr "Questo film non mi piace molto. Che ne dici di baciarci e basta?"

# game/Scenes/Mari/MariDates/marimoviedate.rpy:86
translate italian marimovietheaterstartdate_d0a52fcf:

    # "I lean in and kiss her and we don't really watch much else of the movie, instead focusing on each other."
    "Mi avvicino e la bacio e non guardiamo più granché del film, concentrandoci invece l’uno sull’altra."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:89
translate italian marimovietheaterstartdate_ae5e6aa0:

    # "To give her some credit, she tries to watch a little bit of the movie."
    "A suo merito, cerca di guardare un po’ del film."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:90
translate italian marimovietheaterstartdate_c601de66:

    # "But by the time the scary parts start, she is pretty much done."
    "Ma quando iniziano le scene spaventose, ha praticamente perso interesse."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:92
translate italian marimovietheaterstartdate_fafc8629:

    # "She tucks her head down against me and hides the movie from her sight."
    "Appoggia la testa contro di me e nasconde lo schermo alla sua vista."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:93
translate italian marimovietheaterstartdate_324b6470:

    # "She stays right there, not watching anything for the rest of the movie."
    "Rimane lì, senza guardare nulla per il resto del film."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:96
translate italian marimovietheaterstartdate_b27a7e4c:

    # "Mari's eyes are focused on the movie throughout the whole thing."
    "Gli occhi di Mari sono fissi sullo schermo per tutta la durata del film."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:97
translate italian marimovietheaterstartdate_125a0ff3:

    # "She laughs, she cries, she taps her foot along with the music."
    "Ride, piange, batte il piede a tempo con la musica."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:98
translate italian marimovietheaterstartdate_e4a43b4e:

    # "We have a great time."
    "Ci divertiamo un mondo."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:101
translate italian marimovietheaterstartdate_8f27901e:

    # "The movie is pretty funny all the way through and Mari and I laugh a lot."
    "Il film è piuttosto divertente dall’inizio alla fine e io e Mari ridiamo un sacco."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:104
translate italian marimovietheaterstartdate_abcf9a29:

    # "Then somehow that turns into us making out."
    "Poi, in qualche modo, finiamo per baciarci."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:105
translate italian marimovietheaterstartdate_46b84a07:

    # "We don't really watch much of the movie after that."
    "Da quel momento in poi non guardiamo più granché del film."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:106
translate italian marimovietheaterstartdate_d855e56b:

    # "Eventually the movie ends and the credits start rolling."
    "Alla fine il film finisce e iniziano i titoli di coda."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:109
translate italian marimovietheaterstartdate_f176d1eb:

    # fr "That was a cute movie."
    fr "È stato un film carino."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:111
translate italian marimovietheaterstartdate_b1836b04:

    # fr "What little I saw of it anyway."
    fr "Per quel poco che ne ho visto, comunque."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:112
translate italian marimovietheaterstartdate_91db2110:

    # fr "I like what we did even more than the movie."
    fr "Mi è piaciuto quello che abbiamo fatto ancora più del film."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:113
translate italian marimovietheaterstartdate_e25ed9ba:

    # fr "Thanks for taking me."
    fr "Grazie per avermi portato."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:116
translate italian marimovietheaterstartdate_eb286352:

    # fr "Well the movie wasn't really my thing."
    fr "Beh, il film non era proprio il mio genere."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:118
translate italian marimovietheaterstartdate_8fc45fba:

    # fr "But seeing it with you made it a lot better."
    fr "Ma vederlo con te l’ha reso molto più bello."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:121
translate italian marimovietheaterstartdate_c58b0ecd:

    # fr "I'm a big baby, I know."
    fr "Sono un gran piagnucolone, lo so."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:122
translate italian marimovietheaterstartdate_acdb9025:

    # fr "But I hated that. Even when I stopped watching it, the noises were still scary."
    fr "Ma l’ho odiato. Anche quando ho smesso di guardarlo, i rumori mi facevano ancora paura."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:123
translate italian marimovietheaterstartdate_26d0b7c9:

    # pc "I'm sorry, I didn't realize that you disliked horror movies so much."
    pc "Mi dispiace, non mi ero reso conto che ti piacessero così poco i film horror."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:124
translate italian marimovietheaterstartdate_30078caa:

    # fr "They just bring back bad memories and make me think about sad things."
    fr "Mi riportano solo brutti ricordi e mi fanno pensare a cose tristi."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:127
translate italian marimovietheaterstartdate_c3aec289:

    # fr "That movie was so cute! I loved it!"
    fr "Quel film era così carino! L’ho adorato!"

# game/Scenes/Mari/MariDates/marimoviedate.rpy:128
translate italian marimovietheaterstartdate_070969bf:

    # fr "Thanks so much for bringing me."
    fr "Grazie mille per avermi portato con te."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:131
translate italian marimovietheaterstartdate_4549f151:

    # fr "That was a fun movie."
    fr "È stato un film divertente."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:133
translate italian marimovietheaterstartdate_b1836b04_1:

    # fr "What little I saw of it anyway."
    fr "Per quel poco che ne ho visto, comunque."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:134
translate italian marimovietheaterstartdate_91db2110_1:

    # fr "I like what we did even more than the movie."
    fr "Mi è piaciuto ancora di più quello che abbiamo fatto insieme rispetto al film."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:135
translate italian marimovietheaterstartdate_233f5bf6:

    # "When the credits start rolling, we hang out and chat through them."
    "Quando iniziano i titoli di coda, restiamo lì a chiacchierare."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:139
translate italian marimovietheaterstartdate_972891e3:

    # "When the credits end, we walk outside together and out to my car."
    "Quando finiscono i titoli di coda, usciamo insieme e andiamo alla mia auto."

translate italian strings:

    # game/Scenes/Mari/MariDates/marimoviedate.rpy:2
    old "When you are able to ask Mari out on a date, take her to the movie theater."
    new "Quando riuscirai a chiedere a Mari di uscire con te, portala al cinema."

    # game/Scenes/Mari/MariDates/marimoviedate.rpy:3
    old "She will only be able to go to the movies in the evening on weekends."
    new "Potrà andare al cinema solo la sera nei fine settimana."

    # game/Scenes/Mari/MariDates/marimoviedate.rpy:54
    old "Something animated"
    new "Qualcosa di animato"

