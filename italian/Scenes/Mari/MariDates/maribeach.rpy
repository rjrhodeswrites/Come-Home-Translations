# game/Scenes/Mari/MariDates/maribeach.rpy:13
translate italian maribeachdate_a63d5d5c:

    # fr "The beach sounds amazing! I'll go get in my swimsuit! Come get me."
    fr "La spiaggia sembra fantastica! Vado a mettermi il costume! Vieni a prendermi."

# game/Scenes/Mari/MariDates/maribeach.rpy:14
translate italian maribeachdate_8caa4a9c:

    # pc "On my way."
    pc "Sto arrivando."

# game/Scenes/Mari/MariDates/maribeach.rpy:21
translate italian maribeachdate_40c18b34:

    # "I pick Mari up and we drive out towards the beach."
    "Passo a prendere Mari e partiamo verso la spiaggia."

# game/Scenes/Mari/MariDates/maribeach.rpy:23
translate italian maribeachdate_427f3be4:

    # fr "I haven't been to the beach in forever."
    fr "Non vado in spiaggia da una vita."

# game/Scenes/Mari/MariDates/maribeach.rpy:24
translate italian maribeachdate_e5624fc2:

    # fr "This is going to be so fun."
    fr "Sarà divertentissimo."

# game/Scenes/Mari/MariDates/maribeach.rpy:29
translate italian maribeachdate_b9c9e980:

    # pc "You look incredible."
    pc "Sei bellissima."

# game/Scenes/Mari/MariDates/maribeach.rpy:30
translate italian maribeachdate_8a5a041f:

    # fr "Thanks, honey. The water is so pretty. Let's get in."
    fr "Grazie, tesoro. L’acqua è così bella. Entriamo in acqua."

# game/Scenes/Mari/MariDates/maribeach.rpy:33
translate italian maribeachdate_93419ef3:

    # "We spend some time swimming around and chatting."
    "Passiamo un po’ di tempo a nuotare e a chiacchierare."

# game/Scenes/Mari/MariDates/maribeach.rpy:36
translate italian maribeachdate_0e1a2c64:

    # "We spend a little longer making out, our bodies pressed against each other underwater."
    "Passiamo ancora un po’ di tempo a baciarci, con i nostri corpi premuti l’uno contro l’altro sott’acqua."

# game/Scenes/Mari/MariDates/maribeach.rpy:39
translate italian maribeachdate_c4765999:

    # "After a while, we're both tired from swimming and the sun is starting to set, so we lie on the beach and dry off."
    "Dopo un po’, siamo entrambi stanchi per aver nuotato e il sole sta cominciando a tramontare, quindi ci sdraiamo sulla spiaggia e ci asciugiamo."

# game/Scenes/Mari/MariDates/maribeach.rpy:40
translate italian maribeachdate_3d2f7709:

    # "We lean back and talk for a while about whatever comes to mind."
    "Ci sdraiamo all’indietro e parliamo per un po’ di qualsiasi cosa ci venga in mente."

# game/Scenes/Mari/MariDates/maribeach.rpy:50
translate italian maribeachdate_67f91a9e:

    # "When the sun starts to dip below the horizon, we take a moment to watch it together."
    "Quando il sole comincia a calare sotto l’orizzonte, ci prendiamo un momento per guardarlo insieme."

# game/Scenes/Mari/MariDates/maribeach.rpy:52
translate italian maribeachdate_0b6982cc:

    # fr "It's so beautiful."
    fr "È così bello."

# game/Scenes/Mari/MariDates/maribeach.rpy:53
translate italian maribeachdate_91de8c28:

    # fr "Thanks for bringing me here."
    fr "Grazie per avermi portato qui."

# game/Scenes/Mari/MariDates/maribeach.rpy:58
translate italian maribeachdate_e10b5f4e:

    # "We kiss and it's like lightning between our lips. It warms me from my heart outward."
    "Ci baciamo ed è come un fulmine tra le nostre labbra. Mi riscalda dal cuore in fuori."

# game/Scenes/Mari/MariDates/maribeach.rpy:63
translate italian maribeachdate_4462906b:

    # fr "Are you ready to go back to my place?"
    fr "Sei pronta a tornare a casa mia?"

# game/Scenes/Mari/MariDates/maribeach.rpy:64
translate italian maribeachdate_61f77a4c:

    # pc "Sure."
    pc "Certo."

# game/Scenes/Mari/MariDates/maribeach.rpy:65
translate italian maribeachdate_63a75f93:

    # fr "Good, because I'm ready to get out of this swimsuit. And to get you out of yours."
    fr "Bene, perché sono pronto a togliermi questo costume da bagno. E a togliere il tuo."

# game/Scenes/Mari/MariDates/maribeach.rpy:69
translate italian maribeachdate_69da3812:

    # "When the sun sets, I drive us back to her house."
    "Quando il sole tramonta, guido fino a casa sua."

# game/Scenes/Mari/MariDates/maribeach.rpy:70
translate italian maribeachdate_e3551ef8:

    # fr "So... are you coming inside?"
    fr "Allora... entri?"

# game/Scenes/Mari/MariDates/maribeach.rpy:73
translate italian maribeachdate_b1aed98f:

    # fr "Good. Let's go."
    fr "Bene. Andiamo."

# game/Scenes/Mari/MariDates/maribeach.rpy:80
translate italian maribeachdate_b1aed98f_1:

    # fr "Good. Let's go."
    fr "Bene. Andiamo."

# game/Scenes/Mari/MariDates/maribeach.rpy:88
translate italian maribeachdate_92c16c18:

    # fr "Dang, really? Too busy for little ol' me tonight?"
    fr "Cavolo, davvero? Troppo occupata per la piccola vecchia me stasera?"

# game/Scenes/Mari/MariDates/maribeach.rpy:89
translate italian maribeachdate_ea7c5dae:

    # fr "Fine. Good night then."
    fr "Va bene. Buona notte allora."

# game/Scenes/Mari/MariDates/maribeach.rpy:92
translate italian maribeachdate_8b93ebfd:

    # "I wait until she gets out and walks into her house before I drive away."
    "Aspetto che esca ed entri in casa prima di andarmene."

translate italian strings:

    # game/Scenes/Mari/MariDates/maribeach.rpy:3
    old "When you are able to ask Mari out on a date, and you have unlocked the beach through Suzy's path, invite Mari to the beach."
    new "Quando riesci a chiedere a Mari di uscire con te e hai sbloccato la spiaggia tramite il percorso di Suzy, invita Mari in spiaggia."

    # game/Scenes/Mari/MariDates/maribeach.rpy:4
    old "She is available to date any time before night on the weekends."
    new "È disponibile per un appuntamento in qualsiasi momento prima di sera nei fine settimana."

