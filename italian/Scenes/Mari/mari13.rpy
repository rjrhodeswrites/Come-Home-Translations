    # fr "Oh, cool! That would be great."
    fr "Oh, fantastico! Sarebbe perfetto."

# game/Scenes/Mari/mari13.rpy:120
translate italian mari13phone_28ca97d1:

    # pc "Okay, I'll call her real quick. Just a sec."
    pc "Ok, la chiamo subito. Solo un secondo."

# game/Scenes/Mari/mari13.rpy:127
translate italian mari13rebahelp_589dd85f:

    # pc "Hey, Reba? You busy?"
    pc "Ehi, Reba? Sei occupata?"

# game/Scenes/Mari/mari13.rpy:128
translate italian mari13rebahelp_c6aaa4b5:

    # rb "Naw, what's up?"
    rb "No, che succede?"

# game/Scenes/Mari/mari13.rpy:129
translate italian mari13rebahelp_6033c0b7:

    # pc "I have a friend whose truck isn't starting and I was wondering..."
    pc "Ho un'amica il cui furgone non parte e mi chiedevo..."

# game/Scenes/Mari/mari13.rpy:131
translate italian mari13rebahelp_c2ea06eb:

    # rb "Gimme the address and I'm on my way!"
    rb "Dammi l'indirizzo e arrivo subito!"

# game/Scenes/Mari/mari13.rpy:132
translate italian mari13rebahelp_a8e3c862:

    # pc "Haha, okay."
    pc "Ah ah, ok."

# game/Scenes/Mari/mari13.rpy:135
translate italian mari13rebahelp_ee70a372:

    # "I give Reba directions to Mari's farm and a few minutes later she meets us there."
    "Do a Reba le indicazioni per la fattoria di Mari e pochi minuti dopo ci raggiunge lì."

# game/Scenes/Mari/mari13.rpy:138
translate italian mari13rebahelp_05b2461c:

    # rb "Oh my God! Your dogs are {i}so{/i} cute."
    rb "Oh mio Dio! I tuoi cani sono {i}così{/i} carini."

# game/Scenes/Mari/mari13.rpy:139
translate italian mari13rebahelp_22df0ba2:

    # fr "They seem to like you."
    fr "Sembra che tu gli piaccia."

# game/Scenes/Mari/mari13.rpy:140
translate italian mari13rebahelp_68c9b491:

    # rb "What's their names?"
    rb "Come si chiamano?"

# game/Scenes/Mari/mari13.rpy:142
translate italian mari13rebahelp_d41d8cd9:

    # voice 'voices/mari_appaandmomo.mp3'
    voice 'voices/mari_appaandmomo.mp3'

# game/Scenes/Mari/mari13.rpy:143
translate italian mari13rebahelp_0ede8f0a:

    # fr "The big one is Appa, and the little guy is Momo."
    fr "Quello grande si chiama Appa, e il piccoletto è Momo."

# game/Scenes/Mari/mari13.rpy:144
translate italian mari13rebahelp_b4839da7:

    # rb "Oh my God, I love them!"
    rb "Oh mio Dio, li adoro!"

# game/Scenes/Mari/mari13.rpy:147
translate italian mari13rebahelp_34d27c0e:

    # rb "You didn't tell me that I was fixin' this car for a cute girlfriend of yours, [pcname]."
    rb "Non mi avevi detto che stavo riparando questa macchina per una tua carina fidanzata, [pcname]."

# game/Scenes/Mari/mari13.rpy:148
translate italian mari13rebahelp_be9414f2:

    # pc "Oh, sorry."
    pc "Oh, scusa."

# game/Scenes/Mari/mari13.rpy:149
translate italian mari13rebahelp_380ac7ef:

    # rb "Naw, it's no problem, I'm just messin'."
    rb "No, nessun problema, stavo solo scherzando."

# game/Scenes/Mari/mari13.rpy:151
translate italian mari13rebahelp_f7c6563e:

    # rb "Aw, hey I remember you from the burger place."
    rb "Ah, ehi, mi ricordo di te dal locale degli hamburger."

# game/Scenes/Mari/mari13.rpy:152
translate italian mari13rebahelp_11d0fe17:

    # fr "Hey, yeah that's me."
    fr "Ehi, sì, sono io."

# game/Scenes/Mari/mari13.rpy:154
translate italian mari13rebahelp_2acf7aec:

    # rb "I'm Reba, by the way."
    rb "A proposito, mi chiamo Reba."

# game/Scenes/Mari/mari13.rpy:155
translate italian mari13rebahelp_6f785a5d:

    # fr "Hello. I'm Mari. Nice to meet you."
    fr "Ciao. Io sono Mari. Piacere di conoscerti."

# game/Scenes/Mari/mari13.rpy:156
translate italian mari13rebahelp_a9aba0f6:

    # rb "Okay, let's see what this thing is doing."
    rb "Ok, vediamo come funziona questa macchina."

# game/Scenes/Mari/mari13.rpy:159
translate italian mari13rebahelp_1a16e9d4:

    # rb "So how long you say it's been sitting here?"
    rb "Allora, da quanto tempo dici che sta ferma qui?"

# game/Scenes/Mari/mari13.rpy:160
translate italian mari13rebahelp_8ebf8623:

    # fr "About four years."
    fr "Circa quattro anni."

# game/Scenes/Mari/mari13.rpy:161
translate italian mari13rebahelp_90a271fa:

    # rb "Alright, and y'all replaced the battery already, so that's good."
    rb "Va bene, e avete già sostituito la batteria, quindi questo è un bene."

# game/Scenes/Mari/mari13.rpy:162
translate italian mari13rebahelp_22d6811f:

    # rb "I'm gonna try a few things, but I expect we'll have to change the gas in the tank, because it's probably gone bad."
    rb "Proverò a fare qualche controllo, ma immagino che dovremo cambiare la benzina nel serbatoio, perché probabilmente si è deteriorata."

# game/Scenes/Mari/mari13.rpy:163
translate italian mari13rebahelp_2dc05954:

    # rb "And I'll clean out the air filter and change the oil and might have to replace the fuel pump too."
    rb "Pulirò il filtro dell’aria, cambierò l’olio e potrei dover sostituire anche la pompa del carburante."

# game/Scenes/Mari/mari13.rpy:164
translate italian mari13rebahelp_1bccde91:

    # rb "Then after all that, if the engine starts, we'll have to get those tires aired up. They don't look like they've rotted, which is good. Hopefully they'll still hold air."
    rb "Poi, dopo tutto questo, se il motore si avvia, dovremo gonfiare quelle gomme. Non sembrano marce, il che è un bene. Speriamo che trattengano ancora l’aria."

# game/Scenes/Mari/mari13.rpy:168
translate italian mari13rebahelp_d41d8cd9_1:

    # voice 'voices/mari_shoot1.mp3'
    voice 'voices/mari_shoot1.mp3'

# game/Scenes/Mari/mari13.rpy:169
translate italian mari13rebahelp_8f74c366:

    # fr "Aw, shoot. How much is all of that going to cost?"
    fr "Oh, cavolo. Quanto costerà tutto questo?"

# game/Scenes/Mari/mari13.rpy:170
translate italian mari13rebahelp_8f3b3d9a:

    # rb "I can get you a new fuel pump for about $100. New oil filter and oil is like $30. Then just a tank of gas to replace the old junk."
    rb "Posso procurarti una nuova pompa del carburante per circa 100 dollari. Il filtro dell’olio nuovo e l’olio costano circa 30 dollari. Poi basta un pieno di benzina per sostituire quella vecchia robaccia."

# game/Scenes/Mari/mari13.rpy:171
translate italian mari13rebahelp_428bb652:

    # rb "And all the labor is on the house, because I like that guy over there, and you seem like a pretty cool chick too."
    rb "E tutta la manodopera è offerta dalla casa, perché mi piace quel ragazzo laggiù, e anche tu mi sembri una ragazza piuttosto in gamba."

# game/Scenes/Mari/mari13.rpy:172
translate italian mari13rebahelp_3eeb60d9:

    # rb "Y'all just gotta hang out and keep me company and hand me junk when I ask for it, alright?"
    rb "Dovete solo stare qui con me, tenermi compagnia e passarmi gli attrezzi quando ve li chiedo, va bene?"

# game/Scenes/Mari/mari13.rpy:174
translate italian mari13rebahelp_d41d8cd9_2:

    # voice 'voices/mari_surething2.mp3'
    voice 'voices/mari_surething2.mp3'

# game/Scenes/Mari/mari13.rpy:175
translate italian mari13rebahelp_9af4e82f:

    # fr "Sure thing!"
    fr "Certo che sì!"

# game/Scenes/Mari/mari13.rpy:178
translate italian mari13rebahelp_ab992a3c:

    # rb "So you don't drive?"
    rb "Quindi non guidi?"

# game/Scenes/Mari/mari13.rpy:179
translate italian mari13rebahelp_205c26d0:

    # fr "No, I haven't ever learned. My parents were killed in a car accident and I've been kind of scared of them since then."
    fr "No, non ho mai imparato. I miei genitori sono morti in un incidente d’auto e da allora ne ho un po’ paura."

# game/Scenes/Mari/mari13.rpy:180
translate italian mari13rebahelp_b0f6c8c0:

    # rb "Aw dang, I'm sorry. My daddy's gone too. I know it hurts."
    rb "Cavolo, mi dispiace. Anche mio papà non c’è più. So che fa male."

# game/Scenes/Mari/mari13.rpy:181
translate italian mari13rebahelp_254e65aa:

    # fr "Yeah it does. But I'm ready to learn how to drive now. I think I need to."
    fr "Sì, è vero. Ma ora sono pronta a imparare a guidare. Penso di averne bisogno."

# game/Scenes/Mari/mari13.rpy:182
translate italian mari13rebahelp_d2c576b2:

    # rb "Yeah, we'll get this truck going and you can drive all over the place."
    rb "Sì, metteremo in moto questo furgone e potrai andare in giro ovunque."

# game/Scenes/Mari/mari13.rpy:185
translate italian mari13rebahelp_28f72a61:

    # rb "So you and [pcname]. Are you two serious?"
    rb "Quindi tu e [pcname]. Voi due fate sul serio?"

# game/Scenes/Mari/mari13.rpy:186
translate italian mari13rebahelp_1ac8f72e:

    # fr "Yeah, I think so."
    fr "Sì, penso di sì."

# game/Scenes/Mari/mari13.rpy:187
translate italian mari13rebahelp_f2f3bd20:

    # rb "But you're okay that he's been dating me too?"
    rb "Ma ti sta bene che lui stia uscendo anche con me?"

# game/Scenes/Mari/mari13.rpy:188
translate italian mari13rebahelp_93575294:

    # fr "I'm not sure. Like, I want to be with him only, but we're not married and I'm okay with not being exclusive for now."
    fr "Non ne sono sicura. Cioè, vorrei stare solo con lui, ma non siamo sposati e per ora mi va bene non avere una relazione esclusiva."

