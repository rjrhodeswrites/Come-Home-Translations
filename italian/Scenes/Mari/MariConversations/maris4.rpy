translate italian maris4_7b389c9e:

    # fr "That's cool. I don't expect us to both like the exact same things, you know?"
    fr "È fantastico. Non mi aspetto che ci piacciano esattamente le stesse cose, capisci?"

# game/Scenes/Mari/MariConversations/maris4.rpy:34
translate italian maris4_b1a6e571:

