translate italian marip5_89cc1bc0:

    # fr "I didn't have sex until I was 19."
    fr "Non ho fatto sesso fino a quando non ho compiuto 19 anni."

# game/Scenes/Mari/MariConversations/marip5.rpy:15
translate italian marip5_3031973d:

    # fr "It was this guy I used to talk to online."
    fr "Era questo ragazzo con cui parlavo online."

# game/Scenes/Mari/MariConversations/marip5.rpy:16
translate italian marip5_d74e1a2d:

    # fr "We had a meet-up with this group that I was a part of and I ended up sleeping with him."
    fr "Abbiamo organizzato un incontro con questo gruppo di cui facevo parte e alla fine sono andata a letto con lui."

# game/Scenes/Mari/MariConversations/marip5.rpy:18
translate italian marip5_65225a8b:

    # fr "It was fun. Nothing serious or anything, neither of us wanted that."
    fr "È stato divertente. Niente di serio o del genere, nessuno dei due lo voleva."

# game/Scenes/Mari/MariConversations/marip5.rpy:20
translate italian marip5_4f010305:

    # fr "I think he's married now. I haven't even thought about him in forever."
    fr "Credo che ora sia sposato. È da una vita che non penso più a lui."

# game/Scenes/Mari/MariConversations/marip5.rpy:22
translate italian marip5_9f0faf8b:

    # fr "I can't even remember his real name. His screen name was Robin_h00d, with the zeros for the O's."
    fr "Non ricordo nemmeno il suo vero nome. Il suo nickname era Robin_h00d, con gli zeri al posto delle O."

# game/Scenes/Mari/MariConversations/marip5.rpy:23
translate italian marip5_c8a7912a:

    # fr "Hah, kind of sad that I can't remember the real name of the first guy I slept with."
    fr "Ah, è un po’ triste che non riesca a ricordare il vero nome del primo ragazzo con cui sono andata a letto."

# game/Scenes/Mari/MariConversations/marip5.rpy:24
translate italian marip5_027f7286:

    # fr "Oh well, doesn't matter."
    fr "Vabbè, non importa."

