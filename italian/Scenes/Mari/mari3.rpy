# game/Scenes/Mari/mari3.rpy:12
translate italian mari3_d41d8cd9:

    # voice 'voices/mari_heythere.mp3'
    voice 'voices/mari_heythere.mp3'

# game/Scenes/Mari/mari3.rpy:13
translate italian mari3_5fec8fcf:

    # fr "Hey there, [pcname]. How are you today?"
    fr "Ehi, [pcname]. Come stai oggi?"

# game/Scenes/Mari/mari3.rpy:14
translate italian mari3_b835b9eb:

    # pc "I'm doing great, how's my favorite waitress?"
    pc "Sto benissimo, e la mia cameriera preferita?"

# game/Scenes/Mari/mari3.rpy:15
translate italian mari3_334e62bd:

    # fr "Much better now that her favorite customer is here."
    fr "Molto meglio ora che il suo cliente preferito è qui."

# game/Scenes/Mari/mari3.rpy:20
translate italian mari3_747e36cd:

    # pc "Mari, there was something I wanted to ask you."
    pc "Mari, c'era una cosa che volevo chiederti."

# game/Scenes/Mari/mari3.rpy:21
translate italian mari3_96d48818:

    # fr "Ask away."
    fr "Chiedi pure."

# game/Scenes/Mari/mari3.rpy:22
translate italian mari3_05be9386:

    # pc "Would you want to go out on a date with me sometime?"
    pc "Ti andrebbe di uscire con me qualche volta?"

# game/Scenes/Mari/mari3.rpy:25
translate italian mari3_d41d8cd9_1:

    # voice 'voices/mari_idloveto.mp3'
    voice 'voices/mari_idloveto.mp3'

# game/Scenes/Mari/mari3.rpy:26
translate italian mari3_ad1c3ebd:

    # fr "Really? I'd love to."
    fr "Davvero? Mi piacerebbe tantissimo."

# game/Scenes/Mari/mari3.rpy:27
translate italian mari3_1da24e01:

    # pc "Awesome."
    pc "Fantastico."

# game/Scenes/Mari/mari3.rpy:29
translate italian mari3_008e9d39:

    # fr "I don't get to go out on dates very often, and I do really like you."
    fr "Non mi capita spesso di uscire con qualcuno, e tu mi piaci davvero tanto."

# game/Scenes/Mari/mari3.rpy:30
translate italian mari3_098a6e78:

    # fr "I'm busy a lot, but I'll give you my phone number and maybe we could go out in the evening on a weekend sometime?"
    fr "Sono molto impegnata, ma ti darò il mio numero di telefono e magari potremmo uscire una sera nel fine settimana, qualche volta?"

# game/Scenes/Mari/mari3.rpy:31
translate italian mari3_d2954fc0:

    # pc "That sounds great."
    pc "Mi sembra un'ottima idea."

# game/Scenes/Mari/mari3.rpy:32
translate italian mari3_52d8f6ae:

    # fr "Oh I'm so excited."
    fr "Oh, sono così emozionata."

# game/Scenes/Mari/mari3.rpy:34
translate italian mari3_e7685f1d:

    # fr "Here's my phone number."
    fr "Ecco il mio numero di telefono."

# game/Scenes/Mari/mari3.rpy:36
translate italian mari3_639d3c6f:

    # fr "You can call me any time, but I won't be able to talk while I'm working, and I work a lot!"
    fr "Puoi chiamarmi in qualsiasi momento, ma non potrò parlare mentre lavoro, e lavoro tantissimo!"

# game/Scenes/Mari/mari3.rpy:37
translate italian mari3_73bf0030:

    # pc "I'll definitely give you a call sometime."
    pc "Ti chiamerò sicuramente prima o poi."

# game/Scenes/Mari/mari3.rpy:38
translate italian mari3_c2bff929:

    # fr "Good, I can't wait!"
    fr "Bene, non vedo l’ora!"

# game/Scenes/Mari/mari3.rpy:39
translate italian mari3_910292d4:

    # fr "I better go get your food."
    fr "È meglio che vada a prenderti da mangiare."

# game/Scenes/Mari/mari3.rpy:40
translate italian mari3_63023601:

    # pc "Okay."
    pc "Ok."

# game/Scenes/Mari/mari3.rpy:42
translate italian mari3_0aa5dfbc:

    # "She starts to walk away, then looks back at me."
    "Comincia ad allontanarsi, poi si volta a guardarmi."

# game/Scenes/Mari/mari3.rpy:43
translate italian mari3_8f6f1358:

    # fr "Thanks for asking me out. I'm really looking forward to our date."
    fr "Grazie per avermi invitata. Non vedo davvero l’ora che arrivi il nostro appuntamento."

# game/Scenes/Mari/mari3.rpy:44
translate italian mari3_03eaad50:

    # pc "Me too."
    pc "Anch’io."

# game/Scenes/Mari/mari3.rpy:45
translate italian mari3_7553af6a:

    # "With that, she smiles and leaves to get my food."
    "Detto questo, sorride e se ne va a prendermi da mangiare."

# game/Scenes/Mari/mari3.rpy:47
translate italian mari3_43045d37:

    # "We don't talk much more while I eat and she has to help other customers, but every time she looks at me, she's smiling."
    "Non parliamo molto mentre mangio e lei deve servire altri clienti, ma ogni volta che mi guarda, sorride."

# game/Scenes/Mari/mari3.rpy:48
translate italian mari3_2d44a908:

    # "The smile is different than usual. More sincere almost."
    "È un sorriso diverso dal solito. Quasi più sincero."

# game/Scenes/Mari/mari3.rpy:51
translate italian maritip3_474b8780:

    # "I leave 10 dollars on the table."
    "Lascio 10 dollari sul tavolo."

# game/Scenes/Mari/mari3.rpy:53
translate italian maritip3_bbc6048f:

    # "No need to leave money, I'll give her something better later."
    "Non c’è bisogno di lasciare soldi, le darò qualcosa di meglio più tardi."

# game/Scenes/Mari/mari3.rpy:55
translate italian maritip3_c56febff:

    # "Then I start to walk out towards my car."
    "Poi mi avvio verso la mia auto."

# game/Scenes/Mari/mari3.rpy:58
translate italian maritip3_e3c07fca:

    # "Mari stops me though, wrapping her arms around me and pulling me into a hug."
    "Mari però mi ferma, mi avvolge le braccia intorno alla vita e mi stringe in un abbraccio."

# game/Scenes/Mari/mari3.rpy:59
translate italian maritip3_7db5e01d:

    # fr "I can't wait to see you again."
    fr "Non vedo l’ora di rivederti."

# game/Scenes/Mari/mari3.rpy:60
translate italian maritip3_98e7787f:

    # fr "Be sure you call me."
    fr "Assicurati di chiamarmi."

# game/Scenes/Mari/mari3.rpy:61
translate italian maritip3_5bc44b07:

    # pc "I will."
    pc "Lo farò."

# game/Scenes/Mari/mari3.rpy:62
translate italian maritip3_2e512b95:

    # fr "Okay, take care."
    fr "Ok, stammi bene."

# game/Scenes/Mari/mari3.rpy:65
translate italian maritip3_5794a059:

    # "She releases me and I go outside. She's really excited about our date it seems."
    "Mi lascia andare ed esco. Sembra davvero entusiasta del nostro appuntamento."

# game/Scenes/Mari/mari3.rpy:66
translate italian maritip3_f0d4672c:

    # "I'm excited too. It should be fun."
    "Anch’io sono entusiasta. Dovrebbe essere divertente."

