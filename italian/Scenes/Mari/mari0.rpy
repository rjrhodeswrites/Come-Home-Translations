translate italian mari0_268d9953:

    # "After about five minutes, a young woman with beautiful curly hair and an even prettier smile walks up with my order."
    "Dopo circa cinque minuti, una giovane donna con bellissimi capelli ricci e un sorriso ancora più bello si avvicina con la mia ordinazione."

# game/Scenes/Mari/mari0.rpy:14
translate italian mari0_61ae3800:

    # fr "Hey there. This must be yours."
    fr "Ehi, ciao. Questo deve essere tuo."

# game/Scenes/Mari/mari0.rpy:16
translate italian mari0_d41d8cd9:

    # voice 'voices/mari_immariwaitress.mp3'
    voice 'voices/mari_immariwaitress.mp3'

# game/Scenes/Mari/mari0.rpy:17
translate italian mari0_83cd92ec:

    # fr "I'm Mari. I'll be your waitress today."
    fr "Mi chiamo Mari. Oggi sarò la tua cameriera."

# game/Scenes/Mari/mari0.rpy:18
translate italian mari0_0a82c299:

    # fr "You just let me know if you need anything else."
    fr "Fammi sapere se hai bisogno di qualcos’altro."

# game/Scenes/Mari/mari0.rpy:19
translate italian mari0_f711eed2:

    # "She gives me a smile and puts the food down on the table."
    "Mi sorride e appoggia il cibo sul tavolo."

# game/Scenes/Mari/mari0.rpy:23
translate italian mari0_84e54e6e:

    # "She blushes a bit and playfully slaps my shoulder."
    "Arrossisce un po’ e mi dà una pacca scherzosa sulla spalla."

# game/Scenes/Mari/mari0.rpy:24
translate italian mari0_967f0281:

    # fr "You're just a charmer, aren't you?"
    fr "Sei proprio un incantatore, vero?"

# game/Scenes/Mari/mari0.rpy:27
translate italian mari0_d41d8cd9_1:

    # voice marisurething
    voice marisurething

# game/Scenes/Mari/mari0.rpy:28
translate italian mari0_9af4e82f:

    # fr "Sure thing!"
    fr "Certo!"

# game/Scenes/Mari/mari0.rpy:31
translate italian mari0_d41d8cd9_2:

    # voice marisurething
    voice marisurething

# game/Scenes/Mari/mari0.rpy:32
translate italian mari0_22159de4:

    # fr "Sure thing! I'll bring it right out."
    fr "Certo! Te lo porto subito."

# game/Scenes/Mari/mari0.rpy:33
translate italian mari0_55ee1584:

    # "She runs to the back and gets the ketchup, then quickly returns with it."
    "Corre in cucina a prendere il ketchup, poi torna rapidamente con esso."

# game/Scenes/Mari/mari0.rpy:34
translate italian mari0_fe5173b6:

    # fr "Just give me a holler if I can do anything else for you."
    fr "Fammi un fischio se posso fare qualcos’altro per te."

# game/Scenes/Mari/mari0.rpy:37
translate italian mari0_d0ec727b:

    # "She walks over to a nearby table, pulls out a rag, and starts wiping it down, bending over just enough to give me a good view of her ass."
    "Si avvicina a un tavolo lì vicino, tira fuori uno straccio e inizia a pulirlo, chinandosi quel tanto che basta per farmi vedere bene il suo culo."

# game/Scenes/Mari/mari0.rpy:40
translate italian mari0_8458142b:

    # "And damn, that's a nice ass."
    "E cavolo, che bel culo."

# game/Scenes/Mari/mari0.rpy:43
translate italian mari0_a58a4782:

    # "I eat my food and Mari returns a couple more times to give me a refill on my drink."
    "Mangio il mio pasto e Mari torna un altro paio di volte per riempirmi il bicchiere."

# game/Scenes/Mari/mari0.rpy:46
translate italian mari0_cc46d500:

    # "Then when I'm finished, I stand up and give her a smile and a wave."
    "Poi, quando ho finito, mi alzo e le faccio un sorriso e un cenno con la mano."

# game/Scenes/Mari/mari0.rpy:49
translate italian mari0_d41d8cd9_3:

    # voice 'voices/mari_thanksgoodnight.mp3'
    voice 'voices/mari_thanksgoodnight.mp3'

# game/Scenes/Mari/mari0.rpy:50
translate italian mari0_8fafd7cf:

    # fr "Thanks for coming in. You have a good night."
    fr "Grazie per essere passato. Buona serata."

# game/Scenes/Mari/mari0.rpy:53
translate italian marifirsttip_1c31faa0:

    # "I place $5 on the table before I leave."
    "Metto 5 dollari sul tavolo prima di andarmene."

# game/Scenes/Mari/mari0.rpy:55
translate italian marifirsttip_01e672c5:

    # "I head back out to the car."
    "Torno alla macchina."

