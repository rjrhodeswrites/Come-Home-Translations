# game/Scenes/Mari/mari1.rpy:15
translate italian mari1_d41d8cd9:

    # voice 'voices/mari_heysweetie.mp3'
    voice 'voices/mari_heysweetie.mp3'

# game/Scenes/Mari/mari1.rpy:16
translate italian mari1_64c354b8:

    # fr "Hey there sweetie, good to see you. How are you doing today?"
    fr "Ehi tesoro, che piacere vederti. Come va oggi?"

# game/Scenes/Mari/mari1.rpy:19
translate italian mari1_223b1496:

    # fr "Good, I'm glad. It's nice to see you in here again, let me know if I can get you anything."
    fr "Bene, ne sono felice. È bello rivederti qui, fammi sapere se posso portarti qualcosa."

# game/Scenes/Mari/mari1.rpy:22
translate italian mari1_fe03e5ca:

    # fr "You're such a charmer. Keep going, I like it."
    fr "Sei proprio un incantatore. Continua così, mi piace."

# game/Scenes/Mari/mari1.rpy:23
translate italian mari1_4d51f194:

    # pc "I mean, the burgers here are great, but I'm really here just to chat with you."
    pc "Insomma, gli hamburger qui sono ottimi, ma in realtà sono qui solo per chiacchierare con te."

# game/Scenes/Mari/mari1.rpy:25
translate italian mari1_67fd9cd9:

    # fr "Really?"
    fr "Davvero?"

# game/Scenes/Mari/mari1.rpy:26
translate italian mari1_18128c18:

    # pc "Really."
    pc "Davvero."

# game/Scenes/Mari/mari1.rpy:28
translate italian mari1_8aa0b3f4:

    # fr "You're so sweet. Thanks for the compliments, but I better get back to work. Let me know if I can get you anything."
    fr "Sei così dolce. Grazie per i complimenti, ma è meglio che torni al lavoro. Fammi sapere se posso portarti qualcosa."

# game/Scenes/Mari/mari1.rpy:29
translate italian mari1_c0bafa60:

    # pc "Can I get a straw for my drink?"
    pc "Posso avere una cannuccia per la mia bevanda?"

# game/Scenes/Mari/mari1.rpy:31
translate italian mari1_d41d8cd9_1:

    # voice marisurething
    voice marisurething

# game/Scenes/Mari/mari1.rpy:32
translate italian mari1_f2433589:

    # fr "Sure thing, honey."
    fr "Certo, tesoro."

# game/Scenes/Mari/mari1.rpy:33
translate italian mari1_ab35ef2d:

    # "She reaches into her pocket to pull out one of the straws and a dozen more pop out and fall onto the floor, scattering around."
    "Si infila la mano in tasca per tirare fuori una delle cannucce e ne saltano fuori una dozzina che cadono sul pavimento, sparpagliandosi ovunque."

# game/Scenes/Mari/mari1.rpy:36
translate italian mari1_d41d8cd9_2:

    # voice 'voices/mari_shoot2.mp3'
    voice 'voices/mari_shoot2.mp3'

# game/Scenes/Mari/mari1.rpy:37
translate italian mari1_aaf7d6fa:

    # fr "Ah shoot, sorry about that."
    fr "Ah cavolo, scusa."

# game/Scenes/Mari/mari1.rpy:38
translate italian mari1_76e2166e:

    # fr "Just a second, let me get these."
    fr "Solo un secondo, le raccolgo."

# game/Scenes/Mari/mari1.rpy:40
translate italian mari1_29517e2b:

    # "She kneels down and gets on hands and knees on the floor, picking up the straws that had scattered around."
    "Si inginocchia e si mette a quattro zampe sul pavimento, raccogliendo le cannucce che si erano sparpagliate."

# game/Scenes/Mari/mari1.rpy:41
translate italian mari1_fa53362f:

    # fr "I'm so sorry."
    fr "Mi dispiace tantissimo."

# game/Scenes/Mari/mari1.rpy:44
translate italian mari1_6ce37599:

    # fr "I'm so clumsy sometimes."
    fr "A volte sono proprio goffa."

# game/Scenes/Mari/mari1.rpy:45
translate italian mari1_bdb852f0:

    # "She quickly finishes grabbing the rest of the straws and stands back up."
    "Finisce rapidamente di raccogliere il resto delle cannucce e si rialza."

# game/Scenes/Mari/mari1.rpy:48
translate italian mari1_c84cc9f0:

    # fr "What?"
    fr "Cosa?"

# game/Scenes/Mari/mari1.rpy:50
translate italian mari1_d41d8cd9_3:

    # voice 'voices/mari_youlikethat.mp3'
    voice 'voices/mari_youlikethat.mp3'

# game/Scenes/Mari/mari1.rpy:51
translate italian mari1_50b1ddec:

    # fr "Oh. You like that do you?"
    fr "Oh. Ti piace, vero?"

# game/Scenes/Mari/mari1.rpy:53
translate italian mari1_7fbd7f76:

    # fr "What about this? You like this?"
    fr "E questa? Ti piace questa?"

# game/Scenes/Mari/mari1.rpy:54
translate italian mari1_9bf0a886:

    # pc "I definitely do."
    pc "Mi piace eccome."

# game/Scenes/Mari/mari1.rpy:55
translate italian mari1_bdb852f0_1:

    # "She quickly finishes grabbing the rest of the straws and stands back up."
    "Finisce rapidamente di raccogliere il resto delle cannucce e si rialza."

# game/Scenes/Mari/mari1.rpy:57
translate italian mari1_2771e6a1:

    # fr "I hope that was worth a little bit more of a tip?"
    fr "Spero che questo valga una mancia un po’ più generosa?"

# game/Scenes/Mari/mari1.rpy:58
translate italian mari1_81450635:

    # pc "Oh I could give you more than the tip."
    pc "Oh, potrei darti molto più della mancia."

# game/Scenes/Mari/mari1.rpy:60
translate italian mari1_053e79a0:

    # fr "You're so bad!"
    fr "Sei proprio cattivo!"

# game/Scenes/Mari/mari1.rpy:63
translate italian mari1_bab66bf3:

    # fr "I'll be right back with a straw that hasn't been on the floor."
    fr "Torno subito con una cannuccia che non è stata per terra."

# game/Scenes/Mari/mari1.rpy:64
translate italian mari1_c8cd6f6b:

    # "She comes back with my straw and then my food shortly after that."
    "Torna con la mia cannuccia e poco dopo mi porta anche il cibo."

# game/Scenes/Mari/mari1.rpy:65
translate italian mari1_2e5f61be:

    # "We don't talk much more, but she gives me a beautiful smile every time I look up at her."
    "Non parliamo molto altro, ma mi regala un bellissimo sorriso ogni volta che alzo lo sguardo verso di lei."

# game/Scenes/Mari/mari1.rpy:69
translate italian mari1_e88fc8e1:

    # "When I finish and it's time to leave, she waves at me."
    "Quando finisco ed è ora di andarmene, mi saluta con la mano."

# game/Scenes/Mari/mari1.rpy:71
translate italian mari1_d41d8cd9_4:

    # voice 'voices/mari_thanksgoodnight.mp3'
    voice 'voices/mari_thanksgoodnight.mp3'

# game/Scenes/Mari/mari1.rpy:72
translate italian mari1_7949c609:

    # fr "Thanks for coming in! You have a good night!"
    fr "Grazie per essere passato! Buona serata!"

# game/Scenes/Mari/mari1.rpy:75
translate italian maritip2_1ce16e45:

    # "I walk up to her and put a ten-dollar bill into her hand."
    "Mi avvicino a lei e le metto una banconota da dieci dollari in mano."

# game/Scenes/Mari/mari1.rpy:78
translate italian maritip2_d41d8cd9:

    # voice 'voices/mari_thankyousomuch.mp3'
    voice 'voices/mari_thankyousomuch.mp3'

# game/Scenes/Mari/mari1.rpy:79
translate italian maritip2_1e720979:

    # fr "Thanks so much, you're the best."
    fr "Grazie mille, sei la migliore."

# game/Scenes/Mari/mari1.rpy:81
translate italian maritip2_890abf2a:

    # "Without warning, she lunges forward and wraps her arms around me, pulling me into a close hug."
    "Senza preavviso, si lancia in avanti e mi avvolge con le braccia, stringendomi in un abbraccio intimo."

# game/Scenes/Mari/mari1.rpy:82
translate italian maritip2_9ba61eed:

    # "She's so warm and soft."
    "È così calda e morbida."

# game/Scenes/Mari/mari1.rpy:83
translate italian maritip2_23314f60:

    # "And bonus - she smells like burgers."
    "E, ciliegina sulla torta, profuma di hamburger."

# game/Scenes/Mari/mari1.rpy:84
translate italian maritip2_c96f83e2:

    # pc "Well you're a great waitress."
    pc "Beh, sei una cameriera fantastica."

# game/Scenes/Mari/mari1.rpy:85
translate italian maritip2_d1889969:

    # fr "It's easy when the customers are as nice as you are."
    fr "È facile quando i clienti sono gentili come te."

# game/Scenes/Mari/mari1.rpy:86
translate italian maritip2_9bc4e48c:

    # fr "Come back and see me again soon, okay?"
    fr "Torna a trovarmi presto, ok?"

# game/Scenes/Mari/mari1.rpy:87
translate italian maritip2_9782867b:

    # pc "Oh I'm sure I will."
    pc "Oh, ne sono sicura."

# game/Scenes/Mari/mari1.rpy:89
translate italian maritip2_fb1fac0d:

    # fr "Have a good night, sweetie."
    fr "Buona serata, tesoro."

# game/Scenes/Mari/mari1.rpy:90
translate italian maritip2_eb61ef6e:

    # pc "You too."
    pc "Anche a te."

# game/Scenes/Mari/mari1.rpy:92
translate italian maritip2_3cb27537:

    # "I give her a wave."
    "Le faccio un cenno con la mano."

# game/Scenes/Mari/mari1.rpy:93
translate italian maritip2_739d2b0c:

    # "With that, I go back outside and head to my car."
    "Detto questo, torno fuori e mi dirigo verso la mia auto."

