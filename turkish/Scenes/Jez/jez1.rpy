# game/Scenes/Jez/jez1.rpy:13
translate turkish jez1_2233ac4e:

    # "My phone rings, waking me up. I look at the screen and it says Detective Rodriguez."
    "Telefonum çalarak beni uyandırır. Ekrana bakarım ve \"Dedektif Rodriguez\" yazıyor."

# game/Scenes/Jez/jez1.rpy:14
translate turkish jez1_bea5e8cb:

    # pc "Hello?"
    pc "Alo?"

# game/Scenes/Jez/jez1.rpy:15
translate turkish jez1_bca81714:

    # det "Hello, is this [pcname]?"
    det "Merhaba, [pcname] mi?"

# game/Scenes/Jez/jez1.rpy:16
translate turkish jez1_6dba6230:

    # pc "Yes."
    pc "Evet."

# game/Scenes/Jez/jez1.rpy:17
translate turkish jez1_adbdbbea:

    # det "Are you at home?"
    det "Evde misin?"

# game/Scenes/Jez/jez1.rpy:18
translate turkish jez1_6dba6230_1:

    # pc "Yes."
    pc "Evet."

# game/Scenes/Jez/jez1.rpy:19
translate turkish jez1_14ff57f7:

    # det "Okay, I'm almost at your house. I got approval to unlock the basement for you, so I'm bringing over the key now."
    det "Tamam, neredeyse evine vardım. Senin için bodrumun kilidini açma izni aldım, o yüzden şimdi anahtarı getiriyorum."

# game/Scenes/Jez/jez1.rpy:20
translate turkish jez1_9979ad0e:

    # pc "Great."
    pc "Harika."

# game/Scenes/Jez/jez1.rpy:21
translate turkish jez1_2ebb04fd:

    # det "Be there in two minutes."
    det "İki dakikaya orada olurum."

# game/Scenes/Jez/jez1.rpy:22
translate turkish jez1_b05a4fa4:

    # "She hangs up the phone."
    "Telefonu kapatıyor."

# game/Scenes/Jez/jez1.rpy:25
translate turkish jez1_82a5849a:

    # "I quickly get dressed and head downstairs. As soon as I open the front door, I see her walking quickly up the walkway towards the door."
    "Hızlıca giyinip aşağı iniyorum. Ön kapıyı açar açmaz, onun yürüyüş yolundan kapıya doğru hızlıca yürüdüğünü görüyorum."

# game/Scenes/Jez/jez1.rpy:28
translate turkish jez1_697391b1:

    # det "Sorry I don't really have time to talk at the moment, but here is the key to the basement."
    det "Üzgünüm, şu anda konuşacak vaktim pek yok, ama işte bodrumun anahtarı."

# game/Scenes/Jez/jez1.rpy:30
translate turkish jez1_7c67e994:

    # det "There's nothing new on the case right now. I'll let you know as soon as any progress happens."
    det "Şu anda davayla ilgili yeni bir gelişme yok. Herhangi bir ilerleme olur olmaz sana haber veririm."

# game/Scenes/Jez/jez1.rpy:32
translate turkish jez1_39cf2074:

    # det "And you let me know if you find anything down there in that basement. You are probably the best person to look through it, as you understand a little more about his job than any of our people."
    det "Ve o bodrumda bir şey bulursan bana haber ver. Muhtemelen orayı incelemek için en uygun kişi sensin, çünkü onun işini bizim ekipten herhangi birinden biraz daha iyi anlıyorsun."

# game/Scenes/Jez/jez1.rpy:33
translate turkish jez1_5c2df0f8:

    # det "You will tell me if you find anything right?"
    det "Bir şey bulursan bana söyleyeceksin, değil mi?"

# game/Scenes/Jez/jez1.rpy:37
translate turkish jez1_fc19b673:

    # det "Good."
    det "Güzel."

# game/Scenes/Jez/jez1.rpy:40
translate turkish jez1_37971de3:

    # det "You better. It's important that you cooperate."
    det "Öyle yapmalısın. İşbirliği yapman önemli."

# game/Scenes/Jez/jez1.rpy:42
translate turkish jez1_15fe2f48:

    # det "Okay, well I have to run. Talk to you again soon."
    det "Tamam, peki, gitmem gerek. Yakında tekrar konuşuruz."

# game/Scenes/Jez/jez1.rpy:44
translate turkish jez1_4ced5b36:

    # "She quickly turns and rushes back out to her car and drives away."
    "Hızla dönüp arabasına koşar ve uzaklaşır."

# game/Scenes/Jez/jez1.rpy:46
translate turkish jez1_39aad490:

    # "I turn and look at the basement door, holding the key to it in my hand."
    "Dönüp bodrum kapısına bakarım, elimde anahtarı tutuyorum."

# game/Scenes/Jez/jez1.rpy:47
translate turkish jez1_5b0ca9d0:

    # "When I slide the key in and hear the click of it unlock, I can't help but feel that I'm doing something wrong."
    "Anahtarı deliğe sokup kilidin açılma sesini duyduğumda, yanlış bir şey yaptığımı hissetmeden edemem."

# game/Scenes/Jez/jez1.rpy:48
translate turkish jez1_cef55c67:

    # "Even though I'm an adult, even though Dad's not down there, the basement still looks somehow menacing and forbidden."
    "Yetişkin olmama rağmen, babam aşağıda olmamasına rağmen, bodrum yine de bir şekilde tehditkar ve yasak bir yer gibi görünüyor."

# game/Scenes/Jez/jez1.rpy:49
translate turkish jez1_3a110456:

    # "The rest of the family was never allowed to come down here or to disturb him while he was working."
    "Ailenin geri kalanının buraya inmesine ya da o çalışırken onu rahatsız etmesine asla izin verilmezdi."

# game/Scenes/Jez/jez1.rpy:51
translate turkish jez1_39472555:

    # "I feel a pit in my stomach as I turn the handle and open the door."
    "Kolu çevirip kapıyı açarken midemde bir düğüm hissediyorum."

