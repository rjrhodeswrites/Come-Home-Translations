translate turkish jezs3_486cd911:

    # det "Not really."
    det "Aslında pek değil."

# game/Scenes/Jez/JezConversation/jezs3.rpy:18
translate turkish jezs3_519f9e27:

    # det "I used to like boating. Waterskiing. Fishing. Swimming."
    det "Eskiden tekne gezintisini severdim. Su kayağı. Balık tutmayı. Yüzmeyi."

# game/Scenes/Jez/JezConversation/jezs3.rpy:19
translate turkish jezs3_6d5d937c:

    # det "Now I pretty much just work and take care of my son."
    det "Artık neredeyse sadece çalışıyorum ve oğluma bakıyorum."

# game/Scenes/Jez/JezConversation/jezs3.rpy:20
translate turkish jezs3_bb1fa4cd:

    # pc "Yeah, I guess that takes a lot of energy."
    pc "Evet, sanırım bu çok enerji gerektiriyor."

# game/Scenes/Jez/JezConversation/jezs3.rpy:22
translate turkish jezs3_ddb0bae1:

    # det "It does, but it's worth it. He's amazing."
    det "Öyle, ama buna değer. O harika bir çocuk."

# game/Scenes/Jez/JezConversation/jezs3.rpy:23
translate turkish jezs3_8b48a0a8:

    # det "I don't know what I would do without him."
    det "O olmasaydı ne yapardım bilmiyorum."

# game/Scenes/Jez/JezConversation/jezs3.rpy:25
translate turkish jezs3_e2d97932:

    # det "Whenever I have a bad day at work, which is most days honestly, I come home and see his face and just immediately feel better."
    det "İş yerinde kötü bir gün geçirdiğimde, ki dürüst olmak gerekirse çoğu gün öyle, eve gelip onun yüzünü gördüğümde hemen kendimi daha iyi hissediyorum."

# game/Scenes/Jez/JezConversation/jezs3.rpy:26
translate turkish jezs3_bf6f947a:

    # pc "That's sweet."
    pc "Ne kadar tatlı."

# game/Scenes/Jez/JezConversation/jezs3.rpy:27
translate turkish jezs3_89e2bf96:

    # det "Anyway, no time for hobbies right now, but I'd love to go out to the lake again. It's been too long."
    det "Neyse, şu anda hobilerle uğraşacak vaktim yok ama göle tekrar gitmeyi çok isterim. Çok uzun zaman oldu."

