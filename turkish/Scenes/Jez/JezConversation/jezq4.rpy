# game/Scenes/Jez/JezConversation/jezq4.rpy:15
translate turkish jezq4_dbd11a17:

    # det "I've really liked having you stay over at the house occasionally. Mom and Javi love having you there too."
    det "Ara sıra bizim evde kalmanı gerçekten çok sevdim. Annem ve Javi de senin orada olmanı çok seviyorlar."

# game/Scenes/Jez/JezConversation/jezq4.rpy:16
translate turkish jezq4_3e5e32be:

    # pc "Oh yeah? I love being there too. Your family is great."
    pc "Öyle mi? Ben de orada olmayı çok seviyorum. Ailen harika."

# game/Scenes/Jez/JezConversation/jezq4.rpy:18
translate turkish jezq4_25f6bf70:

    # det "Maybe you could keep some of your clothes there? A toothbrush and stuff?"
    det "Belki bazı kıyafetlerini orada bırakabilirsin? Diş fırçası falan?"

# game/Scenes/Jez/JezConversation/jezq4.rpy:19
translate turkish jezq4_d2ad3f3e:

    # pc "You want me to move in?"
    pc "Oraya taşınmamı mı istiyorsun?"

# game/Scenes/Jez/JezConversation/jezq4.rpy:21
translate turkish jezq4_cd5b631b:

    # det "Well maybe not all the way in, but a little trial run, sort of?"
    det "Şey, belki tam olarak taşınmam, ama bir nevi deneme amaçlı, öyle mi?"

# game/Scenes/Jez/JezConversation/jezq4.rpy:23
translate turkish jezq4_b5358c43:

    # det "I think you're great, [pcname]. Javi and Mom love you. I love you."
    det "Bence harikasın, [pcname]. Javi ve annem seni çok seviyor. Ben de seni seviyorum."

# game/Scenes/Jez/JezConversation/jezq4.rpy:25
translate turkish jezq4_d41d8cd9:

    # voice 'voices/jez_18_2.mp3'
    voice 'voices/jez_18_2.mp3'

# game/Scenes/Jez/JezConversation/jezq4.rpy:26
translate turkish jezq4_0bc3d079:

    # det "I feel like I'm ready to start getting more serious."
    det "Artık ilişkimizi daha ciddiye almaya hazırım."

# game/Scenes/Jez/JezConversation/jezq4.rpy:28
translate turkish jezq4_d024735b:

    # det "So yeah, I'd like you to move in. I'd like you to start thinking about us being exclusive, too."
    det "Evet, yanıma taşınmanı istiyorum. Ayrıca, sadece birbirimize ait olacağımızı düşünmeye başlamanı da istiyorum."

# game/Scenes/Jez/JezConversation/jezq4.rpy:30
translate turkish jezq4_ef825207:

    # det "When you're my man, I don't think I could share you anymore."
    det "Sen benim erkeğim olduğunda, seni artık kimseyle paylaşamam."

# game/Scenes/Jez/JezConversation/jezq4.rpy:31
translate turkish jezq4_44237835:

    # det "And I'm ready for you to be my man."
    det "Ve senin benim erkeğim olmana hazırım."

# game/Scenes/Jez/JezConversation/jezq4.rpy:33
translate turkish jezq4_9946d1c0:

    # det "So maybe you could keep some of your stuff over at my place. Stay the night a little more often..."
    det "Belki eşyalarının bir kısmını benim evimde bırakabilirsin. Biraz daha sık gecelemek..."

# game/Scenes/Jez/JezConversation/jezq4.rpy:35
translate turkish jezq4_caa20347:

    # det "Then, after you finish school, you could move in?"
    det "Sonra, okulunu bitirdikten sonra yanıma taşınabilirsin?"

# game/Scenes/Jez/JezConversation/jezq4.rpy:36
translate turkish jezq4_1afac86b:

    # det "We could get more serious... maybe even think about marriage?"
    det "İlişkimizi daha ciddiye alabiliriz... belki evliliği bile düşünebiliriz?"

# game/Scenes/Jez/JezConversation/jezq4.rpy:37
translate turkish jezq4_ce300ccd:

    # pc "Marriage?"
    pc "Evlilik mi?"

# game/Scenes/Jez/JezConversation/jezq4.rpy:40
translate turkish jezq4_d41d8cd9_1:

    # voice 'voices/jez_18_1.mp3'
    voice 'voices/jez_18_1.mp3'

# game/Scenes/Jez/JezConversation/jezq4.rpy:41
translate turkish jezq4_49396e86:

    # det "I've been thinking about it a lot. I think we're really good together."
    det "Bu konuyu çok düşündüm. Bence birlikte çok iyi uyuşuyoruz."

# game/Scenes/Jez/JezConversation/jezq4.rpy:44
translate turkish jezq4_d41d8cd9_2:

    # voice 'voices/jez_18_3.mp3'
    voice 'voices/jez_18_3.mp3'

# game/Scenes/Jez/JezConversation/jezq4.rpy:45
translate turkish jezq4_9f664c20:

    # det "You know I'd treat you right, Papi."
    det "Sana iyi davranacağımı biliyorsun, Papi."

# game/Scenes/Jez/JezConversation/jezq4.rpy:46
translate turkish jezq4_b4546f12:

    # pc "I know you would. I think a trial run is a good idea."
    pc "Biliyorum. Bence deneme amaçlı bir süre geçirmek iyi bir fikir."

# game/Scenes/Jez/JezConversation/jezq4.rpy:47
translate turkish jezq4_b166578c:

    # pc "I'll keep some clothes and a toothbrush over there and we'll see how it goes."
    pc "Orada birkaç giysi ve diş fırçamı bırakacağım, bakalım nasıl gidecek."

# game/Scenes/Jez/JezConversation/jezq4.rpy:49
translate turkish jezq4_eead4246:

    # det "And about becoming exclusive?"
    det "Peki, sadece birbirimize ait olmaya ne dersin?"

# game/Scenes/Jez/JezConversation/jezq4.rpy:50
translate turkish jezq4_0301fe87:

    # pc "Give me until graduation to think about it?"
    pc "Mezuniyete kadar düşünmem için bana zaman verir misin?"

# game/Scenes/Jez/JezConversation/jezq4.rpy:52
translate turkish jezq4_90af5d9c:

    # det "Damn, you have to think about it? I guess I really do have some competition out there."
    det "Vay canına, düşünmen mi gerekiyor? Sanırım dışarıda gerçekten rakiplerim var."

# game/Scenes/Jez/JezConversation/jezq4.rpy:53
translate turkish jezq4_4e915a19:

    # pc "I just want to be sure before I make promises."
    pc "Söz vermeden önce emin olmak istiyorum."

# game/Scenes/Jez/JezConversation/jezq4.rpy:55
translate turkish jezq4_4fd7e2a8:

    # det "I understand. Honestly, I don't mind. You've been great so far."
    det "Anlıyorum. Açıkçası, benim için sorun değil. Şimdiye kadar harikaydın."

# game/Scenes/Jez/JezConversation/jezq4.rpy:57
translate turkish jezq4_d5a7c57c:

    # det "If you decide that this isn't right for you, that's okay. We had a great time."
    det "Bunun sana uygun olmadığına karar verirsen, sorun değil. Harika zaman geçirdik."

# game/Scenes/Jez/JezConversation/jezq4.rpy:59
translate turkish jezq4_62bafee5:

    # det "But I'd love to take things further with you and really see where this goes."
    det "Ama seninle ilişkimizi bir adım öteye taşımak ve bunun nereye varacağını gerçekten görmek isterim."

