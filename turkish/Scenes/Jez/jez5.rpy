# game/Scenes/Jez/jez5.rpy:9
translate turkish jez5_98ca1a51:

    # "My phone buzzes in my pocket."
    "Cebimde telefonum titriyor."

# game/Scenes/Jez/jez5.rpy:13
translate turkish jez5_450455fc:

    # "It's Detective Rodriguez. I wonder if she's found something out about my dad."
    "Arayan Dedektif Rodriguez. Acaba babam hakkında bir şey bulmuş mu?"

# game/Scenes/Jez/jez5.rpy:16
translate turkish jez5_bea5e8cb:

    # pc "Hello?"
    pc "Alo?"

# game/Scenes/Jez/jez5.rpy:18
translate turkish jez5_d41d8cd9:

    # voice 'voices/jez_hey.mp3'
    voice 'voices/jez_hey.mp3'

# game/Scenes/Jez/jez5.rpy:19
translate turkish jez5_31f304d3:

    # det "Hey, [pcname]."
    det "Selam, [pcname]."

# game/Scenes/Jez/jez5.rpy:20
translate turkish jez5_704218da:

    # pc "Did you find anything?"
    pc "Bir şey buldun mu?"

# game/Scenes/Jez/jez5.rpy:22
translate turkish jez5_dd220c64:

    # det "What? Oh! About your dad?"
    det "Ne? Oh! Baban hakkında mı?"

# game/Scenes/Jez/jez5.rpy:24
translate turkish jez5_e8fe8a8c:

    # det "Oh God, no I'm sorry. I wasn't calling about your dad, but I can understand why you'd think that."
    det "Tanrım, hayır, özür dilerim. Baban hakkında aramıyordum ama neden öyle düşündüğünü anlayabiliyorum."

# game/Scenes/Jez/jez5.rpy:25
translate turkish jez5_1559f8f9:

    # det "With me being a detective and on your dad's case and all."
    det "Ben bir dedektifim ve babanın davasıyla ilgileniyorum da."

# game/Scenes/Jez/jez5.rpy:26
translate turkish jez5_8c3ac124:

    # det "God, I'm a horrible detective aren't I?"
    det "Tanrım, berbat bir dedektifim, değil mi?"

# game/Scenes/Jez/jez5.rpy:27
translate turkish jez5_a807c23e:

    # pc "No, I don't think so. What did you call for then?"
    pc "Hayır, öyle olduğunu sanmıyorum. O zaman neden aradın?"

# game/Scenes/Jez/jez5.rpy:30
translate turkish jez5_d41d8cd9_1:

    # voice 'voices/jez_5_1.mp3'
    voice 'voices/jez_5_1.mp3'

# game/Scenes/Jez/jez5.rpy:31
translate turkish jez5_0a63889f:

    # det "Well, I had kind of a rough day and I wanted to talk to somebody."
    det "Şey, biraz zor bir gün geçirdim ve biriyle konuşmak istedim."

# game/Scenes/Jez/jez5.rpy:33
translate turkish jez5_d41d8cd9_2:

    # voice 'voices/jez_5_2.mp3'
    voice 'voices/jez_5_2.mp3'

# game/Scenes/Jez/jez5.rpy:34
translate turkish jez5_ea09e714:

    # det "And you were nice to me in the past, when we went out for drinks."
    det "Ayrıca geçmişte, birlikte içmeye çıktığımızda bana karşı naziktin."

# game/Scenes/Jez/jez5.rpy:36
translate turkish jez5_d41d8cd9_3:

    # voice 'voices/jez_5_3.mp3'
    voice 'voices/jez_5_3.mp3'

# game/Scenes/Jez/jez5.rpy:37
translate turkish jez5_307d2b53:

    # det "And I don't really have anybody else to talk to."
    det "Ve konuşacak başka kimse yok."

# game/Scenes/Jez/jez5.rpy:39
translate turkish jez5_d41d8cd9_4:

    # voice 'voices/jez_5_4.mp3'
    voice 'voices/jez_5_4.mp3'

# game/Scenes/Jez/jez5.rpy:40
translate turkish jez5_0f2cd5d3:

    # det "So I was wondering if you would want to just talk some?"
    det "O yüzden, biraz konuşmak ister misin diye merak ediyordum?"

# game/Scenes/Jez/jez5.rpy:46
translate turkish jez5_47059538:

    # det "You're right. This was a mistake, I'm sorry."
    det "Haklısın. Bu bir hataydı, özür dilerim."

# game/Scenes/Jez/jez5.rpy:47
translate turkish jez5_ec16f7c0:

    # det "I won't bother you any more until I have information on your dad."
    det "Baban hakkında bilgi alana kadar seni bir daha rahatsız etmeyeceğim."

# game/Scenes/Jez/jez5.rpy:48
translate turkish jez5_07fc1b9f:

    # det "Bye, [pcname]."
    det "Hoşça kal, [pcname]."

# game/Scenes/Jez/jez5.rpy:52
translate turkish jez5_5429a27f:

    # "She hangs up and I lie down to go to sleep."
    "O telefonu kapatıyor ve ben uyumak için uzanıyorum."

# game/Scenes/Jez/jez5.rpy:53
translate turkish jez5_ceaf3431:

    # "I can hardly believe that she wants to call me and dump her problems on me. Don't I have enough of my own to deal with?"
    "Beni arayıp sorunlarını bana yüklemek istemesine inanamıyorum. Kendi başıma halletmem gereken yeterince sorunum yok mu zaten?"

# game/Scenes/Jez/jez5.rpy:54
translate turkish jez5_0a396100:

    # "I mean, my dad is missing and it doesn't seem like she's doing much of anything to find him."
    "Yani, babam kayıp ve o da onu bulmak için pek bir şey yapmıyor gibi görünüyor."

# game/Scenes/Jez/jez5.rpy:55
translate turkish jez5_a9441b54:

    # "Maybe I was a little harsh with her, but she needs to do her damn job."
    "Belki ona biraz sert davrandım, ama o da lanet işini yapmalı."

# game/Scenes/Jez/jez5.rpy:56
translate turkish jez5_437235da:

    # "I fall asleep, still upset about the whole thing."
    "Hâlâ tüm bu olay yüzünden üzgün bir şekilde uykuya dalıyorum."

# game/Scenes/Jez/jez5.rpy:62
translate turkish jez5_9f04dd80:

    # det "My Chief is yelling at me all the time because I haven't been able to track down this meth manufacturer."
    det "Şefim, bu metamfetamin üreticisinin izini süremediğim için bana sürekli bağırıyor."

# game/Scenes/Jez/jez5.rpy:63
translate turkish jez5_2edb985d:

    # det "It's like, I'm trying. There's only so much I can do."
    det "Sanki, elimden geleni yapmıyormuşum gibi. Yapabileceğim şeyler sınırlı."

# game/Scenes/Jez/jez5.rpy:64
translate turkish jez5_d637e4b1:

    # det "I spend most of my day on stakeouts watching drug handoffs."
    det "Günün çoğunu, uyuşturucu teslimatlarını izlemek için gözetleme görevlerinde geçiriyorum."

# game/Scenes/Jez/jez5.rpy:65
translate turkish jez5_b65d63fc:

    # det "Or interrogating people, trying to push them into telling me something."
    det "Ya da insanları sorguya çekip, bir şeyler söylemeleri için onları zorluyorum."

# game/Scenes/Jez/jez5.rpy:66
translate turkish jez5_e4fde77f:

    # det "But nobody's giving anything up and I'm running out of leads."
    det "Ama kimse bir şey söylemiyor ve ipuçlarım tükeniyor."

# game/Scenes/Jez/jez5.rpy:67
translate turkish jez5_45b6d6aa:

    # det "There's only two detectives on this case. A big meth ring and just two of us."
    det "Bu davada sadece iki dedektif var. Büyük bir metamfetamin şebekesi ve sadece ikimiz."

# game/Scenes/Jez/jez5.rpy:68
translate turkish jez5_77a9cef6:

    # det "I mean Skyhill is a small town, so I get it, but I need more help here."
    det "Yani Skyhill küçük bir kasaba, anlıyorum, ama burada daha fazla yardıma ihtiyacım var."

# game/Scenes/Jez/jez5.rpy:69
translate turkish jez5_72d52a4d:

    # det "I wish we could call in the state police, or the FBI or something, but the Chief won't have it. Says we have to handle this ourselves."
    det "Keşke eyalet polisini ya da FBI'ı falan çağırabilsek, ama Şef buna izin vermiyor. Bunu kendimiz halletmemiz gerektiğini söylüyor."

# game/Scenes/Jez/jez5.rpy:70
translate turkish jez5_d8b3de1e:

    # det "But there's only so much I can do. I have other cases too - like your dad's - that I'm having to neglect because of this meth thing."
    det "Ama yapabileceğim şeyler sınırlı. Başka davalarım da var – babanınki gibi – ama bu metamfetamin meselesi yüzünden onları ihmal etmek zorunda kalıyorum."

# game/Scenes/Jez/jez5.rpy:72
translate turkish jez5_88d7e875:

    # det "And today I had to raid the house of this methhead."
    det "Ve bugün bu metamfetamin bağımlısının evine baskın yapmak zorunda kaldım."

# game/Scenes/Jez/jez5.rpy:73
translate turkish jez5_d5874b9e:

    # det "It was horrible. This woman, her house was disgusting. Her baby, a three-year-old girl, was sitting in the middle of a bunch of filth naked."
    det "Korkunçtu. Bu kadının evi iğrençti. Üç yaşındaki kızı, bir yığın pisliğin ortasında çıplak oturuyordu."

# game/Scenes/Jez/jez5.rpy:74
translate turkish jez5_2823a872:

    # det "And I had to take this child, who was screaming and crying that she didn't want to leave her mom, and give the child to protective services."
    det "Ve annesinden ayrılmak istemediğini haykıran ve ağlayan bu çocuğu alıp, çocuk koruma hizmetlerine teslim etmek zorunda kaldım."

# game/Scenes/Jez/jez5.rpy:75
translate turkish jez5_e5dd6ea8:

    # det "The girl will probably have a better life in foster care than she would have with her mother, but who knows. She could end up with some abusive assholes or something."
    det "Kız, muhtemelen annesiyle kalmaktansa koruyucu ailede daha iyi bir hayat sürecek, ama kim bilir. Belki de istismarcı pisliklerin eline düşebilir."

# game/Scenes/Jez/jez5.rpy:76
translate turkish jez5_5e97fe72:

    # det "That little girl's life is messed up no matter what happens now."
    det "Artık ne olursa olsun, o küçük kızın hayatı mahvolmuş durumda."

# game/Scenes/Jez/jez5.rpy:77
translate turkish jez5_a1286de7:

    # det "And it just makes me so sad."
    det "Ve bu beni çok üzüyor."

# game/Scenes/Jez/jez5.rpy:78
translate turkish jez5_89052a8b:

    # pc "I'm sorry. That's awful."
    pc "Üzgünüm. Bu çok korkunç."

# game/Scenes/Jez/jez5.rpy:80
translate turkish jez5_97380cd0:

    # det "So I get the woman back to the station and start interrogating her."
    det "Kadını karakola götürdüm ve sorgulamaya başladım."

# game/Scenes/Jez/jez5.rpy:81
translate turkish jez5_3e4784a1:

    # det "She's going to jail for at least five years for possession, probably will get a child endangerment charge as well, but she won't give up her dealer."
    det "Uyuşturucu bulundurmaktan en az beş yıl hapis yatacak, muhtemelen çocukları tehlikeye atma suçlaması da alacak, ama satıcısını ifşa etmiyor."

# game/Scenes/Jez/jez5.rpy:82
translate turkish jez5_19e09092:

    # det "I don't fucking get it."
    det "Anlamıyorum lan."

# game/Scenes/Jez/jez5.rpy:83
translate turkish jez5_59760784:

    # det "She's scared that something will happen to her family if she snitches."
    det "İspiyonlarsa ailesine bir şey olacağından korkuyor."

# game/Scenes/Jez/jez5.rpy:84
translate turkish jez5_c0f63ffe:

    # det "Spits in my face, calls me a pig. I wanted to beat her fucking head in."
    det "Yüzüme tükürüyor, bana domuz diyor. Lanet kafasını ezip geçmek istedim."

# game/Scenes/Jez/jez5.rpy:85
translate turkish jez5_c36e96d1:

    # det "Then I get chewed out by the Chief because I didn't get anything out of her."
    det "Sonra ondan hiçbir şey öğrenemediğim için Şef tarafından azarlandım."

# game/Scenes/Jez/jez5.rpy:87
translate turkish jez5_2288ac26:

    # det "And that was my day."
    det "İşte günüm böyle geçti."

# game/Scenes/Jez/jez5.rpy:88
translate turkish jez5_2074c381:

    # det "I'm just so tired of all of it. I want to find this meth manufacturer and shut that shit down."
    det "Artık hepsinden bıktım. Bu metamfetamin üreticisini bulup o işi durdurmak istiyorum."

# game/Scenes/Jez/jez5.rpy:90
translate turkish jez5_3a7bef84:

    # "I think about telling her about the bunker that Izzy had sent me to."
    "Izzy’nin beni gönderdiği sığınaktan ona bahsetmeyi düşünüyorum."

# game/Scenes/Jez/jez5.rpy:91
translate turkish jez5_35c47a4d:

    # "But I'm not sure that is really what she's looking for."
    "Ama onun gerçekten aradığı şeyin bu olduğundan emin değilim."

# game/Scenes/Jez/jez5.rpy:92
translate turkish jez5_7dda6c8a:

    # "Plus, I'm not sure if me and Izzy might get in some serious trouble for our part in whatever they were doing."
    "Ayrıca, Izzy ile ikimizin, onların yaptıkları her neyse, o işteki rolümüz yüzünden başımızın ciddi bir belaya girebileceğinden de emin değilim."

# game/Scenes/Jez/jez5.rpy:93
translate turkish jez5_9fcbf4b8:

    # "I may tell Jez about it later, but for now I stay quiet."
    "Belki daha sonra Jez’e bundan bahsederim, ama şimdilik sessiz kalacağım."

# game/Scenes/Jez/jez5.rpy:95
translate turkish jez5_6387c117:

    # "I think about telling her about the bunker that Reba had taken me to."
    "Reba’nın beni götürdüğü sığınaktan ona bahsetmeyi düşünüyorum."

# game/Scenes/Jez/jez5.rpy:96
translate turkish jez5_35c47a4d_1:

    # "But I'm not sure that is really what she's looking for."
    "Ama onun gerçekten aradığı şeyin bu olduğundan emin değilim."

# game/Scenes/Jez/jez5.rpy:97
translate turkish jez5_306cf091:

    # "Plus, I'm not sure if Reba might get in some serious trouble for our part in whatever they were doing."
    "Ayrıca, yaptıkları her neyse, bizim de bu işin içinde olmamız yüzünden Reba’nın başının ciddi bir belaya girebileceğinden emin değilim."

# game/Scenes/Jez/jez5.rpy:98
translate turkish jez5_9fcbf4b8_1:

    # "I may tell Jez about it later, but for now I stay quiet."
    "Belki daha sonra Jez’e bundan bahsederim, ama şimdilik sessiz kalacağım."

# game/Scenes/Jez/jez5.rpy:99
translate turkish jez5_a3049ca4:

    # det "Anyway, thanks for listening to me vent."
    det "Neyse, derdimi dinlediğin için teşekkürler."

# game/Scenes/Jez/jez5.rpy:100
translate turkish jez5_732596c5:

    # det "I needed to get all that off my chest."
    det "Bunları içimden atmam gerekiyordu."

# game/Scenes/Jez/jez5.rpy:101
translate turkish jez5_d957ecb7:

    # pc "You feeling better now?"
    pc "Şimdi daha iyi hissediyor musun?"

# game/Scenes/Jez/jez5.rpy:103
translate turkish jez5_880af095:

    # det "A little, yeah."
    det "Evet, biraz."

# game/Scenes/Jez/jez5.rpy:104
translate turkish jez5_566089d7:

    # det "You're a pretty good listener, [pcname]. Thank you."
    det "Oldukça iyi bir dinleyicisin, [pcname]. Teşekkürler."

# game/Scenes/Jez/jez5.rpy:105
translate turkish jez5_c46a0b54:

    # pc "Any time."
    pc "Ne zaman istersen."

# game/Scenes/Jez/jez5.rpy:107
translate turkish jez5_1d1792a8:

    # det "I can be a good listener too, if you ever want to chat."
    det "Sen de sohbet etmek istersen, ben de iyi bir dinleyici olabilirim."

# game/Scenes/Jez/jez5.rpy:108
translate turkish jez5_d87a672d:

    # det "You could call me at nights and we could just talk or something."
    det "Geceleri beni arayabilirsin, sadece konuşuruz falan."

# game/Scenes/Jez/jez5.rpy:110
translate turkish jez5_b7c62ab4:

    # pc "That sounds good. I'll do that."
    pc "Kulağa hoş geliyor. Öyle yapacağım."

# game/Scenes/Jez/jez5.rpy:112
translate turkish jez5_fc19b673:

    # det "Good."
    det "Güzel."

# game/Scenes/Jez/jez5.rpy:114
translate turkish jez5_d41d8cd9_5:

    # voice 'voices/jez_5_5.mp3'
    voice 'voices/jez_5_5.mp3'

# game/Scenes/Jez/jez5.rpy:115
translate turkish jez5_22567fb7:

    # det "Okay, [pcname], I better get to bed. Thanks for listening to me."
    det "Tamam, [pcname], yatmaya gitsem iyi olacak. Beni dinlediğin için teşekkürler."

# game/Scenes/Jez/jez5.rpy:117
translate turkish jez5_d41d8cd9_6:

    # voice 'voices/jez_5_6.mp3'
    voice 'voices/jez_5_6.mp3'

# game/Scenes/Jez/jez5.rpy:118
translate turkish jez5_22b369a9:

    # det "I'll talk to you later."
    det "Sonra konuşuruz."

# game/Scenes/Jez/jez5.rpy:119
translate turkish jez5_31e08f47:

    # pc "Okay, good night, Jez."
    pc "Tamam, iyi geceler Jez."

# game/Scenes/Jez/jez5.rpy:121
translate turkish jez5_d41d8cd9_7:

    # voice 'voices/jez_night.mp3'
    voice 'voices/jez_night.mp3'

# game/Scenes/Jez/jez5.rpy:122
translate turkish jez5_8669dcbe:

    # det "Night."
    det "İyi geceler."

# game/Scenes/Jez/jez5.rpy:125
translate turkish jez5_52d6e3cf:

    # "We hang up and I get ready for bed."
    "Telefonu kapatıyoruz ve ben yatmaya hazırlanıyorum."

# game/Scenes/Jez/jez5.rpy:126
translate turkish jez5_73bafe8e:

    # "It must be hard having to deal with the things that she deals with, see the things that she sees every day."
    "Onun başa çıkmak zorunda olduğu şeylerle uğraşmak, her gün gördüğü şeyleri görmek zor olmalı."

# game/Scenes/Jez/jez5.rpy:127
translate turkish jez5_63d39c7b:

    # "I like that she is opening up to me though, becoming more friendly."
    "Yine de bana açılmasını, daha samimi olmasını seviyorum."

# game/Scenes/Jez/jez5.rpy:128
translate turkish jez5_00f887ed:

    # "I actually really like her."
    "Aslında ondan gerçekten hoşlanıyorum."

# game/Scenes/Jez/jez5.rpy:129
translate turkish jez5_c6ddf2e1:

    # "I fall asleep thinking about how I'd like to spend more time with her. Hopefully we'll get a chance soon."
    "Onunla daha fazla zaman geçirmek istediğimi düşünerek uykuya dalıyorum. Umarım yakında bir fırsatımız olur."

