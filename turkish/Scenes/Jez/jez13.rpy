    # det "Have a seat and I'll make you a plate."
    det "Otur da sana bir tabak hazırlayayım."

# game/Scenes/Jez/jez13.rpy:183
translate turkish jez13_7d92ea12:

    # "I sit down at the table in the empty chair next to Javi, while Jez walks over to the kitchen."
    "Jez mutfağa doğru yürürken, ben de masada Javi’nin yanındaki boş sandalyeye oturuyorum."

# game/Scenes/Jez/jez13.rpy:184
translate turkish jez13_165be96c:

    # jav "Are you living here now?"
    jav "Artık burada mı yaşıyorsun?"

# game/Scenes/Jez/jez13.rpy:185
translate turkish jez13_d3f55d8e:

    # det "No, mijo, he's not living here. But you might see him sometimes. Is that okay?"
    det "Hayır, mijo, burada yaşamıyor. Ama onu ara sıra görebilirsin. Sorun olur mu?"

# game/Scenes/Jez/jez13.rpy:186
translate turkish jez13_b4d9cdcc:

    # jav "I guess."
    jav "Sanırım olmaz."

# game/Scenes/Jez/jez13.rpy:187
translate turkish jez13_bd0e121b:

    # jav "Do you like Minecraft?"
    jav "Minecraft’ı sever misin?"

# game/Scenes/Jez/jez13.rpy:188
translate turkish jez13_e961c690:

    # pc "I've never played it."
    pc "Hiç oynamadım."

# game/Scenes/Jez/jez13.rpy:189
translate turkish jez13_376c3872:

    # jav "Oh, I could show you how to play if you want."
    jav "Oh, istersen nasıl oynandığını gösterebilirim."

# game/Scenes/Jez/jez13.rpy:190
translate turkish jez13_5b20795d:

    # pc "Sure, that sounds fun."
    pc "Tabii, kulağa eğlenceli geliyor."

# game/Scenes/Jez/jez13.rpy:191
translate turkish jez13_9e8c872b:

    # jav "Okay, let's go!"
    jav "Tamam, hadi başlayalım!"

# game/Scenes/Jez/jez13.rpy:192
translate turkish jez13_2ba8fd61:

    # det "Not right now, mijo. We're having breakfast and then you have to go to school."
    det "Şu anda olmaz, mijo. Kahvaltı yapıyoruz ve sonra okula gitmen gerekiyor."

# game/Scenes/Jez/jez13.rpy:193
translate turkish jez13_bd2f8227:

    # jav "Okay, I'll show you later then."
    jav "Tamam, o zaman sana daha sonra gösteririm."

# game/Scenes/Jez/jez13.rpy:196
translate turkish jez13_ce637d21:

    # "Jez and her mamá come to the table and Jez puts a plate of food in front of me."
    "Jez ve annesi masaya gelirler ve Jez önüme bir tabak yemek koyar."

# game/Scenes/Jez/jez13.rpy:197
translate turkish jez13_e02b004c:

    # "Before I get a chance to even look at it though, Mamá sits across from me and looks me in the eyes, like she's weighing me up."
    "Ama daha bakma fırsatı bile bulamadan, annesi karşımda oturur ve sanki beni tartıyormuş gibi gözlerimin içine bakar."

# game/Scenes/Jez/jez13.rpy:198
translate turkish jez13_0711ba82:

    # mama "So, [pcname], how old are you?"
    mama "Peki, [pcname], kaç yaşındasın?"

# game/Scenes/Jez/jez13.rpy:200
translate turkish jez13_c2113814:

    # pc "Twenty-two."
    pc "Yirmi iki."

# game/Scenes/Jez/jez13.rpy:202
translate turkish jez13_a6d70d6c:

    # mama "So young. You're younger than Jesabela."
    mama "Çok gençsin. Jesabela’dan daha gençsin."

# game/Scenes/Jez/jez13.rpy:205
translate turkish jez13_d41d8cd9_16:

    # voice 'voices/jez_13_17.mp3'
    voice 'voices/jez_13_17.mp3'

# game/Scenes/Jez/jez13.rpy:206
translate turkish jez13_8cc38855:

    # det "Ay Mamá!"
    det "Ay anne!"

# game/Scenes/Jez/jez13.rpy:208
translate turkish jez13_1da93989:

    # mama "Do you have a job?"
    mama "Bir işin var mı?"

# game/Scenes/Jez/jez13.rpy:210
translate turkish jez13_748e9a7f:

    # pc "Yes, as an assistant at a law office."
    pc "Evet, bir hukuk bürosunda asistanım."

# game/Scenes/Jez/jez13.rpy:212
translate turkish jez13_23a217be:

    # mama "Do you have any children?"
    mama "Çocuğun var mı?"

# game/Scenes/Jez/jez13.rpy:214
translate turkish jez13_4219f3ee:

    # pc "No."
    pc "Hayır."

# game/Scenes/Jez/jez13.rpy:216
translate turkish jez13_5dc9c07e:

    # mama "Do you do drugs?"
    mama "Uyuşturucu kullanıyor musun?"

# game/Scenes/Jez/jez13.rpy:218
translate turkish jez13_4219f3ee_1:

    # pc "No."
    pc "Hayır."

# game/Scenes/Jez/jez13.rpy:220
translate turkish jez13_af0ca811:

    # mama "Do you live with your parents?"
    mama "Ailenle mi yaşıyorsun?"

# game/Scenes/Jez/jez13.rpy:222
translate turkish jez13_9af16977:

    # pc "I live with my [mother] at the moment."
    pc "Şu anda [mother]’mle yaşıyorum."

# game/Scenes/Jez/jez13.rpy:224
translate turkish jez13_6b1ebe90:

    # mama "How many other girlfriends do you have?"
    mama "Başka kaç kız arkadaşın var?"

# game/Scenes/Jez/jez13.rpy:227
translate turkish jez13_d41d8cd9_17:

    # voice 'voices/jez_13_17b.mp3'
    voice 'voices/jez_13_17b.mp3'

# game/Scenes/Jez/jez13.rpy:228
translate turkish jez13_5296d8b8:

    # det "Ay Mamá, be nice!"
    det "Ay anne, nazik ol!"

# game/Scenes/Jez/jez13.rpy:229
translate turkish jez13_5faa2282:

    # mama "Que?"
    mama "Ne?"

# game/Scenes/Jez/jez13.rpy:230
translate turkish jez13_fd390a20:

    # mama "Quiero saber acerca de este chico con el que estás saliendo."
    mama "Çıktığın bu çocuk hakkında bilgi almak istiyorum."

# game/Scenes/Jez/jez13.rpy:232
translate turkish jez13_d41d8cd9_18:

    # voice 'voices/jez_13_18.mp3'
    voice 'voices/jez_13_18.mp3'

# game/Scenes/Jez/jez13.rpy:233
translate turkish jez13_1e7215a5:

    # det "Ya te hablé de él. Es un buen chico y me gusta. ¿No confías en mi juicio?"
    det "Sana ondan bahsetmiştim zaten. İyi bir çocuk ve ondan hoşlanıyorum. Benim yargıma güvenmiyor musun?"

# game/Scenes/Jez/jez13.rpy:234
translate turkish jez13_28dfbcd6:

    # mama "No lo hiciste tan bien la primera vez."
    mama "İlk seferinde pek de iyi başaramamıştın."

# game/Scenes/Jez/jez13.rpy:235
translate turkish jez13_1847687a:

    # det "Mamá!"
    det "Anne!"

# game/Scenes/Jez/jez13.rpy:237
translate turkish jez13_a9618f8c:

    # mama "Do you have any brothers or sisters?"
    mama "Kardeşin var mı?"

# game/Scenes/Jez/jez13.rpy:239
translate turkish jez13_b0e9cb79:

    # pc "Just Suzy, my [sister]."
    pc "Sadece Suzy, benim [sister]'m."

# game/Scenes/Jez/jez13.rpy:241
translate turkish jez13_0acf000d:

    # mama "What are you going to school for?"
    mama "Okula ne için gidiyorsun?"

# game/Scenes/Jez/jez13.rpy:243
translate turkish jez13_04c35adf:

    # pc "Quantum physics. To be a scientist."
    pc "Kuantum fiziği. Bilim insanı olmak için."

# game/Scenes/Jez/jez13.rpy:245
translate turkish jez13_36e29056:

    # det "That's enough, Mamá, the food is getting cold while you're grilling him."
    det "Yeter artık, anne, sen onu sorguya çekerken yemek soğuyor."

# game/Scenes/Jez/jez13.rpy:246
translate turkish jez13_9fda17f8:

    # mama "You seem like a good boy, I suppose."
    mama "Sanırım iyi bir çocuğa benziyorsun."

# game/Scenes/Jez/jez13.rpy:247
translate turkish jez13_45d2cbc0:

    # det "He is. He helped me out a lot last night."
    det "Öyle. Dün gece bana çok yardım etti."

# game/Scenes/Jez/jez13.rpy:248
translate turkish jez13_f3a75866:

    # mama "I'm sure he did."
    mama "Eminim etmiştir."

# game/Scenes/Jez/jez13.rpy:250
translate turkish jez13_d41d8cd9_19:

    # voice 'voices/jez_13_20.mp3'
    voice 'voices/jez_13_20.mp3'

# game/Scenes/Jez/jez13.rpy:251
translate turkish jez13_b535f103:

    # det "Mamá! Cuida lo que dices delante de Javi."
    det "Anne! Javi'nin önünde söylediklerine dikkat et."

# game/Scenes/Jez/jez13.rpy:252
translate turkish jez13_c913be1a:

    # mama "No dije nada en absoluto!"
    mama "Hiçbir şey demedim ki!"

# game/Scenes/Jez/jez13.rpy:255
translate turkish jez13_c5ef0cc4:

    # mama "If Jesabela likes you enough to introduce you to me, you must be something special."
    mama "Jesabela seni bana tanıtacak kadar seviyorsa, özel biri olmalısın."

# game/Scenes/Jez/jez13.rpy:256
translate turkish jez13_48aa3884:

    # mama "You just be good to her."
    mama "Sen ona iyi davran yeter."

# game/Scenes/Jez/jez13.rpy:257
translate turkish jez13_f31ca3be:

    # pc "Yes ma'am, I will."
    pc "Evet hanımefendi, öyle yapacağım."

# game/Scenes/Jez/jez13.rpy:258
translate turkish jez13_8faa40cf:

    # mama "No ma'am. You call me Mamá, or Ivelisse."
    mama "Hayır hanımefendi. Bana Mamá ya da Ivelisse de."

# game/Scenes/Jez/jez13.rpy:259
translate turkish jez13_49e790d0:

    # jav "Or Abuelita."
    jav "Ya da Abuelita."

# game/Scenes/Jez/jez13.rpy:262
translate turkish jez13_f9207776:

    # mama "No, mi guapo, you're the only one that gets to call me abuelita."
    mama "Hayır, mi guapo, bana Abuelita diyebilecek tek kişi sensin."

# game/Scenes/Jez/jez13.rpy:263
translate turkish jez13_8d2fe2d9:

    # jav "Oh okay. Sorry, [pcname], you can't call her that."
    jav "Ah, tamam. Özür dilerim, [pcname], ona öyle diyemezsin."

# game/Scenes/Jez/jez13.rpy:266
translate turkish jez13_196bac72:

    # "We chit-chat a little more while we eat."
    "Yemek yerken biraz daha sohbet ediyoruz."

# game/Scenes/Jez/jez13.rpy:267
translate turkish jez13_dedcdede:

    # "Ivelisse is a little intimidating, but after a while, she smiles a lot and she seems pretty funny."
    "Ivelisse ilk başta biraz ürkütücü geliyor, ama bir süre sonra bol bol gülümsüyor ve oldukça eğlenceli birine benziyor."

# game/Scenes/Jez/jez13.rpy:268
translate turkish jez13_0ba3754f:

    # "And I can feel so much love between the three of them."
    "Üçü arasında çok büyük bir sevgi hissedebiliyorum."

# game/Scenes/Jez/jez13.rpy:271
translate turkish jez13_81657b80:

    # "Javi talks a lot about school and the base that he and his friends are building in Minecraft."
    "Javi, okuldan ve arkadaşlarıyla Minecraft’ta inşa ettikleri üsten bol bol bahsediyor."

# game/Scenes/Jez/jez13.rpy:272
translate turkish jez13_c3923da8:

    # "Meanwhile, Jez looks at me with a shy smile while her foot rubs against my leg under the table."
    "Bu arada Jez, masanın altından ayağıyla bacağıma sürtünürken utangaç bir gülümsemeyle bana bakıyor."

# game/Scenes/Jez/jez13.rpy:275
translate turkish jez13_c332134e:

    # "When we finish eating, I tell Javi and Ivelisse goodbye."
    "Yemeğimizi bitirdiğimizde Javi ve Ivelisse’ye veda ediyorum."

# game/Scenes/Jez/jez13.rpy:276
translate turkish jez13_eac1a598:

    # mama "It was very nice to meet you, [pcname]."
    mama "Seninle tanışmak çok güzeldi, [pcname]."

# game/Scenes/Jez/jez13.rpy:277
translate turkish jez13_a7f3d1fc:

    # pc "Nice to meet you too. Thank you for the amazing breakfast."
    pc "Ben de tanıştığıma sevindim. Harika kahvaltı için teşekkürler."

# game/Scenes/Jez/jez13.rpy:278
translate turkish jez13_6ad487d2:

    # jav "Bye, [pcname]!"
    jav "Hoşça kal, [pcname]!"

# game/Scenes/Jez/jez13.rpy:279
translate turkish jez13_5f653b3b:

    # pc "Bye, Javi. I'll be back for you to teach me about Minecraft sometime, okay?"
    pc "Hoşça kal, Javi. Bir ara Minecraft hakkında bana bir şeyler öğretmen için tekrar geleceğim, tamam mı?"

# game/Scenes/Jez/jez13.rpy:280
translate turkish jez13_930b665f:

    # jav "Okay!"
    jav "Tamam!"

# game/Scenes/Jez/jez13.rpy:283
translate turkish jez13_12a645a9:

    # pc "Do you think I did okay?"
    pc "Sence iyi miydim?"

# game/Scenes/Jez/jez13.rpy:284
translate turkish jez13_e66be0b3:

    # det "You did wonderful."
    det "Harikaydın."

# game/Scenes/Jez/jez13.rpy:287
translate turkish jez13_2a95c68b:

    # det "Seriously, [pcname]. Thank you for everything."
    det "Cidden, [pcname]. Her şey için teşekkürler."

# game/Scenes/Jez/jez13.rpy:288
translate turkish jez13_a05c3ddb:

    # pc "You're welcome. Hope your day is better today."
    pc "Rica ederim. Umarım bugün günün daha iyi geçer."

# game/Scenes/Jez/jez13.rpy:289
translate turkish jez13_37df78b6:

    # det "It will be. I already feel so much better."
    det "Öyle olacak. Şimdiden kendimi çok daha iyi hissediyorum."

# game/Scenes/Jez/jez13.rpy:290
translate turkish jez13_95715fb7:

    # det "You have a good day too. Let's spend some more time together soon, okay?"
    det "Sana da iyi günler. Yakında biraz daha vakit geçirelim, olur mu?"

# game/Scenes/Jez/jez13.rpy:291
translate turkish jez13_2951ed74:

    # pc "Definitely."
    pc "Kesinlikle."

# game/Scenes/Jez/jez13.rpy:294
translate turkish jez13_01f6f4f8:

    # "I leave her house and go home to change clothes and get my things, then head straight to school, barely getting there in time for my first class."
    "Evinden ayrılıp eve gidip üstümü değiştirip eşyalarımı alıyorum, sonra da doğruca okula gidiyorum; ilk dersime zar zor yetişiyorum."

# game/Scenes/Jez/jez13.rpy:295
translate turkish jez13_24a3ded4:

    # "The whole time, I'm thinking about my relationship with Jez."
    "Bütün yol boyunca Jez ile olan ilişkim hakkında düşünüyorum."

# game/Scenes/Jez/jez13.rpy:296
translate turkish jez13_b509de35:

    # "She called me her boyfriend."
    "Bana erkek arkadaşı dedi."

# game/Scenes/Jez/jez13.rpy:297
translate turkish jez13_b197b664:

    # "It seems like it's starting to get pretty serious. Meeting her kid and her mom like that."
    "İşler oldukça ciddileşmeye başlıyor gibi görünüyor. Onun çocuğuyla ve annesiyle öylece tanışmak."

# game/Scenes/Jez/jez13.rpy:298
translate turkish jez13_4e167340:

    # "I have to think about if that's something I really want or not. She's amazing, but am I really ready to commit to something like that?"
    "Bunun gerçekten istediğim bir şey olup olmadığını düşünmem gerekiyor. O harika biri, ama ben böyle bir şeye kendimi adamaya gerçekten hazır mıyım?"

# game/Scenes/Jez/jez13.rpy:299
translate turkish jez13_3bf96260:

    # "I'll need to decide soon. I don't want to hurt her."
    "Yakında karar vermem gerekecek. Onu incitmek istemiyorum."

# game/Scenes/Jez/jez13.rpy:300
translate turkish jez13_3c440e53:

    # "And I don't want her Mamá to hurt me."
    "Ve annesinin de beni incitmesini istemiyorum."

