    # jav "Good morning."
    jav "Günaydın."

# game/Scenes/Jez/jez13.rpy:179
translate turkish jez13_fe0bdf4c_1:

    # pc "Good morning."
    pc "Günaydın."

# game/Scenes/Jez/jez13.rpy:180
