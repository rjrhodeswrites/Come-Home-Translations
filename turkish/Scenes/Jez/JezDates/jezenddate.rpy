# game/Scenes/Jez/JezDates/jezenddate.rpy:7
translate turkish jezenddate_d41d8cd9:

    # voice 'voices/jez_myplace.mp3'
    voice 'voices/jez_myplace.mp3'

# game/Scenes/Jez/JezDates/jezenddate.rpy:8
translate turkish jezenddate_687d0176:

    # det "So, do you want to come back to my place for a while?"
    det "Peki, bir süreliğine benim evime gelmek ister misin?"

# game/Scenes/Jez/JezDates/jezenddate.rpy:9
translate turkish jezenddate_30d6b817:

    # det "Mamá's got Javi for a bit. We could spend some time together."
    det "Javi bir süreliğine annemle kalacak. Biraz vakit geçirebiliriz."

# game/Scenes/Jez/JezDates/jezenddate.rpy:12
translate turkish jezenddate_3ba845d3:

    # det "Good, let's go."
    det "Tamam, gidelim."

# game/Scenes/Jez/JezDates/jezenddate.rpy:15
translate turkish jezenddate_588b9a6e:

    # "We get in our cars and I follow her back to her house, where we quickly make our way inside to her bedroom."
    "Arabalarımıza biniyoruz ve ben onu evine kadar takip ediyorum; oraya varır varmaz hemen yatak odasına geçiyoruz."

# game/Scenes/Jez/JezDates/jezenddate.rpy:19
translate turkish jezenddate_77b42da9:

    # det "Oh, alright then. Well I had a nice date anyway. I'll see you later, [pcname]."
    det "Oh, peki o zaman. Neyse, yine de güzel bir randevuydu. Görüşürüz, [pcname]."

# game/Scenes/Jez/JezDates/jezenddate.rpy:21
translate turkish jezenddate_b4d69820:

    # "I lean in and we kiss, my arms wrapped around her."
    "Ona doğru eğiliyorum ve öpüşüyoruz, kollarım onu sarmış durumda."

# game/Scenes/Jez/JezDates/jezenddate.rpy:22
translate turkish jezenddate_3091dff1:

    # pc "Bye, Jez. See you again soon."
    pc "Hoşça kal, Jez. Yakında tekrar görüşürüz."

# game/Scenes/Jez/JezDates/jezenddate.rpy:25
translate turkish jezenddate_f48c2630:

    # "She leaves, and I go back out to my car and drive away."
    "O ayrılıyor, ben de arabama dönüp uzaklaşıyorum."

# game/Scenes/Jez/JezDates/jezenddate.rpy:29
translate turkish jezenddate_716db417:

    # det "I had a really good time. I'm looking forward to doing this again soon."
    det "Gerçekten çok iyi vakit geçirdim. Bunu yakında tekrar yapmayı dört gözle bekliyorum."

# game/Scenes/Jez/JezDates/jezenddate.rpy:30
translate turkish jezenddate_03eaad50:

    # pc "Me too."
    pc "Ben de."

# game/Scenes/Jez/JezDates/jezenddate.rpy:33
translate turkish jezenddate_398aacb4:

    # det "I'd invite you over to my place, but I'm not quite ready for my son to meet you yet."
    det "Seni evime davet etmek isterdim, ama oğlumun seninle tanışmasına henüz tam olarak hazır değilim."

# game/Scenes/Jez/JezDates/jezenddate.rpy:34
translate turkish jezenddate_70367ea3:

    # det "I don't want him to get confused by male figures being in his life for only a short time."
    det "Hayatında sadece kısa bir süre kalacak erkek figürler yüzünden kafasının karışmasını istemiyorum."

# game/Scenes/Jez/JezDates/jezenddate.rpy:35
translate turkish jezenddate_6cf8b822:

    # det "I want to make sure that this thing between me and you is real before we do that. I hope you understand."
    det "Bunu yapmadan önce, aramızdaki ilişkinin gerçek olduğundan emin olmak istiyorum. Umarım anlarsın."

# game/Scenes/Jez/JezDates/jezenddate.rpy:36
translate turkish jezenddate_cca20d9e:

    # pc "I do understand."
    pc "Anlıyorum."

# game/Scenes/Jez/JezDates/jezenddate.rpy:38
translate turkish jezenddate_3239d4cf:

    # det "Thanks."
    det "Teşekkürler."

# game/Scenes/Jez/JezDates/jezenddate.rpy:41
translate turkish jezenddate_b4d69820_1:

    # "I lean in and we kiss, my arms wrapped around her."
    "Ona doğru eğildim ve öpüştük, kollarımı ona doladım."

# game/Scenes/Jez/JezDates/jezenddate.rpy:43
translate turkish jezenddate_ef81804e:

    # det "Wow, that was nice. Making it really hard for me to say goodbye."
    det "Vay canına, bu çok güzeldi. Veda etmemi gerçekten zorlaştırıyor."

# game/Scenes/Jez/JezDates/jezenddate.rpy:44
translate turkish jezenddate_c18fe3a7:

    # det "But I have to. Bye, [pcname]."
    det "Ama etmek zorundayım. Hoşça kal, [pcname]."

# game/Scenes/Jez/JezDates/jezenddate.rpy:45
translate turkish jezenddate_3091dff1_1:

    # pc "Bye, Jez. See you again soon."
    pc "Hoşça kal, Jez. Yakında tekrar görüşürüz."

# game/Scenes/Jez/JezDates/jezenddate.rpy:48
translate turkish jezenddate_f48c2630_1:

    # "She leaves, and I go back out to my car and drive away."
    "O ayrıldı, ben de arabama dönüp uzaklaştım."

