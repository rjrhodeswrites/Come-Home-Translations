translate turkish jezfirstdate_552b166c:

    # det "Hey, [pcname]. You doing anything tonight?"
    det "Selam, [pcname]. Bu akşam bir planın var mı?"

# game/Scenes/Jez/JezDates/jezfirstdate.rpy:13
translate turkish jezfirstdate_f924b941:

    # det "With the meth lab shut down, I actually have a little more free time in the evenings."
    det "Metamfetamin laboratuvarı kapatıldığı için, akşamları aslında biraz daha boş vaktim var."

# game/Scenes/Jez/JezDates/jezfirstdate.rpy:14
translate turkish jezfirstdate_7f3a988e:

    # det "You feel like hitting the bar with me?"
    det "Benimle bara gitmek ister misin?"

# game/Scenes/Jez/JezDates/jezfirstdate.rpy:18
translate turkish jezfirstdate_de415fd1:

    # det "Great! I'll see you at The Pit in about half an hour, okay?"
    det "Harika! Yaklaşık yarım saat sonra The Pit’te görüşürüz, tamam mı?"

# game/Scenes/Jez/JezDates/jezfirstdate.rpy:19
translate turkish jezfirstdate_b0ab0038:

    # pc "Sounds good. See you there."
    pc "Kulağa hoş geliyor. Orada görüşürüz."

# game/Scenes/Jez/JezDates/jezfirstdate.rpy:23
translate turkish jezfirstdate_5000acd7:

    # det "Aw alright. Well if you change your mind, just give me a call sometime."
    det "Tamam, peki. Fikrini değiştirirsen, ara sıra beni ara."

# game/Scenes/Jez/JezDates/jezfirstdate.rpy:24
translate turkish jezfirstdate_39a5e291:

    # det "I should be available most evenings now."
    det "Artık çoğu akşam boş olacağım."

# game/Scenes/Jez/JezDates/jezfirstdate.rpy:25
translate turkish jezfirstdate_64c8cb1f:

    # pc "Okay, I will."
    pc "Tamam, ararım."

# game/Scenes/Jez/JezDates/jezfirstdate.rpy:26
translate turkish jezfirstdate_bd2ce11d:

    # det "See you later, [pcname]."
    det "Görüşürüz, [pcname]."

