# game/Scenes/Jez/JezDates/jezluigisdate.rpy:29
translate turkish jezluigisstartdate_ec0fa6ca:

    # "I meet Jez at Luigi's and we sit and order our meals."
    "Luigi's'te Jez ile buluşuyorum, oturup yemeklerimizi sipariş ediyoruz."

# game/Scenes/Jez/JezDates/jezluigisdate.rpy:30
translate turkish jezluigisstartdate_c57a5228:

    # "Then we chat for a while."
    "Sonra bir süre sohbet ediyoruz."

# game/Scenes/Jez/JezDates/jezluigisdate.rpy:33
translate turkish jezluigisstartdate_0875967f:

    # "The server brings our food out, and we continue talking while we eat."
    "Garson yemeklerimizi getiriyor ve biz de yerken konuşmaya devam ediyoruz."

# game/Scenes/Jez/JezDates/jezluigisdate.rpy:35
translate turkish jezluigisstartdate_3c0f7991:

    # "When we're done eating, we just hang around and talk for a while longer."
    "Yemeğimizi bitirdiğimizde, biraz daha takılıp sohbet ediyoruz."

# game/Scenes/Jez/JezDates/jezluigisdate.rpy:38
translate turkish jezluigisstartdate_e9a5d339:

    # "We could probably sit and chat all night, but it's starting to get late."
    "Muhtemelen bütün gece oturup sohbet edebiliriz, ama saat geç olmaya başladı."

