    new "2. günün sabahında."

    # game/Scenes/Jez/jez0.rpy:53
    old "I don't mind"
    new "Sorun değil"

    # game/Scenes/Jez/jez0.rpy:56
    old "I'd rather not"
    new "Tercihen istemem"

    # game/Scenes/Jez/jez0.rpy:63
    old "Who else have you interviewed?"
    new "Başka kimlerle konuştun?"

    # game/Scenes/Jez/jez0.rpy:79
    old "Have you looked at his work any?"
    new "Çalışmalarına hiç baktın mı?"

    # game/Scenes/Jez/jez0.rpy:99
    old "Did you do any investigation around the house?"
    new "Evin çevresinde herhangi bir araştırma yaptın mı?"

    # game/Scenes/Jez/jez0.rpy:109
    old "Do you think he was killed?"
    new "Sence öldürüldü mü?"

    # game/Scenes/Jez/jez0.rpy:124
    old "So, you have no real leads?"
    new "Yani, elinde gerçek bir ipucu yok mu?"

    # game/Scenes/Jez/jez0.rpy:140
    old "Nothing else right now."
    new "Şu anda başka bir şey yok."

