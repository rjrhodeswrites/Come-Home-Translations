# game/Scenes/Jez/jez3.rpy:16
translate turkish jez3_b7d0283a:

    # "Detective Rodriguez picks up the phone after a single ring, as if she had been holding her phone in her hand."
    "Dedektif Rodriguez, sanki telefonu elinde tutuyormuş gibi, tek bir zil sesinden sonra telefonu açtı."

# game/Scenes/Jez/jez3.rpy:18
translate turkish jez3_d41d8cd9:

    # voice 'voices/jez_answering.mp3'
    voice 'voices/jez_answering.mp3'

# game/Scenes/Jez/jez3.rpy:19
translate turkish jez3_6673062e:

    # det "Detective Rodriguez."
    det "Dedektif Rodriguez."

# game/Scenes/Jez/jez3.rpy:20
translate turkish jez3_416b4b28:

    # pc "Hello, this is [pcname]."
    pc "Merhaba, ben [pcname]."

# game/Scenes/Jez/jez3.rpy:22
translate turkish jez3_d41d8cd9_1:

    # voice 'voices/jez_hey.mp3'
    voice 'voices/jez_hey.mp3'

# game/Scenes/Jez/jez3.rpy:23
translate turkish jez3_5f1522eb:

    # det "Hey, [pcname]. What's up?"
    det "Selam, [pcname]. N'aber?"

# game/Scenes/Jez/jez3.rpy:24
translate turkish jez3_eb667b3e:

    # pc "I had some new information about my dad's case. I was able to get into his laptop."
    pc "Babamın davasıyla ilgili yeni bilgiler edindim. Onun dizüstü bilgisayarına girmeyi başardım."

# game/Scenes/Jez/jez3.rpy:25
translate turkish jez3_a1187622:

    # pc "I found a bunch of e-mails between him and this Whitney person."
    pc "Onunla Whitney adındaki kişi arasında bir sürü e-posta buldum."

# game/Scenes/Jez/jez3.rpy:26
translate turkish jez3_d2f98bdb:

    # det "Hey, [pcname]. Hold on a second."
    det "Selam, [pcname]. Bir saniye bekle."

# game/Scenes/Jez/jez3.rpy:28
translate turkish jez3_77774b9f:

    # det "I'll be honest with you. I've had a really bad day and I have a migraine from hell."
    det "Sana dürüst olacağım. Gerçekten berbat bir gün geçirdim ve başım cehennem gibi ağrıyor."

# game/Scenes/Jez/jez3.rpy:29
translate turkish jez3_b0a1faa8:

    # det "Your voice on this phone is making my head pound. What do you say we meet up in person."
    det "Bu telefondaki sesin başımı çatlatıyor. Yüz yüze görüşmeye ne dersin?"

# game/Scenes/Jez/jez3.rpy:30
translate turkish jez3_7cfb0b0e:

    # det "Do you know where The Pit is?"
    det "The Pit'in nerede olduğunu biliyor musun?"

# game/Scenes/Jez/jez3.rpy:31
translate turkish jez3_5a003c29:

    # pc "The bar downtown?"
    pc "Şehir merkezindeki bar mı?"

# game/Scenes/Jez/jez3.rpy:32
translate turkish jez3_c60f38c7:

    # det "That's it. Want to meet me there and have this conversation over drinks?"
    det "Evet, orası. Orada buluşup bu konuyu bir şeyler içerken konuşmak ister misin?"

# game/Scenes/Jez/jez3.rpy:33
translate turkish jez3_a5c9c049:

    # det "I could really use a drink."
    det "Bir içkiye gerçekten ihtiyacım var."

# game/Scenes/Jez/jez3.rpy:36
translate turkish jez3_2ba5f0eb:

    # det "Great, I'll be there in two."
    det "Harika, iki dakikaya orada olurum."

# game/Scenes/Jez/jez3.rpy:38
translate turkish jez3_cd4d07e3:

    # det "Come on man, give me a break."
    det "Hadi ama dostum, bana bir şans ver."

# game/Scenes/Jez/jez3.rpy:39
translate turkish jez3_84d27d16:

    # det "I just got finished working a 24-hour shift."
    det "24 saatlik vardiyamı yeni bitirdim."

# game/Scenes/Jez/jez3.rpy:40
translate turkish jez3_cd598c64:

    # pc "Alright, I'll be there in five minutes."
    pc "Tamam, beş dakikaya orada olurum."

# game/Scenes/Jez/jez3.rpy:41
translate turkish jez3_2ba5f0eb_1:

    # det "Great, I'll be there in two."
    det "Harika, iki dakikaya orada olurum."

# game/Scenes/Jez/jez3.rpy:44
translate turkish jez3_d1ed5b1b:

    # "She hangs up and I quickly get ready and head out to the car."
    "Telefonu kapattı, ben de çabucak hazırlanıp arabaya doğru çıktım."

# game/Scenes/Jez/jez3.rpy:45
translate turkish jez3_5ddb21e5:

    # "Only a few minutes later, I park in front of the bar."
    "Sadece birkaç dakika sonra, barın önüne park ettim."

# game/Scenes/Jez/jez3.rpy:47
translate turkish jez3_23e3b6db:

    # "I walk in and am met with a cloud of cigarette smoke, the dull roar of conversation, and a jukebox playing some rock song I've never heard."
    "İçeri giriyorum ve bir sigara dumanı bulutu, sohbetlerin boğuk uğultusu ve daha önce hiç duymadığım bir rock şarkısı çalan bir müzik kutusuyla karşılaşıyorum."

# game/Scenes/Jez/jez3.rpy:48
translate turkish jez3_64d6327f:

    # "It takes a few moments for me to notice Detective Rodriguez waving at me from a booth in the back of the bar."
    "Barın arkasındaki bir masadan bana el sallayan Dedektif Rodriguez’i fark etmem biraz zaman alıyor."

# game/Scenes/Jez/jez3.rpy:49
translate turkish jez3_398f4ad8:

    # "I walk over and sit down across from her."
    "Yanına gidip karşısına oturuyorum."

# game/Scenes/Jez/jez3.rpy:53
translate turkish jez3_71bded69:

    # det "Thanks for meeting me here. I know it's not very professional, but I need a drink real bad and I hate drinking alone."
    det "Burada buluşmaya geldiğin için teşekkürler. Bunun pek profesyonelce olmadığını biliyorum, ama içkiye çok ihtiyacım var ve yalnız içmekten nefret ederim."

# game/Scenes/Jez/jez3.rpy:54
translate turkish jez3_ac23b499:

    # det "I ordered you a beer too. You're twenty-one, right?"
    det "Sana da bir bira sipariş ettim. Yirmi bir yaşındasın, değil mi?"

# game/Scenes/Jez/jez3.rpy:55
translate turkish jez3_c2113814:

    # pc "Twenty-two."
    pc "Yirmi iki."

# game/Scenes/Jez/jez3.rpy:56
translate turkish jez3_da9af380:

    # det "Good. Drink up then."
    det "Güzel. O zaman iç hadi."

# game/Scenes/Jez/jez3.rpy:59
translate turkish jez3_899cb188:

    # "I take a drink of the beer in front of me. It's nice and smooth."
    "Önümdeki biradan bir yudum alıyorum. Tadı güzel ve yumuşak."

# game/Scenes/Jez/jez3.rpy:62
translate turkish jez3_cfdfe09b:

    # pc "I'm just here to talk."
    pc "Buraya sadece konuşmak için geldim."

# game/Scenes/Jez/jez3.rpy:64
translate turkish jez3_a023156a:

    # det "So I'm just going to be drinking alone anyway. So be it."
    det "Yani yine de tek başıma içeceğim. Öyle olsun."

# game/Scenes/Jez/jez3.rpy:68
translate turkish jez3_e5c2530c:

    # det "Okay, so you got into your dad's laptop and found some correspondence?"
    det "Tamam, babasının dizüstü bilgisayarına girip bazı yazışmalar mı buldun?"

# game/Scenes/Jez/jez3.rpy:69
translate turkish jez3_66708b9a:

    # pc "Yeah, and it's crazy."
    pc "Evet, ve çok çılgınca."

# game/Scenes/Jez/jez3.rpy:70
translate turkish jez3_08461fea:

    # det "Give me the summary. You can send the entire thing over to my e-mail later."
    det "Özetini anlat. Tam metni daha sonra e-postama gönderebilirsin."

# game/Scenes/Jez/jez3.rpy:71
translate turkish jez3_2af7a240:

    # pc "Well the gist is that he and Whitney were planning a trip."
    pc "Özetle, o ve Whitney bir seyahat planlıyorlardı."

# game/Scenes/Jez/jez3.rpy:72
translate turkish jez3_b2a62e0b:

    # det "So he did run off with her?"
    det "Yani onunla kaçtı mı?"

# game/Scenes/Jez/jez3.rpy:73
translate turkish jez3_d0c263e4:

    # pc "No, he was the only one going on this trip."
    pc "Hayır, bu seyahate sadece o gidiyordu."

# game/Scenes/Jez/jez3.rpy:74
translate turkish jez3_2908401f:

    # det "Okay, so where did he go?"
    det "Tamam, peki nereye gitti?"

# game/Scenes/Jez/jez3.rpy:75
translate turkish jez3_0a1d6430:

    # pc "I'm not sure, but the strangest part is how he got there."
    pc "Emin değilim, ama en tuhaf kısmı oraya nasıl gittiği."

# game/Scenes/Jez/jez3.rpy:76
translate turkish jez3_09d6eafc:

    # det "Explain."
    det "Açıkla."

# game/Scenes/Jez/jez3.rpy:77
translate turkish jez3_61000743:

    # pc "He built some sort of device. I found it in the basement. It looks like a hula hoop."
    pc "Bir tür cihaz yapmış. Bunu bodrumda buldum. Hula hoop'a benziyor."

# game/Scenes/Jez/jez3.rpy:79
translate turkish jez3_b0e7f9ea:

    # det "What? You lost me."
    det "Ne? Anlamadım."

# game/Scenes/Jez/jez3.rpy:80
translate turkish jez3_40d85287:

    # pc "I don't know how to explain it. It looks like a hoop. He and Whitney built it together. When it's activated, it's supposed to transport you somewhere."
    pc "Nasıl açıklayacağımı bilmiyorum. Bir çember gibi görünüyor. O ve Whitney bunu birlikte yaptılar. Çalıştırıldığında, seni bir yere götürmesi gerekiyor."

# game/Scenes/Jez/jez3.rpy:81
translate turkish jez3_1f06310c:

    # pc "He needed the diamonds to activate it. That's why he stole them."
    pc "Cihazı çalıştırmak için elmaslara ihtiyacı vardı. Bu yüzden onları çaldı."

# game/Scenes/Jez/jez3.rpy:82
translate turkish jez3_35f3019c:

    # det "And the meth too?"
    det "Peki ya metamfetamin?"

# game/Scenes/Jez/jez3.rpy:83
translate turkish jez3_ff210007:

    # pc "Right. He used the meth to speed his heart rate up so his heart didn't stop during the transportation."
    pc "Doğru. Nakil sırasında kalbi durmasın diye kalp atış hızını artırmak için metamfetamin kullandı."

# game/Scenes/Jez/jez3.rpy:84
translate turkish jez3_22ea6d6f:

    # det "You know this is the dumbest fucking thing I've ever heard right?"
    det "Bunun şimdiye kadar duyduğum en aptalca şey olduğunu biliyorsun, değil mi?"

# game/Scenes/Jez/jez3.rpy:85
translate turkish jez3_a2fed6c2:

    # pc "I'm just telling you what they were talking about."
    pc "Ben sadece onların ne hakkında konuştuklarını anlatıyorum."

# game/Scenes/Jez/jez3.rpy:87
translate turkish jez3_1b198a7a:

    # det "Well I did look into the diamond theft."
    det "Peki, elmas hırsızlığını araştırdım."

# game/Scenes/Jez/jez3.rpy:88
translate turkish jez3_0768d1c5:

    # det "There was a jewelry store over in Whiterock that was broken into only a few days before your dad went missing."
    det "Babanın kaybolmasından sadece birkaç gün önce Whiterock'ta bir kuyumcuya hırsız girmiş."

# game/Scenes/Jez/jez3.rpy:89
translate turkish jez3_727a0b8a:

    # det "It was just like you described. The security was disabled for only a minute."
    det "Tam da senin tarif ettiğin gibiydi. Güvenlik sistemi sadece bir dakikalığına devre dışı bırakılmıştı."

# game/Scenes/Jez/jez3.rpy:90
translate turkish jez3_75b55784:

    # det "The thief entered through the back door, walked in, took two three-carat diamond rings, then walked back out."
    det "Hırsız arka kapıdan girmiş, içeri girip iki adet üç karatlık elmas yüzük almış, sonra da çıkıp gitmiş."

# game/Scenes/Jez/jez3.rpy:91
translate turkish jez3_a0cd13f9:

    # det "Security kicked back on. There would have been no trace that anybody was even there, except the rings were gone."
    det "Güvenlik sistemi hemen yeniden devreye girmiş. Yüzükler kaybolmuş olsaydı, orada birinin bulunduğuna dair hiçbir iz kalmazdı."

# game/Scenes/Jez/jez3.rpy:92
translate turkish jez3_a595c814:

    # pc "So he did it."
    pc "Yani o yapmış."

# game/Scenes/Jez/jez3.rpy:93
translate turkish jez3_2cf2afa7:

    # det "It seems that way."
    det "Öyle görünüyor."

# game/Scenes/Jez/jez3.rpy:94
translate turkish jez3_7b6c844b:

    # pc "Any clue where he got the meth?"
    pc "Metamfetamini nereden bulduğuna dair bir ipucu var mı?"

# game/Scenes/Jez/jez3.rpy:96
translate turkish jez3_6063143c:

    # det "God, there's no telling. That shit is all over Skyhill."
    det "Tanrım, kim bilir. O mal Skyhill’in her yerinde dolaşıyor."

# game/Scenes/Jez/jez3.rpy:97
translate turkish jez3_399bdc0f:

    # pc "Really?"
    pc "Gerçekten mi?"

# game/Scenes/Jez/jez3.rpy:99
translate turkish jez3_94032961:

    # det "Yes. That's what I've been working on. That's my primary job."
    det "Evet. Ben de bunun üzerinde çalışıyorum. Bu benim asıl işim."

# game/Scenes/Jez/jez3.rpy:100
translate turkish jez3_91bebae5:

    # det "We know a few dealers and we can find people who buy meth."
    det "Birkaç satıcı tanıyoruz ve metamfetamin alan kişileri bulabiliriz."

# game/Scenes/Jez/jez3.rpy:101
translate turkish jez3_ec847758:

    # det "But we can't seem to locate where the shit is coming from. Somebody around here is cooking it, and I don't know where."
    det "Ama o malın nereden geldiğini bir türlü tespit edemiyoruz. Buralarda biri onu üretiyor, ama nerede olduğunu bilmiyorum."

# game/Scenes/Jez/jez3.rpy:102
translate turkish jez3_ea875425:

    # pc "I had no idea it was that bad around here."
    pc "Buraların bu kadar kötü olduğunu hiç bilmiyordum."

# game/Scenes/Jez/jez3.rpy:103
translate turkish jez3_49c82960:

    # det "Yeah. So I'm not sure exactly where your dad got it at, but I've been questioning people."
    det "Evet. Yani babanın tam olarak nereden aldığını bilmiyorum, ama insanları sorguluyorum."

# game/Scenes/Jez/jez3.rpy:104
translate turkish jez3_5d188bd8:

    # det "Look [pcname], it sounds to me like your dad was having some sort of psychotic break."
    det "Bak [pcname], bana öyle geliyor ki baban bir tür psikotik kriz geçiriyordu."

# game/Scenes/Jez/jez3.rpy:105
translate turkish jez3_7a8cf8a1:

    # det "Teleporting hula-hoops, diamond theft, using meth to speed up your heart rate."
    det "Hula-hoop'ları ışınlamak, elmas hırsızlığı, kalp atışını hızlandırmak için metamfetamin kullanmak."

# game/Scenes/Jez/jez3.rpy:106
translate turkish jez3_8ebd5686:

    # det "That sounds like a bunch of nonsense to me."
    det "Bana hepsi saçmalık gibi geliyor."

# game/Scenes/Jez/jez3.rpy:107
translate turkish jez3_c417e350:

    # pc "Yeah."
    pc "Evet."

# game/Scenes/Jez/jez3.rpy:108
translate turkish jez3_4c3ec6a3:

    # det "But the more we dig into it, the more likely we're going to find him."
    det "Ama ne kadar çok araştırırsak, onu bulma ihtimalimiz o kadar artar."

# game/Scenes/Jez/jez3.rpy:109
translate turkish jez3_e004b1ab:

    # det "So keep digging."
    det "O yüzden araştırmaya devam et."

# game/Scenes/Jez/jez3.rpy:110
translate turkish jez3_58f0fc2d:

    # det "Send me the info that you found on the laptop and I'll see if I can find this Whitney person."
    det "Dizüstü bilgisayarda bulduğun bilgileri bana gönder, ben de bu Whitney denen kişiyi bulmaya çalışayım."

# game/Scenes/Jez/jez3.rpy:111
translate turkish jez3_955d194d:

    # det "Assuming that she's real and not somebody that your dad made up."
    det "Tabii ki onun gerçek bir kişi olduğunu ve babanın uydurduğu biri olmadığını varsayarsak."

# game/Scenes/Jez/jez3.rpy:112
translate turkish jez3_25bfd7d2:

    # pc "It seems like she's real to me, based on the e-mails."
    pc "E-postalara bakılırsa bana gerçek gibi geliyor."

# game/Scenes/Jez/jez3.rpy:113
translate turkish jez3_2fc85b75:

    # det "Alright. Well let's find her."
    det "Tamam. Hadi onu bulalım o zaman."

# game/Scenes/Jez/jez3.rpy:114
translate turkish jez3_e70c1658:

    # pc "I could e-mail her from Dad's laptop."
    pc "Babamın dizüstü bilgisayarından ona e-posta gönderebilirim."

# game/Scenes/Jez/jez3.rpy:116
translate turkish jez3_3997e2c3:

    # det "That's not a bad idea. Give it a shot. Start up a conversation with her, see if you can find out more about her."
    det "Fena fikir değil. Bir dene. Onunla sohbet et, hakkında daha fazla bilgi edinebilir misin bir bak."

# game/Scenes/Jez/jez3.rpy:117
translate turkish jez3_4d9bef33:

    # det "And let me know anything you find."
    det "Ve bulduğun her şeyi bana haber ver."

# game/Scenes/Jez/jez3.rpy:119
translate turkish jez3_5bc44b07:

    # pc "I will."
    pc "Veririm."

# game/Scenes/Jez/jez3.rpy:121
translate turkish jez3_b734eba7:

    # det "Thanks for meeting me here. I needed this."
    det "Burada benimle buluştuğun için teşekkürler. Buna ihtiyacım vardı."

# game/Scenes/Jez/jez3.rpy:122
translate turkish jez3_ba520f30:

    # det "Now I have to get home. I haven't seen my kid in two days."
    det "Şimdi eve gitmem lazım. Çocuğumu iki gündür görmedim."

# game/Scenes/Jez/jez3.rpy:123
translate turkish jez3_ce82357f:

    # pc "You have a kid?"
    pc "Çocuğun mu var?"

# game/Scenes/Jez/jez3.rpy:125
translate turkish jez3_71fc0e0c:

    # det "Yeah, Javi. He's seven. My mom's taking care of him right now."
    det "Evet, Javi. Yedi yaşında. Şu anda annem ona bakıyor."

# game/Scenes/Jez/jez3.rpy:126
translate turkish jez3_798c23ff:

    # det "You surprised that I have a kid?"
    det "Çocuğum olmasına şaşırdın mı?"

# game/Scenes/Jez/jez3.rpy:130
translate turkish jez3_632e262d:

    # det "Thanks. I had him when I was 17."
    det "Teşekkürler. Onu 17 yaşındayken doğurdum."

# game/Scenes/Jez/jez3.rpy:133
translate turkish jez3_ae370b70:

    # det "I'm not. You don't have to be married to have a kid, you know."
    det "Hayır, şaşırmadım. Çocuk sahibi olmak için evli olman gerekmez, biliyorsun."

# game/Scenes/Jez/jez3.rpy:134
translate turkish jez3_2356fff3:

    # pc "Right, I didn't mean anything by it."
    pc "Haklısın, öyle demek istemedim."

# game/Scenes/Jez/jez3.rpy:137
translate turkish jez3_a82f6cf9:

    # det "Oh, I thought you seemed surprised."
    det "Ah, şaşırmış gibi göründüğünü sanmıştım."

# game/Scenes/Jez/jez3.rpy:139
translate turkish jez3_12633b63:

    # det "Anyway, I better get home."
    det "Neyse, eve gitsem iyi olacak."

# game/Scenes/Jez/jez3.rpy:140
translate turkish jez3_d0fa7dfb:

    # det "I'll see you later, [pcname]."
    det "Görüşürüz, [pcname]."

# game/Scenes/Jez/jez3.rpy:141
translate turkish jez3_7b4cad00:

    # pc "Bye Detective Rodriguez."
    pc "Hoşça kal Dedektif Rodriguez."

# game/Scenes/Jez/jez3.rpy:144
translate turkish jez3_d41d8cd9_2:

    # voice 'voices/jez_3_1.mp3'
    voice 'voices/jez_3_1.mp3'

# game/Scenes/Jez/jez3.rpy:145
translate turkish jez3_e7adfac5:

    # det "You can call me Jez, okay? That's my first name."
    det "Bana Jez diyebilirsin, tamam mı? Bu benim ilk adım."

# game/Scenes/Jez/jez3.rpy:146
translate turkish jez3_db79b546:

    # pc "Okay. Bye Jez."
    pc "Tamam. Hoşça kal Jez."

# game/Scenes/Jez/jez3.rpy:151
translate turkish jez3_d41d8cd9_3:

    # voice 'voices/jez_goodnight.mp3'
    voice 'voices/jez_goodnight.mp3'

# game/Scenes/Jez/jez3.rpy:152
translate turkish jez3_2f6a1cc2:

    # det "Good night."
    det "İyi geceler."

# game/Scenes/Jez/jez3.rpy:155
translate turkish jez3_40a94195:

    # "She stands up and walks out of the bar. I sit there alone for a few minutes, thinking about our conversation."
    "Ayağa kalkıp bardan çıkıyor. Ben de orada birkaç dakika tek başıma oturup, sohbetimizi düşünüyorum."

# game/Scenes/Jez/jez3.rpy:156
translate turkish jez3_06361269:

    # "She thinks Dad was crazy. I'm not so sure."
    "O, babamın deli olduğunu düşünüyor. Ben o kadar emin değilim."

# game/Scenes/Jez/jez3.rpy:157
translate turkish jez3_d8c1ec54:

    # "The things in his notes and in his conversations with Whitney were wild, but there is so much there that seems true."
    "Notlarında ve Whitney ile yaptığı konuşmalardaki şeyler çılgınca geliyordu, ama orada gerçek gibi görünen pek çok şey var."

# game/Scenes/Jez/jez3.rpy:158
translate turkish jez3_3da12785:

    # "Whitney definitely seems like a real person. I just need to find out who she is."
    "Whitney kesinlikle gerçek bir insan gibi görünüyor. Sadece onun kim olduğunu bulmam gerekiyor."

# game/Scenes/Jez/jez3.rpy:159
translate turkish jez3_8298e18a:

    # "Then maybe I can find out where my dad went."
    "O zaman belki babamın nereye gittiğini öğrenebilirim."

# game/Scenes/Jez/jez3.rpy:160
translate turkish jez3_bc8a9774:

    # "Eventually, I stand up and walk out of the bar, then head home for the night."
    "Sonunda ayağa kalkıp bardan çıkıyorum, sonra geceyi geçirmek üzere eve gidiyorum."

translate turkish strings:

    # game/Scenes/Jez/jez3.rpy:2
    old "You need to get into your dad's computer. Talk to Adrian about it. She's been at the grocery store trying to find a new game."
    new "Babanın bilgisayarına girmen gerekiyor. Bu konuyu Adrian’la konuş. O, markette yeni bir oyun arıyor."

    # game/Scenes/Jez/jez3.rpy:3
    old "Once you search your dad's laptop, call Detective Rodriguez from your bedroom in the evening."
    new "Babanın dizüstü bilgisayarını aradıktan sonra, akşam yatak odandan Dedektif Rodriguez’i ara."

    # game/Scenes/Jez/jez3.rpy:35
    old "Sure, I'll be there in five minutes"
    new "Tabii, beş dakikaya orada olurum"

    # game/Scenes/Jez/jez3.rpy:37
    old "That doesn't seem very professional"
    new "Bu pek profesyonelce görünmüyor"

    # game/Scenes/Jez/jez3.rpy:58
    old "Drink"
    new "İç"

    # game/Scenes/Jez/jez3.rpy:61
    old "Don't Drink"
    new "İçme"

    # game/Scenes/Jez/jez3.rpy:128
    old "You just look so young"
    new "Çok genç görünüyorsun"

    # game/Scenes/Jez/jez3.rpy:131
    old "I didn't know that you were married"
    new "Evli olduğunu bilmiyordum"

