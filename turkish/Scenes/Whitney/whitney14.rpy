translate turkish rjwhitneywarning_66c62f1f:

    # wt "Wait, we have trouble."
    wt "Bekle, bir sorun var."

# game/Scenes/Whitney/whitney14.rpy:260
translate turkish rjwhitneywarning_06b7e2ed:

    # pc "What!?"
    pc "Ne!?"

# game/Scenes/Whitney/whitney14.rpy:261
translate turkish rjwhitneywarning_20183cb0:

    # wt "Just grab the whole box and get back to the van, now!"
    wt "Hemen kutunun tamamını al ve minibüse geri dön, hemen!"

# game/Scenes/Whitney/whitney14.rpy:264
translate turkish rjwhitneywarning_06b7e2ed_1:

    # pc "What!?"
    pc "Ne!?"

# game/Scenes/Whitney/whitney14.rpy:265
