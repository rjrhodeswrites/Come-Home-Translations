# game/Scenes/Whitney/whitney14.rpy:18
translate turkish whitney14_50df7566:

    # "My phone buzzes in my pocket. Whitney's calling."
    "Cebimdeki telefon titriyor. Whitney arıyor."

# game/Scenes/Whitney/whitney14.rpy:22
translate turkish whitney14_9baa4d84:

    # wt "Are you ready?"
    wt "Hazır mısın?"

# game/Scenes/Whitney/whitney14.rpy:23
translate turkish whitney14_8a4963b6:

    # pc "Ready for what?"
    pc "Neye hazır?"

# game/Scenes/Whitney/whitney14.rpy:24
translate turkish whitney14_ab83914e:

    # wt "To move forward with the next step of the plan."
    wt "Planın bir sonraki adımına geçmek için."

# game/Scenes/Whitney/whitney14.rpy:25
translate turkish whitney14_191f52bf:

    # pc "What {i}is{/i} the next step?"
    pc "Bir sonraki adım {i}nedir{/i}?"

# game/Scenes/Whitney/whitney14.rpy:27
translate turkish whitney14_d8555685:

    # wt "We need diamonds. Two large diamonds."
    wt "Elmaslara ihtiyacımız var. İki büyük elmas."

# game/Scenes/Whitney/whitney14.rpy:28
translate turkish whitney14_6121f377:

    # pc "That's probably really expensive."
    pc "Muhtemelen çok pahalıdır."

# game/Scenes/Whitney/whitney14.rpy:30
translate turkish whitney14_e03107d2:

    # wt "We're not going to pay for them."
    wt "Onların parasını biz ödemeyeceğiz."

# game/Scenes/Whitney/whitney14.rpy:31
translate turkish whitney14_5bb78b12:

    # pc "Wait, what?"
    pc "Bekle, ne?"

# game/Scenes/Whitney/whitney14.rpy:32
translate turkish whitney14_68482c5f:

    # wt "We're going to steal them, just like I did with your dad."
    wt "Onları çalacağız, tıpkı babanla yaptığım gibi."

# game/Scenes/Whitney/whitney14.rpy:33
translate turkish whitney14_b16d9c4d:

    # pc "I thought you were really rich. Why can't you just buy them?"
    pc "Senin gerçekten zengin olduğunu sanıyordum. Neden onları satın almıyorsun ki?"

# game/Scenes/Whitney/whitney14.rpy:35
translate turkish whitney14_e7291356:

    # wt "The ones that we need, at the purity level that we require, are beyond even the money that I have available."
    wt "İhtiyacımız olanları, istediğimiz saflık seviyesinde, elimdeki parayla bile alamam."

# game/Scenes/Whitney/whitney14.rpy:36
translate turkish whitney14_18b47f23:

    # wt "Besides, these diamonds were not humanely harvested. I don't feel bad about stealing from these greedy companies."
    wt "Ayrıca, bu elmaslar insani koşullarda çıkarılmadı. Bu açgözlü şirketlerden çalmak konusunda vicdan azabı duymuyorum."

# game/Scenes/Whitney/whitney14.rpy:37
translate turkish whitney14_79651c65:

    # wt "What we are doing with them is far more important than some aristocrat wearing it on her finger."
    wt "Onlarla yapacağımız şey, bir aristokratın parmağında takmasından çok daha önemli."

# game/Scenes/Whitney/whitney14.rpy:38
translate turkish whitney14_c5daad32:

    # pc "How are we going to pull this off? What if we get caught?"
    pc "Bunu nasıl başaracağız? Ya yakalanırsak?"

# game/Scenes/Whitney/whitney14.rpy:40
translate turkish whitney14_09e85fe5:

    # wt "That's for me to take care of. I'll explain it to you before you go in."
    wt "Bunu halletmek bana düşer. İçeri girmeden önce sana her şeyi açıklayacağım."

# game/Scenes/Whitney/whitney14.rpy:41
translate turkish whitney14_30dd8227:

    # pc "I have to go in?"
    pc "İçeri girmek zorunda mıyım?"

# game/Scenes/Whitney/whitney14.rpy:43
translate turkish whitney14_87885119:

    # wt "Of course you do. I'm in a wheelchair."
    wt "Elbette girmelisin. Ben tekerlekli sandalyedeyim."

# game/Scenes/Whitney/whitney14.rpy:44
translate turkish whitney14_2416510e:

    # wt "But I've arranged everything. You won't get caught. Just like your father didn't get caught when he did this before."
    wt "Ama her şeyi ayarladım. Yakalanmayacaksın. Tıpkı babanın daha önce bunu yaptığında yakalanmadığı gibi."

# game/Scenes/Whitney/whitney14.rpy:45
translate turkish whitney14_f06e3a9b:

    # pc "We're robbing the same place?"
    pc "Aynı yeri mi soyacağız?"

# game/Scenes/Whitney/whitney14.rpy:47
translate turkish whitney14_d1a56e79:

    # wt "Of course not. That would be dumb."
    wt "Elbette hayır. Bu aptalca olurdu."

# game/Scenes/Whitney/whitney14.rpy:48
translate turkish whitney14_ed2f7d18:

    # wt "Just trust me. I know what I'm doing here. Come to my house and we'll get ready."
    wt "Bana güven yeter. Ne yaptığımı biliyorum. Evime gel de hazırlanalım."

# game/Scenes/Whitney/whitney14.rpy:50
translate turkish whitney14_50df7566_1:

    # "My phone buzzes in my pocket. Whitney's calling."
    "Cebimdeki telefonum titriyor. Whitney arıyor."

# game/Scenes/Whitney/whitney14.rpy:54
translate turkish whitney14_6b748407:

    # wt "Are you ready to take the diamonds?"
    wt "Elmasları almaya hazır mısın?"

# game/Scenes/Whitney/whitney14.rpy:55
translate turkish whitney14_f8d534ae:

    # pc "Tonight?"
    pc "Bu gece mi?"

# game/Scenes/Whitney/whitney14.rpy:56
translate turkish whitney14_d9b8f3ae:

    # wt "No better time."
    wt "Daha iyi bir zaman olamaz."

# game/Scenes/Whitney/whitney14.rpy:59
translate turkish whitney14_355c90d9:

    # rj "Whoa! Holupaminute!"
    rj "Vay canına! Bir dakika bekle!"

# game/Scenes/Whitney/whitney14.rpy:62
translate turkish rjwhitneywarning_73195949:

    # rj "I just want to let you know that doing this scene right now will cause you to miss out on Whitney's romance storyline."
    rj "Şu anda bu sahneyi yaparsan Whitney’in romantik hikayesini kaçıracağını bilmeni isterim."

# game/Scenes/Whitney/whitney14.rpy:63
translate turkish rjwhitneywarning_ba4a28b5:

    # rj "If you're not interested in Whitney romantically, no problem, do the diamond heist tonight."
    rj "Whitney’e romantik olarak ilgi duymuyorsan sorun değil, bu gece elmas soygununu yap."

# game/Scenes/Whitney/whitney14.rpy:64
translate turkish rjwhitneywarning_3d1165e2:

    # rj "Otherwise, you might want to advance some with Whitney..."
    rj "Aksi takdirde, elmas soygununu yapmadan önce Whitney ile biraz ilerlemek isteyebilirsin..."

# game/Scenes/Whitney/whitney14.rpy:66
translate turkish rjwhitneywarning_8f5726ba:

    # rj "... to the point where you cum all over her face..."
    rj "...yüzüne boşalana kadar..."

# game/Scenes/Whitney/whitney14.rpy:68
translate turkish rjwhitneywarning_9f0eac4a:

    # rj "... before doing the diamond heist."
    rj "..."

# game/Scenes/Whitney/whitney14.rpy:69
translate turkish rjwhitneywarning_369e3555:

    # rj "It's up to you. If you tell her that you don't want to do it tonight, she'll call you again next Saturday night."
    rj "Karar senin. Eğer ona bu gece yapmak istemediğini söylersen, önümüzdeki Cumartesi gecesi seni tekrar arayacak."

# game/Scenes/Whitney/whitney14.rpy:70
translate turkish rjwhitneywarning_63505504:

    # rj "Did you get all that?"
    rj "Hepsini anladın mı?"

# game/Scenes/Whitney/whitney14.rpy:76
translate turkish rjwhitneywarning_4ecb53ff:

    # rj "Fine, I'll repeat it."
    rj "Tamam, tekrar edeyim."

# game/Scenes/Whitney/whitney14.rpy:79
translate turkish rjwhitneywarning_3a9d25c3:

    # rj "Okay, that's it. Sorry to interrupt! See ya!"
    rj "Tamam, bu kadar. Böldüğüm için özür dilerim! Görüşürüz!"

# game/Scenes/Whitney/whitney14.rpy:84
translate turkish rjwhitneywarning_49e2edaf:

    # wt "Great, come over to my lab and we'll get ready."
    wt "Harika, laboratuvarıma gel de hazırlanalım."

# game/Scenes/Whitney/whitney14.rpy:85
translate turkish rjwhitneywarning_a7e78a4e:

    # pc "Okay, I'm leaving now."
    pc "Tamam, şimdi çıkıyorum."

# game/Scenes/Whitney/whitney14.rpy:87
translate turkish rjwhitneywarning_19b39e94:

    # pc "I'm not ready yet."
    pc "Henüz hazır değilim."

# game/Scenes/Whitney/whitney14.rpy:89
translate turkish rjwhitneywarning_76d673a0:

    # wt "Okay."
    wt "Tamam."

# game/Scenes/Whitney/whitney14.rpy:90
translate turkish rjwhitneywarning_c22c8a75:

    # wt "We should do this soon though, if we are going to do it."
    wt "Yapacaksak, bunu bir an önce yapmalıyız."

# game/Scenes/Whitney/whitney14.rpy:91
translate turkish rjwhitneywarning_23677720:

    # wt "Your father cannot wait forever."
    wt "Baban sonsuza kadar bekleyemez."

# game/Scenes/Whitney/whitney14.rpy:92
translate turkish rjwhitneywarning_395cd6d9:

    # pc "I know. Soon."
    pc "Biliyorum. Yakında."

# game/Scenes/Whitney/whitney14.rpy:94
translate turkish rjwhitneywarning_2adac8aa:

    # wt "Okay. We can try next week then."
    wt "Tamam. O zaman gelecek hafta deneyebiliriz."

# game/Scenes/Whitney/whitney14.rpy:95
translate turkish rjwhitneywarning_0db4d881:

    # wt "I'll talk to you later, [pcname]."
    wt "Sonra konuşuruz, [pcname]."

# game/Scenes/Whitney/whitney14.rpy:96
translate turkish rjwhitneywarning_663246d7:

    # pc "Okay. Bye, Whitney."
    pc "Tamam. Hoşça kal, Whitney."

# game/Scenes/Whitney/whitney14.rpy:99
translate turkish rjwhitneywarning_012c7d57:

    # "We hang up. How am I supposed to steal diamonds?"
    "Telefonu kapatıyoruz. Elmasları nasıl çalacağım?"

# game/Scenes/Whitney/whitney14.rpy:100
translate turkish rjwhitneywarning_514c7ad2:

    # "This is all getting really serious."
    "İşler iyice ciddileşiyor."

# game/Scenes/Whitney/whitney14.rpy:108
translate turkish rjwhitneywarning_8652a2fb:

    # "I arrive at her house and walk through the courtyard towards the front door."
    "Onun evine varıyorum ve avludan geçerek ön kapıya doğru yürüyorum."

# game/Scenes/Whitney/whitney14.rpy:109
translate turkish rjwhitneywarning_7bd312b7:

    # "Her voice startles me when it blares over the intercom."
    "İnterkomdan gelen sesi beni ürkütüyor."

# game/Scenes/Whitney/whitney14.rpy:110
translate turkish rjwhitneywarning_1bb0325b:

    # wt "Hi, [pcname]. I'm in the lab. The door is unlocked."
    wt "Merhaba, [pcname]. Laboratuvardayım. Kapı kilitli değil."

# game/Scenes/Whitney/whitney14.rpy:113
translate turkish rjwhitneywarning_dc712c6d:

    # "I make my way to the lab, where Whitney is waiting for me."
    "Whitney’in beni beklediği laboratuvara doğru ilerliyorum."

# game/Scenes/Whitney/whitney14.rpy:114
translate turkish rjwhitneywarning_5214e180:

    # wt "Your clothing is in the back of the van. Go ahead and get changed."
    wt "Kıyafetlerin minibüsün arkasında. Hadi, üstünü değiştir."

# game/Scenes/Whitney/whitney14.rpy:115
translate turkish rjwhitneywarning_b37180b5:

    # pc "I have to wear different clothing?"
    pc "Farklı bir kıyafet giymem mi gerekiyor?"

# game/Scenes/Whitney/whitney14.rpy:116
translate turkish rjwhitneywarning_61bb1ca5:

    # wt "Yes, you do. Everybody is going to know it's you in that blue shirt."
    wt "Evet, giymelisin. O mavi gömlekle herkes senin olduğunu anlar."

# game/Scenes/Whitney/whitney14.rpy:117
translate turkish rjwhitneywarning_c33734b6:

    # pc "Fine. But I like my blue shirt."
    pc "Peki. Ama mavi gömleğimi seviyorum."

# game/Scenes/Whitney/whitney14.rpy:120
translate turkish rjwhitneywarning_a3f1d669:

    # "I go to the back of the van and change clothes."
    "Minibüsün arkasına gidip kıyafetimi değiştiriyorum."

# game/Scenes/Whitney/whitney14.rpy:123
translate turkish rjwhitneywarning_f46c6704:

    # pc "Is this really necessary?"
    pc "Bu gerçekten gerekli mi?"

# game/Scenes/Whitney/whitney14.rpy:124
translate turkish rjwhitneywarning_ec008765:

    # wt "Yes, if you don't want to be recognized on camera."
    wt "Evet, kamerada tanınmak istemiyorsan."

# game/Scenes/Whitney/whitney14.rpy:125
translate turkish rjwhitneywarning_56afcb31:

    # wt "I was able to plot a route that would avoid getting the van on camera, but I cannot do anything about the cameras inside the building."
    wt "Minibüsün kameraya yakalanmayacağı bir rota çizebildim, ama binanın içindeki kameralar konusunda bir şey yapamam."

# game/Scenes/Whitney/whitney14.rpy:126
translate turkish rjwhitneywarning_2c6002d9:

    # pc "So, fill me in. What is the crazy plan here?"
    pc "Peki, bana durumu anlat. Buradaki çılgın plan nedir?"

# game/Scenes/Whitney/whitney14.rpy:129
translate turkish rjwhitneywarning_506ca14d:

    # wt "I am going to park over here where you will get out and make your way to the back entrance of the jewelry store..."
    wt "Ben buraya park edeceğim, sen buradan inip kuyumcunun arka girişine doğru ilerleyeceksin..."

# game/Scenes/Whitney/whitney14.rpy:132
translate turkish rjwhitneywarning_6b7981aa:

    # wt "...here."
    wt "...buraya."

# game/Scenes/Whitney/whitney14.rpy:133
translate turkish rjwhitneywarning_c840c904:

    # wt "The store has a deadbolt that requires a key, but I have a solution for that."
    wt "Dükkanın anahtar gerektiren bir sürgülü kilidi var, ama bunun için bir çözümüm var."

# game/Scenes/Whitney/whitney14.rpy:136
translate turkish rjwhitneywarning_cb3653db:

    # wt "This is a lockpicking gun. You just put the end of it into the lock and squeeze the trigger."
    wt "Bu bir kilit açma tabancası. Ucunu kilide sokup tetiği çekmen yeterli."

# game/Scenes/Whitney/whitney14.rpy:137
translate turkish rjwhitneywarning_1ba42d5f:

    # wt "I'm sure it will work on the door there."
    wt "Eminim oradaki kapıda işe yarayacaktır."

# game/Scenes/Whitney/whitney14.rpy:138
translate turkish rjwhitneywarning_368080b9:

    # pc "Wait, is that a Nintendo gun? Like for Duck Hunt?"
    pc "Dur, o bir Nintendo tabancası mı? Duck Hunt'taki gibi mi?"

# game/Scenes/Whitney/whitney14.rpy:139
translate turkish rjwhitneywarning_cb7a5d6f:

    # wt "It was. I modified it. Now it's a lockpicking gun."
    wt "Öyleydi. Onu modifiye ettim. Artık bir kilit açma tabancası."

# game/Scenes/Whitney/whitney14.rpy:140
translate turkish rjwhitneywarning_880b4aa8:

    # pc "Okay..."
    pc "Tamam..."

# game/Scenes/Whitney/whitney14.rpy:141
translate turkish rjwhitneywarning_18b9d86b:

    # pc "So, that's it? Just zap the lock and I'm in?"
    pc "Yani, hepsi bu mu? Kilide ateş edince içeri girebilir miyim?"

# game/Scenes/Whitney/whitney14.rpy:144
translate turkish rjwhitneywarning_57ed69cc:

    # wt "Well, yes, you'll be able to get in the building then, but there is a security system."
    wt "Evet, o zaman binaya girebileceksin, ama bir güvenlik sistemi var."

# game/Scenes/Whitney/whitney14.rpy:145
translate turkish rjwhitneywarning_b3ded7f6:

    # wt "Fortunately, you and I will be in contact the entire time and just before you go in, I will disable the alarms remotely."
    wt "Neyse ki, sen ve ben tüm süreç boyunca iletişim halinde olacağız ve sen içeri girmeden hemen önce alarmları uzaktan devre dışı bırakacağım."

# game/Scenes/Whitney/whitney14.rpy:146
translate turkish rjwhitneywarning_45436a60:

    # pc "You can do that?"
    pc "Bunu yapabilir misin?"

# game/Scenes/Whitney/whitney14.rpy:147
translate turkish rjwhitneywarning_ed1b329a:

    # wt "Of course I can do that."
    wt "Tabii ki yapabilirim."

# game/Scenes/Whitney/whitney14.rpy:150
translate turkish rjwhitneywarning_6e0c3693:

    # wt "When you first go in, you will be in the back storage area. You'll have to make your way through there to the office, where the safe is kept."
    wt "İçeri ilk girdiğinde, arka depo alanında olacaksın. Oradan geçip kasanın bulunduğu ofise ulaşman gerekecek."

# game/Scenes/Whitney/whitney14.rpy:151
translate turkish rjwhitneywarning_1547e2f3:

    # pc "A safe? How are we supposed to get into that? Do you know the combination?"
    pc "Kasa mı? Ona nasıl gireceğiz? Şifreyi biliyor musun?"

# game/Scenes/Whitney/whitney14.rpy:152
translate turkish rjwhitneywarning_9778d18a:

    # wt "Yes, actually. I do."
    wt "Evet, aslında biliyorum."

# game/Scenes/Whitney/whitney14.rpy:153
translate turkish rjwhitneywarning_a7d1f229:

    # pc "How?"
    pc "Nasıl?"

# game/Scenes/Whitney/whitney14.rpy:154
translate turkish rjwhitneywarning_284142b3:

    # wt "Don't worry about that. I told you I've been working on this. I haven't just been sitting over here the whole time, twiddling my thumbs."
    wt "Bunun için endişelenme. Sana bunun üzerinde çalıştığımı söylemiştim. Bütün bu zaman boyunca burada oturup boş boş parmaklarımı ovuşturmadım."

# game/Scenes/Whitney/whitney14.rpy:155
translate turkish rjwhitneywarning_b9a33198:

    # wt "The safe has a keypad combination. The code is 96678552."
    wt "Kasada tuş takımı şifresi var. Şifre 96678552."

# game/Scenes/Whitney/whitney14.rpy:156
translate turkish rjwhitneywarning_c386084f:

    # wt "Don't write it down anywhere. I'll remind you over the radio if you forget."
    wt "Hiçbir yere yazma. Unutursan telsizden hatırlatırım."

# game/Scenes/Whitney/whitney14.rpy:159
translate turkish rjwhitneywarning_ddf4be87:

    # wt "Once you get the safe open, you're going to have to find the diamonds. This is the only part I'm not completely sure of."
    wt "Kasayı açtığında elmasları bulman gerekecek. Tam olarak emin olmadığım tek kısım bu."

# game/Scenes/Whitney/whitney14.rpy:160
translate turkish rjwhitneywarning_d61f0ea5:

    # wt "They are diamonds that have not been inset into any jewelry yet."
    wt "Bunlar henüz hiçbir takıya yerleştirilmemiş elmaslar."

# game/Scenes/Whitney/whitney14.rpy:161
translate turkish rjwhitneywarning_0bb7be7d:

    # wt "They need to be real diamonds too, not the synthetic ones. The hoop will only work on real diamonds."
    wt "Ayrıca sentetik değil, gerçek elmaslar olmalı. Çember sadece gerçek elmaslarda işe yarar."

# game/Scenes/Whitney/whitney14.rpy:162
translate turkish rjwhitneywarning_7b883c0e:

    # wt "They are large and clear and are likely stored wrapped in tissue paper or cloth and in individual bags."
    wt "Elmaslar iri ve berraktır; muhtemelen kağıt mendil veya kumaşa sarılı ve ayrı ayrı poşetlerde saklanmaktadır."

# game/Scenes/Whitney/whitney14.rpy:163
translate turkish rjwhitneywarning_c8a5f5b0:

    # wt "I believe they're going to be near the bottom shelf of the safe."
    wt "Sanırım kasanın en alt rafının yakınında olacaklar."

# game/Scenes/Whitney/whitney14.rpy:164
translate turkish rjwhitneywarning_ff090bab:

    # pc "How do you possibly know all of this?"
    pc "Bunların hepsini nasıl bilebiliyorsun ki?"

# game/Scenes/Whitney/whitney14.rpy:167
translate turkish rjwhitneywarning_52c41d0c:

    # wt "I have been monitoring this place for weeks."
    wt "Haftalardır burayı izliyorum."

# game/Scenes/Whitney/whitney14.rpy:168
translate turkish rjwhitneywarning_c2154aa2:

    # wt "There is a building across the street that has an outside camera. I was able to move that camera to where it aims directly through the front windows of the jewelry shop."
    wt "Sokağın karşısında, dış mekanda kamerası olan bir bina var. O kamerayı, kuyumcunun ön camlarından doğrudan içeriye bakacak şekilde yönlendirebildim."

# game/Scenes/Whitney/whitney14.rpy:169
translate turkish rjwhitneywarning_919dc7c4:

    # wt "Then, by changing the visual frequency a bit, I could look through the one-way mirror and into the back office where the safe is."
    wt "Sonra, görüntü frekansını biraz değiştirerek, tek yönlü aynadan geçip kasanın bulunduğu arka ofisi görebildim."

# game/Scenes/Whitney/whitney14.rpy:170
translate turkish rjwhitneywarning_9a1523a7:

    # wt "Then I just watched and gathered information."
    wt "Sonra sadece izledim ve bilgi topladım."

# game/Scenes/Whitney/whitney14.rpy:173
translate turkish rjwhitneywarning_a32a886a:

    # pc "You're quite scary sometimes, you know?"
    pc "Bazen oldukça ürkütücüsün, biliyor musun?"

# game/Scenes/Whitney/whitney14.rpy:174
translate turkish rjwhitneywarning_6c97b1cc:

    # pc "I'm really glad you're not evil. You could really cause some trouble."
    pc "Kötü biri olmadığına gerçekten çok sevindim. Gerçekten başımıza bela açabilirdin."

# game/Scenes/Whitney/whitney14.rpy:175
translate turkish rjwhitneywarning_4e966f59:

    # wt "Yes. Yes, I could."
    wt "Evet. Evet, yapabilirim."

# game/Scenes/Whitney/whitney14.rpy:176
translate turkish rjwhitneywarning_f91c3d58:

    # wt "Let's go."
    wt "Hadi gidelim."

# game/Scenes/Whitney/whitney14.rpy:179
translate turkish rjwhitneywarning_a1b12283:

    # "Whitney drives us back to town, then takes a convoluted path to avoid the various cameras, before parking in the back area of a nearby store and turning the van off."
