    # wt "There must have been an alarm that trips if the safe is opened after hours."
    wt "Çalışma saatleri dışında kasa açıldığında devreye giren bir alarm olmalı."

# game/Scenes/Whitney/whitney14.rpy:266
translate turkish rjwhitneywarning_a55a8f63:

    # wt "Police are currently en route to check the store out. You need to get out of there."
    wt "Polis şu anda mağazayı kontrol etmek için yolda. Oradan çıkman lazım."

# game/Scenes/Whitney/whitney14.rpy:267
translate turkish rjwhitneywarning_4fe1b4d8:

    # pc "FUCK! Okay!"
    pc "SİKTİR! Tamam!"

# game/Scenes/Whitney/whitney14.rpy:268
