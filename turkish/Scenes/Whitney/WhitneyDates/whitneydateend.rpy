translate turkish whitneydateend_5d3b4f3f:

    # wt "Do you... want to come back to my place for a bit? To spend some time with me?"
    wt "Acaba... biraz benim evime gelmek ister misin? Benimle biraz vakit geçirmek için?"

# game/Scenes/Whitney/WhitneyDates/whitneydateend.rpy:6
translate turkish whitneydateend_72df6614:

    # wt "Great. I was hoping you would."
    wt "Harika. Ben de öyle umuyordum."

# game/Scenes/Whitney/WhitneyDates/whitneydateend.rpy:9
translate turkish whitneydateend_e622f823:

    # wt "Oh okay, that's fine."
    wt "Tamam, sorun değil."

# game/Scenes/Whitney/WhitneyDates/whitneydateend.rpy:10
translate turkish whitneydateend_b2d24667:

    # wt "I'll just drive you home then."
    wt "O zaman seni eve bırakayım."

# game/Scenes/Whitney/WhitneyDates/whitneydateend.rpy:14
translate turkish whitneydateend_bd8a422e:

    # "We leave and Whitney drives me back to my house. We chit-chat the entire way."
    "Ayrılıyoruz ve Whitney beni evime bırakıyor. Yol boyunca sohbet ediyoruz."

# game/Scenes/Whitney/WhitneyDates/whitneydateend.rpy:17
translate turkish whitneydateend_945f9fdf:

    # wt "Well, I guess this is goodbye for now. I had a great time."
    wt "Sanırım şimdilik vedalaşma zamanı geldi. Çok güzel vakit geçirdim."

# game/Scenes/Whitney/WhitneyDates/whitneydateend.rpy:18
translate turkish whitneydateend_f25511f0:

    # pc "Me too. Looking forward to doing it again."
    pc "Ben de. Tekrar yapmayı dört gözle bekliyorum."

# game/Scenes/Whitney/WhitneyDates/whitneydateend.rpy:19
translate turkish whitneydateend_0bc7bf6c:

    # wt "Me too!"
    wt "Ben de!"

# game/Scenes/Whitney/WhitneyDates/whitneydateend.rpy:21
translate turkish whitneydateend_aba75a3d:

    # "I sit there awkwardly for a few moments, not sure if I should try to make a move or not."
    "Birkaç saniye orada biraz garip bir şekilde oturuyorum, bir hamle yapmalı mıyım yoksa yapmamalı mıyım emin olamıyorum."

# game/Scenes/Whitney/WhitneyDates/whitneydateend.rpy:22
translate turkish whitneydateend_33487650:

    # "In the end, I'm not quite sure if she would be open to it, so decide not to."
    "Sonunda, buna açık olup olmayacağından tam emin olamadığım için yapmamaya karar veriyorum."

# game/Scenes/Whitney/WhitneyDates/whitneydateend.rpy:23
translate turkish whitneydateend_1b81e9ad:

    # pc "Okay. See you next time then."
    pc "Tamam. O zaman bir dahaki sefere görüşürüz."

# game/Scenes/Whitney/WhitneyDates/whitneydateend.rpy:24
translate turkish whitneydateend_2d25af02:

    # wt "Bye, [pcname]!"
    wt "Hoşça kal, [pcname]!"

# game/Scenes/Whitney/WhitneyDates/whitneydateend.rpy:27
translate turkish whitneydateend_7e9e1acf:

    # "I get out of the van and she drives away."
    "Minibüsten iniyorum ve o uzaklaşıyor."

# game/Scenes/Whitney/WhitneyDates/whitneydateend.rpy:28
translate turkish whitneydateend_4046f802:

    # "The date went pretty well. Maybe next time things would go even better."
    "Randevu oldukça iyi geçti. Belki bir dahaki sefere işler daha da iyi gider."

