# game/Scenes/Whitney/whitney10.rpy:10
translate turkish whitney10_be5af3f7:

    # "My phone buzzes in my pocket. It's Whitney calling."
    "Cebimdeki telefonum titriyor. Arayan Whitney."

# game/Scenes/Whitney/whitney10.rpy:15
translate turkish whitney10_cabe2426:

    # pc "Hey, Whitney. What's up?"
    pc "Selam Whitney. Naber?"

# game/Scenes/Whitney/whitney10.rpy:16
translate turkish whitney10_b9006bbe:

    # wt "Oh hey. Are you busy?"
    wt "Oh, selam. Meşgul müsün?"

# game/Scenes/Whitney/whitney10.rpy:17
translate turkish whitney10_bc1428f9:

    # pc "Not really."
    pc "Pek değil."

# game/Scenes/Whitney/whitney10.rpy:19
translate turkish whitney10_87d76db1:

    # wt "I have this craving for that burger place we went to before. Would you want to go get dinner with me again?"
    wt "Daha önce gittiğimiz o hamburgerciye canım çok çekti. Benimle tekrar akşam yemeğine çıkmak ister misin?"

# game/Scenes/Whitney/whitney10.rpy:20
translate turkish whitney10_240f7709:

    # pc "Are you asking me out on a date?"
    pc "Bana çıkma teklifi mi ediyorsun?"

# game/Scenes/Whitney/whitney10.rpy:22
translate turkish whitney10_b86f93de:

    # wt "You can call it whatever you like. I just want a burger."
    wt "Ne dersen de. Ben sadece hamburger istiyorum."

# game/Scenes/Whitney/whitney10.rpy:23
translate turkish whitney10_91e1bb14:

    # wt "And your company is nice as well."
    wt "Seninle vakit geçirmek de hoşuma gidiyor."

# game/Scenes/Whitney/whitney10.rpy:27
translate turkish whitney10_7c538ce6:

    # wt "Great! I'll drive over and pick you up at your place in about half an hour."
    wt "Harika! Yarım saat sonra arabayla gelip seni evinden alacağım."

# game/Scenes/Whitney/whitney10.rpy:28
translate turkish whitney10_ac8c00ba:

    # pc "Sounds good. See you then."
    pc "Kulağa hoş geliyor. O zaman görüşürüz."

# game/Scenes/Whitney/whitney10.rpy:29
translate turkish whitney10_2c71ca5c:

    # "We hang up and I go home and get ready."
    "Telefonu kapattık, ben de eve gidip hazırlanıyorum."

# game/Scenes/Whitney/whitney10.rpy:33
translate turkish whitney10_2aaf9014:

    # wt "Oh, okay then."
    wt "Ah, peki o zaman."

# game/Scenes/Whitney/whitney10.rpy:34
translate turkish whitney10_f7a5b1c0:

    # wt "Well, if you want to sometime, just give me a call in the evening. I'm usually free."
    wt "Şey, bir ara istersen, akşamları beni ara. Genelde boşumdur."

# game/Scenes/Whitney/whitney10.rpy:35
translate turkish whitney10_bf0c9413:

    # pc "Okay, Whitney. Talk to you later."
    pc "Tamam, Whitney. Sonra konuşuruz."

# game/Scenes/Whitney/whitney10.rpy:36
translate turkish whitney10_a7e7a8bf:

    # wt "Bye, [pcname]."
    wt "Hoşça kal, [pcname]."

