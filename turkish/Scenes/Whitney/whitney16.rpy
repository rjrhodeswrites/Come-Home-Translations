# TODO: Translation updated at 2026-08-03 12:42

# game/Scenes/Whitney/whitney16.rpy:13
translate turkish whitney16_50df7566:

    # "My phone buzzes in my pocket. Whitney's calling."
    "Cebimdeki telefon titriyor. Whitney arıyor."

# game/Scenes/Whitney/whitney16.rpy:17
translate turkish whitney16_0b8efa0c:

    # pc "Hey, Whitney."
    pc "Selam, Whitney."

# game/Scenes/Whitney/whitney16.rpy:19
translate turkish whitney16_c6ee1dad:

    # wt "Could you come over to the lab? I have something to show you."
    wt "Laboratuvara gelebilir misin? Sana gösterecek bir şeyim var."

# game/Scenes/Whitney/whitney16.rpy:20
translate turkish whitney16_61f77a4c:

    # pc "Sure."
    pc "Tabii."

# game/Scenes/Whitney/whitney16.rpy:21
translate turkish whitney16_a1cf6718:

    # wt "Good. See you soon."
    wt "Güzel. Görüşürüz."

# game/Scenes/Whitney/whitney16.rpy:22
translate turkish whitney16_897088bb:

    # "She hangs up before I can say anything else. Guess I better head over to the lab."
    "Ben başka bir şey söyleyemeden telefonu kapattı. Sanırım laboratuvara gitsem iyi olacak."

# game/Scenes/Whitney/whitney16.rpy:25
translate turkish whitney16_fa8b8cd1:

    # "A few minutes later, I walk into the lab, where she's busy at her computer."
    "Birkaç dakika sonra laboratuvara girdiğimde, o bilgisayar başında meşgul."

# game/Scenes/Whitney/whitney16.rpy:26
translate turkish whitney16_4d683f87:

    # wt "Oh, [pcname]. Good. Follow me."
    wt "Oh, [pcname]. Güzel. Beni takip et."

# game/Scenes/Whitney/whitney16.rpy:29
translate turkish whitney16_1e926628:

    # wt "I have finished the new hoop."
    wt "Yeni çemberi bitirdim."

# game/Scenes/Whitney/whitney16.rpy:30
translate turkish whitney16_22c83dc1:

    # pc "It's much bigger than the last one."
    pc "Bir öncekinden çok daha büyük."

# game/Scenes/Whitney/whitney16.rpy:31
translate turkish whitney16_984bce26:

    # wt "Yes, it's true. In this case, size does matter."
    wt "Evet, doğru. Bu durumda boyut önemli."

# game/Scenes/Whitney/whitney16.rpy:32
translate turkish whitney16_650aeb95:

    # wt "I've designed the new hoop so that it will not only transport you to the exact world that your father went to, but it will also bring you back."
    wt "Yeni çemberi, sizi sadece babanızın gittiği dünyaya götürmekle kalmayıp, aynı zamanda geri de getirecek şekilde tasarladım."

# game/Scenes/Whitney/whitney16.rpy:33
translate turkish whitney16_d0034e37:

    # wt "It is synced with your DNA profile. When you go through it, you will be tethered to it. I can bring you back from here."
    wt "DNA profilinizle senkronize edildi. İçinden geçtiğinizde, ona bağlanacaksınız. Sizi buradan geri getirebilirim."

# game/Scenes/Whitney/whitney16.rpy:34
translate turkish whitney16_5b38bd59:

    # wt "This is what we should have done with your father, if he had been more patient."
    wt "Babanız biraz daha sabırlı olsaydı, onunla da bunu yapmalıydık."

# game/Scenes/Whitney/whitney16.rpy:37
translate turkish whitney16_994924ab:

    # pc "So, it's ready to go?"
    pc "Yani, kullanıma hazır mı?"

# game/Scenes/Whitney/whitney16.rpy:38
translate turkish whitney16_c60270d5:

    # wt "Not quite. We have to test it first."
    wt "Henüz değil. Önce test etmemiz gerekiyor."

# game/Scenes/Whitney/whitney16.rpy:39
translate turkish whitney16_74dfd840:

    # pc "How do we do that?"
    pc "Bunu nasıl yapacağız?"

# game/Scenes/Whitney/whitney16.rpy:42
translate turkish whitney16_a54b5eec:

    # wt "This morning, before you got here, I sent a mouse through."
    wt "Bu sabah, sen gelmeden önce bir fareyi oraya gönderdim."

# game/Scenes/Whitney/whitney16.rpy:43
translate turkish whitney16_c4971b1e:

    # pc "Wait, really? You sent a mouse into another universe?"
    pc "Dur, gerçekten mi? Bir fareyi başka bir evrene mi gönderdin?"

# game/Scenes/Whitney/whitney16.rpy:44
translate turkish whitney16_6f0e0998:

    # wt "Yes. That's the easy part."
    wt "Evet. O kısmı kolaydı."

# game/Scenes/Whitney/whitney16.rpy:45
translate turkish whitney16_a992c7cf:

    # wt "Now though, I'm going to try to bring it back."
    wt "Şimdi ise onu geri getirmeye çalışacağım."

# game/Scenes/Whitney/whitney16.rpy:48
translate turkish whitney16_91de8169:

    # "She presses a series of buttons on her watch and the hoop glows to life."
    "Saatindeki bir dizi düğmeye basıyor ve halka parlayarak canlanıyor."

# game/Scenes/Whitney/whitney16.rpy:49
translate turkish whitney16_83bcc1d8:

    # "My ears pop as the air pressure in the room changes and there's a slight ringing sound."
    "Odadaki hava basıncı değişince kulaklarım tıkanıyor ve hafif bir çınlama duyuluyor."

# game/Scenes/Whitney/whitney16.rpy:52
translate turkish whitney16_7d1c036c:

    # "Then the sound dissipates and there is something lying on the platform near the hoop."
    "Sonra ses kayboluyor ve çemberin yanındaki platformda bir şey yatıyor."

# game/Scenes/Whitney/whitney16.rpy:53
translate turkish whitney16_daaa84a9:

    # pc "What the fuck is that?"
    pc "Bu da ne lan?"

# game/Scenes/Whitney/whitney16.rpy:54
translate turkish whitney16_e0330bbf:

    # wt "That... is the mouse."
    wt "O... fare."

# game/Scenes/Whitney/whitney16.rpy:57
translate turkish whitney16_2681ebe7:

    # wt "It seems there is some more testing that must be done."
    wt "Görünüşe göre yapılması gereken birkaç test daha var."

# game/Scenes/Whitney/whitney16.rpy:58
translate turkish whitney16_4492000b:

    # pc "Yeah, I'd say so!"
    pc "Evet, bence de!"

# game/Scenes/Whitney/whitney16.rpy:59
translate turkish whitney16_2551790c:

    # wt "I'll figure it out. We're close."
    wt "Bir yolunu bulacağım. Çok az kaldı."

# game/Scenes/Whitney/whitney16.rpy:62
translate turkish whitney16_004ba629:

    # wt "This is the last little bit to solve, though."
    wt "Ama çözülmesi gereken son bir ayrıntı var."

# game/Scenes/Whitney/whitney16.rpy:63
translate turkish whitney16_9edb80ec:

    # wt "The hoop is built. It's ready."
    wt "Çember yapıldı. Hazır."

# game/Scenes/Whitney/whitney16.rpy:64
translate turkish whitney16_b679ea6d:

    # wt "It's just finding out how to do this in a way that we can bring you back in one piece."
    wt "Şimdi tek yapmamız gereken, seni tek parça halinde geri getirebileceğimiz bir yol bulmak."

# game/Scenes/Whitney/whitney16.rpy:65
translate turkish whitney16_19874614:

    # wt "I'll let you know as soon as I figure it out, okay?"
    wt "Çözümü bulur bulmaz sana haber veririm, tamam mı?"

# game/Scenes/Whitney/whitney16.rpy:68
translate turkish whitney16_8c9138ff:

    # pc "Okay. Thanks, Whitney."
    pc "Tamam. Teşekkürler, Whitney."

# game/Scenes/Whitney/whitney16.rpy:69
translate turkish whitney16_d39969f2:

    # wt "You're welcome. Sorry for calling you out here for nothing. I really thought that this would be successful."
    wt "Rica ederim. Seni boşuna buraya çağırdığım için özür dilerim. Bunun gerçekten başarılı olacağını düşünmüştüm."

# game/Scenes/Whitney/whitney16.rpy:70
translate turkish whitney16_e9a3252a:

    # wt "That is why we are patient though. That is why we test."
    wt "İşte bu yüzden sabırlıyız. İşte bu yüzden test yapıyoruz."

# game/Scenes/Whitney/whitney16.rpy:71
translate turkish whitney16_4c58fa25:

    # wt "Back to work for me. I'll talk to you later."
    wt "Ben işime dönüyorum. Sonra konuşuruz."

# game/Scenes/Whitney/whitney16.rpy:72
translate turkish whitney16_0854e810:

    # pc "Okay, see ya later."
    pc "Tamam, sonra görüşürüz."

# game/Scenes/Whitney/whitney16.rpy:75
translate turkish whitney16_0ee8d1bf:

    # "I leave her lab, the image of that mouse in my mind."
    "Laboratuvarından ayrılırken, o farenin görüntüsü aklımdan çıkmıyor."

# game/Scenes/Whitney/whitney16.rpy:76
translate turkish whitney16_97666c57:

    # "Fuck, I hope Dad is okay."
    "Kahretsin, umarım babam iyidir."

translate turkish strings:

    # game/Scenes/Whitney/whitney16.rpy:5
    old "A week after the jewelry store robbery, Whitney will call you on an afternoon on the weekend."
    new "Kuyumcu soygunundan bir hafta sonra, Whitney hafta sonu bir öğleden sonra seni arayacak."

