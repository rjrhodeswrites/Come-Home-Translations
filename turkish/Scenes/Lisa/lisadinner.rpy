# game/Scenes/Lisa/lisadinner.rpy:3
translate turkish lisadinner_e20dd2c0:

    # "Usually Lisa would be cooking dinner here on the weekend, but she's not here."
    "Genelde hafta sonları Lisa burada akşam yemeği pişirir, ama o burada değil."

# game/Scenes/Lisa/lisadinner.rpy:4
translate turkish lisadinner_7b04e990:

    # "I wonder if she's still upset about before?"
    "Acaba daha önce olanlar yüzünden hâlâ kızgın mı?"

# game/Scenes/Lisa/lisadinner.rpy:5
translate turkish lisadinner_6a8bd90c:

    # "I guess she just needs some more time."
    "Sanırım biraz daha zamana ihtiyacı var."

# game/Scenes/Lisa/lisadinner.rpy:8
translate turkish lisadinner_17ebb7b6:

    # "Lisa stands in the kitchen, cooking dinner at the stove."
    "Lisa mutfakta durmuş, ocakta akşam yemeği pişiriyor."

# game/Scenes/Lisa/lisadinner.rpy:9
translate turkish lisadinner_622e58a4:

    # "She looks tired, but still turns towards me with a smile."
    "Yorgun görünüyor, ama yine de bana gülümseyerek dönüyor."

# game/Scenes/Lisa/lisadinner.rpy:12
translate turkish lisadinner_dbdf9d75:

    # sp "Hey honey. You joining me for dinner?"
    sp "Selam tatlım. Akşam yemeğinde bana katılır mısın?"

# game/Scenes/Lisa/lisadinner.rpy:21
translate turkish lisadinner_d0417e78:

    # sp "Okay honey, let me know if you change your mind."
    sp "Tamam tatlım, fikrini değiştirirsen haber ver."

# game/Scenes/Lisa/lisadinner.rpy:67
translate turkish lisadinnerconversation_18c6396f:

    # sp "I'm glad. It gets lonely eating by myself."
    sp "Sevindim. Tek başıma yemek yemek biraz yalnızlık hissettiriyor."

# game/Scenes/Lisa/lisadinner.rpy:69
translate turkish lisadinnerconversation_f7385cce:

    # "She returns to the stove and cooks us both dinner."
    "Ocağa geri dönüp ikimize de akşam yemeği hazırlıyor."

# game/Scenes/Lisa/lisadinner.rpy:73
translate turkish lisadinnerconversation_2aba8403:

    # "Then we sit together in the dining room and have a nice conversation while eating."
    "Sonra yemek odasında birlikte oturup, yemek yerken hoş bir sohbet ediyoruz."

# game/Scenes/Lisa/lisadinner.rpy:76
translate turkish lisadinnerconversation_ac9094b5:

    # "Afterwards, we go to the kitchen and I help with the dishes."
    "Yemekten sonra mutfağa gidip bulaşıkları yıkamaya yardım ediyorum."

# game/Scenes/Lisa/lisadinner.rpy:77
translate turkish lisadinnerconversation_74aec54b:

    # sp "Thanks for having dinner with me honey. I really enjoyed it."
    sp "Benimle akşam yemeği yediğin için teşekkürler tatlım. Gerçekten çok keyif aldım."

# game/Scenes/Lisa/lisadinner.rpy:78
translate turkish lisadinnerconversation_6ecfecf0:

    # pc "Any time, [mom]."
    pc "Ne zaman istersen, [mom]."

# game/Scenes/Lisa/lisadinner.rpy:80
translate turkish lisadinnerconversation_79c86a4f:

    # sp "Love you, baby."
    sp "Seni seviyorum bebeğim."

# game/Scenes/Lisa/lisadinner.rpy:81
translate turkish lisadinnerconversation_ce2ae2bf:

    # pc "Love you too."
    pc "Ben de seni seviyorum."

# game/Scenes/Lisa/lisadinner.rpy:82
translate turkish lisadinnerconversation_db14aa5a:

    # "We finish up and Lisa goes to her bedroom for the night."
    "İşimizi bitirip Lisa yatmak için yatak odasına gidiyor."

