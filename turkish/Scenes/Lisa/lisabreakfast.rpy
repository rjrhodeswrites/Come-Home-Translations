translate turkish lisabreakfast_09b21b2a:

    # sp "Good morning honey. Want some breakfast?"
    sp "Günaydın tatlım. Kahvaltı ister misin?"

# game/Scenes/Lisa/lisabreakfast.rpy:35
translate turkish nottodaymom_d0417e78:

    # sp "Okay honey, let me know if you change your mind."
    sp "Tamam tatlım, fikrini değiştirirsen bana haber ver."

# game/Scenes/Lisa/lisabreakfast.rpy:45
translate turkish lisabreakfastconvo_c299cac3:

    # sp "I'll cook you some eggs and bacon."
    sp "Sana biraz yumurta ve pastırma pişireyim."

# game/Scenes/Lisa/lisabreakfast.rpy:46
translate turkish lisabreakfastconvo_e45e3b16:

    # "She returns to the stove and cooks us both breakfast."
    "Ocağa geri dönüyor ve ikimize kahvaltı hazırlıyor."

# game/Scenes/Lisa/lisabreakfast.rpy:49
translate turkish lisabreakfastconvo_2ccb9eb9:

    # "Then we sit down together and have a nice conversation while eating breakfast."
    "Sonra birlikte oturup kahvaltı yaparken hoş bir sohbet ediyoruz."

# game/Scenes/Lisa/lisabreakfast.rpy:51
translate turkish lisabreakfastconvo_280140a3:

    # "Afterwards, she cleans up the plates and I head upstairs and get dressed for the day."
    "Ardından o tabakları topluyor ve ben yukarı çıkıp gün için giyiniyorum."

