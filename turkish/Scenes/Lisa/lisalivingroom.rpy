# game/Scenes/Lisa/lisalivingroom.rpy:3
translate turkish lisalivingroom_acb88e92:

    # "Lisa's not here watching TV like she usually is. What's going on with her?"
    "Lisa her zamanki gibi burada televizyon izlemiyor. Ona ne oldu acaba?"

# game/Scenes/Lisa/lisalivingroom.rpy:4
translate turkish lisalivingroom_b428ebd3:

    # "I guess she's still upset. Better just give her time."
    "Sanırım hâlâ kızgın. En iyisi ona biraz zaman tanımak."

# game/Scenes/Lisa/lisalivingroom.rpy:16
translate turkish lisalivingroom_28820f39:

    # "Lisa is in the living room watching television."
    "Lisa oturma odasında televizyon izliyor."

# game/Scenes/Lisa/lisalivingroom.rpy:17
translate turkish lisalivingroom_62054172:

    # sp "Hey, honey, I'm just watching some TV. Want to join me?"
    sp "Hey tatlım, ben de biraz televizyon izliyorum. Bana katılmak ister misin?"

# game/Scenes/Lisa/lisalivingroom.rpy:21
translate turkish lisatv_11b9ab1f:

    # sp "Sure, that sounds great."
    sp "Tabii, harika olur."

# game/Scenes/Lisa/lisalivingroom.rpy:25
translate turkish lisatv_683befdb:

    # "Lisa changes into her nightgown and we go sit in the living room together."
    "Lisa geceliğini giyiyor ve birlikte oturma odasına geçiyoruz."

# game/Scenes/Lisa/lisalivingroom.rpy:115
translate turkish lisatvconversation_8d017aa1:

    # "I sit down next to her and we watch television together for a while."
    "Yanına oturuyorum ve bir süre birlikte televizyon izliyoruz."

# game/Scenes/Lisa/lisalivingroom.rpy:117
translate turkish lisatvconversation_3f78d36e:

    # "After the show is over, Lisa looks over to me."
    "Program bittikten sonra Lisa bana bakıyor."

# game/Scenes/Lisa/lisalivingroom.rpy:118
translate turkish lisatvconversation_9938deea:

    # sp "Well, it's getting late. I'm going to go to bed, honey."
    sp "Eh, saat geç oldu. Ben yatmaya gidiyorum tatlım."

# game/Scenes/Lisa/lisalivingroom.rpy:119
translate turkish lisatvconversation_db98731b:

    # pc "Alright, [mom]."
    pc "Tamam, [mom]."

# game/Scenes/Lisa/lisalivingroom.rpy:120
translate turkish lisatvconversation_b7fc26cb:

    # sp "Thanks for hanging out with me. Love you."
    sp "Benimle vakit geçirdiğin için teşekkürler. Seni seviyorum."

# game/Scenes/Lisa/lisalivingroom.rpy:121
translate turkish lisatvconversation_776fd6b3:

    # pc "Love you too, [mom]. Good night."
    pc "Ben de seni seviyorum, [mom]. İyi geceler."

# game/Scenes/Lisa/lisalivingroom.rpy:122
translate turkish lisatvconversation_0ffd2107:

    # sp "Good night."
    sp "İyi geceler."

# game/Scenes/Lisa/lisalivingroom.rpy:123
translate turkish lisatvconversation_b9d79178:

    # "She gets up and walks towards her bedroom. I don't really want to watch any more TV, so I turn it off and leave as well."
    "Ayağa kalkıp yatak odasına doğru yürüyor. Ben de artık televizyon izlemek istemiyorum, o yüzden televizyonu kapatıp ben de odadan çıkıyorum."

