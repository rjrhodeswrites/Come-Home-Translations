# game/Scenes/Lisa/lisahallway.rpy:9
translate turkish lisahallway_c49eebeb:

    # sp "Oh, hey honey. Did you want to do something together this evening?"
    sp "Oh, merhaba tatlım. Bu akşam birlikte bir şeyler yapmak ister misin?"

# game/Scenes/Lisa/lisahallway.rpy:17
translate turkish cookwithlisa_6524ac29:

    # "We go to the kitchen and cook dinner together."
    "Mutfağa gidip birlikte akşam yemeği hazırlıyoruz."

# game/Scenes/Lisa/lisahallway.rpy:20
translate turkish cookwithlisa_2aba8403:

    # "Then we sit together in the dining room and have a nice conversation while eating."
    "Sonra yemek odasında birlikte oturup yemek yerken hoş bir sohbet ediyoruz."

# game/Scenes/Lisa/lisahallway.rpy:24
translate turkish cookwithlisa_ac9094b5:

    # "Afterwards, we go to the kitchen and I help with the dishes."
    "Ardından mutfağa gidip bulaşıkları yıkamaya yardım ediyorum."

# game/Scenes/Lisa/lisahallway.rpy:25
translate turkish cookwithlisa_5de5fea4:

    # sp "This was really nice."
    sp "Bu gerçekten çok hoştu."

# game/Scenes/Lisa/lisahallway.rpy:28
translate turkish cookwithlisa_79b9a743:

    # sp "I think I'm going to go take a shower now. Want to join me?"
    sp "Sanırım şimdi duş almaya gideceğim. Bana katılmak ister misin?"

# game/Scenes/Lisa/lisahallway.rpy:33
translate turkish cookwithlisa_cf0a5849:

    # sp "Okay. Love you, baby."
    sp "Tamam. Seni seviyorum, bebeğim."

# game/Scenes/Lisa/lisahallway.rpy:34
translate turkish cookwithlisa_ce2ae2bf:

    # pc "Love you too."
    pc "Ben de seni seviyorum."

# game/Scenes/Lisa/lisahallway.rpy:35
translate turkish cookwithlisa_db14aa5a:

    # "We finish up and Lisa goes to her bedroom for the night."
    "İşlerimizi bitiriyoruz ve Lisa geceyi geçirmek için yatak odasına gidiyor."

# game/Scenes/Lisa/lisahallway.rpy:40
translate turkish lisadate_01e3ac80:

    # sp "Oh yeah, I guess since Suzy knows about us now, we could do that."
    sp "Ah evet, sanırım Suzy artık bizi bildiğine göre bunu yapabiliriz."

# game/Scenes/Lisa/lisahallway.rpy:41
translate turkish lisadate_88279251:

    # sp "Okay that sounds really nice actually. Where do you want to go?"
    sp "Tamam, aslında kulağa gerçekten hoş geliyor. Nereye gitmek istersin?"

# game/Scenes/Lisa/lisahallway.rpy:44
translate turkish lisadate_8071debf:

    # sp "That sounds great. Where do you want to go?"
    sp "Harika bir fikir. Nereye gitmek istersin?"

# game/Scenes/Lisa/lisahallway.rpy:202
translate turkish lisaenddate_637356aa:

    # sp "Thank you so much for taking me out tonight."
    sp "Bu gece beni dışarı çıkardığın için çok teşekkür ederim."

# game/Scenes/Lisa/lisahallway.rpy:203
translate turkish lisaenddate_6ab2bfff:

    # sp "Do you want to come to my room?"
    sp "Odama gelmek ister misin?"

# game/Scenes/Lisa/lisahallway.rpy:249
translate turkish lisasex_8a718dca:

    # "We go to her room and she strips out of her clothes and lies on the bed, ready for me."
    "Odasına gidiyoruz ve o kıyafetlerini çıkarıp yatağa uzanıyor, benim için hazır."

# game/Scenes/Lisa/lisahallway.rpy:250
translate turkish lisasex_93cfa24d:

    # sp "What do you feel like doing, baby?"
    sp "Ne yapmak istersin, bebeğim?"

# game/Scenes/Lisa/lisahallway.rpy:255
translate turkish lisanottonight_fd2f564d:

    # sp "Okay, honey. Thank you for the amazing date anyway."
    sp "Tamam, tatlım. Yine de bu harika randevu için teşekkürler."

# game/Scenes/Lisa/lisahallway.rpy:258
translate turkish lisanottonight_ea3d4ac7:

    # "We say our goodnights and she goes to her bedroom."
    "Birbirimize iyi geceler diyoruz ve o yatak odasına gidiyor."

