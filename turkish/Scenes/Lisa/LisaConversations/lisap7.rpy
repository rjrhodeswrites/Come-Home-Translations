# game/Scenes/Lisa/LisaConversations/lisap7.rpy:13
translate turkish lisap7_94d99c64:

    # sp "Do you think he is going to come back?"
    sp "Sence geri dönecek mi?"

# game/Scenes/Lisa/LisaConversations/lisap7.rpy:14
translate turkish lisap7_ebe799f9:

    # pc "I'm not sure, but I'm trying."
    pc "Emin değilim, ama deniyorum."

# game/Scenes/Lisa/LisaConversations/lisap7.rpy:16
translate turkish lisap7_097d9069:

    # sp "Well, {i}if{/i} he comes back, I will ask him nicely if he would pack his things and move out."
    sp "Şey, {i}eğer{/i} geri gelirse, ona kibarca eşyalarını toplayıp taşınmasını rica edeceğim."

# game/Scenes/Lisa/LisaConversations/lisap7.rpy:18
translate turkish lisap7_defaba5c:

    # sp "Technically, the house is his, but I have been paying all the bills since he disappeared."
    sp "Teknik olarak ev onun, ama o ortadan kaybolduğundan beri tüm faturaları ben ödüyorum."

# game/Scenes/Lisa/LisaConversations/lisap7.rpy:19
translate turkish lisap7_7e722eaa:

    # sp "I believe I have some legal claim to the house at this point."
    sp "Sanırım bu noktada ev üzerinde bazı yasal haklarım var."

# game/Scenes/Lisa/LisaConversations/lisap7.rpy:21
translate turkish lisap7_3be4f3d5:

    # sp "But if he fights too much, I'll probably just leave with Suzy and get an apartment somewhere."
    sp "Ama çok direnirse, muhtemelen Suzy’yle birlikte ayrılıp başka bir yerde bir daire tutacağım."

# game/Scenes/Lisa/LisaConversations/lisap7.rpy:24
translate turkish lisap7_d41d8cd9:

    # voice 'voices/lisa_18_1.mp3'
    voice 'voices/lisa_18_1.mp3'

# game/Scenes/Lisa/LisaConversations/lisap7.rpy:25
translate turkish lisap7_691527ac:

    # sp "Either way... I am not in a relationship with him anymore."
    sp "Her halükarda... Artık onunla bir ilişkim yok."

# game/Scenes/Lisa/LisaConversations/lisap7.rpy:27
translate turkish lisap7_d41d8cd9_1:

    # voice 'voices/lisa_18_2.mp3'
    voice 'voices/lisa_18_2.mp3'

# game/Scenes/Lisa/LisaConversations/lisap7.rpy:28
translate turkish lisap7_f5b06ff5:

    # sp "There is no going back to the way things were."
    sp "Eskisi gibi olmaya geri dönüş yok."

# game/Scenes/Lisa/LisaConversations/lisap7.rpy:31
translate turkish lisap7_d41d8cd9_2:

    # voice 'voices/lisa_18_3.mp3'
    voice 'voices/lisa_18_3.mp3'

# game/Scenes/Lisa/LisaConversations/lisap7.rpy:32
translate turkish lisap7_e25e29cb:

    # sp "I want to stay with you, [pcname]."
    sp "Seninle kalmak istiyorum, [pcname]."

# game/Scenes/Lisa/LisaConversations/lisap7.rpy:33
translate turkish lisap7_e85b9fe2:

    # sp "If your dad comes back, I'll still want to be with you."
    sp "Baban geri gelse bile, yine de seninle olmak isteyeceğim."

# game/Scenes/Lisa/LisaConversations/lisap7.rpy:35
translate turkish lisap7_99e080fb:

    # sp "It will be weird at first, but no weirder than telling Suzy, and we somehow survived that."
    sp "Başlangıçta tuhaf olacak, ama Suzy’ye söylemekten daha tuhaf olmayacak ve biz bunu bir şekilde atlattık."

# game/Scenes/Lisa/LisaConversations/lisap7.rpy:37
translate turkish lisap7_d123a709:

    # sp "Anyways... I hope your father is okay, wherever he is."
    sp "Neyse... Umarım baban iyi durumdadır, nerede olursa olsun."

# game/Scenes/Lisa/LisaConversations/lisap7.rpy:38
translate turkish lisap7_18bad589:

    # sp "And I'd love to talk to him and ask him some things."
    sp "Ve onunla konuşup ona bazı şeyler sormak isterdim."

# game/Scenes/Lisa/LisaConversations/lisap7.rpy:40
translate turkish lisap7_36f2056a:

    # sp "But I'm not going back to him."
    sp "Ama ona geri dönmeyeceğim."

# game/Scenes/Lisa/LisaConversations/lisap7.rpy:42
translate turkish lisap7_d41d8cd9_3:

    # voice 'voices/lisa_18_4.mp3'
    voice 'voices/lisa_18_4.mp3'

# game/Scenes/Lisa/LisaConversations/lisap7.rpy:43
translate turkish lisap7_6b3cf03c:

    # sp "I'm done being treated like a backup plan."
    sp "Yedek plan gibi muamele görmeye artık son verdim."

# game/Scenes/Lisa/LisaConversations/lisap7.rpy:45
translate turkish lisap7_2988465e:

    # sp "I'm sorry. I know he's your dad. I do care about him and I don't mean to badmouth him this much."
    sp "Üzgünüm. Onun baban olduğunu biliyorum. Onu önemsiyorum ve bu kadar kötü konuşmak istemem."

# game/Scenes/Lisa/LisaConversations/lisap7.rpy:46
translate turkish lisap7_6c4342d2:

    # pc "It's okay. I know how he treated you. He deserves it."
    pc "Sorun değil. Sana nasıl davrandığını biliyorum. Bunu hak ediyor."

# game/Scenes/Lisa/LisaConversations/lisap7.rpy:48
translate turkish lisap7_e3621c99:

    # sp "Are you going to be okay with us being together, even if he comes back?"
    sp "O geri dönse bile birlikte olmamızı kabul edecek misin?"

# game/Scenes/Lisa/LisaConversations/lisap7.rpy:49
translate turkish lisap7_3bfc4bd4:

    # sp "Or is it too weird for you?"
    sp "Yoksa bu senin için çok tuhaf mı?"

# game/Scenes/Lisa/LisaConversations/lisap7.rpy:51
translate turkish lisap7_89e1637d:

    # pc "Everything about this situation with my dad is weird."
    pc "Babamla ilgili bu durumun her şeyi tuhaf."

# game/Scenes/Lisa/LisaConversations/lisap7.rpy:52
translate turkish lisap7_e1114729:

    # pc "But me being with you doesn't feel weird at all."
    pc "Ama seninle birlikte olmam hiç de tuhaf gelmiyor."

# game/Scenes/Lisa/LisaConversations/lisap7.rpy:53
translate turkish lisap7_2bfc5c08:

    # pc "It feels perfect."
    pc "Mükemmel geliyor."

# game/Scenes/Lisa/LisaConversations/lisap7.rpy:55
translate turkish lisap7_4a76d6f4:

    # sp "Yeah... it does."
    sp "Evet... öyle."

# game/Scenes/Lisa/LisaConversations/lisap7.rpy:56
translate turkish lisap7_dbd4b8fb:

    # sp "I love you."
    sp "Seni seviyorum."

# game/Scenes/Lisa/LisaConversations/lisap7.rpy:57
translate turkish lisap7_931fdb2e:

    # pc "I love you too, Lisa."
    pc "Ben de seni seviyorum, Lisa."

translate turkish strings:

    # game/Scenes/Lisa/LisaConversations/lisap7.rpy:3
    old "To have this final conversation with lisa, you must have had all the other conversations with her regarding your father,"
    new "Lisa ile bu son konuşmayı yapabilmek için, babanla ilgili diğer tüm konuşmaları onunla yapmış olmalısın,"

    # game/Scenes/Lisa/LisaConversations/lisap7.rpy:4
    old "and you must progress with the main story until Whitney is almost ready to send you through the portal."
    new "ve Whitney seni portaldan geçirmek üzereyken ana hikayede ilerlemiş olmalısın."

