translate turkish lisaq3_63440e3b:

    # pc "Thanks. I hope so."
    pc "Teşekkürler. Umarım öyle olur."

# game/Scenes/Lisa/LisaConversations/lisaq3.rpy:24
translate turkish lisaq3_cae312b2:

    # sp "Just like your dad."
    sp "Tıpkı baban gibi."

# game/Scenes/Lisa/LisaConversations/lisaq3.rpy:25
translate turkish lisaq3_1dc5dc35:

    # sp "You're so smart."
    sp "Çok zekisin."

# game/Scenes/Lisa/LisaConversations/lisaq3.rpy:27
translate turkish lisaq3_582d94d2:

    # sp "I know you'll do something great. Like cure cancer, or something."
    sp "Harika bir şey yapacağını biliyorum. Kanseri tedavi etmek gibi bir şey mesela."

# game/Scenes/Lisa/LisaConversations/lisaq3.rpy:28
translate turkish lisaq3_2f4d9dc0:

    # pc "Haha, maybe."
    pc "Haha, belki."

# game/Scenes/Lisa/LisaConversations/lisaq3.rpy:30
translate turkish lisaq3_03ed9f47:

    # sp "Well, I'm sure you'll be great at it."
    sp "Eh, eminim bu konuda harika olacaksın."

# game/Scenes/Lisa/LisaConversations/lisaq3.rpy:31
translate turkish lisaq3_cda2f52e:

