# game/Scenes/Lisa/LisaDates/lisagrotto.rpy:29
translate turkish lisagrottostartdate_b57ce247:

    # sp "What a beautiful view. I've always wanted to come out here."
    sp "Ne güzel bir manzara. Hep buraya gelmek istemiştim."

# game/Scenes/Lisa/LisaDates/lisagrotto.rpy:30
translate turkish lisagrottostartdate_c147ac60:

    # pc "I'm glad I can take you, [mom]."
    pc "Seni buraya getirebildiğim için çok mutluyum, [mom]."

# game/Scenes/Lisa/LisaDates/lisagrotto.rpy:31
translate turkish lisagrottostartdate_37c9d0bf:

    # "We walk in and the host leads us to our seats."
    "İçeri giriyoruz ve garson bizi masamıza götürüyor."

# game/Scenes/Lisa/LisaDates/lisagrotto.rpy:36
translate turkish lisagrottostartdate_10fa4e8b:

    # sp "This all looks so good."
    sp "Her şey çok lezzetli görünüyor."

# game/Scenes/Lisa/LisaDates/lisagrotto.rpy:37
translate turkish lisagrottostartdate_64c84be1:

    # pc "Order whatever you'd like. You deserve it."
    pc "Ne istersen sipariş et. Bunu hak ediyorsun."

# game/Scenes/Lisa/LisaDates/lisagrotto.rpy:38
translate turkish lisagrottostartdate_eca3a20d:

    # sp "It's going to be so hard to decide."
    sp "Karar vermek çok zor olacak."

# game/Scenes/Lisa/LisaDates/lisagrotto.rpy:39
translate turkish lisagrottostartdate_ecd9ab22:

    # "The server takes our orders and we chat for a while."
    "Garson siparişlerimizi alıyor ve bir süre sohbet ediyoruz."

# game/Scenes/Lisa/LisaDates/lisagrotto.rpy:42
translate turkish lisagrottostartdate_ac38448c:

    # "Then we eat and chat some more."
    "Sonra yemek yiyoruz ve biraz daha sohbet ediyoruz."

# game/Scenes/Lisa/LisaDates/lisagrotto.rpy:48
translate turkish lisagrottostartdate_94d3f64e:

    # "Then we get up and dance a bit to the soft music."
    "Sonra kalkıp hafif müziğe eşlik ederek biraz dans ediyoruz."

# game/Scenes/Lisa/LisaDates/lisagrotto.rpy:50
translate turkish lisagrottostartdate_97354a3c:

    # sp "I love this so much. Your father never danced with me."
    sp "Buna bayılıyorum. Baban benimle hiç dans etmedi."

# game/Scenes/Lisa/LisaDates/lisagrotto.rpy:51
translate turkish lisagrottostartdate_f2726624:

    # pc "Too bad. You're a good dancer."
    pc "Çok yazık. Sen iyi bir dansçısın."

# game/Scenes/Lisa/LisaDates/lisagrotto.rpy:52
translate turkish lisagrottostartdate_2297510b:

    # sp "You are too. I could dance with you all night."
    sp "Sen de öylesin. Seninle bütün gece dans edebilirim."

# game/Scenes/Lisa/LisaDates/lisagrotto.rpy:56
translate turkish lisagrottostartdate_ccc4760d:

    # sp "This has been a fantastic date."
    sp "Bu harika bir randevuydu."

