# game/Scenes/Juliana/juliana2.rpy:13
translate turkish juliana2_ba25a872:

    # "The school day goes by normally until English class."
    "Okul günü, İngilizce dersine kadar normal bir şekilde geçiyor."

# game/Scenes/Juliana/juliana2.rpy:14
translate turkish juliana2_5631544c:

    # "Mrs. McGee lectures all period about the archetypes and subtext of the short story we are reading."
    "Bayan McGee, tüm ders boyunca okuduğumuz kısa öykünün arketipleri ve alt metni hakkında ders veriyor."

# game/Scenes/Juliana/juliana2.rpy:15
translate turkish juliana2_88daeb16:

    # "The entire time, I don't even look at Juliana, I'm still so annoyed with her."
    "Bütün bu süre boyunca Juliana’ya bakmıyorum bile, ona hâlâ çok kızgınım."

# game/Scenes/Juliana/juliana2.rpy:18
translate turkish juliana2_1c2cecc3:

    # "When the class is over, I gather my things and get up to leave."
    "Ders bittiğinde eşyalarımı toplayıp kalkıp çıkmak üzereyim."

# game/Scenes/Juliana/juliana2.rpy:19
translate turkish juliana2_290ef46a:

    # bn "[pcname]?"
    bn "[pcname]?"

# game/Scenes/Juliana/juliana2.rpy:20
translate turkish juliana2_fc83ac13:

    # "I think about continuing to walk, but the nervousness in her voice makes me stop."
    "Yürümeye devam etmeyi düşünüyorum ama sesindeki gerginlik beni durduruyor."

# game/Scenes/Juliana/juliana2.rpy:24
translate turkish juliana2_395d1511:

    # bn "[pcname], can you just talk to me for a second?"
    bn "[pcname], benimle bir saniye konuşabilir misin?"

# game/Scenes/Juliana/juliana2.rpy:25
translate turkish juliana2_63023601:

    # pc "Okay."
    pc "Tamam."

# game/Scenes/Juliana/juliana2.rpy:28
translate turkish juliana2_9da0d89a:

    # bn "I'm sorry about the things I wrote on your essay."
    bn "Kompozisyonuna yazdıklarım için özür dilerim."

# game/Scenes/Juliana/juliana2.rpy:29
translate turkish juliana2_ec9b7d74:

    # bn "I know that sometimes I can be too harsh. Too blunt with my words."
    bn "Bazen çok sert olabileceğimi biliyorum. Sözlerim çok açık sözlü oluyor."

# game/Scenes/Juliana/juliana2.rpy:30
translate turkish juliana2_e1eed4cc:

    # bn "I'm not good with talking to people. I get nervous and my words come out muddled."
    bn "İnsanlarla konuşmakta pek iyi değilim. Gergin oluyorum ve sözlerim karışık çıkıyor."

# game/Scenes/Juliana/juliana2.rpy:31
translate turkish juliana2_439f936e:

    # bn "When I was editing your essay, I failed to take into account that there was a person on the other side of the writing."
    bn "Kompozisyonunu düzeltirken, yazının diğer tarafında bir kişi olduğunu hesaba katmadım."

# game/Scenes/Juliana/juliana2.rpy:32
translate turkish juliana2_828e0032:

    # bn "And I apologize for that. I should have been kinder."
    bn "Ve bunun için özür dilerim. Daha nazik olmalıydım."

# game/Scenes/Juliana/juliana2.rpy:33
translate turkish juliana2_6ac1535a:

    # "I look at her, genuinely sorry for what she had written."
    "Ona bakıyorum, yazdıkları için içtenlikle üzgünüm."

# game/Scenes/Juliana/juliana2.rpy:34
translate turkish juliana2_4af91df8:

    # "It's difficult for me to stay mad after that."
    "Bundan sonra kızgın kalmam zor."

# game/Scenes/Juliana/juliana2.rpy:35
translate turkish juliana2_7836aabb:

    # pc "I forgive you."
    pc "Seni affediyorum."

# game/Scenes/Juliana/juliana2.rpy:36
translate turkish juliana2_359954db:

    # pc "Besides, your input did help me get an A on that essay."
    pc "Ayrıca, yorumların o kompozisyondan A almama gerçekten yardımcı oldu."

# game/Scenes/Juliana/juliana2.rpy:39
translate turkish juliana2_49b20716:

    # bn "Good. I'm glad."
    bn "Güzel. Sevindim."

# game/Scenes/Juliana/juliana2.rpy:40
translate turkish juliana2_36f62856:

    # bn "That was my intention. To help you fix your essay."
    bn "Amacım da buydu. Kompozisyonunu düzeltmene yardım etmek."

# game/Scenes/Juliana/juliana2.rpy:41
translate turkish juliana2_5d0adf4a:

    # pc "Well you did a good job there."
    pc "Bu konuda iyi iş çıkardın."

# game/Scenes/Juliana/juliana2.rpy:44
translate turkish juliana2_a559e42c:

    # bn "I could help you more if you want."
    bn "İstersen sana daha fazla yardım edebilirim."

# game/Scenes/Juliana/juliana2.rpy:45
translate turkish juliana2_7e811564:

    # bn "If you want to maybe study together sometime?"
    bn "Belki bir ara birlikte çalışmak ister misin?"

# game/Scenes/Juliana/juliana2.rpy:46
translate turkish juliana2_ff08c86f:

    # bn "I'm usually in the café here on campus in the morning."
    bn "Sabahları genellikle kampüsteki bu kafede olurum."

# game/Scenes/Juliana/juliana2.rpy:47
translate turkish juliana2_e4b8a84b:

    # bn "You could come by and study with me if you want."
    bn "İstersen uğrayıp benimle çalışabilirsin."

# game/Scenes/Juliana/juliana2.rpy:52
translate turkish juliana2_1abdf9b6:

    # bn "Good, I'm looking forward to it!"
    bn "Güzel, sabırsızlıkla bekliyorum!"

# game/Scenes/Juliana/juliana2.rpy:53
translate turkish juliana2_d63c89db:

    # bn "Okay, well I better get on to my next class."
    bn "Tamam, peki, şimdi bir sonraki dersime gitmeliyim."

# game/Scenes/Juliana/juliana2.rpy:54
translate turkish juliana2_9c9c1091:

    # bn "I'm glad we talked."
    bn "Konuştuğumuza sevindim."

# game/Scenes/Juliana/juliana2.rpy:57
translate turkish juliana2_b237b55e:

    # bn "Okay, well if you change your mind, I'll be there."
    bn "Tamam, peki fikrini değiştirirsen, ben orada olacağım."

# game/Scenes/Juliana/juliana2.rpy:58
translate turkish juliana2_5dfb772a:

    # bn "I better get on to my next class."
    bn "Bir sonraki dersime geçsem iyi olacak."

# game/Scenes/Juliana/juliana2.rpy:59
translate turkish juliana2_268fafe9:

    # bn "But I'm glad we talked."
    bn "Ama konuştuğumuza sevindim."

# game/Scenes/Juliana/juliana2.rpy:62
translate turkish juliana2_fa503b05:

    # "With that, she walks out of Mrs. McGee's class and rushes down the hall."
    "Bunun üzerine, Bayan McGee’nin dersinden çıkıp koridorda koşar adımlarla ilerler."

# game/Scenes/Juliana/juliana2.rpy:63
translate turkish juliana2_5b956f56:

    # "I head the opposite direction towards my own class."
    "Ben ise tam ters yönde, kendi dersime doğru ilerlerim."

# game/Scenes/Juliana/juliana2.rpy:64
translate turkish juliana2_02bf7eb2:

    # "The rest of the day passes quickly and without incident, then it's time to go to work."
    "Günün geri kalanı hızlı ve sorunsuz geçer, sonra işime gitme vakti gelir."

translate turkish strings:

    # game/Scenes/Juliana/juliana2.rpy:2
    old "After the scene where Juliana critiques your essay,"
    new "Juliana’nın kompozisyonunu eleştirdiği sahneden sonra,"

    # game/Scenes/Juliana/juliana2.rpy:3
    old "this scene will happen automatically in English class."
    new "bu sahne İngilizce dersinde otomatik olarak gerçekleşecek."

    # game/Scenes/Juliana/juliana2.rpy:55
    old "Maybe, I don't know"
    new "Belki, bilmiyorum"

