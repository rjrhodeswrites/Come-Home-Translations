# TODO: Translation updated at 2026-08-03 12:42

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:32
translate turkish julianamovietheaterstartdate_0f1c479d:

    # "We get to the theater and get seats in the back."
    "Sinemaya varıyoruz ve arka sıralardan yer alıyoruz."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:33
translate turkish julianamovietheaterstartdate_cd1f1d61:

    # bn "What kind of movie are we watching?"
    bn "Ne tür bir film izleyeceğiz?"

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:37
translate turkish julianamovietheaterstartdate_9753ecc6:

    # bn "That sounds very nice."
    bn "Kulağa çok hoş geliyor."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:38
translate turkish julianamovietheaterstartdate_08edcd3e:

    # bn "I like romantic movies."
    bn "Romantik filmleri severim."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:43
translate turkish julianamovietheaterstartdate_22be6204:

    # bn "Oh really?"
    bn "Öyle mi?"

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:44
translate turkish julianamovietheaterstartdate_a7aa68a8:

    # bn "I'm not really interested dumb action movies, but okay."
    bn "Aptal aksiyon filmleriyle pek ilgilenmem ama tamam."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:50
translate turkish julianamovietheaterstartdate_a36785e7:

    # bn "Oh really? I don't really like scary movies at all."
    bn "Öyle mi? Korku filmlerini hiç sevmem."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:51
translate turkish julianamovietheaterstartdate_5b88690f:

    # bn "Unless they're about hauntings, or they have some sort of romance in them."
    bn "Tabii hayaletlerle ilgili ya da içinde biraz romantizm varsa o başka."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:52
translate turkish julianamovietheaterstartdate_ffedd8a3:

    # bn "Most horror movies are really dumb."
    bn "Çoğu korku filmi gerçekten aptalca."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:58
translate turkish julianamovietheaterstartdate_352ba7de:

    # bn "Oh okay."
    bn "Tamam."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:59
translate turkish julianamovietheaterstartdate_9c6a96f5:

    # bn "I try to enjoy comedies, but I don't always get the jokes."
    bn "Komedi filmlerinden keyif almaya çalışırım ama esprileri her zaman anlamıyorum."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:60
translate turkish julianamovietheaterstartdate_74eb3e05:

    # bn "There's a lot of times that I just don't understand what is supposed to be funny and what's not."
    bn "Neyin komik olması gerektiği, neyin olmaması gerektiğini çoğu zaman anlamıyorum."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:61
translate turkish julianamovietheaterstartdate_cf50250b:

    # bn "But I'll try my best to laugh at the parts I'm supposed to."
    bn "Ama gülmem gereken yerlerde gülmek için elimden geleni yapacağım."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:63
translate turkish julianamovietheaterstartdate_2fcc7df5:

    # "There's a little time before the movie starts for us to chat some."
    "Film başlamadan önce biraz sohbet etmek için vaktimiz var."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:67
translate turkish julianamovietheaterstartdate_592835a4:

    # "Finally the movie starts up and we go silent."
    "Sonunda film başlıyor ve sessizleşiyoruz."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:70
translate turkish julianamovietheaterstartdate_fd60e14c:

    # "She reaches over and holds my hand on top of the arm rest."
    "Bana doğru uzanıp kol dayama yerinin üstünden elimi tutuyor."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:74
translate turkish julianamovietheaterstartdate_aee76b2d:

    # "The trailers take up about fifteen minutes, then the movie really gets started."
    "Fragmanlar yaklaşık on beş dakika sürüyor, sonra film gerçekten başlıyor."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:78
translate turkish julianamovietheaterstartdate_17eefcb1:

    # "During the movie, she leans on my shoulder, really getting into the story."
    "Film sırasında omzuma yaslanıyor, hikâyeye kendini kaptırıyor."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:80
translate turkish julianamovietheaterstartdate_1b60b301:

    # "Then during a particularly romantic scene, she raises her head and puts her lips to mine."
    "Sonra özellikle romantik bir sahnede başını kaldırıp dudaklarını dudaklarıma değdiriyor."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:81
translate turkish julianamovietheaterstartdate_787192bc:

    # "We don't really watch a lot of the rest of the movie, instead focusing on making out."
    "Filmin geri kalanını pek izlemiyoruz, bunun yerine öpüşmeye odaklanıyoruz."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:84
translate turkish julianamovietheaterstartdate_d17a4ae6:

    # "During the movie, she leans against my shoulder, really getting into the story."
    "Film sırasında omzuma yaslanıyor ve hikâyeye kendini kaptırıyor."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:86
translate turkish julianamovietheaterstartdate_610dce56:

    # "She seems to be liking the movie okay."
    "Filmi fena sayılmayacak kadar beğeniyor gibi görünüyor."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:89
translate turkish julianamovietheaterstartdate_dcbaecf4:

    # "Juliana watches the movie, but she looks annoyed the entire time."
    "Juliana filmi izliyor ama başından sonuna kadar sinirli görünüyor."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:92
translate turkish julianamovietheaterstartdate_40670365:

    # "Eventually, she turns towards me."
    "Sonunda bana doğru dönüyor."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:93
translate turkish julianamovietheaterstartdate_b867ff88:

    # bn "This movie is really bad, isn't it? It might be the worst movie I've ever seen."
    bn "Bu film gerçekten çok kötü, değil mi? Belki de şimdiye kadar izlediğim en kötü filmdir."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:94
translate turkish julianamovietheaterstartdate_e3d0d8a6:

    # "She does not speak quietly, and some people in front of us turn and look at us."
    "Sesini alçaltmıyor ve önümüzde oturan bazı insanlar dönüp bize bakıyor."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:95
translate turkish julianamovietheaterstartdate_d58327fc:

    # pc "Do you want to leave?"
    pc "Gitmek ister misin?"

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:97
translate turkish julianamovietheaterstartdate_25b2e9a4:

    # bn "No, can we just kiss or something instead? I don't care about watching this."
    bn "Hayır, bunun yerine öpüşsek ya da başka bir şey yapsak olmaz mı? Bu filmi izlemek umurumda değil."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:98
translate turkish julianamovietheaterstartdate_4f1735dd:

    # pc "Sounds good to me."
    pc "Bana uyar."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:100
translate turkish julianamovietheaterstartdate_d0a52fcf:

    # "I lean in and kiss her and we don't really watch much else of the movie, instead focusing on each other."
    "Ona doğru eğilip onu öptüm ve filmin geri kalanını pek izlemedik, bunun yerine birbirimize odaklandık."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:103
translate turkish julianamovietheaterstartdate_c1b8c885:

    # "The horror movie was not about hauntings and had no romance in it."
    "Korku filmi hayaletlerle ilgili değildi ve içinde hiç romantizm yoktu."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:104
translate turkish julianamovietheaterstartdate_003c9dc3:

    # "I'm pretty sure Juliana hated it."
    "Juliana’nın bundan nefret ettiğinden oldukça eminim."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:105
translate turkish julianamovietheaterstartdate_27d6edde:

    # "At one point, I even tried holding her hand, but she was not interested."
    "Bir ara elini tutmaya bile çalıştım, ama ilgilenmedi."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:106
translate turkish julianamovietheaterstartdate_d58327fc_1:

    # pc "Do you want to leave?"
    pc "Gitmek ister misin?"

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:107
translate turkish julianamovietheaterstartdate_4aa1d16b:

    # bn "We're already too far in. I have to know which of these dumb girls is going to live."
    bn "Zaten çok ilerledik. Bu aptal kızlardan hangisinin hayatta kalacağını bilmem lazım."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:108
translate turkish julianamovietheaterstartdate_880b4aa8:

    # pc "Okay..."
    pc "Tamam..."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:111
translate turkish julianamovietheaterstartdate_92b7555a:

    # "At first, I'm not sure that Juliana is going to like the movie at all."
    "İlk başta, Juliana’nın bu filmi hiç seveceğinden emin değildim."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:112
translate turkish julianamovietheaterstartdate_c421db42:

    # "She looks frustrated through the beginning."
    "Filmin başlarında sinirli görünüyordu."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:113
translate turkish julianamovietheaterstartdate_4e4b3a2b:

    # "But then..."
    "Ama sonra..."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:115
translate turkish julianamovietheaterstartdate_bd97c290:

    # "During one of the dumb jokes, she bursts into a fit of laughter that seems to go on forever."
    "Aptalca esprilerden birinin sırasında, sanki hiç bitmeyecekmiş gibi bir kahkaha krizine girdi."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:116
translate turkish julianamovietheaterstartdate_fa75bbc3:

    # pc "Are you okay?"
    pc "İyi misin?"

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:117
translate turkish julianamovietheaterstartdate_5b62109c:

    # bn "Yes. I'm sorry. It's so funny though."
    bn "Evet. Özür dilerim. Ama çok komik."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:118
translate turkish julianamovietheaterstartdate_6ecb5d88:

    # bn "It's funny because he farted in a place where it was awkward to fart."
    bn "Komik çünkü osurması uygunsuz bir yerde osurdu."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:119
translate turkish julianamovietheaterstartdate_b59d1ff2:

    # bn "And he couldn't stop farting!"
    bn "Ve osurmayı kesemedi!"

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:120
translate turkish julianamovietheaterstartdate_9ef4273c:

    # "Once she starts laughing, she barely stops throughout the rest of the movie."
    "Bir kez gülmeye başlayınca, filmin geri kalanı boyunca neredeyse hiç durmadı."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:124
translate turkish julianamovietheaterstartdate_e42d81a7:

    # bn "I really liked that. I love when they go through some hardships, but stay together in the end."
    bn "Bunu gerçekten çok beğendim. Zorluklar yaşayıp da sonunda birlikte kalmalarını seviyorum."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:125
translate turkish julianamovietheaterstartdate_fe15de53:

    # bn "Thank you for bringing me. I enjoyed all of it."
    bn "Beni getirdiğin için teşekkürler. Her şeyini çok beğendim."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:129
translate turkish julianamovietheaterstartdate_71eb6066:

    # bn "Well, thanks for bringing me, but maybe not an action movie next time?"
    bn "Beni getirdiğin için teşekkürler, ama belki bir dahaki sefere aksiyon filmi olmasa?"

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:130
translate turkish julianamovietheaterstartdate_6f6931a9:

    # bn "Even the noise of it was giving me a headache."
    bn "Sesleri bile başımı ağrıtıyordu."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:134
translate turkish julianamovietheaterstartdate_5bf0a9a9:

    # bn "That was the dumbest thing I've ever seen in my life."
    bn "Bu, hayatımda gördüğüm en aptalca şeydi."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:135
translate turkish julianamovietheaterstartdate_2f39e364:

    # pc "It was pretty bad."
    pc "Oldukça kötüydü."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:136
translate turkish julianamovietheaterstartdate_02a07558:

    # bn "I hated it."
    bn "Hiç beğenmedim."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:137
translate turkish julianamovietheaterstartdate_09c476ba:

    # bn "No more horror movies. They're all trash."
    bn "Artık korku filmi izlemeyeceğim. Hepsi çöp."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:138
translate turkish julianamovietheaterstartdate_459e0f19:

    # pc "Okay. No more horror movies."
    pc "Tamam. Artık korku filmi izlemeyeceğim."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:141
translate turkish julianamovietheaterstartdate_850f6df3:

    # bn "That was so funny."
    bn "Çok komikti."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:142
translate turkish julianamovietheaterstartdate_4083c4d8:

    # bn "I'm sorry if I laughed too much."
    bn "Çok güldüğüm için özür dilerim."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:143
translate turkish julianamovietheaterstartdate_cd4369b1:

    # pc "No, it was fun to see you cut loose like that."
    pc "Hayır, senin o kadar rahatladığını görmek eğlenceliydi."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:144
translate turkish julianamovietheaterstartdate_f50c4948:

    # bn "I guess I don't laugh very often, huh?"
    bn "Sanırım pek sık gülmüyorum, değil mi?"

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:145
translate turkish julianamovietheaterstartdate_b459f5c7:

    # bn "But when I do... wow, you have to look out."
    bn "Ama güldüğümde... vay canına, dikkat etmelisin."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:146
translate turkish julianamovietheaterstartdate_985a02fd:

    # "We hang out after the movie and chat during the credits."
    "Film bittikten sonra takılıyoruz ve jeneriği izlerken sohbet ediyoruz."

# game/Scenes/Juliana/JulianaDates/julianamoviedate.rpy:150
translate turkish julianamovietheaterstartdate_972891e3:

    # "When the credits end, we walk outside together and out to my car."
    "Jenerik bittiğinde, birlikte dışarı çıkıp arabama doğru yürüyoruz."

