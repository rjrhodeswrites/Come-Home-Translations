translate turkish julianaluigisstartdate_2f29693a:

    # bn "I like to wear them when I go out somewhere nice."
    bn "Güzel bir yere giderken bunları giymeyi seviyorum."

# game/Scenes/Juliana/JulianaDates/julianaluigisdate.rpy:47
translate turkish julianaluigisstartdate_1431cc27:

    # bn "Thank you."
    bn "Teşekkür ederim."

# game/Scenes/Juliana/JulianaDates/julianaluigisdate.rpy:48
translate turkish julianaluigisstartdate_3dc0e34e_1:

    # "She turns away and blushes a little."
    "Yüzünü başka yöne çevirip biraz kızarır."

# game/Scenes/Juliana/JulianaDates/julianaluigisdate.rpy:50
translate turkish julianaluigisstartdate_563fa2c8:

    # bn "Okay. Well I prefer the wig when I go somewhere nice."
    bn "Tamam. Ben de güzel bir yere giderken peruğu tercih ederim."

# game/Scenes/Juliana/JulianaDates/julianaluigisdate.rpy:51
translate turkish julianaluigisstartdate_e256026f:

    # "I'm not really sure how to respond, so we end up driving the rest of the way to the restaurant in an awkward silence."
    "Nasıl cevap vereceğimi tam bilemiyorum, bu yüzden restorana kadar kalan yolu garip bir sessizlik içinde süreriz."

# game/Scenes/Juliana/JulianaDates/julianaluigisdate.rpy:54
translate turkish julianaluigisstartdate_62345451:

    # "When we get to Luigi's, we sit and order our meals."
    "Luigi's'e vardığımızda oturup yemeklerimizi sipariş ederiz."

# game/Scenes/Juliana/JulianaDates/julianaluigisdate.rpy:55
translate turkish julianaluigisstartdate_c57a5228:

    # "Then we chat for a while."
    "Sonra bir süre sohbet ederiz."

# game/Scenes/Juliana/JulianaDates/julianaluigisdate.rpy:58
translate turkish julianaluigisstartdate_0875967f:

    # "The server brings our food out, and we continue talking while we eat."
    "Garson yemeklerimizi getiriyor ve biz de yerken sohbet etmeye devam ediyoruz."

# game/Scenes/Juliana/JulianaDates/julianaluigisdate.rpy:60
translate turkish julianaluigisstartdate_dbe7b11f:

    # "When we're done eating, we just hang around and talk for a little more."
    "Yemeğimizi bitirdikten sonra, biraz daha oturup sohbet ediyoruz."

# game/Scenes/Juliana/JulianaDates/julianaluigisdate.rpy:63
translate turkish julianaluigisstartdate_018a4945:

    # "After our conversation, I pay for the food and we leave the restaurant and drive back to Juliana's house."
    "Sohbetimiz bittikten sonra, hesabı ödüyorum, restorandan çıkıp Juliana’nın evine geri dönüyoruz."

