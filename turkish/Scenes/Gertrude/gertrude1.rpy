# game/Scenes/Gertrude/gertrude1.rpy:12
translate turkish gertrude1_b8ab60df:

    # sc "I had a kind of personal question for you today."
    sc "Bugün sana kişisel bir sorum var."

# game/Scenes/Gertrude/gertrude1.rpy:13
translate turkish gertrude1_46f5a669:

    # pc "Okay, go ahead."
    pc "Tamam, sor bakalım."

# game/Scenes/Gertrude/gertrude1.rpy:14
translate turkish gertrude1_f61c5e45:

    # sc "If you don't want to answer it, you don't have to."
    sc "Cevap vermek istemiyorsan, cevap vermek zorunda değilsin."

# game/Scenes/Gertrude/gertrude1.rpy:15
translate turkish gertrude1_e2305d2c:

    # pc "Just ask."
    pc "Sormaya devam et."

# game/Scenes/Gertrude/gertrude1.rpy:16
translate turkish gertrude1_0cd2dbde:

    # sc "Are you sexually active?"
    sc "Cinsel olarak aktif misin?"

# game/Scenes/Gertrude/gertrude1.rpy:20
translate turkish gertrude1_7b5b8bbb:

    # sc "I think that most people would say that."
    sc "Sanırım çoğu insan öyle derdi."

# game/Scenes/Gertrude/gertrude1.rpy:23
translate turkish gertrude1_ebf7eccb:

    # sc "Good, I'm glad."
    sc "Güzel, sevindim."

# game/Scenes/Gertrude/gertrude1.rpy:26
translate turkish gertrude1_13162311:

    # sc "I'm sorry, I'm not trying to get involved in your personal life."
    sc "Özür dilerim, özel hayatına karışmaya çalışmıyorum."

# game/Scenes/Gertrude/gertrude1.rpy:27
translate turkish gertrude1_dda22b21:

    # sc "But I do think that it is healthy to be sexually active at your age."
    sc "Ama senin yaşında cinsel olarak aktif olmanın sağlıklı olduğunu düşünüyorum."

# game/Scenes/Gertrude/gertrude1.rpy:29
translate turkish gertrude1_5a649775:

    # sc "College is the perfect opportunity to experiment."
    sc "Üniversite, deneme yapmak için mükemmel bir fırsat."

# game/Scenes/Gertrude/gertrude1.rpy:30
translate turkish gertrude1_b8b829eb:

    # sc "To figure out what you like and don't like."
    sc "Neyi sevip neyi sevmediğini anlamak için."

# game/Scenes/Gertrude/gertrude1.rpy:32
translate turkish gertrude1_8594ced1:

    # sc "You don't want to look back later in life and wonder about the things you missed out on."
    sc "Hayatının ilerleyen dönemlerinde geriye bakıp kaçırdığın şeyleri merak etmek istemezsin."

# game/Scenes/Gertrude/gertrude1.rpy:36
translate turkish gertrude1_639c8f25:

    # sc "Good."
    sc "Güzel."

# game/Scenes/Gertrude/gertrude1.rpy:39
translate turkish gertrude1_070c7224:

    # sc "As long as you're safe about it, yes."
    sc "Güvenli olduğu sürece, evet."

# game/Scenes/Gertrude/gertrude1.rpy:40
translate turkish gertrude1_9fc07896:

    # sc "I think that you should have lots of sex with a variety of people."
    sc "Bence çeşitli insanlarla bol bol seks yapmalısın."

# game/Scenes/Gertrude/gertrude1.rpy:41
translate turkish gertrude1_6bec941c:

    # sc "I believe that it gives you a healthier mindset when you're older, like me."
    sc "Benim gibi yaşlandığında sana daha sağlıklı bir zihniyet kazandıracağına inanıyorum."

# game/Scenes/Gertrude/gertrude1.rpy:43
translate turkish gertrude1_a0193afd:

    # sc "Anyway, that is enough of this talk."
    sc "Neyse, bu konuyu bu kadar konuşmak yeter."

# game/Scenes/Gertrude/gertrude1.rpy:44
translate turkish gertrude1_e11ba8d0:

    # sc "You should get to class, right?"
    sc "Derse gitmen gerek, değil mi?"

# game/Scenes/Gertrude/gertrude1.rpy:46
translate turkish gertrude1_9f00d552:

    # pc "Yeah, I guess so."
    pc "Evet, sanırım öyle."

# game/Scenes/Gertrude/gertrude1.rpy:47
translate turkish gertrude1_8f9b25a7:

    # sc "Okay, well I'll see you next time, [pcname]."
    sc "Tamam, peki, bir dahaki sefere görüşürüz, [pcname]."

# game/Scenes/Gertrude/gertrude1.rpy:48
translate turkish gertrude1_850ead77:

    # pc "Okay. Bye, Gertrude."
    pc "Tamam. Hoşça kal, Gertrude."

