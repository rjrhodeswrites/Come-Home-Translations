# game/Scenes/Micha/MichaConversations/michas4.rpy:15
translate turkish michas4_cb1615b7:

    # mc "My father chose it. I don't know why he chose this place in particular."
    mc "Burayı babam seçti. Neden özellikle burayı seçtiğini bilmiyorum."

# game/Scenes/Micha/MichaConversations/michas4.rpy:17
translate turkish michas4_7558e3ed:

    # mc "I believe he was given a list of places that would accept me, despite my poor grades..."
    mc "Sanırım, notlarım kötü olmasına rağmen beni kabul edecek okulların bir listesi verilmişti..."

# game/Scenes/Micha/MichaConversations/michas4.rpy:18
translate turkish michas4_6f225033:

    # mc "...and Skyhill University was the highest rated school that I qualified for."
    mc "...ve Skyhill Üniversitesi, girmeye hak kazandığım okullar arasında en yüksek puanlı olanıydı."

# game/Scenes/Micha/MichaConversations/michas4.rpy:20
translate turkish michas4_e2c5e502:

    # mc "Which says something about how poor my grades were."
    mc "Bu da notlarımın ne kadar kötü olduğunu gösteriyor."

# game/Scenes/Micha/MichaConversations/michas4.rpy:22
translate turkish michas4_db3fe301:

    # mc "I'm sorry! I don't mean to dishonor this school!"
    mc "Özür dilerim! Bu okulu küçük düşürmek istemem!"

# game/Scenes/Micha/MichaConversations/michas4.rpy:24
translate turkish michas4_736c172d:

    # mc "It is a good school and I am happy to be given the opportunity to study here."
    mc "Burası iyi bir okul ve burada okuma fırsatı bulduğum için mutluyum."

# game/Scenes/Micha/MichaConversations/michas4.rpy:26
translate turkish michas4_4ec300b0:

    # mc "When I talk to my friends back home though, none of them have ever heard of Skyhill. They think that I am making the place up."
    mc "Ama memleketimdeki arkadaşlarımla konuştuğumda, hiçbiri Skyhill’i duymamış. Orayı uydurduğumu düşünüyorlar."

# game/Scenes/Micha/MichaConversations/michas4.rpy:28
translate turkish michas4_65bfb7d2:

    # mc "So... I know that it is wrong to lie, but I tell them that I am attending Harvard."
    mc "Yani... Yalan söylemenin yanlış olduğunu biliyorum, ama onlara Harvard’a gittiğimi söylüyorum."

# game/Scenes/Micha/MichaConversations/michas4.rpy:29
translate turkish michas4_839ed9b8:

    # pc "Haha! Really?"
    pc "Haha! Gerçekten mi?"

# game/Scenes/Micha/MichaConversations/michas4.rpy:31
translate turkish michas4_2064101c:

    # mc "Yes. It is funny, isn't it?"
    mc "Evet. Komik, değil mi?"

# game/Scenes/Micha/MichaConversations/michas4.rpy:32
translate turkish michas4_862bf897:

    # pc "It's hilarious."
    pc "Çok komik."

# game/Scenes/Micha/MichaConversations/michas4.rpy:33
translate turkish michas4_1e5e09e7:

    # mc "I'm glad you think so. I thought so too."
    mc "Öyle düşündüğüne sevindim. Ben de öyle düşünmüştüm."

# game/Scenes/Micha/MichaConversations/michas4.rpy:35
translate turkish michas4_9b17ca88:

    # mc "They all believe me too. I tell them that I am very popular and that I have a boyfriend also."
    mc "Hepsi de bana inanıyor. Onlara çok popüler olduğumu ve bir erkek arkadaşım olduğunu da söylüyorum."

# game/Scenes/Micha/MichaConversations/michas4.rpy:38
translate turkish michas4_facfa516:

    # mc "Which part?"
    mc "Hangi kısmı?"

# game/Scenes/Micha/MichaConversations/michas4.rpy:39
translate turkish michas4_b7770814:

    # pc "That you have a boyfriend. Since I'm your boyfriend."
    pc "Erkek arkadaşın olduğu kısmı. Çünkü ben senin erkek arkadaşınım."

# game/Scenes/Micha/MichaConversations/michas4.rpy:41
translate turkish michas4_a4fcb7ef:

    # mc "Oh!"
    mc "Oh!"

# game/Scenes/Micha/MichaConversations/michas4.rpy:42
translate turkish michas4_9a78c4c6:

    # mc "Yes, I guess you are."
    mc "Evet, sanırım öylesin."

# game/Scenes/Micha/MichaConversations/michas4.rpy:45
translate turkish michas4_c4a23117:

    # mc "I know. I am awful sometimes."
    mc "Biliyorum. Bazen çok kötüyüm."

# game/Scenes/Micha/MichaConversations/michas4.rpy:46
translate turkish michas4_2f03ca34:

    # pc "It's still funny though."
    pc "Yine de komik."

# game/Scenes/Micha/MichaConversations/michas4.rpy:48
translate turkish michas4_9331e107:

    # mc "Yes it is."
    mc "Evet, öyle."

translate turkish strings:

    # game/Scenes/Micha/MichaConversations/michas4.rpy:37
    old "Well at least that part is not a lie"
    new "En azından o kısım yalan değil."

    # game/Scenes/Micha/MichaConversations/michas4.rpy:44
    old "Wow, such a liar!"
    new "Vay canına, ne yalancı!"

