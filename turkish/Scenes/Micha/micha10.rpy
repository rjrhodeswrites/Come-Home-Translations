# TODO: Translation updated at 2026-08-03 12:42

# game/Scenes/Micha/micha10.rpy:15
translate turkish micha10_53d7eff6:

    # "She gets in my car and we drive back towards the school and park near the dorms."
    "Arabama biniyor ve okula doğru geri dönüp yurtların yakınına park ediyoruz."

# game/Scenes/Micha/micha10.rpy:18
translate turkish micha10_0ba0ce57:

    # mc "Would you walk to my dorm with me?"
    mc "Benimle birlikte yurda yürür müsün?"

# game/Scenes/Micha/micha10.rpy:19
translate turkish micha10_61f77a4c:

    # pc "Sure."
    pc "Tabii."

# game/Scenes/Micha/micha10.rpy:26
translate turkish micha10_fc5b71e7:

    # "We walk through the school courtyard, towards her dorm building."
    "Okul avlusundan geçip onun yurt binasına doğru yürüyoruz."

# game/Scenes/Micha/micha10.rpy:27
translate turkish micha10_9c8bddba:

    # "The night air is cool, and the school is surprisingly peaceful and quiet."
    "Gece havası serin ve okul şaşırtıcı derecede huzurlu ve sessiz."

# game/Scenes/Micha/micha10.rpy:34
translate turkish micha10_8f3659cb:

    # "She glances over at me and then slides her hand into mine."
    "Bana bir bakış atıyor ve sonra elini elime kaydırıyor."

# game/Scenes/Micha/micha10.rpy:35
translate turkish micha10_b17081d9:

    # "Her hand is cold and small and soft. I hold it gently as we continue walking."
    "Eli soğuk, küçük ve yumuşak. Yürümeye devam ederken elini nazikçe tutuyorum."

# game/Scenes/Micha/micha10.rpy:42
translate turkish micha10_9207436c:

    # mc "Would you maybe want to sit and chat for a while before I go inside?"
    mc "İçeri girmeden önce biraz oturup sohbet etmek ister misin?"

# game/Scenes/Micha/micha10.rpy:43
translate turkish micha10_8fefe090:

    # mc "I had such a good time with you today. I am not quite ready for it to end."
    mc "Bugün seninle çok güzel vakit geçirdim. Henüz bitmesine hazır değilim."

# game/Scenes/Micha/micha10.rpy:44
translate turkish micha10_4476e592:

    # pc "Sure, we can do that."
    pc "Tabii, yapabiliriz."

# game/Scenes/Micha/micha10.rpy:51
translate turkish micha10_d96ba613:

    # "We sit on the bench together, her hand still enveloped in mine."
    "Birlikte bankta oturuyoruz, eli hâlâ benim elimde."

# game/Scenes/Micha/micha10.rpy:52
translate turkish micha10_5e2207f4:

    # "I wonder what she would want to talk about? She barely talks about anything at all."
    "Acaba ne hakkında konuşmak ister? Neredeyse hiçbir şeyden bahsetmiyor."

# game/Scenes/Micha/micha10.rpy:59
translate turkish micha10_5ec89b3b:

    # mc "I like it here."
    mc "Burayı seviyorum."

# game/Scenes/Micha/micha10.rpy:60
translate turkish micha10_00ff76ff:

    # pc "Yeah, the fresh air feels really nice. And the trees are pretty."
    pc "Evet, temiz hava gerçekten çok güzel. Ağaçlar da çok güzel."

# game/Scenes/Micha/micha10.rpy:61
translate turkish micha10_277d368d:

    # mc "No. I meant I like it here... in America."
    mc "Hayır. Demek istediğim, burayı seviyorum... Amerika'yı."

# game/Scenes/Micha/micha10.rpy:62
translate turkish micha10_193e6392:

    # mc "I wish that I could stay."
    mc "Keşke kalabilseydim."

# game/Scenes/Micha/micha10.rpy:69
translate turkish micha10_4354fa16:

    # pc "What do you mean? You have to go back to Korea?"
    pc "Ne demek istiyorsun? Kore'ye geri dönmek zorunda mısın?"

# game/Scenes/Micha/micha10.rpy:71
translate turkish micha10_d41d8cd9:

    # voice 'voices/micha_yes2.mp3'
    voice 'voices/micha_yes2.mp3'

# game/Scenes/Micha/micha10.rpy:72
translate turkish micha10_b63541c5:

    # mc "Yes. I have to return and become married after I finish this semester."
    mc "Evet. Bu dönemi bitirdikten sonra geri dönüp evlenmek zorundayım."

# game/Scenes/Micha/micha10.rpy:73
translate turkish micha10_1ae5f5f0:

    # pc "What? Why?"
    pc "Ne? Neden?"

# game/Scenes/Micha/micha10.rpy:74
translate turkish micha10_97c2ea57:

    # mc "My parents have arranged it. They have chosen a man. I will become his wife when I return."
    mc "Ailem ayarladı. Bir adam seçtiler. Döndüğümde onun karısı olacağım."

# game/Scenes/Micha/micha10.rpy:75
translate turkish micha10_29f911d6:

    # pc "Is that what you want? Do you even like him?"
    pc "Sen de bunu mu istiyorsun? Ondan hoşlanıyor musun ki?"

# game/Scenes/Micha/micha10.rpy:76
translate turkish micha10_e1f07ca9:

    # mc "I have never met him. I am sure that he is nice though. My parents chose him."
    mc "Onunla hiç tanışmadım. Ama eminim ki iyi biridir. Ailem onu seçti."

# game/Scenes/Micha/micha10.rpy:77
translate turkish micha10_51e20623:

    # pc "You want that though?"
    pc "Ama bunu istiyor musun?"

# game/Scenes/Micha/micha10.rpy:78
translate turkish micha10_4989970d:

    # mc "I want to be a wife, yes. But I do like it here."
    mc "Evlenmek istiyorum, evet. Ama burayı da seviyorum."

# game/Scenes/Micha/micha10.rpy:79
translate turkish micha10_22cefe33:

    # pc "Why don't you just stay then? Why don't you tell your parents no, and stay here?"
    pc "O zaman neden kalmıyorsun? Neden ailene hayır deyip burada kalmıyorsun?"

# game/Scenes/Micha/micha10.rpy:86
translate turkish micha10_d64f1fa7:

    # mc "It does not work that way."
    mc "İşler öyle yürümüyor."

# game/Scenes/Micha/micha10.rpy:89
translate turkish micha10_14baa1d2:

    # mc "I really like you too, [pcname]."
    mc "Ben de senden gerçekten hoşlanıyorum, [pcname]."

# game/Scenes/Micha/micha10.rpy:91
translate turkish micha10_24676458:

    # mc "Yes, I guess so."
    mc "Evet, sanırım öyle."

# game/Scenes/Micha/micha10.rpy:98
translate turkish micha10_52765170:

    # "We grow silent again, looking up at the stars."
    "Yine sessizliğe bürünürüz, yıldızlara bakarak."

# game/Scenes/Micha/micha10.rpy:99
translate turkish micha10_9e978195:

    # "She has to go back to Korea after this semester. I doubt I would see her again."
    "Bu dönemden sonra Kore’ye geri dönmek zorunda. Onu bir daha görebileceğimi sanmıyorum."

# game/Scenes/Micha/micha10.rpy:100
translate turkish micha10_494d2b9e:

    # "I can't help but feel really sad about that."
    "Bu konuda gerçekten çok üzülmeden edemiyorum."

# game/Scenes/Micha/micha10.rpy:107
translate turkish micha10_06878b88:

    # "As we're watching the sky, a shooting star flies past. She gasps."
    "Gökyüzünü izlerken, bir kayan yıldız geçip gider. O, hayretle nefesini tutar."

# game/Scenes/Micha/micha10.rpy:108
translate turkish micha10_05fba3d4:

    # mc "Oh! It's so beautiful."
    mc "Oh! Çok güzel."

# game/Scenes/Micha/micha10.rpy:109
translate turkish micha10_013ea0ef:

    # pc "You should make a wish."
    pc "Bir dilek tutmalısın."

# game/Scenes/Micha/micha10.rpy:110
translate turkish micha10_9d8e700d:

    # mc "A wish?"
    mc "Dilek mi?"

# game/Scenes/Micha/micha10.rpy:111
translate turkish micha10_10994647:

    # pc "Yeah, when you see a shooting star, you make a wish and it might come true."
    pc "Evet, bir kayan yıldız gördüğünde bir dilek tutarsan, belki gerçekleşir."

# game/Scenes/Micha/micha10.rpy:118
translate turkish micha10_74c726d2:

    # "She looks at me and speaks in a low, shy voice."
    "Bana bakıyor ve alçak, utangaç bir sesle konuşuyor."

# game/Scenes/Micha/micha10.rpy:120
translate turkish micha10_d41d8cd9_1:

    # voice 'voices/micha_10_1.mp3'
    voice 'voices/micha_10_1.mp3'

# game/Scenes/Micha/micha10.rpy:121
translate turkish micha10_c0a252cf:

    # mc "I wish you would kiss me."
    mc "Keşke beni öpseydin."

# game/Scenes/Micha/micha10.rpy:122
translate turkish micha10_2b10aa09:

    # pc "Oh. Well you're not supposed to tell anybody, or it won't happen."
    pc "Oh. Peki, bunu kimseye söylememelisin, yoksa gerçekleşmez."

# game/Scenes/Micha/micha10.rpy:123
translate turkish micha10_23b76a7a:

    # mc "Oh... I did not know that."
    mc "Oh... Bunu bilmiyordum."

# game/Scenes/Micha/micha10.rpy:139
translate turkish micha10kiss_4cdfc044:

    # "I lean in and kiss her."
    "Ona doğru eğilip onu öperim."

# game/Scenes/Micha/micha10.rpy:140
translate turkish micha10kiss_ca40b1c0:

    # pc "It's just dumb superstition anyway."
    pc "Zaten bu sadece aptalca bir batıl inanç."

# game/Scenes/Micha/micha10.rpy:141
translate turkish micha10kiss_39894277:

    # "At first, she is stiff, not moving at all as I kiss her lips. It's like kissing a mannequin."
    "İlk başta, o gergindir, ben dudaklarını öperken hiç kıpırdamaz. Sanki bir mankeni öpüyormuşum gibi."

# game/Scenes/Micha/micha10.rpy:154
translate turkish micha10kiss_4319b810:

    # "But then I feel her body loosen, she puts her hand on my arm and leans in further, her lips moving against mine, breath coming quicker."
    "Ama sonra vücudunun gevşediğini hissederim, elini koluma koyar ve daha da yaklaşır, dudakları benimkilere sürtünür, nefesi hızlanır."

# game/Scenes/Micha/micha10.rpy:155
translate turkish micha10kiss_b9bbd6df:

    # "We kiss like that, under the stars, until the moment turns into minutes, and time seems to float away on the cool night breeze."
    "Yıldızların altında öylece öpüşüyoruz, o an dakikalarca sürene kadar, zaman serin gece esintisiyle uzaklaşıyor gibi."

# game/Scenes/Micha/micha10.rpy:167
translate turkish micha10kiss_a2abceb1:

    # "I have no idea how much time has passed when she finally, reluctantly, pulls away."
    "Ne kadar zaman geçtiğini hiç bilmiyorum ki, sonunda isteksizce benden uzaklaşıyor."

# game/Scenes/Micha/micha10.rpy:168
translate turkish micha10kiss_e9b48769:

    # mc "I should go."
    mc "Gitmem gerek."

# game/Scenes/Micha/micha10.rpy:169
translate turkish micha10kiss_7cf89165:

    # pc "You have to?"
    pc "Gitmek zorunda mısın?"

# game/Scenes/Micha/micha10.rpy:170
translate turkish micha10kiss_1145978d:

    # mc "Yes, I apologize."
    mc "Evet, özür dilerim."

# game/Scenes/Micha/micha10.rpy:173
translate turkish micha10kiss_d89f8402:

    # pc "I should probably go home."
    pc "Muhtemelen eve gitmeliyim."

# game/Scenes/Micha/micha10.rpy:174
translate turkish micha10kiss_2148e939:

    # mc "Okay. Me too then."
    mc "Tamam. O zaman ben de."

# game/Scenes/Micha/micha10.rpy:186
translate turkish micha10kiss_53fd2d63:

    # mc "I had a very good time tonight, [pcname]. Thank you."
    mc "Bu gece çok güzel vakit geçirdim, [pcname]. Teşekkürler."

# game/Scenes/Micha/micha10.rpy:187
translate turkish micha10kiss_445c1419:

    # pc "I'm glad. I did too."
    pc "Sevindim. Ben de öyle."

# game/Scenes/Micha/micha10.rpy:188
translate turkish micha10kiss_7aea7a63:

    # mc "I hope we can do this again soon."
    mc "Umarım bunu yakında tekrar yapabiliriz."

# game/Scenes/Micha/micha10.rpy:190
translate turkish micha10kiss_d41d8cd9:

    # voice 'voices/micha_goodnight1.mp3'
    voice 'voices/micha_goodnight1.mp3'

# game/Scenes/Micha/micha10.rpy:191
translate turkish micha10kiss_9b0423ef:

    # mc "Good night."
    mc "İyi geceler."

# game/Scenes/Micha/micha10.rpy:192
translate turkish micha10kiss_c2ed5d6f:

    # pc "Good night, Mi-Cha."
    pc "İyi geceler, Mi-Cha."

# game/Scenes/Micha/micha10.rpy:195
translate turkish micha10kiss_17735f99:

    # "With that, she goes inside of her dorm building and I walk back to my car and drive away."
    "Bunun üzerine, o yurt binasına girer ve ben de arabama geri dönüp uzaklaşırım."

# game/Scenes/Micha/micha10.rpy:196
translate turkish micha10kiss_de8a7413:

    # "Maybe Mi-Cha and I will only get the rest of the semester together, but we'll be sure to make it count."
    "Belki Mi-Cha ile sadece bu dönemin geri kalanını birlikte geçirebileceğiz, ama bunu en iyi şekilde değerlendireceğiz."

translate turkish strings:

    # game/Scenes/Micha/micha10.rpy:3
    old "Take Mi-Cha on more dates by calling her in the evening. Eventually she will ask you to walk her back to her dorm after one."
    new "Akşamları Mi-Cha’yı arayarak onunla daha fazla randevuya çık. Eninde sonunda saat birden sonra seni yurtuna kadar eşlik etmeni isteyecektir."

    # game/Scenes/Micha/micha10.rpy:4
    old "Take your opportunity and kiss her when the moment arises."
    new "Fırsatını değerlendir ve doğru an geldiğinde onu öp."

    # game/Scenes/Micha/micha10.rpy:88
    old "That sucks, because I really like you"
    new "Bu çok kötü, çünkü senden gerçekten hoşlanıyorum"

    # game/Scenes/Micha/micha10.rpy:90
    old "I guess we're just temporary friends then, huh?"
    new "O zaman sanırım sadece geçici arkadaşız, değil mi?"

    # game/Scenes/Micha/micha10.rpy:172
    old "Tell her good night"
    new "Ona iyi geceler de"

