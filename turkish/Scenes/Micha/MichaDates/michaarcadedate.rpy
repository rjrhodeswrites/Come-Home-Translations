# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:100
translate turkish michaarcadestartdate_a3d2a74a:

    # mc "Will you dance with me?"
    mc "Benimle dans eder misin?"

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:101
translate turkish michaarcadestartdate_de472e37:

    # pc "Sure, let's do it."
    pc "Tabii, hadi yapalım."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:108
translate turkish michaarcadestartdate_66e81d3f:

    # "We dance for a while, working up a sweat. She's really good at it."
    "Bir süre dans ediyoruz, terliyoruz. O bu işte gerçekten çok iyi."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:109
translate turkish michaarcadestartdate_6516c14c:

    # "And I am not so good."
    "Ben ise pek iyi değilim."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:110
translate turkish michaarcadestartdate_17fc8197:

    # "But I try to keep up, while sneaking glances at her moves when I'm able."
    "Ama elimden geldiğince onun hareketlerine gizlice bakarak ona ayak uydurmaya çalışıyorum."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:111
translate turkish michaarcadestartdate_89687eae:

    # "Damn she moves so fucking sexy."
    "Vay canına, hareketleri çok seksi."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:113
translate turkish michaarcadestartdate_1df83f78:

    # "We dance for a while, working up a sweat."
    "Bir süre dans ediyoruz, terliyoruz."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:114
translate turkish michaarcadestartdate_93d87356:

    # "I can barely take my eyes off her."
    "Gözlerimi ondan zar zor ayırabiliyorum."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:119
translate turkish michaarcadestartdate_17d62fc5:

    # "After a few songs, we take a break, catch our breath and chat for a while."
    "Birkaç şarkıdan sonra ara verip nefesimizi toplayıyoruz ve bir süre sohbet ediyoruz."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:127
translate turkish michaarcadestartdate_e717916b:

    # mc "Want to dance a little more?"
    mc "Biraz daha dans etmek ister misin?"

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:128
translate turkish michaarcadestartdate_61f77a4c:

    # pc "Sure."
    pc "Tabii."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:134
translate turkish michaarcadestartdate_cba53581:

    # "We dance for a while longer, until I'm so tired, I can barely move."
    "Yorgunluktan zar zor hareket edebilecek hale gelene kadar biraz daha dans ediyoruz."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:135
translate turkish michaarcadestartdate_66adc21b:

    # "But it's worth it to see her having so much fun."
    "Ama onun bu kadar eğlendiğini görmek buna değer."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:143
translate turkish michaarcadestartdate_6c3d27ae:

    # "After a while, we leave together and I drive her back to the dorms."
    "Bir süre sonra birlikte çıkıyoruz ve onu yurtlara geri götürüyorum."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:144
translate turkish michaarcadestartdate_fdab3f40:

    # mc "Would you come inside and spend some time with me?"
    mc "İçeri gelip benimle biraz vakit geçirir misin?"

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:149
translate turkish michaarcadestartdate_bc4fd44d:

    # mc "Oh, okay."
    mc "Oh, tamam."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:150
translate turkish michaarcadestartdate_c5fbc007:

    # mc "Thank you for taking me out. I had a very nice time."
    mc "Beni dışarı çıkardığın için teşekkür ederim. Çok güzel vakit geçirdim."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:151
translate turkish michaarcadestartdate_5794bc3e:

    # pc "You're welcome. I'll see you later, Mi-Cha."
    pc "Rica ederim. Görüşürüz Mi-Cha."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:152
translate turkish michaarcadestartdate_3fb698eb:

    # mc "Goodbye, [pcname]."
    mc "Hoşça kal [pcname]."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:155
translate turkish michaarcadestartdate_16c2a7fe:

    # "She gets out of the car and walks off towards her dorms."
    "Arabadan iner ve yurt binasına doğru yürür."

