# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:73
translate turkish michaarcadestartdate_d71db8c3:

    # "Manager" "There's only a couple of games over there, but there is a DDR machine."
    "Manager" "Orada sadece birkaç oyun var, ama bir DDR makinesi var."

