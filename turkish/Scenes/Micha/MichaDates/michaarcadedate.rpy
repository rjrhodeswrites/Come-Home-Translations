    pc "Burada hiç görmedim..."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:69
translate turkish michaarcadestartdate_18b5b9c6:

    # "The manager of the place, who I didn't even see standing nearby, speaks up."
    "Yanımda durduğunu bile fark etmediğim mekanın müdürü konuşmaya başlıyor."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:70
translate turkish michaarcadestartdate_e919c4ea:

    # "Manager" "There's a DDR machine in the side room over there."
    "Manager" "Şuradaki yan odada bir DDR makinesi var."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:71
translate turkish michaarcadestartdate_e9ad6056:

    # pc "There's a side room?"
    pc "Yan oda mı var?"

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:72
