translate turkish michaarcadestartdate_85cb4a47:

    # "I drive over to Mi-Cha's dorm to pick her up, then we go out to the arcade."
    "Mi-Cha’yı almak için yurtuna arabayla gidiyorum, sonra oyun salonuna gidiyoruz."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:64
