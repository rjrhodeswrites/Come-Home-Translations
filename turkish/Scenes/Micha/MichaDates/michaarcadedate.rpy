    # mc "Oh, wow. This is so cool."
    mc "Vay canına. Burası çok havalı."

# game/Scenes/Micha/MichaDates/michaarcadedate.rpy:65
translate turkish michaarcadestartdate_166917a4:

    # mc "Do you think they have Dance Dance Revolution?"
