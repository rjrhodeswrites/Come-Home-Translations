# game/Scenes/Micha/micha13.rpy:10
translate turkish micha13_66a911ed:

    # "When I get to the counselor's office, I'm surprised to see Gertrude behind the counter instead of Mi-Cha."
    "Danışmanlık ofisine vardığımda, Mi-Cha yerine Gertrude'u masanın arkasında görünce şaşırıyorum."

# game/Scenes/Micha/micha13.rpy:11
translate turkish micha13_51f359cb:

    # sc "Good morning, [pcname]. If you're here for a counseling session, I'm sorry. I have to work reception today."
    sc "Günaydın, [pcname]. Danışmanlık seansı için geldiysen üzgünüm. Bugün resepsiyonda çalışmam gerekiyor."

# game/Scenes/Micha/micha13.rpy:12
translate turkish micha13_320f7ecc:

    # pc "Where's Mi-Cha?"
    pc "Mi-Cha nerede?"

# game/Scenes/Micha/micha13.rpy:13
translate turkish micha13_f822911c:

    # sc "She called this morning saying she couldn't come in for some reason. She sounded upset."
    sc "Bu sabah bir nedenden dolayı gelemeyeceğini söyleyerek aradı. Sesi üzgün geliyordu."

# game/Scenes/Micha/micha13.rpy:14
translate turkish micha13_d6ed663d:

    # sc "If you have time, maybe you could go check on her? I know you two have become friends."
    sc "Vaktin varsa, belki ona bir bakmaya gidebilirsin? İkinizin arkadaş olduğunuzu biliyorum."

# game/Scenes/Micha/micha13.rpy:15
translate turkish micha13_477e82cd:

    # pc "Yeah, I think I have a little time before class. I'll go do that."
    pc "Evet, dersim başlamadan önce biraz vaktim var sanırım. Gidip bakayım."

# game/Scenes/Micha/micha13.rpy:18
translate turkish micha13_cfda0a84:

    # "I leave the counselor's office, walk over to the dorms, and make my way up to Mi-Cha's door."
    "Danışmanlık odasından çıkıp yurtlara doğru yürüyorum ve Mi-Cha’nın kapısına doğru ilerliyorum."

# game/Scenes/Micha/micha13.rpy:22
translate turkish micha13_90464c94:

    # "She answers after a couple of knocks."
    "Birkaç kez kapıyı çaldıktan sonra kapıyı açıyor."

# game/Scenes/Micha/micha13.rpy:23
translate turkish micha13_94a711d9:

    # mc "Oh, [pcname]! Why are you here?"
    mc "Oh, [pcname]! Neden buradasın?"

# game/Scenes/Micha/micha13.rpy:24
translate turkish micha13_36eedc65:

    # pc "Gertrude asked me to come check on you. She said you called in. Are you sick?"
    pc "Gertrude seni kontrol etmemi istedi. Aradığını söyledi. Hasta mısın?"

# game/Scenes/Micha/micha13.rpy:25
translate turkish micha13_2e46b23a:

    # mc "No, I'm not sick."
    mc "Hayır, hasta değilim."

# game/Scenes/Micha/micha13.rpy:26
translate turkish micha13_cb45e08c:

    # pc "Well, what's going on?"
    pc "Peki, ne oluyor?"

# game/Scenes/Micha/micha13.rpy:29
translate turkish micha13_98c909b0:

    # "I follow her inside and we sit on her bed."
    "Onun peşinden içeri giriyorum ve yatağına oturuyoruz."

# game/Scenes/Micha/micha13.rpy:30
translate turkish micha13_2f43efba:

    # mc "I argued with my parents last night. They told me to quit dance class. They say that it interferes with my studies."
    mc "Dün gece ailemle tartıştım. Dans dersini bırakmamı söylediler. Derslerimi aksattığını söylüyorlar."

# game/Scenes/Micha/micha13.rpy:31
translate turkish micha13_6282a1b7:

    # pc "But you like dancing."
    pc "Ama dans etmeyi seviyorsun."

# game/Scenes/Micha/micha13.rpy:34
translate turkish micha13_44899e27:

    # mc "I love dancing. And I have a performance soon that I was very much looking forward to."
    mc "Dans etmeyi çok seviyorum. Ve çok heyecanla beklediğim bir gösterim yakında var."

# game/Scenes/Micha/micha13.rpy:35
translate turkish micha13_4624f9be:

    # mc "But they say that I have to stop."
    mc "Ama dansı bırakmam gerektiğini söylüyorlar."

# game/Scenes/Micha/micha13.rpy:36
translate turkish micha13_ff3c6bab:

    # pc "So what?"
    pc "Ne olmuş yani?"

# game/Scenes/Micha/micha13.rpy:37
translate turkish micha13_f0ac6ad2:

    # mc "I can't just not do what they say."
    mc "Onların dediklerini yapmamak gibi bir seçeneğim yok."

# game/Scenes/Micha/micha13.rpy:40
translate turkish micha13_23d549c1:

    # pc "But I want you to dance."
    pc "Ama ben senin dans etmeni istiyorum."

# game/Scenes/Micha/micha13.rpy:41
translate turkish micha13_81709362:

    # mc "You do?"
    mc "Öyle mi?"

# game/Scenes/Micha/micha13.rpy:42
translate turkish micha13_6dba6230:

    # pc "Yes."
    pc "Evet."

# game/Scenes/Micha/micha13.rpy:43
translate turkish micha13_27a4c741:

    # mc "Are you telling me to?"
    mc "Bana dans etmemi mi söylüyorsun?"

# game/Scenes/Micha/micha13.rpy:44
translate turkish micha13_f43da382:

    # pc "Yes, Mi-Cha. I'm telling you to dance."
    pc "Evet, Mi-Cha. Sana dans etmeni söylüyorum."

# game/Scenes/Micha/micha13.rpy:49
translate turkish micha13_d41d8cd9:

    # voice 'voices/micha_yessir.mp3'
    voice 'voices/micha_yessir.mp3'

# game/Scenes/Micha/micha13.rpy:50
translate turkish micha13_620baac7:

    # mc "Yes, [mcsir]."
    mc "Evet, [mcsir]."

# game/Scenes/Micha/micha13.rpy:51
translate turkish micha13_929f424d:

    # pc "So you will?"
    pc "Yani dans edeceksin?"

# game/Scenes/Micha/micha13.rpy:54
translate turkish micha13_d41d8cd9_1:

    # voice 'voices/micha_yessir.mp3'
    voice 'voices/micha_yessir.mp3'

# game/Scenes/Micha/micha13.rpy:55
translate turkish micha13_620baac7_1:

    # mc "Yes, [mcsir]."
    mc "Evet, [mcsir]."

# game/Scenes/Micha/micha13.rpy:56
translate turkish micha13_536da0ad:

    # mc "I will keep dancing. For you."
    mc "Dans etmeye devam edeceğim. Senin için."

# game/Scenes/Micha/micha13.rpy:57
translate turkish micha13_f07574ec:

    # pc "Good."
    pc "Güzel."

# game/Scenes/Micha/micha13.rpy:61
translate turkish micha13_d41d8cd9_2:

    # voice 'voices/micha_thankyou1.mp3'
    voice 'voices/micha_thankyou1.mp3'

# game/Scenes/Micha/micha13.rpy:62
translate turkish micha13_5b61e929:

    # mc "Thank you, [pcname]."
    mc "Teşekkür ederim, [pcname]."

# game/Scenes/Micha/micha13.rpy:63
translate turkish micha13_e3b6df4e:

    # pc "Do you feel better now?"
    pc "Şimdi daha iyi hissediyor musun?"

# game/Scenes/Micha/micha13.rpy:64
translate turkish micha13_c324b928:

    # mc "Yes. I feel much better now."
    mc "Evet. Şimdi çok daha iyi hissediyorum."

# game/Scenes/Micha/micha13.rpy:65
translate turkish micha13_63023601:

    # pc "Okay."
    pc "Tamam."

# game/Scenes/Micha/micha13.rpy:66
translate turkish micha13_c98760d6:

    # mc "I'll get dressed and go to the office."
    mc "Giyinip ofise gideceğim."

# game/Scenes/Micha/micha13.rpy:70
translate turkish micha13_d41d8cd9_3:

    # voice 'voices/micha_imsorry2.mp3'
    voice 'voices/micha_imsorry2.mp3'

# game/Scenes/Micha/micha13.rpy:71
translate turkish micha13_5fbcf7dd:

    # mc "I'm sorry you had to see me like this. In my pajamas with no makeup."
    mc "Beni bu halde görmek zorunda kaldığın için üzgünüm. Pijamalarımla, makyajsız."

# game/Scenes/Micha/micha13.rpy:72
translate turkish micha13_57c13e1f:

    # pc "Don't be silly. You're gorgeous."
    pc "Saçmalama. Harikasın."

# game/Scenes/Micha/micha13.rpy:75
translate turkish micha13_d41d8cd9_4:

    # voice 'voices/micha_thankyousir2.mp3'
    voice 'voices/micha_thankyousir2.mp3'

# game/Scenes/Micha/micha13.rpy:76
translate turkish micha13_b00529b9:

    # mc "Thank you, [mcsir]."
    mc "Teşekkür ederim, [mcsir]."

# game/Scenes/Micha/micha13.rpy:79
translate turkish micha13_80adb898:

    # "I kiss her goodbye."
    "Ona veda öpücüğü veriyorum."

# game/Scenes/Micha/micha13.rpy:80
translate turkish micha13_bed52260:

    # "If I had time, I'd do more."
    "Zamanım olsaydı, daha fazlasını yapardım."

# game/Scenes/Micha/micha13.rpy:83
translate turkish micha13_1a383b4b:

    # "But I have to get to class, so we pull apart and I tell her goodbye."
    "Ama derse gitmem gerekiyor, bu yüzden birbirimizden ayrılıyoruz ve ona veda ediyorum."

