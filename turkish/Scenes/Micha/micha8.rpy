    # "Before I go to Gertrude's office, Mi-Cha stops me in the lobby."
    "Gertrude’un ofisine gitmeden önce, Mi-Cha beni lobide durdurur."

# game/Scenes/Micha/micha8.rpy:15
translate turkish micha8_ed6bde86:

    # mc "Hello, [pcname]."
    mc "Merhaba, [pcname]."

# game/Scenes/Micha/micha8.rpy:16
translate turkish micha8_f481dcaa:

    # pc "Hi, Mi-Cha. How are you?"
    pc "Merhaba, Mi-Cha. Nasılsın?"

# game/Scenes/Micha/micha8.rpy:17
translate turkish micha8_72cb11f5:

    # mc "I am good, thank you."
    mc "İyiyim, teşekkürler."

# game/Scenes/Micha/micha8.rpy:19
translate turkish micha8_bdbd1fa8:

    # mc "I want to tell you that I enjoyed our coffee date."
    mc "Kahve randevumuzdan keyif aldığımı söylemek istedim."

# game/Scenes/Micha/micha8.rpy:20
translate turkish micha8_8a7120da:

    # mc "I apologize for rushing off early and would like to again another sometime."
    mc "Erken ayrıldığım için özür dilerim ve bir ara tekrar buluşmak isterim."

# game/Scenes/Micha/micha8.rpy:21
translate turkish micha8_3171636b:

    # mc "If you would like to this evening?"
    mc "Bu akşam ne dersin?"

# game/Scenes/Micha/micha8.rpy:25
translate turkish micha8_2d186b97:

    # mc "Good. I will meet you in the Skyhill Cafe this evening then."
    mc "Tamam. O zaman bu akşam Skyhill Cafe'de buluşuruz."

# game/Scenes/Micha/micha8.rpy:29
translate turkish micha8_2f88594e:

    # mc "Oh. Okay. Yes, I'm sure you're busy."
    mc "Oh. Tamam. Evet, eminim meşgulsündür."

# game/Scenes/Micha/micha8.rpy:31
translate turkish micha8_08d0510d:

    # mc "Enjoy your visit with Mrs. Spann."
    mc "Bayan Spann ile geçireceğin zamanın tadını çıkar."

# game/Scenes/Micha/micha8.rpy:32
translate turkish micha8_32a03447:

    # pc "Okay. I'll see you later, Mi-Cha."
    pc "Tamam. Görüşürüz Mi-Cha."

