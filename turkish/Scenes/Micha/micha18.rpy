# game/Scenes/Micha/micha18.rpy:15
translate turkish micha18_688d0c7f:

    # "My phone starts buzzing in my pocket. I check and see that Mi-Cha is calling."
    "Cebimdeki telefonum titremeye başlıyor. Bakıyorum ve Mi-Cha'nın aradığını görüyorum."

# game/Scenes/Micha/micha18.rpy:20
translate turkish micha18_3f3890ee:

    # pc "Hey, Mi-Cha. How are you doing?"
    pc "Selam Mi-Cha. Nasılsın?"

# game/Scenes/Micha/micha18.rpy:21
translate turkish micha18_871ef5af:

    # mc "I am feeling very nervous, but also excited."
    mc "Çok gerginim ama aynı zamanda heyecanlıyım da."

# game/Scenes/Micha/micha18.rpy:22
translate turkish micha18_e61255db:

    # pc "About what?"
    pc "Ne konuda?"

# game/Scenes/Micha/micha18.rpy:24
translate turkish micha18_0366f1bc:

    # mc "My dance performance is tonight. Will you come?"
    mc "Bu akşam dans gösterim var. Gelir misin?"

# game/Scenes/Micha/micha18.rpy:25
translate turkish micha18_33cc462a:

    # pc "What? Of course! Why didn't you tell me already? I didn't know it was tonight!"
    pc "Ne? Tabii ki! Neden daha önce söylemedin ki? Bu akşam olduğunu bilmiyordum!"

# game/Scenes/Micha/micha18.rpy:27
translate turkish micha18_b360fd8d:

    # mc "I'm sorry, [mcsir]."
    mc "Üzgünüm, [mcsir]."

# game/Scenes/Micha/micha18.rpy:28
translate turkish micha18_c2363c70:

    # mc "I have been shy to talk about it."
    mc "Bu konuyu konuşmaya çekiniyordum."

# game/Scenes/Micha/micha18.rpy:30
translate turkish micha18_a4fac60b:

    # mc "It is only a small performance. Nothing to get excited about."
    mc "Sadece küçük bir gösteri. Heyecanlanacak bir şey yok."

# game/Scenes/Micha/micha18.rpy:32
translate turkish micha18_0bb075ff:

    # pc "That's nonsense! You should be excited about it!"
    pc "Saçmalık! Bunun için heyecanlanmalısın!"

# game/Scenes/Micha/micha18.rpy:33
translate turkish micha18_16694b2f:

    # pc "I'm really happy for you and I'll be in the audience supporting you."
    pc "Senin adına gerçekten çok mutluyum ve seni desteklemek için seyirciler arasında olacağım."

# game/Scenes/Micha/micha18.rpy:35
translate turkish micha18_7c591fc4:

    # mc "Okay. I am happy that you will be there."
    mc "Tamam. Orada olacağına sevindim."

# game/Scenes/Micha/micha18.rpy:36
translate turkish micha18_5f7f4323:

    # mc "It is at 7pm on the school's stage."
    mc "Saat 19:00'da okulun sahnesinde."

# game/Scenes/Micha/micha18.rpy:37
translate turkish micha18_9d74725b:

    # pc "I'll be there. As close as I can get to the front row."
    pc "Orada olacağım. Mümkün olduğunca ön sıraya yakın bir yerde."

# game/Scenes/Micha/micha18.rpy:39
translate turkish micha18_02124621:

    # mc "Thank you, [pcname]. I will see you there."
    mc "Teşekkürler, [pcname]. Orada görüşürüz."

# game/Scenes/Micha/micha18.rpy:42
translate turkish micha18_25a2f290:

    # "We say our goodbyes, then later that evening, I drive to the school to watch her performance."
    "Vedalaştık, sonra o akşamın ilerleyen saatlerinde, onun gösterisini izlemek için okula arabayla gittim."

# game/Scenes/Micha/micha18.rpy:45
translate turkish micha18_ebb5885b:

    # "I show up a little early and am able to get a front row seat. There's a few other people in the audience, but it's pretty empty."
    "Biraz erken vardım ve ön sıradan bir koltuk bulabildim. Seyirciler arasında birkaç kişi daha vardı, ama salon oldukça boştu."

# game/Scenes/Micha/micha18.rpy:48
translate turkish micha18_9b44beaa:

    # "A few minutes later, Gertrude comes in and smiles at me."
    "Birkaç dakika sonra Gertrude içeri girdi ve bana gülümsedi."

# game/Scenes/Micha/micha18.rpy:49
translate turkish micha18_734ac2ed:

    # sc "Hey, [pcname]. I didn't expect to see you here. I've never seen you at any of the other performances."
    sc "Selam, [pcname]. Seni burada görmeyi beklemiyordum. Diğer gösterilerin hiçbirinde seni görmemiştim."

# game/Scenes/Micha/micha18.rpy:50
translate turkish micha18_c2b482c4:

    # pc "Oh, I'm here to support Mi-Cha."
    pc "Ah, Mi-Cha’ya destek olmak için geldim."

# game/Scenes/Micha/micha18.rpy:51
translate turkish micha18_6fc91d73:

    # sc "That's nice of you. I'm looking forward to seeing her perform."
    sc "Çok naziksin. Onun performansını izlemeyi sabırsızlıkla bekliyorum."

# game/Scenes/Micha/micha18.rpy:52
translate turkish micha18_0d7c2170:

    # sc "Do you mind if I sit next to you?"
    sc "Yanına oturabilir miyim?"

# game/Scenes/Micha/micha18.rpy:53
translate turkish micha18_6912ead3:

    # pc "Not at all."
    pc "Tabii ki."

# game/Scenes/Micha/micha18.rpy:57
translate turkish micha18_618925b1:

    # sc "So are you two dating now?"
    sc "Peki, siz ikiniz çıkıyor musunuz?"

# game/Scenes/Micha/micha18.rpy:58
translate turkish micha18_f78d20fe:

    # pc "Yeah, we've been seeing each other a bit."
    pc "Evet, bir süredir görüşüyoruz."

# game/Scenes/Micha/micha18.rpy:59
translate turkish micha18_5ab35b8c:

    # sc "That's great!"
    sc "Harika!"

# game/Scenes/Micha/micha18.rpy:60
translate turkish micha18_a0b30b82:

    # sc "How serious is it between you two?"
    sc "İlişkiniz ne kadar ciddi?"

# game/Scenes/Micha/micha18.rpy:61
translate turkish micha18_b8162d87:

    # pc "Oh I don't know... I think she's great and I like spending time with her."
    pc "Bilemiyorum... Bence o harika biri ve onunla vakit geçirmeyi seviyorum."

# game/Scenes/Micha/micha18.rpy:63
translate turkish micha18_8094ff46:

    # sc "We both know she's not the only one you're seeing though..."
    sc "Ama ikimiz de biliyoruz ki görüştüğün tek kişi o değil..."

# game/Scenes/Micha/micha18.rpy:64
translate turkish micha18_c417e350:

    # pc "Yeah."
    pc "Evet."

# game/Scenes/Micha/micha18.rpy:65
translate turkish micha18_eda2d229:

    # sc "Just be careful with her. She's a little naive."
    sc "Ona karşı dikkatli ol. Biraz saf bir kız."

# game/Scenes/Micha/micha18.rpy:66
translate turkish micha18_11144671:

    # sc "Don't hurt her, okay?"
    sc "Onu incitme, tamam mı?"

# game/Scenes/Micha/micha18.rpy:67
translate turkish micha18_dd9a629d:

    # pc "I won't."
    pc "İncitmem."

# game/Scenes/Micha/micha18.rpy:70
translate turkish micha18_0a52de10:

    # "As time grows closer to the start of the show, the seats begin to fill up more."
    "Gösterinin başlama saati yaklaştıkça koltuklar giderek dolmaya başlıyor."

# game/Scenes/Micha/micha18.rpy:73
translate turkish micha18_14f8d7ae:

    # "I see Ms. Welch walk in and sit down."
    "Bayan Welch’in içeri girip oturduğunu görüyorum."

# game/Scenes/Micha/micha18.rpy:77
translate turkish micha18_5868bd91:

    # "She spots me and gives me a wave and a wink."
    "Beni fark ediyor, el sallayıp göz kırpıyor."

# game/Scenes/Micha/micha18.rpy:80
translate turkish micha18_f6954d22:

    # "Then I look over and see Mrs. McGee sitting as well."
    "Sonra başımı çevirip Bayan McGee’nin de oturduğunu görüyorum."

# game/Scenes/Micha/micha18.rpy:81
translate turkish micha18_e5a0cf64:

    # "It's more people than I expected to see."
    "Beklediğimden daha fazla insan var."

# game/Scenes/Micha/micha18.rpy:85
translate turkish micha18_f05e2763:

    # "She and Pete both smile and wave at me."
    "O ve Pete ikisi de bana gülümsüyor ve el sallıyor."

# game/Scenes/Micha/micha18.rpy:89
translate turkish micha18_29bbeb02:

    # "Then the lights dim, a spotlight shines on the stage, and music begins to play."
    "Sonra ışıklar sönüyor, sahneye bir spot ışığı vuruyor ve müzik çalmaya başlıyor."

# game/Scenes/Micha/micha18.rpy:92
translate turkish micha18_16e9fa91:

    # "The curtains open and the ballet starts."
    "Perdeler açılıyor ve bale başlıyor."

# game/Scenes/Micha/micha18.rpy:93
translate turkish micha18_5069de6b:

    # "I'm not really sure what is happening, but everybody on stage moves in a well-choreographed dance along with the music."
    "Tam olarak ne olduğunu anlamıyorum ama sahnedeki herkes müziğe uyumlu, iyi koreografili bir dansla hareket ediyor."

# game/Scenes/Micha/micha18.rpy:94
translate turkish micha18_e615adbc:

    # "Everybody else seems to fade into the background as my eyes lock onto Mi-Cha, though."
    "Gözlerim Mi-Cha’ya kilitlendiğinde ise diğer herkes arka planda kayboluyor gibi görünüyor."

# game/Scenes/Micha/micha18.rpy:95
translate turkish micha18_f7a5d1fe:

    # "She's gorgeous in her costume and her movements are almost hypnotizing in their beauty."
    "Kostümüyle muhteşem görünüyor ve hareketlerinin güzelliği adeta hipnotize edici."

# game/Scenes/Micha/micha18.rpy:98
translate turkish micha18_9d2a99c2:

    # "One of the male dancers spins her, then lifts her up like she's flying."
    "Erkek dansçılardan biri onu döndürüyor, sonra sanki uçuyormuş gibi havaya kaldırıyor."

# game/Scenes/Micha/micha18.rpy:101
translate turkish micha18_b95ea171:

    # "Amazingly, she doesn't look nervous at all."
    "Şaşırtıcı bir şekilde, hiç de gergin görünmüyor."

# game/Scenes/Micha/micha18.rpy:102
translate turkish micha18_728386fb:

    # "Her usual self-conscious and timid attitude is gone, as if she's in her own world and none of us are even here."
    "Her zamanki utangaç ve çekingen tavrı yok olmuş, sanki kendi dünyasında ve biz hiç burada değilmişiz gibi."

# game/Scenes/Micha/micha18.rpy:105
translate turkish micha18_ffb4c520:

    # "Part of the way through the performance - I've long lost the story by now - the lights dim once again and only Mi-Cha is illuminated."
    "Gösterinin bir noktasında – bu arada ben hikayeyi çoktan unutmuşumdur – ışıklar bir kez daha sönüyor ve sadece Mi-Cha aydınlatılıyor."

# game/Scenes/Micha/micha18.rpy:106
translate turkish micha18_ee38e730:

    # "The rest of the cast falls back into the shadows and all eyes are on her."
    "Diğer oyuncular gölgelere çekiliyor ve tüm gözler ona çevriliyor."

# game/Scenes/Micha/micha18.rpy:110
translate turkish micha18_235a0510:

    # "And she dances."
    "Ve o dans ediyor."

# game/Scenes/Micha/micha18.rpy:111
translate turkish micha18_af3cfdb9:

    # "I'm sure her dance is telling the story of her character in the ballet, but I feel like it's telling Mi-Cha's story as well."
    "Eminim dansı, baledeki karakterinin hikayesini anlatıyor, ama bana sanki Mi-Cha’nın hikayesini de anlatıyormuş gibi geliyor."

# game/Scenes/Micha/micha18.rpy:112
translate turkish micha18_b3efe8d7:

    # "I feel like I can see right through to her heart. She's wearing clothes, but she is also naked, baring her soul."
    "Sanki kalbinin derinliklerine kadar görebiliyorum. Üzerinde kıyafetler var, ama aynı zamanda çıplak, ruhunu ortaya koyuyor."

# game/Scenes/Micha/micha18.rpy:113
translate turkish micha18_cd9f512f:

    # "There's only been a couple of times where I've felt like Mi-Cha has been completely free and uninhibited - when she's dancing, and when we're fucking."
    "Mi-Cha’nın tamamen özgür ve sınır tanımaz olduğunu hissettiğim sadece birkaç an oldu – dans ederken ve sevişirken."

# game/Scenes/Micha/micha18.rpy:114
translate turkish micha18_9b3a0aea:

    # "In both cases, she's absolutely beautiful."
    "Her iki durumda da, o kesinlikle çok güzel."

# game/Scenes/Micha/micha18.rpy:120
translate turkish micha18_abeb9237:

    # "When the show is over, the whole crowd stands up and applauds."
    "Gösteri bittiğinde, tüm seyirciler ayağa kalkıp alkışlıyor."

# game/Scenes/Micha/micha18.rpy:121
translate turkish micha18_aca55a3d:

    # "I'm just so happy that everybody can see how amazing Mi-Cha is."
    "Herkesin Mi-Cha’nın ne kadar muhteşem olduğunu görebilmesine çok seviniyorum."

# game/Scenes/Micha/micha18.rpy:124
translate turkish micha18_f1614496:

    # sc "Wow, that was incredible. She is so talented!"
    sc "Vay canına, bu inanılmazdı. O çok yetenekli!"

# game/Scenes/Micha/micha18.rpy:125
translate turkish micha18_6c11c780:

    # pc "Yeah. I'm going to go find her."
    pc "Evet. Gidip onu bulacağım."

# game/Scenes/Micha/micha18.rpy:126
translate turkish micha18_9b70b49a:

    # sc "Okay. You two have a good night."
    sc "Tamam. İkinize de iyi geceler."

# game/Scenes/Micha/micha18.rpy:130
translate turkish micha18_72d6b54c:

    # "I look backstage, but the cast tells me that she's already left."
    "Sahne arkasına bakıyorum, ama ekip bana onun çoktan ayrıldığını söylüyor."

# game/Scenes/Micha/micha18.rpy:131
translate turkish micha18_d18e5603:

    # "So I rush out towards her dorm, looking for her."
    "Ben de onu aramak için yurt binasına doğru koşuyorum."

# game/Scenes/Micha/micha18.rpy:134
translate turkish micha18_9cd32c90:

    # "When I find her, she's sitting on the bench outside her dorm, sobbing into her hands."
    "Onu bulduğumda, yurt binasının dışındaki bankta oturmuş, ellerinin arasına gömülmüş hıçkırarak ağlıyor."

# game/Scenes/Micha/micha18.rpy:135
translate turkish micha18_0003d575:

    # pc "Hey, what's wrong? Are you okay?"
    pc "Hey, ne oldu? İyi misin?"

# game/Scenes/Micha/micha18.rpy:137
translate turkish micha18_d41d8cd9:

    # voice 'voices/micha_18_1.mp3'
    voice 'voices/micha_18_1.mp3'

# game/Scenes/Micha/micha18.rpy:138
translate turkish micha18_918fea83:

    # mc "I'm sorry."
    mc "Üzgünüm."

# game/Scenes/Micha/micha18.rpy:141
translate turkish micha18_2db90f14:

    # pc "What's wrong? You were amazing. They all loved you."
    pc "Ne oldu ki? Harikaydın. Herkes seni çok sevdi."

# game/Scenes/Micha/micha18.rpy:143
translate turkish micha18_d41d8cd9_1:

    # voice 'voices/micha_18_2.mp3'
    voice 'voices/micha_18_2.mp3'

# game/Scenes/Micha/micha18.rpy:144
translate turkish micha18_cd855510:

    # mc "I don't want this to be over."
    mc "Bunun bitmesini istemiyorum."

# game/Scenes/Micha/micha18.rpy:146
translate turkish micha18_d41d8cd9_2:

    # voice 'voices/micha_18_3.mp3'
    voice 'voices/micha_18_3.mp3'

# game/Scenes/Micha/micha18.rpy:147
translate turkish micha18_b624d3b4:

    # mc "I have to go back home. No more dancing."
    mc "Eve dönmek zorundayım. Artık dans yok."

# game/Scenes/Micha/micha18.rpy:151
translate turkish micha18_d41d8cd9_3:

    # voice 'voices/micha_18_4.mp3'
    voice 'voices/micha_18_4.mp3'

# game/Scenes/Micha/micha18.rpy:152
translate turkish micha18_4a94d1aa:

    # mc "And no more of you."
    mc "Ve artık sen de yok."

# game/Scenes/Micha/micha18.rpy:154
translate turkish micha18_d41d8cd9_4:

    # voice 'voices/micha_18_5.mp3'
    voice 'voices/micha_18_5.mp3'

# game/Scenes/Micha/micha18.rpy:155
translate turkish micha18_b954ffce:

    # mc "I'm so happy. I don't want to leave."
    mc "Çok mutluyum. Ayrılmak istemiyorum."

# game/Scenes/Micha/micha18.rpy:158
translate turkish micha18_6d39e617:

    # "I hold her for a while. Squeezing her close until she stops crying."
    "Onu bir süre kucakladım. Ağlaması durana kadar ona sıkıca sarıldım."

# game/Scenes/Micha/micha18.rpy:159
translate turkish micha18_c40fa025:

    # pc "What if you just stay?"
    pc "Ya kalırsan?"

# game/Scenes/Micha/micha18.rpy:161
translate turkish micha18_d41d8cd9_5:

    # voice 'voices/micha_18_6.mp3'
    voice 'voices/micha_18_6.mp3'

# game/Scenes/Micha/micha18.rpy:162
translate turkish micha18_fe1e7b75:

    # mc "I can't. I'm only authorized until the end of the semester. If I stay longer, I will be illegal."
    mc "Kalamam. Sadece dönem sonuna kadar kalma iznim var. Daha uzun kalırsam, kaçak durumuna düşerim."

# game/Scenes/Micha/micha18.rpy:163
translate turkish micha18_dcbbb7ed:

    # pc "Yeah, I guess that's bad."
    pc "Evet, sanırım bu kötü olur."

# game/Scenes/Micha/micha18.rpy:166
translate turkish micha18_e22cecb4:

    # pc "Could you get your date extended?"
    pc "Kalma süreni uzatabilir misin?"

# game/Scenes/Micha/micha18.rpy:168
translate turkish micha18_d41d8cd9_6:

    # voice 'voices/micha_18_7.mp3'
    voice 'voices/micha_18_7.mp3'

# game/Scenes/Micha/micha18.rpy:169
translate turkish micha18_6be2096b:

    # mc "I don't know. I will talk to Mrs. Spann about it. She knows better than me."
    mc "Bilmiyorum. Bu konuyu Bayan Spann ile konuşacağım. O benden daha iyi bilir."

# game/Scenes/Micha/micha18.rpy:171
translate turkish micha18_d41d8cd9_7:

    # voice 'voices/micha_18_8.mp3'
    voice 'voices/micha_18_8.mp3'

# game/Scenes/Micha/micha18.rpy:172
translate turkish micha18_708ee42e:

    # mc "I think I have to have a reason to extend though."
    mc "Sanırım uzatma için bir nedenim olması gerekiyor."

# game/Scenes/Micha/micha18.rpy:174
translate turkish micha18_d41d8cd9_8:

    # voice 'voices/micha_18_9.mp3'
    voice 'voices/micha_18_9.mp3'

# game/Scenes/Micha/micha18.rpy:175
translate turkish micha18_d4d465f0:

    # mc "Like taking more school. Or marriage."
    mc "Mesela daha fazla ders almak gibi. Ya da evlilik."

# game/Scenes/Micha/micha18.rpy:179
translate turkish micha18_d41d8cd9_9:

    # voice 'voices/micha_18_10.mp3'
    voice 'voices/micha_18_10.mp3'

# game/Scenes/Micha/micha18.rpy:180
translate turkish micha18_1cf758a9:

    # mc "I'm sorry. I said I wouldn't mention it again, and I did."
    mc "Özür dilerim. Bundan bir daha bahsetmeyeceğimi söylemiştim, ama yine bahsettim."

# game/Scenes/Micha/micha18.rpy:182
translate turkish micha18_d41d8cd9_10:

    # voice 'voices/micha_18_11.mp3'
    voice 'voices/micha_18_11.mp3'

# game/Scenes/Micha/micha18.rpy:183
translate turkish micha18_d88ba6c6:

    # mc "I don't want to pressure you."
    mc "Sana baskı yapmak istemiyorum."

# game/Scenes/Micha/micha18.rpy:185
translate turkish micha18_d41d8cd9_11:

    # voice 'voices/micha_18_12.mp3'
    voice 'voices/micha_18_12.mp3'

# game/Scenes/Micha/micha18.rpy:186
translate turkish micha18_0a8cc307:

    # mc "I just love you so much."
    mc "Seni çok seviyorum."

# game/Scenes/Micha/micha18.rpy:189
translate turkish micha18_5735beae:

    # pc "I love you too, Mi-Cha."
    pc "Ben de seni seviyorum, Mi-Cha."

# game/Scenes/Micha/micha18.rpy:190
translate turkish micha18_83eef187:

    # pc "We'll figure this out, one way or another."
    pc "Bir şekilde bu sorunu çözeceğiz."

# game/Scenes/Micha/micha18.rpy:191
translate turkish micha18_39f98ad4:

    # pc "Everything will be okay."
    pc "Her şey yoluna girecek."

# game/Scenes/Micha/micha18.rpy:192
translate turkish micha18_2c147205:

    # pc "I just want you to keep dancing. I just want you to be happy."
    pc "Sadece dans etmeye devam etmeni istiyorum. Sadece mutlu olmanı istiyorum."

# game/Scenes/Micha/micha18.rpy:196
translate turkish micha18_d41d8cd9_12:

    # voice 'voices/micha_18_13.mp3'
    voice 'voices/micha_18_13.mp3'

# game/Scenes/Micha/micha18.rpy:197
translate turkish micha18_06801be0:

    # mc "I am. So happy."
    mc "Öyleyim. Çok mutluyum."

# game/Scenes/Micha/micha18.rpy:201
