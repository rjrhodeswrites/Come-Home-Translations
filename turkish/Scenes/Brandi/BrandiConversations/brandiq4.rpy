translate turkish brandiq4_a409a33e:

    # fd "My lease is up in August. I don't think I'll renew."
    fd "Kira sözleşmem Ağustos'ta bitiyor. Yenilemeyi düşünmüyorum."

# game/Scenes/Brandi/BrandiConversations/brandiq4.rpy:33
translate turkish brandiq4_260077f4:

