# game/Scenes/Brandi/BrandiConversations/brandis8.rpy:17
translate turkish brandis8_4aed897d:

    # fd "Not really."
    fd "Aslında pek değil."

# game/Scenes/Brandi/BrandiConversations/brandis8.rpy:19
translate turkish brandis8_62228593:

    # fd "It's actually something that I struggle with a lot."
    fd "Aslında bu konuda çok zorlanıyorum."

# game/Scenes/Brandi/BrandiConversations/brandis8.rpy:21
translate turkish brandis8_06850c03:

    # fd "I have people that I talk to online."
    fd "İnternette konuştuğum insanlar var."

# game/Scenes/Brandi/BrandiConversations/brandis8.rpy:22
translate turkish brandis8_b7bc1e50:

    # fd "I have my family."
    fd "Ailem var."

# game/Scenes/Brandi/BrandiConversations/brandis8.rpy:23
translate turkish brandis8_5c5a4a76:

    # fd "I have some friends on Facebook that I keep in touch with."
    fd "Facebook’ta iletişimde kaldığım bazı arkadaşlarım var."

# game/Scenes/Brandi/BrandiConversations/brandis8.rpy:25
translate turkish brandis8_c21a1991:

    # fd "And I have you, of course."
    fd "Ve tabii ki sen varsın."

# game/Scenes/Brandi/BrandiConversations/brandis8.rpy:27
translate turkish brandis8_b8faf66f:

    # fd "But I don't have any girlfriends that I can hang out with and open up to about things and share my feelings with."
    fd "Ama takılabileceğim, içimi dökebileceğim ve duygularımı paylaşabileceğim kız arkadaşlarım yok."

# game/Scenes/Brandi/BrandiConversations/brandis8.rpy:28
translate turkish brandis8_305d44ed:

    # fd "I get jealous and sad when I see people who have that."
    fd "Böyle arkadaşları olan insanları gördüğümde kıskanıyorum ve üzülüyorum."

# game/Scenes/Brandi/BrandiConversations/brandis8.rpy:30
translate turkish brandis8_6a821ea4:

    # fd "I just never have."
    fd "Hiç olmadı işte."

# game/Scenes/Brandi/BrandiConversations/brandis8.rpy:32
translate turkish brandis8_4ea0af15:

    # fd "As a kid, we moved around a lot, so I never had time to make really strong friendships."
    fd "Çocukken çok sık taşınırdık, o yüzden gerçekten sağlam arkadaşlıklar kuracak vaktim hiç olmadı."

# game/Scenes/Brandi/BrandiConversations/brandis8.rpy:34
translate turkish brandis8_22f38772:

    # fd "And as an adult..."
    fd "Ve yetişkin olarak..."

# game/Scenes/Brandi/BrandiConversations/brandis8.rpy:36
translate turkish brandis8_b1a92f8a:

    # fd "Well, it's just hard to meet people and make new friends."
    fd "Şey, insanlarla tanışmak ve yeni arkadaşlar edinmek zor oluyor."

# game/Scenes/Brandi/BrandiConversations/brandis8.rpy:37
translate turkish brandis8_87c60ffa:

    # pc "Yeah, I get that."
    pc "Evet, anlıyorum."

# game/Scenes/Brandi/BrandiConversations/brandis8.rpy:39
translate turkish brandis8_8be586e2:

    # fd "Really?"
    fd "Gerçekten mi?"

# game/Scenes/Brandi/BrandiConversations/brandis8.rpy:40
translate turkish brandis8_15164318:

    # fd "You seem like you make friends pretty easily."
    fd "Sen arkadaş edinmeyi oldukça kolay hallediyor gibi görünüyorsun."

# game/Scenes/Brandi/BrandiConversations/brandis8.rpy:41
translate turkish brandis8_11138f5a:

    # pc "Sometimes!"
    pc "Bazen!"

# game/Scenes/Brandi/BrandiConversations/brandis8.rpy:42
translate turkish brandis8_c494d1c0:

    # pc "You probably could too. Just invite strangers over to have burgers with you on camera."
    pc "Muhtemelen sen de yapabilirsin. Yabancıları kameranın önünde hamburger yemeye davet et yeter."

# game/Scenes/Brandi/BrandiConversations/brandis8.rpy:44
translate turkish brandis8_82a46137:

    # fd "Hey, if it works, it works!"
    fd "Hey, işe yarıyorsa, yarar!"

# game/Scenes/Brandi/BrandiConversations/brandis8.rpy:46
translate turkish brandis8_feb1083e:

    # fd "Seriously though, I've done that a couple of times before you and it didn't develop into anything."
    fd "Cidden ama, senden önce bunu birkaç kez denedim ama hiçbir şey çıkmadı."

# game/Scenes/Brandi/BrandiConversations/brandis8.rpy:48
translate turkish brandis8_dfb74cda:

    # fd "I'm really glad that it worked with you."
    fd "Seninle işe yaradığına gerçekten sevindim."

# game/Scenes/Brandi/BrandiConversations/brandis8.rpy:49
translate turkish brandis8_e01560e0:

    # pc "I'm glad too."
    pc "Ben de sevindim."

translate turkish strings:

    # game/Scenes/Brandi/BrandiConversations/brandis8.rpy:3
    old "To unlock this conversation, you need to have progressed far enough with her that you have gone to the ice cream parlor with her."
    new "Bu sohbeti açmak için, onunla dondurmacıya gidecek kadar ilerlemiş olman gerekiyor."

