    "Telefonum titremeye başlıyor."

# game/Scenes/Brandi/brandi2.rpy:15
translate turkish brandi2_801610c4:

    # "It's Brandi. I press accept and answer the phone."
    "Arayan Brandi. Kabul tuşuna basıp telefonu açıyorum."

# game/Scenes/Brandi/brandi2.rpy:17
translate turkish brandi2_bea5e8cb:

    # pc "Hello?"
    pc "Alo?"

# game/Scenes/Brandi/brandi2.rpy:20
translate turkish brandi2_d41d8cd9:

    # voice 'voices/brandi_hey2.mp3'
    voice 'voices/brandi_hey2.mp3'

# game/Scenes/Brandi/brandi2.rpy:21
translate turkish brandi2_5281a818:

    # fd "Hey, [pcname]."
    fd "Selam, [pcname]."

# game/Scenes/Brandi/brandi2.rpy:22
translate turkish brandi2_48df05b4:

    # fd "I was wondering if you wanted to go out for dinner with me tonight? My treat of course."
    fd "Acaba bu akşam benimle yemeğe çıkmak ister misin diye merak ediyordum? Tabii ki ben ısmarlıyorum."

# game/Scenes/Brandi/brandi2.rpy:23
translate turkish brandi2_95de9f02:

    # pc "You mean like a date?"
    pc "Yani bir randevu gibi mi?"

# game/Scenes/Brandi/brandi2.rpy:24
translate turkish brandi2_bc08406c:

    # fd "Well, yeah. Exactly like a date."
    fd "Evet, aynen öyle. Tam bir randevu gibi."

# game/Scenes/Brandi/brandi2.rpy:25
translate turkish brandi2_c14c8905:

    # fd "Except my laptop will be there too and I'll be livestreaming and a few hundred people will be watching us."
    fd "Tabii dizüstü bilgisayarım da orada olacak, canlı yayın yapacağım ve birkaç yüz kişi bizi izleyecek."

# game/Scenes/Brandi/brandi2.rpy:29
translate turkish brandi2_60b83ec3:

    # fd "Great!"
    fd "Harika!"

# game/Scenes/Brandi/brandi2.rpy:30
translate turkish brandi2_fcc3b2b6:

    # fd "You know Luigi's? The new Italian place? Could you meet me there?"
    fd "Luigi’s’i biliyor musun? Yeni açılan İtalyan restoranı? Orada buluşabilir miyiz?"

# game/Scenes/Brandi/brandi2.rpy:31
translate turkish brandi2_06cea6b3:

    # pc "I'm on my way."
    pc "Yola çıktım."

# game/Scenes/Brandi/brandi2.rpy:33
translate turkish brandi2_d41d8cd9_1:

    # voice 'voices/brandi_awesome2.mp3'
    voice 'voices/brandi_awesome2.mp3'

# game/Scenes/Brandi/brandi2.rpy:34
translate turkish brandi2_baf45d7c:

    # fd "Awesome. See you there!"
    fd "Süper. Orada görüşürüz!"

# game/Scenes/Brandi/brandi2.rpy:37
translate turkish brandi2_72628cc8:

    # fd "Aw dang."
    fd "Hay aksi."

# game/Scenes/Brandi/brandi2.rpy:38
translate turkish brandi2_23254083:

    # fd "Oh well, give me a call if you change your mind. I usually eat out most every night."
    fd "Neyse, fikrini değiştirirsen beni ara. Genelde her akşam dışarıda yemek yerim."

# game/Scenes/Brandi/brandi2.rpy:39
translate turkish brandi2_5d94ae2f:

    # fd "It's kind of my job."
    fd "Bu benim işim sayılır."

# game/Scenes/Brandi/brandi2.rpy:40
translate turkish brandi2_63023601:

    # pc "Okay."
    pc "Tamam."

# game/Scenes/Brandi/brandi2.rpy:41
translate turkish brandi2_21f428c4:

    # fd "See ya, [pcname]."
    fd "Görüşürüz, [pcname]."

# game/Scenes/Brandi/brandi2.rpy:42
translate turkish brandi2_fc0e4cb5:

    # "With that, she hangs up."
    "Bunun üzerine telefonu kapattı."

# game/Scenes/Brandi/brandi2.rpy:43
translate turkish brandi2_b0060369:

    # "She seems nice, but I'm not all that interested in dating her with the internet always watching."
    "Hoş birine benziyor, ama internetin sürekli izlediği bir ortamda onunla çıkmak pek ilgimi çekmiyor."

# game/Scenes/Brandi/brandi2.rpy:44
translate turkish brandi2_61234404:

    # "There are just other people I'd rather spend my time with."
    "Zamanımı birlikte geçirmeyi tercih edeceğim başka insanlar var."

# game/Scenes/Brandi/brandi2.rpy:54
translate turkish brandi2_7a261ee1:

    # "I pull up into the Luigi's parking lot and my phone buzzes again."
    "Luigi’nin otoparkına giriyorum ve telefonum yine titriyor."

# game/Scenes/Brandi/brandi2.rpy:61
translate turkish brandi2_763b14c3:

    # "Looks like she's already here. I head inside."
    "Görünüşe göre o çoktan buradaymış. İçeri giriyorum."

# game/Scenes/Brandi/brandi2.rpy:64
translate turkish brandi2_4bde4e1d:

    # "She must have been watching for me, because as soon as I walk in, she jumps up from her table and rushes over towards me."
    "Beni bekliyor olmalı, çünkü içeri girer girmez masasından fırlayıp bana doğru koşuyor."

# game/Scenes/Brandi/brandi2.rpy:67
translate turkish brandi2_d67052d1:

    # "Then she wraps her arms around me and pulls me into a hug."
    "Sonra kollarıyla beni sarmalıyor ve bana sarılıyor."

# game/Scenes/Brandi/brandi2.rpy:69
translate turkish brandi2_d41d8cd9_2:

    # voice 'voices/brandi_hey2.mp3'
    voice 'voices/brandi_hey2.mp3'

# game/Scenes/Brandi/brandi2.rpy:70
translate turkish brandi2_e3c46240:

    # fd "Hey, [pcname]. I'm so glad you came."
    fd "Selam, [pcname]. Geldiğine çok sevindim."

# game/Scenes/Brandi/brandi2.rpy:73
translate turkish brandi2_7623cc69:

    # fd "The chat is already excited to see our first date."
    fd "Sohbet odası ilk randevumuzu görmek için şimdiden heyecanlanmış durumda."

# game/Scenes/Brandi/brandi2.rpy:74
translate turkish brandi2_36036053:

    # fd "I know that this is a little weird having all those people watching us, but just pretend like they're not there okay?"
    fd "Biliyorum, bu kadar insanın bizi izlemesi biraz tuhaf, ama sanki orada değillermiş gibi davran, tamam mı?"

# game/Scenes/Brandi/brandi2.rpy:75
translate turkish brandi2_63023601_1:

    # pc "Okay."
    pc "Tamam."

# game/Scenes/Brandi/brandi2.rpy:76
translate turkish brandi2_50d36c3a:

    # fd "Cool, follow me."
    fd "Harika, beni takip et."

# game/Scenes/Brandi/brandi2.rpy:78
translate turkish brandi2_5342c32e:

    # fd "Hey everybody, BurgerBuddy is here. Or [pcname], which we should probably call him from now on."
    fd "Hey millet, BurgerBuddy geldi. Ya da [pcname], bundan sonra ona böyle seslenmeliyiz."

# game/Scenes/Brandi/brandi2.rpy:79
translate turkish brandi2_21079f98:

    # pc "Yes, I'd prefer that."
    pc "Evet, öyle olmasını tercih ederim."

# game/Scenes/Brandi/brandi2.rpy:80
translate turkish brandi2_66c11aab:

    # fd "Okay, let's order some food. I'm getting spaghetti and meatballs today. What do you like?"
    fd "Tamam, hadi yemek sipariş edelim. Bugün spagetti ve köfte alacağım. Sen ne istersin?"

# game/Scenes/Brandi/brandi2.rpy:81
translate turkish brandi2_155c8f5e:

    # pc "Uh, I guess I'll have that too."
    pc "Hmm, sanırım ben de ondan alacağım."

# game/Scenes/Brandi/brandi2.rpy:82
translate turkish brandi2_98b146f0:

    # fd "Good choice."
    fd "İyi seçim."

# game/Scenes/Brandi/brandi2.rpy:83
translate turkish brandi2_beb3f8ca:

    # "The waiter comes and takes our order, then Brandi turns towards me sort of dramatically. She is putting on a show for sure."
    "Garson gelip siparişlerimizi alıyor, sonra Brandi biraz abartılı bir şekilde bana dönüyor. Kesinlikle rol yapıyor."

# game/Scenes/Brandi/brandi2.rpy:86
translate turkish brandi2_74f01f3b:

    # fd "So, first date. We should get to know each other a little better."
    fd "Ee, ilk buluşma. Birbirimizi biraz daha yakından tanımalıyız."

# game/Scenes/Brandi/brandi2.rpy:87
translate turkish brandi2_6f946235:

    # fd "It's always a little awkward at first. We've only talked a few times before, I don't really know you very well."
    fd "Başlangıçta her zaman biraz garip olur. Daha önce sadece birkaç kez konuştuk, seni pek iyi tanımıyorum."

# game/Scenes/Brandi/brandi2.rpy:88
translate turkish brandi2_76f35fc6:

    # fd "And you're a cute guy and I'm sitting so close to you."
    fd "Sen sevimli bir adamsın ve ben de sana çok yakın oturuyorum."

# game/Scenes/Brandi/brandi2.rpy:89
translate turkish brandi2_e86c12d0:

    # fd "So what should I talk about? What are good conversation topics for the first date?"
    fd "Peki ne hakkında konuşmalıyım? İlk buluşma için iyi sohbet konuları nelerdir?"

# game/Scenes/Brandi/brandi2.rpy:90
translate turkish brandi2_65ba2cc2:

    # fd "What do you think, chat? What should we talk about?"
    fd "Ne dersin, sohbet edelim mi? Ne hakkında konuşmalıyız?"

# game/Scenes/Brandi/brandi2.rpy:93
translate turkish brandi2_c16cea75:

    # "She leans in and looks closer at the screen."
    "O da eğilip ekrana daha yakından bakıyor."

# game/Scenes/Brandi/brandi2.rpy:94
translate turkish brandi2_14197c78:

    # fd "No, not that. Too heavy for a first date. Wow, no I'm not asking him that! Geez, guys!"
    fd "Hayır, o değil. İlk buluşma için çok ağır bir konu. Vay canına, hayır, ona bunu sormayacağım! Hayret, çocuklar!"

# game/Scenes/Brandi/brandi2.rpy:95
translate turkish brandi2_7c433d80:

    # fd "Ah, there's a good one."
    fd "Ah, işte iyi bir tane."

# game/Scenes/Brandi/brandi2.rpy:98
translate turkish brandi2_78389a04:

    # fd "BurgerChic suggests I ask if you have any brothers or sisters?"
    fd "BurgerChic, “Kardeşin var mı?” diye sormamı öneriyor."

# game/Scenes/Brandi/brandi2.rpy:99
translate turkish brandi2_37eda2d6:

    # pc "No blood-related siblings, but there is Suzy, I guess. She's my [sister]."
    pc "Kan bağı olan kardeşim yok, ama Suzy var sanırım. O benim [sister]'m."

# game/Scenes/Brandi/brandi2.rpy:100
translate turkish brandi2_8266c6d6:

    # pc "What about you?"
    pc "Peki ya sen?"

# game/Scenes/Brandi/brandi2.rpy:101
translate turkish brandi2_35c433bd:

    # fd "Oh yeah, I have two brothers and two sisters. "
    fd "Evet, iki erkek ve iki kız kardeşim var. "

# game/Scenes/Brandi/brandi2.rpy:102
translate turkish brandi2_2b1f61d6:

    # fd "They don't live here though. They all moved away after college, but I like Skyhill so I stuck around."
    fd "Ama burada yaşamıyorlar. Hepsi üniversiteden sonra taşındılar, ama ben Skyhill’i sevdiğim için burada kaldım."

# game/Scenes/Brandi/brandi2.rpy:105
translate turkish brandi2_0a955753:

    # fd "Do you have a job?"
    fd "İşin var mı?"

# game/Scenes/Brandi/brandi2.rpy:106
translate turkish brandi2_fce9f9b7:

    # pc "I do. I'm an assistant for an attorney."
    pc "Evet. Bir avukatın asistanıyım."

# game/Scenes/Brandi/brandi2.rpy:107
translate turkish brandi2_8844ef8a:

    # fd "Oh, so you're going to be a lawyer?"
    fd "Oh, yani avukat mı olacaksın?"

# game/Scenes/Brandi/brandi2.rpy:108
translate turkish brandi2_afbdac62:

    # pc "Well, no. I'm in school for quantum physics actually."
    pc "Şey, hayır. Aslında kuantum fiziği okuyorum."

# game/Scenes/Brandi/brandi2.rpy:109
translate turkish brandi2_04c1148e:

    # fd "Wow, that's impressive."
    fd "Vay canına, bu etkileyici."

# game/Scenes/Brandi/brandi2.rpy:110
translate turkish brandi2_1de87a6b:

    # fd "I dropped out of high school and now I eat food in front of an audience for money."
    fd "Liseyi bıraktım ve şimdi para karşılığında seyircilerin önünde yemek yiyorum."

# game/Scenes/Brandi/brandi2.rpy:111
translate turkish brandi2_037690dc:

    # pc "Hey, whatever pays the bills."
    pc "Hey, faturaları ödeyebiliyorsa ne fark eder ki."

# game/Scenes/Brandi/brandi2.rpy:112
translate turkish brandi2_75eca7b6:

    # fd "Right! Somebody tell my mom that."
    fd "Doğru! Biri bunu anneme söylesin."

# game/Scenes/Brandi/brandi2.rpy:115
translate turkish brandi2_3adc15d4:

    # "The waiter brings out our food and we start digging in."
    "Garson yemeklerimizi getiriyor ve yemeye başlıyoruz."

# game/Scenes/Brandi/brandi2.rpy:116
translate turkish brandi2_bc981603:

    # fd "Since you're the guest, you get first taste."
    fd "Misafir sen olduğun için ilk sen tadına bak."

# game/Scenes/Brandi/brandi2.rpy:117
translate turkish brandi2_350435c4:

    # pc "Okay, sounds good to me."
    pc "Tamam, bana uyar."

# game/Scenes/Brandi/brandi2.rpy:118
translate turkish brandi2_96c0c900:

    # fd "What do you think, [pcname]? Do you like it?"
    fd "Ne dersin, [pcname]? Beğendin mi?"

# game/Scenes/Brandi/brandi2.rpy:119
translate turkish brandi2_efb02d33:

    # pc "Yeah it's pretty damn good."
    pc "Evet, gerçekten çok lezzetli."

# game/Scenes/Brandi/brandi2.rpy:120
translate turkish brandi2_f2d6f866:

    # fd "See? I love this place."
    fd "Gördün mü? Burayı çok seviyorum."

# game/Scenes/Brandi/brandi2.rpy:123
translate turkish brandi2_add75b21:

    # fd "Now it's my turn."
    fd "Şimdi sıra bende."

# game/Scenes/Brandi/brandi2.rpy:124
translate turkish brandi2_d1a17c3f:

    # fd "I like to start with the balls."
    fd "Ben köftelerle başlamayı seviyorum."

# game/Scenes/Brandi/brandi2.rpy:125
translate turkish brandi2_dcb21a7c:

    # fd "Just pop the whole thing in there and..."
    fd "Hepsini ağzına at ve..."

# game/Scenes/Brandi/brandi2.rpy:128
translate turkish brandi2_b3f6951f:

    # fd "Delicious!"
    fd "Lezzetli!"

# game/Scenes/Brandi/brandi2.rpy:129
translate turkish brandi2_36d64bd9:

    # "Time passes quickly while we eat and before long, we have spent nearly an hour chatting and we are both so full."
    "Yemek yerken zaman çabuk geçiyor ve çok geçmeden, neredeyse bir saat sohbet etmişiz ve ikimiz de çok doymuşuz."

# game/Scenes/Brandi/brandi2.rpy:132
translate turkish brandi2_248b5030:

    # fd "Okay, one last question from chat, then we're going to head out."
    fd "Tamam, sohbetten son bir soru daha, sonra çıkacağız."

# game/Scenes/Brandi/brandi2.rpy:133
translate turkish brandi2_cc48f82b:

    # fd "No, I'm not asking him that."
    fd "Hayır, ona bunu sormayacağım."

# game/Scenes/Brandi/brandi2.rpy:134
translate turkish brandi2_5360ee4b:

    # fd "Okay, that's a good one."
    fd "Tamam, bu iyi bir soru."

# game/Scenes/Brandi/brandi2.rpy:135
translate turkish brandi2_85beb4d2:

    # fd "Where would you like this relationship to go?"
    fd "Bu ilişkinin nereye gitmesini istersin?"

# game/Scenes/Brandi/brandi2.rpy:140
translate turkish brandi2_c8eaa0d3:

    # fd "Haha! Straight to the point."
    fd "Haha! Doğrudan konuya girmişsin."

# game/Scenes/Brandi/brandi2.rpy:141
translate turkish brandi2_e9e17cc6:

    # fd "Well, we will see. I like to let things build up a little before we get to that point."
    fd "Şey, göreceğiz. O noktaya gelmeden önce işlerin biraz gelişmesine izin vermeyi seviyorum."

# game/Scenes/Brandi/brandi2.rpy:142
translate turkish brandi2_6930b345:

    # fd "But we are definitely heading in that direction."
    fd "Ama kesinlikle o yöne doğru gidiyoruz."

# game/Scenes/Brandi/brandi2.rpy:146
translate turkish brandi2_6e80582d:

    # fd "I like that answer. The build-up is part of the fun."
    fd "Bu cevabı beğendim. Gelişme süreci de eğlencenin bir parçası."

# game/Scenes/Brandi/brandi2.rpy:147
translate turkish brandi2_01aec78f:

    # fd "We'll take it slow and see where it takes us."
    fd "Yavaş yavaş ilerleyip bizi nereye götüreceğini göreceğiz."

# game/Scenes/Brandi/brandi2.rpy:150
translate turkish brandi2_173c3c75:

    # fd "Okay guys, that's it for today. Remember to click Like and Subscribe if you're not already following me."
    fd "Tamam millet, bugünlük bu kadar. Henüz beni takip etmiyorsanız, Beğen ve Abone Ol düğmelerine tıklamayı unutmayın."

# game/Scenes/Brandi/brandi2.rpy:151
translate turkish brandi2_97f9ef0f:

    # fd "This was fun. I hope we'll be able to do it again sometime soon."
    fd "Çok eğlenceliydi. Umarım yakında tekrar yapabiliriz."

# game/Scenes/Brandi/brandi2.rpy:152
translate turkish brandi2_7bb0c1c0:

    # fd "Love you guys! Bye!"
    fd "Sizi seviyorum millet! Hoşça kalın!"

# game/Scenes/Brandi/brandi2.rpy:158
translate turkish brandi2_4e9c7ec4:

    # "She closes the laptop and then looks at me."
    "Dizüstü bilgisayarı kapatıp bana bakıyor."

# game/Scenes/Brandi/brandi2.rpy:159
translate turkish brandi2_7a30d65f:

    # fd "I really did have a good time. I hope you did too."
    fd "Gerçekten çok eğlendim. Umarım siz de eğlenmişsinizdir."

# game/Scenes/Brandi/brandi2.rpy:162
translate turkish brandi2_d9c44974:

    # fd "Great! I'm glad."
    fd "Harika! Sevindim."

# game/Scenes/Brandi/brandi2.rpy:166
translate turkish brandi2_2545de2f:

    # fd "I get it. Really, I do."
    fd "Anlıyorum. Gerçekten, anlıyorum."

# game/Scenes/Brandi/brandi2.rpy:167
translate turkish brandi2_b23717c5:

    # fd "But this is part of who I am. I hope that you'll be okay with that."
    fd "Ama bu benim bir parçam. Umarım bununla bir sorunun olmaz."

# game/Scenes/Brandi/brandi2.rpy:168
translate turkish brandi2_ecd95542:

    # fd "If you're not, then we just won't be able to date, I'm sorry."
    fd "Eğer olmazsa, o zaman çıkamayız, üzgünüm."

# game/Scenes/Brandi/brandi2.rpy:173
translate turkish brandi2_c90abea0:

    # fd "Good, because I think that really went over well with the audience."
    fd "Güzel, çünkü bence bu seyirciler arasında gerçekten iyi yankı buldu."

# game/Scenes/Brandi/brandi2.rpy:174
translate turkish brandi2_6f7cc3ca:

    # fd "I got a bunch of new subscribers and the tips were coming in hard."
    fd "Bir sürü yeni abone kazandım ve bahşişler de bolca geldi."

# game/Scenes/Brandi/brandi2.rpy:175
translate turkish brandi2_67293cc6:

    # fd "People are curious to see where this relationship goes."
    fd "İnsanlar bu ilişkinin nereye varacağını merak ediyor."

# game/Scenes/Brandi/brandi2.rpy:176
translate turkish brandi2_23d6be6d:

    # fd "So am I actually."
    fd "Aslında ben de öyle."

# game/Scenes/Brandi/brandi2.rpy:178
translate turkish brandi2_625d8282:

    # fd "Okay then. Thanks for hanging out with me today."
    fd "Tamam o zaman. Bugün benimle vakit geçirdiğin için teşekkürler."

# game/Scenes/Brandi/brandi2.rpy:179
translate turkish brandi2_d3615a77:

    # fd "I'll go get the check. You can leave now."
    fd "Hesabı ödeyeceğim. Artık gidebilirsin."

# game/Scenes/Brandi/brandi2.rpy:182
translate turkish brandi2_6f831ce8:

    # "I get up and walk out. She doesn't say anything else to me."
    "Ayağa kalkıp dışarı çıkıyorum. Bana başka bir şey söylemiyor."

# game/Scenes/Brandi/brandi2.rpy:183
translate turkish brandi2_1e44de24:

    # "Oh well. She is okay, but I don't like having an audience watching our whole relationship."
    "Neyse. Fena bir kız değil, ama tüm ilişkimizi izleyen bir seyirci kitlesi olmasını sevmiyorum."

# game/Scenes/Brandi/brandi2.rpy:184
translate turkish brandi2_2fa87c07:

    # "There are other people out there I'm more interested in."
    "Dışarıda daha çok ilgimi çeken başka insanlar var."

# game/Scenes/Brandi/brandi2.rpy:186
translate turkish brandi2_fbe3fcb3:

    # "I go out to the car and drive away."
    "Arabaya gidip uzaklaşıyorum."

# game/Scenes/Brandi/brandi2.rpy:190
translate turkish brandi2_0da34d09:

    # fd "Okay, I'll go take care of the check real quick and we can head out."
    fd "Tamam, gidip hesabı hemen halledeyim, sonra çıkabiliriz."

# game/Scenes/Brandi/brandi2.rpy:193
translate turkish brandi2_76db71da:

    # fd "I appreciate you being chivalrous. I actually find that extremely attractive in a guy."
    fd "Centilmen davranışın için teşekkür ederim. Aslında bir erkekte bu özelliği son derece çekici buluyorum."

# game/Scenes/Brandi/brandi2.rpy:194
translate turkish brandi2_79a749bb:

    # fd "But it's a business expense for me, so I get a big discount and a tax break."
    fd "Ama bu benim için bir iş gideri, o yüzden büyük bir indirim ve vergi indirimi alıyorum."

# game/Scenes/Brandi/brandi2.rpy:195
