    con "Şuradaki havluyu alır mısın lütfen, tatlım?"

# game/Scenes/Connie/connie15.rpy:200
translate turkish connie15_1fda941e:

    # con "That was incredible."
    con "İnanılmazdı."

# game/Scenes/Connie/connie15.rpy:201
translate turkish connie15_a8fbf3ff:

    # con "You really know how to make a woman happy."
    con "Bir kadını nasıl mutlu edeceğini gerçekten iyi biliyorsun."

# game/Scenes/Connie/connie15.rpy:202
translate turkish connie15_64d3d99b:

    # pc "I'm glad I could. You definitely still have a few tricks up your sleeve too."
    pc "Yapabildiğime sevindim. Senin de kesinlikle hâlâ birkaç numaran var."

# game/Scenes/Connie/connie15.rpy:203
translate turkish connie15_88f76d9a:

    # con "You betcha."
    con "Elbette."

# game/Scenes/Connie/connie15.rpy:206
translate turkish connie15_bee0b92a:

    # "She takes a box of cigarettes out of her night stand and lights one up."
    "Komodinden bir paket sigara çıkarıp bir tane yakıyor."

# game/Scenes/Connie/connie15.rpy:207
translate turkish connie15_4fb3d9c8:

    # con "Do you want a smoke?"
    con "Sigara ister misin?"

# game/Scenes/Connie/connie15.rpy:208
translate turkish connie15_cdac1b0a:

    # pc "No thanks, I don't smoke cigarettes."
    pc "Hayır teşekkürler, sigara içmem."

# game/Scenes/Connie/connie15.rpy:209
translate turkish connie15_7d74ff93:

    # con "I don't really either. I think I've had this pack for a year or so."
    con "Ben de pek içmem aslında. Sanırım bu paketi bir yıldır falan saklıyorum."

# game/Scenes/Connie/connie15.rpy:212
translate turkish connie15_98da17ed:

    # con "Right now, after that, a cigarette hits just right."
    con "Şu anda, o olaydan sonra, bir sigara tam da iyi gelir."

# game/Scenes/Connie/connie15.rpy:213
translate turkish connie15_596c0f44:

    # con "You know, besides my husband, you're the first man I've had sex with in fifty years."
    con "Biliyor musun, kocam dışında, elli yıldır seks yaptığım ilk erkek sensin."

# game/Scenes/Connie/connie15.rpy:214
translate turkish connie15_6a75940e:

    # pc "Really? You and Jackson never had anything?"
    pc "Gerçekten mi? Sen ve Jackson arasında hiç bir şey olmadı mı?"

# game/Scenes/Connie/connie15.rpy:215
translate turkish connie15_03c8c55b:

    # con "Naw, he's like a brother to me. He's never looked at me like that."
    con "Hayır, o benim için bir kardeş gibidir. Bana hiç öyle bakmadı."

# game/Scenes/Connie/connie15.rpy:216
translate turkish connie15_42e3bab3:

    # con "Nobody ever really looks at me like that."
    con "Kimse bana gerçekten öyle bakmaz."

# game/Scenes/Connie/connie15.rpy:219
translate turkish connie15_bab07018:

    # pc "I don't see why not. You're a good looking woman."
    pc "Neden olmasın ki? Çok güzel bir kadınsın."

# game/Scenes/Connie/connie15.rpy:220
translate turkish connie15_2a7d9ea2:

    # con "I try, but nobody is interested in an old lady."
    con "Çabalıyorum ama kimse yaşlı bir kadına ilgi göstermiyor."

# game/Scenes/Connie/connie15.rpy:221
translate turkish connie15_f0f40b8d:

    # con "You got to use it while you're young, you know? Else you end up stuck in an old body, all alone."
    con "Gençken bunu kullanmalısın, biliyor musun? Yoksa yaşlı bir bedende, yapayalnız kalırsın."

# game/Scenes/Connie/connie15.rpy:222
translate turkish connie15_007fbff2:

    # pc "You have regrets?"
    pc "Pişmanlık duyuyor musun?"

# game/Scenes/Connie/connie15.rpy:223
translate turkish connie15_79491ffd:

    # con "Oh, no. Not really."
    con "Hayır, pek sayılmaz."

# game/Scenes/Connie/connie15.rpy:224
translate turkish connie15_bf42fbfd:

    # con "My husband was good to me. We had a lot of really good years."
    con "Kocam bana çok iyi davranırdı. Gerçekten çok güzel yıllar geçirdik."

# game/Scenes/Connie/connie15.rpy:227
translate turkish connie15_8fb15acf:

    # con "And that man was just as gifted as you are in bed."
    con "Ve o adam yatakta da en az senin kadar yetenekliydi."

# game/Scenes/Connie/connie15.rpy:228
translate turkish connie15_acf7a854:

    # con "God, I miss him."
    con "Tanrım, onu çok özlüyorum."

# game/Scenes/Connie/connie15.rpy:231
translate turkish connie15_25ac1736:

    # pc "Did you have any children?"
    pc "Çocuğun var mıydı?"

# game/Scenes/Connie/connie15.rpy:232
translate turkish connie15_4575dead:

    # con "One. A boy. Chase."
    con "Bir tane. Bir erkek. Chase."

# game/Scenes/Connie/connie15.rpy:233
translate turkish connie15_5b0fb844:

    # con "He died over in Afghanistan."
    con "Afganistan’da öldü."

# game/Scenes/Connie/connie15.rpy:234
translate turkish connie15_6c6d9416_1:

    # pc "Oh, I'm sorry."
    pc "Oh, çok üzüldüm."

# game/Scenes/Connie/connie15.rpy:237
translate turkish connie15_0fa6aba4_1:

    # con "It's okay."
    con "Önemli değil."

# game/Scenes/Connie/connie15.rpy:238
translate turkish connie15_d075efd8:

    # con "Sometimes I feel like I died too..."
    con "Bazen ben de ölmüşüm gibi hissediyorum..."

# game/Scenes/Connie/connie15.rpy:239
translate turkish connie15_454cba6d:

    # con "... and I'm just stuck here, waiting for my turn to go meet them."
    con "... ve burada sıkışıp kalmışım, onlarla buluşmak için sıramı bekliyorum."

# game/Scenes/Connie/connie15.rpy:242
translate turkish connie15_19979052:

    # con "Thank you for making me feel alive for a little while."
    con "Beni bir süreliğine canlı hissettirdiğin için teşekkür ederim."

# game/Scenes/Connie/connie15.rpy:243
translate turkish connie15_2911487b:

    # con "You're a good kid."
    con "İyi bir çocuksun."

# game/Scenes/Connie/connie15.rpy:246
translate turkish connie15_109a5d63:

    # con "I think you and Brandi make a very nice couple."
    con "Bence sen ve Brandi çok güzel bir çiftsiniz."

# game/Scenes/Connie/connie15.rpy:247
translate turkish connie15_68f01008:

    # con "You should consider settling down with her."
    con "Onunla bir yuva kurmayı düşünmelisin."

# game/Scenes/Connie/connie15.rpy:248
translate turkish connie15_19e05b84:

    # con "I see you coming into Jackson's with different girls."
    con "Jackson’s’a farklı kızlarla geldiğini görüyorum."

# game/Scenes/Connie/connie15.rpy:249
translate turkish connie15_fedfc4a9:

    # con "You're young. That's a good thing. Experiment."
    con "Gençsin. Bu iyi bir şey. Deneyim kazan."

# game/Scenes/Connie/connie15.rpy:250
translate turkish connie15_ec119d97:

    # con "But eventually, I hope you'll pick a girl and start a life and a family with her."
    con "Ama eninde sonunda, umarım bir kız seçip onunla bir hayat kurup bir aile kurarsın."

# game/Scenes/Connie/connie15.rpy:251
translate turkish connie15_1dc28a58:

    # con "And I hope you'll make each other very happy."
    con "Ve umarım birbirinizi çok mutlu edersiniz."

# game/Scenes/Connie/connie15.rpy:252
translate turkish connie15_a40b7cd5:

    # pc "Thanks, Connie."
    pc "Teşekkürler, Connie."

# game/Scenes/Connie/connie15.rpy:253
translate turkish connie15_0fd31492:

    # con "All right, that's enough reminiscing. Time to get dressed."
    con "Tamam, bu kadar anımsama yeter. Giyinme zamanı."

# game/Scenes/Connie/connie15.rpy:256
translate turkish connie15_2f1120e6:

    # "Before I leave, she hands me a tin full of chocolate chip cookies."
    "Ben çıkmadan önce, bana çikolata parçacıklı kurabiyelerle dolu bir teneke uzattı."

# game/Scenes/Connie/connie15.rpy:257
translate turkish connie15_189fa119:

    # con "I made these for Jackson, but he can have the next batch. You enjoy. You earned them."
    con "Bunları Jackson için yapmıştım ama bir sonraki partiyi o yiyebilir. Sen afiyetle ye. Hak ettin."

# game/Scenes/Connie/connie15.rpy:258
translate turkish connie15_25e0f073:

    # con "Thanks again for making my day."
    con "Günümü güzelleştirdiğin için tekrar teşekkürler."

# game/Scenes/Connie/connie15.rpy:259
translate turkish connie15_a351accf:

    # con "I don't think we'll do this again, but I'm glad to have spent some time with you."
    con "Sanırım bunu bir daha yapmayacağız ama seninle biraz zaman geçirdiğim için mutluyum."

# game/Scenes/Connie/connie15.rpy:260
translate turkish connie15_a9da76fd:

    # pc "Me too, Connie."
    pc "Ben de, Connie."

# game/Scenes/Connie/connie15.rpy:261
translate turkish connie15_c6512378:

    # con "You take care."
    con "Kendine iyi bak."

# game/Scenes/Connie/connie15.rpy:264
translate turkish connie15_18c0b69c:

    # "I leave Connie's house and drive away."
    "Connie’nin evinden ayrılıp arabayla uzaklaşıyorum."

# game/Scenes/Connie/connie15.rpy:265
translate turkish connie15_313c822e:

    # "I hope she'll be okay. She's a sweet lady."
    "Umarım o iyi olur. Çok tatlı bir hanımefendi."

# game/Scenes/Connie/connie15.rpy:266
translate turkish connie15_f74a794a:

    # "And she gives a killer gummer."
    "Ve müthiş bir öpücük veriyor."

translate turkish strings:

    # game/Scenes/Connie/connie15.rpy:39
    old "Um... okay"
    new "Şey... tamam"

    # game/Scenes/Connie/connie15.rpy:55
    old "Age is just a number, baby"
    new "Yaş sadece bir sayıdır, bebeğim"

    # game/Scenes/Connie/connie15.rpy:60
    old "Thanks, Connie"
    new "Teşekkürler, Connie"

    # game/Scenes/Connie/connie15.rpy:72
    old "I wouldn't mind a piece of you"
    new "Seninle biraz vakit geçirmek hoşuma giderdi"

