    # bai "It was really fun."
    bai "Gerçekten çok eğlenceliydi."

# game/Scenes/Bai/bai9.rpy:191
translate turkish bai9menu_5fb6f695:

    # pc "Yeah, it was."
    pc "Evet, öyleydi."

# game/Scenes/Bai/bai9.rpy:193
translate turkish bai9menu_49fd0008:

    # "I step forward and give him one last kiss goodbye, lingering for a while, half-hoping he'll ask me to stay."
    "Bir adım öne çıkıp ona veda etmek için son bir öpücük veriyorum, bir süre öylece kalıyorum, içten içe kalmamı isteyeceğini umuyorum."

# game/Scenes/Bai/bai9.rpy:194
translate turkish bai9menu_99b0804b:

    # "But he doesn't. Not ready yet, I guess. So I pull away."
    "Ama istemiyor. Henüz hazır değil sanırım. Ben de uzaklaşıyorum."

# game/Scenes/Bai/bai9.rpy:197
translate turkish bai9menu_996630df:

    # bai "Bye, [pcname]."
    bai "Hoşça kal, [pcname]."

# game/Scenes/Bai/bai9.rpy:198
translate turkish bai9menu_2de26655:

    # pc "Bye, Bai."
    pc "Hoşça kal, Bai."

# game/Scenes/Bai/bai9.rpy:201
translate turkish bai9menu_3f5af290:

    # "With that, I leave his apartment and walk back to my car."
    "Bunun üzerine, dairesinden çıkıp arabama doğru yürüyorum."

# game/Scenes/Bai/bai9.rpy:202
translate turkish bai9menu_fab7459a:

    # "That was a fun evening."
    "Eğlenceli bir akşamdı."

# game/Scenes/Bai/bai9.rpy:221
translate turkish bai9end_87193ebc:

    # pc "I'm sorry, I can't. I'm not into this."
    pc "Üzgünüm, yapamam. Bu iş bana göre değil."

# game/Scenes/Bai/bai9.rpy:222
translate turkish bai9end_28261d04:

    # bai "Oh, Okay. That's okay, I understand."
    bai "Oh, tamam. Sorun değil, anlıyorum."

# game/Scenes/Bai/bai9.rpy:223
translate turkish bai9end_511bbc2a:

    # "I stand up and leave Bai's apartment. This just wasn't going to work for me."
    "Ayağa kalkıp Bai'nin dairesinden çıkıyorum. Bu iş benim için yürümeyecekti."

translate turkish strings:

    # game/Scenes/Bai/bai9.rpy:6
    old "You need to have your first kiss with Bai, which can happen at the end of a good date, if you haven't told him you were just friends."
    new "Bai ile ilk öpüşmeni gerçekleştirmelisin; eğer ona sadece arkadaş olduğunuzu söylemediysen, bu iyi bir randevunun sonunda gerçekleşebilir."

    # game/Scenes/Bai/bai9.rpy:7
    old "After this, Bai will call you and invite you over in the evening sometime."
    new "Bundan sonra, Bai seni arayacak ve bir akşam seni evine davet edecek."

    # game/Scenes/Bai/bai9.rpy:101
    old "No, I can't do this"
    new "Hayır, bunu yapamam"

    # game/Scenes/Bai/bai9.rpy:115
    old "I thought I could, but I can't do this"
    new "Yapabileceğimi sanmıştım ama yapamıyorum"

    # game/Scenes/Bai/bai9.rpy:126
    old "Yeah, please do"
    new "Evet, lütfen yap"

    # game/Scenes/Bai/bai9.rpy:163
