translate turkish bai1d_8c24f368:

    # bai "So would you be up for one of these little dates again?"
    bai "Peki, bu tür küçük randevulardan birine tekrar çıkmak ister misin?"

# game/Scenes/Bai/bai1.rpy:242
translate turkish bai1d_802bd748:

    # bai "I'm glad to hear it. Can't wait for our next one."
    bai "Bunu duyduğuma sevindim. Bir sonrakini sabırsızlıkla bekliyorum."

# game/Scenes/Bai/bai1.rpy:245
translate turkish bai1d_3c769f7a:

    # bai "I mean we don't have to call it that, I was just joking."
    bai "Yani buna öyle dememiz gerekmez, sadece şaka yapıyordum."

# game/Scenes/Bai/bai1.rpy:249
translate turkish bai1d_96804e49:

    # bai "Okay."
    bai "Tamam."

# game/Scenes/Bai/bai1.rpy:250
translate turkish bai1d_b5ad529f:

    # bai "Well I can't wait for our next one then."
    bai "O zaman bir sonraki buluşmamızı sabırsızlıkla bekliyorum."

# game/Scenes/Bai/bai1.rpy:254
translate turkish bai1d_8844c594:

    # bai "Okay, that's cool."
    bai "Tamam, sorun yok."

# game/Scenes/Bai/bai1.rpy:255
translate turkish bai1d_681f0b18:

    # bai "Well I'm looking forward to the next time we can hang out then."
    bai "O zaman bir dahaki sefere takılabileceğimiz zamanı sabırsızlıkla bekliyorum."

# game/Scenes/Bai/bai1.rpy:257
translate turkish bai1d_d0ca3261:

    # bai "Hope we can hang out like this again soon."
    bai "Umarım yakında yine böyle takılabiliriz."

# game/Scenes/Bai/bai1.rpy:258
translate turkish bai1d_03eaad50_1:

    # pc "Me too."
    pc "Ben de."

# game/Scenes/Bai/bai1.rpy:260
translate turkish bai1d_30423311:

    # bai "Hey before we leave, let me give you my phone number."
    bai "Hey, gitmeden önce sana telefon numaramı vereyim."

# game/Scenes/Bai/bai1.rpy:261
translate turkish bai1d_0b8345e6:

    # bai "I don't have a lot of friends around here, so I'd love to just chat with you whenever you feel up to it."
    bai "Buralarda pek arkadaşım yok, o yüzden ne zaman istersen seninle sohbet etmek isterim."

# game/Scenes/Bai/bai1.rpy:262
translate turkish bai1d_465c988e:

    # bai "And maybe we can go out again sometime soon."
    bai "Belki yakında tekrar dışarı çıkabiliriz."

# game/Scenes/Bai/bai1.rpy:263
translate turkish bai1d_50eb93b7:

    # pc "Okay, sounds good."
    pc "Tamam, kulağa hoş geliyor."

# game/Scenes/Bai/bai1.rpy:270
translate turkish bai1d_0e8a2008:

    # "We finish up our food, he leaves some money on the table, then we head outside."
    "Yemeğimizi bitiriyoruz, o masaya biraz para bırakıyor, sonra dışarı çıkıyoruz."

# game/Scenes/Bai/bai1.rpy:271
translate turkish bai1d_630eae85:

    # bai "Well that was the most fun I've had in a while."
    bai "Bu, son zamanlarda yaşadığım en eğlenceli anlardı."

# game/Scenes/Bai/bai1.rpy:272
translate turkish bai1d_a96bfd7d:

    # bai "Thanks again for hanging out with me tonight."
    bai "Bu gece benimle vakit geçirdiğin için tekrar teşekkürler."

# game/Scenes/Bai/bai1.rpy:273
translate turkish bai1d_fe5246ec:

    # pc "No problem. I had fun too."
    pc "Sorun değil. Ben de eğlendim."

# game/Scenes/Bai/bai1.rpy:274
translate turkish bai1d_b6980062:

    # bai "Alright, well I better head home."
    bai "Peki, artık eve gitsem iyi olacak."

# game/Scenes/Bai/bai1.rpy:276
translate turkish bai1d_5d4a4d14:

    # bai "I'll see you later."
    bai "Görüşürüz."

# game/Scenes/Bai/bai1.rpy:277
translate turkish bai1d_1aff6c8c:

    # pc "See ya, Bai."
    pc "Görüşürüz, Bai."

# game/Scenes/Bai/bai1.rpy:278
translate turkish bai1d_ba9439b8:

    # "He goes to his car and drives off and I walk to mine."
    "O arabasına binip uzaklaşır, ben de kendiminkine doğru yürürüm."

