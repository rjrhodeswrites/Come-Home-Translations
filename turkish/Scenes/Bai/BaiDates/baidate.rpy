# game/Scenes/Bai/BaiDates/baidate.rpy:65
translate turkish baienddate_17764b2d:

    # bai "I had a really good time. I'm looking forward to our next date."
    bai "Gerçekten çok iyi vakit geçirdim. Bir sonraki randevumuzu sabırsızlıkla bekliyorum."

# game/Scenes/Bai/BaiDates/baidate.rpy:66
translate turkish baienddate_03eaad50:

    # pc "Me too."
    pc "Ben de."

# game/Scenes/Bai/BaiDates/baidate.rpy:68
translate turkish baienddate_4924fbc9:

    # "He stands close to me, looking in my eyes expectantly. Thinking about something, but seemingly too afraid to do it."
    "Bana yakın duruyor, umutla gözlerime bakıyor. Bir şey düşünüyor, ama bunu yapmaya çok korkuyor gibi görünüyor."

# game/Scenes/Bai/BaiDates/baidate.rpy:72
translate turkish baienddate_18491609:

    # "He looks a bit surprised as I lean in, but quickly accepts it and kisses back."
    "Ben eğildiğimde biraz şaşırmış gibi görünüyor, ama çabucak kabul ediyor ve karşılık veriyor."

# game/Scenes/Bai/BaiDates/baidate.rpy:74
translate turkish baienddate_ea54ee7b:

    # pc "Can I kiss you?"
    pc "Seni öpebilir miyim?"

# game/Scenes/Bai/BaiDates/baidate.rpy:75
translate turkish baienddate_e48f765e:

    # bai "Yes. I'd like that."
    bai "Evet. Hoşuma giderdi."

# game/Scenes/Bai/BaiDates/baidate.rpy:77
translate turkish baienddate_ceee6fe3:

    # "I lean in and kiss him."
    "Ona doğru eğilip onu öpüyorum."

# game/Scenes/Bai/BaiDates/baidate.rpy:79
translate turkish baienddate_30410416:

    # "He looks nervous, then that changes a bit to disappointment."
    "Gergin görünüyor, sonra bu ifade biraz hayal kırıklığına dönüşüyor."

# game/Scenes/Bai/BaiDates/baidate.rpy:81
translate turkish baienddate_17fc970f:

    # "The kiss starts off nervously, but then it changes to something more comfortable and eager."
    "Öpücük gergin bir şekilde başlıyor, ama sonra daha rahat ve hevesli bir şeye dönüşüyor."

# game/Scenes/Bai/BaiDates/baidate.rpy:82
translate turkish baienddate_54e89b78:

    # "And then finally, we pull away."
    "Ve sonunda, birbirimizden ayrılıyoruz."

# game/Scenes/Bai/BaiDates/baidate.rpy:84
