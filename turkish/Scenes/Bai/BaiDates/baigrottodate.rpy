# game/Scenes/Bai/BaiDates/baigrottodate.rpy:19
translate turkish baigrottodate_d3715341:

    # pc "Do you want to come out to a fancy restaurant with me?"
    pc "Benimle lüks bir restorana gelmek ister misin?"

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:20
translate turkish baigrottodate_4243d9c3:

    # pc "It's called The Grotto. It's out on the lake."
    pc "Adı The Grotto. Göl kenarında."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:23
translate turkish baigrottodate_4f7f94cb:

    # bai "Is it expensive?"
    bai "Pahalı mı?"

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:24
translate turkish baigrottodate_3308b177:

    # pc "Pretty expensive, yeah."
    pc "Evet, epey pahalı."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:26
translate turkish baigrottodate_fb59b9b7:

    # bai "Aw, what the hell. Might as well spend it, right?"
    bai "Ah, ne olacak ki. Harcayalım bari, değil mi?"

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:27
translate turkish baigrottodate_f82e580f:

    # bai "I eat cheap every other day, let's get some fancy food!"
    bai "Her gün ucuz yemek yiyorum, hadi biraz lüks bir şeyler yiyelim!"

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:28
translate turkish baigrottodate_5f71dc40:

    # pc "All right! I'll text you the address and meet you out there."
    pc "Tamam! Adresi sana mesaj atacağım, orada buluşuruz."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:29
translate turkish baigrottodate_1bda0dbe:

    # bai "Sounds good! See you there."
    bai "Kulağa hoş geliyor! Orada görüşürüz."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:32
translate turkish baigrottodate_cf65d098:

    # "I get ready and text Bai the address, then about an hour later we're sitting down to eat at The Grotto."
    "Hazırlanıp Bai'ye adresi mesaj attım, yaklaşık bir saat sonra The Grotto'da yemek yemeye oturduk."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:35
translate turkish baigrottodate_79872e14:

    # bai "That sounds great. Are we going to get all dressed up in suits and stuff?"
    bai "Kulağa harika geliyor. Takım elbise falan giyip şık mı giyineceğiz?"

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:36
translate turkish baigrottodate_a9dc377e:

    # pc "Damn right, we are."
    pc "Tabii ki giyeceğiz."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:38
translate turkish baigrottodate_bfaba4a8:

    # bai "Oh man. I have to find my suit then. I know I have one in the closet somewhere."
    bai "Of be. O zaman takım elbisemi bulmam lazım. Dolabımın bir yerinde bir tane olduğunu biliyorum."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:39
translate turkish baigrottodate_b5cc83ae:

    # bai "I'll go find it."
    bai "Gidip bulacağım."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:40
translate turkish baigrottodate_ffb27a81:

    # pc "Okay. Send me a text when you're ready and I'll come pick you up, okay?"
    pc "Tamam. Hazır olduğunda bana mesaj at, gelip seni alayım, tamam mı?"

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:42
translate turkish baigrottodate_9e815b71:

    # bai "Okay! I'm really excited!"
    bai "Tamam! Çok heyecanlıyım!"

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:43
translate turkish baigrottodate_f07574ec:

    # pc "Good."
    pc "Güzel."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:44
translate turkish baigrottodate_412f6c55:

    # bai "Okay, see you in a bit."
    bai "Tamam, birazdan görüşürüz."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:47
translate turkish baigrottodate_9bcd7a72:

    # "I get ready to go and wait for Bai's text."
    "Çıkmaya hazırlanıp Bai'nin mesajını bekliyorum."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:48
translate turkish baigrottodate_9173db50:

    # "About an hour later, he texts me and I go pick him up, then we walk into The Grotto together."
    "Yaklaşık bir saat sonra bana mesaj atıyor, ben de onu almaya gidiyorum, sonra birlikte The Grotto'ya giriyoruz."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:51
translate turkish baigrottodate_9131d6c6:

    # bai "Sounds good! I'll see you there."
    bai "Kulağa hoş geliyor! Orada görüşürüz."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:52
translate turkish baigrottodate_5d3d77d3:

    # pc "Cool. See you."
    pc "Harika. Görüşürüz."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:54
translate turkish baigrottodate_299409d0:

    # bai "That sounds great! I'll start getting ready. Come get me."
    bai "Harika! Hazırlanmaya başlayayım. Gel de beni al."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:55
translate turkish baigrottodate_e3948ee8:

    # pc "Alright, I'll be there in a bit."
    pc "Tamam, birazdan oradayım."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:69
translate turkish baigrottostartdate_ba211ff8:

    # "We walk in together, holding hands."
    "El ele tutuşarak içeri giriyoruz."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:70
translate turkish baigrottostartdate_fb0e2e4f:

    # bai "This feels very public. More public than we usually are."
    bai "Bu çok halka açık bir ortam gibi geliyor. Her zamankinden daha halka açık."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:71
translate turkish baigrottostartdate_a674eec0:

    # pc "Are you okay with that?"
    pc "Senin için sorun olur mu?"

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:72
translate turkish baigrottostartdate_023cf823:

    # bai "Yeah, with you, I think I am."
    bai "Evet, seninle birlikteyken sorun olmaz sanırım."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:73
translate turkish baigrottostartdate_e39c1441:

    # pc "Good. You look like a fucking stud right now. I'm proud to be here with you."
    pc "Güzel. Şu anda tam bir yakışıklısın. Seninle burada olmaktan gurur duyuyorum."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:74
translate turkish baigrottostartdate_bb37df29:

    # bai "Me too."
    bai "Ben de."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:81
translate turkish baigrottostartdate_a5785e55:

    # "We sit at a table and begin looking over the menus."
    "Bir masaya oturup menüleri incelemeye başlıyoruz."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:82
translate turkish baigrottostartdate_a395082c:

    # "Then a server comes by and takes our order."
    "Sonra bir garson gelip siparişlerimizi alıyor."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:91
translate turkish baigrottostartdate_32733c2f:

    # "After we chat for a while, our food is brought out."
    "Bir süre sohbet ettikten sonra yemeklerimiz geliyor."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:92
translate turkish baigrottostartdate_501f942a:

    # bai "Wow, this looks amazing."
    bai "Vay canına, bu harika görünüyor."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:98
translate turkish baigrottostartdate_28b42b01:

    # "We continue chatting while we eat our meal. Just hanging out and enjoying some good food together."
    "Yemeğimizi yerken sohbet etmeye devam ediyoruz. Sadece takılıp birlikte güzel bir yemeğin tadını çıkarıyoruz."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:101
translate turkish baigrottostartdate_7150c85d:

    # "When we're done eating, we split the bill and say our goodbyes."
    "Yemeğimizi bitirdiğimizde hesabı bölüşüp vedalaşıyoruz."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:105
translate turkish baigrottostartdate_25d6d119:

    # bai "That was fun, man. Good food. Thanks for inviting me."
    bai "Çok eğlenceliydi dostum. Yemek harikaydı. Davet ettiğin için teşekkürler."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:106
translate turkish baigrottostartdate_0c975e99:

    # pc "No problem. Good to hang out and talk for a while."
    pc "Önemli değil. Bir süre takılıp sohbet etmek güzeldi."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:107
translate turkish baigrottostartdate_49b45846:

    # bai "Yeah it was."
    bai "Evet, öyleydi."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:108
translate turkish baigrottostartdate_01c7ca57:

    # bai "Alright, well I'll see you later. Take care."
    bai "Tamam, peki, sonra görüşürüz. Kendine iyi bak."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:109
translate turkish baigrottostartdate_22fbafdc:

    # pc "You too. See ya."
    pc "Sen de. Görüşürüz."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:112
translate turkish baigrottostartdate_0c8ca28d:

    # "We get in our cars and go our separate directions."
    "Arabalarımıza biniyoruz ve ayrı yönlere gidiyoruz."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:120
translate turkish baigrottostartdate_bfde7d54:

    # "We continue chatting and eating."
    "Sohbet etmeye ve yemek yemeye devam ediyoruz."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:126
translate turkish baigrottostartdate_1ef0c0b5:

    # "Bai insists that we split the bill, then we get ready to leave."
    "Bai hesabı bölüşmemiz konusunda ısrar ediyor, sonra da çıkmaya hazırlanıyoruz."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:132
translate turkish baigrottostartdate_ca01422f:

    # bai "It's so pretty out here, isn't it?"
    bai "Burası çok güzel, değil mi?"

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:133
translate turkish baigrottostartdate_44eeaf1a:

    # pc "Yeah it is."
    pc "Evet, öyle."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:139
translate turkish baigrottostartdate_7c70709c:

    # "I lean in and kiss him, uncaring about anybody who might be watching us."
    "Etrafta bizi izleyenler olup olmadığını umursamadan ona doğru eğilip öpüyorum."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:140
translate turkish baigrottostartdate_61700a7a:

    # "He is surprised at first, but doesn't pull away."
    "İlk başta şaşırıyor ama geri çekilmiyor."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:143
translate turkish baigrottostartdate_4a0dd6f7:

    # bai "I can't believe I just did that. Right in front of everybody."
    bai "Az önce bunu yaptığıma inanamıyorum. Hem de herkesin gözü önünde."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:144
translate turkish baigrottostartdate_6e718b73:

    # pc "How did it feel?"
    pc "Nasıl hissettin?"

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:145
translate turkish baigrottostartdate_3696af55:

    # bai "It felt great."
    bai "Harikaydı."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:150
translate turkish baigrottostartdate_d90b231d:

    # bai "Want to go back to my apartment now?"
    bai "Şimdi benim daireme gitmek ister misin?"

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:153
translate turkish baigrottostartdate_4861bda5:

    # bai "Aw, okay. Well it was a good date, anyway. Thanks for bringing me."
    bai "Ah, tamam. Neyse, yine de güzel bir randevuydu. Beni getirdiğin için teşekkürler."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:156
translate turkish baigrottostartdate_29d9625f:

    # "We leave and I drive him to his aparment and say goodbye."
    "Ayrılıyoruz, onu dairesine kadar arabayla götürüp vedalaşıyorum."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:157
translate turkish baigrottostartdate_f1413fe1:

    # "Then I drive away to do something else with my night."
    "Sonra geceyi başka bir şeyle geçirmek için oradan ayrılıyorum."

# game/Scenes/Bai/BaiDates/baigrottodate.rpy:164
translate turkish baigrottostartdate_ebdfbc55:

    # "We rush out to the car and drive back to his apartment."
    "Hemen arabaya atlayıp onun dairesine geri dönüyoruz."

translate turkish strings:

    # game/Scenes/Bai/BaiDates/baigrottodate.rpy:2
    old "After you have gone out to The Grotto with Whitney, you'll unlock it for other characters."
    new "Whitney ile The Grotto'ya gittikten sonra, diğer karakterler için de burayı açmış olacaksın."

    # game/Scenes/Bai/BaiDates/baigrottodate.rpy:3
    old "Call Bai in the evening and invite him to The Grotto. If you're on the romance path with Bai, you'll need to have pizza at his place before this option is available."
    new "Akşam Bai'yi ara ve onu The Grotto'ya davet et. Bai ile romantizm yolunda ilerliyorsan, bu seçeneğin kullanılabilir hale gelmesi için önce onun evinde pizza yemen gerekecek."

    # game/Scenes/Bai/BaiDates/baigrottodate.rpy:161
    old "Yeah, let's go"
    new "Tamam, gidelim"

