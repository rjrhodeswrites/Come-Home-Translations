# game/Scenes/Bai/BaiDates/baimoviedate.rpy:25
translate turkish baimovietheaterstartdate_13ddb197:

    # "We get to the theater and find seats in the back."
    "Sinemaya varıyoruz ve arkada yer buluyoruz."

# game/Scenes/Bai/BaiDates/baimoviedate.rpy:26
translate turkish baimovietheaterstartdate_7b36967b:

    # "We chat for a while before the movie starts."
    "Film başlamadan önce bir süre sohbet ediyoruz."

# game/Scenes/Bai/BaiDates/baimoviedate.rpy:31
translate turkish baimovietheaterstartdate_592835a4:

    # "Finally the movie starts up and we go silent."
    "Sonunda film başlıyor ve sessizleşiyoruz."

# game/Scenes/Bai/BaiDates/baimoviedate.rpy:33
translate turkish baimovietheaterstartdate_aee76b2d:

    # "The trailers take up about fifteen minutes, then the movie really gets started."
    "Fragmanlar yaklaşık on beş dakika sürüyor, ardından film asıl olarak başlıyor."

# game/Scenes/Bai/BaiDates/baimoviedate.rpy:35
translate turkish baimovietheaterstartdate_5e17c29c:

    # "It's a pretty good movie and we laugh all the way through it."
    "Oldukça iyi bir film ve baştan sona gülüyoruz."

# game/Scenes/Bai/BaiDates/baimoviedate.rpy:37
translate turkish baimovietheaterstartdate_a2905b6a:

    # "After the movie ends, we hang out and chat through the credits."
    "Film bittikten sonra, jeneriği izlerken takılıp sohbet ediyoruz."

# game/Scenes/Bai/BaiDates/baimoviedate.rpy:42
translate turkish baimovietheaterstartdate_edff30b2:

    # "When the credits end, we walk outside together to my car."
    "Jenerik bittiğinde, birlikte dışarı çıkıp arabama doğru yürüyoruz."

