# game/Scenes/Bai/bai2.rpy:10
translate turkish bai2_98ca1a51:

    # "My phone buzzes in my pocket."
    "Cebimdeki telefonum titriyor."

# game/Scenes/Bai/bai2.rpy:14
translate turkish bai2_a13b13a8:

    # "It's Bai. I guess I have time to chat a bit."
    "Arayan Bai. Sanırım biraz sohbet edecek vaktim var."

# game/Scenes/Bai/bai2.rpy:17
translate turkish bai2_c0d6b27a:

    # pc "Hey Bai, what's up?"
    pc "Selam Bai, naber?"

# game/Scenes/Bai/bai2.rpy:18
translate turkish bai2_ca2e0cd6:

    # bai "Hey, [pcname]. I was just lying here bored and wondered what you were up to?"
    bai "Selam, [pcname]. Burada sıkılmış yatıyordum da, ne yapıyorsun diye merak ettim?"

# game/Scenes/Bai/bai2.rpy:19
translate turkish bai2_f020dde3:

    # pc "Just getting ready for bed, but I can talk for a while."
    pc "Yatmaya hazırlanıyordum ama bir süre konuşabilirim."

# game/Scenes/Bai/bai2.rpy:20
translate turkish bai2_b9768b08:

    # bai "That's cool. I've just been thinking a lot."
    bai "Harika. Son zamanlarda çok düşünüyordum da."

# game/Scenes/Bai/bai2.rpy:21
translate turkish bai2_e61255db:

    # pc "About what?"
    pc "Ne hakkında?"

# game/Scenes/Bai/bai2.rpy:23
translate turkish bai2_67224ed1:

    # bai "Just stuff mostly."
    bai "Çoğunlukla ufak tefek şeyler."

# game/Scenes/Bai/bai2.rpy:24
translate turkish bai2_19828c08:

    # pc "You're going to have to be a little more specific than that or this conversation isn't going to go anywhere."
    pc "Biraz daha net olman gerek yoksa bu sohbet bir yere varamayacak."

# game/Scenes/Bai/bai2.rpy:25
translate turkish bai2_64de84cd:

    # bai "Okay, well."
    bai "Tamam, peki."

# game/Scenes/Bai/bai2.rpy:26
translate turkish bai2_d7d9d996:

    # bai "I uh... I've only dated girls in the past."
    bai "Şey... Geçmişte sadece kızlarla çıktım."

# game/Scenes/Bai/bai2.rpy:27
translate turkish bai2_36470b3e:

    # bai "I've had sex and stuff. With girls."
    bai "Seks falan yaptım. Kızlarla."

# game/Scenes/Bai/bai2.rpy:28
translate turkish bai2_41c2c9e2:

    # bai "But uh... I think I might be into guys too."
    bai "Ama şey... Sanırım erkeklerden de hoşlanıyor olabilirim."

# game/Scenes/Bai/bai2.rpy:30
translate turkish bai2_8833a2ab:

    # pc "So, you're bisexual?"
    pc "Yani biseksüel misin?"

# game/Scenes/Bai/bai2.rpy:31
translate turkish bai2_61b09772:

    # bai "Maybe?"
    bai "Belki?"

# game/Scenes/Bai/bai2.rpy:32
translate turkish bai2_0e63d7c1:

    # bai "What about you? Are you into guys at all?"
    bai "Peki ya sen? Erkeklerden hoşlanıyor musun?"

# game/Scenes/Bai/bai2.rpy:36
translate turkish bai2_bde64ebd:

    # bai "Oh okay. I thought maybe we had a thing. It's okay though."
    bai "Ah tamam. Belki aramızda bir şey olabilir diye düşünmüştüm. Ama sorun değil."

# game/Scenes/Bai/bai2.rpy:37
translate turkish bai2_0fe323b5:

    # pc "Sorry, man. Chicks only for me."
    pc "Üzgünüm dostum. Ben sadece kızlardan hoşlanırım."

# game/Scenes/Bai/bai2.rpy:38
translate turkish bai2_83d8b883:

    # bai "It's cool. I understand."
    bai "Sorun değil. Anlıyorum."

# game/Scenes/Bai/bai2.rpy:40
translate turkish bai2_ecf05d77:

    # bai "Still friends though?"
    bai "Yine de arkadaş kalabilir miyiz?"

# game/Scenes/Bai/bai2.rpy:41
translate turkish bai2_71d4cebe:

    # pc "Sure, we're still friends."
    pc "Tabii, hâlâ arkadaşız."

# game/Scenes/Bai/bai2.rpy:44
translate turkish bai2_e26b3f90:

    # bai "Cool."
    bai "Harika."

# game/Scenes/Bai/bai2.rpy:47
translate turkish bai2_b66cc0ac:

    # bai "Really? I thought maybe we had a thing, but I wasn't sure."
    bai "Gerçekten mi? Belki aramızda bir şeyler olabileceğini düşünmüştüm, ama emin değildim."

# game/Scenes/Bai/bai2.rpy:49
translate turkish bai2_f39ae0a2:

    # bai "Are you into me?"
    bai "Benden hoşlanıyor musun?"

# game/Scenes/Bai/bai2.rpy:53
translate turkish bai2_99a03550:

    # bai "That makes me so happy."
    bai "Bu beni çok mutlu etti."

# game/Scenes/Bai/bai2.rpy:55
translate turkish bai2_99b1838b:

    # bai "So do you maybe want to actually go on a date sometime?"
    bai "Peki, belki bir ara gerçekten bir randevuya çıkmak ister misin?"

# game/Scenes/Bai/bai2.rpy:56
translate turkish bai2_39757b54:

    # pc "Yeah, let's do it."
    pc "Evet, hadi yapalım."

# game/Scenes/Bai/bai2.rpy:57
translate turkish bai2_8c98f2da:

    # bai "Okay, just give me a call in the evening sometime then. I'm available almost every day."
    bai "Tamam, o zaman bir akşam beni ara. Neredeyse her gün boşum."

# game/Scenes/Bai/bai2.rpy:58
translate turkish bai2_58a87bc2:

    # pc "Sounds good. I'm looking forward to it."
    pc "Kulağa hoş geliyor. Sabırsızlıkla bekliyorum."

# game/Scenes/Bai/bai2.rpy:59
translate turkish bai2_10a70856:

    # bai "Me too. Really."
    bai "Ben de. Gerçekten."

# game/Scenes/Bai/bai2.rpy:60
translate turkish bai2_4d74a398:

    # bai "This is new territory for me, but I'm really looking forward to exploring it with you."
    bai "Bu benim için yeni bir alan, ama seninle birlikte keşfetmeyi gerçekten dört gözle bekliyorum."

# game/Scenes/Bai/bai2.rpy:63
translate turkish bai2_c0a43543:

    # bai "Oh, so you're into guys, but you're not into me."
    bai "Ah, demek erkeklerden hoşlanıyorsun, ama benden hoşlanmıyorsun."

# game/Scenes/Bai/bai2.rpy:64
translate turkish bai2_27247fe1:

    # bai "Gotta say, that hurts man."
    bai "Söylemeliyim ki, bu canımı yaktı dostum."

# game/Scenes/Bai/bai2.rpy:65
translate turkish bai2_c31c7975:

    # pc "Sorry, just being honest."
    pc "Üzgünüm, sadece dürüst oluyorum."

# game/Scenes/Bai/bai2.rpy:66
translate turkish bai2_40a3eff2:

    # bai "Yeah okay. Well that sucks."
    bai "Evet, tamam. Bu çok kötü."

# game/Scenes/Bai/bai2.rpy:67
translate turkish bai2_0cce2b18:

    # pc "We can still be friends though."
    pc "Yine de arkadaş kalabiliriz."

# game/Scenes/Bai/bai2.rpy:68
translate turkish bai2_46106a33:

    # bai "Yeah, okay. I'm going to bed."
    bai "Evet, tamam. Ben yatmaya gidiyorum."

# game/Scenes/Bai/bai2.rpy:70
translate turkish bai2_14a17911:

    # "He hangs up. I guess that didn't go so well."
    "Telefonu kapattı. Sanırım pek iyi gitmedi."

# game/Scenes/Bai/bai2.rpy:71
translate turkish bai2_a0d6f0f3:

    # "Oh well. He'll get over it. Or not, whatever."
    "Neyse. Aşar bunu. Ya da aşmaz, neyse ne."

# game/Scenes/Bai/bai2.rpy:72
translate turkish bai2_ef88129a:

    # "I put the phone away and get ready for bed."
    "Telefonu bir kenara koyup yatmaya hazırlanıyorum."

# game/Scenes/Bai/bai2.rpy:75
translate turkish bai2_17d3424c:

    # "We chat a little longer about our days, until we are both tired."
    "İkimiz de yorulana kadar günümüz hakkında biraz daha sohbet ediyoruz."

# game/Scenes/Bai/bai2.rpy:77
translate turkish bai2_3898d259:

    # bai "I better get some sleep man."
    bai "Artık biraz uyusam iyi olacak dostum."

# game/Scenes/Bai/bai2.rpy:78
translate turkish bai2_89c07fc5:

    # bai "I'll talk to you later."
    bai "Sonra konuşuruz."

# game/Scenes/Bai/bai2.rpy:79
translate turkish bai2_d2381b62:

    # pc "Okay. See ya, Bai."
    pc "Tamam. Görüşürüz Bai."

# game/Scenes/Bai/bai2.rpy:82
translate turkish bai2_52d6e3cf:

    # "We hang up and I get ready for bed."
    "Telefonu kapatıyoruz ve ben yatmaya hazırlanıyorum."

