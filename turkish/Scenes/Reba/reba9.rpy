translate turkish reba9_4a2deb47:

    # "My phone starts buzzing. Reba is calling."
    "Telefonum titremeye başlıyor. Reba arıyor."

# game/Scenes/Reba/reba9.rpy:9
translate turkish reba9_62aee7f1:

    # rb "Hey, [pcname]. You know how we talked about hanging out in town some time?"
    rb "Selam, [pcname]. Bir ara şehirde takılmaktan bahsetmiştik, hatırlıyor musun?"

# game/Scenes/Reba/reba9.rpy:10
translate turkish reba9_28c6d658:

    # rb "Are you busy right now? I'm really craving a burger."
    rb "Şu anda meşgul müsün? Canım hamburger çekiyor da."

# game/Scenes/Reba/reba9.rpy:14
translate turkish reba9_15d1a1d2:

    # rb "Awesome! I'll meet you at Jackson Burger, alright?"
    rb "Harika! Jackson Burger'da buluşalım, olur mu?"

# game/Scenes/Reba/reba9.rpy:15
translate turkish reba9_b0ab0038:

    # pc "Sounds good. See you there."
    pc "Kulağa hoş geliyor. Orada görüşürüz."

# game/Scenes/Reba/reba9.rpy:19
translate turkish reba9_e23feda5:

    # rb "Aw alright. Well if you change your mind, just give me a call sometime."
    rb "Tamam, peki. Fikrini değiştirirsen, ara sıra beni ara."

# game/Scenes/Reba/reba9.rpy:20
translate turkish reba9_24b552e3:

    # rb "I'm available most evenings."
    rb "Çoğu akşam boşum."

# game/Scenes/Reba/reba9.rpy:21
translate turkish reba9_64c8cb1f:

    # pc "Okay, I will."
    pc "Tamam, ararım."

# game/Scenes/Reba/reba9.rpy:22
translate turkish reba9_e0e1ea50:

    # rb "See you later, [pcname]."
    rb "Görüşürüz, [pcname]."

# game/Scenes/Reba/reba9.rpy:34
translate turkish reba9b_0e02b106:

    # "My phone buzzes. It looks like I got a text from Reba."
    "Telefonum titriyor. Reba'dan bir mesaj gelmiş gibi görünüyor."

# game/Scenes/Reba/reba9.rpy:49
translate turkish reba9b_bce9991d:

    # "Wow."
    "Vay canına."

# game/Scenes/Reba/reba9.rpy:53
translate turkish reba9b_ab930a7e:

    # "Just wow."
    "Tek kelimeyle vay canına."

# game/Scenes/Reba/reba9.rpy:59
translate turkish reba9b_cb625026:

    # "I put the phone away and go to sleep, thinking about burying my face between those big tits."
    "Telefonu bir kenara koyup uykuya dalıyorum, o kocaman göğüslerin arasına yüzümü gömmek hayalini kurarak."

translate turkish strings:

    # game/Scenes/Reba/reba9.rpy:26
    old "A few days after you go mudding with Reba, she will call and ask if you want to go out for a burger."
    new "Reba'yla çamur banyosuna gittikten birkaç gün sonra, seni arayıp hamburger yemeye çıkmak ister misin diye soracak."

    # game/Scenes/Reba/reba9.rpy:27
    old "Go on the date with her and she will send you a text at night."
    new "Onunla randevuya çık, gece sana bir mesaj gönderecek."

