    "Sürücü koltuğuna oturup arabayı çalıştırıyorum, akşamımın geri kalanını nasıl geçireceğime henüz karar vermedim."

# game/Scenes/Reba/reba1.rpy:15
translate turkish reba1_ed1fbe56:

    # "Then my phone starts buzzing."
    "Sonra telefonum titremeye başlıyor."

# game/Scenes/Reba/reba1.rpy:21
translate turkish reba1_36a0a4e9:

    # "I'm not sure who it is, but it's a local number."
    "Kim olduğunu bilmiyorum ama yerel bir numara."

# game/Scenes/Reba/reba1.rpy:24
translate turkish reba1_bea5e8cb:

    # pc "Hello?"
    pc "Alo?"

# game/Scenes/Reba/reba1.rpy:25
translate turkish reba1_421c326c:

    # "Unknown" "Hi, is this [pcname]?"
    "Unknown" "Merhaba, [pcname] mi?"

# game/Scenes/Reba/reba1.rpy:26
translate turkish reba1_206fe9f8:

    # pc "Uh yes, who is this?"
    pc "Evet, kimsiniz?"

# game/Scenes/Reba/reba1.rpy:28
translate turkish reba1_3f54ba94:

    # rb "Hey! This is Reba, the pretty gal you helped on the side of the road."
    rb "Selam! Ben Reba, yol kenarında yardım ettiğin o güzel kız."

# game/Scenes/Reba/reba1.rpy:29
translate turkish reba1_514501a6:

    # pc "Oh yeah! Hey, how are you?"
    pc "Ah evet! Selam, nasılsın?"

# game/Scenes/Reba/reba1.rpy:30
translate turkish reba1_b20d36aa:

    # rb "I'm pretty dang good. I bet you thought I weren't gonna call you, huh?"
    rb "Oldukça iyiyim. Seni aramayacağımı düşündün herhalde, değil mi?"

# game/Scenes/Reba/reba1.rpy:31
translate turkish reba1_3a31a86c:

    # pc "I wasn't sure."
    pc "Emin değildim."

# game/Scenes/Reba/reba1.rpy:32
translate turkish reba1_12c083c1:

    # rb "Well I wanted to invite you over for dinner."
    rb "Seni akşam yemeğine davet etmek istedim."

# game/Scenes/Reba/reba1.rpy:33
translate turkish reba1_f8d534ae:

    # pc "Tonight?"
    pc "Bu akşam mı?"

# game/Scenes/Reba/reba1.rpy:34
translate turkish reba1_fb6d5a5d:

    # rb "Yeah, man. Right now."
    rb "Evet dostum. Hemen şimdi."

# game/Scenes/Reba/reba1.rpy:38
translate turkish reba1_44a6bff6:

    # "Reba was calling me again."
    "Reba yine arıyordu."

# game/Scenes/Reba/reba1.rpy:41
translate turkish reba1_bea5e8cb_1:

    # pc "Hello?"
    pc "Alo?"

# game/Scenes/Reba/reba1.rpy:42
translate turkish reba1_13d5d84f:

    # rb "Hey, [pcname]. It's Reba."
    rb "Selam, [pcname]. Ben Reba."

# game/Scenes/Reba/reba1.rpy:43
translate turkish reba1_e10d698c:

    # rb "Just wonderin' if you wanna come over for some dinner?"
    rb "Akşam yemeğine gelmek ister misin diye merak ediyordum da?"

# game/Scenes/Reba/reba1.rpy:46
translate turkish reba1_26c5da0f:

    # rb "Yay! I'll text you directions to my house okay?"
    rb "Yaşasın! Sana evimin yol tarifini mesaj atarım, tamam mı?"

# game/Scenes/Reba/reba1.rpy:47
translate turkish reba1_9ef2f77e:

    # rb "It's out in the middle of nowhere, so just give me a call if you get lost."
    rb "Evim ıssız bir yerde, yolunu kaybedersen beni ara."

# game/Scenes/Reba/reba1.rpy:48
translate turkish reba1_5f7c28c5:

    # pc "Alright."
    pc "Tamam."

# game/Scenes/Reba/reba1.rpy:49
translate turkish reba1_4d98be45:

    # rb "See you when you get here!"
    rb "Geldiğinde görüşürüz!"

# game/Scenes/Reba/reba1.rpy:51
translate turkish reba1_baffae44:

    # rb "You busy? Alrighty, well I'll try you again some other night."
    rb "Meşgul müsün? Tamam o zaman, başka bir gece tekrar ararım."

# game/Scenes/Reba/reba1.rpy:52
translate turkish reba1_050f909c:

    # pc "Sounds good."
    pc "Olur."

# game/Scenes/Reba/reba1.rpy:53
translate turkish reba1_62d03f6c:

    # rb "Alright, talk to you later, [pcname]."
    rb "Tamam, sonra konuşuruz, [pcname]."

# game/Scenes/Reba/reba1.rpy:58
translate turkish reba1_96642d84:

    # rb "Oh really? Well alright then."
    rb "Öyle mi? Peki o zaman."

# game/Scenes/Reba/reba1.rpy:59
translate turkish reba1_31a3112c:

    # rb "I thought you were a good fella, but I guess Mama was right when she said that city-boys were assholes."
    rb "İyi bir adam olduğunu sanmıştım, ama sanırım annem şehirli erkeklerin pislik olduğunu söylerken haklıymış."

# game/Scenes/Reba/reba1.rpy:60
translate turkish reba1_97e52919:

    # rb "Bye, [pcname]."
    rb "Hoşça kal, [pcname]."

# game/Scenes/Reba/reba1.rpy:62
translate turkish reba1_acd799d7:

    # "She hangs up. I guess that relationship isn't going anywhere else."
    "Telefonu kapattı. Sanırım bu ilişki bir yere varmayacak."

# game/Scenes/Reba/reba1.rpy:63
translate turkish reba1_e6e74926:

    # "Oh well. I'm not interested in her anyways. Already moved on."
    "Neyse. Zaten ona ilgim yoktu. Çoktan başka birine geçtim."

# game/Scenes/Reba/reba1.rpy:68
translate turkish reba1_a0107be8:

    # "We hang up and she texts me not too long after with detailed directions using landmarks to get to her house."
    "Telefonu kapattık ve kısa bir süre sonra bana, evine ulaşmak için önemli noktaları kullanarak ayrıntılı yol tarifi içeren bir mesaj attı."

# game/Scenes/Reba/reba1.rpy:69
translate turkish reba1_4b1ef2e9:

    # "It takes about 20 minutes of following her complicated instructions before I pull into a long driveway out in the middle of nowhere that leads up to a trailer house."
    "Onun karmaşık talimatlarını takip ederek yaklaşık 20 dakika sonra, ıssız bir yerde, bir karavana çıkan uzun bir araba yoluna girdim."

# game/Scenes/Reba/reba1.rpy:70
translate turkish reba1_b44e99ff:

    # "I know it is her house because of that old truck that's parked out front. But there are several other vehicles too."
    "Önünde park etmiş o eski kamyonet sayesinde burasının onun evi olduğunu anladım. Ama birkaç başka araç da vardı."

# game/Scenes/Reba/reba1.rpy:72
translate turkish reba1_b23c5ca9:

    # "I park and step out, walking towards the front door."
    "Arabayı park edip dışarı çıkıyorum ve ön kapıya doğru yürüyorum."

# game/Scenes/Reba/reba1.rpy:76
translate turkish reba1_ebd5eabf:

    # "Before I take two steps, a crazed looking man with a gun rushes out the front door of the trailer and charges towards me."
    "İki adım atamadan, elinde silah olan çılgın görünümlü bir adam karavanın ön kapısından dışarı fırlayıp bana doğru hücum ediyor."

# game/Scenes/Reba/reba1.rpy:77
translate turkish reba1_e2aed0f3:

    # "I nearly piss my pants right there."
    "Orada neredeyse altıma işeyecektim."

# game/Scenes/Reba/reba1.rpy:78
translate turkish reba1_d8766968:

    # "Man" "What'chu doin' on my property boy?"
    "Man" "Benim arazimde ne işin var evlat?"

# game/Scenes/Reba/reba1.rpy:79
translate turkish reba1_1939bcec:

    # pc "Uh Reba..."
    pc "Şey, Reba..."

# game/Scenes/Reba/reba1.rpy:80
translate turkish reba1_be8f8d66:

    # "Man" "We dun want nun of yer kind out here, now git!"
    "Man" "Senin gibileri burada istemiyoruz, şimdi defol!"

# game/Scenes/Reba/reba1.rpy:81
translate turkish reba1_0976b26b:

    # pc "Okay I'm leaving, sorry! Don't shoot me."
    pc "Tamam, gidiyorum, özür dilerim! Bana ateş etme."

# game/Scenes/Reba/reba1.rpy:86
translate turkish reba1_e495c8b9:

    # "The trailer door bangs open and Reba rushes down towards me."
    "Karavanın kapısı güm diye açılır ve Reba bana doğru koşar."

# game/Scenes/Reba/reba1.rpy:87
translate turkish reba1_cb77e722:

    # rb "Mickey! Put the dang gun down and quit scarin' my friend."
    rb "Mickey! Şu lanet silahı indir de arkadaşımı korkutmayı kes."

# game/Scenes/Reba/reba1.rpy:88
translate turkish reba1_20066a90:

    # rb "[pcname], this is my brother Mickey. He's just being a dillweed."
    rb "[pcname], bu benim kardeşim Mickey. Sadece aptalca davranıyor."

# game/Scenes/Reba/reba1.rpy:90
translate turkish reba1_45c24e71:

    # mk "Aw sis, I's just havin' sum fun wit' the city slicker."
    mk "Ah abla, ben sadece bu şehirliyle biraz eğleniyordum."

# game/Scenes/Reba/reba1.rpy:91
translate turkish reba1_c189b955:

    # rb "You just get yer butt back inside. Food's almost done."
    rb "Hemen içeri gir. Yemek neredeyse hazır."

# game/Scenes/Reba/reba1.rpy:92
translate turkish reba1_52b573db:

    # mk "Yeah, yeah."
    mk "Evet, evet."

# game/Scenes/Reba/reba1.rpy:97
translate turkish reba1_7a9d2a35:

    # rb "Hey, [pcname]. Sorry if he scared ya. He's kind of a pain in the butt."
    rb "Hey, [pcname]. Seni korkuttuysa özür dilerim. O biraz baş belasıdır."

# game/Scenes/Reba/reba1.rpy:98
translate turkish reba1_803406e3:

    # pc "I'm okay, I think."
    pc "Sanırım iyiyim."

# game/Scenes/Reba/reba1.rpy:100
translate turkish reba1_8cc849fe:

    # rb "Well, this is my house. I live here with Mickey and Mama."
    rb "Eh, burası benim evim. Burada Mickey ve annemle yaşıyorum."

# game/Scenes/Reba/reba1.rpy:101
translate turkish reba1_757350b7:

    # rb "It ain't much, but..."
    rb "Fazla bir şey yok ama..."

# game/Scenes/Reba/reba1.rpy:103
translate turkish reba1_d4356e5a:

    # rb "Well that's it. It just ain't much."
    rb "Evet, hepsi bu. Fazla bir şey yok işte."

# game/Scenes/Reba/reba1.rpy:104
translate turkish reba1_defbb0a2:

    # rb "Food's just about ready though. Come in and I'll introduce you to Mama."
    rb "Yemek de neredeyse hazır. İçeri gel, seni annemle tanıştırayım."

# game/Scenes/Reba/reba1.rpy:106
translate turkish reba1_4b85c32b:

    # rb "Just a warning though. She can be a little... opinionated."
    rb "Ama bir uyarı yapayım. O biraz... inatçı olabilir."

# game/Scenes/Reba/reba1.rpy:107
translate turkish reba1_a101af89:

    # pc "Uh... okay."
    pc "Ee... tamam."

# game/Scenes/Reba/reba1.rpy:110
translate turkish reba1_bb793b2d:

    # "I follow her into the trailer."
    "Onu takip ederek karavana giriyorum."

# game/Scenes/Reba/reba1.rpy:111
translate turkish reba1_16dd944d:

    # "If I had even been hungry to begin with, the smell of the place definitely diminishes my appetite."
    "Başta aç olsaydım bile, oranın kokusu kesinlikle iştahımı kaçırıyor."

# game/Scenes/Reba/reba1.rpy:112
translate turkish reba1_fd88ca50:

    # "First there is the scent of the chili, which isn't bad, but then underneath that, there is this odor that seems to be a mix of cigarettes, sweat, and maybe cat piss?"
    "Önce chili kokusu geliyor, ki o fena değil, ama onun altında sigara, ter ve belki de kedi sidiği karışımı gibi bir koku var."

# game/Scenes/Reba/reba1.rpy:116
translate turkish reba1_becbdc4b:

    # rb "Mama, this is that boy I was tellin' you about. The one who helped me out the other day."
    rb "Mama, bu sana bahsettiğim çocuk. Geçen gün bana yardım eden çocuk."

# game/Scenes/Reba/reba1.rpy:117
translate turkish reba1_a67c0e9d:

    # ma "He looks a little scrawny."
    ma "Biraz sıska görünüyor."

# game/Scenes/Reba/reba1.rpy:118
translate turkish reba1_91ba5d20:

    # rb "Be nice Mama. I think he looks mighty fine."
    rb "Kibar ol anne. Bence çok yakışıklı görünüyor."

# game/Scenes/Reba/reba1.rpy:119
translate turkish reba1_a0523121:

    # ma "I guess if you're into the skinny, hairless, type, he ain't a bad lookin' fella."
    ma "Sanırım sıska, tüysüz tiplerden hoşlanıyorsan, fena bir delikanlı sayılmaz."

# game/Scenes/Reba/reba1.rpy:120
translate turkish reba1_2517c171:

    # ma "Nice to meet you, [pcname]. You can just call me Mama."
    ma "Tanıştığımıza memnun oldum, [pcname]. Bana Mama diyebilirsin."

# game/Scenes/Reba/reba1.rpy:121
translate turkish reba1_84e32e06:

    # pc "Nice to meet you too."
    pc "Ben de tanıştığımıza memnun oldum."

# game/Scenes/Reba/reba1.rpy:124
translate turkish reba1_ea70c271:

    # "Reba walks over to the small kitchen area and stirs the chili pot."
    "Reba küçük mutfak alanına doğru yürür ve chili tenceresini karıştırır."

# game/Scenes/Reba/reba1.rpy:125
translate turkish reba1_c00a5321:

    # "I think about turning and running out the front door. The whole situation feels weird."
    "Arkamı dönüp ön kapıdan kaçmayı düşünüyorum. Bütün durum bana tuhaf geliyor."

# game/Scenes/Reba/reba1.rpy:126
translate turkish reba1_5ef6ebbf:

    # rb "I think it's done. Let's eat. Everybody sit at the table."
    rb "Sanırım pişti. Hadi yiyelim. Herkes masaya otursun."

# game/Scenes/Reba/reba1.rpy:128
translate turkish reba1_6f4092c5:

    # "I hesitantly sit at the table with Reba, Mickey, and Mama."
    "Tereddütle Reba, Mickey ve Mama'nın yanına masaya oturuyorum."

# game/Scenes/Reba/reba1.rpy:129
translate turkish reba1_9c99b88f:

    # "It's so awkward. I just want to finish eating and leave."
    "Çok garip bir durum. Sadece yemeğimi bitirip gitmek istiyorum."

# game/Scenes/Reba/reba1.rpy:130
translate turkish reba1_8d8f56b3:

    # "At least the chili is good though. Reba can definitely cook."
    "En azından chili lezzetli. Reba kesinlikle iyi yemek yapıyor."

# game/Scenes/Reba/reba1.rpy:131
translate turkish reba1_c632cc77:

    # mk "This is sum good possum chili sis."
    mk "Bu chili gerçekten çok lezzetli, kardeşim."

# game/Scenes/Reba/reba1.rpy:132
translate turkish reba1_4f104cbe:

    # "And it's ruined."
    "Ve her şey mahvoldu."

# game/Scenes/Reba/reba1.rpy:134
translate turkish reba1_a6f874ce:

    # ma "So what do you do, [pcname]?"
    ma "Peki ne iş yapıyorsun, [pcname]?"

# game/Scenes/Reba/reba1.rpy:135
translate turkish reba1_5354681b:

    # pc "I'm in college and I work as an assistant in a law office in town."
    pc "Üniversiteye gidiyorum ve kasabadaki bir hukuk bürosunda asistan olarak çalışıyorum."

# game/Scenes/Reba/reba1.rpy:136
translate turkish reba1_0af5cb0e:

    # mk "College boy AND a lawyer?"
    mk "Hem üniversiteli hem de avukat mı?"

# game/Scenes/Reba/reba1.rpy:137
translate turkish reba1_3562724d:

    # mk "You sure know how to pick 'em, Reba."
    mk "Onları nasıl seçeceğini iyi biliyorsun, Reba."

# game/Scenes/Reba/reba1.rpy:138
translate turkish reba1_7d3b9e0f:

    # ma "I never liked college folk."
    ma "Üniversiteli tipleri hiç sevmedim."

# game/Scenes/Reba/reba1.rpy:139
translate turkish reba1_030d9e4f:

    # rb "You don't even know any college folk, Mama. I already told you that I want to go to college."
    rb "Hiç üniversiteli tip tanımıyorsun ki, anne. Sana üniversiteye gitmek istediğimi zaten söylemiştim."

# game/Scenes/Reba/reba1.rpy:140
translate turkish reba1_ad161f61:

    # ma "Ain't got money for it baby."
    ma "Bunun için param yok bebeğim."

# game/Scenes/Reba/reba1.rpy:141
translate turkish reba1_08132159:

    # ma "Plus they'd just mess up your mind."
    ma "Üstelik kafanı da karıştırırlar."

# game/Scenes/Reba/reba1.rpy:142
translate turkish reba1_e2adf491:

    # ma "College is full of foreigners, gays, and liberals."
    ma "Üniversite yabancılar, eşcinseller ve liberallerle dolu."

# game/Scenes/Reba/reba1.rpy:143
translate turkish reba1_047c977e:

    # "Alright, I'm done."
    "Tamam, benden bu kadar."

# game/Scenes/Reba/reba1.rpy:146
translate turkish reba1_f0544559:

    # pc "Well it was nice to meet you all. Thanks for the dinner."
    pc "Hepinizle tanışmak güzeldi. Akşam yemeği için teşekkürler."

# game/Scenes/Reba/reba1.rpy:147
translate turkish reba1_9410a81f:

    # pc "I'm just going to head out."
    pc "Ben gidiyorum."

# game/Scenes/Reba/reba1.rpy:148
translate turkish reba1_9bc53580:

    # ma "What? We ain't done yet."
    ma "Ne? Henüz bitmedi ki."

# game/Scenes/Reba/reba1.rpy:149
translate turkish reba1_d2b96a92:

    # mk "Let him go, Mama. The little snowflake got triggered."
    mk "Bırak gitsin anne. Küçük kar tanesi sinirlendi."

# game/Scenes/Reba/reba1.rpy:152
translate turkish reba1_e7215967:

    # "I ignore them and just walk out of the trailer."
    "Onları görmezden gelip karavandan çıkıyorum."

# game/Scenes/Reba/reba1.rpy:155
translate turkish reba1_fd740709:

    # "Reba runs out after me."
    "Reba peşimden koşarak çıkıyor."

# game/Scenes/Reba/reba1.rpy:156
translate turkish reba1_fee9c8d9:

    # rb "[pcname], wait up! Please!"
    rb "[pcname], bekle! Lütfen!"

# game/Scenes/Reba/reba1.rpy:157
translate turkish reba1_dedb026e:

    # rb "I'm really sorry. This was a bad idea. I just wanted to do something nice for you and I thought my family would be okay."
    rb "Gerçekten çok üzgünüm. Bu kötü bir fikirdi. Sadece senin için güzel bir şey yapmak istedim ve ailemin sorun etmeyeceğini düşünmüştüm."

# game/Scenes/Reba/reba1.rpy:158
translate turkish reba1_3dd86291:

    # rb "Look [pcname], I know we don't really know each other well, but I like you."
    rb "Bak [pcname], birbirimizi pek iyi tanımadığımızı biliyorum, ama senden hoşlanıyorum."

# game/Scenes/Reba/reba1.rpy:159
translate turkish reba1_4cfc6b53:

    # rb "I don't really have any friends that are like you. You know... smart."
    rb "Senin gibi arkadaşlarım pek yok. Bilirsin... zeki."

# game/Scenes/Reba/reba1.rpy:160
translate turkish reba1_7f0ddb3b:

    # rb "Please don't write me off because of my family. I'm not like them, I promise."
    rb "Lütfen ailem yüzünden beni silme. Onlar gibi değilim, söz veriyorum."

# game/Scenes/Reba/reba1.rpy:162
translate turkish reba1_af6f3f2c:

    # rb "Can we please see each other again sometime? Somewhere else, away from my family?"
    rb "Lütfen bir ara tekrar görüşebilir miyiz? Ailemden uzak, başka bir yerde?"

# game/Scenes/Reba/reba1.rpy:169
translate turkish reba1_9305d4e7:

    # rb "Thank you."
    rb "Teşekkürler."

# game/Scenes/Reba/reba1.rpy:170
translate turkish reba1_db562963:

    # rb "Can I kiss you now?"
    rb "Şimdi seni öpebilir miyim?"

# game/Scenes/Reba/reba1.rpy:173
translate turkish reba1_92da6f83:

    # "I lean in and kiss her lips."
    "Eğilip dudaklarına öpücük konduruyorum."

# game/Scenes/Reba/reba1.rpy:174
translate turkish reba1_4b266ba6:

    # "They are soft, warm, and still taste a bit like possum chili."
    "Dudakları yumuşak, sıcak ve hâlâ biraz opossum chili tadı var."

# game/Scenes/Reba/reba1.rpy:176
translate turkish reba1_18d653d1:

    # rb "That was nice. I'm looking forward to seeing you again sometime, [pcname]."
    rb "Çok güzeldi. Bir ara tekrar görüşmeyi dört gözle bekliyorum, [pcname]."

# game/Scenes/Reba/reba1.rpy:177
translate turkish reba1_402e7bfc:

    # rb "Have a safe drive home, okay?"
    rb "Eve giderken dikkatli sür, tamam mı?"

# game/Scenes/Reba/reba1.rpy:178
translate turkish reba1_1daad8dd:

    # pc "Thanks. I'll see you later."
    pc "Teşekkürler. Sonra görüşürüz."

# game/Scenes/Reba/reba1.rpy:180
translate turkish reba1_97e52919_1:

    # rb "Bye, [pcname]."
    rb "Hoşça kal, [pcname]."

# game/Scenes/Reba/reba1.rpy:184
translate turkish reba1_6579a61b:

    # "Well that had been one of the worst dates that I've ever been on, but I still like Reba."
    "Bu, şimdiye kadar çıktığım en kötü randevulardan biriydi, ama yine de Reba'yı seviyorum."

# game/Scenes/Reba/reba1.rpy:185
translate turkish reba1_51e64dde:

    # "I just hope I never have to deal with her family again."
    "Umarım bir daha onun ailesiyle uğraşmak zorunda kalmam."

# game/Scenes/Reba/reba1.rpy:191
translate turkish reba1_4b628d5a:

    # rb "Okay then. I understand."
    rb "Tamam o zaman. Anlıyorum."

# game/Scenes/Reba/reba1.rpy:192
translate turkish reba1_1f8eb4cf:

    # rb "Have a safe trip home."
    rb "Eve güvenli bir yolculuk dilerim."

# game/Scenes/Reba/reba1.rpy:193
translate turkish reba1_97e52919_2:

    # rb "Bye, [pcname]."
    rb "Hoşça kal, [pcname]."

# game/Scenes/Reba/reba1.rpy:195
translate turkish reba1_cf8d6396:

    # "She turns and walks back to her house, not looking back."
    "Arkasını dönüp, geriye bakmadan evine doğru yürüyor."

# game/Scenes/Reba/reba1.rpy:196
translate turkish reba1_1ee6d168:

    # "I get into my car and drive away, glad to be done with that date."
    "Arabama biniyorum ve uzaklaşıyorum, o randevuyu atlattığıma seviniyorum."

# game/Scenes/Reba/reba1.rpy:197
translate turkish reba1_09c105b2:

    # "Reba might be fine, but it just isn't worth it to have to deal with her family."
    "Reba iyi biri olabilir, ama ailesiyle uğraşmaya değmez."

translate turkish strings:

    # game/Scenes/Reba/reba1.rpy:1
    old "A few days after you meet Reba,"
    new "Reba ile tanıştıktan birkaç gün sonra,"

    # game/Scenes/Reba/reba1.rpy:2
    old "she will call you in the evening to come eat with her family."
    new "akşamları seni arayıp ailesiyle yemeğe davet edecek."

    # game/Scenes/Reba/reba1.rpy:57
    old "I'm not interested at all"
    new "Hiç ilgilenmiyorum"

