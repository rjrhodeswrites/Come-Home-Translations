# game/Scenes/Update19/Act2/act2scene3a.rpy:25
translate turkish u19a2s3a_6d79e182:

    # "It doesn't take long before I hear her actual voice, calling out."
    "Çok geçmeden onun gerçek sesini duyuyorum, bana sesleniyor."

# game/Scenes/Update19/Act2/act2scene3a.rpy:29
translate turkish u19a2s3a_b6f125ff:

    # gg "Get the fuck away from me, you trolls!"
    gg "Benden uzak durun lan, sizi troller!"

# game/Scenes/Update19/Act2/act2scene3a.rpy:30
translate turkish u19a2s3a_91f50fe5:

    # "We come to a clearing and I see her - though she looks more like her character in Souls of War than her real life appearance."
    "Bir açıklığa varıyoruz ve onu görüyorum – gerçi gerçek hayattaki halinden çok Souls of War’daki karakterine benziyor."

# game/Scenes/Update19/Act2/act2scene3a.rpy:43
translate turkish u19a2s3a_7fe530c1:

    # "I pull out my sword and get ready to head in to fight."
    "Kılıcımı çekip savaşmaya hazırlanıyorum."

# game/Scenes/Update19/Act2/act2scene3a.rpy:45
translate turkish u19a2s3a_4a6014ee:

    # sst "Trolls... I hate trolls. Let's help her."
    sst "Troller... Trollerden nefret ederim. Hadi ona yardım edelim."

# game/Scenes/Update19/Act2/act2scene3a.rpy:47
translate turkish u19a2s3a_c989b003:

    # rb "Do you think you're going to be able to fight those things? You'll definitely need my help."
    rb "O şeylerle savaşabileceğini mi sanıyorsun? Kesinlikle benim yardımıma ihtiyacın olacak."

# game/Scenes/Update19/Act2/act2scene3a.rpy:48
translate turkish u19a2s3a_993e94f1:

    # rb "Let's do this."
    rb "Hadi yapalım şunu."

# game/Scenes/Update19/Act2/act2scene3a.rpy:50
translate turkish u19a2s3a_4ce0d393:

    # cw "Trolls. Why is it always trolls?"
    cw "Troller. Neden hep troller?"

# game/Scenes/Update19/Act2/act2scene3a.rpy:51
translate turkish u19a2s3a_112afcc5:

    # cw "I'm not holding back this time."
    cw "Bu sefer kendimi tutmayacağım."

# game/Scenes/Update19/Act2/act2scene3a.rpy:63
translate turkish u19a2s3a_0991b910:

    # "We charge in together, letting out a battle cry to grab the trolls' attention."
    "Birlikte hücum ediyoruz ve trollerin dikkatini çekmek için bir savaş çığlığı atıyoruz."

# game/Scenes/Update19/Act2/act2scene3a.rpy:65
translate turkish u19a2s3a_48878a66:

    # "I charge in, letting out a battle cry to grab the trolls' attention."
    "Hücum ediyorum ve trollerin dikkatini çekmek için bir savaş çığlığı atıyorum."

# game/Scenes/Update19/Act2/act2scene3a.rpy:87
translate turkish adrianbattleconversation1_2035d9aa:

    # gg "Thanks for the help! Who are you?"
    gg "Yardımın için teşekkürler! Kimsin sen?"

# game/Scenes/Update19/Act2/act2scene3a.rpy:88
translate turkish adrianbattleconversation1_6340393e:

    # pc "Hey Adrian. I'm [pcname]."
    pc "Selam Adrian. Ben [pcname]'im."

# game/Scenes/Update19/Act2/act2scene3a.rpy:89
translate turkish adrianbattleconversation1_450920cd:

    # gg "Wait, how do you know my name?"
    gg "Dur, adımı nereden biliyorsun?"

# game/Scenes/Update19/Act2/act2scene3a.rpy:93
translate turkish adrianbattleconversation1_c70dcaa4:

    # sst "Not really important right now. Trolls to fight."
    sst "Şu anda pek önemli değil. Savaşacak troller var."

# game/Scenes/Update19/Act2/act2scene3a.rpy:97
translate turkish adrianbattleconversation1_fca5f34c:

    # rb "Who cares!? Pay attention and let's kill these bluggars!"
    rb "Kimin umurunda!? Dikkatini ver ve hadi bu herifleri öldürelim!"

# game/Scenes/Update19/Act2/act2scene3a.rpy:101
translate turkish adrianbattleconversation1_b326ef94:

    # cw "We'll deal with that later. First, we kill trolls."
    cw "Bununla sonra ilgileniriz. Önce trolleri öldürelim."

# game/Scenes/Update19/Act2/act2scene3a.rpy:103
translate turkish adrianbattleconversation1_113539de:

    # pc "Let's get through this fight first, then I'll explain."
    pc "Önce bu savaşı atlatalım, sonra açıklarım."

# game/Scenes/Update19/Act2/act2scene3a.rpy:104
translate turkish adrianbattleconversation1_79fe09a9:

    # gg "Right! Let's do this!"
    gg "Tamam! Hadi yapalım şunu!"

# game/Scenes/Update19/Act2/act2scene3a.rpy:117
translate turkish u19a2s3a_b_b4116a01:

    # gg "That could have been bad. Thanks for showing up when you did."
    gg "Kötü sonuçlanabilirdi. Tam zamanında geldiğin için teşekkürler."

# game/Scenes/Update19/Act2/act2scene3a.rpy:118
translate turkish u19a2s3a_b_5d1eff79:

    # gg "Who are you anyway?"
    gg "Sen kimsin ki?"

# game/Scenes/Update19/Act2/act2scene3a.rpy:122
translate turkish u19a2s3a_b_4e5f032f:

    # sst "I'm Nora. Nice to meet you."
    sst "Ben Nora. Tanıştığımıza memnun oldum."

# game/Scenes/Update19/Act2/act2scene3a.rpy:123
translate turkish u19a2s3a_b_64478cd6:

    # pc "And I'm [pcname]."
    pc "Ben de [pcname]'im."

# game/Scenes/Update19/Act2/act2scene3a.rpy:127
translate turkish u19a2s3a_b_f8814411:

    # rb "I'm Reba. Your magic is so dang pretty!"
    rb "Ben Reba. Büyün çok güzel!"

# game/Scenes/Update19/Act2/act2scene3a.rpy:128
translate turkish u19a2s3a_b_64478cd6_1:

    # pc "And I'm [pcname]."
    pc "Ben de [pcname]'im."

# game/Scenes/Update19/Act2/act2scene3a.rpy:132
translate turkish u19a2s3a_b_1a145250:

    # cw "I'm Dana. Nice to meet you."
    cw "Ben Dana. Tanıştığımıza memnun oldum."

# game/Scenes/Update19/Act2/act2scene3a.rpy:133
translate turkish u19a2s3a_b_64478cd6_2:

    # pc "And I'm [pcname]."
    pc "Ben de [pcname]'im."

# game/Scenes/Update19/Act2/act2scene3a.rpy:137
translate turkish u19a2s3a_b_cb77909a:

    # pc "I'm [pcname]."
    pc "Ben [pcname]'im."

# game/Scenes/Update19/Act2/act2scene3a.rpy:140
translate turkish u19a2s3a_b_abe29e36:

    # gg "And I'm Adrian. But somehow, you already knew that."
    gg "Ben de Adrian. Ama nedense bunu zaten biliyordun."

# game/Scenes/Update19/Act2/act2scene3a.rpy:141
translate turkish u19a2s3a_b_4d841c2b:

    # gg "So... how do you know me?"
    gg "Peki... beni nereden tanıyorsun?"

# game/Scenes/Update19/Act2/act2scene3a.rpy:145
translate turkish u19a2s3a_b_9e8398d6:

    # sst "I've heard this one. I'm going to go take a dip while you explain."
    sst "Bunu daha önce duymuştum. Sen açıklarken ben gidip biraz yüzeceğim."

# game/Scenes/Update19/Act2/act2scene3a.rpy:149
translate turkish u19a2s3a_b_cc0d08f1:

    # rb "I'll let you explain this to her while I go loot the bodies."
    rb "Ben cesetleri yağmalarken bunu ona sen açıklayabilirsin."

# game/Scenes/Update19/Act2/act2scene3a.rpy:153
translate turkish u19a2s3a_b_81912442:

    # cw "I'll let you handle this. I'm going to clean up a bit."
    cw "Bunu sen hallet. Ben biraz ortalığı toplayayım."

# game/Scenes/Update19/Act2/act2scene3a.rpy:156
translate turkish u19a2s3a_b_cedc4a56:

    # "It takes some time, but I explain to Adrian about coming from another world, about the bracelet, and about the Ice Queen."
    "Biraz zaman alıyor ama Adrian'a başka bir dünyadan geldiğimi, bileziği ve Buz Kraliçesi'ni anlatıyorum."

# game/Scenes/Update19/Act2/act2scene3a.rpy:159
translate turkish u19a2s3a_b_8770d065:

    # gg "Sounds like you're on a quest. I love a good quest. I'm in."
    gg "Bir göreve çıkmış gibisin. İyi bir görevi severim. Ben de varım."

# game/Scenes/Update19/Act2/act2scene3a.rpy:160
translate turkish u19a2s3a_b_dc879346:

    # pc "That didn't take much convincing."
    pc "Pek ikna etmeye gerek kalmadı."

# game/Scenes/Update19/Act2/act2scene3a.rpy:161
translate turkish u19a2s3a_b_69959806:

    # gg "Nah, this sounds like fun."
    gg "Hayır, bu eğlenceli görünüyor."

# game/Scenes/Update19/Act2/act2scene3a.rpy:162
translate turkish u19a2s3a_b_44fb0b42:

    # gg "Besides, you came in and rescued me out of the goodness of your heart. How can I deny you my assistance now?"
    gg "Üstelik, içinden geldiği için gelip beni kurtardın. Şimdi sana yardım etmeyi nasıl reddedebilirim ki?"

# game/Scenes/Update19/Act2/act2scene3a.rpy:163
translate turkish u19a2s3a_b_38929c6b:

    # pc "After seeing the spells you were slinging, I could definitely use your help."
    pc "Kullandığın büyüler gördükten sonra, yardımına kesinlikle ihtiyacım var."

# game/Scenes/Update19/Act2/act2scene3a.rpy:166
translate turkish u19a2s3a_b_28aee061:

    # gg "Then let's get going, [pcname]. No time to waste."
    gg "O zaman yola çıkalım, [pcname]. Kaybedecek zaman yok."

# game/Scenes/Update19/Act2/act2scene3a.rpy:167
translate turkish u19a2s3a_b_a77fc863:

    # gg "We gotta get you back to your world."
    gg "Seni kendi dünyana geri götürmeliyiz."

