# game/Scenes/Update19/Act2/act2scene6.rpy:22
translate turkish u19a2s6_c3123f8f:

    # "In the morning, we pack up camp and continue walking north."
    "Sabahleyin kampı toplayıp kuzeye doğru yürümeye devam ediyoruz."

# game/Scenes/Update19/Act2/act2scene6.rpy:41
translate turkish u19a2s6_300cd3b7:

    # "Until we reach another fork in the road."
    "Ta ki yolun bir başka ayrımına gelene kadar."

# game/Scenes/Update19/Act2/act2scene6.rpy:43
translate turkish u19a2s6_9323b11f:

    # gg "So which way are we supposed to go?"
    gg "Peki hangi yöne gitmeliyiz?"

# game/Scenes/Update19/Act2/act2scene6.rpy:45
translate turkish u19a2s6_cbb43aaf:

    # sg "Well fuck! Where do we go now?"
    sg "Kahretsin! Şimdi nereye gideceğiz?"

# game/Scenes/Update19/Act2/act2scene6.rpy:47
translate turkish u19a2s6_831aa59c:

    # bn "Should I consult my books to decide which way to go? Or... left again?"
    bn "Hangi yöne gideceğimize karar vermek için kitaplarıma bakmalı mıyım? Yoksa... yine sola mı?"

# game/Scenes/Update19/Act2/act2scene6.rpy:49
translate turkish u19a2s6_e573e0aa:

    # sst "Give him a moment. He will know which way to go."
    sst "Ona biraz zaman ver. Hangi yöne gideceğini bilecektir."

# game/Scenes/Update19/Act2/act2scene6.rpy:51
translate turkish u19a2s6_9a5226cc:

    # rb "Oh, we've seen this before. He'll figure it out."
    rb "Ah, bunu daha önce de görmüştük. O bir yolunu bulacaktır."

# game/Scenes/Update19/Act2/act2scene6.rpy:53
translate turkish u19a2s6_b2231ec3:

    # cw "He will know. He senses the correct path."
    cw "O bilecektir. Doğru yolu hissediyor."

# game/Scenes/Update19/Act2/act2scene6.rpy:62
translate turkish thirdfork_5f65608b:

    # "I feel that same sensation again - like a voice I recognize calling to me, pulling me towards it."
    "Yine aynı hissi duyuyorum - sanki tanıdığım bir ses beni çağırıyor, bana doğru çekiyor."

# game/Scenes/Update19/Act2/act2scene6.rpy:67
translate turkish thirdfork_42f499c4:

    # pc "I'm not sure. I don't feel anything. I guess we just pick one and keep heading north."
    pc "Emin değilim. Hiçbir şey hissetmiyorum. Sanırım bir tanesini seçip kuzeye doğru ilerlemeye devam edeceğiz."

# game/Scenes/Update19/Act2/act2scene6.rpy:71
translate turkish thirdfork_52741011:

    # "With no idea which way to go, I just choose a path and keep walking north."
    "Hangi yöne gideceğimi bilmediğim için, bir yol seçip kuzeye doğru yürümeye devam ediyorum."

