    # rb "What the heck was that? Who's there?"
    rb "O da neydi böyle? Kim var orada?"

# game/Scenes/Update19/Act2/act2scene6c.rpy:60
translate turkish u19a2s6c_c078095b:

    # cw "I don't think we're alone out here."
    cw "Sanırım burada yalnız değiliz."

# game/Scenes/Update19/Act2/act2scene6c.rpy:62
translate turkish u19a2s6c_34ffacad:

    # "I am not alone out here."
    "Burada yalnız değilim."

# game/Scenes/Update19/Act2/act2scene6c.rpy:63
translate turkish u19a2s6c_92bc8f2c:

    # "I unsheathe my sword and hold it ready, just in case."
    "Her ihtimale karşı kılıcımı kınından çekip hazır tutuyorum."

# game/Scenes/Update19/Act2/act2scene6c.rpy:64
translate turkish u19a2s6c_1bb756e1:

    # pc "Jez?"
    pc "Jez?"

# game/Scenes/Update19/Act2/act2scene6c.rpy:69
translate turkish u19a2s6c_ab435d1a:

    # "Then it's chaos, as we are suddenly surrounded by enemies."
    "Sonra birdenbire düşmanlar tarafından kuşatıldığımız için ortalık kaosa dönüyor."

# game/Scenes/Update19/Act2/act2scene6c.rpy:71
translate turkish u19a2s6c_a6c05bcb:

    # "Then it's chaos, as I am suddenly surrounded by enemies."
    "Sonra ortalık kaosa dönüyor, çünkü birdenbire düşmanlar tarafından kuşatılıyorum."

# game/Scenes/Update19/Act2/act2scene6c.rpy:72
translate turkish u19a2s6c_77908e8b:

    # "They step out from the trees in front of and behind us."
    "Önümüzdeki ve arkamızdaki ağaçların arasından çıkıyorlar."

# game/Scenes/Update19/Act2/act2scene6c.rpy:90
translate turkish u19a2s6c_0235d083:

    # gg "There's a lot of them. We might be able to take them, but this is going to get rough."
    gg "Sayıları çok fazla. Onları alt edebilirsek de, bu iş zorlu geçecek."

# game/Scenes/Update19/Act2/act2scene6c.rpy:92
translate turkish u19a2s6c_067a076a:

    # sg "I don't know about this. There's too many of them."
    sg "Bundan emin değilim. Sayıları çok fazla."

# game/Scenes/Update19/Act2/act2scene6c.rpy:94
translate turkish u19a2s6c_f596ce83:

    # bn "The odds are not in our favor here. We are surrounded."
    bn "Şans bizim lehimizde değil. Kuşatıldık."

# game/Scenes/Update19/Act2/act2scene6c.rpy:96
translate turkish u19a2s6c_065f6b79:

    # sst "I can probably take a few of them out, but this is going to be a tough fight."
    sst "Muhtemelen birkaçını halledebilirim, ama bu zorlu bir mücadele olacak."

# game/Scenes/Update19/Act2/act2scene6c.rpy:98
translate turkish u19a2s6c_ce47fe3f:

    # rb "I'm not sure if I can clobber all of these guys. This is bad."
    rb "Bu adamların hepsini haklayabileceğimden emin değilim. Durum kötü."

# game/Scenes/Update19/Act2/act2scene6c.rpy:100
translate turkish u19a2s6c_440b233e:

    # cw "There's too many of them. This is going to be difficult."
    cw "Sayıları çok fazla. Bu iş zor olacak."

# game/Scenes/Update19/Act2/act2scene6c.rpy:102
translate turkish u19a2s6c_d557ab7d:

    # "I don't see any way of standing up against this many enemies. Not alone."
    "Bu kadar çok düşmana karşı koymanın bir yolunu göremiyorum. Tek başıma değil."

# game/Scenes/Update19/Act2/act2scene6c.rpy:105
translate turkish u19a2s6c_4f562773:

    # "Bandit" "Well aren't you pretty..."
    "Bandit" "Vay canına, ne kadar da güzelsin..."

# game/Scenes/Update19/Act2/act2scene6c.rpy:106
translate turkish u19a2s6c_d607ebbd:

    # "Bandit" "Drop your weapon and hand over all of your stuff."
    "Bandit" "Silahını bırak ve tüm eşyalarını teslim et."

# game/Scenes/Update19/Act2/act2scene6c.rpy:107
translate turkish u19a2s6c_2db1bc6b:

    # "Bandit" "Then maybe we won't fuck your face before we kill you."
    "Bandit" "O zaman belki seni öldürmeden önce suratını sikmeyiz."

# game/Scenes/Update19/Act2/act2scene6c.rpy:110
translate turkish u19a2s6c_d3f8f83f:

    # "Before I can even respond, there is a sickening crack and the man's face explodes."
    "Ben cevap bile veremeden, mide bulandırıcı bir çatırtı duyulur ve adamın yüzü patlar."

# game/Scenes/Update19/Act2/act2scene6c.rpy:114
translate turkish u19a2s6c_01e9cd43:

    # "The bandits barely realize what has happened before Jez drops in from the trees above, blasting with two glowing pistols."
    "Haydutlar ne olduğunu tam olarak kavrayamadan, Jez yukarıdaki ağaçlardan atlayarak iki parlayan tabancayla ateş açar."

# game/Scenes/Update19/Act2/act2scene6c.rpy:132
translate turkish u19a2s6c_fe432f48:

    # "The pistols crack over and over again and the bandits all fall dead around me."
    "Tabancalar defalarca patlar ve haydutların hepsi etrafımda ölü olarak yere yığılır."

# game/Scenes/Update19/Act2/act2scene6c.rpy:134
translate turkish u19a2s6c_cb1d533e:

    # "The pistols crack over and over again and the bandits all fall dead around us."
    "Tabancalar defalarca patlar ve haydutların hepsi etrafımızda ölü olarak yere yığılır."

# game/Scenes/Update19/Act2/act2scene6c.rpy:137
translate turkish u19a2s6c_fcbb048d:

    # "Then, the noise finally stops and Jez walks towards me."
    "Sonra, gürültü nihayet durur ve Jez bana doğru yürür."

# game/Scenes/Update19/Act2/act2scene6c.rpy:138
translate turkish u19a2s6c_c941ba51:

    # det "Did I hear you say my name before all of that bullshit started?"
    det "Tüm o saçmalıklar başlamadan önce adımı söylediğini mi duydum?"

# game/Scenes/Update19/Act2/act2scene6c.rpy:155
translate turkish u19a2s6c_b72bb31a:

    # pc "Uh, yeah... Wow, that was violent."
    pc "Ee, evet... Vay canına, çok şiddetliydi."

# game/Scenes/Update19/Act2/act2scene6c.rpy:156
translate turkish u19a2s6c_46a44815:

    # det "Sometimes you have to stop violence with violence."
    det "Bazen şiddeti şiddetle durdurmak gerekir."

# game/Scenes/Update19/Act2/act2scene6c.rpy:157
translate turkish u19a2s6c_6f0162f9:

    # det "How do you know my name?"
    det "Adımı nereden biliyorsun?"

# game/Scenes/Update19/Act2/act2scene6c.rpy:158
translate turkish u19a2s6c_24374ea4:

    # "I explain everything to her about the other world, the bracelet, and the Ice Queen."
    "Ona diğer dünya, bileklik ve Buz Kraliçesi hakkında her şeyi anlatıyorum."

# game/Scenes/Update19/Act2/act2scene6c.rpy:159
translate turkish u19a2s6c_25131235:

    # det "The Ice Queen... she has caused so many problems."
    det "Buz Kraliçesi... O kadar çok soruna neden oldu ki."

# game/Scenes/Update19/Act2/act2scene6c.rpy:162
translate turkish u19a2s6c_d49da151:

    # det "You'll probably need backup. I'll go with you."
    det "Muhtemelen desteğe ihtiyacın olacak. Ben de seninle geleceğim."

# game/Scenes/Update19/Act2/act2scene6c.rpy:163
translate turkish u19a2s6c_bc87b3ed:

    # pc "Thanks, Jez."
    pc "Teşekkürler, Jez."

# game/Scenes/Update19/Act2/act2scene6c.rpy:164
translate turkish u19a2s6c_2886f31b:

    # det "It feels like something I should do. Something inside me tells me that I should protect you."
    det "Bunu yapmam gerektiğini hissediyorum. İçimden bir ses, seni korumam gerektiğini söylüyor."

# game/Scenes/Update19/Act2/act2scene6c.rpy:165
translate turkish u19a2s6c_ce9e78e3:

    # pc "I'll take all the help I can get."
    pc "Alabileceğim her türlü yardıma ihtiyacım var."

# game/Scenes/Update19/Act2/act2scene6c.rpy:186
translate turkish u19a2s6c_ecc8297e:

    # "With that, Jez gathers her supplies and we continue down the path to the north."
    "Bunun üzerine Jez, malzemelerini toplar ve kuzeye doğru yola devam ederiz."

# game/Scenes/Update19/Act2/act2scene6c.rpy:188
translate turkish u19a2s6c_853e9742:

    # sst "Hi Jez. I'm Nora."
    sst "Merhaba Jez. Ben Nora."

# game/Scenes/Update19/Act2/act2scene6c.rpy:189
translate turkish u19a2s6c_787e33e0:

    # sst "Always happy to have another badass woman in the group."
    sst "Gruba bir başka sert kadın daha katılması her zaman mutluluk verici."

# game/Scenes/Update19/Act2/act2scene6c.rpy:190
translate turkish u19a2s6c_20824ddf:

    # det "Thanks for having me. I'm looking forward to seeing what you can do."
    det "Beni kabul ettiğin için teşekkürler. Neler yapabileceğini görmek için sabırsızlanıyorum."

# game/Scenes/Update19/Act2/act2scene6c.rpy:192
translate turkish u19a2s6c_66e8ad88:

    # rb "Hi Jez. My name's Reba."
    rb "Merhaba Jez. Benim adım Reba."

# game/Scenes/Update19/Act2/act2scene6c.rpy:193
translate turkish u19a2s6c_4c352005:

    # rb "I've never seen anything like your weapons there. I just swing my hammer."
    rb "Oradaki silahlarına benzer bir şey hiç görmemiştim. Ben sadece çekicimi sallıyorum."

# game/Scenes/Update19/Act2/act2scene6c.rpy:194
translate turkish u19a2s6c_5c9e4657:

    # det "I bet you can do some damage with that hammer too."
    det "Eminim o çekiciyle de epey hasar verebilirsin."

# game/Scenes/Update19/Act2/act2scene6c.rpy:195
translate turkish u19a2s6c_83664a9b:

    # rb "Sometimes. When it's necessary."
    rb "Bazen. Gerekli olduğunda."

# game/Scenes/Update19/Act2/act2scene6c.rpy:196
translate turkish u19a2s6c_b65621dc:

    # det "Yeah... it seems to be more and more necessary lately."
    det "Evet... son zamanlarda giderek daha gerekli hale geliyor gibi."

# game/Scenes/Update19/Act2/act2scene6c.rpy:197
translate turkish u19a2s6c_408cc224:

    # rb "You're telling me."
    rb "Bana mı söylüyorsun."

# game/Scenes/Update19/Act2/act2scene6c.rpy:199
translate turkish u19a2s6c_8edf6aab:

    # cw "Hi Jez. I'm Dana, by the way."
    cw "Merhaba Jez. Bu arada, ben Dana."

# game/Scenes/Update19/Act2/act2scene6c.rpy:200
translate turkish u19a2s6c_5790dd63:

    # cw "That was brutal back there. Wow."
    cw "Az önce olanlar çok acımasızdı. Vay canına."

# game/Scenes/Update19/Act2/act2scene6c.rpy:201
translate turkish u19a2s6c_c85d1325:

    # det "Yeah. I'm not a fan of the violence, but some people only speak one language."
    det "Evet. Şiddeti pek sevmem ama bazı insanlar tek bir dil konuşur."

# game/Scenes/Update19/Act2/act2scene6c.rpy:202
translate turkish u19a2s6c_94830ef7:

    # cw "I suppose so."
    cw "Sanırım öyle."

# game/Scenes/Update19/Act2/act2scene6c.rpy:204
translate turkish u19a2s6c_4111fb67:

    # gg "I'm Adrian. Nice to meet you, Jez."
    gg "Ben Adrian. Tanıştığımıza memnun oldum, Jez."

# game/Scenes/Update19/Act2/act2scene6c.rpy:205
translate turkish u19a2s6c_65966cd5:

    # det "Nice to meet you as well."
    det "Ben de tanıştığımıza memnun oldum."

# game/Scenes/Update19/Act2/act2scene6c.rpy:206
translate turkish u19a2s6c_33ed9226:

    # gg "Are those guns magic? I sense something from them."
    gg "O silahlar sihirli mi? Onlardan bir şeyler hissediyorum."

# game/Scenes/Update19/Act2/act2scene6c.rpy:207
translate turkish u19a2s6c_d211965d:

    # det "Yeah they are. They're very special to me."
    det "Evet, öyle. Benim için çok özel."

# game/Scenes/Update19/Act2/act2scene6c.rpy:209
translate turkish u19a2s6c_0f3c13f7:

    # sg "Nice to meet you! I'm Kendra."
    sg "Tanıştığımıza memnun oldum! Ben Kendra."

# game/Scenes/Update19/Act2/act2scene6c.rpy:210
translate turkish u19a2s6c_3ec570f2:

    # sg "That was incredible, the way you were like \"BLAM! POW! KABLOOEY!\""
    sg "İnanılmazdı, şu “BLAM! POW! KABLOOEY!” dediğin an."

# game/Scenes/Update19/Act2/act2scene6c.rpy:211
translate turkish u19a2s6c_51ce01e8:

    # det "Hah, yeah. Thanks."
    det "Hah, evet. Teşekkürler."

# game/Scenes/Update19/Act2/act2scene6c.rpy:212
translate turkish u19a2s6c_9fb22c06:

    # det "I don't love doing it, but I can't say I'm too sad to see those people unable to hurt anybody else."
    det "Bunu yapmayı pek sevmiyorum ama o adamların artık kimseye zarar veremeyeceklerini görmek beni pek de üzmüyor."

# game/Scenes/Update19/Act2/act2scene6c.rpy:213
translate turkish u19a2s6c_518f546b:

    # sg "Heck yeah. Fuck those guys."
    sg "Tabii ki. Siktir et o adamları."

# game/Scenes/Update19/Act2/act2scene6c.rpy:215
translate turkish u19a2s6c_c628a769:

    # bn "I'm Juliana. Nice to meet you, Jez."
    bn "Ben Juliana. Tanıştığımıza memnun oldum, Jez."

# game/Scenes/Update19/Act2/act2scene6c.rpy:216
translate turkish u19a2s6c_86d67a4d:

    # bn "Were those guys really that bad? They deserved what you did to them?"
    bn "O herifler gerçekten o kadar kötü müydü? Onlara yaptıklarınızı hak ettiler mi?"

# game/Scenes/Update19/Act2/act2scene6c.rpy:217
translate turkish u19a2s6c_e2b6a9a7:

    # det "You heard what they said they were going to do to you."
    det "Sana ne yapacaklarını söylediklerini duydun."

# game/Scenes/Update19/Act2/act2scene6c.rpy:218
translate turkish u19a2s6c_8a31e387:

    # det "It's not the first time they've done this. They deserved it."
    det "Bunu ilk kez yapmıyorlar. Hak ettiler."

# game/Scenes/Update19/Act2/act2scene6c.rpy:219
translate turkish u19a2s6c_3e4cedd2:

    # bn "Yes... I guess so. It's just... sad."
    bn "Evet... Sanırım öyle. Sadece... üzücü."

# game/Scenes/Update19/Act2/act2scene6c.rpy:220
translate turkish u19a2s6c_2d8dbe51:

    # det "I don't disagree."
    det "Katılmıyorum değil."

