# game/Scenes/Update19/Act2/act2scene7d.rpy:46
translate turkish u19a2s7d_bc64f23d:

    # "I walk until the sun begins to set and it's time to set up camp once again."
    "Güneş batmaya başlayana kadar yürüyorum ve yine kamp kurma zamanı geliyor."

# game/Scenes/Update19/Act2/act2scene7d.rpy:47
translate turkish u19a2s7d_440ad206:

    # "I stay up and watch the fire and eat rations from my bag."
    "Uyanık kalıp ateşi izliyorum ve çantamdaki erzakları yiyorum."

# game/Scenes/Update19/Act2/act2scene7d.rpy:52
translate turkish u19a2s7d_4ed19615:

    # "I'm so tired. I wish I had somebody here with me to help keep watch overnight."
    "Çok yorgunum. Keşke gece nöbetini tutmama yardım edecek biri burada olsaydı."

# game/Scenes/Update19/Act2/act2scene7d.rpy:53
translate turkish u19a2s7d_6da9e370:

    # "I hope I can sleep through the night without being attacked again."
    "Umarım bu gece yine saldırıya uğramadan uyuyabilirim."

