# game/Scenes/Update19/Act2/act2scene4c.rpy:90
translate turkish u19a2s4c_d058deaf:

    # pc "Yes, she is."
    pc "Evet, öyle."

# game/Scenes/Update19/Act2/act2scene4c.rpy:91
translate turkish u19a2s4c_b2583800:

