# game/Scenes/Update19/Act2/act2scene4c.rpy:94
translate turkish u19a2s4c_f9cefb7f:

    # bn "We should go to sleep as well. There will be plenty more miles to travel tomorrow."
    bn "Biz de uyumalıyız. Yarın kat etmemiz gereken daha çok yol var."

# game/Scenes/Update19/Act2/act2scene4c.rpy:95
translate turkish u19a2s4c_573e15a0:

    # pc "Yeah, you're right."
    pc "Evet, haklısın."

# game/Scenes/Update19/Act2/act2scene4c.rpy:97
