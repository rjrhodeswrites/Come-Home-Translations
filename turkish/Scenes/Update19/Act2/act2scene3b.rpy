    # cw "Oh wow, a fairy! I've always wanted to meet one!"
    cw "Vay canına, bir peri! Hep bir tanesiyle tanışmak istemişimdir!"

# game/Scenes/Update19/Act2/act2scene3b.rpy:89
translate turkish u19a2s3b_482fb601:

    # sg "Nice to meetcha! I'm Kendra."
    sg "Tanıştığımıza memnun oldum! Ben Kendra."

