translate turkish u19a2s3b_ca87a416:

    # pc "Wow. Yeah, a light would be helpful."
    pc "Vay canına. Evet, bir ışık işimize yarardı."

# game/Scenes/Update19/Act2/act2scene3b.rpy:101
translate turkish u19a2s3b_be27a582:

    # sg "Follow me then! I'll lead you through the woods!"
    sg "O zaman beni takip et! Seni ormanın içinden geçireceğim!"

# game/Scenes/Update19/Act2/act2scene3b.rpy:112
translate turkish u19a2s3b_9dcf9bce:

    # "With Kendra lighting the path, I follow her through the woods."
    "Kendra yolu aydınlatırken, ben de onu takip ederek ormanın içinden geçiyorum."

