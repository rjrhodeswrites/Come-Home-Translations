translate turkish u19a2s3b_762fe211:

    # sg "Well if you want to make it through the woods, you're going to need me to light the way for you."
    sg "Peki, ormanı geçmek istiyorsan, yolunu aydınlatmam gerekecek."

# game/Scenes/Update19/Act2/act2scene3b.rpy:96
translate turkish u19a2s3b_45436a60:

    # pc "You can do that?"
    pc "Bunu yapabilir misin?"

