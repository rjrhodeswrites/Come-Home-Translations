# game/Scenes/Adrian/AdrianDates/adrianarcadedate.rpy:23
translate turkish adrianarcadestartdate_93cbf6b1:

    # "I drive over to Adrian's house to pick her up, then she gives me directions to get to this arcade she wants to visit."
    "Adrian'ı almak için arabayla evine gidiyorum, sonra o bana gitmek istediği oyun salonuna nasıl gideceğimi anlatıyor."

# game/Scenes/Adrian/AdrianDates/adrianarcadedate.rpy:25
translate turkish adrianarcadestartdate_ef349499:

    # "I drive over to Adrian's house and pick her up, then we head out to the arcade."
    "Adrian'ın evine gidip onu alıyorum, sonra oyun salonuna doğru yola çıkıyoruz."

# game/Scenes/Adrian/AdrianDates/adrianarcadedate.rpy:30
translate turkish adrianarcadestartdate_049af941:

    # gg "Wow, look at this place! It's so retro and trashy."
    gg "Vay canına, şuraya bir bak! Çok retro ve ucuz bir yer."

# game/Scenes/Adrian/AdrianDates/adrianarcadedate.rpy:31
translate turkish adrianarcadestartdate_ca89a42d:

    # gg "I love it!"
    gg "Bayıldım!"

# game/Scenes/Adrian/AdrianDates/adrianarcadedate.rpy:32
translate turkish adrianarcadestartdate_1b8393bf:

    # pc "Is this like the business you want to start?"
    pc "Bu, kurmak istediğin iş gibi mi?"

# game/Scenes/Adrian/AdrianDates/adrianarcadedate.rpy:33
translate turkish adrianarcadestartdate_cb319d99:

    # gg "Hm, not really. I'm looking to appeal to a younger crowd, with newer games and private playing areas."
    gg "Hm, pek sayılmaz. Daha yeni oyunlarla ve özel oyun alanlarıyla genç bir kitleye hitap etmeyi düşünüyorum."

# game/Scenes/Adrian/AdrianDates/adrianarcadedate.rpy:34
translate turkish adrianarcadestartdate_1dc6627f:

    # gg "These are all old machines, pretty beat up too. I love them, but I doubt their business is booming here."
    gg "Bunların hepsi eski makineler, üstelik oldukça yıpranmışlar. Onları seviyorum ama burada işlerinin çok iyi gittiğini sanmıyorum."

# game/Scenes/Adrian/AdrianDates/adrianarcadedate.rpy:35
translate turkish adrianarcadestartdate_b342ddbc:

    # gg "Anyway..."
    gg "Neyse..."

# game/Scenes/Adrian/AdrianDates/adrianarcadedate.rpy:36
translate turkish adrianarcadestartdate_ce26e6ca:

    # gg "Let's go play some games!"
    gg "Hadi gidip biraz oyun oynayalım!"

# game/Scenes/Adrian/AdrianDates/adrianarcadedate.rpy:37
translate turkish adrianarcadestartdate_5d89bf80:

    # "We head over to the machines."
    "Makinelerin yanına gidiyoruz."

# game/Scenes/Adrian/AdrianDates/adrianarcadedate.rpy:44
translate turkish adrianarcadestartdate_fcc66601:

    # "We chat while we play games together."
    "Birlikte oyun oynarken sohbet ediyoruz."

# game/Scenes/Adrian/AdrianDates/adrianarcadedate.rpy:51
translate turkish adrianarcadestartdate_aa98635a:

    # "It's fun just to hang out with her. She obviously loves this stuff."
    "Onunla takılmak bile çok eğlenceli. Bu tür şeyleri çok sevdiği belli."

# game/Scenes/Adrian/AdrianDates/adrianarcadedate.rpy:60
translate turkish adrianarcadestartdate_b0953d82:

    # gg "That was fun. You're pretty good at these old games."
    gg "Çok eğlenceliydi. Bu eski oyunlarda oldukça iyisin."

# game/Scenes/Adrian/AdrianDates/adrianarcadedate.rpy:61
translate turkish adrianarcadestartdate_98d42c74:

    # pc "Thanks! I used to play these types of games with my dad as a kid all the time."
    pc "Teşekkürler! Çocukken babamla bu tür oyunları sürekli oynardım."

# game/Scenes/Adrian/AdrianDates/adrianarcadedate.rpy:62
translate turkish adrianarcadestartdate_fb8d8dab:

    # "After we get our fill, playing most of the games in the place several times, we're both ready to leave."
    "Oradaki oyunların çoğunu birkaç kez oynayarak doya doya eğlendikten sonra, ikimiz de gitmeye hazırız."

# game/Scenes/Adrian/AdrianDates/adrianarcadedate.rpy:66
translate turkish adrianarcadestartdate_96accbe9:

    # gg "That was fun!"
    gg "Çok eğlenceliydi!"

# game/Scenes/Adrian/AdrianDates/adrianarcadedate.rpy:68
translate turkish adrianarcadestartdate_1e0d4722:

    # pc "Did you get the research you need?"
    pc "İhtiyacın olan araştırmayı yapabildin mi?"

# game/Scenes/Adrian/AdrianDates/adrianarcadedate.rpy:69
translate turkish adrianarcadestartdate_d081eccb:

    # gg "Yeah, I think so."
    gg "Evet, sanırım."

# game/Scenes/Adrian/AdrianDates/adrianarcadedate.rpy:72
translate turkish adrianarcadestartdate_57656827:

    # gg "Want to take me home and research me now?"
    gg "Beni eve götürüp şimdi benim hakkımda araştırma yapmak ister misin?"

# game/Scenes/Adrian/AdrianDates/adrianarcadedate.rpy:73
translate turkish adrianarcadestartdate_82ba066c:

    # pc "That sounds fantastic."
    pc "Kulağa harika geliyor."

# game/Scenes/Adrian/AdrianDates/adrianarcadedate.rpy:79
translate turkish adrianarcadestartdate_05218083:

    # "We leave the arcade, then I drive her home and walk her up to her front door."
    "Oyun salonundan çıkıyoruz, sonra onu eve götürüp kapısına kadar eşlik ediyorum."

