# game/Scenes/Adrian/AdrianDates/adrianmovietheaterdate.rpy:25
translate turkish adrianmovietheaterstartdate_13ddb197:

    # "We get to the theater and find seats in the back."
    "Sinemaya varıyoruz ve arkada yer buluyoruz."

# game/Scenes/Adrian/AdrianDates/adrianmovietheaterdate.rpy:26
translate turkish adrianmovietheaterstartdate_6cc4cd44:

    # "There's a little time to chat before the movie starts."
    "Film başlamadan önce biraz sohbet etmek için vaktimiz var."

# game/Scenes/Adrian/AdrianDates/adrianmovietheaterdate.rpy:32
translate turkish adrianmovietheaterstartdate_c6fd13bc:

    # "Finally lights dim and she leans over against me while we watch the movie."
    "Sonunda ışıklar sönüyor ve film izlerken o bana yaslanıyor."

# game/Scenes/Adrian/AdrianDates/adrianmovietheaterdate.rpy:33
translate turkish adrianmovietheaterstartdate_d2fbe7b2:

    # "It's pretty good and it's nice just being there with her."
    "Film oldukça iyi ve sadece onunla orada olmak çok güzel."

# game/Scenes/Adrian/AdrianDates/adrianmovietheaterdate.rpy:38
translate turkish adrianmovietheaterstartdate_9dc3692e:

    # "Finally the lights dim and the movie starts. It's not bad."
    "Sonunda ışıklar sönüyor ve film başlıyor. Fena değil."

# game/Scenes/Adrian/AdrianDates/adrianmovietheaterdate.rpy:40
translate turkish adrianmovietheaterstartdate_9b19c90f:

    # gg "That was pretty good, huh?"
    gg "Oldukça iyiydi, değil mi?"

# game/Scenes/Adrian/AdrianDates/adrianmovietheaterdate.rpy:41
translate turkish adrianmovietheaterstartdate_a57bb1cd:

    # "We chat a little through the credits."
    "Jenerik akarken biraz sohbet ediyoruz."

# game/Scenes/Adrian/AdrianDates/adrianmovietheaterdate.rpy:46
translate turkish adrianmovietheaterstartdate_cb13127e:

    # "Afterwards, I drive her home and walk her up to her door."
    "Sonra onu eve bırakıyorum ve kapısına kadar eşlik ediyorum."

translate turkish strings:

    # game/Scenes/Adrian/AdrianDates/adrianmovietheaterdate.rpy:2
    old "A few days after adrian comes out to you, she will call you and invite you to go to a movie with her."
    new "Adrian sana açıldıktan birkaç gün sonra, seni arayıp onunla sinemaya gitmeye davet edecek."

    # game/Scenes/Adrian/AdrianDates/adrianmovietheaterdate.rpy:3
    old "After this first date, you can call her in the evening to go on dates."
    new "Bu ilk randevudan sonra, akşamları onu arayıp randevuya çıkabilirsin."

