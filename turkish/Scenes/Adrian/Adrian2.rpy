# game/Scenes/Adrian/Adrian2.rpy:11
translate turkish adrian2_8e7751b4:

    # "In my social studies class, Adrian and I talk a bit before class starts."
    "Sosyal bilgiler dersimde, ders başlamadan önce Adrian'la biraz sohbet ediyoruz."

# game/Scenes/Adrian/Adrian2.rpy:12
translate turkish adrian2_dfe32186:

    # gg "Have you played any Souls of War?"
    gg "Souls of War oynadın mı hiç?"

# game/Scenes/Adrian/Adrian2.rpy:13
translate turkish adrian2_ce2ffb52:

    # pc "What is that, a computer game?"
    pc "O ne, bir bilgisayar oyunu mu?"

# game/Scenes/Adrian/Adrian2.rpy:14
translate turkish adrian2_f421b58a:

    # gg "Yeah, man. It's great. I've been playing it like crazy the last couple of weeks."
    gg "Evet dostum. Harika bir oyun. Son birkaç haftadır deli gibi oynuyorum."

# game/Scenes/Adrian/Adrian2.rpy:15
translate turkish adrian2_c7884527:

    # pc "Cool. I don't play a ton of games anymore."
    pc "Harika. Artık pek oyun oynamıyorum."

# game/Scenes/Adrian/Adrian2.rpy:16
translate turkish adrian2_dff1d00f:

    # gg "You should check it out."
    gg "Bir denemelisin."

# game/Scenes/Adrian/Adrian2.rpy:17
translate turkish adrian2_9a1fce33:

    # gg "Hey, if you want to see what it's like, you could come over to my house and I could show you."
    gg "Hey, nasıl bir şey olduğunu görmek istersen, evime gel de sana göstereyim."

# game/Scenes/Adrian/Adrian2.rpy:23
translate turkish adrian2_8c2be035:

    # gg "Great! Can you come over tonight?"
    gg "Harika! Bu akşam gelebilir misin?"

# game/Scenes/Adrian/Adrian2.rpy:24
translate turkish adrian2_38aec589:

    # pc "Sure, I'll head over after work."
    pc "Tabii, işten sonra uğrarım."

# game/Scenes/Adrian/Adrian2.rpy:25
translate turkish adrian2_840b1f51:

    # gg "Okay, I'll text you my address."
    gg "Tamam, adresimi sana mesaj atarım."

# game/Scenes/Adrian/Adrian2.rpy:26
translate turkish adrian2_7893f16a:

    # pc "Cool. Looking forward to it."
    pc "Harika. Sabırsızlıkla bekliyorum."

# game/Scenes/Adrian/Adrian2.rpy:27
translate turkish adrian2_d639582e:

    # gg "Me too, I can't wait."
    gg "Ben de, sabırsızlanıyorum."

# game/Scenes/Adrian/Adrian2.rpy:30
translate turkish adrian2_c922aa63:

    # gg "Oh, okay. No big deal."
    gg "Oh, tamam. Önemli değil."

# game/Scenes/Adrian/Adrian2.rpy:34
translate turkish adrian2_c27d3948:

    # "Ms. Welch starts talking then and puts an end to our conversation."
    "O sırada Bayan Welch konuşmaya başlar ve sohbetimizi sonlandırır."

# game/Scenes/Adrian/Adrian2.rpy:35
translate turkish adrian2_e63040ef:

    # "After that, nothing else interesting happens throughout the day and then it is time to go to work."
    "Ondan sonra, gün boyunca ilginç bir şey olmaz ve sonra işe gitme vakti gelir."

translate turkish strings:

    # game/Scenes/Adrian/Adrian2.rpy:2
    old "Talk to Adrian on the phone and ask her what her favorite video game is."
    new "Adrian'la telefonda konuş ve ona en sevdiği video oyununun ne olduğunu sor."

    # game/Scenes/Adrian/Adrian2.rpy:3
    old "Then in class she will invite you to come over to her house in the evening."
    new "Sonra derste, akşamüstü seni evine davet edecek."

    # game/Scenes/Adrian/Adrian2.rpy:19
    old "That sounds fun"
    new "Kulağa eğlenceli geliyor."

    # game/Scenes/Adrian/Adrian2.rpy:28
    old "I don't think so"
    new "Sanmıyorum."

