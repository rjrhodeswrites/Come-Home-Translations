# TODO: Translation updated at 2026-08-03 12:42

# game/Scenes/Adrian/Adrian2b.rpy:15
translate turkish adrian2b_fe1843ee:

    # "After work, I check the address that Adrian had sent me and put it into the GPS."
    "İşten sonra, Adrian'ın bana gönderdiği adresi kontrol edip GPS'e giriyorum."

# game/Scenes/Adrian/Adrian2b.rpy:16
translate turkish adrian2b_220b39e6:

    # "It doesn't take long to get to her house. She actually lives really close to my home."
    "Evine varmam uzun sürmüyor. Aslında evimden çok yakın bir yerde oturuyor."

# game/Scenes/Adrian/Adrian2b.rpy:20
translate turkish adrian2b_614acdee:

    # "I park on the street, then walk up to the front door and knock. A woman answers almost immediately."
    "Sokağa park ediyorum, sonra ön kapıya yürüyüp kapıyı çalıyorum. Bir kadın hemen kapıyı açtı."

# game/Scenes/Adrian/Adrian2b.rpy:21
translate turkish adrian2b_3dafc9b9:

    # "Woman" "Hello? Can I help you?"
    "Woman" "Merhaba? Nasıl yardımcı olabilirim?"

# game/Scenes/Adrian/Adrian2b.rpy:22
translate turkish adrian2b_966e8fef:

    # pc "I'm looking for Adrian. Does she live here?"
    pc "Adrian'ı arıyorum. O burada mı yaşıyor?"

# game/Scenes/Adrian/Adrian2b.rpy:23
translate turkish adrian2b_b542dd0a:

    # "Woman" "Yes she does."
    "Woman" "Evet, burada yaşıyor."

# game/Scenes/Adrian/Adrian2b.rpy:24
translate turkish adrian2b_acfd1a5a:

    # pc "She invited me over to play some video games."
    pc "Beni video oyunu oynamaya davet etmişti."

# game/Scenes/Adrian/Adrian2b.rpy:25
translate turkish adrian2b_172cc6dd:

    # "Woman" "Oh she did? She didn't tell me that anybody was coming."
    "Woman" "Öyle mi? Bana kimse geleceğini söylememişti."

# game/Scenes/Adrian/Adrian2b.rpy:26
translate turkish adrian2b_2fdb51d6:

    # "Woman" "You just stay there and I'll go get her."
    "Woman" "Sen orada bekle, ben onu çağırayım."

# game/Scenes/Adrian/Adrian2b.rpy:27
translate turkish adrian2b_cddf2662:

    # "Then, I hear footsteps coming down the stairs and Adrian calls out."
    "Sonra merdivenlerden inen ayak sesleri duydum ve Adrian seslendi."

# game/Scenes/Adrian/Adrian2b.rpy:28
translate turkish adrian2b_9899eaa9:

    # gg "He's my friend, Mom, let him in."
    gg "O benim arkadaşım anne, içeri al onu."

# game/Scenes/Adrian/Adrian2b.rpy:33
translate turkish adrian2b_c583a608:

    # "Woman" "You're supposed to tell me if somebody is coming over, Adrian."
    "Woman" "Birisi geliyorsa bana söylemen gerekiyordu, Adrian."

# game/Scenes/Adrian/Adrian2b.rpy:34
translate turkish adrian2b_6c01d4fd:

    # gg "I know, Mom. I meant to, but I was just busy... with schoolwork. I forgot."
    gg "Biliyorum anne. Söyleyecektim ama okul ödevleriyle meşguldüm. Unuttum."

# game/Scenes/Adrian/Adrian2b.rpy:35
translate turkish adrian2b_e878210c:

    # "Adrian's Mom" "Okay, well he can stay until 10."
    "Adrian's Mom" "Tamam, saat 10'a kadar kalabilir."

# game/Scenes/Adrian/Adrian2b.rpy:36
translate turkish adrian2b_326f12bf:

    # gg "Okay, Mom. Thank you."
    gg "Tamam anne. Teşekkürler."

# game/Scenes/Adrian/Adrian2b.rpy:39
translate turkish adrian2b_8f7ebec7:

    # "I follow her inside the house and we walk up the stairs."
    "Onu takip ederek evin içine giriyorum ve merdivenleri çıkıyoruz."

# game/Scenes/Adrian/Adrian2b.rpy:44
translate turkish adrian2b_d41d8cd9:

    # voice 'voices/adrian_sorry.mp3'
    voice 'voices/adrian_sorry.mp3'

# game/Scenes/Adrian/Adrian2b.rpy:45
translate turkish adrian2b_c03425eb:

    # gg "I'm sorry about that. She can be a bit overbearing sometimes."
    gg "Bunun için özür dilerim. Bazen biraz baskıcı olabiliyor."

# game/Scenes/Adrian/Adrian2b.rpy:46
translate turkish adrian2b_3ed1d973:

    # gg "She's just very protective of me. Only child and all."
    gg "Sadece beni çok koruyor. Tek çocuğum da olduğum için."

# game/Scenes/Adrian/Adrian2b.rpy:49
translate turkish adrian2b_04c7f126:

    # pc "My dad could be the same way sometimes when I was growing up. I'm an only child too."
    pc "Ben de büyürken babam bazen aynı şekilde davranırdı. Ben de tek çocuğum."

# game/Scenes/Adrian/Adrian2b.rpy:50
translate turkish adrian2b_f7e6c62b:

    # gg "Then you understand."
    gg "O zaman anlıyorsun."

# game/Scenes/Adrian/Adrian2b.rpy:52
translate turkish adrian2b_636661b2:

    # gg "It does sometimes."
    gg "Bazen öyle oluyor."

# game/Scenes/Adrian/Adrian2b.rpy:53
translate turkish adrian2b_2900eca8:

    # gg "But I love her and she's been really good to me through a lot of hard times."
    gg "Ama onu seviyorum ve zor zamanlarda bana gerçekten çok iyi davrandı."

# game/Scenes/Adrian/Adrian2b.rpy:54
translate turkish adrian2b_c07d0332:

    # pc "That's good. Always good to have people there for you."
    pc "Bu iyi. Yanında sana destek olacak insanların olması her zaman iyidir."

# game/Scenes/Adrian/Adrian2b.rpy:55
translate turkish adrian2b_a560b57e:

    # gg "Want to check out the game?"
    gg "Oyuna bir göz atmak ister misin?"

# game/Scenes/Adrian/Adrian2b.rpy:56
translate turkish adrian2b_39757b54:

    # pc "Yeah, let's do it."
    pc "Evet, hadi bakalım."

# game/Scenes/Adrian/Adrian2b.rpy:59
translate turkish adrian2b_5c242d3c:

    # gg "Okay, so this is my character. Her name is Trenoxa and she's a mage."
    gg "Tamam, işte bu benim karakterim. Adı Trenoxa ve o bir büyücü."

# game/Scenes/Adrian/Adrian2b.rpy:60
translate turkish adrian2b_290fa501:

    # pc "She looks badass."
    pc "Çok havalı görünüyor."

# game/Scenes/Adrian/Adrian2b.rpy:61
translate turkish adrian2b_eecdf621:

    # gg "Oh she definitely is. Watch me kill all these kobolds."
    gg "Evet, kesinlikle öyle. Bak, tüm bu koboldları nasıl öldüreceğim."

# game/Scenes/Adrian/Adrian2b.rpy:66
translate turkish adrian2b_8a0ec2b0:

    # "Using the keyboard and mouse, she guides her character into the middle of a group of small monsters and proceeds to blow them all up."
    "Klavye ve fareyi kullanarak karakterini küçük canavarların ortasına yönlendiriyor ve hepsini havaya uçuruyor."

# game/Scenes/Adrian/Adrian2b.rpy:68
translate turkish adrian2b_c9d9899a:

    # "I barely look at the screen, unable to take my eyes off of her."
    "Ekrana neredeyse hiç bakmıyorum, gözlerimi ondan ayıramıyorum."

# game/Scenes/Adrian/Adrian2b.rpy:69
translate turkish adrian2b_c68ec5f4:

    # "She really gets into this stuff, and it's cute to see her so excited about it."
    "Bu işe gerçekten kendini kaptırıyor ve bu kadar heyecanlanmasını görmek çok sevimli."

# game/Scenes/Adrian/Adrian2b.rpy:72
translate turkish adrian2b_f57aeacc:

    # gg "Do you want to give it a try?"
    gg "Bir denemek ister misin?"

# game/Scenes/Adrian/Adrian2b.rpy:73
translate turkish adrian2b_e3e97310:

    # pc "What if I get your character killed?"
    pc "Ya karakterini öldürürsem?"

# game/Scenes/Adrian/Adrian2b.rpy:74
translate turkish adrian2b_03db2857:

    # gg "It's no big deal. You just revive at the nearest respawn point and are weakened for a few minutes."
    gg "Önemli değil. En yakın yeniden doğma noktasında dirilirsin ve birkaç dakika boyunca zayıf kalırsın."

# game/Scenes/Adrian/Adrian2b.rpy:75
translate turkish adrian2b_9a5eb084:

    # gg "Come on, give it a try, see if you like it."
    gg "Hadi ama, bir dene, hoşuna gider mi bak."

# game/Scenes/Adrian/Adrian2b.rpy:76
translate turkish adrian2b_63023601:

    # pc "Okay."
    pc "Tamam."

# game/Scenes/Adrian/Adrian2b.rpy:79
translate turkish adrian2b_2d53ff69:

    # "We switch seats and I play for a bit, trying to learn all the buttons."
    "Yer değiştiriyoruz ve ben de bir süre oynuyorum, tüm tuşları öğrenmeye çalışıyorum."

# game/Scenes/Adrian/Adrian2b.rpy:80
translate turkish adrian2b_b0a6ba6f:

    # gg "Okay, all of your powers are the number keys up top. You move with WASD and look around with the mouse."
    gg "Tamam, tüm güçlerin üstteki sayı tuşlarında. WASD ile hareket ediyorsun ve fareyle etrafa bakınıyorsun."

# game/Scenes/Adrian/Adrian2b.rpy:81
translate turkish adrian2b_3b25da4f:

    # gg "Just click on what you want to kill and then use one of your powers to kill it."
    gg "Öldürmek istediğin şeye tıklayıp, güçlerinden birini kullanarak onu öldürüyorsun."

# game/Scenes/Adrian/Adrian2b.rpy:82
translate turkish adrian2b_b4a8a49d:

    # gg "Super easy. Barely an inconvenience."
    gg "Süper kolay. Neredeyse hiç zahmetli değil."

# game/Scenes/Adrian/Adrian2b.rpy:83
translate turkish adrian2b_babb66b4:

    # pc "You say that, but I'm still wondering what a WASD is."
    pc "Sen öyle diyorsun ama ben hâlâ WASD'nin ne olduğunu merak ediyorum."

# game/Scenes/Adrian/Adrian2b.rpy:86
translate turkish adrian2b_055f2992:

    # "A little bit later, I have pretty much figured out the controls and am demolishing enemies."
    "Biraz sonra, kontrolleri hemen hemen çözdüm ve düşmanları yok ediyorum."

# game/Scenes/Adrian/Adrian2b.rpy:87
translate turkish adrian2b_4915d075:

    # gg "You like it?"
    gg "Beğendin mi?"

# game/Scenes/Adrian/Adrian2b.rpy:88
translate turkish adrian2b_3b7f3448:

    # pc "I have to admit, it's pretty fun."
    pc "Kabul etmeliyim ki, oldukça eğlenceli."

# game/Scenes/Adrian/Adrian2b.rpy:89
translate turkish adrian2b_a82592f5:

    # gg "I'm glad. If you bought a copy sometime, we could even play together."
    gg "Sevindim. Bir ara bir kopya alırsan, birlikte bile oynayabiliriz."

# game/Scenes/Adrian/Adrian2b.rpy:90
translate turkish adrian2b_c0437e5d:

    # pc "That would be fun."
    pc "Bu eğlenceli olurdu."

# game/Scenes/Adrian/Adrian2b.rpy:93
translate turkish adrian2b_ee920117:

    # gg "I think so too. I'd love to explore and kill goblins with you."
    gg "Ben de öyle düşünüyorum. Seninle birlikte keşfetmek ve goblinleri öldürmek isterim."

# game/Scenes/Adrian/Adrian2b.rpy:94
translate turkish adrian2b_efa756f8:

    # pc "Maybe I'll get it sometime then."
    pc "O zaman belki bir ara alırım."

# game/Scenes/Adrian/Adrian2b.rpy:95
translate turkish adrian2b_ce14f6da:

    # gg "Good."
    gg "Güzel."

# game/Scenes/Adrian/Adrian2b.rpy:96
translate turkish adrian2b_6a346fe1:

    # gg "It's about time for you to go. I wouldn't mind hanging out longer, but it's nearly 10 and my mom will be mad."
    gg "Artık gitme vaktin geldi. Daha uzun süre takılmak isterdim ama saat neredeyse 10 oldu ve annem kızacak."

# game/Scenes/Adrian/Adrian2b.rpy:97
translate turkish adrian2b_8f70c6ec:

    # pc "Okay, I'll go then. Don't want to get you in trouble."
    pc "Tamam, o zaman gidiyorum. Seni belaya sokmak istemem."

# game/Scenes/Adrian/Adrian2b.rpy:98
translate turkish adrian2b_45175d50:

    # gg "I had a good time though. Thank you for coming over."
    gg "Yine de iyi vakit geçirdim. Geldiğin için teşekkürler."

# game/Scenes/Adrian/Adrian2b.rpy:99
translate turkish adrian2b_1b5489ad:

    # pc "Thanks for inviting me, I had fun too."
    pc "Beni davet ettiğin için teşekkürler, ben de eğlendim."

# game/Scenes/Adrian/Adrian2b.rpy:103
translate turkish adrian2b_6a658ffa:

    # "She walks me down to the front door."
    "Beni ön kapıya kadar geçirdi."

# game/Scenes/Adrian/Adrian2b.rpy:104
translate turkish adrian2b_2c7e0e7e:

    # gg "I could probably get you a copy of the game. If I did, would you play with me?"
    gg "Muhtemelen sana oyunun bir kopyasını bulabilirim. Eğer bulursam, benimle oynar mısın?"

# game/Scenes/Adrian/Adrian2b.rpy:105
translate turkish adrian2b_7f0c6c37:

    # pc "Yeah, I think I could do that."
    pc "Evet, sanırım yapabilirim."

# game/Scenes/Adrian/Adrian2b.rpy:107
translate turkish adrian2b_d41d8cd9_1:

    # voice 'voices/adrian_seeyou.mp3'
    voice 'voices/adrian_seeyou.mp3'

# game/Scenes/Adrian/Adrian2b.rpy:108
translate turkish adrian2b_c8b2cdfc:

    # gg "Okay cool. I'll see you in class, [pcname]."
    gg "Tamam, harika. Derste görüşürüz, [pcname]."

# game/Scenes/Adrian/Adrian2b.rpy:109
translate turkish adrian2b_9bfc226b:

    # pc "Alright. Bye, Adrian."
    pc "Tamam. Hoşça kal, Adrian."

translate turkish strings:

    # game/Scenes/Adrian/Adrian2b.rpy:2
    old "Go over to Adrian's house after she invites you in class."
    new "Derste Adrian seni davet ettikten sonra onun evine git."

    # game/Scenes/Adrian/Adrian2b.rpy:3
    old "This will happen automatically that evening."
    new "Bu, o akşam otomatik olarak gerçekleşecek."

    # game/Scenes/Adrian/Adrian2b.rpy:48
    old "It's okay, I get it."
    new "Sorun değil, anlıyorum."

    # game/Scenes/Adrian/Adrian2b.rpy:51
    old "It must drive you crazy."
    new "Seni deli ediyor olmalı."

    # game/Scenes/Adrian/Adrian2b.rpy:65
    old "Watch the screen"
    new "Ekrana bak"

    # game/Scenes/Adrian/Adrian2b.rpy:67
    old "Watch her"
    new "Ona bak"

