    # gg "Maybe next weekend then."
    gg "O zaman belki gelecek hafta sonu."

# game/Scenes/Adrian/adrian15.rpy:35
translate turkish adrian15_ba01fe47:

    # pc "Okay, see you later, Adrian."
    pc "Tamam, sonra görüşürüz Adrian."

# game/Scenes/Adrian/adrian15.rpy:36
translate turkish adrian15_225cc39e:

    # gg "See ya."
    gg "Görüşürüz."

# game/Scenes/Adrian/adrian15.rpy:42
translate turkish adrian15_997826d2:

    # pc "I'll be right over."
    pc "Hemen geliyorum."

# game/Scenes/Adrian/adrian15.rpy:44
translate turkish adrian15_1f3fc4dd:

    # gg "Awesome! See you then."
    gg "Harika! O zaman görüşürüz."

# game/Scenes/Adrian/adrian15.rpy:48
translate turkish adrian15_3415b62c:

    # "I get ready real quick and drive over to Adrian's house to hang out with her."
    "Hemen hazırlanıp Adrian'ın evine gidip onunla vakit geçiriyorum."

# game/Scenes/Adrian/adrian15.rpy:52
translate turkish adrian15_0be6e60c:

    # "She greets me in the kitchen with a deep kiss."
    "Mutfakta beni derin bir öpücükle karşılıyor."

# game/Scenes/Adrian/adrian15.rpy:53
translate turkish adrian15_19e9b3da:

    # gg "We {i}could{/i} just skip straight to the sex today, but I do really want to play some games."
    gg "Bugün {i}doğrudan{/i} sekse geçebiliriz, ama ben gerçekten biraz oyun oynamak istiyorum."

# game/Scenes/Adrian/adrian15.rpy:54
translate turkish adrian15_216dab98:

    # gg "Is that okay?"
    gg "Sorun olur mu?"

# game/Scenes/Adrian/adrian15.rpy:55
translate turkish adrian15_e1f76998:

    # pc "Of course. I was looking forward to playing games with you too."
    pc "Tabii ki olmaz. Ben de seninle oyun oynamayı dört gözle bekliyordum."

# game/Scenes/Adrian/adrian15.rpy:59
translate turkish adrian15_abe6c25e:

    # "We go upstairs and start playing."
    "Yukarı çıkıp oynamaya başlıyoruz."

# game/Scenes/Adrian/adrian15.rpy:61
translate turkish adrian15_c8f89ecf:

    # "As soon as I get there, we go upstairs and start playing."
    "Oraya varır varmaz, yukarı çıkıp oynamaya başlıyoruz."

# game/Scenes/Adrian/adrian15.rpy:62
translate turkish adrian15_d2b3fa04:

    # "As usual, she's just a little bit better than me at just about everything we play."
    "Her zamanki gibi, oynadığımız hemen hemen her şeyde benden biraz daha iyi."

# game/Scenes/Adrian/adrian15.rpy:64
translate turkish adrian15_1c125346:

    # gg "Ooh, you're getting frustrated. I want you to take that out on me later."
    gg "Ooh, sinirleniyorsun. Daha sonra öfkeni benden çıkarmak istiyorum."

# game/Scenes/Adrian/adrian15.rpy:65
translate turkish adrian15_49db3af1:

    # pc "Oh I will. I'm going to fucking pound you."
    pc "Oh, çıkaracağım. Seni fena halde becereceğim."

# game/Scenes/Adrian/adrian15.rpy:66
translate turkish adrian15_05fc893c:

    # gg "Not as hard as I'm pounding you right now."
    gg "Şu anda seni becerdiğim kadar sert değil."

# game/Scenes/Adrian/adrian15.rpy:68
translate turkish adrian15_23cf97cd:

    # gg "You're getting frustrated. Want me to take it easy on you?"
    gg "Sinirleniyorsun. Sana biraz daha nazik davranmamı ister misin?"

# game/Scenes/Adrian/adrian15.rpy:69
translate turkish adrian15_07b12e2a:

    # pc "Absolutely not."
    pc "Kesinlikle hayır."

# game/Scenes/Adrian/adrian15.rpy:70
translate turkish adrian15_61c39868:

    # gg "Okay then."
    gg "Tamam o zaman."

# game/Scenes/Adrian/adrian15.rpy:73
translate turkish adrian15_e6bf8cf8:

    # gg "Get wrecked!"
    gg "Mahvol!"

# game/Scenes/Adrian/adrian15.rpy:74
translate turkish adrian15_458a16fb:

    # pc "Damn it!"
    pc "Kahretsin!"

# game/Scenes/Adrian/adrian15.rpy:75
translate turkish adrian15_e2f2f564:

    # "Just then, Adrian's phone starts to ring."
    "Tam o sırada, Adrian'ın telefonu çalmaya başlar."

# game/Scenes/Adrian/adrian15.rpy:78
translate turkish adrian15_1ff26783:

    # gg "Oh hold on, my cousin is calling. I gotta answer this."
    gg "Oh, bekle biraz, kuzenim arıyor. Cevap vermem lazım."

# game/Scenes/Adrian/adrian15.rpy:79
translate turkish adrian15_9b761d73:

    # pc "Okay, no problem."
    pc "Tamam, sorun değil."

# game/Scenes/Adrian/adrian15.rpy:82
translate turkish adrian15_993631a3:

    # gg "Hey, cuz. What's up?"
    gg "Selam kuzen. Naber?"

# game/Scenes/Adrian/adrian15.rpy:83
translate turkish adrian15_55836b8e:

    # gg "Not really, just hanging out with a friend."
    gg "Pek bir şey yok, sadece bir arkadaşla takılıyorum."

# game/Scenes/Adrian/adrian15.rpy:84
translate turkish adrian15_1717d990:

    # gg "You're almost here already?"
    gg "Neredeyse geldin mi?"

# game/Scenes/Adrian/adrian15.rpy:85
translate turkish adrian15_82261785:

    # gg "Okay then, see you in a few minutes."
    gg "Tamam o zaman, birkaç dakika sonra görüşürüz."

# game/Scenes/Adrian/adrian15.rpy:88
translate turkish adrian15_d0342fde:

    # gg "She's coming over to see me."
    gg "Beni görmeye geliyor."

# game/Scenes/Adrian/adrian15.rpy:89
translate turkish adrian15_241b8044:

    # gg "Sorry, this is completely unexpected."
    gg "Üzgünüm, bu tamamen beklenmedik bir durum."

# game/Scenes/Adrian/adrian15.rpy:90
translate turkish adrian15_58426ace:

    # gg "But I'm excited that you're going to get to meet her!"
    gg "Ama onunla tanışacak olmana çok sevindim!"

# game/Scenes/Adrian/adrian15.rpy:91
translate turkish adrian15_6f1ff7f5:

    # pc "You two get along, I guess?"
    pc "İkiniz iyi anlaşıyorsunuz, değil mi?"

# game/Scenes/Adrian/adrian15.rpy:92
translate turkish adrian15_56ba3372:

    # gg "Yeah, she's amazing. I love her so much."
    gg "Evet, o harika biri. Onu çok seviyorum."

# game/Scenes/Adrian/adrian15.rpy:93
translate turkish adrian15_f36cae87:

    # gg "Come on, let's go down and greet her."
    gg "Hadi, aşağı inip onu karşılayalım."

# game/Scenes/Adrian/adrian15.rpy:96
translate turkish adrian15_e520b635:

    # "We go downstairs and wait outside for a few minutes before a woman pulls up on a motorcycle and parks in Adrian's driveway."
    "Aşağı inip dışarıda birkaç dakika bekliyoruz; sonra bir kadın motosikletiyle gelip Adrian’ın garaj yoluna park ediyor."

# game/Scenes/Adrian/adrian15.rpy:97
translate turkish adrian15_327f8422:

    # gg "There she is!"
    gg "İşte o!"

# game/Scenes/Adrian/adrian15.rpy:98
translate turkish adrian15_80f73ec8:

    # gg "Thena!"
    gg "Thena!"

# game/Scenes/Adrian/adrian15.rpy:101
translate turkish adrian15_41689eaf:

    # gg "What's going on, cuz?"
    gg "Neler oluyor kuzen?"

# game/Scenes/Adrian/adrian15.rpy:103
translate turkish adrian15_bdbb7e4a:

    # ath "Ugh, I have so much to tell you."
    ath "Of, sana anlatacak o kadar çok şey var ki."

# game/Scenes/Adrian/adrian15.rpy:106
translate turkish adrian15_f34f39f9:

    # "Adrian rushes towards her and they hug."
    "Adrian ona doğru koşar ve sarılırlar."

# game/Scenes/Adrian/adrian15.rpy:107
translate turkish adrian15_8a2ad9ef:

    # ath "Can we go inside and talk for a bit?"
    ath "İçeri girip biraz konuşabilir miyiz?"

# game/Scenes/Adrian/adrian15.rpy:108
translate turkish adrian15_6cec5501:

    # gg "Sure."
    gg "Tabii."

# game/Scenes/Adrian/adrian15.rpy:111
translate turkish adrian15_40382c6b:

    # ath "Oh, who's this?"
    ath "Oh, bu kim?"

# game/Scenes/Adrian/adrian15.rpy:113
translate turkish adrian15_f248dcf0:

    # gg "This is my boyfriend, [pcname]. [pcname], this is my cousin, Athena."
    gg "Bu benim erkek arkadaşım, [pcname]. [pcname], bu benim kuzenim Athena."

# game/Scenes/Adrian/adrian15.rpy:115
translate turkish adrian15_2fec0547:

    # gg "This is my friend, [pcname]. [pcname], this is my cousin, Athena."
    gg "Bu benim arkadaşım, [pcname]. [pcname], bu benim kuzenim Athena."

# game/Scenes/Adrian/adrian15.rpy:116
translate turkish adrian15_bc87a0d4:

    # pc "Nice to meet you."
    pc "Tanıştığımıza memnun oldum."

# game/Scenes/Adrian/adrian15.rpy:117
translate turkish adrian15_15faa5ea:

    # ath "Yeah, you too."
    ath "Evet, ben de."

# game/Scenes/Adrian/adrian15.rpy:122
translate turkish adrian15_7ac147ee:

    # "We go in and go upstairs and sit in the bedroom and the tone immediately changes to something more somber and uncomfortable."
    "İçeri girip yukarı çıkıyoruz ve yatak odasında oturuyoruz; ortamın havası aniden daha kasvetli ve rahatsız edici bir hale bürünüyor."

# game/Scenes/Adrian/adrian15.rpy:123
translate turkish adrian15_da185fde:

    # pc "Should I go? Do you two need to talk?"
    pc "Gitsem mi? İkinizin konuşması mı gerekiyor?"

# game/Scenes/Adrian/adrian15.rpy:124
translate turkish adrian15_6b5e2f35:

    # gg "No, you don't have to go."
    gg "Hayır, gitmene gerek yok."

# game/Scenes/Adrian/adrian15.rpy:125
translate turkish adrian15_ff42571e:

    # gg "Right, Athena? What's going on? Did something happen?"
    gg "Değil mi, Athena? Neler oluyor? Bir şey mi oldu?"

# game/Scenes/Adrian/adrian15.rpy:128
translate turkish adrian15_cd5138a1:

    # ath "Yeah, but I'm not allowed to tell you everything."
    ath "Evet, ama sana her şeyi anlatmam yasak."

# game/Scenes/Adrian/adrian15.rpy:129
translate turkish adrian15_0937f8ec:

    # ath "I'm going to be leaving for a while. For my own protection."
    ath "Bir süreliğine ayrılacağım. Kendi güvenliğim için."

# game/Scenes/Adrian/adrian15.rpy:132
translate turkish adrian15_ea61cda2:

    # gg "What do you mean? Are you in trouble?"
    gg "Ne demek istiyorsun? Başın belada mı?"

# game/Scenes/Adrian/adrian15.rpy:134
translate turkish adrian15_d6235708:

    # ath "I got mixed up in something. I can't tell you any more about it right now."
    ath "Bir şeye bulaştım. Şu anda sana daha fazlasını anlatamam."

# game/Scenes/Adrian/adrian15.rpy:135
translate turkish adrian15_a6ace00b:

    # ath "Hopefully some day. Whenever it all blows over."
    ath "Umarım bir gün. Her şey yatıştığında."

# game/Scenes/Adrian/adrian15.rpy:137
translate turkish adrian15_8643f80d:

    # gg "What do you mean you have to leave?"
    gg "Ne demek gitmek zorundasın?"

# game/Scenes/Adrian/adrian15.rpy:139
translate turkish adrian15_666954cc:

    # ath "I have to cut contact with everybody. Witness protection."
    ath "Herkesle iletişimi kesmek zorundayım. Tanık koruma programı."

# game/Scenes/Adrian/adrian15.rpy:141
translate turkish adrian15_479d733b:

    # gg "Cut contact? So we're not going to be able to talk? At all?"
    gg "İletişimi kesmek mi? Yani konuşamayacak mıyız? Hiç mi?"

# game/Scenes/Adrian/adrian15.rpy:144
translate turkish adrian15_dc747734:

    # ath "Not for a while."
    ath "Bir süreliğine."

# game/Scenes/Adrian/adrian15.rpy:145
translate turkish adrian15_49c637e0:

    # gg "How long?"
    gg "Ne kadar süre?"

# game/Scenes/Adrian/adrian15.rpy:146
translate turkish adrian15_7b465be2:

    # ath "I don't know."
    ath "Bilmiyorum."

# game/Scenes/Adrian/adrian15.rpy:147
translate turkish adrian15_024a8128:

    # gg "Are you in danger?"
    gg "Tehlikede misin?"

# game/Scenes/Adrian/adrian15.rpy:148
translate turkish adrian15_619b8851:

    # gg "Because you know I would burn the whole world down for you."
    gg "Çünkü biliyorsun ki senin için tüm dünyayı yakarım."

# game/Scenes/Adrian/adrian15.rpy:151
translate turkish adrian15_10475b4e:

    # ath "I know. I'd do the same for you too."
    ath "Biliyorum. Ben de senin için aynısını yapardım."

# game/Scenes/Adrian/adrian15.rpy:152
translate turkish adrian15_db6c9ba9:

    # gg "Do we need to? Go on a Thelma and Louise style cross-country escape?"
    gg "Buna gerek var mı? Thelma ve Louise tarzında ülke çapında bir kaçışa çıkmamız mı gerekiyor?"

# game/Scenes/Adrian/adrian15.rpy:153
translate turkish adrian15_938aadfc:

    # ath "No, it's okay, Adrian."
    ath "Hayır, sorun yok Adrian."

# game/Scenes/Adrian/adrian15.rpy:156
translate turkish adrian15_9d14717d:

    # ath "I'll be safe. And I'll be with people I love."
    ath "Güvende olacağım. Ve sevdiğim insanlarla birlikte olacağım."

# game/Scenes/Adrian/adrian15.rpy:157
translate turkish adrian15_ad669f44:

    # ath "I'll just be... hidden for a while."
    ath "Sadece... bir süreliğine saklanacağım."

# game/Scenes/Adrian/adrian15.rpy:160
translate turkish adrian15_ab7ecd37:

    # ath "But you don't have to worry about me, I promise."
    ath "Ama benim için endişelenmene gerek yok, söz veriyorum."

# game/Scenes/Adrian/adrian15.rpy:161
translate turkish adrian15_6fc1467e:

    # ath "And as soon as I'm able to, I'll contact you."
    ath "Ve elimden gelir gelmez seninle iletişime geçeceğim."

# game/Scenes/Adrian/adrian15.rpy:162
translate turkish adrian15_f33637a0:

    # ath "This isn't a goodbye. Just a see you later. Okay?"
    ath "Bu bir veda değil. Sadece \"görüşürüz\" demek. Tamam mı?"

# game/Scenes/Adrian/adrian15.rpy:165
translate turkish adrian15_97b198b3:

    # gg "It feels like a goodbye."
    gg "Sanki bir veda gibi geliyor."

# game/Scenes/Adrian/adrian15.rpy:166
translate turkish adrian15_1ba8b0dd:

    # ath "Oh don't cry, cuz, please. You'll make me cry too."
    ath "Ah, ağlama lütfen kardeşim. Beni de ağlatacaksın."

# game/Scenes/Adrian/adrian15.rpy:169
translate turkish adrian15_0e2cfb70:

    # gg "I just don't know what I'm going to do without being able to talk to you and play games with you every night."
    gg "Her gece seninle konuşamadan ve oyun oynayamadan ne yapacağım bilmiyorum."

# game/Scenes/Adrian/adrian15.rpy:170
translate turkish adrian15_0b0416f8:

    # gg "I'm going to miss you so much."
    gg "Seni çok özleyeceğim."

# game/Scenes/Adrian/adrian15.rpy:171
translate turkish adrian15_4851e337:

    # ath "I'll miss you too, Adrian."
    ath "Ben de seni özleyeceğim Adrian."

# game/Scenes/Adrian/adrian15.rpy:172
translate turkish adrian15_decbe2a6:

    # ath "You'll be okay though. You have friends. You are loved."
    ath "Ama sen iyi olacaksın. Arkadaşların var. Seviliyorsun."

# game/Scenes/Adrian/adrian15.rpy:173
translate turkish adrian15_b994f8f3:

    # ath "And one day I'll call you and we'll hang out and I'll tell you everything."
    ath "Ve bir gün seni arayacağım, birlikte takılacağız ve sana her şeyi anlatacağım."

# game/Scenes/Adrian/adrian15.rpy:176
translate turkish adrian15_baad95b7:

    # gg "You better."
    gg "Öyle olsa iyi olur."

# game/Scenes/Adrian/adrian15.rpy:177
translate turkish adrian15_e694fdb2:

    # gg "Or I might come looking for you, and I'll take out anybody in my way."
    gg "Yoksa seni aramaya gelebilirim ve yoluma çıkan herkesi ortadan kaldırırım."

# game/Scenes/Adrian/adrian15.rpy:178
translate turkish adrian15_0cebbbe1:

    # gg "I have a very particular set of skills."
    gg "Çok özel yeteneklerim var."

# game/Scenes/Adrian/adrian15.rpy:179
translate turkish adrian15_46263ea2:

    # ath "I'm not sure how mob management with ice magic or looking amazing in a tank top is going to help you there."
    ath "Buz büyüsüyle kalabalıkları kontrol etmenin ya da tişörtle muhteşem görünmenin sana bu konuda nasıl yardımcı olacağını pek bilmiyorum."

# game/Scenes/Adrian/adrian15.rpy:180
translate turkish adrian15_5b9f42ef:

    # gg "Fine. I might need to obtain more skills."
    gg "Peki. Belki de daha fazla yetenek edinmem gerekebilir."

# game/Scenes/Adrian/adrian15.rpy:183
translate turkish adrian15_297bbe15:

    # ath "So, my ride is going to be here to pick me up soon. I don't have a lot of time."
    ath "Peki, beni almaya gelecek araç birazdan burada olacak. Fazla vaktim yok."

# game/Scenes/Adrian/adrian15.rpy:184
translate turkish adrian15_083bd235:

    # ath "But I do have some good news for you too."
    ath "Ama sana da iyi bir haberim var."

# game/Scenes/Adrian/adrian15.rpy:185
translate turkish adrian15_5f5f9537:

    # gg "Oh really?"
    gg "Öyle mi?"

# game/Scenes/Adrian/adrian15.rpy:188
translate turkish adrian15_c24bc319:

    # ath "I'm not going to need my bike anymore. So it's all yours."
    ath "Artık bisikletime ihtiyacım olmayacak. O yüzden tamamen senin."

# game/Scenes/Adrian/adrian15.rpy:189
translate turkish adrian15_9e813a25:

    # gg "What!? You're just giving it to me!?"
    gg "Ne!? Bana öylece mi veriyorsun!?"

# game/Scenes/Adrian/adrian15.rpy:190
translate turkish adrian15_ca7279be:

    # ath "Sure. You had a blast riding it when you visited me last and I can't take it with me."
    ath "Tabii ki. En son beni ziyarete geldiğinde bisikletle çok eğlenmiştin ve ben onu yanımda götüremem."

# game/Scenes/Adrian/adrian15.rpy:191
translate turkish adrian15_f0112aa2:

    # ath "So I wanted you to have it."
    ath "O yüzden senin olmasını istedim."

# game/Scenes/Adrian/adrian15.rpy:194
translate turkish adrian15_6fb0514f:

    # gg "You're amazing, Thena. I love you."
    gg "Harikasın, Thena. Seni seviyorum."

# game/Scenes/Adrian/adrian15.rpy:195
translate turkish adrian15_a77a6e8c:

    # ath "I love you too, cuz."
    ath "Ben de seni seviyorum, kuzen."

# game/Scenes/Adrian/adrian15.rpy:196
translate turkish adrian15_04259593:

    # ath "Take care of it, okay? And be careful."
    ath "Ona iyi bak, tamam mı? Ve dikkatli ol."

# game/Scenes/Adrian/adrian15.rpy:197
translate turkish adrian15_62a41927:

    # gg "I will, I promise."
    gg "Olur, söz veriyorum."

# game/Scenes/Adrian/adrian15.rpy:198
translate turkish adrian15_1339b17c:

    # ath "We should probably go downstairs. My ride will be here any minute."
    ath "Artık aşağı inmeliyiz. Beni alacak araç her an gelebilir."

# game/Scenes/Adrian/adrian15.rpy:201
translate turkish adrian15_1192b455:

    # ath "Be sure to tell your mom what's going on, okay? I was hoping she'd be here so I could say goodbye to her too."
    ath "Annene neler olduğunu mutlaka anlat, tamam mı? Onun da burada olmasını umuyordum, böylece ona da veda edebilirdim."

# game/Scenes/Adrian/adrian15.rpy:202
translate turkish adrian15_e8147df6:

    # gg "I will. She's going to be as confused as I am about it, I'm sure."
    gg "Söyleyeceğim. Eminim o da bu konuda benim kadar kafası karışık olacaktır."

# game/Scenes/Adrian/adrian15.rpy:203
translate turkish adrian15_43503f58:

    # ath "Yeah, I'm really sorry that I can't tell you more. It's better to know as little as possible for everybody's safety."
    ath "Evet, sana daha fazlasını anlatamadığım için gerçekten üzgünüm. Herkesin güvenliği için mümkün olduğunca az şey bilmek daha iyi."

# game/Scenes/Adrian/adrian15.rpy:206
translate turkish adrian15_b0be2693:

    # ath "And I'm sorry that we couldn't meet under better circumstances."
    ath "Ve daha iyi koşullarda buluşamadığımız için üzgünüm."

# game/Scenes/Adrian/adrian15.rpy:207
translate turkish adrian15_488c149e:

    # gg "Yeah, usually when Athena and I are together, it's all laughs and playing games and stuff."
    gg "Evet, genellikle Athena ve ben birlikteyken, her şey kahkaha, oyun oynamak falan olur."

# game/Scenes/Adrian/adrian15.rpy:208
translate turkish adrian15_3dedfad6:

    # gg "It would have been fun to hang out for a while with all three of us and play some Smash or something."
    gg "Üçümüz bir süre takılıp Smash falan oynasaydık eğlenceli olurdu."

# game/Scenes/Adrian/adrian15.rpy:211
translate turkish adrian15_a29880ae:

    # ath "Do you still main Kirby? I'd love to kick that little pink ball's ass sometime."
    ath "Hâlâ Kirby'yi mi kullanıyorsun? O küçük pembe topun canına okumak isterdim bir ara."

# game/Scenes/Adrian/adrian15.rpy:212
translate turkish adrian15_c75ca3d4:

    # gg "You wish."
    gg "Hayal kuruyorsun."

# game/Scenes/Adrian/adrian15.rpy:213
translate turkish adrian15_9882e4ae:

    # ath "We might have time to fit in a quick game, if we hurry. It won't take me long to wipe the floor with you."
    ath "Acele edersek hızlı bir oyun sıkıştıracak vaktimiz olabilir. Seni yerden silip süpürmem uzun sürmez."

# game/Scenes/Adrian/adrian15.rpy:214
translate turkish adrian15_36bb3cc8:

    # gg "Let's go then, bitch!"
    gg "Hadi o zaman, sürtük!"

# game/Scenes/Adrian/adrian15.rpy:217
translate turkish adrian15_b7c027eb:

    # "Just then, a police car parks in front of the house and a man in a suit steps out, looking grim and official."
    "Tam o sırada, bir polis arabası evin önüne park etti ve takım elbiseli bir adam, ciddi ve resmi bir ifadeyle arabadan indi."

# game/Scenes/Adrian/adrian15.rpy:218
translate turkish adrian15_b3e6504f:

    # ath "Rain check, I guess. Time to go."
    ath "Başka sefere o zaman. Gitme zamanı."

# game/Scenes/Adrian/adrian15.rpy:221
translate turkish adrian15_d5f4dd84:

    # ath "I love you, cuz. I'll see you again soon."
    ath "Seni seviyorum, kuzen. Yakında tekrar görüşürüz."

# game/Scenes/Adrian/adrian15.rpy:222
translate turkish adrian15_b13e0d25:

    # gg "I love you too."
    gg "Ben de seni seviyorum."

# game/Scenes/Adrian/adrian15.rpy:223
translate turkish adrian15_96dc14b2:

    # gg "I hate this so much. I don't want to let you go."
    gg "Bundan çok nefret ediyorum. Seni bırakmak istemiyorum."

# game/Scenes/Adrian/adrian15.rpy:224
translate turkish adrian15_1edb5510:

    # ath "I know. We'll be okay though."
    ath "Biliyorum. Ama her şey yoluna girecek."

# game/Scenes/Adrian/adrian15.rpy:225
translate turkish adrian15_e2fe510e:

    # ath "And when I see you again, we'll hang out for days, okay?"
    ath "Ve seni tekrar gördüğümde, günlerce takılacağız, tamam mı?"

# game/Scenes/Adrian/adrian15.rpy:226
translate turkish adrian15_c5cc5eaf:

    # gg "Okay, but if there's anything I can do to help, please call me."
    gg "Tamam, ama yardım edebileceğim bir şey olursa lütfen beni ara."

# game/Scenes/Adrian/adrian15.rpy:227
translate turkish adrian15_20fcca99:

    # ath "I will."
    ath "Arayacağım."

# game/Scenes/Adrian/adrian15.rpy:230
translate turkish adrian15_170b7c68:

    # ath "And [pcname], it was nice to meet you."
    ath "Ve [pcname], seninle tanıştığıma sevindim."

# game/Scenes/Adrian/adrian15.rpy:231
translate turkish adrian15_61906ded:

    # pc "Nice to meet you too, Athena."
    pc "Ben de seninle tanıştığıma sevindim, Athena."

# game/Scenes/Adrian/adrian15.rpy:235
translate turkish adrian15_84825cda:

    # "Suddenly, she pulls my hand, yanking me closer, then whispers in my ear."
    "Aniden elimi çekip beni kendine yaklaştırdı, sonra kulağıma fısıldadı."

# game/Scenes/Adrian/adrian15.rpy:236
translate turkish adrian15_46517656:

    # ath "Be good to her. If you hurt my cousin, I will find you."
    ath "Ona iyi davran. Eğer kuzenimi incitirsen, seni bulurum."

# game/Scenes/Adrian/adrian15.rpy:237
translate turkish adrian15_17a1cb32:

    # pc "Uh, I will."
    pc "Ee, öyle yapacağım."

# game/Scenes/Adrian/adrian15.rpy:240
translate turkish adrian15_05763882:

    # ath "Bye, Adrian! Love you!"
    ath "Hoşça kal, Adrian! Seni seviyorum!"

# game/Scenes/Adrian/adrian15.rpy:241
translate turkish adrian15_11b6245f:

    # gg "Bye! Love you too!"
    gg "Hoşça kal! Ben de seni seviyorum!"

# game/Scenes/Adrian/adrian15.rpy:242
translate turkish adrian15_fd99ecee:

    # ath "Tell your mom I love her too!"
    ath "Annene de onu sevdiğimi söyle!"

# game/Scenes/Adrian/adrian15.rpy:243
translate turkish adrian15_b909935e:

    # gg "I will!"
    gg "Söyleyeceğim!"

# game/Scenes/Adrian/adrian15.rpy:244
translate turkish adrian15_124dcc1b:

    # ath "I'll kick your pink Kirby ass real soon!"
    ath "O pembe Kirby kıçını çok yakında tekmeleyeceğim!"

# game/Scenes/Adrian/adrian15.rpy:248
translate turkish adrian15_4829e0da:

    # "As soon as Athena is in the car and it starts to pull away, Adrian turns towards me, tears in her eyes."
    "Athena arabaya biner binmez ve araba uzaklaşmaya başlar başlamaz, Adrian gözlerinde yaşlarla bana döner."

# game/Scenes/Adrian/adrian15.rpy:249
translate turkish adrian15_5928d159:

    # gg "Ugh, this fucking sucks."
    gg "Of, bu çok berbat."

# game/Scenes/Adrian/adrian15.rpy:250
translate turkish adrian15_72615de3:

    # gg "I'm sorry, [pcname]. I don't much feel like playing games anymore."
    gg "Üzgünüm, [pcname]. Artık oyun oynamak pek içimden gelmiyor."

# game/Scenes/Adrian/adrian15.rpy:251
translate turkish adrian15_fd83325a:

    # gg "I'll see you later, okay?"
    gg "Sonra görüşürüz, tamam mı?"

# game/Scenes/Adrian/adrian15.rpy:252
translate turkish adrian15_e576c8b5:

    # pc "Are you going to be all right."
    pc "İyi olacak mısın?"

# game/Scenes/Adrian/adrian15.rpy:253
translate turkish adrian15_0da71ea1:

    # gg "Yeah. I'll have to be."
    gg "Evet. Olmak zorundayım."

# game/Scenes/Adrian/adrian15.rpy:254
translate turkish adrian15_4004410a:

    # gg "But I need some time alone now."
    gg "Ama şimdi biraz yalnız kalmaya ihtiyacım var."

# game/Scenes/Adrian/adrian15.rpy:255
translate turkish adrian15_b21f0baf:

    # pc "No problem. Let me know if I can help. See you later, Adrian."
    pc "Sorun değil. Yardımcı olabileceğim bir şey olursa haber ver. Görüşürüz, Adrian."

# game/Scenes/Adrian/adrian15.rpy:256
translate turkish adrian15_9d092ee2:

    # gg "Thanks, [pcname]. See ya."
    gg "Teşekkürler, [pcname]. Görüşürüz."

# game/Scenes/Adrian/adrian15.rpy:259
translate turkish adrian15_25d8780e:

    # "I leave Adrian's house, hoping that she'll be okay."
    "Adrian'ın evinden ayrılıyorum, umarım o iyi olur."

# game/Scenes/Adrian/adrian15.rpy:267
translate turkish adrian15_d9f27044:

    # "As soon as Athena is in the car and it starts to pull away, Adrian turns and collapses into my arms, crying against my shoulder."
    "Athena arabaya biner binmez ve araba hareket etmeye başlar başlamaz, Adrian dönüp kollarıma yığılır ve omzuma yaslanarak ağlar."

# game/Scenes/Adrian/adrian15.rpy:268
translate turkish adrian15_0e12d7d2:

    # gg "This fucking sucks!!!"
    gg "Bu durum berbat!!!"

# game/Scenes/Adrian/adrian15.rpy:269
translate turkish adrian15_182f9ad8:

    # "I rub her back and hold her and let her cry it out."
    "Sırtını okşuyorum, ona sarılıyorum ve ağlamasına izin veriyorum."

# game/Scenes/Adrian/adrian15.rpy:272
translate turkish adrian15_8bf9515c:

    # "A few minutes later, she sniffs up her tears and looks at me."
    "Birkaç dakika sonra, gözyaşlarını silip bana bakar."

# game/Scenes/Adrian/adrian15.rpy:273
translate turkish adrian15_3d955406:

    # gg "Okay, feeling slightly better."
    gg "Tamam, biraz daha iyi hissediyorum."

# game/Scenes/Adrian/adrian15.rpy:274
translate turkish adrian15_58a70a56:

    # gg "I want to go for a ride. Do you want to come with me?"
    gg "Bir tur atmak istiyorum. Benimle gelmek ister misin?"

# game/Scenes/Adrian/adrian15.rpy:275
translate turkish adrian15_2b3b24ff:

    # "I think I probably should stay with her, with how upset she is."
    "Bu kadar üzgün olduğu için onunla kalmam daha iyi olur sanırım."

# game/Scenes/Adrian/adrian15.rpy:276
translate turkish adrian15_2d17893f:

    # pc "Sure, let's do it, if you're okay to drive?"
    pc "Tabii, hadi gidelim, sürmeye hazır mısın?"

# game/Scenes/Adrian/adrian15.rpy:277
translate turkish adrian15_28404c62:

    # gg "Yeah, I'm okay."
    gg "Evet, hazırım."

# game/Scenes/Adrian/adrian15.rpy:280
translate turkish adrian15_58afc396:

    # gg "Here, I found her old helmet in the storage under the seat. You should probably wear it."
    gg "Bak, koltuğun altındaki saklama yerinde onun eski kaskını buldum. Muhtemelen onu takmalısın."

# game/Scenes/Adrian/adrian15.rpy:281
translate turkish adrian15_4fb22de7:

    # pc "Dear lord, this thing is huge."
    pc "Aman Tanrım, bu şey kocaman."

# game/Scenes/Adrian/adrian15.rpy:282
translate turkish adrian15_2409eb5c:

    # gg "That's what she... nevermind, let's just go."
    gg "O da bunu... boş ver, hadi gidelim."

# game/Scenes/Adrian/adrian15.rpy:283
translate turkish adrian15_9b4e9f4c:

    # pc "You know how to ride this thing?"
    pc "Bunu sürmeyi biliyor musun?"

# game/Scenes/Adrian/adrian15.rpy:284
translate turkish adrian15_12315e04:

    # gg "Yeah, Athena taught me when I visited her last time. We rode all over the place on it."
    gg "Evet, geçen sefer onu ziyaret ettiğimde Athena öğretmişti. Onunla her yeri dolaşmıştık."

# game/Scenes/Adrian/adrian15.rpy:285
translate turkish adrian15_c4bccc9f:

    # gg "I'm the only person she'd ever let drive it."
    gg "Onu sürmeme izin verdiği tek kişi benim."

# game/Scenes/Adrian/adrian15.rpy:289
translate turkish adrian15_65c8468c:

    # "I wrap my arms around her and hold on as she pulls out into the street."
    "O sokağa çıkarken kollarıma sarılıp sıkıca tutunuyorum."

# game/Scenes/Adrian/adrian15.rpy:290
translate turkish adrian15_a4cc4d56:

    # pc "Where are we going?"
    pc "Nereye gidiyoruz?"

# game/Scenes/Adrian/adrian15.rpy:291
translate turkish adrian15_33da7917:

    # gg "I just feel like riding for a while. Clear my head, you know."
    gg "Sadece biraz sürmek istiyorum. Kafamı boşaltmak için, bilirsin."

# game/Scenes/Adrian/adrian15.rpy:292
translate turkish adrian15_61f77a4c:

    # pc "Sure."
    pc "Tabii."

# game/Scenes/Adrian/adrian15.rpy:294
translate turkish adrian15_df03bfba:

    # "It feels like we're riding forever. We leave town and take a rarely used highway out towards the lake."
    "Sanki sonsuza kadar sürüyormuşuz gibi geliyor. Şehirden çıkıp, göle doğru nadiren kullanılan bir otoyola giriyoruz."

# game/Scenes/Adrian/adrian15.rpy:295
translate turkish adrian15_ba48df36:

    # "After a while, I'm not even sure where we are anymore. Hopefully Adrian knows. I guess I have GPS on the phone if we get lost."
    "Bir süre sonra, artık nerede olduğumuzdan bile emin değilim. Umarım Adrian bilir. Kaybolursak telefonumdaki GPS’i kullanabiliriz herhalde."

# game/Scenes/Adrian/adrian15.rpy:296
translate turkish adrian15_0bac7b03:

    # "But I don't say anything. I just hold on and let Adrian clear her mind of everything."
    "Ama hiçbir şey söylemiyorum. Sadece tutunuyorum ve Adrian’ın kafasını her şeyden arındırmasına izin veriyorum."

# game/Scenes/Adrian/adrian15.rpy:297
translate turkish adrian15_76cd1d73:

    # "She seems calm now, like this is exactly what she needed to get through this."
    "Artık sakin görünüyor, sanki bunu atlatmak için tam da buna ihtiyacı varmış gibi."

# game/Scenes/Adrian/adrian15.rpy:298
translate turkish adrian15_f0b56a2e:

    # "Then, after what must have been at least an hour, she pulls off the highway and drives a little ways up towards the cliffside near the lake."
    "Sonra, en az bir saat geçmiş olmalı ki, otoyoldan çıkıp gölün yanındaki uçurumun eteğine doğru biraz ilerledi."

# game/Scenes/Adrian/adrian15.rpy:301
translate turkish adrian15_135327af:

    # "We sit and I hold her close, trying to provide whatever comfort I can."
    "Oturduk ve onu sıkıca sarıldım, elimden geldiğince rahatlatmaya çalıştım."

# game/Scenes/Adrian/adrian15.rpy:302
translate turkish adrian15_fa24fdf7:

    # gg "I'm sorry I'm being such a bummer. This was supposed to be a fun day."
    gg "Bu kadar moral bozucu olduğum için özür dilerim. Bugün eğlenceli bir gün olacaktı."

# game/Scenes/Adrian/adrian15.rpy:303
translate turkish adrian15_cfd80ee8:

    # pc "It's okay, Adrian. I'm here for you. Whatever you need."
    pc "Sorun değil, Adrian. Ben senin yanındayım. Neye ihtiyacın olursa."

# game/Scenes/Adrian/adrian15.rpy:304
translate turkish adrian15_64ee3ae6:

    # gg "Thanks, [pcname]. I just need a friend really."
    gg "Teşekkürler, [pcname]. Aslında sadece bir arkadaşa ihtiyacım var."

# game/Scenes/Adrian/adrian15.rpy:306
translate turkish adrian15_d41d8cd9:

    # voice 'voices/adrian_whenitransitioned.mp3'
    voice 'voices/adrian_whenitransitioned.mp3'

# game/Scenes/Adrian/adrian15.rpy:307
translate turkish adrian15_ec81d936:

    # gg "When I transitioned, besides my mom, Athena was the only person who was there for me."
    gg "Cinsiyet geçiş sürecimde, annem dışında yanımda olan tek kişi Athena’ydı."

# game/Scenes/Adrian/adrian15.rpy:309
translate turkish adrian15_d41d8cd9_1:

    # voice 'voices/adrian_nohesitation.mp3'
    voice 'voices/adrian_nohesitation.mp3'

# game/Scenes/Adrian/adrian15.rpy:310
translate turkish adrian15_b76e91f4:

    # gg "No hesitation, no questions, just a ton of support and love."
    gg "Hiç tereddüt etmedi, soru sormadı, sadece bolca destek ve sevgi gösterdi."

# game/Scenes/Adrian/adrian15.rpy:312
translate turkish adrian15_d41d8cd9_2:

    # voice 'voices/adrian_shewastheonly.mp3'
    voice 'voices/adrian_shewastheonly.mp3'

# game/Scenes/Adrian/adrian15.rpy:313
translate turkish adrian15_5be20e3b:

    # gg "She was the only friend I had for a long time."
    gg "Uzun bir süre boyunca sahip olduğum tek arkadaş oydu."

# game/Scenes/Adrian/adrian15.rpy:317
translate turkish adrian15_d41d8cd9_3:

    # voice 'voices/adrian_untilyou.mp3'
    voice 'voices/adrian_untilyou.mp3'

# game/Scenes/Adrian/adrian15.rpy:318
translate turkish adrian15_b79560a9:

    # gg "Until you."
    gg "Ta ki sen gelene kadar."

# game/Scenes/Adrian/adrian15.rpy:320
translate turkish adrian15_d41d8cd9_4:

    # voice 'voices/adrian_missherlikecrazy.mp3'
    voice 'voices/adrian_missherlikecrazy.mp3'

# game/Scenes/Adrian/adrian15.rpy:321
translate turkish adrian15_65372d0d:

    # gg "So, I'm going to miss her like crazy, and I'm going to worry about her until I hear from her again."
    gg "Yani, onu deli gibi özleyeceğim ve ondan tekrar haber alana kadar onun için endişeleneceğim."

# game/Scenes/Adrian/adrian15.rpy:323
translate turkish adrian15_d41d8cd9_5:

    # voice 'voices/adrian_butimsoglad.mp3'
    voice 'voices/adrian_butimsoglad.mp3'

# game/Scenes/Adrian/adrian15.rpy:324
translate turkish adrian15_4de0338c:

    # gg "But I'm so glad that you're here."
    gg "Ama senin burada olmana çok seviniyorum."

# game/Scenes/Adrian/adrian15.rpy:326
translate turkish adrian15_d41d8cd9_6:

    # voice 'voices/adrian_iloveyou1.mp3'
    voice 'voices/adrian_iloveyou1.mp3'

# game/Scenes/Adrian/adrian15.rpy:327
translate turkish adrian15_9c8fbba1:

    # gg "I love you, [pcname]."
    gg "Seni seviyorum, [pcname]."

# game/Scenes/Adrian/adrian15.rpy:330
translate turkish adrian15_456cffdf:

    # pc "I love you too, Adrian."
    pc "Ben de seni seviyorum, Adrian."

# game/Scenes/Adrian/adrian15.rpy:333
translate turkish adrian15_e9e54f9a:

    # "We sit and watch the sun set, holding each other, enjoying the quiet evening."
    "Oturup güneşin batışını izliyoruz, birbirimize sarılıp sessiz akşamın tadını çıkarıyoruz."

# game/Scenes/Adrian/adrian15.rpy:334
translate turkish adrian15_5a0d166e:

    # "I just want to be whatever she needs now."
    "Şu anda onun neye ihtiyacı varsa o olmak istiyorum."

# game/Scenes/Adrian/adrian15.rpy:335
translate turkish adrian15_46b97a11:

    # "I realize how hard I've fallen for her. I'd do anything to make her happy."
    "Ona ne kadar aşık olduğumu fark ediyorum. Onu mutlu etmek için her şeyi yaparım."

# game/Scenes/Adrian/adrian15.rpy:338
translate turkish adrian15_7f8ffd28:

    # "After the sun sets, we drive back to her house."
    "Güneş battıktan sonra arabayla onun evine geri dönüyoruz."

# game/Scenes/Adrian/adrian15.rpy:341
translate turkish adrian15_78e6be93:

    # gg "It looks like my mom is home now. I'm going to have to explain everything to her."
    gg "Görünüşe göre annem eve gelmiş. Ona her şeyi açıklamak zorunda kalacağım."

# game/Scenes/Adrian/adrian15.rpy:342
translate turkish adrian15_f3610339:

    # gg "This is not going to be fun."
    gg "Bu hiç de eğlenceli olmayacak."

# game/Scenes/Adrian/adrian15.rpy:343
translate turkish adrian15_20cd9dd9:

    # pc "Want some backup?"
    pc "Destek ister misin?"

# game/Scenes/Adrian/adrian15.rpy:344
translate turkish adrian15_0c91a1a8:

    # gg "No, I think I better do this on my own."
    gg "Hayır, sanırım bunu kendi başıma halletmeliyim."

# game/Scenes/Adrian/adrian15.rpy:345
translate turkish adrian15_cf913627:

    # gg "Thanks for everything though, [pcname]. You've been amazing."
    gg "Yine de her şey için teşekkürler, [pcname]. Harikaydın."

# game/Scenes/Adrian/adrian15.rpy:346
translate turkish adrian15_c46a0b54:

    # pc "Any time."
    pc "Ne zaman istersen."

# game/Scenes/Adrian/adrian15.rpy:347
translate turkish adrian15_ee13ba27:

    # gg "I'll call you soon, okay?"
    gg "Seni yakında ararım, tamam mı?"

# game/Scenes/Adrian/adrian15.rpy:350
translate turkish adrian15_1f2a71e7:

    # pc "Okay. Good night, Adrian."
    pc "Tamam. İyi geceler, Adrian."

# game/Scenes/Adrian/adrian15.rpy:351
translate turkish adrian15_f27d9018:

    # gg "Good night, [pcname]."
    gg "İyi geceler, [pcname]."

# game/Scenes/Adrian/adrian15.rpy:352
translate turkish adrian15_80adb898:

    # "I kiss her goodbye."
    "Ona veda öpücüğü veriyorum."

# game/Scenes/Adrian/adrian15.rpy:355
translate turkish adrian15_0cbac92b:

    # "Then I get in my car and drive away, hoping that everything will be okay."
    "Sonra arabama biniyorum ve her şeyin yoluna gireceğini umarak uzaklaşıyorum."

# game/Scenes/Adrian/adrian15.rpy:356
translate turkish adrian15_339d053a:

    # "And if she needs me, I'll do anything I can to help her."
    "Ve eğer bana ihtiyacı olursa, ona yardım etmek için elimden geleni yapacağım."

translate turkish strings:

    # game/Scenes/Adrian/adrian15.rpy:6
    old "After you have checked out a local arcade with Adrian,"
    new "Adrian'la birlikte yerel bir oyun salonuna gittikten sonra,"

    # game/Scenes/Adrian/adrian15.rpy:7
    old "she will call and invite you to hang out in the afternoon on the weekend."
    new "o seni arayıp hafta sonu öğleden sonra takılmaya davet edecek."

    # game/Scenes/Adrian/adrian15.rpy:28
    old "Oh heck yeah"
    new "Tabii ki evet"

