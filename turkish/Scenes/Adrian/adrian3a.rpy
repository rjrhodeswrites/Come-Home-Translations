translate turkish adrian3a_8e7751b4:

    # "In my social studies class, Adrian and I talk a bit before class starts."
    "Sosyal bilgiler dersimde, ders başlamadan önce Adrian'la biraz konuşuyoruz."

# game/Scenes/Adrian/adrian3a.rpy:15
translate turkish adrian3a_6c261f00:

    # gg "Hey, so I bought something for you?"
    gg "Hey, sana bir şey aldım."

# game/Scenes/Adrian/adrian3a.rpy:16
translate turkish adrian3a_ae871f39:

    # pc "Oh yeah?"
    pc "Öyle mi?"

# game/Scenes/Adrian/adrian3a.rpy:17
translate turkish adrian3a_33d2e142:

    # gg "Yeah, I bought you a copy of Souls of War, so you could play with me sometime."
    gg "Evet, sana bir Souls of War kopyası aldım, böylece bir ara benimle oynayabilirsin."

# game/Scenes/Adrian/adrian3a.rpy:18
translate turkish adrian3a_7c430bc8:

    # pc "You didn't have to do that."
    pc "Buna gerek yoktu."

# game/Scenes/Adrian/adrian3a.rpy:20
translate turkish adrian3a_6012fac8:

    # gg "I know, but I really wanted to play with you and I thought this might speed things along."
    gg "Biliyorum, ama seninle gerçekten oynamak istedim ve bunun işleri hızlandıracağını düşündüm."

# game/Scenes/Adrian/adrian3a.rpy:21
translate turkish adrian3a_2f8b1c2b:

    # gg "Here, just take the code and go to the website."
    gg "Al, kodu al ve web sitesine git."

# game/Scenes/Adrian/adrian3a.rpy:22
translate turkish adrian3a_e56fb6fb:

    # pc "Thanks. I'll have to pay you back sometime."
    pc "Teşekkürler. Bir ara borcumu ödemem gerekecek."

# game/Scenes/Adrian/adrian3a.rpy:23
translate turkish adrian3a_025c91e7:

    # gg "You can pay me back by playing with me. Seriously, I'm really looking forward to it."
    gg "Benimle oynayarak borcunu ödeyebilirsin. Cidden, bunu gerçekten dört gözle bekliyorum."

# game/Scenes/Adrian/adrian3a.rpy:24
translate turkish adrian3a_9b888d1f:

    # pc "Me too, it sounds fun."
    pc "Ben de, kulağa eğlenceli geliyor."

# game/Scenes/Adrian/adrian3a.rpy:25
translate turkish adrian3a_b3bbacd5:

    # gg "I'm usually on there every night."
    gg "Genelde her gece oradayım."

# game/Scenes/Adrian/adrian3a.rpy:27
translate turkish adrian3a_4c559fd8:

    # gg "I guess I'm kind of addicted."
    gg "Sanırım biraz bağımlı oldum."

# game/Scenes/Adrian/adrian3a.rpy:30
translate turkish adrian3a_c27d3948:

    # "Ms. Welch starts talking then and puts an end to our conversation."
    "O sırada Bayan Welch konuşmaya başlar ve sohbetimizi sonlandırır."

# game/Scenes/Adrian/adrian3a.rpy:31
translate turkish adrian3a_e63040ef:

    # "After that, nothing else interesting happens throughout the day and then it is time to go to work."
    "Ondan sonra, gün boyunca ilginç başka bir şey olmaz ve sonra işe gitme vakti gelir."

translate turkish strings:

    # game/Scenes/Adrian/adrian3a.rpy:2
    old "Go over to Adrian's house and play games with her."
    new "Adrian’ın evine git ve onunla oyun oyna."

