# TODO: Translation updated at 2026-08-03 12:42

# game/Scenes/Adrian/adrian11.rpy:14
translate turkish adrian11_e6b6169b:

    # "Adrian and I have a little time to talk before class."
    "Adrian'la ders başlamadan önce biraz konuşacak vaktimiz var."

# game/Scenes/Adrian/adrian11.rpy:15
translate turkish adrian11_584cd980:

    # pc "Haven't seen you in Souls of War as much lately. Everything okay?"
    pc "Son zamanlarda Souls of War'da sizi pek görmüyorum. Her şey yolunda mı?"

# game/Scenes/Adrian/adrian11.rpy:16
translate turkish adrian11_c8aa5afa:

    # gg "Oh! Yeah, everything is great actually."
    gg "Oh! Evet, aslında her şey harika."

# game/Scenes/Adrian/adrian11.rpy:17
translate turkish adrian11_93e26893:

    # gg "I've been kind of busy with this arcade idea though."
    gg "Ama bu arcade fikriyle biraz meşgulüm."

# game/Scenes/Adrian/adrian11.rpy:18
translate turkish adrian11_37a88e09:

    # gg "I talked to Gertrude, one of the school counselors, you know?"
    gg "Okul danışmanlarından biri olan Gertrude ile konuştum, biliyor musun?"

# game/Scenes/Adrian/adrian11.rpy:20
translate turkish adrian11_25ef1d29:

    # pc "Oh, yeah. I know her."
    pc "Ah, evet. Onu tanıyorum."

# game/Scenes/Adrian/adrian11.rpy:21
translate turkish adrian11_e7b7b41e:

    # gg "She helped me change up all my classes for next semester. It's all set up now."
    gg "Gelecek dönem için tüm derslerimi değiştirmeme yardım etti. Artık her şey ayarlandı."

# game/Scenes/Adrian/adrian11.rpy:22
translate turkish adrian11_f428f0b6:

    # pc "Oh, cool!"
    pc "Ah, harika!"

# game/Scenes/Adrian/adrian11.rpy:23
translate turkish adrian11_f224267b:

    # gg "And in my spare time at home I've been doing a lot of research."
    gg "Evde boş zamanlarımda da epey araştırma yapıyorum."

# game/Scenes/Adrian/adrian11.rpy:24
translate turkish adrian11_b9375b6a:

    # gg "I even wrote up a formal business plan. Want to see?"
    gg "Hatta resmi bir iş planı bile hazırladım. Görmek ister misin?"

# game/Scenes/Adrian/adrian11.rpy:25
translate turkish adrian11_61f77a4c:

    # pc "Sure."
    pc "Tabii."

# game/Scenes/Adrian/adrian11.rpy:28
translate turkish adrian11_8dfefed2:

    # "She puts a folder with typed papers in front of me, and I flip through it."
    "Önüme daktilo ile yazılmış kağıtların bulunduğu bir klasör koyuyor ve ben de sayfaları çeviriyorum."

# game/Scenes/Adrian/adrian11.rpy:29
translate turkish adrian11_37adcdf0:

    # "There's so much information here, so much detail. She knows far more about this stuff than I do, obviously. I'm not even sure where to begin."
    "Burada çok fazla bilgi var, çok fazla ayrıntı. Belli ki bu konularda benden çok daha fazla bilgisi var. Nereden başlayacağımı bile bilmiyorum."

# game/Scenes/Adrian/adrian11.rpy:30
translate turkish adrian11_6d5e4bce:

    # gg "How does it look?"
    gg "Nasıl görünüyor?"

# game/Scenes/Adrian/adrian11.rpy:31
translate turkish adrian11_08f3eb16:

    # pc "I mean, I'm no expert here, but it looks great to me."
    pc "Yani, bu konuda uzman değilim ama bana harika görünüyor."

# game/Scenes/Adrian/adrian11.rpy:32
translate turkish adrian11_f9c7e107:

    # gg "The goal is to get people to invest so that I can get some startup money."
    gg "Amaç, insanların yatırım yapmasını sağlamak ve böylece bir başlangıç sermayesi elde etmek."

# game/Scenes/Adrian/adrian11.rpy:33
translate turkish adrian11_10293973:

    # pc "If I had the money, I'd invest for sure."
    pc "Param olsaydı, kesinlikle yatırım yapardım."

# game/Scenes/Adrian/adrian11.rpy:36
translate turkish adrian11_c4fb707b:

    # gg "Awesome! That makes me super happy."
    gg "Harika! Bu beni çok mutlu etti."

# game/Scenes/Adrian/adrian11.rpy:37
translate turkish adrian11_0c2c19e9:

    # gg "I'm actually feeling like, really good about myself right now."
    gg "Aslında şu anda kendimi gerçekten çok iyi hissediyorum."

# game/Scenes/Adrian/adrian11.rpy:38
translate turkish adrian11_1c658d00:

    # gg "Better than I've ever felt, maybe."
    gg "Belki de hiç bu kadar iyi hissetmemiştim."

# game/Scenes/Adrian/adrian11.rpy:41
translate turkish adrian11_75dceae8:

    # gg "I feel like I'm accepted for who I am."
    gg "Olduğum gibi kabul edildiğimi hissediyorum."

# game/Scenes/Adrian/adrian11.rpy:43
translate turkish adrian11_ae80f6d3:

    # gg "I have a pretty cool boyfriend."
    gg "Oldukça havalı bir erkek arkadaşım var."

# game/Scenes/Adrian/adrian11.rpy:44
translate turkish adrian11_cfc70d4a:

    # gg "And I feel like my life is heading in the right direction, for once."
    gg "Ve hayatımın ilk kez doğru yönde ilerlediğini hissediyorum."

# game/Scenes/Adrian/adrian11.rpy:45
translate turkish adrian11_07e7c552:

    # pc "I'm really happy for you."
    pc "Senin adına gerçekten çok mutluyum."

# game/Scenes/Adrian/adrian11.rpy:49
translate turkish adrian11_c7d52788:

    # gg "Thanks, [pcname]. I'm glad you're behind me."
    gg "Teşekkürler, [pcname]. Beni desteklediğine sevindim."

# game/Scenes/Adrian/adrian11.rpy:50
translate turkish adrian11_c46a0b54:

    # pc "Any time."
    pc "Ne zaman istersen."

# game/Scenes/Adrian/adrian11.rpy:53
translate turkish adrian11_380ece13:

    # "She looks away, blushing a bit."
    "Biraz kızararak başka yere bakıyor."

# game/Scenes/Adrian/adrian11.rpy:54
translate turkish adrian11_91c10599:

    # "Then Ms. Welch starts her lecture and we have to focus on school work."
    "Sonra Bayan Welch dersine başlıyor ve biz de derslerimize odaklanmak zorundayız."

# game/Scenes/Adrian/adrian11.rpy:57
translate turkish adrian11_b3da124f:

    # "The rest of the school day passes by pretty quick, then it's time for work."
    "Okul gününün geri kalanı oldukça hızlı geçiyor, sonra iş zamanı geliyor."

translate turkish strings:

    # game/Scenes/Adrian/adrian11.rpy:2
    old "After Adrian talks with you about her plans for the future,"
    new "Adrian seninle gelecek planları hakkında konuştuktan sonra,"

    # game/Scenes/Adrian/adrian11.rpy:3
    old "This scene will happen sometimes before Ms. Welch's class."
    new "Bu sahne bazen Bayan Welch'in dersinden önce gerçekleşecek."

