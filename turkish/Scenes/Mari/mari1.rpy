# game/Scenes/Mari/mari1.rpy:15
translate turkish mari1_d41d8cd9:

    # voice 'voices/mari_heysweetie.mp3'
    voice 'voices/mari_heysweetie.mp3'

# game/Scenes/Mari/mari1.rpy:16
translate turkish mari1_64c354b8:

    # fr "Hey there sweetie, good to see you. How are you doing today?"
    fr "Merhaba tatlım, seni görmek ne güzel. Bugün nasılsın?"

# game/Scenes/Mari/mari1.rpy:19
translate turkish mari1_223b1496:

    # fr "Good, I'm glad. It's nice to see you in here again, let me know if I can get you anything."
    fr "İyi, sevindim. Seni burada tekrar görmek güzel, bir şeye ihtiyacın olursa söyle."

# game/Scenes/Mari/mari1.rpy:22
translate turkish mari1_fe03e5ca:

    # fr "You're such a charmer. Keep going, I like it."
    fr "Ne kadar da çekicisin. Devam et, hoşuma gidiyor."

# game/Scenes/Mari/mari1.rpy:23
translate turkish mari1_4d51f194:

    # pc "I mean, the burgers here are great, but I'm really here just to chat with you."
    pc "Yani, buradaki hamburgerler harika ama aslında ben sadece seninle sohbet etmek için buradayım."

# game/Scenes/Mari/mari1.rpy:25
translate turkish mari1_67fd9cd9:

    # fr "Really?"
    fr "Gerçekten mi?"

# game/Scenes/Mari/mari1.rpy:26
translate turkish mari1_18128c18:

    # pc "Really."
    pc "Gerçekten."

# game/Scenes/Mari/mari1.rpy:28
translate turkish mari1_8aa0b3f4:

    # fr "You're so sweet. Thanks for the compliments, but I better get back to work. Let me know if I can get you anything."
    fr "Çok tatlısın. İltifatların için teşekkürler ama işime dönsem iyi olacak. Sana bir şey getireyim mi?"

# game/Scenes/Mari/mari1.rpy:29
translate turkish mari1_c0bafa60:

    # pc "Can I get a straw for my drink?"
    pc "İçeceğim için bir pipet alabilir miyim?"

# game/Scenes/Mari/mari1.rpy:31
translate turkish mari1_d41d8cd9_1:

    # voice marisurething
    voice marisurething

# game/Scenes/Mari/mari1.rpy:32
translate turkish mari1_f2433589:

    # fr "Sure thing, honey."
    fr "Tabii ki tatlım."

# game/Scenes/Mari/mari1.rpy:33
translate turkish mari1_ab35ef2d:

    # "She reaches into her pocket to pull out one of the straws and a dozen more pop out and fall onto the floor, scattering around."
    "Cebine uzanıp pipetlerden birini çıkarmak isterken, bir düzine pipet daha fırlayıp yere düşer ve etrafa dağılır."

# game/Scenes/Mari/mari1.rpy:36
translate turkish mari1_d41d8cd9_2:

    # voice 'voices/mari_shoot2.mp3'
    voice 'voices/mari_shoot2.mp3'

# game/Scenes/Mari/mari1.rpy:37
translate turkish mari1_aaf7d6fa:

    # fr "Ah shoot, sorry about that."
    fr "Ah, hay aksi, özür dilerim."

# game/Scenes/Mari/mari1.rpy:38
translate turkish mari1_76e2166e:

    # fr "Just a second, let me get these."
    fr "Bir saniye, bunları toplayayım."

# game/Scenes/Mari/mari1.rpy:40
translate turkish mari1_29517e2b:

    # "She kneels down and gets on hands and knees on the floor, picking up the straws that had scattered around."
    "Diz çöküp yere el ve dizlerinin üzerine çöker, etrafa dağılmış pipetleri toplar."

# game/Scenes/Mari/mari1.rpy:41
translate turkish mari1_fa53362f:

    # fr "I'm so sorry."
    fr "Çok özür dilerim."

# game/Scenes/Mari/mari1.rpy:44
translate turkish mari1_6ce37599:

    # fr "I'm so clumsy sometimes."
    fr "Bazen çok sakarım."

# game/Scenes/Mari/mari1.rpy:45
translate turkish mari1_bdb852f0:

    # "She quickly finishes grabbing the rest of the straws and stands back up."
    "Kalan pipetleri de çabucak toplayıp ayağa kalkar."

# game/Scenes/Mari/mari1.rpy:48
translate turkish mari1_c84cc9f0:

    # fr "What?"
    fr "Ne?"

# game/Scenes/Mari/mari1.rpy:50
translate turkish mari1_d41d8cd9_3:

    # voice 'voices/mari_youlikethat.mp3'
    voice 'voices/mari_youlikethat.mp3'

# game/Scenes/Mari/mari1.rpy:51
translate turkish mari1_50b1ddec:

    # fr "Oh. You like that do you?"
    fr "Oh. Hoşuna gitti mi?"

# game/Scenes/Mari/mari1.rpy:53
translate turkish mari1_7fbd7f76:

    # fr "What about this? You like this?"
    fr "Peki ya bu? Bunu beğendin mi?"

# game/Scenes/Mari/mari1.rpy:54
translate turkish mari1_9bf0a886:

    # pc "I definitely do."
    pc "Kesinlikle beğendim."

# game/Scenes/Mari/mari1.rpy:55
translate turkish mari1_bdb852f0_1:

    # "She quickly finishes grabbing the rest of the straws and stands back up."
    "Kalan pipetleri de çabucak toplayıp ayağa kalkar."

# game/Scenes/Mari/mari1.rpy:57
translate turkish mari1_2771e6a1:

    # fr "I hope that was worth a little bit more of a tip?"
    fr "Umarım bu, biraz daha fazla bahşiş almaya değer bir şeydi?"

# game/Scenes/Mari/mari1.rpy:58
translate turkish mari1_81450635:

    # pc "Oh I could give you more than the tip."
    pc "Oh, sana bahşişten fazlasını verebilirim."

# game/Scenes/Mari/mari1.rpy:60
translate turkish mari1_053e79a0:

    # fr "You're so bad!"
    fr "Sen çok yaramazsın!"

# game/Scenes/Mari/mari1.rpy:63
translate turkish mari1_bab66bf3:

    # fr "I'll be right back with a straw that hasn't been on the floor."
    fr "Yere düşmemiş bir pipetle hemen dönerim."

# game/Scenes/Mari/mari1.rpy:64
translate turkish mari1_c8cd6f6b:

    # "She comes back with my straw and then my food shortly after that."
    "Pipetimi getirir ve kısa bir süre sonra da yemeğimi getirir."

# game/Scenes/Mari/mari1.rpy:65
translate turkish mari1_2e5f61be:

    # "We don't talk much more, but she gives me a beautiful smile every time I look up at her."
    "Fazla konuşmayız ama ne zaman ona baksam bana güzel bir gülümseme atar."

# game/Scenes/Mari/mari1.rpy:69
translate turkish mari1_e88fc8e1:

    # "When I finish and it's time to leave, she waves at me."
    "Yemeğimi bitirip gitme vakti geldiğinde bana el sallar."

# game/Scenes/Mari/mari1.rpy:71
translate turkish mari1_d41d8cd9_4:

    # voice 'voices/mari_thanksgoodnight.mp3'
    voice 'voices/mari_thanksgoodnight.mp3'

# game/Scenes/Mari/mari1.rpy:72
translate turkish mari1_7949c609:

    # fr "Thanks for coming in! You have a good night!"
    fr "Geldiğiniz için teşekkürler! İyi geceler!"

# game/Scenes/Mari/mari1.rpy:75
translate turkish maritip2_1ce16e45:

    # "I walk up to her and put a ten-dollar bill into her hand."
    "Yanına yaklaşır ve eline on dolarlık bir banknot sıkıştırırım."

# game/Scenes/Mari/mari1.rpy:78
translate turkish maritip2_d41d8cd9:

    # voice 'voices/mari_thankyousomuch.mp3'
    voice 'voices/mari_thankyousomuch.mp3'

# game/Scenes/Mari/mari1.rpy:79
translate turkish maritip2_1e720979:

    # fr "Thanks so much, you're the best."
    fr "Çok teşekkürler, sen harikasın."

# game/Scenes/Mari/mari1.rpy:81
translate turkish maritip2_890abf2a:

    # "Without warning, she lunges forward and wraps her arms around me, pulling me into a close hug."
    "Hiç haber vermeden bana doğru atılır ve kollarını bana dolayarak beni sıkıca kucaklar."

# game/Scenes/Mari/mari1.rpy:82
translate turkish maritip2_9ba61eed:

    # "She's so warm and soft."
    "O kadar sıcak ve yumuşak ki."

# game/Scenes/Mari/mari1.rpy:83
translate turkish maritip2_23314f60:

    # "And bonus - she smells like burgers."
    "Üstelik - hamburger gibi kokuyor."

# game/Scenes/Mari/mari1.rpy:84
translate turkish maritip2_c96f83e2:

    # pc "Well you're a great waitress."
    pc "Sen harika bir garsonsun."

# game/Scenes/Mari/mari1.rpy:85
translate turkish maritip2_d1889969:

    # fr "It's easy when the customers are as nice as you are."
    fr "Müşteriler senin kadar nazik olduğunda işim kolaylaşıyor."

# game/Scenes/Mari/mari1.rpy:86
translate turkish maritip2_9bc4e48c:

    # fr "Come back and see me again soon, okay?"
    fr "Yakında tekrar gelip beni gör, tamam mı?"

# game/Scenes/Mari/mari1.rpy:87
translate turkish maritip2_9782867b:

    # pc "Oh I'm sure I will."
    pc "Oh, tabii ki geleceğim."

# game/Scenes/Mari/mari1.rpy:89
translate turkish maritip2_fb1fac0d:

    # fr "Have a good night, sweetie."
    fr "İyi geceler tatlım."

# game/Scenes/Mari/mari1.rpy:90
translate turkish maritip2_eb61ef6e:

    # pc "You too."
    pc "Sana da."

# game/Scenes/Mari/mari1.rpy:92
translate turkish maritip2_3cb27537:

    # "I give her a wave."
    "Ona el sallıyorum."

# game/Scenes/Mari/mari1.rpy:93
translate turkish maritip2_739d2b0c:

    # "With that, I go back outside and head to my car."
    "Bunun üzerine dışarı çıkıp arabama doğru yürüyorum."

