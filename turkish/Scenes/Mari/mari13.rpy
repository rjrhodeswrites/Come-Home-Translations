    # fr "The big one is Appa, and the little guy is Momo."
    fr "Büyük olanın adı Appa, küçük olanınki ise Momo."

# game/Scenes/Mari/mari13.rpy:144
translate turkish mari13rebahelp_b4839da7:

    # rb "Oh my God, I love them!"
    rb "Aman Tanrım, onlara bayıldım!"

# game/Scenes/Mari/mari13.rpy:147
translate turkish mari13rebahelp_34d27c0e:

    # rb "You didn't tell me that I was fixin' this car for a cute girlfriend of yours, [pcname]."
    rb "Bu arabayı senin sevimli kız arkadaşın için tamir ettiğimi söylememiştin, [pcname]."

# game/Scenes/Mari/mari13.rpy:148
translate turkish mari13rebahelp_be9414f2:

    # pc "Oh, sorry."
    pc "Oh, özür dilerim."

# game/Scenes/Mari/mari13.rpy:149
translate turkish mari13rebahelp_380ac7ef:

    # rb "Naw, it's no problem, I'm just messin'."
    rb "Hayır, sorun değil, sadece dalga geçiyordum."

# game/Scenes/Mari/mari13.rpy:151
translate turkish mari13rebahelp_f7c6563e:

    # rb "Aw, hey I remember you from the burger place."
    rb "Ah, hey, seni hamburgerci dükkanından hatırlıyorum."

# game/Scenes/Mari/mari13.rpy:152
translate turkish mari13rebahelp_11d0fe17:

    # fr "Hey, yeah that's me."
    fr "Hey, evet, o benim."

# game/Scenes/Mari/mari13.rpy:154
translate turkish mari13rebahelp_2acf7aec:

    # rb "I'm Reba, by the way."
    rb "Bu arada, ben Reba."

# game/Scenes/Mari/mari13.rpy:155
translate turkish mari13rebahelp_6f785a5d:

    # fr "Hello. I'm Mari. Nice to meet you."
    fr "Merhaba. Ben Mari. Tanıştığımıza memnun oldum."

# game/Scenes/Mari/mari13.rpy:156
translate turkish mari13rebahelp_a9aba0f6:

    # rb "Okay, let's see what this thing is doing."
    rb "Tamam, bakalım bu şey ne durumda."

# game/Scenes/Mari/mari13.rpy:159
translate turkish mari13rebahelp_1a16e9d4:

    # rb "So how long you say it's been sitting here?"
    rb "Peki, ne kadar süredir burada duruyor demiştin?"

# game/Scenes/Mari/mari13.rpy:160
translate turkish mari13rebahelp_8ebf8623:

    # fr "About four years."
    fr "Yaklaşık dört yıldır."

# game/Scenes/Mari/mari13.rpy:161
translate turkish mari13rebahelp_90a271fa:

    # rb "Alright, and y'all replaced the battery already, so that's good."
    rb "Tamam, aküyü de değiştirmişsiniz, bu iyi."

# game/Scenes/Mari/mari13.rpy:162
translate turkish mari13rebahelp_22d6811f:

    # rb "I'm gonna try a few things, but I expect we'll have to change the gas in the tank, because it's probably gone bad."
    rb "Birkaç şey deneyeceğim, ama sanırım depodaki benzini değiştirmemiz gerekecek, çünkü muhtemelen bozulmuştur."

# game/Scenes/Mari/mari13.rpy:163
translate turkish mari13rebahelp_2dc05954:

    # rb "And I'll clean out the air filter and change the oil and might have to replace the fuel pump too."
    rb "Hava filtresini temizleyeceğim, yağı değiştireceğim ve yakıt pompasını da değiştirmem gerekebilir."

# game/Scenes/Mari/mari13.rpy:164
translate turkish mari13rebahelp_1bccde91:

    # rb "Then after all that, if the engine starts, we'll have to get those tires aired up. They don't look like they've rotted, which is good. Hopefully they'll still hold air."
    rb "Bunların hepsinden sonra, motor çalışırsa, lastiklere hava basmamız gerekecek. Çürümüş gibi görünmüyorlar, bu iyi bir şey. Umarım hala hava tutarlar."

# game/Scenes/Mari/mari13.rpy:168
