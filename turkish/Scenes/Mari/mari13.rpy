    # "I give Reba directions to Mari's farm and a few minutes later she meets us there."
    "Reba’ya Mari’nin çiftliğine yol tarifini veriyorum ve birkaç dakika sonra orada bizimle buluşuyor."

# game/Scenes/Mari/mari13.rpy:138
translate turkish mari13rebahelp_05b2461c:

    # rb "Oh my God! Your dogs are {i}so{/i} cute."
    rb "Aman Tanrım! Köpeklerin {i}çok{/i} sevimli."

# game/Scenes/Mari/mari13.rpy:139
translate turkish mari13rebahelp_22df0ba2:

    # fr "They seem to like you."
    fr "Senden hoşlanmış gibiler."

# game/Scenes/Mari/mari13.rpy:140
