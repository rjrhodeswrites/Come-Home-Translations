    # fr "Sure thing!"
    fr "Tabii ki!"

# game/Scenes/Mari/mari13.rpy:178
translate turkish mari13rebahelp_ab992a3c:

    # rb "So you don't drive?"
    rb "Yani araba kullanmıyorsun mu?"

# game/Scenes/Mari/mari13.rpy:179
translate turkish mari13rebahelp_205c26d0:

    # fr "No, I haven't ever learned. My parents were killed in a car accident and I've been kind of scared of them since then."
    fr "Hayır, hiç öğrenmedim. Ailem bir trafik kazasında hayatını kaybetti ve o zamandan beri arabalardan biraz korkuyorum."

# game/Scenes/Mari/mari13.rpy:180
translate turkish mari13rebahelp_b0f6c8c0:

    # rb "Aw dang, I'm sorry. My daddy's gone too. I know it hurts."
    rb "Vay canına, çok üzüldüm. Benim babam da yok artık. Ne kadar acı verdiğini biliyorum."

# game/Scenes/Mari/mari13.rpy:181
translate turkish mari13rebahelp_254e65aa:

