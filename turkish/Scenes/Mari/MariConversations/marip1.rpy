# game/Scenes/Mari/MariConversations/marip1.rpy:16
translate turkish marip1_ec4a3669:

    # fr "This is a hard story for me to tell. Are you sure you want to hear about it?"
    fr "Bu hikayeyi anlatmak benim için zor. Bunu duymak istediğinden emin misin?"

# game/Scenes/Mari/MariConversations/marip1.rpy:19
translate turkish marip1_124cbb0b:

    # fr "I trust you and I like you. I want you to know about it."
    fr "Sana güveniyorum ve senden hoşlanıyorum. Bunu bilmeni istiyorum."

# game/Scenes/Mari/MariConversations/marip1.rpy:21
translate turkish marip1_c9426e7f:

    # fr "Okay. I trust you and I want you to know about it."
    fr "Tamam. Sana güveniyorum ve bunu bilmeni istiyorum."

# game/Scenes/Mari/MariConversations/marip1.rpy:25
translate turkish marip1_d41d8cd9:

    # voice 'voices/mari_yeah.mp3'
    voice 'voices/mari_yeah.mp3'

# game/Scenes/Mari/MariConversations/marip1.rpy:26
translate turkish marip1_e1a717b7:

    # fr "Yeah, let's not talk about sad stuff today."
    fr "Evet, bugün üzücü şeylerden bahsetmeyelim."

# game/Scenes/Mari/MariConversations/marip1.rpy:27
translate turkish marip1_a5b1d94c:

    # fr "Maybe some other time."
    fr "Belki başka bir zaman."

# game/Scenes/Mari/MariConversations/marip1.rpy:30
translate turkish marip1_dc5e9084:

    # fr "So I'll tell you what happened."
    fr "O zaman sana ne olduğunu anlatayım."

# game/Scenes/Mari/MariConversations/marip1.rpy:31
translate turkish marip1_89daecb4:

    # fr "We were all packed into my dad's SUV, driving to a restaurant in Whiterock."
    fr "Hepimiz babamın SUV'sine sıkışmıştık ve Whiterock'taki bir restorana gidiyorduk."

# game/Scenes/Mari/MariConversations/marip1.rpy:32
translate turkish marip1_4ecefbf2:

    # fr "This was nearly 4 years ago. I was 18."
    fr "Bu yaklaşık 4 yıl önceydi. 18 yaşındaydım."

# game/Scenes/Mari/MariConversations/marip1.rpy:33
translate turkish marip1_f52ca67a:

    # fr "My dad was driving, mom was in the passenger seat, and I was sitting in the back with my grandmother and my Aunt Susan."
    fr "Babam sürüyordu, annem yolcu koltuğundaydı ve ben de büyükannemle Susan teyzemle birlikte arka koltukta oturuyordum."

# game/Scenes/Mari/MariConversations/marip1.rpy:35
translate turkish marip1_073ae7ca:

    # fr "When our car was on the bridge that leads into Whiterock, a semi-truck coming in the other direction veered over into our lane and hit us head-on."
    fr "Arabamız Whiterock’a giden köprüdeyken, karşı yönden gelen bir tır bizim şeridimize saptı ve bize kafa kafaya çarptı."

# game/Scenes/Mari/MariConversations/marip1.rpy:36
translate turkish marip1_9a1c473f:

    # fr "I woke up nearly a month later and I couldn't remember anything."
    fr "Neredeyse bir ay sonra uyandım ve hiçbir şey hatırlayamıyordum."

# game/Scenes/Mari/MariConversations/marip1.rpy:37
translate turkish marip1_68df3d2e:

    # fr "The doctor told me that they had all been killed in the accident. The truck driver had fallen asleep at the wheel. He was dead too."
    fr "Doktor bana, kazada hepsinin öldüğünü söyledi. Tır şoförü direksiyon başında uyuyakalmıştı. O da ölmüştü."

# game/Scenes/Mari/MariConversations/marip1.rpy:38
translate turkish marip1_944ca833:

    # fr "I was the only survivor."
    fr "Hayatta kalan tek kişi bendim."

# game/Scenes/Mari/MariConversations/marip1.rpy:39
translate turkish marip1_2dffe0f5:

    # fr "My whole life was in that car, wiped away in an instant."
    fr "Tüm hayatım o arabadaydı, bir anda silinip gitti."

# game/Scenes/Mari/MariConversations/marip1.rpy:40
translate turkish marip1_7c8d475f:

    # fr "Now all that I have left is my farm and my animals."
    fr "Artık elimde kalan tek şey çiftliğim ve hayvanlarım."

# game/Scenes/Mari/MariConversations/marip1.rpy:41
translate turkish marip1_36223d79:

    # fr "That's why they mean so much to me, and also why I've never learned to drive. I'm pretty scared of cars."
    fr "Bu yüzden onlar benim için çok değerli ve bu yüzden de hiç araba kullanmayı öğrenmedim. Arabalardan oldukça korkuyorum."

# game/Scenes/Mari/MariConversations/marip1.rpy:44
translate turkish marip1_61b06a2b:

    # fr "Yeah. Sorry to bring down the date."
    fr "Evet. Havayı bozduğum için özür dilerim."

# game/Scenes/Mari/MariConversations/marip1.rpy:45
translate turkish marip1_7e2a8815:

    # pc "It's okay, I wanted to know. Thank you for telling me."
    pc "Sorun değil, bilmek istemiştim. Anlattığın için teşekkür ederim."

# game/Scenes/Mari/MariConversations/marip1.rpy:46
translate turkish marip1_b8c78b04:

    # fr "You're welcome."
    fr "Rica ederim."

# game/Scenes/Mari/MariConversations/marip1.rpy:51
translate turkish marip1_90a640e6:

    # fr "Thank you."
    fr "Teşekkürler."

# game/Scenes/Mari/MariConversations/marip1.rpy:52
translate turkish marip1_f648d2ef:

    # "I hold her like that for a bit, while she cries the rest of her tears out."
    "O kalan gözyaşlarını dökene kadar onu bir süre öyle kucaklıyorum."

# game/Scenes/Mari/MariConversations/marip1.rpy:53
translate turkish marip1_ec648553:

    # "Then she pulls away."
    "Sonra benden uzaklaşıyor."

# game/Scenes/Mari/MariConversations/marip1.rpy:58
translate turkish marip1_42ad97de:

    # fr "Yeah, no kidding."
    fr "Evet, şaka değil."

# game/Scenes/Mari/MariConversations/marip1.rpy:59
translate turkish marip1_236f25d9:

    # fr "Now I'm going to wipe my eyes and we're going to only talk about happy stuff the rest of the time. Deal?"
    fr "Şimdi gözlerimi sileceğim ve geri kalan zamanda sadece mutlu şeylerden bahsedeceğiz. Anlaştık mı?"

# game/Scenes/Mari/MariConversations/marip1.rpy:60
translate turkish marip1_8ef8e0e9:

    # pc "Deal."
    pc "Anlaştık."

translate turkish strings:

    # game/Scenes/Mari/MariConversations/marip1.rpy:18
    old "Only if you want to tell it."
    new "Sadece anlatmak istersen."

    # game/Scenes/Mari/MariConversations/marip1.rpy:20
    old "Yes, please."
    new "Evet, lütfen."

    # game/Scenes/Mari/MariConversations/marip1.rpy:22
    old "Maybe not."
    new "Belki de anlatmam."

    # game/Scenes/Mari/MariConversations/marip1.rpy:43
    old "That's so awful"
    new "Bu çok korkunç."

    # game/Scenes/Mari/MariConversations/marip1.rpy:57
    old "Wow, shit luck"
    new "Vay canına, ne şanssızlık."

