translate turkish marip6_a9c1c999:

    # fr "Uh… I'm not sure I'm ready to talk about that yet."
    fr "Şey… Henüz bunu konuşmaya hazır olduğumdan emin değilim."

# game/Scenes/Mari/MariConversations/marip6.rpy:14
translate turkish marip6_a67893bc:

    # pc "Oh… okay."
    pc "Oh… tamam."

# game/Scenes/Mari/MariConversations/marip6.rpy:15
translate turkish marip6_614b83cc:

    # fr "Sorry. That's kind of a cop out."
    fr "Üzgünüm. Bu biraz kaçamak bir cevap oldu."

# game/Scenes/Mari/MariConversations/marip6.rpy:16
translate turkish marip6_da8c3fd1:

    # fr "But I'm honestly worried that you're not going to like me anymore when you find out what I'm really into."
    fr "Ama dürüst olmak gerekirse, gerçekte nelerden hoşlandığımı öğrendiğinde benden hoşlanmayacağından endişeleniyorum."

# game/Scenes/Mari/MariConversations/marip6.rpy:20
translate turkish marip6_6213b93b:

    # fr "I'm glad."
    fr "Sevindim."

# game/Scenes/Mari/MariConversations/marip6.rpy:21
translate turkish marip6_1b4a453a:

    # fr "I'll show you soon, I promise."
    fr "Sana yakında göstereceğim, söz veriyorum."

# game/Scenes/Mari/MariConversations/marip6.rpy:24
translate turkish marip6_ac5140d1:

    # fr "Aw, that's really sweet."
    fr "Ah, bu gerçekten çok tatlı."

# game/Scenes/Mari/MariConversations/marip6.rpy:25
translate turkish marip6_635b034a:

    # fr "You're making me very happy already, doing what we've been doing."
    fr "Şu ana kadar yaptıklarımızla beni şimdiden çok mutlu ediyorsun."

# game/Scenes/Mari/MariConversations/marip6.rpy:26
translate turkish marip6_40137676:

    # pc "If there's anything else I could be doing to make you happier though, I'd like to."
    pc "Yine de seni daha mutlu etmek için yapabileceğim başka bir şey varsa, seve seve yaparım."

# game/Scenes/Mari/MariConversations/marip6.rpy:28
translate turkish marip6_1b4a453a_1:

    # fr "I'll show you soon, I promise."
    fr "Sana yakında göstereceğim, söz veriyorum."

# game/Scenes/Mari/MariConversations/marip6.rpy:30
translate turkish marip6_3f246ba4:

    # fr "Sorry, I'm just not quite ready yet."
    fr "Üzgünüm, henüz tam olarak hazır değilim."

# game/Scenes/Mari/MariConversations/marip6.rpy:31
translate turkish marip6_6c1afee9:

    # fr "I'll show you soon though, I promise."
    fr "Ama yakında göstereceğim, söz veriyorum."

# game/Scenes/Mari/MariConversations/marip6.rpy:32
translate turkish marip6_3d0a1d8b:

    # pc "That sounds a little ominous."
    pc "Bu biraz uğursuz geliyor."

# game/Scenes/Mari/MariConversations/marip6.rpy:34
translate turkish marip6_552d5d50:

    # fr "Nothing that bad."
    fr "O kadar da kötü bir şey değil."

# game/Scenes/Mari/MariConversations/marip6.rpy:35
translate turkish marip6_f70b29ed:

    # fr "It's just something that some people find a little weird."
    fr "Sadece bazı insanların biraz tuhaf bulduğu bir şey."

# game/Scenes/Mari/MariConversations/marip6.rpy:36
translate turkish marip6_42c307f8:

    # pc "Well I'm looking forward to finding out what it is."
    pc "Peki, ne olduğunu öğrenmeyi sabırsızlıkla bekliyorum."

# game/Scenes/Mari/MariConversations/marip6.rpy:37
translate turkish marip6_74fe9590:

    # fr "Thank you for giving me time."
    fr "Bana zaman ayırdığın için teşekkür ederim."

