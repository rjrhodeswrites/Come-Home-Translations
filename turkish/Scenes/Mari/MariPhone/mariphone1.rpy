# game/Scenes/Mari/MariPhone/mariphone1.rpy:6
translate turkish mariphone1_bb37d3e4:

    # fr "Hello?"
    fr "Alo?"

# game/Scenes/Mari/MariPhone/mariphone1.rpy:7
translate turkish mariphone1_096d1d51:

    # pc "Hey Mari, it's [pcname]."
    pc "Selam Mari, ben [pcname]."

# game/Scenes/Mari/MariPhone/mariphone1.rpy:9
translate turkish mariphone1_5ed0c02d:

    # fr "Oh hi, [pcname]. I was hoping you'd actually call me!"
    fr "Merhaba [pcname]. Gerçekten beni arayacağını umuyordum!"

# game/Scenes/Mari/MariPhone/mariphone1.rpy:10
translate turkish mariphone1_57807e81:

    # pc "Of course, why wouldn't I?"
    pc "Tabii ki, neden aramayayım ki?"

# game/Scenes/Mari/MariPhone/mariphone1.rpy:12
translate turkish mariphone1_0188f787:

    # fr "I don't know, I get a lot of guys who hit on me when I wait on them, but very few actually call me afterwards."
    fr "Bilmiyorum, onlara hizmet ederken bana asılan bir sürü erkek oluyor, ama sonrasında gerçekten beni arayan çok azı var."

# game/Scenes/Mari/MariPhone/mariphone1.rpy:13
translate turkish mariphone1_4f2020b2:

    # pc "Their loss."
    pc "Onların kaybı."

# game/Scenes/Mari/MariPhone/mariphone1.rpy:15
translate turkish mariphone1_133dd711:

    # fr "Ha, I guess so."
    fr "Ha, sanırım öyle."

# game/Scenes/Mari/MariPhone/mariphone1.rpy:16
translate turkish mariphone1_22afdb68:

    # pc "So about that date?"
    pc "Peki, o randevu ne olacak?"

# game/Scenes/Mari/MariPhone/mariphone1.rpy:20
translate turkish mariphone1_c896b06e:

    # fr "What about right now? I'm not busy."
    fr "Şu anda nasıl olur? Meşgul değilim."

# game/Scenes/Mari/MariPhone/mariphone1.rpy:23
translate turkish mariphone1_2b65f161:

    # fr "I'd love to, but it's a little late right now."
    fr "Çok isterdim, ama şu anda biraz geç oldu."

# game/Scenes/Mari/MariPhone/mariphone1.rpy:24
translate turkish mariphone1_42d6aa16:

    # fr "Maybe give me a call a little earlier? I'm free most weekends earlier in the day."
    fr "Belki biraz daha erken ararsın? Hafta sonlarının sabahları genellikle boşum."

# game/Scenes/Mari/MariPhone/mariphone1.rpy:25
translate turkish mariphone1_50eb93b7:

    # pc "Okay, sounds good."
    pc "Tamam, iyi olur."

# game/Scenes/Mari/MariPhone/mariphone1.rpy:27
translate turkish mariphone1_1499c8ef:

    # fr "I'm really looking forward to going out with you."
    fr "Seninle çıkmayı gerçekten çok istiyorum."

# game/Scenes/Mari/MariPhone/mariphone1.rpy:28
translate turkish mariphone1_03eaad50:

    # pc "Me too."
    pc "Ben de."

# game/Scenes/Mari/MariPhone/mariphone1.rpy:29
translate turkish mariphone1_3cf20ab9:

    # fr "Okay, we'll I'll talk to you later then. Don't forget to call."
    fr "Tamam, o zaman sonra görüşürüz. Aramayı unutma."

# game/Scenes/Mari/MariPhone/mariphone1.rpy:30
translate turkish mariphone1_d0a145a4:

    # pc "I won't. Bye Mari."
    pc "Unutmam. Hoşça kal Mari."

# game/Scenes/Mari/MariPhone/mariphone1.rpy:31
translate turkish mariphone1_364fcd03:

    # fr "Bye, [pcname]."
    fr "Hoşça kal, [pcname]."

# game/Scenes/Mari/MariPhone/mariphone1.rpy:35
translate turkish mariphone1_281453bb:

    # fr "I'd love to, but I work nearly every evening on weekdays. Maybe we could go on the weekend sometime?"
    fr "Çok isterdim, ama hafta içi neredeyse her akşam çalışıyorum. Belki hafta sonu bir ara çıkabiliriz?"

# game/Scenes/Mari/MariPhone/mariphone1.rpy:36
translate turkish mariphone1_4f1735dd:

    # pc "Sounds good to me."
    pc "Bana uyar."

# game/Scenes/Mari/MariPhone/mariphone1.rpy:38
translate turkish mariphone1_726d3b83:

    # fr "Okay, give me a call on the weekend then."
    fr "Tamam, o zaman hafta sonu beni ara."

# game/Scenes/Mari/MariPhone/mariphone1.rpy:39
translate turkish mariphone1_63be461a:

    # pc "I will! Bye Mari."
    pc "Arayacağım! Hoşça kal Mari."

# game/Scenes/Mari/MariPhone/mariphone1.rpy:40
translate turkish mariphone1_364fcd03_1:

    # fr "Bye, [pcname]."
    fr "Hoşça kal, [pcname]."

# game/Scenes/Mari/MariPhone/mariphone1.rpy:42
translate turkish mariphone1_2fb7e364:

    # pc "Sure. I'll come pick you up."
    pc "Tabii. Seni almaya gelirim."

# game/Scenes/Mari/MariPhone/mariphone1.rpy:44
translate turkish mariphone1_24af4011:

    # fr "Great! You remember how to get out to my place?"
    fr "Harika! Evime nasıl gelineceğini hatırlıyor musun?"

# game/Scenes/Mari/MariPhone/mariphone1.rpy:45
translate turkish mariphone1_8e7d7319:

    # pc "Yeah, no problem."
    pc "Evet, sorun değil."

# game/Scenes/Mari/MariPhone/mariphone1.rpy:46
translate turkish mariphone1_c32afb2c:

    # fr "Awesome. Well I'm really looking forward to it."
    fr "Süper. Gerçekten sabırsızlanıyorum."

# game/Scenes/Mari/MariPhone/mariphone1.rpy:47
translate turkish mariphone1_03eaad50_1:

    # pc "Me too."
    pc "Ben de."

# game/Scenes/Mari/MariPhone/mariphone1.rpy:48
translate turkish mariphone1_5c2ba016:

    # fr "Alright, well I'll see you when you get here then."
    fr "Tamam, o zaman buraya geldiğinde görüşürüz."

# game/Scenes/Mari/MariPhone/mariphone1.rpy:49
translate turkish mariphone1_f4f0e9a7:

    # pc "Okay, I'll get ready to head out right now."
    pc "Tamam, hemen çıkmak için hazırlanacağım."

# game/Scenes/Mari/MariPhone/mariphone1.rpy:50
translate turkish mariphone1_d9729a57:

    # fr "Me too. I better hurry. Bye!"
    fr "Ben de. Acele etsem iyi olur. Hoşça kal!"

# game/Scenes/Mari/MariPhone/mariphone1.rpy:51
translate turkish mariphone1_b6df41e9:

    # "I start getting ready to leave while I think about where I should take her."
    "Onu nereye götürmeliyim diye düşünürken çıkmak için hazırlanmaya başlıyorum."

# game/Scenes/Mari/MariPhone/mariphone1.rpy:52
translate turkish mariphone1_1715c9d7:

    # "I think she'd like a peaceful morning stroll around the park. Just keep it simple so that we can talk and get to know each other better."
    "Sanırım parkta sakin bir sabah yürüyüşü hoşuna gider. Sohbet edip birbirimizi daha iyi tanıyabilmemiz için basit bir şey olsun."

# game/Scenes/Mari/MariPhone/mariphone1.rpy:53
translate turkish mariphone1_c6ad64a6:

    # "Once I get cleaned up and dressed, I rush down to the car and leave."
    "Temizlenip giyindikten sonra arabaya koşup çıkıyorum."

