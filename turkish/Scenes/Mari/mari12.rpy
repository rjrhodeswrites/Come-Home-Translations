    # voice 'voices/mari12audio12.mp3'
    voice 'voices/mari12audio12.mp3'

# game/Scenes/Mari/mari12.rpy:69
translate turkish mari12b_a5572b6c:

    # fr "I know they're not here. But this feels like the closest I can be to them."
    fr "Burada olmadıklarını biliyorum. Ama bu, onlara en yakın olabileceğim hissi veriyor."

# game/Scenes/Mari/mari12.rpy:73
translate turkish mari12b_d41d8cd9_6:

    # voice 'voices/mari_missyousomuch.mp3'
    voice 'voices/mari_missyousomuch.mp3'

# game/Scenes/Mari/mari12.rpy:74
translate turkish mari12b_7ab90ce1:

    # fr "I miss you so much."
    fr "Sizi çok özlüyorum."

# game/Scenes/Mari/mari12.rpy:76
translate turkish mari12b_d41d8cd9_7:

    # voice 'voices/mari12audio13.mp3'
    voice 'voices/mari12audio13.mp3'

