    voice 'voices/mari12audio3.mp3'

# game/Scenes/Mari/mari12.rpy:26
translate turkish mari12_68fa0e33:

    # fr "It's kind of a downer, I know... but today is the anniversary of my parents' death."
    fr "Biraz moral bozucu bir konu, biliyorum... ama bugün annemle babamın ölüm yıldönümü."

# game/Scenes/Mari/mari12.rpy:28
translate turkish mari12_d41d8cd9_3:

    # voice 'voices/mari12audio4.mp3'
    voice 'voices/mari12audio4.mp3'

# game/Scenes/Mari/mari12.rpy:29
translate turkish mari12_f3750784:

    # fr "Do you think that you could give me a ride out to the cemetery to put flowers on their stone?"
    fr "Beni mezarlığa götürüp mezar taşlarına çiçek bırakmama yardım eder misin?"

# game/Scenes/Mari/mari12.rpy:31
translate turkish mari12_d41d8cd9_4:

    # voice 'voices/mari12audio5.mp3'
    voice 'voices/mari12audio5.mp3'

# game/Scenes/Mari/mari12.rpy:32
translate turkish mari12_788acf0d:

    # fr "I'd really appreciate it."
    fr "Çok minnettar olurum."

# game/Scenes/Mari/mari12.rpy:33
translate turkish mari12_a248948f:

    # pc "Of course."
    pc "Tabii ki."

# game/Scenes/Mari/mari12.rpy:34
translate turkish mari12_f8e19e76:

    # pc "I'll get ready and pick you up in just a bit."
    pc "Hazırlanıp birazdan seni almaya geleceğim."

# game/Scenes/Mari/mari12.rpy:37
translate turkish mari12_d41d8cd9_5:

    # voice 'voices/mari12audio6.mp3'
    voice 'voices/mari12audio6.mp3'

# game/Scenes/Mari/mari12.rpy:38
translate turkish mari12_394b1929:

    # fr "Okay, thanks, [pcname]. I'll see you when you get here."
    fr "Tamam, teşekkürler, [pcname]. Geldiğinde görüşürüz."

# game/Scenes/Mari/mari12.rpy:41
translate turkish mari12_e6ab44c5:

    # "I get out of bed, get ready, and go pick her up at her house. Then we drive out to the cemetery."
    "Yataktan kalkıp hazırlanıyorum ve onu evinden almaya gidiyorum. Sonra mezarlığa doğru yola çıkıyoruz."

# game/Scenes/Mari/mari12.rpy:47
translate turkish mari12b_44391b00:

    # "She doesn't talk much on the way there, or as we somberly walk between the gravestones."
    "Oraya giderken ya da mezar taşlarının arasında hüzünle yürürken pek konuşmuyor."

# game/Scenes/Mari/mari12.rpy:49
translate turkish mari12b_d41d8cd9:

    # voice 'voices/mari12audio7.mp3'
    voice 'voices/mari12audio7.mp3'

# game/Scenes/Mari/mari12.rpy:50
translate turkish mari12b_8dfc6edc:

    # fr "I'm sorry. I don't mean to be sad like this. I usually don't let people see me this way."
    fr "Özür dilerim. Böyle üzgün olmak istemem. Genelde insanlara kendimi bu halde göstermem."

# game/Scenes/Mari/mari12.rpy:51
translate turkish mari12b_8e96bf49:

    # pc "It's okay Mari. Whatever you need, I'm here for you."
    pc "Sorun değil Mari. Neye ihtiyacın olursa, ben senin yanındayım."

# game/Scenes/Mari/mari12.rpy:53
translate turkish mari12b_d41d8cd9_1:

    # voice 'voices/mari12audio8.mp3'
    voice 'voices/mari12audio8.mp3'

# game/Scenes/Mari/mari12.rpy:54
translate turkish mari12b_e44358fe:

    # fr "I know. I love you for that. Thank you, [pcname]."
    fr "Biliyorum. Seni bunun için seviyorum. Teşekkürler, [pcname]."

# game/Scenes/Mari/mari12.rpy:58
translate turkish mari12b_d41d8cd9_2:

    # voice 'voices/mari12audio9.mp3'
    voice 'voices/mari12audio9.mp3'

# game/Scenes/Mari/mari12.rpy:59
translate turkish mari12b_6f733e61:

    # fr "This is them."
    fr "İşte onlar."

# game/Scenes/Mari/mari12.rpy:61
