    # voice 'voices/mari12audio26.mp3'
    voice 'voices/mari12audio26.mp3'

# game/Scenes/Mari/mari12.rpy:136
translate turkish mari12b_6b971349:

    # fr "I love you."
    fr "Sizi seviyorum."

# game/Scenes/Mari/mari12.rpy:139
translate turkish mari12b_4c9a85d5:

    # "When we get back to the car, the tears start flowing again."
    "Arabaya geri döndüğümüzde gözyaşları yeniden akmaya başlıyor."

# game/Scenes/Mari/mari12.rpy:141
translate turkish mari12b_d41d8cd9_21:

    # voice 'voices/mari12audio27.mp3'
    voice 'voices/mari12audio27.mp3'

# game/Scenes/Mari/mari12.rpy:142
translate turkish mari12b_8ff0003b:

    # fr "I'm sorry. I don't mean to cry so much. I'm trying to be strong."
    fr "Özür dilerim. Bu kadar çok ağlamak istemiyorum. Güçlü olmaya çalışıyorum."

# game/Scenes/Mari/mari12.rpy:143
translate turkish mari12b_6354f869:

    # pc "You don't have to be strong around me. It's okay."
    pc "Benim yanımda güçlü olmana gerek yok. Sorun değil."

# game/Scenes/Mari/mari12.rpy:147
translate turkish mari12b_d41d8cd9_22:

    # voice 'voices/mari12audio28.mp3'
    voice 'voices/mari12audio28.mp3'

# game/Scenes/Mari/mari12.rpy:148
translate turkish mari12b_a3eca98b:

    # fr "Good, because I'm not strong."
    fr "İyi ki, çünkü ben güçlü değilim."

# game/Scenes/Mari/mari12.rpy:150
translate turkish mari12b_d41d8cd9_23:

    # voice 'voices/mari_dontwanttobealone.mp3'
    voice 'voices/mari_dontwanttobealone.mp3'

# game/Scenes/Mari/mari12.rpy:151
translate turkish mari12b_c6c507b7:

    # fr "I don't want to be alone."
    fr "Yalnız kalmak istemiyorum."

# game/Scenes/Mari/mari12.rpy:152
translate turkish mari12b_9907419c:

    # pc "You won't be. I'm here."
    pc "Kalmayacaksın. Ben buradayım."

# game/Scenes/Mari/mari12.rpy:154
translate turkish mari12b_d41d8cd9_24:

    # voice 'voices/mari12audio29.mp3'
    voice 'voices/mari12audio29.mp3'

# game/Scenes/Mari/mari12.rpy:155
translate turkish mari12b_83448b64:

    # fr "Thank you, [pcname]. I know they're not really in this place, but every time I leave here I feel like I'm losing them all over again."
    fr "Teşekkür ederim, [pcname]. Aslında onların burada olmadıklarını biliyorum, ama buradan her ayrıldığımda sanki onları yeniden kaybediyormuşum gibi hissediyorum."

# game/Scenes/Mari/mari12.rpy:158
translate turkish mari12b_cdcdfbc7:

    # "I hold her while she cries, until she takes a deep breath and asks me to take her home."
    "O ağlarken onu kucaklarım, derin bir nefes alıp beni eve götürmemi isteyene kadar."

# game/Scenes/Mari/mari12.rpy:159
translate turkish mari12b_ac7f9f2b:

    # "We don't talk on the way back to her house."
    "Evine dönerken yol boyunca konuşmuyoruz."

# game/Scenes/Mari/mari12.rpy:162
translate turkish mari12b_824bd4f8:

    # "As soon as we walk inside, Appa and Momo greet us, excitedly hopping and panting."
    "İçeri girer girmez Appa ve Momo, heyecanla zıplayıp nefes nefese kalarak bizi karşılıyorlar."

# game/Scenes/Mari/mari12.rpy:164
translate turkish mari12b_d41d8cd9_25:

    # voice 'voices/mari12audio30.mp3'
    voice 'voices/mari12audio30.mp3'

# game/Scenes/Mari/mari12.rpy:165
translate turkish mari12b_5d63339f:

    # fr "You're such good boys, aren't you?"
    fr "Ne kadar uslu çocuklarsınız, değil mi?"

# game/Scenes/Mari/mari12.rpy:167
translate turkish mari12b_d41d8cd9_26:

    # voice 'voices/mari12audio31.mp3'
    voice 'voices/mari12audio31.mp3'

# game/Scenes/Mari/mari12.rpy:168
translate turkish mari12b_746c40a9:

    # fr "Any time I'm feeling sad, these two know how to cheer me up."
    fr "Ne zaman üzgün hissetsem, bu ikisi beni nasıl neşelendireceklerini çok iyi biliyorlar."

# game/Scenes/Mari/mari12.rpy:172
translate turkish mari12b_d41d8cd9_27:

    # voice 'voices/mari12audio32.mp3'
    voice 'voices/mari12audio32.mp3'

# game/Scenes/Mari/mari12.rpy:173
translate turkish mari12b_24a562d0:

    # fr "And you of course. You always seem to know how to make me feel better."
    fr "Ve tabii ki sen. Sen de her zaman beni nasıl daha iyi hissettireceğini biliyor gibisin."

# game/Scenes/Mari/mari12.rpy:175
translate turkish mari12b_d41d8cd9_28:

    # voice 'voices/mari12audio33.mp3'
    voice 'voices/mari12audio33.mp3'

# game/Scenes/Mari/mari12.rpy:176
translate turkish mari12b_3c61016a:

    # fr "Do you have anything to do today? Would you mind spending the day with me? I'm off work."
    fr "Bugün yapacak bir işin var mı? Günü benimle geçirmeye ne dersin? Bugün işten izinliyim."

# game/Scenes/Mari/mari12.rpy:178
translate turkish mari12b_d41d8cd9_29:

    # voice 'voices/mari12audio34.mp3'
    voice 'voices/mari12audio34.mp3'

# game/Scenes/Mari/mari12.rpy:179
translate turkish mari12b_c3564cc7:

    # fr "I have some chores to take care of, but I'd love the company."
    fr "Halletmem gereken bazı işlerim var ama sana eşlik etmeyi çok isterim."

# game/Scenes/Mari/mari12.rpy:181
translate turkish mari12b_d41d8cd9_30:

    # voice 'voices/mari12audio35.mp3'
    voice 'voices/mari12audio35.mp3'

# game/Scenes/Mari/mari12.rpy:182
translate turkish mari12b_36301338:

    # fr "I'll even cook you dinner."
    fr "Hatta sana akşam yemeği bile pişiririm."

# game/Scenes/Mari/mari12.rpy:183
translate turkish mari12b_cfff4e2c:

    # pc "Ha, you don't have to try to convince me. I'd love to spend the day with you."
    pc "Ha, beni ikna etmeye çalışmana gerek yok. Seninle bir gün geçirmeyi çok isterim."

# game/Scenes/Mari/mari12.rpy:186
translate turkish mari12b_1b4c460c:

    # "I spend the rest of the day hanging out with Mari."
    "Günün geri kalanını Mari ile takılarak geçiriyorum."

# game/Scenes/Mari/mari12.rpy:187
translate turkish mari12b_e2f512e0:

    # "I help her out with the chores on her farm, picking vegetables and chatting."
    "Çiftliğindeki işlerinde ona yardım ediyorum, sebze topluyoruz ve sohbet ediyoruz."

# game/Scenes/Mari/mari12.rpy:190
translate turkish mari12b_ddd97615:

    # "We feed the animals and brush her horse, Cash."
    "Hayvanları besliyoruz ve atı Cash’i fırçalıyoruz."

# game/Scenes/Mari/mari12.rpy:193
translate turkish mari12b_4db51a74:

    # "Then we just sit in the fresh air and drink iced tea in the early summer breeze."
    "Sonra da temiz havada oturup, yaz başı esintisinde buzlu çay içiyoruz."

# game/Scenes/Mari/mari12.rpy:195
translate turkish mari12b_d41d8cd9_31:

    # voice 'voices/mari12audio36.mp3'
    voice 'voices/mari12audio36.mp3'

# game/Scenes/Mari/mari12.rpy:196
translate turkish mari12b_1858b787:

    # fr "This has been great. Spending time with you. Doing things like a couple."
    fr "Bu harika oldu. Seninle vakit geçirmek. Bir çift gibi şeyler yapmak."

# game/Scenes/Mari/mari12.rpy:197
translate turkish mari12b_ffc4a85b:

    # pc "Yeah, it's been fun."
    pc "Evet, çok eğlenceliydi."

# game/Scenes/Mari/mari12.rpy:199
translate turkish mari12b_d41d8cd9_32:

    # voice 'voices/mari12audio37.mp3'
    voice 'voices/mari12audio37.mp3'

# game/Scenes/Mari/mari12.rpy:200
translate turkish mari12b_d7d09581:

    # fr "I'd love to do it more often."
    fr "Bunu daha sık yapmak isterim."

# game/Scenes/Mari/mari12.rpy:203
translate turkish mari12b_f2e427de:

    # "Then Mari cooks up dinner. It's a mix of different vegetables sauteed together."
    "Sonra Mari akşam yemeğini hazırlıyor. Farklı sebzelerin birlikte sotelendiği bir karışım."

# game/Scenes/Mari/mari12.rpy:204
translate turkish mari12b_169a82ad:

    # "No meat, because she's vegetarian and doesn't have any at the house, but the vegetables are all fresh, and the bread is homemade as well."
    "Et yok, çünkü o vejetaryen ve evde hiç et yok, ama sebzelerin hepsi taze ve ekmek de ev yapımı."

# game/Scenes/Mari/mari12.rpy:205
translate turkish mari12b_d574565c:

    # "It's very tasty."
    "Çok lezzetli."

# game/Scenes/Mari/mari12.rpy:208
translate turkish mari12b_756b3b11:

    # "After that, we sit in her living room and watch a movie. The Disney animated Robin Hood - her favorite."
    "Ondan sonra oturma odasında oturup bir film izliyoruz. Disney'in Robin Hood animasyonu – en sevdiği film."

# game/Scenes/Mari/mari12.rpy:209
translate turkish mari12b_50d1a5c2:

    # "She hums along with all the songs."
    "Tüm şarkılara eşlik ederek mırıldanıyor."

# game/Scenes/Mari/mari12.rpy:210
translate turkish mari12b_bb444f7c:

    # pc "These are definitely going to be in my head for the next week."
    pc "Bu şarkılar önümüzdeki hafta boyunca kesinlikle kafamda dönüp duracak."

# game/Scenes/Mari/mari12.rpy:212
translate turkish mari12b_d41d8cd9_33:

    # voice 'voices/mari12audio37-2.mp3'
    voice 'voices/mari12audio37-2.mp3'

# game/Scenes/Mari/mari12.rpy:213
translate turkish mari12b_8da90cc3:

    # fr "Join the club!"
    fr "Hoş geldin kulübe!"

# game/Scenes/Mari/mari12.rpy:216
translate turkish mari12b_af7d8e81:

    # "We take a shower together."
    "Birlikte duş alıyoruz."

# game/Scenes/Mari/mari12.rpy:217
translate turkish mari12b_fdf6b91c:

    # "I scrub her back, taking extra time to massage her shoulders."
    "Sırtını ovarken omuzlarına masaj yapmak için biraz daha zaman ayırıyorum."

# game/Scenes/Mari/mari12.rpy:220
translate turkish mari12b_5e90d934:

    # "Then we go to bed."
    "Sonra yatıyoruz."

# game/Scenes/Mari/mari12.rpy:222
translate turkish mari12b_d41d8cd9_34:

    # voice 'voices/mari12audio38.mp3'
    voice 'voices/mari12audio38.mp3'

# game/Scenes/Mari/mari12.rpy:223
translate turkish mari12b_637f5924:

    # fr "We spent the entire day together, huh?"
    fr "Bütün günü birlikte geçirdik, değil mi?"

# game/Scenes/Mari/mari12.rpy:225
translate turkish mari12b_d41d8cd9_35:

    # voice 'voices/mari12audio39.mp3'
    voice 'voices/mari12audio39.mp3'

# game/Scenes/Mari/mari12.rpy:226
translate turkish mari12b_47dbf3dc:

    # fr "I know I was sad through some of it, but even though this is the anniversary of the worst day in my life..."
    fr "Bazı anlarda üzgün olduğumu biliyorum, ama bu hayatımın en kötü gününün yıldönümü olsa da..."

# game/Scenes/Mari/mari12.rpy:228
translate turkish mari12b_d41d8cd9_36:

    # voice 'voices/mari12audio40.mp3'
    voice 'voices/mari12audio40.mp3'

# game/Scenes/Mari/mari12.rpy:229
translate turkish mari12b_eeeeced3:

    # fr "Somehow you turned today into the best day."
    fr "Bir şekilde bugünü en güzel güne çevirdin."

# game/Scenes/Mari/mari12.rpy:231
translate turkish mari12b_d41d8cd9_37:

    # voice 'voices/mari_lovesomuch2.mp3'
    voice 'voices/mari_lovesomuch2.mp3'

# game/Scenes/Mari/mari12.rpy:232
translate turkish mari12b_546fd524:

    # fr "I love you so much."
    fr "Seni çok seviyorum."

# game/Scenes/Mari/mari12.rpy:233
translate turkish mari12b_51fe7806:

    # pc "I love you too, Mari."
    pc "Ben de seni seviyorum, Mari."

