translate turkish mari12b_39ac0a93:

    # fr "Do you mind waiting over there for just a moment. I want to talk to them alone for a bit."
    fr "Bir dakika orada bekler misin? Onlarla biraz baş başa konuşmak istiyorum."

# game/Scenes/Mari/mari12.rpy:95
translate turkish mari12b_65d4bc1f:

    # pc "No problem. I understand. Just let me know when you're ready."
    pc "Sorun değil. Anlıyorum. Hazır olduğunda bana haber ver."

# game/Scenes/Mari/mari12.rpy:96
translate turkish mari12b_351906a2:

    # fr "Thanks, [pcname]."
    fr "Teşekkürler, [pcname]."

