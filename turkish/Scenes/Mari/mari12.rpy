    # fr "Hey, [pcname]! You can come back now!"
    fr "Hey, [pcname]! Artık geri gelebilirsin!"

# game/Scenes/Mari/mari12.rpy:126
translate turkish mari12b_a64ec45a:

    # "I return and see her eyes are red and rimmed with tears."
    "Geri dönüp gözlerinin kızardığını ve gözyaşlarıyla dolduğunu görüyorum."

# game/Scenes/Mari/mari12.rpy:127
translate turkish mari12b_24c2e031:

    # "I put an arm around her and give her a gentle squeeze, trying to provide some comfort."
    "Onu teselli etmek için kolumu omzuna atıp hafifçe sarılıyorum."

# game/Scenes/Mari/mari12.rpy:129
translate turkish mari12b_d41d8cd9_18:

    # voice 'voices/mari12audio24.mp3'
    voice 'voices/mari12audio24.mp3'

# game/Scenes/Mari/mari12.rpy:130
