    fr "Günaydın, [pcname]. Üzgünüm, saatin erken olduğunu biliyorum."

# game/Scenes/Mari/mari12.rpy:18
translate turkish mari12_91f902a2:

    # pc "Hey. Everything okay?"
    pc "Selam. Her şey yolunda mı?"

