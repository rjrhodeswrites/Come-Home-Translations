    # voice 'voices/mari12audio10.mp3'
    voice 'voices/mari12audio10.mp3'

# game/Scenes/Mari/mari12.rpy:62
translate turkish mari12b_04b67e29:

    # fr "Hi, Mom. Hi, Daddy. This is [pcname]."
    fr "Merhaba anne. Merhaba baba. Ben [pcname]."

# game/Scenes/Mari/mari12.rpy:64
translate turkish mari12b_d41d8cd9_4:

    # voice 'voices/mari12audio11.mp3'
    voice 'voices/mari12audio11.mp3'

# game/Scenes/Mari/mari12.rpy:65
translate turkish mari12b_7a0cc25f:

    # fr "Sorry, I know this is a little strange, but I like to talk to them like they're here."
    fr "Üzgünüm, bunun biraz tuhaf olduğunu biliyorum ama sanki buradaymışlar gibi onlarla konuşmayı seviyorum."

# game/Scenes/Mari/mari12.rpy:66
translate turkish mari12b_d77ba8f9:

    # pc "It's not strange."
    pc "Tuhaf değil."

# game/Scenes/Mari/mari12.rpy:68
