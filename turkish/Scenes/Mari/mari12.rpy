    voice 'voices/mari12audio2.mp3'

# game/Scenes/Mari/mari12.rpy:21
translate turkish mari12_d11f5c6f:

    # fr "Yeah, I was just wondering if you'd do me a big favor?"
    fr "Evet, sadece bana büyük bir iyilik yapabilir misin diye merak ediyordum?"

# game/Scenes/Mari/mari12.rpy:22
translate turkish mari12_f25b8564:

    # pc "Anything you need."
    pc "Ne istersen."

# game/Scenes/Mari/mari12.rpy:25
