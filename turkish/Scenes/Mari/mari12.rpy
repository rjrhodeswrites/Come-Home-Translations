    # fr "I think I'm done."
    fr "Sanırım işim bitti."

# game/Scenes/Mari/mari12.rpy:132
translate turkish mari12b_d41d8cd9_19:

    # voice 'voices/mari12audio25.mp3'
    voice 'voices/mari12audio25.mp3'

# game/Scenes/Mari/mari12.rpy:133
