    # voice 'voices/mari12audio41.mp3'
    voice 'voices/mari12audio41.mp3'

# game/Scenes/Mari/mari12.rpy:236
translate turkish mari12b_af93bf64:

    # fr "Just one more thing to make today perfect."
    fr "Bugünü mükemmel kılmak için son bir şey daha var."

# game/Scenes/Mari/mari12.rpy:238
translate turkish mari12b_d41d8cd9_39:

    # voice 'voices/mari12audio42.mp3'
    voice 'voices/mari12audio42.mp3'

# game/Scenes/Mari/mari12.rpy:239
translate turkish mari12b_92a46e68:

    # fr "Please, make love to me, [pcname]."
    fr "Lütfen, benimle seviş, [pcname]."

# game/Scenes/Mari/mari12.rpy:241
translate turkish mari12b_47510abd:

    # "We kiss as I sink into her."
    "Onun içine girerken öpüşüyoruz."

# game/Scenes/Mari/mari12.rpy:242
translate turkish mari12b_1becc9d2:

    # "Then we move together, every part of us connected."
    "Sonra birlikte hareket ediyoruz, her parçamız birbirine bağlı."

# game/Scenes/Mari/mari12.rpy:243
translate turkish mari12b_f4010c57:

    # "It's the closest I've ever felt to her."
    "Ona hiç bu kadar yakın hissetmemiştim."

# game/Scenes/Mari/mari12.rpy:247
translate turkish mari12b_e219a86e:

    # "And when we cum together, I feel everything that she feels."
    "Ve birlikte boşaldığımızda, onun hissettiği her şeyi hissediyorum."

# game/Scenes/Mari/mari12.rpy:248
translate turkish mari12b_e721ecdf:

    # "We hold each other close as I empty myself into her."
    "İçine boşalırken birbirimize sıkıca sarılıyoruz."

# game/Scenes/Mari/mari12.rpy:251
translate turkish mari12b_743db198:

    # "Afterwards, we continue holding each other."
    "Sonrasında da birbirimize sarılmaya devam ediyoruz."

# game/Scenes/Mari/mari12.rpy:252
translate turkish mari12b_2a4dc283:

    # "No words are needed. We both know what the other is thinking."
    "Sözlere gerek yok. İkimiz de birbirimizin ne düşündüğünü biliyoruz."

# game/Scenes/Mari/mari12.rpy:253
translate turkish mari12b_b73d7100:

    # "Our minds and hearts and bodies are all one."
    "Zihinlerimiz, kalplerimiz ve bedenlerimiz tek bir bütün."

# game/Scenes/Mari/mari12.rpy:256
translate turkish mari12b_3e0dbf15:

    # "And in the comfort of each other, we fall asleep."
    "Ve birbirimizin kollarında huzur içinde uykuya dalıyoruz."

# game/Scenes/Mari/mari12.rpy:259
translate turkish mari12b_a10928f0:

    # "The next day, she has to go to work, so we say goodbye early."
    "Ertesi gün, onun işe gitmesi gerektiği için erkenden vedalaşıyoruz."

# game/Scenes/Mari/mari12.rpy:260
translate turkish mari12b_ceb21b0a:

    # "But our lips linger on each other."
    "Ama dudaklarımız birbirinden ayrılmak bilmiyor."

# game/Scenes/Mari/mari12.rpy:262
translate turkish mari12b_d41d8cd9_40:

    # voice 'voices/mari12audio43.mp3'
    voice 'voices/mari12audio43.mp3'

# game/Scenes/Mari/mari12.rpy:263
translate turkish mari12b_02e21aa9:

    # fr "You know you're welcome here any time. Any night."
    fr "Biliyorsun, buraya her zaman gelebilirsin. Her gece."

# game/Scenes/Mari/mari12.rpy:265
translate turkish mari12b_d41d8cd9_41:

    # voice 'voices/mari12audio44.mp3'
    voice 'voices/mari12audio44.mp3'

# game/Scenes/Mari/mari12.rpy:266
translate turkish mari12b_7ccfda96:

    # fr "I'd spend every day with you, like yesterday, if I could."
    fr "Mümkün olsaydı, tıpkı dün olduğu gibi her günümü seninle geçirirdim."

# game/Scenes/Mari/mari12.rpy:267
translate turkish mari12b_5addd2db:

    # pc "It was pretty great. Don't worry. We'll do it again soon."
    pc "Oldukça harikaydı. Merak etme. Yakında tekrar yaparız."

# game/Scenes/Mari/mari12.rpy:269
translate turkish mari12b_d41d8cd9_42:

    # voice 'voices/mari_okay1.mp3'
    voice 'voices/mari_okay1.mp3'

