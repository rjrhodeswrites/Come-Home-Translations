translate turkish mari12b_fc7bc5a6:

    # fr "...miss you all the time..."
    fr "...seni her zaman özlüyorum..."

# game/Scenes/Mari/mari12.rpy:115
translate turkish mari12b_636a8add:

    # "I walk further away, until I can't hear any of her words. It feels wrong to listen to these things."
    "Söylediklerini hiç duyamayana kadar daha uzağa yürüyorum. Bu sözleri dinlemek bana yanlış geliyor."

# game/Scenes/Mari/mari12.rpy:116
translate turkish mari12b_761b1907:

    # "I lean against a tree and breathe in the cool air."
    "Bir ağaca yaslanıp serin havayı içime çekiyorum."

# game/Scenes/Mari/mari12.rpy:117
translate turkish mari12b_a02780e8:

    # "It's a nice day for this at least."
    "En azından bunun için güzel bir gün."

# game/Scenes/Mari/mari12.rpy:120
translate turkish mari12b_f581e523:

    # "After a while, she calls out for me again."
    "Bir süre sonra, bana tekrar sesleniyor."

# game/Scenes/Mari/mari12.rpy:122
translate turkish mari12b_d41d8cd9_17:

    # voice 'voices/mari12audio23.mp3'
