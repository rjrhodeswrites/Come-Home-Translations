    # fr "Okay."
    fr "Tamam."

# game/Scenes/Mari/mari12.rpy:272
translate turkish mari12b_d41d8cd9_43:

    # voice 'voices/mari_loveyou1.mp3'
    voice 'voices/mari_loveyou1.mp3'

# game/Scenes/Mari/mari12.rpy:273
translate turkish mari12b_f3511250:

    # fr "Bye, [pcname]. I love you."
    fr "Hoşça kal, [pcname]. Seni seviyorum."

# game/Scenes/Mari/mari12.rpy:274
translate turkish mari12b_93754ce5:

    # pc "Love you too, Mari."
    pc "Ben de seni seviyorum, Mari."

# game/Scenes/Mari/mari12.rpy:279
translate turkish mari12b_a71ca6f3:

    # "I leave her farm and drive back towards home."
    "Çiftliğinden ayrılıp eve doğru yola çıkıyorum."

# game/Scenes/Mari/mari12.rpy:280
translate turkish mari12b_a94d9d83:

    # "I'm not quite ready to settle down yet, but when I am, I could definitely see it being with her."
    "Henüz yerleşmeye hazır değilim, ama hazır olduğumda, kesinlikle onunla olacağımı görebiliyorum."

# game/Scenes/Mari/mari12.rpy:281
translate turkish mari12b_f9b60f9c:

    # "Being with her is just so easy. It feels natural."
    "Onunla olmak çok kolay. Doğal geliyor."

# game/Scenes/Mari/mari12.rpy:282
translate turkish mari12b_811aa5f5:

    # "She's amazing."
    "O harika biri."

