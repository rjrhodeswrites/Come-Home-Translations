# game/Scenes/Mari/mari3.rpy:12
translate turkish mari3_d41d8cd9:

    # voice 'voices/mari_heythere.mp3'
    voice 'voices/mari_heythere.mp3'

# game/Scenes/Mari/mari3.rpy:13
translate turkish mari3_5fec8fcf:

    # fr "Hey there, [pcname]. How are you today?"
    fr "Merhaba, [pcname]. Bugün nasılsın?"

# game/Scenes/Mari/mari3.rpy:14
translate turkish mari3_b835b9eb:

    # pc "I'm doing great, how's my favorite waitress?"
    pc "Harikayım, en sevdiğim garson kız nasıl?"

# game/Scenes/Mari/mari3.rpy:15
translate turkish mari3_334e62bd:

    # fr "Much better now that her favorite customer is here."
    fr "En sevdiği müşteri burada olduğu için şimdi çok daha iyi."

# game/Scenes/Mari/mari3.rpy:20
translate turkish mari3_747e36cd:

    # pc "Mari, there was something I wanted to ask you."
    pc "Mari, sana sormak istediğim bir şey vardı."

# game/Scenes/Mari/mari3.rpy:21
translate turkish mari3_96d48818:

    # fr "Ask away."
    fr "Sor bakalım."

# game/Scenes/Mari/mari3.rpy:22
translate turkish mari3_05be9386:

    # pc "Would you want to go out on a date with me sometime?"
    pc "Bir ara benimle çıkmak ister misin?"

# game/Scenes/Mari/mari3.rpy:25
translate turkish mari3_d41d8cd9_1:

    # voice 'voices/mari_idloveto.mp3'
    voice 'voices/mari_idloveto.mp3'

# game/Scenes/Mari/mari3.rpy:26
translate turkish mari3_ad1c3ebd:

    # fr "Really? I'd love to."
    fr "Gerçekten mi? Çok isterim."

# game/Scenes/Mari/mari3.rpy:27
translate turkish mari3_1da24e01:

    # pc "Awesome."
    pc "Harika."

# game/Scenes/Mari/mari3.rpy:29
translate turkish mari3_008e9d39:

    # fr "I don't get to go out on dates very often, and I do really like you."
    fr "Çok sık randevuya çıkamıyorum ve senden gerçekten hoşlanıyorum."

# game/Scenes/Mari/mari3.rpy:30
translate turkish mari3_098a6e78:

    # fr "I'm busy a lot, but I'll give you my phone number and maybe we could go out in the evening on a weekend sometime?"
    fr "Çok meşgulüm ama sana telefon numaramı vereyim, belki bir hafta sonu akşamı çıkabiliriz?"

# game/Scenes/Mari/mari3.rpy:31
translate turkish mari3_d2954fc0:

    # pc "That sounds great."
    pc "Kulağa harika geliyor."

# game/Scenes/Mari/mari3.rpy:32
translate turkish mari3_52d8f6ae:

    # fr "Oh I'm so excited."
    fr "Oh, çok heyecanlıyım."

# game/Scenes/Mari/mari3.rpy:34
translate turkish mari3_e7685f1d:

    # fr "Here's my phone number."
    fr "İşte telefon numaram."

# game/Scenes/Mari/mari3.rpy:36
translate turkish mari3_639d3c6f:

    # fr "You can call me any time, but I won't be able to talk while I'm working, and I work a lot!"
    fr "Beni istediğin zaman arayabilirsin ama çalışırken konuşamayacağım ve çok çalışıyorum!"

# game/Scenes/Mari/mari3.rpy:37
translate turkish mari3_73bf0030:

    # pc "I'll definitely give you a call sometime."
    pc "Kesinlikle bir ara seni arayacağım."

# game/Scenes/Mari/mari3.rpy:38
translate turkish mari3_c2bff929:

    # fr "Good, I can't wait!"
    fr "Güzel, sabırsızlanıyorum!"

# game/Scenes/Mari/mari3.rpy:39
translate turkish mari3_910292d4:

    # fr "I better go get your food."
    fr "Gidip yemeğini getirsem iyi olacak."

# game/Scenes/Mari/mari3.rpy:40
translate turkish mari3_63023601:

    # pc "Okay."
    pc "Tamam."

# game/Scenes/Mari/mari3.rpy:42
translate turkish mari3_0aa5dfbc:

    # "She starts to walk away, then looks back at me."
    "Uzaklaşmaya başlıyor, sonra bana dönüp bakıyor."

# game/Scenes/Mari/mari3.rpy:43
translate turkish mari3_8f6f1358:

    # fr "Thanks for asking me out. I'm really looking forward to our date."
    fr "Beni randevuya davet ettiğin için teşekkürler. Randevumuzu gerçekten dört gözle bekliyorum."

# game/Scenes/Mari/mari3.rpy:44
translate turkish mari3_03eaad50:

    # pc "Me too."
    pc "Ben de."

# game/Scenes/Mari/mari3.rpy:45
translate turkish mari3_7553af6a:

    # "With that, she smiles and leaves to get my food."
    "Bunun üzerine gülümsüyor ve yemeğimi getirmek için ayrılıyor."

# game/Scenes/Mari/mari3.rpy:47
translate turkish mari3_43045d37:

    # "We don't talk much more while I eat and she has to help other customers, but every time she looks at me, she's smiling."
    "Ben yemek yerken ve o diğer müşterilere yardım etmek zorunda olduğu için fazla konuşmuyoruz, ama bana her baktığında gülümsüyor."

# game/Scenes/Mari/mari3.rpy:48
translate turkish mari3_2d44a908:

    # "The smile is different than usual. More sincere almost."
    "Bu gülümseme her zamankinden farklı. Neredeyse daha samimi."

# game/Scenes/Mari/mari3.rpy:51
translate turkish maritip3_474b8780:

    # "I leave 10 dollars on the table."
    "Masaya 10 dolar bırakıyorum."

# game/Scenes/Mari/mari3.rpy:53
translate turkish maritip3_bbc6048f:

    # "No need to leave money, I'll give her something better later."
    "Para bırakmana gerek yok, ona daha sonra daha iyi bir şey vereceğim."

# game/Scenes/Mari/mari3.rpy:55
translate turkish maritip3_c56febff:

    # "Then I start to walk out towards my car."
    "Sonra arabama doğru yürümeye başlıyorum."

# game/Scenes/Mari/mari3.rpy:58
translate turkish maritip3_e3c07fca:

    # "Mari stops me though, wrapping her arms around me and pulling me into a hug."
    "Ama Mari beni durduruyor, kollarını bana doluyor ve beni kucaklıyor."

# game/Scenes/Mari/mari3.rpy:59
translate turkish maritip3_7db5e01d:

    # fr "I can't wait to see you again."
    fr "Seni tekrar görmek için sabırsızlanıyorum."

# game/Scenes/Mari/mari3.rpy:60
translate turkish maritip3_98e7787f:

    # fr "Be sure you call me."
    fr "Mutlaka beni ara."

# game/Scenes/Mari/mari3.rpy:61
translate turkish maritip3_5bc44b07:

    # pc "I will."
    pc "Arayacağım."

# game/Scenes/Mari/mari3.rpy:62
translate turkish maritip3_2e512b95:

    # fr "Okay, take care."
    fr "Tamam, kendine iyi bak."

# game/Scenes/Mari/mari3.rpy:65
translate turkish maritip3_5794a059:

    # "She releases me and I go outside. She's really excited about our date it seems."
    "Beni bıraktı ve ben dışarı çıktım. Görünüşe göre randevumuz için gerçekten heyecanlı."

# game/Scenes/Mari/mari3.rpy:66
translate turkish maritip3_f0d4672c:

    # "I'm excited too. It should be fun."
    "Ben de heyecanlıyım. Eğlenceli olmalı."

translate turkish strings:

    # game/Scenes/Mari/mari3.rpy:2
    old "After you helped Mari by giving her a ride home,"
    new "Mari’yi eve bırakarak ona yardım ettikten sonra,"

    # game/Scenes/Mari/mari3.rpy:3
    old "go get a burger at Jackson Burger while she's working and ask her out."
    new "o çalışırken Jackson Burger’e gidip bir hamburger al ve ona çıkma teklif et."

    # game/Scenes/Mari/mari3.rpy:52
    old "I'll give her the tip later"
    new "Bahşişi daha sonra veririm"

    # game/Scenes/Mari/mari3.rpy:71
    old "Just eat"
    new "Sen sadece ye"

