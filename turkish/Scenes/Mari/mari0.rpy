# game/Scenes/Mari/mari0.rpy:13
translate turkish mari0_268d9953:

    # "After about five minutes, a young woman with beautiful curly hair and an even prettier smile walks up with my order."
    "Yaklaşık beş dakika sonra, güzel kıvırcık saçları ve daha da güzel bir gülümsemesi olan genç bir kadın siparişimi getiriyor."

# game/Scenes/Mari/mari0.rpy:14
translate turkish mari0_61ae3800:

    # fr "Hey there. This must be yours."
    fr "Merhaba. Bu senin olmalı."

# game/Scenes/Mari/mari0.rpy:16
translate turkish mari0_d41d8cd9:

    # voice 'voices/mari_immariwaitress.mp3'
    voice 'voices/mari_immariwaitress.mp3'

# game/Scenes/Mari/mari0.rpy:17
translate turkish mari0_83cd92ec:

    # fr "I'm Mari. I'll be your waitress today."
    fr "Ben Mari. Bugün garsonunuz ben olacağım."

# game/Scenes/Mari/mari0.rpy:18
translate turkish mari0_0a82c299:

    # fr "You just let me know if you need anything else."
    fr "Başka bir şeye ihtiyacınız olursa bana haber verin."

# game/Scenes/Mari/mari0.rpy:19
translate turkish mari0_f711eed2:

    # "She gives me a smile and puts the food down on the table."
    "Bana gülümsüyor ve yemeği masaya koyuyor."

# game/Scenes/Mari/mari0.rpy:23
translate turkish mari0_84e54e6e:

    # "She blushes a bit and playfully slaps my shoulder."
    "Biraz kızarıyor ve şakacı bir şekilde omzuma hafifçe vuruyor."

# game/Scenes/Mari/mari0.rpy:24
translate turkish mari0_967f0281:

    # fr "You're just a charmer, aren't you?"
    fr "Tam bir çapkınsın, değil mi?"

# game/Scenes/Mari/mari0.rpy:27
translate turkish mari0_d41d8cd9_1:

    # voice marisurething
    voice marisurething

# game/Scenes/Mari/mari0.rpy:28
translate turkish mari0_9af4e82f:

    # fr "Sure thing!"
    fr "Tabii ki!"

# game/Scenes/Mari/mari0.rpy:31
translate turkish mari0_d41d8cd9_2:

    # voice marisurething
    voice marisurething

# game/Scenes/Mari/mari0.rpy:32
translate turkish mari0_22159de4:

    # fr "Sure thing! I'll bring it right out."
    fr "Tabii ki! Hemen getiririm."

# game/Scenes/Mari/mari0.rpy:33
translate turkish mari0_55ee1584:

    # "She runs to the back and gets the ketchup, then quickly returns with it."
    "Arkaya koşup ketçabı alıyor, sonra hemen geri dönüyor."

# game/Scenes/Mari/mari0.rpy:34
translate turkish mari0_fe5173b6:

    # fr "Just give me a holler if I can do anything else for you."
    fr "Başka bir şeye ihtiyacınız olursa bana seslenin yeter."

# game/Scenes/Mari/mari0.rpy:37
translate turkish mari0_d0ec727b:

    # "She walks over to a nearby table, pulls out a rag, and starts wiping it down, bending over just enough to give me a good view of her ass."
    "Yakındaki bir masaya doğru yürür, bir bez çıkarır ve masayı silmeye başlar; tam da kıçını iyi görebilmem için yeterince eğilir."

# game/Scenes/Mari/mari0.rpy:40
translate turkish mari0_8458142b:

    # "And damn, that's a nice ass."
    "Vay canına, ne güzel bir kıç."

# game/Scenes/Mari/mari0.rpy:43
translate turkish mari0_a58a4782:

    # "I eat my food and Mari returns a couple more times to give me a refill on my drink."
    "Yemeğimi yerken Mari, içkimi yenilemek için birkaç kez daha geri gelir."

# game/Scenes/Mari/mari0.rpy:46
translate turkish mari0_cc46d500:

    # "Then when I'm finished, I stand up and give her a smile and a wave."
    "Sonra yemeğimi bitirince ayağa kalkar, ona gülümser ve el sallarım."

# game/Scenes/Mari/mari0.rpy:49
translate turkish mari0_d41d8cd9_3:

    # voice 'voices/mari_thanksgoodnight.mp3'
    voice 'voices/mari_thanksgoodnight.mp3'

# game/Scenes/Mari/mari0.rpy:50
translate turkish mari0_8fafd7cf:

    # fr "Thanks for coming in. You have a good night."
    fr "Uğradığın için teşekkürler. İyi geceler."

# game/Scenes/Mari/mari0.rpy:53
translate turkish marifirsttip_1c31faa0:

    # "I place $5 on the table before I leave."
    "Çıkmadan önce masaya 5 dolar bırakıyorum."

# game/Scenes/Mari/mari0.rpy:55
translate turkish marifirsttip_01e672c5:

    # "I head back out to the car."
    "Arabaya geri dönüyorum."

