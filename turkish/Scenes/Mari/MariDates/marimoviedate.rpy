# game/Scenes/Mari/MariDates/marimoviedate.rpy:26
translate turkish marimovietheaterstartdate_0f1c479d:

    # "We get to the theater and get seats in the back."
    "Sinemaya varıyoruz ve arka sıralardan yer alıyoruz."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:27
translate turkish marimovietheaterstartdate_d03e5a70:

    # fr "So what are we watching anyway?"
    fr "Peki, ne izleyeceğiz?"

# game/Scenes/Mari/MariDates/marimoviedate.rpy:31
translate turkish marimovietheaterstartdate_346436bf:

    # fr "Oh yeah?"
    fr "Öyle mi?"

# game/Scenes/Mari/MariDates/marimoviedate.rpy:32
translate turkish marimovietheaterstartdate_3aed9093:

    # fr "I love romance movies. As long as they're not too corny."
    fr "Romantik filmleri severim. Tabii çok klişe olmadıkları sürece."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:35
translate turkish marimovietheaterstartdate_337ed84d:

    # fr "Hrm, okay well that sounds fun."
    fr "Hmm, tamam, kulağa eğlenceli geliyor."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:36
translate turkish marimovietheaterstartdate_7a1524b8:

    # fr "As long as it isn't just two buff guys slapping their meat together."
    fr "Tabii ki sadece iki kaslı erkeğin kaslarını birbirine vurduğu bir film olmadığı sürece."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:38
translate turkish marimovietheaterstartdate_d3cf7e4e:

    # fr "Actually, that sounds pretty fun too."
    fr "Aslında, o da oldukça eğlenceli geliyor."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:43
translate turkish marimovietheaterstartdate_d41d8cd9:

    # voice 'voices/mari_really.mp3'
    voice 'voices/mari_really.mp3'

# game/Scenes/Mari/MariDates/marimoviedate.rpy:44
translate turkish marimovietheaterstartdate_67fd9cd9:

    # fr "Really?"
    fr "Gerçekten mi?"

# game/Scenes/Mari/MariDates/marimoviedate.rpy:45
translate turkish marimovietheaterstartdate_8b77409f:

    # fr "I don't really do scary movies very well."
    fr "Korku filmlerini pek sevmem."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:46
translate turkish marimovietheaterstartdate_cb84ad92:

    # fr "I might just have my eyes closed and be holding you through the whole thing."
    fr "Belki de film boyunca gözlerimi kapatıp sana sarılıp kalırım."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:51
translate turkish marimovietheaterstartdate_321fa232:

    # fr "Oh good, I need a good laugh."
    fr "Oh, ne güzel, biraz gülmeye ihtiyacım var."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:52
translate turkish marimovietheaterstartdate_76b9da8b:

    # fr "As long as it's not one of those gross-out sex comedies. I'm not really into those."
    fr "Tabii o iğrenç seks komedilerinden biri olmadığı sürece. Onları pek sevmem."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:56
translate turkish marimovietheaterstartdate_f3087137:

    # fr "Oh good! You know what I like."
    fr "Oh, ne güzel! Neyi sevdiğimi biliyorsun."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:57
translate turkish marimovietheaterstartdate_3224e393:

    # fr "I love animated stuff. Especially when it's about talking animals."
    fr "Animasyonları çok severim. Özellikle de konuşan hayvanlarla ilgili olanları."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:60
translate turkish marimovietheaterstartdate_f45af0c0:

    # "There's a little time before the movie starts for us to chat."
    "Film başlamadan önce sohbet etmek için biraz vaktimiz var."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:64
translate turkish marimovietheaterstartdate_592835a4:

    # "Finally the movie starts up and we go silent."
    "Sonunda film başlıyor ve sessizleşiyoruz."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:66
translate turkish marimovietheaterstartdate_fd60e14c:

    # "She reaches over and holds my hand on top of the arm rest."
    "Bana doğru uzanıp kol dayama yerinin üstünden elimi tutuyor."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:67
translate turkish marimovietheaterstartdate_aee76b2d:

    # "The trailers take up about fifteen minutes, then the movie really gets started."
    "Fragmanlar yaklaşık on beş dakika sürüyor, sonra film gerçekten başlıyor."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:71
translate turkish marimovietheaterstartdate_17eefcb1:

    # "During the movie, she leans on my shoulder, really getting into the story."
    "Film sırasında omzuma yaslanıyor, hikâyeye kendini kaptırıyor."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:73
translate turkish marimovietheaterstartdate_1b60b301:

    # "Then during a particularly romantic scene, she raises her head and puts her lips to mine."
    "Sonra özellikle romantik bir sahnede başını kaldırıp dudaklarını dudaklarıma değdiriyor."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:74
translate turkish marimovietheaterstartdate_787192bc:

    # "We don't really watch a lot of the rest of the movie, instead focusing on making out."
    "Filmin geri kalanını pek izlemiyoruz, bunun yerine öpüşmeye odaklanıyoruz."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:77
translate turkish marimovietheaterstartdate_d17a4ae6:

    # "During the movie, she leans against my shoulder, really getting into the story."
    "Film sırasında, o omzuma yaslanıyor ve hikâyeye kendini kaptırıyor."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:80
translate turkish marimovietheaterstartdate_284094da:

    # "Mari watches the movie, but I'm not really sure how much she likes it."
    "Mari filmi izliyor, ama filmi ne kadar beğendiğinden pek emin değilim."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:83
translate turkish marimovietheaterstartdate_26b74708:

    # "Eventually, she turns towards me and whispers."
    "Sonunda bana dönüp fısıldıyor."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:84
translate turkish marimovietheaterstartdate_5aa661f3:

    # fr "I'm not really into this movie. Want to just make out?"
    fr "Bu film pek ilgimi çekmiyor. Sadece öpüşmek ister misin?"

# game/Scenes/Mari/MariDates/marimoviedate.rpy:86
translate turkish marimovietheaterstartdate_d0a52fcf:

    # "I lean in and kiss her and we don't really watch much else of the movie, instead focusing on each other."
    "Ona doğru eğilip onu öpüyorum ve filmin geri kalanını pek izlemiyoruz, bunun yerine birbirimize odaklanıyoruz."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:89
translate turkish marimovietheaterstartdate_ae5e6aa0:

    # "To give her some credit, she tries to watch a little bit of the movie."
    "Adil olmak gerekirse, filmin bir kısmını izlemeye çalışıyor."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:90
translate turkish marimovietheaterstartdate_c601de66:

    # "But by the time the scary parts start, she is pretty much done."
    "Ama korkunç sahneler başladığında, artık pek izlemeye niyeti kalmıyor."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:92
translate turkish marimovietheaterstartdate_fafc8629:

    # "She tucks her head down against me and hides the movie from her sight."
    "Başını bana yaslayıp filmi gözünden saklıyor."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:93
translate turkish marimovietheaterstartdate_324b6470:

    # "She stays right there, not watching anything for the rest of the movie."
    "Filmin geri kalanı boyunca orada kalıyor, hiçbir şey izlemiyor."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:96
translate turkish marimovietheaterstartdate_b27a7e4c:

    # "Mari's eyes are focused on the movie throughout the whole thing."
    "Mari ise film boyunca gözlerini filmden ayırmıyor."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:97
translate turkish marimovietheaterstartdate_125a0ff3:

    # "She laughs, she cries, she taps her foot along with the music."
    "Gülüyor, ağlıyor, müziğin ritmine ayaklarını sallıyor."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:98
translate turkish marimovietheaterstartdate_e4a43b4e:

    # "We have a great time."
    "Harika vakit geçiriyoruz."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:101
translate turkish marimovietheaterstartdate_8f27901e:

    # "The movie is pretty funny all the way through and Mari and I laugh a lot."
    "Film baştan sona oldukça komik ve Mari ile ikimiz çok gülüyoruz."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:104
translate turkish marimovietheaterstartdate_abcf9a29:

    # "Then somehow that turns into us making out."
    "Sonra bir şekilde bu, öpüşmemize dönüşüyor."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:105
translate turkish marimovietheaterstartdate_46b84a07:

    # "We don't really watch much of the movie after that."
    "Ondan sonra filmi pek izlemiyoruz."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:106
translate turkish marimovietheaterstartdate_d855e56b:

    # "Eventually the movie ends and the credits start rolling."
    "Sonunda film bitiyor ve jeneriği akmaya başlıyor."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:109
translate turkish marimovietheaterstartdate_f176d1eb:

    # fr "That was a cute movie."
    fr "Sevimli bir filmdi."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:111
translate turkish marimovietheaterstartdate_b1836b04:

    # fr "What little I saw of it anyway."
    fr "En azından gördüğüm kadarıyla."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:112
translate turkish marimovietheaterstartdate_91db2110:

    # fr "I like what we did even more than the movie."
    fr "Yaptığımız şey, filmden bile daha çok hoşuma gitti."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:113
translate turkish marimovietheaterstartdate_e25ed9ba:

    # fr "Thanks for taking me."
    fr "Beni götürdüğün için teşekkürler."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:116
translate turkish marimovietheaterstartdate_eb286352:

    # fr "Well the movie wasn't really my thing."
    fr "Aslında film pek benim tarzım değildi."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:118
translate turkish marimovietheaterstartdate_8fc45fba:

    # fr "But seeing it with you made it a lot better."
    fr "Ama seninle izlemek çok daha iyi hale getirdi."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:121
translate turkish marimovietheaterstartdate_c58b0ecd:

    # fr "I'm a big baby, I know."
    fr "Ben kocaman bir bebeksin, biliyorum."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:122
translate turkish marimovietheaterstartdate_acdb9025:

    # fr "But I hated that. Even when I stopped watching it, the noises were still scary."
    fr "Ama ondan nefret ettim. İzlemeyi bıraktığımda bile sesler hala korkutucuydu."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:123
translate turkish marimovietheaterstartdate_26d0b7c9:

    # pc "I'm sorry, I didn't realize that you disliked horror movies so much."
    pc "Özür dilerim, korku filmlerinden bu kadar çok nefret ettiğini fark etmemiştim."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:124
translate turkish marimovietheaterstartdate_30078caa:

    # fr "They just bring back bad memories and make me think about sad things."
    fr "Kötü anıları geri getiriyorlar ve beni üzücü şeyler düşünmeye itiyorlar."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:127
translate turkish marimovietheaterstartdate_c3aec289:

    # fr "That movie was so cute! I loved it!"
    fr "O film çok şirindi! Bayıldım!"

# game/Scenes/Mari/MariDates/marimoviedate.rpy:128
translate turkish marimovietheaterstartdate_070969bf:

    # fr "Thanks so much for bringing me."
    fr "Beni buraya getirdiğin için çok teşekkürler."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:131
translate turkish marimovietheaterstartdate_4549f151:

    # fr "That was a fun movie."
    fr "Eğlenceli bir filmdi."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:133
translate turkish marimovietheaterstartdate_b1836b04_1:

    # fr "What little I saw of it anyway."
    fr "En azından gördüğüm kadarıyla."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:134
translate turkish marimovietheaterstartdate_91db2110_1:

    # fr "I like what we did even more than the movie."
    fr "Filmden çok, yaptığımız şeyi daha çok sevdim."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:135
translate turkish marimovietheaterstartdate_233f5bf6:

    # "When the credits start rolling, we hang out and chat through them."
    "Jenerik akmaya başladığında, oturup sohbet ederiz."

# game/Scenes/Mari/MariDates/marimoviedate.rpy:139
translate turkish marimovietheaterstartdate_972891e3:

    # "When the credits end, we walk outside together and out to my car."
    "Jenerik bittiğinde, birlikte dışarı çıkıp arabama doğru yürürüz."

translate turkish strings:

    # game/Scenes/Mari/MariDates/marimoviedate.rpy:2
    old "When you are able to ask Mari out on a date, take her to the movie theater."
    new "Mari'yi randevuya davet edebildiğinde, onu sinemaya götür."

    # game/Scenes/Mari/MariDates/marimoviedate.rpy:3
    old "She will only be able to go to the movies in the evening on weekends."
    new "O sadece hafta sonları akşamları sinemaya gidebilir."

    # game/Scenes/Mari/MariDates/marimoviedate.rpy:54
    old "Something animated"
    new "Animasyonlu bir film"

