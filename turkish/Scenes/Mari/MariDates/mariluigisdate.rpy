# game/Scenes/Mari/MariDates/mariluigisdate.rpy:28
translate turkish mariluigisstartdate_1ee44fe2:

    # "Mari and I sit next to each other at one of the booths at Luigi's."
    "Mari ve ben, Luigi's'teki kabinlerden birinde yan yana oturuyoruz."

# game/Scenes/Mari/MariDates/mariluigisdate.rpy:29
translate turkish mariluigisstartdate_0d18b373:

    # "We are chatting the whole time about this and that."
    "Sürekli şu bu hakkında sohbet ediyoruz."

# game/Scenes/Mari/MariDates/mariluigisdate.rpy:30
translate turkish mariluigisstartdate_5bdbd1f6:

    # "The waitress comes by and takes our order, we continue talking."
    "Garson gelip siparişlerimizi alıyor, biz konuşmaya devam ediyoruz."

# game/Scenes/Mari/MariDates/mariluigisdate.rpy:34
translate turkish mariluigisstartdate_f9e372f9:

    # "After a short time, the waitress brings our food out to us and we continue talking while we eat."
    "Kısa bir süre sonra garson yemeklerimizi getiriyor ve biz de yerken konuşmaya devam ediyoruz."

# game/Scenes/Mari/MariDates/mariluigisdate.rpy:37
translate turkish mariluigisstartdate_54f7ac2e:

    # "We take our time eating while we talk, just enjoying one another's company."
    "Konuşurken yemeğimizi acele etmeden yiyoruz, sadece birbirimizin eşliğinde vakit geçirmenin tadını çıkarıyoruz."

# game/Scenes/Mari/MariDates/mariluigisdate.rpy:40
translate turkish mariluigisstartdate_764eafa0:

    # fr "Good salad, but the service here isn't great huh?"
    fr "Salata güzelmiş, ama buradaki servis pek iyi değil, değil mi?"

# game/Scenes/Mari/MariDates/mariluigisdate.rpy:41
translate turkish mariluigisstartdate_407731d1:

    # fr "Waiter didn't even face the dang silverware the correct way."
    fr "Garson, o lanet çatal bıçak takımını bile doğru şekilde yerleştirmedi."

# game/Scenes/Mari/MariDates/mariluigisdate.rpy:42
translate turkish mariluigisstartdate_c54b50c7:

    # pc "Well they can't all be as good as you."
    pc "Eh, hepsi senin kadar iyi olamaz tabii."

# game/Scenes/Mari/MariDates/mariluigisdate.rpy:44
translate turkish mariluigisstartdate_a4da275d:

    # fr "Aww..."
    fr "Ah..."

# game/Scenes/Mari/MariDates/mariluigisdate.rpy:48
translate turkish mariluigisstartdate_360f4aaa:

    # "When we're done with the meal, I pay the waitress and Mari and I walk out to the car together and start back towards her house."
    "Yemeğimizi bitirdiğimizde, garsona hesabı ödüyorum ve Mari ile birlikte arabaya doğru yürüyor, onun evine doğru yola çıkıyoruz."

