translate turkish maridateendbad_fda24b08:

    # "We don't talk much as I drive her back home."
    "Onu evine geri götürürken pek konuşmuyoruz."

# game/Scenes/Mari/MariDates/marienddate.rpy:13
translate turkish maridateendbad_332660ab:

    # "When I pull in, I look over at her."
    "Arabayı park ettiğimde ona bakıyorum."

# game/Scenes/Mari/MariDates/marienddate.rpy:14
translate turkish maridateendbad_f2749287:

    # pc "I'm sorry about today."
    pc "Bugün olanlar için üzgünüm."

# game/Scenes/Mari/MariDates/marienddate.rpy:15
translate turkish maridateendbad_32607601:

    # fr "Yeah."
    fr "Evet."

# game/Scenes/Mari/MariDates/marienddate.rpy:16
translate turkish maridateendbad_e2f49b67:

    # fr "I don't think I want to see you anymore."
    fr "Sanırım artık seni görmek istemiyorum."

# game/Scenes/Mari/MariDates/marienddate.rpy:17
translate turkish maridateendbad_364fcd03:

    # fr "Bye, [pcname]."
    fr "Hoşça kal, [pcname]."

# game/Scenes/Mari/MariDates/marienddate.rpy:18
translate turkish maridateendbad_51f7879e:

    # "With that, she gets out of the car and walk into her house."
    "Bunun üzerine arabadan inip evine giriyor."

# game/Scenes/Mari/MariDates/marienddate.rpy:22
translate turkish maridateendbad_d0cc2cdb:

    # "I drive out of her driveway and back towards town."
    "Garaj yolundan çıkıp şehre doğru geri dönüyorum."

# game/Scenes/Mari/MariDates/marienddate.rpy:23
translate turkish maridateendbad_fb9b9632:

    # "I guess Mari and I are done. I'd have to do something pretty big to get her to even talk to me again."
    "Sanırım Mari ile aramız bitti. Onun benimle tekrar konuşmasını sağlamak için oldukça büyük bir şey yapmam gerekecek."

# game/Scenes/Mari/MariDates/marienddate.rpy:33
translate turkish maridateendpoor_fda24b08:

    # "We don't talk much as I drive her back home."
    "Onu evine geri götürürken pek konuşmuyoruz."

# game/Scenes/Mari/MariDates/marienddate.rpy:37
translate turkish maridateendpoor_0a3401a5:

    # "I pull into her driveway and park near her door."
    "Garaj yoluna girip kapısının yanına park ediyorum."

# game/Scenes/Mari/MariDates/marienddate.rpy:38
translate turkish maridateendpoor_54cc5537:

    # pc "I'm sorry today wasn't great."
    pc "Bugün pek iyi geçmedi, üzgünüm."

# game/Scenes/Mari/MariDates/marienddate.rpy:39
translate turkish maridateendpoor_96ff618e:

    # fr "Yeah, it could have gone better."
    fr "Evet, daha iyi geçebilirdi."

# game/Scenes/Mari/MariDates/marienddate.rpy:40
translate turkish maridateendpoor_86900206:

    # fr "Still, it wasn't awful. I'd go out again with you sometime if you wanted."
    fr "Yine de o kadar da kötü değildi. İstersen bir ara seninle tekrar çıkabilirim."

# game/Scenes/Mari/MariDates/marienddate.rpy:44
translate turkish maridateendpoor_025a1db1:

    # fr "Okay. Well call me sometime then."
    fr "Tamam. O zaman ara beni bir ara."

# game/Scenes/Mari/MariDates/marienddate.rpy:45
translate turkish maridateendpoor_9f231683:

    # pc "I will. See you later."
    pc "Arayacağım. Görüşürüz."

# game/Scenes/Mari/MariDates/marienddate.rpy:46
translate turkish maridateendpoor_79ef1b9c:

    # fr "Bye."
    fr "Hoşça kal."

# game/Scenes/Mari/MariDates/marienddate.rpy:47
translate turkish maridateendpoor_9a02741f:

    # "With that, she gets out of the car and walks up to her door."
    "Bunun üzerine arabadan iner ve kapısına doğru yürür."

# game/Scenes/Mari/MariDates/marienddate.rpy:51
translate turkish maridateendpoor_b5a7fa55:

    # "It hadn't been the best date, but it wasn't too bad either. At least she agreed to go on another with me."
    "En iyi randevu olmamıştı, ama o kadar da kötü değildi. En azından benimle bir daha çıkmayı kabul etti."

# game/Scenes/Mari/MariDates/marienddate.rpy:52
translate turkish maridateendpoor_80af0e20:

    # "I'll just have to make the next one better."
    "Bir dahaki sefere daha iyi hale getirmem gerekecek."

# game/Scenes/Mari/MariDates/marienddate.rpy:57
translate turkish maridateendpoor_7a7f5252:

    # fr "Okay. Well thanks for taking me out."
    fr "Tamam. Beni dışarı çıkardığın için teşekkürler."

# game/Scenes/Mari/MariDates/marienddate.rpy:58
translate turkish maridateendpoor_e00118b5:

    # fr "I hope you find somebody that you fit with better."
    fr "Umarım sana daha uygun birini bulursun."

# game/Scenes/Mari/MariDates/marienddate.rpy:59
translate turkish maridateendpoor_eb61ef6e:

    # pc "You too."
    pc "Sen de."

# game/Scenes/Mari/MariDates/marienddate.rpy:60
translate turkish maridateendpoor_1454e679:

    # "With that, she steps out of the car and walks up to her door."
    "Bunun üzerine arabadan inip kapısına doğru yürüdü."

# game/Scenes/Mari/MariDates/marienddate.rpy:66
translate turkish maridateendpoor_0ca75f3a:

    # "That hadn't gone as well as I would have liked, but at least Mari doesn't hate me, I guess?"
    "Her şey istediğim kadar iyi gitmemişti, ama en azından Mari benden nefret etmiyor, sanırım?"

# game/Scenes/Mari/MariDates/marienddate.rpy:67
translate turkish maridateendpoor_9b418399:

    # "We just don't work together well. There's others out there."
    "Sadece birbirimize pek uymuyoruz. Dışarıda başka insanlar da var."

# game/Scenes/Mari/MariDates/marienddate.rpy:75
translate turkish maridateendgood_9201f7f4:

    # "We don't talk much during the drive."
    "Yol boyunca pek konuşmadık."

# game/Scenes/Mari/MariDates/marienddate.rpy:79
translate turkish maridateendgood_2759b5c3:

    # "When I pull into her driveway, I look over at her."
    "Arabayı onun garaj yoluna çektiğimde ona baktım."

# game/Scenes/Mari/MariDates/marienddate.rpy:80
translate turkish maridateendgood_84e51ab3:

    # pc "This was fun. I hope you had a good time."
    pc "Bu eğlenceliydi. Umarım iyi vakit geçirmişsindir."

# game/Scenes/Mari/MariDates/marienddate.rpy:82
translate turkish maridateendgood_68ef2b7a:

    # fr "I did, definitely."
    fr "Evet, kesinlikle."

# game/Scenes/Mari/MariDates/marienddate.rpy:83
translate turkish maridateendgood_6a7e81c5:

    # fr "I can't wait to do it again."
    fr "Tekrar yapmayı sabırsızlıkla bekliyorum."

# game/Scenes/Mari/MariDates/marienddate.rpy:84
translate turkish maridateendgood_d97139f0:

    # fr "Walk me up to the door?"
    fr "Beni kapıya kadar geçirir misin?"

# game/Scenes/Mari/MariDates/marienddate.rpy:85
translate turkish maridateendgood_61f77a4c:

    # pc "Sure."
    pc "Tabii."

# game/Scenes/Mari/MariDates/marienddate.rpy:86
translate turkish maridateendgood_0d361a68:

    # "I park the car in her driveway and walk with her up to her front door."
    "Arabayı garaj yoluna park edip onunla birlikte ön kapısına kadar yürüyorum."

# game/Scenes/Mari/MariDates/marienddate.rpy:93
translate turkish maridateendgood_1ff3de05:

    # fr "I had a really good time. We'll do this again soon right?"
    fr "Gerçekten çok eğlendim. Bunu yakında tekrar yapacağız, değil mi?"

# game/Scenes/Mari/MariDates/marienddate.rpy:94
translate turkish maridateendgood_4664af7e:

    # pc "For sure."
    pc "Kesinlikle."

# game/Scenes/Mari/MariDates/marienddate.rpy:95
translate turkish maridateendgood_40ea4840:

    # fr "Okay. Well I'll see you later then."
    fr "Tamam. O zaman sonra görüşürüz."

# game/Scenes/Mari/MariDates/marienddate.rpy:100
translate turkish maridateendgood_01cc1a36:

    # "I lean in and kiss her. She kisses back enthusiastically."
    "Ona doğru eğilip onu öpüyorum. O da coşkuyla karşılık veriyor."

# game/Scenes/Mari/MariDates/marienddate.rpy:101
translate turkish maridateendgood_7d104398:

    # "We stay like that for some time, our lips locked, our tongues exploring each other."
    "Bir süre öyle kalıyoruz, dudaklarımız birbirine yapışmış, dillerimiz birbirini keşfediyor."

# game/Scenes/Mari/MariDates/marienddate.rpy:102
translate turkish maridateendgood_ec427365:

    # "I want to take it further, but then she pulls away."
    "Daha ileri gitmek istiyorum ama o birden uzaklaşıyor."

# game/Scenes/Mari/MariDates/marienddate.rpy:105
translate turkish maridateendgood_77fea71d:

    # fr "Woah. As nice as that is, we need to stop."
    fr "Vay canına. Her ne kadar hoş olsa da, durmamız gerekiyor."

# game/Scenes/Mari/MariDates/marienddate.rpy:106
translate turkish maridateendgood_f6edb1e6:

    # fr "You better go, but I look forward to continuing this later."
    fr "Gitsen iyi olur, ama bunu daha sonra devam ettirmeyi dört gözle bekliyorum."

# game/Scenes/Mari/MariDates/marienddate.rpy:107
translate turkish maridateendgood_191e3fc9:

    # fr "I'll see you again soon, okay?"
    fr "Yakında tekrar görüşürüz, tamam mı?"

# game/Scenes/Mari/MariDates/marienddate.rpy:108
translate turkish maridateendgood_a2cba356:

    # pc "Okay. Bye, Mari."
    pc "Tamam. Hoşça kal, Mari."

# game/Scenes/Mari/MariDates/marienddate.rpy:109
translate turkish maridateendgood_364fcd03:

    # fr "Bye, [pcname]."
    fr "Hoşça kal, [pcname]."

# game/Scenes/Mari/MariDates/marienddate.rpy:112
translate turkish maridateendgood_5de4b6b2:

    # "With that, she turns and walks inside and I go back to the car."
    "Bunun üzerine o dönüp içeri giriyor, ben de arabaya geri dönüyorum."

# game/Scenes/Mari/MariDates/marienddate.rpy:114
translate turkish maridateendgood_5c0b14bd:

    # "She gives me a final smile before turning and going inside the house."
    "Dönüp evin içine girmeden önce bana son bir gülümseme atıyor."

# game/Scenes/Mari/MariDates/marienddate.rpy:117
translate turkish maridateendgood_550f3dd4:

    # "I walk back to the car."
    "Arabaya geri yürüyorum."

# game/Scenes/Mari/MariDates/marienddate.rpy:121
translate turkish maridateendgood_1fa2fe2f:

    # "The whole way back to town, all I can think about is our next date."
    "Şehre dönerken yol boyunca tek düşünebildiğim şey bir sonraki randevumuz."

