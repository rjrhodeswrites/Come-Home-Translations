    pc "Peki, ödünç verdiğin için teşekkürler. Bir dahaki sefere geldiğimde geri getireceğim."

# game/Scenes/Mari/mari8.rpy:302
translate turkish mari8_1f6fe053:

    # fr "You could keep them if you want. Wear them to school, to your fancy law-office job."
    fr "İstersen sende kalabilir. Okula giy, o şık hukuk bürosundaki işine giy."

# game/Scenes/Mari/mari8.rpy:303
translate turkish mari8_9e0e2b71:

    # pc "Who knows? Maybe I will."
    pc "Kim bilir? Belki de giyerim."

# game/Scenes/Mari/mari8.rpy:306
translate turkish mari8_dae1bf91:

    # "She walks me out to the porch where we hug goodbye."
    "Beni verandaya kadar uğurluyor ve vedalaşmak için sarılıyoruz."

# game/Scenes/Mari/mari8.rpy:307
translate turkish mari8_7ff1a487:

    # fr "This was great. I hope we can do it again soon."
    fr "Harikaydı. Umarım yakında tekrar yapabiliriz."

# game/Scenes/Mari/mari8.rpy:308
translate turkish mari8_9a12f6c6:

    # pc "We will."
    pc "Yapacağız."

# game/Scenes/Mari/mari8.rpy:310
translate turkish mari8_3e1bd0c3:

    # pc "Love you."
    pc "Seni seviyorum."

# game/Scenes/Mari/mari8.rpy:312
translate turkish mari8_d41d8cd9_3:

    # voice mariloveyou
    voice mariloveyou

# game/Scenes/Mari/mari8.rpy:313
translate turkish mari8_afbe9cf9:

    # fr "Love you too, [pcname]."
    fr "Ben de seni seviyorum, [pcname]."

# game/Scenes/Mari/mari8.rpy:314
translate turkish mari8_0561fa98:

    # fr "I'll talk to you later, okay?"
    fr "Sonra konuşuruz, tamam mı?"

# game/Scenes/Mari/mari8.rpy:315
translate turkish mari8_ba155008:

    # pc "Definitely. Have a good day."
    pc "Kesinlikle. İyi günler."

# game/Scenes/Mari/mari8.rpy:316
translate turkish mari8_b4d1da73:

    # fr "You too."
    fr "Sana da."

# game/Scenes/Mari/mari8.rpy:324
translate turkish marilove_51fe7806:

    # pc "I love you too, Mari."
    pc "Ben de seni seviyorum, Mari."

# game/Scenes/Mari/mari8.rpy:325
translate turkish marilove_61599683:

    # "It's true too. I do love her."
    "Bu da doğru. Onu gerçekten seviyorum."

# game/Scenes/Mari/mari8.rpy:326
translate turkish marilove_5aec122e:

    # "We'd have to decide what that love means at some point, and what we should do with it, but for now, I'm just happy to be with her, to care about her, and to have her care about me."
    "Bir noktada bu sevginin ne anlama geldiğine ve bununla ne yapmamız gerektiğine karar vermemiz gerekecek, ama şimdilik sadece onunla birlikte olmaktan, ona değer vermekten ve onun da bana değer vermesinden mutluyum."

