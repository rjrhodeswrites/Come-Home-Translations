translate turkish cc9_9caf3522:

    # sc "Well not a romantic date, but a friendly one."
    sc "Romantik bir buluşma değil tabii, dostça bir buluşma."

# game/Scenes/CounselorChats/Conversations/cc9.rpy:22
translate turkish cc9_7acad64a:

