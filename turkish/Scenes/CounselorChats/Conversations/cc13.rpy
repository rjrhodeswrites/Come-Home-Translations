# game/Scenes/CounselorChats/Conversations/cc13.rpy:12
translate turkish cc13_14c081a9:

    # sc "I need to talk to you about something."
    sc "Seninle bir şey hakkında konuşmam lazım."

# game/Scenes/CounselorChats/Conversations/cc13.rpy:13
translate turkish cc13_c5f20c44:

    # sc "A rumor has been going around that you have been having sex with a teacher."
    sc "Bir öğretmenle seks yaptığın yönünde bir söylenti dolaşıyor."

# game/Scenes/CounselorChats/Conversations/cc13.rpy:14
translate turkish cc13_e89e0515:

    # pc "Oh really?"
    pc "Öyle mi gerçekten?"

# game/Scenes/CounselorChats/Conversations/cc13.rpy:16
translate turkish cc13_cfd3f1f1:

    # sc "Yes. I don't want to get into details, and I don't want you to confirm or deny it."
    sc "Evet. Ayrıntılara girmek istemiyorum ve bunu doğrulamanı ya da yalanlamanı da istemiyorum."

# game/Scenes/CounselorChats/Conversations/cc13.rpy:17
translate turkish cc13_f54f89e3:

    # sc "I just want to warn you."
    sc "Sadece seni uyarmak istiyorum."

# game/Scenes/CounselorChats/Conversations/cc13.rpy:18
translate turkish cc13_50a8a170:

    # sc "You could be putting your diploma in jeopardy, along with the teacher's job."
    sc "Hem diplomanı hem de öğretmenin işini tehlikeye atıyor olabilirsin."

# game/Scenes/CounselorChats/Conversations/cc13.rpy:20
translate turkish cc13_efd8b6cc:

    # sc "So as your counselor, I have to strongly suggest that, if this rumor is true, you end this relationship."
    sc "Bu yüzden danışmanın olarak, bu söylenti doğruysa bu ilişkiyi sonlandırmanı şiddetle tavsiye etmek zorundayım."

# game/Scenes/CounselorChats/Conversations/cc13.rpy:21
translate turkish cc13_b4dece47:

    # sc "It can only bring harm."
    sc "Bu sana sadece zarar getirebilir."

# game/Scenes/CounselorChats/Conversations/cc13.rpy:22
translate turkish cc13_4c93bce8:

    # pc "What about me and you?"
    pc "Peki ya sen ve ben?"

# game/Scenes/CounselorChats/Conversations/cc13.rpy:24
translate turkish cc13_a0c6b3c0:

    # sc "That's a little different."
    sc "O biraz farklı."

# game/Scenes/CounselorChats/Conversations/cc13.rpy:25
translate turkish cc13_a3b40c83:

    # sc "It's still technically against the rules."
    sc "Teknik olarak yine de kurallara aykırı."

# game/Scenes/CounselorChats/Conversations/cc13.rpy:26
translate turkish cc13_466d02ac:

    # sc "I would still get fired if it was discovered, especially since we are doing things here in my office."
    sc "Ortaya çıkarsa yine de kovulurum, özellikle de burada, ofisimde bir şeyler yapıyorsak."

# game/Scenes/CounselorChats/Conversations/cc13.rpy:28
translate turkish cc13_0b00c4ec:

    # sc "But it would probably not cause you to lose your diploma, since I don't assign grades to you."
    sc "Ama muhtemelen diplomanı kaybetmene neden olmaz, çünkü sana not vermiyorum."

# game/Scenes/CounselorChats/Conversations/cc13.rpy:30
translate turkish cc13_aab27f9e:

    # sc "I'm just worried about your success."
    sc "Sadece başarın için endişeleniyorum."

# game/Scenes/CounselorChats/Conversations/cc13.rpy:32
translate turkish cc13_63a948a4:

    # pc "Thanks for looking out for me."
    pc "Bana göz kulak olduğun için teşekkürler."

# game/Scenes/CounselorChats/Conversations/cc13.rpy:33
translate turkish cc13_c935f597:

    # pc "I'll think about it and keep your advice in mind."
    pc "Bunun üzerinde düşüneceğim ve tavsiyeni aklımda tutacağım."

# game/Scenes/CounselorChats/Conversations/cc13.rpy:34
translate turkish cc13_d9dd5654:

    # sc "Please do."
    sc "Lütfen öyle yap."

# game/Scenes/CounselorChats/Conversations/cc13.rpy:35
translate turkish cc13_08618ece:

    # sc "Anyway, you should get to class."
    sc "Neyse, derse gitmelisin."

# game/Scenes/CounselorChats/Conversations/cc13.rpy:36
translate turkish cc13_66b35acb:

    # pc "Okay, talk to you later Gertrude."
    pc "Tamam, sonra görüşürüz Gertrude."

# game/Scenes/CounselorChats/Conversations/cc13.rpy:37
translate turkish cc13_984d8ab7:

    # sc "Bye, hun. Have a good day."
    sc "Hoşça kal tatlım. İyi günler."

translate turkish strings:

    # game/Scenes/CounselorChats/Conversations/cc13.rpy:2
    old "To unlock this scene, you must have had sex with Gertrude and also had sex with either Mrs. McGee or Ms. Welch."
    new "Bu sahneyi açmak için Gertrude ile cinsel ilişkiye girmiş olman ve ayrıca ya Bayan McGee ya da Bayan Welch ile de cinsel ilişkiye girmiş olman gerekir."

    # game/Scenes/CounselorChats/Conversations/cc13.rpy:3
    old "Then this conversation will happen automatically when you visit Gertrude in her office on a weekday morning."
    new "Ardından, hafta içi bir sabah Gertrude’u ofisinde ziyaret ettiğinde bu konuşma otomatik olarak gerçekleşecektir."

