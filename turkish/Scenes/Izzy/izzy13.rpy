# game/Scenes/Izzy/izzy13.rpy:12
translate turkish izzy13_8ca62be9:

    # gl "Hey Twig! Guess what? I got the job!"
    gl "Hey Twig! Bil bakalım ne oldu? İşi aldım!"

# game/Scenes/Izzy/izzy13.rpy:13
translate turkish izzy13_68c72b69:

    # pc "Hey, congratulations!"
    pc "Hey, tebrikler!"

# game/Scenes/Izzy/izzy13.rpy:14
translate turkish izzy13_5a2b96eb:

    # pc "I guess that means you'll be leaving soon, Mari?"
    pc "Sanırım bu, yakında ayrılacağın anlamına geliyor, Mari?"

# game/Scenes/Izzy/izzy13.rpy:15
translate turkish izzy13_d83a5365:

    # fr "Yeah, I'm going to train her for a little while, then I'm done."
    fr "Evet, onu bir süre eğiteceğim, sonra işim biter."

# game/Scenes/Izzy/izzy13.rpy:16
translate turkish izzy13_1591b993:

    # fr "It's a little sad, but I'm glad that Jackson has a good person to take my position."
    fr "Biraz üzücü, ama Jackson'ın benim yerime geçecek iyi birine sahip olmasına sevindim."

# game/Scenes/Izzy/izzy13.rpy:17
translate turkish izzy13_93f32351:

    # gl "Thanks, girl. I appreciate that."
    gl "Teşekkürler, kızım. Çok teşekkür ederim."

# game/Scenes/Izzy/izzy13.rpy:18
translate turkish izzy13_0ce62e11:

    # gl "Well, let's get your order in."
    gl "Peki, siparişini alalım."

# game/Scenes/Izzy/izzy13.rpy:21
translate turkish izzy13_5e8dd55b:

    # "Izzy leads me back to my booth, with Mari trailing along behind her, supervising."
    "Izzy beni masama götürüyor, Mari de arkadan gelip denetliyor."

# game/Scenes/Izzy/izzy13.rpy:22
translate turkish izzy13_44f9ac2a:

    # gl "So what are you having today?"
    gl "Ee, bugün ne alacaksın?"

# game/Scenes/Izzy/izzy13.rpy:23
translate turkish izzy13_6c37c9c9:

    # pc "Cheeseburger with everything, fries, and a coke."
    pc "Her şeyli çizburger, patates kızartması ve kola."

# game/Scenes/Izzy/izzy13.rpy:24
translate turkish izzy13_61e49ea3:

    # gl "Simple. I like it. Give me a few minutes."
    gl "Basit. Hoşuma gitti. Bana birkaç dakika ver."

# game/Scenes/Izzy/izzy13.rpy:27
translate turkish izzy13_12885faf:

    # "Izzy rushes off to the back to put my order in."
    "Izzy siparişimi vermek için arka tarafa koştu."

# game/Scenes/Izzy/izzy13.rpy:28
translate turkish izzy13_c78badbd:

    # pc "So how are things going? How is she doing?"
    pc "Ee, işler nasıl gidiyor? O nasıl?"

# game/Scenes/Izzy/izzy13.rpy:29
translate turkish izzy13_85b43910:

    # fr "She's doing great so far. Jackson likes her a lot."
    fr "Şu ana kadar harika gidiyor. Jackson ondan çok hoşlanıyor."

# game/Scenes/Izzy/izzy13.rpy:30
translate turkish izzy13_278c283a:

    # fr "She's pretty sassy. Jackson loves that."
    fr "Oldukça cesur bir kız. Jackson buna bayılıyor."

# game/Scenes/Izzy/izzy13.rpy:31
translate turkish izzy13_c478ef3e:

    # pc "Good. I'm really happy it's working out."
    pc "Güzel. Her şey yolunda gittiğine çok sevindim."

# game/Scenes/Izzy/izzy13.rpy:32
translate turkish izzy13_ecc2451e:

    # fr "Me too!"
    fr "Ben de!"

# game/Scenes/Izzy/izzy13.rpy:33
translate turkish izzy13_a3a72879:

    # fr "Well, I better get back to helping her. I'll talk to you later, [pcname]."
    fr "Peki, gidip ona yardım etsem iyi olacak. Sonra konuşuruz, [pcname]."

# game/Scenes/Izzy/izzy13.rpy:34
translate turkish izzy13_53fa2ef6:

    # pc "Okay, see ya."
    pc "Tamam, görüşürüz."

# game/Scenes/Izzy/izzy13.rpy:37
translate turkish izzy13_69b02f38:

    # "Mari leaves and I play on my phone for a few minutes until Izzy returns with my food."
    "Mari ayrılır ve ben birkaç dakika telefonumla oynarım, ta ki Izzy yemeğimi getirene kadar."

# game/Scenes/Izzy/izzy13.rpy:40
translate turkish izzy13_3cd8bfcc:

    # gl "Got your burger ready, Twig. Enjoy."
    gl "Hamburgerin hazır, Twig. Afiyet olsun."

# game/Scenes/Izzy/izzy13.rpy:41
translate turkish izzy13_97e892af:

    # pc "Thanks! I'm sure I will."
    pc "Teşekkürler! Eminim afiyetle yiyeceğim."

# game/Scenes/Izzy/izzy13.rpy:42
translate turkish izzy13_8dc0436a:

    # gl "So you and Mari have a thing going on?"
    gl "Yani sen ve Mari arasında bir şeyler mi var?"

# game/Scenes/Izzy/izzy13.rpy:43
translate turkish izzy13_999c143d:

    # pc "Yeah, we've been dating some."
    pc "Evet, bir süredir çıkıyoruz."

# game/Scenes/Izzy/izzy13.rpy:44
translate turkish izzy13_f21ed68a:

    # gl "Man, she's so hot."
    gl "Vay be, o çok seksi."

# game/Scenes/Izzy/izzy13.rpy:45
translate turkish izzy13_a996b478:

    # gl "We should all three get together sometime, you know?"
    gl "Bir ara üçümüz bir araya gelmeliyiz, ne dersin?"

# game/Scenes/Izzy/izzy13.rpy:46
translate turkish izzy13_f945ea47:

    # pc "Yeah maybe. We'll see."
    pc "Evet, belki. Bakarız."

# game/Scenes/Izzy/izzy13.rpy:47
translate turkish izzy13_0827ec33:

    # gl "Anyway, let me know if you need anything. I gotta go take care of those assholes over there."
    gl "Neyse, bir şeye ihtiyacın olursa haber ver. Şuradaki pisliklerle ilgilenmem lazım."

# game/Scenes/Izzy/izzy13.rpy:48
translate turkish izzy13_49912e7a:

    # pc "Alright, I will."
    pc "Tamam, haber veririm."

# game/Scenes/Izzy/izzy13.rpy:51
translate turkish izzy13_410fc4ec:

    # "Izzy goes to help other customers and I eat my meal."
    "Izzy diğer müşterilere yardım etmeye gidiyor ve ben yemeğimi yiyorum."

# game/Scenes/Izzy/izzy13.rpy:54
translate turkish izzy13_1afb6a34:

    # "Then a few minutes later, Izzy and Mari return."
    "Birkaç dakika sonra Izzy ve Mari geri dönüyor."

# game/Scenes/Izzy/izzy13.rpy:55
translate turkish izzy13_b99c5a01:

    # gl "Did you like your burger?"
    gl "Hamburgerini beğendin mi?"

# game/Scenes/Izzy/izzy13.rpy:56
translate turkish izzy13_a248948f:

    # pc "Of course."
    pc "Tabii ki."

# game/Scenes/Izzy/izzy13.rpy:57
translate turkish izzy13_d2f1177a:

    # gl "I know, right? They're so fucking good."
    gl "Değil mi? Gerçekten çok lezzetliler."

# game/Scenes/Izzy/izzy13.rpy:58
translate turkish izzy13_4a0f9f0f:

    # gl "I'm going to end up eating so many, working here. My ass is gonna get {i}fat{/i}!"
    gl "Burada çalışırken sonunda çok fazla yiyeceğim. Kıçım {i}şişmanlayacak{/i}!"

# game/Scenes/Izzy/izzy13.rpy:59
translate turkish izzy13_bad98252:

    # gl "How do you stay so fit, Mari?"
    gl "Nasıl bu kadar formda kalıyorsun, Mari?"

# game/Scenes/Izzy/izzy13.rpy:60
translate turkish izzy13_2202a21b:

    # fr "Benefits of being vegetarian."
    fr "Vejetaryen olmanın faydaları."

# game/Scenes/Izzy/izzy13.rpy:61
translate turkish izzy13_03e1f782:

    # gl "Well I sure as hell ain't doing that!"
    gl "Ben kesinlikle öyle bir şey yapmayacağım!"

# game/Scenes/Izzy/izzy13.rpy:62
translate turkish izzy13_481c466b:

    # gl "Anyways, have a good day, Twig. I'll see you later."
    gl "Neyse, iyi günler, Twig. Sonra görüşürüz."

# game/Scenes/Izzy/izzy13.rpy:63
translate turkish izzy13_1af352a6:

    # fr "Yeah, bye [pcname]. Thanks for coming in."
    fr "Evet, hoşça kal [pcname]. Uğradığın için teşekkürler."

# game/Scenes/Izzy/izzy13.rpy:66
translate turkish izzy13_afdbb1fc:

    # "They start to walk away, and Izzy looks back at me."
    "Uzaklaşmaya başlıyorlar ve Izzy bana dönüp bakıyor."

# game/Scenes/Izzy/izzy13.rpy:67
translate turkish izzy13_65d07413:

    # gl "You better give me a good tip. I was downright fucking pleasant."
    gl "Bana iyi bir bahşiş versen iyi olur. Gerçekten çok naziktim."

# game/Scenes/Izzy/izzy13.rpy:68
translate turkish izzy13_8a5abc7f:

    # pc "I'll give you more than the tip."
    pc "Bahşişten fazlasını vereceğim."

# game/Scenes/Izzy/izzy13.rpy:69
translate turkish izzy13_8f001d5e:

    # gl "Don't tease me, Twig. I have to work 'til closing today."
    gl "Beni kızdırma, Twig. Bugün kapanışa kadar çalışmam gerekiyor."

# game/Scenes/Izzy/izzy13.rpy:70
translate turkish izzy13_864b9473:

    # pc "Have fun."
    pc "İyi eğlenceler."

# game/Scenes/Izzy/izzy13.rpy:71
translate turkish izzy13_4772f020:

    # gl "Yeah, yeah. See ya."
    gl "Evet, evet. Görüşürüz."

# game/Scenes/Izzy/izzy13.rpy:74
translate turkish izzy13_2cf41d4f:

    # "With a smile, I leave a generous tip on the table and leave."
    "Gülümsayarak masaya cömert bir bahşiş bırakıp çıkıyorum."

# game/Scenes/Izzy/izzy13.rpy:75
translate turkish izzy13_b9414cfd:

    # "It's good to see Izzy doing well. I hope the job works out for her."
    "Izzy'nin iyi durumda olduğunu görmek güzel. Umarım iş işi yolunda gider."

translate turkish strings:

    # game/Scenes/Izzy/izzy13.rpy:1
    old "You'll need to progress far enough with Izzy that she is looking for a job. You will also have to progress far enough with Mari that she tells you she is leaving Jackson Burger."
    new "Izzy ile ilişkini, iş aramaya başlayacağı noktaya kadar ilerletmen gerekecek. Ayrıca Mari ile de ilişkini, sana Jackson Burger'dan ayrılacağını söyleyeceği noktaya kadar ilerletmen gerekecek."

    # game/Scenes/Izzy/izzy13.rpy:2
    old "Have conversations with Izzy asking what kind of job she is looking for, then have the conversation to suggest Jackson Burger. Then this scene will happen when you next go to Jackson Burger."
    new "Izzy ile ne tür bir iş aradığını sorarak sohbet et, ardından ona Jackson Burger'ı öneren bir konuşma yap. Böylece bir dahaki sefere Jackson Burger'a gittiğinde bu sahne gerçekleşecek."

