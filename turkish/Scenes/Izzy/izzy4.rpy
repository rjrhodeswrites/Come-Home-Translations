# game/Scenes/Izzy/izzy4.rpy:14
translate turkish izzy4_4024ac17:

    # "I hang out with Izzy and her gang for a while."
    "Bir süre Izzy ve çetesiyle takılıyorum."

# game/Scenes/Izzy/izzy4.rpy:15
translate turkish izzy4_13ec06b7:

    # gl "You know, Twig, I like you."
    gl "Biliyor musun Twig, senden hoşlanıyorum."

# game/Scenes/Izzy/izzy4.rpy:18
translate turkish izzy4_6eac563e:

    # gl "You start coming around here even though you don't quite fit in and you just force your way into my group."
    gl "Buraya pek uyum sağlayamasan da gelmeye başlıyorsun ve zorla da olsa grubuma giriyorsun."

# game/Scenes/Izzy/izzy4.rpy:19
translate turkish izzy4_587e3e94:

    # gl "I like that tenacity. It's pretty hot actually."
    gl "Bu azmini seviyorum. Aslında oldukça seksi."

# game/Scenes/Izzy/izzy4.rpy:20
translate turkish izzy4_5997026a:

    # gl "Anyway, here's my phone number."
    gl "Neyse, işte telefon numaram."

# game/Scenes/Izzy/izzy4.rpy:21
translate turkish izzy4_9efb5f7a:

    # gl "So we can talk sometime without these knuckle-heads hanging around."
    gl "Böylece bu ahmaklar etrafta dolanmadan bir ara konuşabiliriz."

# game/Scenes/Izzy/izzy4.rpy:22
translate turkish izzy4_ef3bfa78:

    # pc "What about Devon? Isn't he your boyfriend?"
    pc "Peki ya Devon? O senin erkek arkadaşın değil mi?"

# game/Scenes/Izzy/izzy4.rpy:23
translate turkish izzy4_ae3aabd6:

    # gl "I told you. I do what I want."
    gl "Söylemiştim ya. Ne istersem onu yaparım."

# game/Scenes/Izzy/izzy4.rpy:24
translate turkish izzy4_3cb128b8:

    # gl "And I want to talk to you solo sometime."
    gl "Ve bir ara seninle baş başa konuşmak istiyorum."

# game/Scenes/Izzy/izzy4.rpy:25
translate turkish izzy4_136391eb:

    # gl "That okay?"
    gl "Sorun olur mu?"

# game/Scenes/Izzy/izzy4.rpy:26
translate turkish izzy4_4f1735dd:

    # pc "Sounds good to me."
    pc "Bana uyar."

# game/Scenes/Izzy/izzy4.rpy:27
translate turkish izzy4_74f6beab:

    # gl "Good. Call me sometime."
    gl "Güzel. Bir ara beni ara."

# game/Scenes/Izzy/izzy4.rpy:28
translate turkish izzy4_08551511:

    # pc "You got it."
    pc "Tamamdır."

# game/Scenes/Izzy/izzy4.rpy:32
translate turkish izzy4_41084d43:

    # "I add Izzy's phone number into my contacts list."
    "Izzy'nin telefon numarasını rehberime ekliyorum."

# game/Scenes/Izzy/izzy4.rpy:34
translate turkish izzy4_ade661fa:

    # "We hang out a little longer, smoking and dancing."
    "Biraz daha takılıyoruz, sigara içip dans ediyoruz."

# game/Scenes/Izzy/izzy4.rpy:36
translate turkish izzy4_2c51ee8c:

    # "We hang out a little longer, just chatting and dancing."
    "Biraz daha takılıyoruz, sadece sohbet edip dans ediyoruz."

# game/Scenes/Izzy/izzy4.rpy:37
translate turkish izzy4_a42d0c9d:

    # "The cops don't even show up tonight. They must be busy working some actual crimes."
    "Bu gece polisler gelmiyor bile. Gerçek suçlarla meşgul olmalılar."

# game/Scenes/Izzy/izzy4.rpy:38
translate turkish izzy4_fce6a84a:

    # "It's a good time."
    "Eğlenceli bir gece."

# game/Scenes/Izzy/izzy4.rpy:39
translate turkish izzy4_efe3ccf0:

    # "Then when it's time to leave, everybody goes their separate ways and I head back to the car and drive off."
    "Sonra gitme vakti geldiğinde herkes kendi yoluna gidiyor, ben de arabaya dönüp uzaklaşıyorum."

translate turkish strings:

    # game/Scenes/Izzy/izzy4.rpy:2
