# game/Scenes/Izzy/izzy2.rpy:13
translate turkish izzy2_b51311fa:

    # "I'm not going to run though. I'm confident in myself."
    "Ama kaçmayacağım. Kendime güveniyorum."

# game/Scenes/Izzy/izzy2.rpy:14
translate turkish izzy2_a9a2f7bf:

    # "Maybe he'll kick my ass, but I'm not running."
    "Belki beni fena halde pataklar, ama kaçmayacağım."

# game/Scenes/Izzy/izzy2.rpy:17
translate turkish izzy2_da02f2e6:

    # "When Moose is about to slam into me, I quickly step aside and instead he trips forward, tumbling through the air."
    "Moose bana çarpmak üzereyken hızla kenara çekildim ve onun yerine o öne doğru tökezleyip havada takla attı."

# game/Scenes/Izzy/izzy2.rpy:20
translate turkish izzy2_4a1e9586:

    # "He slams hard into the ground and lies there moaning."
    "Yere sertçe çarptı ve orada inleyerek yattı."

# game/Scenes/Izzy/izzy2.rpy:21
translate turkish izzy2_7575cb2e:

    # "Izzy and the others burst into laughter, pointing at him."
    "Izzy ve diğerleri onu işaret ederek kahkahalara boğuldu."

# game/Scenes/Izzy/izzy2.rpy:22
translate turkish izzy2_58f4b0c6:

    # moose "S'not funny, man."
    moose "Hiç komik değil dostum."

# game/Scenes/Izzy/izzy2.rpy:23
translate turkish izzy2_fa71cc47:

    # mal "I don't know about that."
    mal "Bunu bilemem."

# game/Scenes/Izzy/izzy2.rpy:24
translate turkish izzy2_0a29e854:

    # gl "Pretty damn funny to me."
    gl "Bana göre oldukça komik."

# game/Scenes/Izzy/izzy2.rpy:28
translate turkish izzy2_d41d8cd9:

    # voice 'voices/izzy_2_1.mp3'
    voice 'voices/izzy_2_1.mp3'

# game/Scenes/Izzy/izzy2.rpy:29
translate turkish izzy2_9be7b884:

    # gl "Got to say, I'm impressed, Twig."
    gl "Söylemeliyim ki, etkilendim Twig."

# game/Scenes/Izzy/izzy2.rpy:31
translate turkish izzy2_d41d8cd9_1:

    # voice 'voices/izzy_2_2.mp3'
    voice 'voices/izzy_2_2.mp3'

# game/Scenes/Izzy/izzy2.rpy:32
translate turkish izzy2_6e6d4843:

    # gl "Not many people who have the guts to stand their ground against Moose."
    gl "Moose’a karşı dik durmaya cesaret edebilecek pek fazla insan yok."

# game/Scenes/Izzy/izzy2.rpy:34
translate turkish izzy2_d41d8cd9_2:

    # voice 'voices/izzy_2_3.mp3'
    voice 'voices/izzy_2_3.mp3'

# game/Scenes/Izzy/izzy2.rpy:35
translate turkish izzy2_728d74b7:

    # gl "You're alright. You can hang with us."
    gl "Fena değilsin. Bizimle takılabilirsin."

# game/Scenes/Izzy/izzy2.rpy:37
translate turkish izzy2_d41d8cd9_3:

    # voice 'voices/izzy_2_4.mp3'
    voice 'voices/izzy_2_4.mp3'

# game/Scenes/Izzy/izzy2.rpy:38
translate turkish izzy2_e3c5fbdd:

    # gl "I'm Izzy. These guys are my gang."
    gl "Ben Izzy. Bu çocuklar benim çetem."

# game/Scenes/Izzy/izzy2.rpy:39
translate turkish izzy2_a0189c31:

    # moose "YOUR gang?"
    moose "SENİN çeten mi?"

# game/Scenes/Izzy/izzy2.rpy:40
translate turkish izzy2_f87a2e20:

    # gl "Yeah, Moose. MY gang. You have a problem with that?"
    gl "Evet Moose. BENİM çetem. Bununla bir sorunun mu var?"

# game/Scenes/Izzy/izzy2.rpy:41
translate turkish izzy2_bf630c9b:

    # moose "Naw, sis. No problem."
    moose "Hayır abla. Sorun yok."

# game/Scenes/Izzy/izzy2.rpy:43
translate turkish izzy2_d41d8cd9_4:

    # voice 'voices/izzy_2_5.mp3'
    voice 'voices/izzy_2_5.mp3'

# game/Scenes/Izzy/izzy2.rpy:44
translate turkish izzy2_b260b0b6:

    # gl "You know Moose. The shirtless Bruce Lee-looking boy-toy over there is Mal."
    gl "Moose'u tanırsın. Şuradaki gömleksiz, Bruce Lee'ye benzeyen genç sevgilim Mal."

# game/Scenes/Izzy/izzy2.rpy:45
translate turkish izzy2_3e106586:

    # mal "Wassup?"
    mal "Naber?"

# game/Scenes/Izzy/izzy2.rpy:47
translate turkish izzy2_d41d8cd9_5:

    # voice 'voices/izzy_2_7.mp3'
    voice 'voices/izzy_2_7.mp3'

# game/Scenes/Izzy/izzy2.rpy:48
translate turkish izzy2_45725a14:

    # gl "And tall, dark and skinny behind me is Devon. He don't talk much."
    gl "Arkamda duran uzun boylu, esmer ve sıska olan da Devon. Pek konuşmaz."

# game/Scenes/Izzy/izzy2.rpy:49
translate turkish izzy2_dc8cb990:

    # "Devon nods his head slightly at me."
    "Devon bana hafifçe başını sallıyor."

# game/Scenes/Izzy/izzy2.rpy:50
translate turkish izzy2_522e1448:

    # gl "And that's the gang. Except now there's you - Twig."
    gl "İşte ekip bu. Artık sen de varsın - Twig."

# game/Scenes/Izzy/izzy2.rpy:51
translate turkish izzy2_8b86df4b:

    # pc "My name is--"
    pc "Adım..."

# game/Scenes/Izzy/izzy2.rpy:52
translate turkish izzy2_28bea8fd:

    # "Just then the chirp of a police siren and a flashing light in the distance catches everyone's attention."
    "Tam o sırada uzaktan gelen bir polis sireni ve yanıp sönen ışık herkesin dikkatini çekiyor."

# game/Scenes/Izzy/izzy2.rpy:55
translate turkish izzy2_40384605:

    # mal "Cops!"
    mal "Polisler!"

# game/Scenes/Izzy/izzy2.rpy:56
translate turkish izzy2_3a4267e8:

    # moose "Oh shit, I gotta get out of here!"
    moose "Kahretsin, buradan gitmem lazım!"

# game/Scenes/Izzy/izzy2.rpy:57
translate turkish izzy2_db9ea3d3:

    # gl "Damn, gotta split."
    gl "Lanet olsun, kaçmam lazım."

# game/Scenes/Izzy/izzy2.rpy:60
translate turkish izzy2_84f98777:

    # gl "You come back and hang out with us sometime."
    gl "Bir ara geri gelip bizimle takıl."

# game/Scenes/Izzy/izzy2.rpy:61
translate turkish izzy2_37f4bf94:

    # gl "We know how to have a good time."
    gl "Nasıl eğlenileceğini iyi biliriz."

# game/Scenes/Izzy/izzy2.rpy:62
translate turkish izzy2_d2b269a7:

    # gl "See you later, Twig."
    gl "Görüşürüz Twig."

# game/Scenes/Izzy/izzy2.rpy:65
translate turkish izzy2_dbce667a:

    # "With that, she runs off in the same direction as the others."
    "Bunun üzerine, o da diğerleriyle aynı yöne doğru koşarak uzaklaşır."

# game/Scenes/Izzy/izzy2.rpy:66
translate turkish izzy2_4f647b81:

    # "I turn and walk back to my car."
    "Dönüp arabama doğru yürüyorum."

# game/Scenes/Izzy/izzy2.rpy:67
translate turkish izzy2_56b73e22:

    # "The police sirens and lights fade away. I'm not even sure they were aware of Izzy and her gang."
    "Polis sirenleri ve ışıkları uzaklaşıyor. Izzy ve çetesinin farkında olup olmadıklarından bile emin değilim."

# game/Scenes/Izzy/izzy2.rpy:68
translate turkish izzy2_b8cda32c:

    # "I wonder why they are so jumpy?"
    "Neden bu kadar gerginler acaba?"

# game/Scenes/Izzy/izzy2.rpy:69
translate turkish izzy2_b0b60482:

    # "I'll have to come back and hang out with them some other time. For now I get in my car and drive away."
    "Başka bir zaman geri gelip onlarla takılmam gerekecek. Şimdilik arabama biniyorum ve uzaklaşıyorum."

translate turkish strings:

    # game/Scenes/Izzy/izzy2.rpy:2
    old "Once you have some confidence,"
    new "Biraz özgüven kazandığında,"

    # game/Scenes/Izzy/izzy2.rpy:3
    old "this scene will happen when you stand your ground against Moose in the evening at the Park."
    new "akşamları parkta Moose’a karşı dik durduğunda bu sahne yaşanacak."

