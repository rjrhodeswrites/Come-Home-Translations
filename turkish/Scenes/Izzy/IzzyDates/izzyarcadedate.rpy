# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:26
translate turkish izzyarcadedatestart_a324d7e5:

    # gl "So we're going to an arcade? I haven't played any arcade games in forever."
    gl "Demek oyun salonuna gidiyoruz? Uzun zamandır hiç oyun salonunda oyun oynamadım."

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:29
translate turkish izzyarcadedatestart_d41d8cd9:

    # voice 'voices/izzy_whatsup.mp3'
    voice 'voices/izzy_whatsup.mp3'

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:30
translate turkish izzyarcadedatestart_515d2991:

    # gl "What's up, Twig. Let's go play some games."
    gl "Naber, Twig. Hadi gidip biraz oyun oynayalım."

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:36
translate turkish izzyarcadedatestart_605a4d9f:

    # gl "Hey, this place is pretty cool. I bet Stanley and Paul would love it."
    gl "Hey, burası oldukça havalı. Eminim Stanley ve Paul burayı çok sevecekler."

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:37
translate turkish izzyarcadedatestart_b1581a15:

    # gl "Maybe we could bring them sometime, when I'm able to."
    gl "Belki bir ara, ben de müsait olduğumda onları da getirebiliriz."

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:38
translate turkish izzyarcadedatestart_8de112f2:

    # pc "Yeah for sure, that sounds fun."
    pc "Evet tabii, kulağa eğlenceli geliyor."

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:45
translate turkish izzyarcadedatestart_f9357be7:

    # "We play games and chat for a while."
    "Bir süre oyun oynayıp sohbet ediyoruz."

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:49
translate turkish izzyarcadedatestart_66506ca5:

    # "We try out a few different games."
    "Birkaç farklı oyun deniyoruz."

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:57
translate turkish izzyarcadedatestart_726fbd6c:

    # "It's all fun and she seems to have a good time."
    "Her şey çok eğlenceli ve o da iyi vakit geçiriyor gibi görünüyor."

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:59
translate turkish izzyarcadedatestart_84d584ed:

    # "When we're done playing, I drive Izzy back to her house."
    "Oyun bittiğinde, Izzy’yi evine geri götürüyorum."

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:60
translate turkish izzyarcadedatestart_2a5b6b89:

    # "I pull into her driveway and she turns to look at me."
    "Arabayı garaj yoluna çekiyorum ve o bana bakmak için dönüyor."

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:62
translate turkish izzyarcadedatestart_6dd86d8c:

    # gl "So, do you want to come inside and fuck a little?"
    gl "Ee, içeri gelip biraz sevişmek ister misin?"

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:69
translate turkish izzyarcadedatestart_dcbc938c:

    # gl "Cool, let's go."
    gl "Harika, hadi gidelim."

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:72
translate turkish izzyarcadedatestart_dcbc938c_1:

    # gl "Cool, let's go."
    gl "Harika, hadi gidelim."

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:75
translate turkish izzyarcadedatestart_7c186cf5:

    # gl "Damn. Well thanks for hanging out anyway. It was fun."
    gl "Kahretsin. Neyse, yine de birlikte vakit geçirdiğin için teşekkürler. Eğlenceliydi."

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:76
translate turkish izzyarcadedatestart_63fc4244:

    # pc "Bye, Izzy."
    pc "Hoşça kal, Izzy."

# game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:79
translate turkish izzyarcadedatestart_8b93ebfd:

    # "I wait until she gets out and walks into her house before I drive away."
    "O arabadan inip evine girene kadar bekledikten sonra arabayla uzaklaşıyorum."

translate turkish strings:

    # game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:4
    old "After your first date with Izzy, you can ask her out by talking to her in the evening."
    new "Izzy ile ilk randevunuzdan sonra, akşam saatlerinde onunla konuşarak ona tekrar çıkma teklifinde bulunabilirsiniz."

    # game/Scenes/Izzy/IzzyDates/izzyarcadedate.rpy:5
    old "Once you have unlocked the arcade through Adrian's story, you can choose to take Izzy there."
    new "Adrian'ın hikayesi sayesinde oyun salonunun kilidini açtıktan sonra, Izzy'yi oraya götürmeyi seçebilirsiniz."

