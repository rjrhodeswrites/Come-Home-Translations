# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:95
translate turkish izzymoviedatestart_dcbc938c_1:

    # gl "Cool, let's go."
    gl "Harika, hadi gidelim."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:98
translate turkish izzymoviedatestart_9a2ffc1c:

    # gl "Damn, fingers it is then. Thanks for the movie anyway, Twig. See ya later."
    gl "Kahretsin, o zaman parmakla idare edelim. Yine de film için teşekkürler, Twig. Görüşürüz."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:99
translate turkish izzymoviedatestart_63fc4244:

    # pc "Bye, Izzy."
    pc "Hoşça kal, Izzy."

# game/Scenes/Izzy/IzzyDates/izzymoviedate.rpy:102
translate turkish izzymoviedatestart_8b93ebfd:

    # "I wait until she gets out and walks into her house before I drive away."
    "Arabayı sürmeden önce, onun arabadan inip evine girmesini bekliyorum."

