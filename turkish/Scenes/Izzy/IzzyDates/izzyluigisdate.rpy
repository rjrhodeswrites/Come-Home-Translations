translate turkish izzyluigisdatestart_528b32f8:

    # gl "Hey Twig. I've never been to this place before. Is it good?"
    gl "Selam Twig. Buraya daha önce hiç gelmemiştim. Burası iyi mi?"

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:28
translate turkish izzyluigisdatestart_60666a62:

    # pc "Yeah, they have great pizza. Or anything Italian. I love it."
    pc "Evet, pizzaları harika. Ya da İtalyan yemekleri genel olarak. Bayılıyorum."

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:29
translate turkish izzyluigisdatestart_892088c7:

    # gl "Fuck, some good pizza sounds good."
    gl "Vay be, lezzetli bir pizza kulağa hoş geliyor."

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:32
translate turkish izzyluigisdatestart_d41d8cd9:

    # voice 'voices/izzy_whatsup.mp3'
    voice 'voices/izzy_whatsup.mp3'

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:33
translate turkish izzyluigisdatestart_7abda82a:

    # gl "What's up, Twig. Let's go get some fucking pizza."
    gl "Naber Twig? Hadi gidip biraz pizza yiyelim."

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:37
translate turkish izzyluigisdatestart_008f10b6:

    # gl "Wow, this place is a little more fancy than I expected."
    gl "Vay canına, burası beklediğimden biraz daha şıkmış."

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:38
translate turkish izzyluigisdatestart_8fffd4a0:

    # gl "Maybe I should have put on some makeup or something."
    gl "Belki de biraz makyaj falan yapmalıydım."

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:39
translate turkish izzyluigisdatestart_560798c7:

    # pc "You look great. Don't worry about it."
    pc "Harika görünüyorsun. Kafana takma."

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:41
translate turkish izzyluigisdatestart_5efd3620:

    # gl "Alright then. Thanks, Twig."
    gl "Peki o zaman. Teşekkürler, Twig."

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:45
translate turkish izzyluigisdatestart_868de71e:

    # "We sit at the booth and order a pizza."
    "Masaya oturup pizza sipariş ediyoruz."

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:46
translate turkish izzyluigisdatestart_a675496b:

    # "We start talking and don't stop the whole time we're there."
    "Konuşmaya başlıyoruz ve orada olduğumuz süre boyunca hiç susmuyoruz."

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:53
translate turkish izzyluigisdatestart_d0143732:

    # "When we're done eating, I drive Izzy back to her house."
    "Yemeğimizi bitirince, Izzy’yi evine bırakıyorum."

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:54
translate turkish izzyluigisdatestart_2a5b6b89:

    # "I pull into her driveway and she turns to look at me."
    "Arabayı garaj yoluna çekiyorum ve o bana bakmak için dönüyor."

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:56
translate turkish izzyluigisdatestart_6dd86d8c:

    # gl "So, do you want to come inside and fuck a little?"
    gl "Ee, içeri gelip biraz sevişmek ister misin?"

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:63
translate turkish izzyluigisdatestart_dcbc938c:

    # gl "Cool, let's go."
    gl "Harika, hadi gidelim."

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:66
translate turkish izzyluigisdatestart_dcbc938c_1:

    # gl "Cool, let's go."
    gl "Harika, hadi gidelim."

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:69
translate turkish izzyluigisdatestart_a9bda5cf:

    # gl "Damn, a girl can hope. Thanks for the food anyway, Twig. See ya later."
    gl "Kahretsin, bir kızın umudu olabilir ya. Yine de yemek için teşekkürler, Twig. Görüşürüz."

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:70
translate turkish izzyluigisdatestart_63fc4244:

    # pc "Bye, Izzy."
    pc "Hoşça kal, Izzy."

# game/Scenes/Izzy/IzzyDates/izzyluigisdate.rpy:73
translate turkish izzyluigisdatestart_8b93ebfd:

    # "I wait until she gets out and walks into her house before I drive away."
    "Arabayla uzaklaşmadan önce, onun dışarı çıkıp evine girmesini bekliyorum."

