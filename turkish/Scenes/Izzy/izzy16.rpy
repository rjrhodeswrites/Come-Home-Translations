    # pc "Later, Moose."
    pc "Sonra görüşürüz, Moose."

# game/Scenes/Izzy/izzy16.rpy:323
translate turkish izzy16_a2a8f537:

    # mal "Bye, guys!"
    mal "Hoşça kalın, millet!"

# game/Scenes/Izzy/izzy16.rpy:324
translate turkish izzy16_9ea02672:

    # "We tell them goodbye and they leave the house, heading out to Mal's car."
    "Onlara veda ediyoruz ve onlar evden çıkıp Mal’ın arabasına doğru gidiyorlar."

# game/Scenes/Izzy/izzy16.rpy:327
translate turkish izzy16_e4961fdc:

    # gl "Well... that was a fun game night."
    gl "Şey... eğlenceli bir oyun gecesiydi."

# game/Scenes/Izzy/izzy16.rpy:328
translate turkish izzy16_31907f49:

    # gl "Sorry I cheated."
    gl "Hile yaptığım için özür dilerim."

# game/Scenes/Izzy/izzy16.rpy:329
translate turkish izzy16_9171cd52:

    # pc "Ah, it's all right. We all knew where this was going, I think."
    pc "Ah, sorun değil. Sanırım hepimiz bunun nereye varacağını biliyorduk."

# game/Scenes/Izzy/izzy16.rpy:330
translate turkish izzy16_4abf1190:

    # gl "Thanks for sharing. I really enjoyed it."
    gl "Paylaştığın için teşekkürler. Gerçekten çok keyif aldım."

# game/Scenes/Izzy/izzy16.rpy:331
translate turkish izzy16_53a29a41:

    # pc "I know you did. I did too."
    pc "Aldığını biliyorum. Ben de aldım."

# game/Scenes/Izzy/izzy16.rpy:334
translate turkish izzy16_e914bfdc:

    # gl "You are a really good boyfriend, you know that?"
    gl "Sen gerçekten iyi bir erkek arkadaşsın, biliyor musun?"

# game/Scenes/Izzy/izzy16.rpy:335
translate turkish izzy16_677ee242:

    # pc "Yeah, you're not so bad yourself."
    pc "Evet, sen de fena sayılmazsın."

# game/Scenes/Izzy/izzy16.rpy:336
translate turkish izzy16_6d52d3a6:

    # gl "I may want to marry you one day."
    gl "Bir gün seninle evlenmek isteyebilirim."

# game/Scenes/Izzy/izzy16.rpy:337
translate turkish izzy16_ae871f39:

    # pc "Oh yeah?"
    pc "Öyle mi?"

# game/Scenes/Izzy/izzy16.rpy:340
translate turkish izzy16_a3388522:

    # gl "Maybe. Just something I was thinking about."
    gl "Belki. Sadece aklıma gelen bir şeydi."

# game/Scenes/Izzy/izzy16.rpy:341
translate turkish izzy16_fc71e7f9:

    # gl "You staying the night?"
    gl "Bu gece kalacak mısın?"

# game/Scenes/Izzy/izzy16.rpy:342
translate turkish izzy16_3e51dd6a:

    # pc "Yeah, I'll stay."
    pc "Evet, kalacağım."

# game/Scenes/Izzy/izzy16.rpy:346
translate turkish izzy16_c6a7da14:

    # "We go back to her bed and lie down together."
    "Yatağına geri dönüp birlikte uzanıyoruz."

# game/Scenes/Izzy/izzy16.rpy:349
translate turkish izzy16_033d9c0c:

    # "It doesn't take long before we're both asleep."
    "Çok geçmeden ikimiz de uykuya dalıyoruz."

# game/Scenes/Izzy/izzy16.rpy:352
translate turkish izzy16_1cee6238:

    # "I wake up to the sound of my phone alarm in the morning."
    "Sabah telefonumun alarm sesiyle uyanıyorum."

# game/Scenes/Izzy/izzy16.rpy:355
translate turkish izzy16_bc4ff6d9:

    # pc "Hey, Izzy. I have to go."
    pc "Selam Izzy. Gitmem lazım."

# game/Scenes/Izzy/izzy16.rpy:356
translate turkish izzy16_4511aa4e:

    # gl "Oh okay, baby."
    gl "Tamam bebeğim."

# game/Scenes/Izzy/izzy16.rpy:357
translate turkish izzy16_475c67d1:

    # gl "Hope you have a good day. Thanks for staying over."
    gl "Umarım güzel bir gün geçirirsin. Kalıp bana eşlik ettiğin için teşekkürler."

# game/Scenes/Izzy/izzy16.rpy:360
translate turkish izzy16_f4a8219d:

    # pc "I'll talk to you later."
    pc "Sonra konuşuruz."

# game/Scenes/Izzy/izzy16.rpy:361
translate turkish izzy16_923d4965:

    # gl "Okay."
    gl "Tamam."

# game/Scenes/Izzy/izzy16.rpy:364
translate turkish izzy16_7db1b4d7:

    # "As I'm walking away, I hear her say, almost too low to make out the words..."
    "Uzaklaşırken, kelimeleri ayırt edemeyecek kadar alçak bir sesle şöyle dediğini duyuyorum..."

# game/Scenes/Izzy/izzy16.rpy:365
translate turkish izzy16_968ee224:

    # gl "Love you, Twig."
    gl "Seni seviyorum, Twig."

# game/Scenes/Izzy/izzy16.rpy:366
translate turkish izzy16_5236ef26:

    # "I leave Izzy's house, then head home to change and shower before starting my day."
    "Izzy’nin evinden ayrılıp, güne başlamadan önce eve gidip üstümü değiştirip duş alıyorum."

