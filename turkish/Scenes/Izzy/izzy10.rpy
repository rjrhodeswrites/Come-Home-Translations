    # voice 'voices/izzy_10_9.mp3'
    voice 'voices/izzy_10_9.mp3'

# game/Scenes/Izzy/izzy10.rpy:51
translate turkish izzy10_511de65f:

    # gl "I gotta go. Talk to you later, hopefully."
    gl "Gitmem lazım. Umarım sonra konuşuruz."

# game/Scenes/Izzy/izzy10.rpy:52
translate turkish izzy10_c363031d:

    # pc "Okay. Bye, Izzy."
    pc "Tamam. Hoşça kal, Izzy."

# game/Scenes/Izzy/izzy10.rpy:56
translate turkish izzy10_d0995620:

    # "I pull back out onto the streets and start driving over towards Izzy's house."
    "Tekrar sokağa çıkıp Izzy’nin evine doğru sürmeye başlıyorum."

# game/Scenes/Izzy/izzy10.rpy:57
translate turkish izzy10_541c797d:

    # "Izzy in jail. Man, that sucks. I wonder if I'll ever even see her again?"
    "Izzy hapiste. Vay be, bu çok kötü. Acaba onu bir daha görebilecek miyim?"

# game/Scenes/Izzy/izzy10.rpy:60
translate turkish izzy10_0161d2d8:

    # "At her house, I find the door unlocked. I open it and walk inside."
    "Evine vardığımda kapının kilitli olmadığını görüyorum. Kapıyı açıp içeri giriyorum."

# game/Scenes/Izzy/izzy10.rpy:61
translate turkish izzy10_0d5bc151:

    # pc "Hello? Anybody home?"
    pc "Merhaba? Evde kimse var mı?"

# game/Scenes/Izzy/izzy10.rpy:62
translate turkish izzy10_735aa81f:

    # "I can hear the television playing in the living room."
    "Oturma odasından televizyon sesi geliyor."

# game/Scenes/Izzy/izzy10.rpy:65
translate turkish izzy10_48d7389b:

    # "Then two boys who must be Izzy's little brothers rush out."
    "Sonra Izzy’nin küçük kardeşleri olması gereken iki çocuk dışarı fırlıyor."

# game/Scenes/Izzy/izzy10.rpy:66
translate turkish izzy10_c3511125:

    # "Older Boy" "Who are you? You better get out of our house!"
    "Older Boy" "Kimsin sen? Evimizden çıkman iyi olur!"

# game/Scenes/Izzy/izzy10.rpy:67
translate turkish izzy10_a66a8306:

    # pc "Woah, calm down. I'm one of Izzy's friends. She's going to be uh... late."
    pc "Vay canına, sakin olun. Ben Izzy’nin arkadaşlarından biriyim. O, şey... geç kalacak."

# game/Scenes/Izzy/izzy10.rpy:68
translate turkish izzy10_807e3ac4:

    # pc "Your auntie is supposed to be coming, but Izzy wanted me to come sit with you until she gets here."
    pc "Teyzeniz gelecekti ama Izzy, o gelene kadar sizinle oturmamı istedi."

# game/Scenes/Izzy/izzy10.rpy:71
translate turkish izzy10_1d52908f:

    # "Younger Boy" "Izzy? Who's that?"
    "Younger Boy" "Izzy mi? O kim?"

# game/Scenes/Izzy/izzy10.rpy:72
translate turkish izzy10_ecf25c52:

    # "Older Boy" "That's sis, dummy. That's what her friends call her."
    "Older Boy" "O “sis”, aptal. Arkadaşları ona öyle diyor."

# game/Scenes/Izzy/izzy10.rpy:73
translate turkish izzy10_9e4c4b50:

    # "Younger Boy" "Oh yeah!"
    "Younger Boy" "Ah evet!"

# game/Scenes/Izzy/izzy10.rpy:74
translate turkish izzy10_380c7fa4:

    # "Older Boy" "Okay, you can come sit and watch TV with us, but if you try anything, we'll bust you."
    "Older Boy" "Tamam, gelip bizimle oturup televizyon izleyebilirsin, ama bir şey yapmaya kalkışırsan, seni yakalarız."

# game/Scenes/Izzy/izzy10.rpy:75
translate turkish izzy10_94570d10:

    # pc "All right then."
    pc "Peki o zaman."

# game/Scenes/Izzy/izzy10.rpy:78
translate turkish izzy10_be6441de:

    # "I go in and sit on the couch, while they sit on the floor in front of the coffee table, doing homework and watching cartoons on the television."
    "İçeri girip kanepeye oturuyorum, onlar ise sehpanın önündeki yerde oturmuş, ödevlerini yapıyor ve televizyonda çizgi film izliyorlar."

# game/Scenes/Izzy/izzy10.rpy:79
translate turkish izzy10_98c4afdf:

    # "After sitting for a couple minutes in awkward silence, the older boy turns towards me."
    "Birkaç dakika garip bir sessizlik içinde oturduktan sonra, büyük olan çocuk bana dönüyor."

# game/Scenes/Izzy/izzy10.rpy:82
translate turkish izzy10_b0063ead:

    # "Older Boy" "What's your name?"
    "Older Boy" "Adın ne?"

# game/Scenes/Izzy/izzy10.rpy:83
translate turkish izzy10_784c18d8:

    # pc "[pcname]. What's yours?"
    pc "[pcname]. Seninki ne?"

# game/Scenes/Izzy/izzy10.rpy:84
translate turkish izzy10_ceb1abab:

    # "Older Boy" "I'm Paul. My brother is Stanley."
    "Older Boy" "Ben Paul. Kardeşim Stanley."

# game/Scenes/Izzy/izzy10.rpy:85
translate turkish izzy10_70696046:

    # pc "Nice to meet you both."
    pc "İkinizle de tanıştığıma memnun oldum."

# game/Scenes/Izzy/izzy10.rpy:86
translate turkish izzy10_3a7290ac:

    # "Paul" "So, are you one of her boyfriends?"
    "Paul" "Peki, sen onun erkek arkadaşlarından biri misin?"

# game/Scenes/Izzy/izzy10.rpy:87
translate turkish izzy10_2d34af9e:

    # "Paul" "Sis has lots of boyfriends, but she usually doesn't let us meet them."
    "Paul" "Ablamın bir sürü erkek arkadaşı var, ama genellikle onlarla tanışmamıza izin vermez."

# game/Scenes/Izzy/izzy10.rpy:88
translate turkish izzy10_fc1855ec:

    # pc "Yeah, I guess I am. We're friends."
    pc "Evet, sanırım öyleyim. Arkadaşız."

# game/Scenes/Izzy/izzy10.rpy:89
translate turkish izzy10_0b6b2f16:

    # "Stanley" "Where is she? Why isn't she at home?"
    "Stanley" "O nerede? Neden evde değil?"

# game/Scenes/Izzy/izzy10.rpy:92
translate turkish izzy10_e562930a:

    # pc "Well, the police arrested her. She might be going to jail."
    pc "Şey, polis onu tutukladı. Hapse girebilir."

# game/Scenes/Izzy/izzy10.rpy:93
translate turkish izzy10_9d4dc068:

    # "Paul" "Oh. Like mom."
    "Paul" "Oh. Annem gibi."

# game/Scenes/Izzy/izzy10.rpy:94
translate turkish izzy10_363102ed:

    # "Stanley" "So we'll never see her again?"
    "Stanley" "Yani onu bir daha asla göremeyecek miyiz?"

# game/Scenes/Izzy/izzy10.rpy:95
translate turkish izzy10_05948c06:

    # "Paul" "Right."
    "Paul" "Evet."

# game/Scenes/Izzy/izzy10.rpy:96
translate turkish izzy10_db875c8c:

    # pc "I wouldn't say that. We'll just have to wait to see what happens."
    pc "Ben öyle demezdim. Ne olacağını görmek için beklememiz gerekecek."

# game/Scenes/Izzy/izzy10.rpy:97
translate turkish izzy10_f0cc05be:

    # "Paul" "Yeah, okay."
    "Paul" "Evet, tamam."

# game/Scenes/Izzy/izzy10.rpy:98
translate turkish izzy10_9054da2b:

    # "Stanley" "I don't want sis to go to jail."
    "Stanley" "Ablamın hapse girmesini istemiyorum."

# game/Scenes/Izzy/izzy10.rpy:100
translate turkish izzy10_8c26bb19:

    # pc "She just got busy with something, but she'll be home soon."
    pc "Sadece bir şeyle meşgul oldu, ama yakında eve dönecek."

# game/Scenes/Izzy/izzy10.rpy:101
translate turkish izzy10_aed5f95e:

    # "Paul" "Really? She's always here when we get off the bus. What'd she get busy with?"
    "Paul" "Gerçekten mi? Otobüsten indiğimizde hep burada olurdu. Neyle meşgul oldu ki?"

# game/Scenes/Izzy/izzy10.rpy:102
translate turkish izzy10_0d6ab269:

    # pc "Just some stuff she had to do."
    pc "Sadece yapması gereken bazı işler vardı."

# game/Scenes/Izzy/izzy10.rpy:103
translate turkish izzy10_f0cc05be_1:

    # "Paul" "Yeah, okay."
    "Paul" "Evet, tamam."

# game/Scenes/Izzy/izzy10.rpy:104
translate turkish izzy10_5c971f07:

    # "We go back to awkward silence for a few more minutes."
    "Birkaç dakika daha garip bir sessizlik hakim oluyor."

# game/Scenes/Izzy/izzy10.rpy:107
translate turkish izzy10_d9654c38:

    # "Stanley" "Do you know how to do your multiplication tables?"
    "Stanley" "Çarpım tablosunu biliyor musun?"

# game/Scenes/Izzy/izzy10.rpy:108
translate turkish izzy10_c0dfc38d:

    # pc "Uh, yeah I do."
    pc "Ee, evet biliyorum."

# game/Scenes/Izzy/izzy10.rpy:109
translate turkish izzy10_5a2c5982:

    # "Stanley" "Could you help me with my homework then? I don't understand this stuff."
    "Stanley" "O zaman ödevime yardım eder misin? Bu konuyu anlamıyorum."

# game/Scenes/Izzy/izzy10.rpy:110
translate turkish izzy10_e85ea253:

    # pc "Sure, let me see what you have there."
    pc "Tabii, bakalım neyin var."

# game/Scenes/Izzy/izzy10.rpy:113
translate turkish izzy10_b17956ae:

    # "Stanley gets up and sits on the couch next to me, putting his worksheet and book on his lap to show me."
    "Stanley ayağa kalkıp yanıma kanepeye oturuyor, bana göstermek için çalışma kağıdını ve kitabını kucağına koyuyor."

# game/Scenes/Izzy/izzy10.rpy:114
translate turkish izzy10_b975883b:

    # "Stanley" "I know that 8 plus 6 is 14. But this says that 8 times 6 is 48. How the heck does that work?"
    "Stanley" "8 artı 6'nın 14 olduğunu biliyorum. Ama burada 8 çarpı 6'nın 48 olduğu yazıyor. Bu nasıl oluyor ki?"

# game/Scenes/Izzy/izzy10.rpy:115
translate turkish izzy10_329fcf1a:

    # pc "So you know how to do addition? 8 plus 8?"
    pc "Yani toplama yapmayı biliyorsun, değil mi? 8 artı 8?"

# game/Scenes/Izzy/izzy10.rpy:116
translate turkish izzy10_04dda5a7:

    # "Stanley" "Yeah."
    "Stanley" "Evet."

# game/Scenes/Izzy/izzy10.rpy:117
translate turkish izzy10_1c11dbdd:

    # pc "Well think of multiplication like you're doing addition over and over again."
    pc "Peki, çarpımı, toplama işlemini tekrar tekrar yapıyormuş gibi düşün."

# game/Scenes/Izzy/izzy10.rpy:118
translate turkish izzy10_b949eaf3:

    # pc "Here, write 8 six times on your paper. Eight six times is eight times six."
    pc "Hadi, kağıdına 8'i altı kez yaz. Sekiz altı kez, sekiz çarpı altıdır."

# game/Scenes/Izzy/izzy10.rpy:119
translate turkish izzy10_b115a24b:

    # "Stanley" "Oh, I get it."
    "Stanley" "Ah, anladım."

# game/Scenes/Izzy/izzy10.rpy:120
translate turkish izzy10_8b68d233:

    # pc "Then put a plus between each of those 8's and add them all together."
    pc "Sonra o 8'lerin arasına artı işareti koy ve hepsini topla."

# game/Scenes/Izzy/izzy10.rpy:121
translate turkish izzy10_e6a0ee82:

    # "He starts adding, writing the number above each of the eights on his page until he reaches the last one that is 48."
    "Çocuk toplama işlemine başlar ve kağıdındaki her 8'in üzerine bir sayı yazarak sonuncuya, yani 48'e ulaşana kadar devam eder."

# game/Scenes/Izzy/izzy10.rpy:122
translate turkish izzy10_7d468f4d:

    # "Stanley" "I get it! Wow, you should be a teacher."
    "Stanley" "Anladım! Vay canına, sen öğretmen olmalısın."

# game/Scenes/Izzy/izzy10.rpy:125
translate turkish izzy10_d3d886b1:

    # "I hear the front door open and a woman's voice calls out."
    "Ön kapının açıldığını duyarım ve bir kadın sesi seslenir."

# game/Scenes/Izzy/izzy10.rpy:126
translate turkish izzy10_e6d98dc8:

    # "Woman" "Boys? Y'all in here?"
    "Woman" "Çocuklar? Hepiniz burada mısınız?"

# game/Scenes/Izzy/izzy10.rpy:129
translate turkish izzy10_e3c838b3:

    # "The woman, who must be the boy's auntie, walks around the corner and both of them rush up to hug her."
    "Çocuğun teyzesi olması gereken kadın köşeyi döner ve ikisi de ona sarılmak için koşarlar."

# game/Scenes/Izzy/izzy10.rpy:130
translate turkish izzy10_ec0adf9c:

    # "Auntie" "Everything okay here?"
    "Auntie" "Her şey yolunda mı?"

# game/Scenes/Izzy/izzy10.rpy:131
translate turkish izzy10_5e4c7b42:

    # "Paul" "Yeah, we're all good."
    "Paul" "Evet, hepimiz iyiyiz."

# game/Scenes/Izzy/izzy10.rpy:132
translate turkish izzy10_60d1cbf2:

    # "Stanley" "[pcname] was teaching me how to do my times table."
    "Stanley" "[pcname] bana çarpım tablosunu nasıl yapacağımı öğretiyordu."

# game/Scenes/Izzy/izzy10.rpy:133
translate turkish izzy10_ad65d7e3:

    # "Auntie" "That's nice of him."
    "Auntie" "Ne kadar nazik."

# game/Scenes/Izzy/izzy10.rpy:134
translate turkish izzy10_31976fc3:

    # "Auntie" "You two go to your room and pack up some clothes. You're going to come stay at my house for a few days, okay?"
    "Auntie" "Siz ikiniz odanıza gidip biraz giysi toplayın. Birkaç günlüğüne benim evimde kalacaksınız, tamam mı?"

# game/Scenes/Izzy/izzy10.rpy:135
translate turkish izzy10_32e2b2bb:

    # "Paul" "Is sis okay?"
    "Paul" "Ablam iyi mi?"

# game/Scenes/Izzy/izzy10.rpy:136
translate turkish izzy10_d6e45f9a:

    # "Auntie" "She's okay, but she's going to be gone for a bit."
    "Auntie" "O iyi, ama bir süreliğine yok olacak."

# game/Scenes/Izzy/izzy10.rpy:137
translate turkish izzy10_e67935e5:

    # "Stanley" "How long?"
    "Stanley" "Ne kadar süre?"

# game/Scenes/Izzy/izzy10.rpy:138
translate turkish izzy10_1f41c1ac:

    # "Auntie" "I don't know yet honey. Go pack your bags, okay?"
    "Auntie" "Henüz bilmiyorum tatlım. Gidip çantalarınızı toplayın, tamam mı?"

# game/Scenes/Izzy/izzy10.rpy:141
translate turkish izzy10_3581e151:

    # "The two boys run off towards their rooms, and I stand up to talk to their auntie."
    "İki çocuk odalarına doğru koşarlar ve ben de kalkıp teyzeleriyle konuşurum."

# game/Scenes/Izzy/izzy10.rpy:142
translate turkish izzy10_f78cee83:

    # "Auntie" "Thanks for coming over and sitting with them for a bit."
    "Auntie" "Gelip bir süre onlarla ilgilendiğin için teşekkürler."

# game/Scenes/Izzy/izzy10.rpy:143
translate turkish izzy10_5301b871:

    # pc "Oh, no problem. They seem like good kids."
    pc "Oh, sorun değil. İyi çocuklara benziyorlar."

# game/Scenes/Izzy/izzy10.rpy:144
translate turkish izzy10_bd9c1d85:

    # "Auntie" "They are. I wish they didn't have to go through all this. First their mom, now their sister."
    "Auntie" "Öyleler. Keşke tüm bunları yaşamak zorunda kalmasalardı. Önce anneleri, şimdi de kız kardeşleri."

# game/Scenes/Izzy/izzy10.rpy:145
translate turkish izzy10_8a42d1af:

    # pc "Is she going to be okay?"
    pc "İyileşecek mi?"

# game/Scenes/Izzy/izzy10.rpy:146
translate turkish izzy10_74736fd1:

    # "Auntie" "She had a lot of drugs on her when they arrested her and that other boy. She has a couple of priors as well. It doesn't look good."
    "Auntie" "Onu ve diğer çocuğu tutukladıklarında üzerinde çok fazla uyuşturucu bulunmuştu. Birkaç sabıkası da var. Durum pek iyi görünmüyor."

# game/Scenes/Izzy/izzy10.rpy:147
translate turkish izzy10_139f3015:

    # "Auntie" "I've been trying to get her to drop the drugs for a long time."
    "Auntie" "Uzun zamandır uyuşturucuyu bırakması için onu ikna etmeye çalışıyordum."

# game/Scenes/Izzy/izzy10.rpy:148
translate turkish izzy10_5e1c08a1:

    # "Auntie" "But it's hard to take care of two kids with a minimum wage job. Isabel didn't ask for any of this either."
    "Auntie" "Ama asgari ücretle iki çocuğa bakmak zor. Isabel de bunların hiçbirini istemiş değildi."

# game/Scenes/Izzy/izzy10.rpy:149
translate turkish izzy10_847af3a0:

    # "Auntie" "I don't know how {i}I'm{/i} even going to take care of these boys."
    "Auntie" "Bu çocuklara nasıl {i}bakacağım{/i} bile bilmiyorum."

# game/Scenes/Izzy/izzy10.rpy:150
translate turkish izzy10_45975e4c:

    # "Auntie" "But, I'll figure it out. Got no other choice."
    "Auntie" "Ama bir yolunu bulacağım. Başka seçeneğim yok."

# game/Scenes/Izzy/izzy10.rpy:151
translate turkish izzy10_527206cb:

    # "Auntie" "Anyways, thanks again. I'll take it from here."
    "Auntie" "Neyse, yine de teşekkürler. Gerisini ben hallederim."

# game/Scenes/Izzy/izzy10.rpy:154
translate turkish izzy10_47574532:

    # "She walks me towards the front door, but before I leave, Paul and Stanley come back out."
    "Beni ön kapıya kadar geçiriyor, ama ben çıkmadan önce Paul ve Stanley tekrar dışarı çıkıyor."

# game/Scenes/Izzy/izzy10.rpy:155
translate turkish izzy10_82761cf4:

    # "Stanley" "Bye, [pcname]! Thanks for helping me with my math."
    "Stanley" "Hoşça kalın, [pcname]! Matematikte bana yardım ettiğiniz için teşekkürler."

# game/Scenes/Izzy/izzy10.rpy:156
translate turkish izzy10_0438055e:

    # pc "Bye, you two. Be good. Keep studying."
    pc "Hoşça kalın, siz ikiniz. Uslu durun. Derslerinize devam edin."

# game/Scenes/Izzy/izzy10.rpy:160
translate turkish izzy10_85086dcf:

    # "I walk out, get into my car, and drive away."
    "Dışarı çıkıyorum, arabama biniyorum ve uzaklaşıyorum."

# game/Scenes/Izzy/izzy10.rpy:161
translate turkish izzy10_70ed6fb0:

    # "Damn, I hope Izzy will be okay. Those boys too. This whole situation just sucks."
    "Kahretsin, umarım Izzy iyi olur. O çocuklar da. Bu durum tam bir felaket."

