# game/Scenes/Update20/u20h.rpy:2
translate turkish u20h_5aee407c:

    # "For now, I should go see Izzy."
    "Şimdilik Izzy’yi görmeye gitmeliyim."

# game/Scenes/Update20/u20h.rpy:5
translate turkish u20h_72a90d54:

    # "I drive over to Izzy's house and knock on her door."
    "Izzy’nin evine arabayla gidip kapısını çalıyorum."

# game/Scenes/Update20/u20h.rpy:6
translate turkish u20h_a6bc8933:

    # "It's late, but she might still be awake. I need to see her."
    "Saat geç oldu ama hâlâ uyanık olabilir. Onu görmem lazım."

# game/Scenes/Update20/u20h.rpy:10
translate turkish u20h_9342f0d4:

    # "Izzy opens the door, her eyes wide with surprise and filling with tears."
    "Izzy kapıyı açıyor, gözleri şaşkınlıktan kocaman açılmış ve yaşlarla doluyor."

# game/Scenes/Update20/u20h.rpy:11
translate turkish u20h_01dbc2b7:

    # gl "Holy shit, [pcname]!"
    gl "Vay canına, [pcname]!"

# game/Scenes/Update20/u20h.rpy:14
translate turkish u20h_840b6638:

    # gl "Damn, I thought that machine killed you, Twig."
    gl "Kahretsin, o makine seni öldürdü sanmıştım, Twig."

# game/Scenes/Update20/u20h.rpy:15
translate turkish u20h_404faba8:

    # gl "I missed you so damn much."
    gl "Seni çok özledim."

# game/Scenes/Update20/u20h.rpy:18
translate turkish u20h_d9c0289b:

    # gl "What happened? Did you see your dad?"
    gl "Ne oldu? Babanı gördün mü?"

# game/Scenes/Update20/u20h.rpy:19
translate turkish u20h_0118c310:

    # pc "Yeah, I did. I'll tell you all about it tomorrow."
    pc "Evet, gördüm. Yarın sana her şeyi anlatacağım."

# game/Scenes/Update20/u20h.rpy:22
translate turkish u20h_9051c62e:

    # gl "Alright then. I'm just glad you're back."
    gl "Tamam o zaman. Geri döndüğüne sevindim."

# game/Scenes/Update20/u20h.rpy:23
translate turkish u20h_bd739f39:

    # gl "But your hair... damn. You gotta cut that shit."
    gl "Ama saçın... vay be. O saçları kesmen lazım."

# game/Scenes/Update20/u20h.rpy:24
translate turkish u20h_e7bdc60a:

    # pc "Yeah, yeah, I know."
    pc "Evet, evet, biliyorum."

# game/Scenes/Update20/u20h.rpy:27
translate turkish u20h_0f040bf1:

    # gl "Come on, let's go to my room."
    gl "Hadi, odama gidelim."

# game/Scenes/Update20/u20h.rpy:28
translate turkish u20h_e0cc24b1:

    # gl "We gotta be quiet, because the boys are here, but I'm gonna get me some of that dick tonight."
    gl "Sessiz olmalıyız, çünkü çocuklar burada, ama bu gece o aletlerden biraz alacağım."

