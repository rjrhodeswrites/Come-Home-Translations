translate turkish michaending_3082a2c7:

    # mc "But we should focus on tonight, yes?"
    mc "Ama bu geceye odaklanmalıyız, değil mi?"

# game/Scenes/Update20/michaending.rpy:202
translate turkish michaending_0a5db754:

    # mc "I will make you feel good again."
    mc "Seni tekrar mutlu edeceğim."

# game/Scenes/Update20/michaending.rpy:205
translate turkish michaending_bcc18862:

    # "As Mi-Cha swallows my cock, I'm still thinking about what our future could be like."
    "Mi-Cha benim aletimi yutarken, ben hâlâ geleceğimizin nasıl olabileceğini düşünüyorum."

# game/Scenes/Update20/michaending.rpy:208
translate turkish michaending_5b5383b1:

    # "I imagine all of our kids. Watching them grow up."
    "Bütün çocuklarımızı hayal ediyorum. Onların büyümesini izliyorum."

# game/Scenes/Update20/michaending.rpy:211
translate turkish michaending_46b4f0cc:

    # "We'll support each other."
    "Birbirimize destek olacağız."

# game/Scenes/Update20/michaending.rpy:214
translate turkish michaending_cc7252ca:

    # "We'll always make each other feel good."
    "Birbirimizi her zaman mutlu edeceğiz."

# game/Scenes/Update20/michaending.rpy:217
translate turkish michaending_1925fb08:

    # "A happy family."
    "Mutlu bir aile."

# game/Scenes/Update20/michaending.rpy:220
translate turkish michaending_55182322:

    # "A life of love."
    "Sevgi dolu bir hayat."

# game/Scenes/Update20/michaending.rpy:223
translate turkish michaending_b97a871d:

    # "What more could a person ask for?"
    "Bir insan daha ne isteyebilir ki?"

