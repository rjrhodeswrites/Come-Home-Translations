# game/Scenes/Update20/u20p.rpy:3
translate turkish u20p_1b7a0d04:

    # "For now, I should go see Mi-Cha."
    "Şimdilik Mi-Cha’yı görmeye gitmeliyim."

# game/Scenes/Update20/u20p.rpy:6
translate turkish u20p_6c85aa97:

    # "I drive over to Mi-Cha's dorm and knock on her door, trying to be quiet so I don't wake up anyone else."
    "Mi-Cha’nın yurduna arabayla gidip kapısını çalıyorum, başkalarını uyandırmamak için sessiz olmaya çalışıyorum."

# game/Scenes/Update20/u20p.rpy:10
translate turkish u20p_a016dbb5:

    # "After a few moments, Mi-Cha opens the door."
    "Birkaç saniye sonra Mi-Cha kapıyı açıyor."

# game/Scenes/Update20/u20p.rpy:11
translate turkish u20p_78132b1d:

    # mc "[pcname]! Oh my God, it's you!"
    mc "[pcname]! Aman Tanrım, sensin!"

# game/Scenes/Update20/u20p.rpy:14
translate turkish u20p_29857b39:

    # "She practically leaps into my arms, wrapping me in a tight embrace."
    "Neredeyse kollarıma atlayarak beni sıkıca kucaklıyor."

# game/Scenes/Update20/u20p.rpy:15
translate turkish u20p_daf29bbf:

    # mc "I missed you so much!"
    mc "Seni çok özledim!"

# game/Scenes/Update20/u20p.rpy:16
translate turkish u20p_48732134:

    # pc "I missed you too, Mi-Cha."
    pc "Ben de seni özledim, Mi-Cha."

# game/Scenes/Update20/u20p.rpy:19
translate turkish u20p_6c2a8295:

    # mc "What happened? Did the thing you were trying to do work?"
    mc "Ne oldu? Yapmaya çalıştığın şey işe yaradı mı?"

# game/Scenes/Update20/u20p.rpy:20
translate turkish u20p_f4fa6482:

    # pc "Yes it did. I didn't mean to be gone so long, but it worked."
    pc "Evet, yaradı. Bu kadar uzun süre uzak kalmak istememiştim, ama işe yaradı."

# game/Scenes/Update20/u20p.rpy:21
translate turkish u20p_48ae30e6:

    # pc "I'll tell you all about it tomorrow."
    pc "Yarın sana her şeyi anlatacağım."

# game/Scenes/Update20/u20p.rpy:22
translate turkish u20p_556bcc63:

    # mc "But you are here now? You won't leave me again?"
    mc "Ama şimdi buradasın, değil mi? Beni bir daha terk etmeyeceksin, değil mi?"

# game/Scenes/Update20/u20p.rpy:23
translate turkish u20p_39bfeeda:

    # pc "No, I'm not going anywhere."
    pc "Hayır, hiçbir yere gitmiyorum."

# game/Scenes/Update20/u20p.rpy:26
translate turkish u20p_8253f92f:

    # mc "I am so glad you came home."
    mc "Eve geldiğine çok sevindim."

# game/Scenes/Update20/u20p.rpy:27
translate turkish u20p_6d3a55c4:

    # mc "I didn't know what to do without you."
    mc "Sensiz ne yapacağımı bilemedim."

# game/Scenes/Update20/u20p.rpy:30
translate turkish u20p_b55a59c5:

    # "She leans in and kisses me softly."
    "Bana doğru eğilip nazikçe öpüyor."

# game/Scenes/Update20/u20p.rpy:31
translate turkish u20p_d17bdb85:

    # mc "I love you so much."
    mc "Seni çok seviyorum."

# game/Scenes/Update20/u20p.rpy:32
translate turkish u20p_5735beae:

    # pc "I love you too, Mi-Cha."
    pc "Ben de seni seviyorum, Mi-Cha."

