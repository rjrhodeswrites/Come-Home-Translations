# game/Scenes/Update20/u20d.rpy:2
translate turkish u20d_57a32b89:

    # "For now, I should go see Jamie."
    "Şimdilik Jamie’yi görmeye gitsem iyi olacak."

# game/Scenes/Update20/u20d.rpy:5
translate turkish u20d_09cc067a:

    # "I drive home, then walk over to Jamie's house, and ring the doorbell."
    "Arabayla eve gidip, sonra Jamie’nin evine yürüyerek gidip zili çalıyorum."

# game/Scenes/Update20/u20d.rpy:6
translate turkish u20d_5240dedf:

    # "It's late and I hate to wake them, but I need to see her."
    "Saat geç oldu ve onları uyandırmak istemiyorum ama onu görmem lazım."

# game/Scenes/Update20/u20d.rpy:9
translate turkish u20d_65a45c72:

    # jd "[pcname]?"
    jd "[pcname]?"

# game/Scenes/Update20/u20d.rpy:10
translate turkish u20d_4297141b:

    # jd "What the hell happened to you, son?"
    jd "Sana ne oldu böyle, evlat?"

# game/Scenes/Update20/u20d.rpy:11
translate turkish u20d_606da365:

    # jd "I thought you took off again. Jamie's been upset for weeks."
    jd "Yine gittiğini sanmıştım. Jamie haftalardır üzgün."

# game/Scenes/Update20/u20d.rpy:12
translate turkish u20d_61c5bb7a:

    # pc "I'm sorry. I didn't mean to leave for so long. I've been trying to get back."
    pc "Özür dilerim. Bu kadar uzun süre uzak kalmak istememiştim. Geri dönmeye çalışıyordum."

# game/Scenes/Update20/u20d.rpy:15
translate turkish u20d_ad0c6ecb:

    # jd "She's going to be happy to see you."
    jd "Seni görünce çok sevinecek."

# game/Scenes/Update20/u20d.rpy:16
translate turkish u20d_a1205e82:

    # jd "Why don't you just go up and see her?"
    jd "Neden yukarı çıkıp ona bir bakmıyorsun?"

# game/Scenes/Update20/u20d.rpy:17
translate turkish u20d_02b70148:

    # pc "Thanks, Rich."
    pc "Teşekkürler, Rich."

# game/Scenes/Update20/u20d.rpy:18
translate turkish u20d_f246a5a7:

    # jd "Nice beard by the way."
    jd "Bu arada sakalın güzel olmuş."

# game/Scenes/Update20/u20d.rpy:22
translate turkish u20d_e2bc298b:

    # "I walk quietly up the stairs and into Jamie's room. She's in bed, sleeping."
    "Sessizce merdivenleri çıkıp Jamie’nin odasına giriyorum. Yatakta uyuyor."

# game/Scenes/Update20/u20d.rpy:25
translate turkish u20d_a95bfc0c:

    # "Trying not to wake her immediately, I lie next to her and wrap her in my arms."
    "Onu hemen uyandırmamaya çalışarak yanına uzanıp kollarımla sarılıyorum."

# game/Scenes/Update20/u20d.rpy:28
translate turkish u20d_c981bd85:

    # "She jolts awake and looks at me, shocked."
    "Birden uyanıyor ve şaşkın bir şekilde bana bakıyor."

# game/Scenes/Update20/u20d.rpy:29
translate turkish u20d_95496a48:

    # gnd "[pcname]? Is it really you?"
    gnd "[pcname]? Gerçekten sen misin?"

# game/Scenes/Update20/u20d.rpy:32
translate turkish u20d_0f0952fe:

    # "I don't answer. I just pull her close and kiss her deeply."
    "Cevap vermiyorum. Sadece onu kendime çekip derin bir öpücük veriyorum."

# game/Scenes/Update20/u20d.rpy:33
translate turkish u20d_3375c7eb:

    # gnd "I thought I lost you! I've been so worried."
    gnd "Seni kaybettiğimi sanmıştım! Çok endişelendim."

# game/Scenes/Update20/u20d.rpy:36
translate turkish u20d_de1105f0:

    # gnd "So all of that stuff was true? You really saw your dad?"
    gnd "Yani tüm o hikayeler doğruydu mu? Babana gerçekten mi gördün?"

# game/Scenes/Update20/u20d.rpy:37
translate turkish u20d_2a9e9f2b:

    # pc "Yeah, I did. It's all true. I'll tell you about it tomorrow."
    pc "Evet, gördüm. Hepsi doğru. Yarın sana anlatırım."

# game/Scenes/Update20/u20d.rpy:40
translate turkish u20d_34ae9f69:

    # gnd "I'm just glad you're back."
    gnd "Geri döndüğüne çok sevindim."

# game/Scenes/Update20/u20d.rpy:41
translate turkish u20d_25f299a8:

    # gnd "That hair looks awful though."
    gnd "Ama saçların berbat görünüyor."

# game/Scenes/Update20/u20d.rpy:44
translate turkish u20d_f432b969:

    # "I pull her close and kiss her again, feeling her warmth."
    "Onu kendime çekip tekrar öpüyorum, sıcaklığını hissediyorum."

# game/Scenes/Update20/u20d.rpy:45
translate turkish u20d_137d3396:

    # gnd "I missed you so much, [pcname]."
    gnd "Seni çok özledim, [pcname]."

# game/Scenes/Update20/u20d.rpy:46
translate turkish u20d_12a0fbc0:

    # pc "I missed you too, Jamie."
    pc "Ben de seni özledim, Jamie."

