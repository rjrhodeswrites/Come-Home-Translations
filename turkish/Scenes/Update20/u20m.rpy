# TODO: Translation updated at 2026-08-03 12:42

# game/Scenes/Update20/u20m.rpy:4
translate turkish u20m_709aec61:

    # "For now, I should go see Reba."
    "Şimdilik Reba'yı görmeye gitsem iyi olacak."

# game/Scenes/Update20/u20m.rpy:7
translate turkish u20m_151617f4:

    # "I drive out to Reba's house and knock on her door."
    "Reba'nın evine arabayla gidip kapısını çalıyorum."

# game/Scenes/Update20/u20m.rpy:8
translate turkish u20m_349819fa:

    # "I haven't been out here since Mickey was arrested. I hope I'm not about to get shot."
    "Mickey tutuklandığından beri buraya gelmemiştim. Umarım vurulmayacağım."

# game/Scenes/Update20/u20m.rpy:11
translate turkish u20m_da38ceda:

    # "Reba's mom opens the door, looking at me in disgust."
    "Reba’nın annesi kapıyı açıyor ve bana tiksintiyle bakıyor."

# game/Scenes/Update20/u20m.rpy:12
translate turkish u20m_02882bbf:

    # "Reba's Mom" "You're that college boy that's been hanging around with Reba, ain't ya?"
    "Reba's Mom" "Sen Reba’yla takılan o üniversiteli çocuksun, değil mi?"

# game/Scenes/Update20/u20m.rpy:13
translate turkish u20m_318f6e59:

    # pc "That's right. Is she home?"
    pc "Evet, doğru. O evde mi?"

# game/Scenes/Update20/u20m.rpy:16
translate turkish u20m_6b95907a:

    # "Reba's Mom" "What happened with you? She's been all mopey and upset but won't tell me why."
    "Reba's Mom" "Ne oldu sana? Son zamanlarda çok hüzünlü ve üzgün ama nedenini bana söylemiyor."

# game/Scenes/Update20/u20m.rpy:17
translate turkish u20m_e6064c5d:

    # pc "It's... complicated. Can you tell her I'm here?"
    pc "Bu... biraz karmaşık. Ona burada olduğumu söyler misin?"

# game/Scenes/Update20/u20m.rpy:18
translate turkish u20m_8eb00b2c:

    # "Reba's Mom" "Just don't make her sad, okay? She seems happier after she's been with you."
    "Reba's Mom" "Onu üzme, tamam mı? Seninle birlikte olduktan sonra daha mutlu görünüyor."

# game/Scenes/Update20/u20m.rpy:21
translate turkish u20m_742064d6:

    # "Reba's Mom" "I like to see her happy."
    "Reba's Mom" "Onu mutlu görmek hoşuma gidiyor."

# game/Scenes/Update20/u20m.rpy:22
translate turkish u20m_6080bf31:

    # "Reba's Mom" "Alright, you can come in. She's asleep in her room."
    "Reba's Mom" "Tamam, girebilirsin. Odasında uyuyor."

# game/Scenes/Update20/u20m.rpy:23
translate turkish u20m_0558b8ab:

    # "Reba's Mom" "No hanky panky though. Not under my roof."
    "Reba's Mom" "Ama yaramazlık yok. Benim çatımın altında olmaz."

# game/Scenes/Update20/u20m.rpy:24
translate turkish u20m_a9a2d1b9:

    # pc "Thanks."
    pc "Teşekkürler."

# game/Scenes/Update20/u20m.rpy:27
translate turkish u20m_ac62c564:

    # "I walk quietly into Reba's room. She's in bed, sleeping."
    "Sessizce Reba'nın odasına giriyorum. Yatakta uyuyor."

# game/Scenes/Update20/u20m.rpy:30
translate turkish u20m_a95bfc0c:

    # "Trying not to wake her immediately, I lie next to her and wrap her in my arms."
    "Onu hemen uyandırmamaya çalışarak yanına uzanıp kollarımı ona doladım."

# game/Scenes/Update20/u20m.rpy:34
translate turkish u20m_c981bd85:

    # "She jolts awake and looks at me, shocked."
    "Birden irkildi ve şaşkın bir şekilde bana baktı."

# game/Scenes/Update20/u20m.rpy:35
translate turkish u20m_1542905d:

    # rb "What the heck!? [pcname]!? Am I dreamin'?"
    rb "Ne oluyor be!? [pcname]!? Rüya mı görüyorum?"

# game/Scenes/Update20/u20m.rpy:36
translate turkish u20m_a64b83f2:

    # pc "No, I'm real. Hey Reba."
    pc "Hayır, ben gerçeksin. Selam Reba."

# game/Scenes/Update20/u20m.rpy:39
translate turkish u20m_b5e336f8:

    # "She leans in and kisses me deeply, her lips soft and warm against mine."
    "Bana doğru eğildi ve beni derin bir şekilde öptü, dudakları benimkilere değdiğinde yumuşak ve sıcaktı."

# game/Scenes/Update20/u20m.rpy:40
translate turkish u20m_c73e0cd1:

    # rb "Dang, I missed you."
    rb "Vay be, seni özledim."

# game/Scenes/Update20/u20m.rpy:43
translate turkish u20m_a4520e8b:

    # rb "So what the heck happened? Did you see your daddy?"
    rb "Peki ne oldu? Babanı gördün mü?"

# game/Scenes/Update20/u20m.rpy:44
translate turkish u20m_90d868cb:

    # pc "Yeah, everything went like it was supposed to. Mostly."
    pc "Evet, her şey olması gerektiği gibi gitti. Çoğunlukla."

# game/Scenes/Update20/u20m.rpy:45
translate turkish u20m_48ae30e6:

    # pc "I'll tell you all about it tomorrow."
    pc "Yarın sana her şeyi anlatacağım."

# game/Scenes/Update20/u20m.rpy:48
translate turkish u20m_98b63ab5:

    # rb "I'm just glad you're back."
    rb "Geri döndüğüne çok sevindim."

# game/Scenes/Update20/u20m.rpy:49
translate turkish u20m_5964ada9:

    # rb "And your hair is all long now. It looks really bad."
    rb "Saçların da uzamış. Gerçekten çok kötü görünüyor."

# game/Scenes/Update20/u20m.rpy:50
translate turkish u20m_a6d4efd9:

    # rb "I kind of like the beard though."
    rb "Sakalını ise biraz beğendim."

# game/Scenes/Update20/u20m.rpy:53
translate turkish u20m_6ec05860:

    # rb "I missed kissing you and doing it with you."
    rb "Seni öpmeyi ve seninle sevişmeyi özledim."

# game/Scenes/Update20/u20m.rpy:54
translate turkish u20m_7d4be04f:

    # pc "I missed it too, Reba."
    pc "Ben de özledim, Reba."

# game/Scenes/Update20/u20m.rpy:55
translate turkish u20m_65a81a6c:

    # rb "If we was at your house, I'd do it with you right now. But I don't want Mama to hear us."
    rb "Senin evinde olsaydık, şu anda seninle sevişirdim. Ama annemin bizi duymasını istemiyorum."

# game/Scenes/Update20/u20m.rpy:56
translate turkish u20m_f90984e6:

    # pc "Maybe tomorrow."
    pc "Belki yarın."

# game/Scenes/Update20/u20m.rpy:57
translate turkish u20m_6f8fbc94:

    # rb "Definitely."
    rb "Kesinlikle."

