# game/Scenes/Update20/u20n.rpy:2
translate turkish u20n_0157cb27:

    # "For now, I should go see Bai."
    "Şimdilik Bai'yi görmeye gitmeliyim."

# game/Scenes/Update20/u20n.rpy:5
translate turkish u20n_5e377e6b:

    # "I drive to Bai's apartment and knock on the door."
    "Bai'nin dairesine arabayla gidip kapıyı çalıyorum."

# game/Scenes/Update20/u20n.rpy:6
translate turkish u20n_cd826cbc:

    # "It's late, but I have to see him."
    "Saat geç oldu ama onu görmem lazım."

# game/Scenes/Update20/u20n.rpy:10
translate turkish u20n_435415c3:

    # "After a few moments, Bai opens the door."
    "Birkaç saniye sonra Bai kapıyı açıyor."

# game/Scenes/Update20/u20n.rpy:11
translate turkish u20n_fce568f9:

    # bai "Holy shit, [pcname]! You're back!"
    bai "Vay canına, [pcname]! Geri dönmüşsün!"

# game/Scenes/Update20/u20n.rpy:14
translate turkish u20n_7e7c2a33:

    # "I wrap my arms around Bai, pulling him in tight."
    "Kollarımı Bai'nin boynuna dolayarak onu sıkıca kendime çekiyorum."

# game/Scenes/Update20/u20n.rpy:15
translate turkish u20n_e660f3f5:

    # bai "I thought that machine killed you!"
    bai "O makine seni öldürdü sanmıştım!"

# game/Scenes/Update20/u20n.rpy:16
translate turkish u20n_52e92c2d:

    # bai "I thought I might never see you again."
    bai "Seni bir daha asla göremeyeceğim sanmıştım."

# game/Scenes/Update20/u20n.rpy:19
translate turkish u20n_e99c4913:

    # bai "So what happened? Did you really go to another universe?"
    bai "Peki ne oldu? Gerçekten başka bir evrene mi gittin?"

# game/Scenes/Update20/u20n.rpy:20
translate turkish u20n_4859fa2f:

    # pc "Yeah, I did. I saw my dad."
    pc "Evet, gittim. Babamı gördüm."

# game/Scenes/Update20/u20n.rpy:21
translate turkish u20n_d8ec5a44:

    # bai "Wow. Are you okay?"
    bai "Vay canına. İyi misin?"

# game/Scenes/Update20/u20n.rpy:22
translate turkish u20n_3c3fa8e3:

    # pc "Yeah, I'm great. I'll tell you everything tomorrow, I promise."
    pc "Evet, harikayım. Yarın sana her şeyi anlatacağım, söz veriyorum."

# game/Scenes/Update20/u20n.rpy:25
translate turkish u20n_feac206a:

    # bai "I'm just glad you're back."
    bai "Geri döndüğüne çok sevindim."

# game/Scenes/Update20/u20n.rpy:26
translate turkish u20n_03eaad50:

    # pc "Me too."
    pc "Ben de."

# game/Scenes/Update20/u20n.rpy:29
translate turkish u20n_61ae245c:

    # "He leans in and kisses me softly."
    "Bana doğru eğilip beni nazikçe öper."

# game/Scenes/Update20/u20n.rpy:30
translate turkish u20n_8466d1ae:

    # bai "Whoo, damn, you smell pretty bad though."
    bai "Vay canına, ama kokun epey kötü."

# game/Scenes/Update20/u20n.rpy:31
translate turkish u20n_dfccd340:

    # bai "Let's take a shower and go to bed."
    bai "Hadi duş alıp yatalım."

