# game/Scenes/Update20/loserending.rpy:5
translate turkish loser_ending_3c54380b:

    # "I look at the crowd, but nobody is here for me."
    "Kalabalığa bakıyorum, ama kimse benim için burada değil."

# game/Scenes/Update20/loserending.rpy:8
translate turkish loser_ending_e94592cd:

    # "I pick up a pizza, then go home and watch TV alone."
    "Bir pizza alıyorum, sonra eve gidip tek başıma televizyon izliyorum."

# game/Scenes/Update20/loserending.rpy:11
translate turkish loser_ending_833bcf67:

    # "Then I watch some porn on the computer."
    "Sonra bilgisayarda biraz porno izliyorum."

# game/Scenes/Update20/loserending.rpy:14
translate turkish loser_ending_e6e71336:

    # "I lie in bed that night and think about what the future might hold."
    "O gece yatakta uzanıp geleceğin ne getireceğini düşünüyorum."

# game/Scenes/Update20/loserending.rpy:17
translate turkish loser_ending_1b242190:

    # "I'll probably get a job in a lab somewhere."
    "Muhtemelen bir laboratuvarda iş bulacağım."

# game/Scenes/Update20/loserending.rpy:20
translate turkish loser_ending_4d4aa8f2:

    # "Maybe I'll find somebody to love one day."
    "Belki bir gün sevecek birini bulurum."

# game/Scenes/Update20/loserending.rpy:21
translate turkish loser_ending_c3bf8e82:

    # "Maybe not."
    "Belki de bulamayacağım."

# game/Scenes/Update20/loserending.rpy:24
translate turkish loser_ending_9652d4a4:

    # "Maybe I'm too picky and nobody will ever be good enough for me."
    "Belki de çok seçiciyim ve kimse benim için yeterince iyi olmayacak."

# game/Scenes/Update20/loserending.rpy:27
translate turkish loser_ending_ec64b334:

    # "Maybe I'll go back to the other world."
    "Belki de öteki dünyaya geri döneceğim."

# game/Scenes/Update20/loserending.rpy:30
translate turkish loser_ending_e3661b99:

    # "Maybe I'll live there with my mom and dad."
    "Belki de orada annemle babamla birlikte yaşayacağım."

# game/Scenes/Update20/loserending.rpy:33
translate turkish loser_ending_f982e9ec:

    # "Either way, I have to find a way to be happy."
    "Her halükarda, mutlu olmanın bir yolunu bulmalıyım."

# game/Scenes/Update20/loserending.rpy:36
translate turkish loser_ending_b97a871d:

    # "What more could a person ask for?"
    "Bir insan daha ne isteyebilir ki?"

