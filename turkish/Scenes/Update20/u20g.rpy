# game/Scenes/Update20/u20g.rpy:2
translate turkish u20g_fc5b5a95:

    # "For now, I should go see Juliana."
    "Şimdilik Juliana'yı görmeye gitmeliyim."

# game/Scenes/Update20/u20g.rpy:5
translate turkish u20g_2257ecc3:

    # "I drive over to Juliana's house and knock on her door."
    "Juliana'nın evine arabayla gidip kapısını çalıyorum."

# game/Scenes/Update20/u20g.rpy:6
translate turkish u20g_4fc89239:

    # "It's late and I hate to wake her, but I need to see her."
    "Saat geç oldu ve onu uyandırmak istemiyorum ama onu görmem lazım."

# game/Scenes/Update20/u20g.rpy:9
translate turkish u20g_5ac21d19:

    # "Juliana's grandmother comes to the door, looking surprised."
    "Juliana'nın büyükannesi kapıya geliyor, şaşkın görünüyor."

# game/Scenes/Update20/u20g.rpy:10
translate turkish u20g_12baa67b:

    # jg "Oh you're Juliana's friend... I'm sorry, I forgot your name."
    jg "Ah, sen Juliana'nın arkadaşısın... Özür dilerim, adını unuttum."

# game/Scenes/Update20/u20g.rpy:11
translate turkish u20g_529f52b6:

    # pc "It's [pcname]."
    pc "Adım [pcname]."

# game/Scenes/Update20/u20g.rpy:12
translate turkish u20g_0a7b8aae:

    # jg "What happened to your hair, boy? You miss a barber appointment?"
    jg "Saçına ne oldu evlat? Berber randevunu mu kaçırdın?"

# game/Scenes/Update20/u20g.rpy:13
translate turkish u20g_84c963f6:

    # pc "I'm sorry. I know it's late, but can I see Juliana?"
    pc "Üzgünüm. Geç olduğunu biliyorum ama Juliana'yı görebilir miyim?"

# game/Scenes/Update20/u20g.rpy:14
translate turkish u20g_975fcca2:

    # jg "Oh, it's okay. I was up watching Love Island. You know that show?"
    jg "Oh, sorun değil. Love Island izliyordum. O programı biliyor musun?"

# game/Scenes/Update20/u20g.rpy:17
translate turkish u20g_70d520dc:

    # jg "I just love all the drama with sexy people trying to get in each other's pants."
    jg "Seksi insanların birbirleriyle yatmaya çalışırken yaşanan tüm o dramayı çok seviyorum."

# game/Scenes/Update20/u20g.rpy:18
translate turkish u20g_5ab1c947:

    # jg "Anyway, come in. Yeah, you can go up to see Juliana."
    jg "Neyse, içeri gel. Evet, yukarı çıkıp Juliana'yı görebilirsin."

# game/Scenes/Update20/u20g.rpy:19
translate turkish u20g_60d8396d:

    # jg "I'll turn up the volume on the TV, so you two can have some privacy."
    jg "Televizyonun sesini açacağım, böylece ikiniz biraz mahremiyetiniz olsun."

# game/Scenes/Update20/u20g.rpy:20
translate turkish u20g_c6880d17:

    # pc "Thanks!"
    pc "Teşekkürler!"

# game/Scenes/Update20/u20g.rpy:24
translate turkish u20g_ea76bd5b:

    # "I walk quietly up the stairs and into Juliana's room. She's in bed, sleeping."
    "Sessizce merdivenleri çıkıp Juliana’nın odasına girdim. Yatakta uyuyordu."

# game/Scenes/Update20/u20g.rpy:27
translate turkish u20g_a95bfc0c:

    # "Trying not to wake her immediately, I lie next to her and wrap her in my arms."
    "Onu hemen uyandırmamaya çalışarak yanına uzandım ve kollarıma sardım."

# game/Scenes/Update20/u20g.rpy:30
translate turkish u20g_c981bd85:

    # "She jolts awake and looks at me, shocked."
    "Birden irkildi ve şaşkın bir şekilde bana baktı."

# game/Scenes/Update20/u20g.rpy:31
translate turkish u20g_c026970e:

    # bn "[pcname]? Is it really you?"
    bn "[pcname]? Gerçekten sen misin?"

# game/Scenes/Update20/u20g.rpy:32
translate turkish u20g_7f340d6d:

    # pc "It's really me."
    pc "Gerçekten benim."

# game/Scenes/Update20/u20g.rpy:35
translate turkish u20g_b5e336f8:

    # "She leans in and kisses me deeply, her lips soft and warm against mine."
    "Bana doğru eğildi ve beni derin bir öpücükle öptü; dudakları benimkilere değdiğinde yumuşak ve sıcaktı."

# game/Scenes/Update20/u20g.rpy:36
translate turkish u20g_df5fc180:

    # bn "Oh, I missed you so much."
    bn "Oh, seni çok özledim."

# game/Scenes/Update20/u20g.rpy:39
translate turkish u20g_cfc15aa3:

    # bn "So everything was true? You really saw your dad?"
    bn "Yani her şey doğruydu mu? Babana gerçekten mi gördün?"

# game/Scenes/Update20/u20g.rpy:40
translate turkish u20g_e5c0f2f9:

    # pc "Yeah, I did. It's all true. I'll tell you all about it tomorrow."
    pc "Evet, gördüm. Hepsi doğru. Yarın sana her şeyi anlatacağım."

# game/Scenes/Update20/u20g.rpy:43
translate turkish u20g_2b545022:

    # bn "I'm just glad you're back. I was so worried about you."
    bn "Geri döndüğüne çok sevindim. Senin için çok endişelenmiştim."

# game/Scenes/Update20/u20g.rpy:44
translate turkish u20g_98d08bed:

    # bn "You look and smell awful though."
    bn "Ama hem görünüşün hem de kokun berbat."

# game/Scenes/Update20/u20g.rpy:47
translate turkish u20g_4aea05d2:

    # bn "I'll go get the bathroom ready for you."
    bn "Gidip banyoyu senin için hazırlayayım."

# game/Scenes/Update20/u20g.rpy:48
translate turkish u20g_a3acbba5:

    # bn "If you're going to stay the night in my bed, you need to shower and shave."
    bn "Bu gece benim yatağımda kalacaksan, duş alıp tıraş olman lazım."

