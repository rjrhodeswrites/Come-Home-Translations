# game/Scenes/Update20/u20i.rpy:4
translate turkish u20i_8448fa1b:

    # "For now, I should go see Kendra."
    "Şimdilik, gidip Kendra'yı görmeliyim."

# game/Scenes/Update20/u20i.rpy:7
translate turkish u20i_0bb8c7de:

    # "I drive over to Kendra's house and ring the doorbell."
    "Kendra'nın evine arabayla gidip zili çalıyorum."

# game/Scenes/Update20/u20i.rpy:8
translate turkish u20i_4fc89239:

    # "It's late and I hate to wake her, but I need to see her."
    "Saat geç oldu ve onu uyandırmak istemem ama onu görmem lazım."

# game/Scenes/Update20/u20i.rpy:11
translate turkish u20i_c67521f3:

    # "Kendra's Mom" "Can I help you?"
    "Kendra's Mom" "Nasıl yardımcı olabilirim?"

# game/Scenes/Update20/u20i.rpy:12
translate turkish u20i_de2a91d9:

    # pc "Hi, Mrs... uh... I'm sorry I can't remember."
    pc "Merhaba, Bayan... şey... Hatırlayamadığım için özür dilerim."

# game/Scenes/Update20/u20i.rpy:13
translate turkish u20i_11072c5d:

    # pc "Can I see Kendra, please?"
    pc "Kendra'yı görebilir miyim lütfen?"

# game/Scenes/Update20/u20i.rpy:14
translate turkish u20i_00534160:

    # "Kendra's Mom" "Oh, [pcname], is that you? I didn't recognize you. You look awful."
    "Kendra's Mom" "Oh, [pcname], sen misin? Seni tanıyamadım. Berbat görünüyorsun."

# game/Scenes/Update20/u20i.rpy:17
translate turkish u20i_19dbe255:

    # "Kendra's Mom" "Come in, come in."
    "Kendra's Mom" "İçeri gel, içeri gel."

# game/Scenes/Update20/u20i.rpy:18
translate turkish u20i_44c98480:

    # "Kendra's Mom" "Kendra has barely left her room in a month, she's been so worried about you."
    "Kendra's Mom" "Kendra bir aydır odasından neredeyse hiç çıkmadı, senin için çok endişelendi."

# game/Scenes/Update20/u20i.rpy:19
translate turkish u20i_63704f39:

    # "Kendra's Mom" "Go ahead and go up. It's the first door on the left."
    "Kendra's Mom" "Hadi yukarı çık. Soldaki ilk kapı."

# game/Scenes/Update20/u20i.rpy:20
translate turkish u20i_008e3a26:

    # pc "Thank you."
    pc "Teşekkürler."

# game/Scenes/Update20/u20i.rpy:23
translate turkish u20i_018f49bc:

    # "I walk quietly up the stairs and into Kendra's room. She's in bed, sleeping."
    "Sessizce merdivenleri çıkıp Kendra’nın odasına giriyorum. Yatakta uyuyor."

# game/Scenes/Update20/u20i.rpy:26
translate turkish u20i_cbba5bfa:

    # "Trying not to wake her immediately, I lie next to her and wrap my arms around her."
    "Onu hemen uyandırmamaya çalışarak yanına uzanıp kollarıma sarıyorum."

# game/Scenes/Update20/u20i.rpy:30
translate turkish u20i_c981bd85:

    # "She jolts awake and looks at me, shocked."
    "Birden uyanıyor ve şaşkın bir şekilde bana bakıyor."

# game/Scenes/Update20/u20i.rpy:31
translate turkish u20i_a0883aa3:

    # sg "[kdaddy]? Is it really you?"
    sg "[kdaddy]? Gerçekten sen misin?"

# game/Scenes/Update20/u20i.rpy:34
translate turkish u20i_0f0952fe:

    # "I don't answer. I just pull her close and kiss her deeply."
    "Cevap vermiyorum. Sadece onu kendime çekip derin bir öpücük veriyorum."

# game/Scenes/Update20/u20i.rpy:35
translate turkish u20i_61fcb071:

    # sg "Oh fuck, I was so worried. I thought you were gone."
    sg "Ah lanet olsun, çok endişelenmiştim. Gittiğini sanmıştım."

# game/Scenes/Update20/u20i.rpy:38
translate turkish u20i_3005a5fb:

    # sg "So what happened? Did you see your dad?"
    sg "Peki ne oldu? Babanı gördün mü?"

# game/Scenes/Update20/u20i.rpy:39
translate turkish u20i_0118c310:

    # pc "Yeah, I did. I'll tell you all about it tomorrow."
    pc "Evet, gördüm. Yarın sana her şeyi anlatacağım."

# game/Scenes/Update20/u20i.rpy:42
translate turkish u20i_1cb431e1:

    # sg "I'm just glad you're back!"
    sg "Geri döndüğüne çok sevindim!"

# game/Scenes/Update20/u20i.rpy:43
translate turkish u20i_8dd76441:

    # sg "Your hair is so long! We could cut it and glue it to my bald ass!"
    sg "Saçların çok uzamış! Kesip benim kel kafama yapıştırabiliriz!"

# game/Scenes/Update20/u20i.rpy:46
translate turkish u20i_ca3e5be6:

    # sg "Fuck, I've been crying a lot. I never knew what it would be like to lose somebody you loved."
    sg "Kahretsin, çok ağladım. Sevdiğin birini kaybetmenin nasıl bir şey olduğunu hiç bilmiyordum."

# game/Scenes/Update20/u20i.rpy:47
translate turkish u20i_f432b969:

    # "I pull her close and kiss her again, feeling her warmth."
    "Onu kendime çekip tekrar öpüyorum, sıcaklığını hissediyorum."

# game/Scenes/Update20/u20i.rpy:48
translate turkish u20i_20c28e15:

    # sg "I missed you so much, [kdaddy]."
    sg "Seni çok özledim, [kdaddy]."

# game/Scenes/Update20/u20i.rpy:49
translate turkish u20i_14591512:

    # pc "I missed you too, baby."
    pc "Ben de seni özledim, bebeğim."

