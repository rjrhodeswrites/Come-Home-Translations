# game/Scenes/Update20/u20f.rpy:2
translate turkish u20f_7d92946f:

    # "For now, I should go see Mari."
    "Şimdilik Mari'yi görmeye gitmeliyim."

# game/Scenes/Update20/u20f.rpy:5
translate turkish u20f_2bb3b023:

    # "I drive to Mari's house and knock on her door."
    "Mari'nin evine gidip kapısını çalıyorum."

# game/Scenes/Update20/u20f.rpy:6
translate turkish u20f_0b175aad:

    # "Her dogs start barking at the door and I hear footsteps approaching."
    "Köpekleri kapıda havlamaya başlıyor ve yaklaşan ayak sesleri duyuyorum."

# game/Scenes/Update20/u20f.rpy:7
translate turkish u20f_be91a4c9:

    # fr "Who is it?"
    fr "Kim o?"

# game/Scenes/Update20/u20f.rpy:8
translate turkish u20f_1063bb8b:

    # pc "It's me! [pcname]."
    pc "Benim! [pcname]."

# game/Scenes/Update20/u20f.rpy:12
translate turkish u20f_a9b3d399:

    # fr "Oh my God, [pcname]!"
    fr "Aman Tanrım, [pcname]!"

# game/Scenes/Update20/u20f.rpy:13
translate turkish u20f_ea03fec2:

    # "She opens the door and stares at me for a moment, shocked."
    "Kapıyı açıyor ve şok içinde bir anlığına bana bakıyor."

# game/Scenes/Update20/u20f.rpy:14
translate turkish u20f_40412d0f:

    # "I can see her eyes welling up with tears."
    "Gözlerinin yaşlarla dolduğunu görebiliyorum."

# game/Scenes/Update20/u20f.rpy:15
translate turkish u20f_23647146:

    # fr "I thought..."
    fr "Sanmıştım ki..."

# game/Scenes/Update20/u20f.rpy:18
translate turkish u20f_540e25ed:

    # "She rushes into my arms and hugs me tightly."
    "Hemen kollarıma atılıyor ve bana sıkıca sarılıyor."

# game/Scenes/Update20/u20f.rpy:19
translate turkish u20f_140e4956:

    # "I hug her back, feeling her warmth and the softness of her body."
    "Ben de ona sarılıyorum, vücudunun sıcaklığını ve yumuşaklığını hissediyorum."

# game/Scenes/Update20/u20f.rpy:20
translate turkish u20f_dddaeb84:

    # pc "I missed you, Mari. I'm sorry I was gone for so long."
    pc "Seni özledim, Mari. Bu kadar uzun süre yok olduğum için özür dilerim."

# game/Scenes/Update20/u20f.rpy:23
translate turkish u20f_b77230d2:

    # fr "I was so worried about you. I thought that machine killed you."
    fr "Senin için çok endişelendim. O makinenin seni öldürdüğünü sandım."

# game/Scenes/Update20/u20f.rpy:24
translate turkish u20f_40e4fe9b:

    # pc "I fought so hard to get back."
    pc "Geri dönmek için çok mücadele ettim."

# game/Scenes/Update20/u20f.rpy:25
translate turkish u20f_356f7f42:

    # pc "I'll tell you everything tomorrow, I promise."
    pc "Yarın sana her şeyi anlatacağım, söz veriyorum."

# game/Scenes/Update20/u20f.rpy:28
translate turkish u20f_e5e85df6:

    # fr "I'm just glad you're back."
    fr "Geri döndüğüne çok sevindim."

# game/Scenes/Update20/u20f.rpy:29
translate turkish u20f_1f943087:

    # fr "Wow, your hair grew a lot."
    fr "Vay canına, saçların çok uzamış."

# game/Scenes/Update20/u20f.rpy:30
translate turkish u20f_c49af8d0:

    # fr "It makes you look all rugged."
    fr "Bu sana oldukça sert bir hava katıyor."

# game/Scenes/Update20/u20f.rpy:33
translate turkish u20f_7d64063d:

    # "She kisses me softly, her lips warm and inviting."
    "Bana nazikçe öpüyor, dudakları sıcak ve davetkar."

# game/Scenes/Update20/u20f.rpy:34
translate turkish u20f_e6ca1864:

    # fr "I'm so happy you came home."
    fr "Eve döndüğüne çok mutluyum."

# game/Scenes/Update20/u20f.rpy:35
translate turkish u20f_402e55b1:

    # fr "Let's go to bed. We can talk in the morning."
    fr "Hadi yatalım. Sabah konuşuruz."

