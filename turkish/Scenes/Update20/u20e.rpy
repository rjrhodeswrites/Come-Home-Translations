# game/Scenes/Update20/u20e.rpy:2
translate turkish u20e_ee43eaac:

    # "For now, I should go see Dana."
    "Şimdilik Dana’yı görmeye gitmeliyim."

# game/Scenes/Update20/u20e.rpy:5
translate turkish u20e_8200a66a:

    # "I drive over to Dana's apartment and knock on her door."
    "Dana’nın dairesine arabayla gidip kapısını çalıyorum."

# game/Scenes/Update20/u20e.rpy:6
translate turkish u20e_4fc89239:

    # "It's late and I hate to wake her, but I need to see her."
    "Saat geç oldu ve onu uyandırmak istemiyorum ama onu görmem lazım."

# game/Scenes/Update20/u20e.rpy:10
translate turkish u20e_92b16112:

    # cw "[pcname]? Oh my God!"
    cw "[pcname]? Aman Tanrım!"

# game/Scenes/Update20/u20e.rpy:13
translate turkish u20e_da2e1dbd:

    # "She rushes to me and wraps her arms around me tightly."
    "Bana doğru koşar ve kollarını sıkıca bana dolanır."

# game/Scenes/Update20/u20e.rpy:14
translate turkish u20e_140e4956:

    # "I hug her back, feeling her warmth and the softness of her body."
    "Ben de ona sarılırım, sıcaklığını ve vücudunun yumuşaklığını hissederim."

# game/Scenes/Update20/u20e.rpy:15
translate turkish u20e_ed44c8a5:

    # pc "I missed you."
    pc "Seni özledim."

# game/Scenes/Update20/u20e.rpy:18
translate turkish u20e_35280183:

    # cw "I missed you too. What happened? I thought that machine killed you."
    cw "Ben de seni özledim. Ne oldu? O makine seni öldürdü sanmıştım."

# game/Scenes/Update20/u20e.rpy:19
translate turkish u20e_b4f81641:

    # pc "I'm sorry. I didn't mean to leave for so long."
    pc "Özür dilerim. Bu kadar uzun süre uzak kalmak istemedim."

# game/Scenes/Update20/u20e.rpy:20
translate turkish u20e_356f7f42:

    # pc "I'll tell you everything tomorrow, I promise."
    pc "Yarın sana her şeyi anlatacağım, söz veriyorum."

# game/Scenes/Update20/u20e.rpy:23
translate turkish u20e_1569fad0:

    # cw "I'm just glad you're back."
    cw "Geri döndüğüne çok sevindim."

# game/Scenes/Update20/u20e.rpy:24
translate turkish u20e_634678a9:

    # cw "Wow, your hair grew a lot."
    cw "Vay canına, saçın epey uzamış."

# game/Scenes/Update20/u20e.rpy:25
translate turkish u20e_ab3cf051:

    # cw "It looks awful."
    cw "Berbat görünüyor."

# game/Scenes/Update20/u20e.rpy:28
translate turkish u20e_7d64063d:

    # "She kisses me softly, her lips warm and inviting."
    "Bana nazikçe öpüyor, dudakları sıcak ve davetkar."

# game/Scenes/Update20/u20e.rpy:29
translate turkish u20e_9cf9ef15:

    # cw "But I don't care. You came home."
    cw "Ama umurumda değil. Eve geldin."

# game/Scenes/Update20/u20e.rpy:30
translate turkish u20e_ad7289ff:

    # cw "I missed you so much, [pcname]."
    cw "Seni çok özledim, [pcname]."

# game/Scenes/Update20/u20e.rpy:31
translate turkish u20e_0ea8f604:

    # cw "Let's go to bed. We can talk in the morning."
    cw "Hadi yatalım. Sabah konuşuruz."

