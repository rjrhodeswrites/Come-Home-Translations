# TODO: Translation updated at 2026-08-03 12:42

# game/Scenes/Update20/u20j.rpy:2
translate turkish u20j_be7d1e50:

    # "For now, I should go see Adrian."
    "Şimdilik Adrian'ı görmeye gitmeliyim."

# game/Scenes/Update20/u20j.rpy:5
translate turkish u20j_33260fe1:

    # "I drive over to Adrian's house and ring the doorbell."
    "Adrian’ın evine arabayla gidip kapı zilini çalıyorum."

# game/Scenes/Update20/u20j.rpy:6
translate turkish u20j_4fc89239:

    # "It's late and I hate to wake her, but I need to see her."
    "Saat geç oldu ve onu uyandırmak istemiyorum ama onu görmem lazım."

# game/Scenes/Update20/u20j.rpy:9
translate turkish u20j_494a3331:

    # "Adrian's Mom" "Hello? Do you know how late it is?"
    "Adrian's Mom" "Alo? Saatin kaç olduğunu biliyor musun?"

# game/Scenes/Update20/u20j.rpy:10
translate turkish u20j_7d43c485:

    # pc "I'm sorry, I know. I'm a friend of Adrian's."
    pc "Özür dilerim, biliyorum. Adrian’ın bir arkadaşıyım."

# game/Scenes/Update20/u20j.rpy:11
translate turkish u20j_87309e2a:

    # pc "Could I talk to her, please?"
    pc "Onunla konuşabilir miyim lütfen?"

# game/Scenes/Update20/u20j.rpy:12
translate turkish u20j_ad012933:

    # "Adrian's Mom" "Oh, are you [pcname]? She's been worried about you for weeks."
    "Adrian's Mom" "Oh, sen [pcname] misin? Haftalardır senin için endişeleniyor."

# game/Scenes/Update20/u20j.rpy:13
translate turkish u20j_332de7e5:

    # pc "Yes, I'm sorry. That's me."
    pc "Evet, özür dilerim. O benim."

# game/Scenes/Update20/u20j.rpy:16
translate turkish u20j_1a0d366a:

    # "Adrian's Mom" "She's going to be really happy to see you."
    "Adrian's Mom" "Seni görünce çok sevinecek."

# game/Scenes/Update20/u20j.rpy:17
translate turkish u20j_1108c1b8:

    # "Adrian's Mom" "You can go up and see her, just keep things PG, okay?"
    "Adrian's Mom" "Yukarı çıkıp onu görebilirsin, ama davranışlarına dikkat et, tamam mı?"

# game/Scenes/Update20/u20j.rpy:18
translate turkish u20j_e170ff6c:

    # pc "Yes, ma'am. Thank you."
    pc "Evet, hanımefendi. Teşekkür ederim."

# game/Scenes/Update20/u20j.rpy:22
translate turkish u20j_f5638052:

    # "I walk quietly up the stairs and into Adrian's room. She's in bed, sleeping."
    "Sessizce merdivenleri çıkıp Adrian’ın odasına giriyorum. Yatakta uyuyor."

# game/Scenes/Update20/u20j.rpy:25
translate turkish u20j_cbba5bfa:

    # "Trying not to wake her immediately, I lie next to her and wrap my arms around her."
    "Onu hemen uyandırmamaya çalışarak yanına uzanıp kollarıma sarıyorum."

# game/Scenes/Update20/u20j.rpy:28
translate turkish u20j_c981bd85:

    # "She jolts awake and looks at me, shocked."
    "Birden uyanıyor ve şaşkın bir şekilde bana bakıyor."

# game/Scenes/Update20/u20j.rpy:29
translate turkish u20j_a857ee55:

    # gg "What the fuck? [pcname]?"
    gg "Ne oluyor lan? [pcname]?"

# game/Scenes/Update20/u20j.rpy:32
translate turkish u20j_0f0952fe:

    # "I don't answer. I just pull her close and kiss her deeply."
    "Cevap vermiyorum. Onu kendime çekip derin bir öpücük veriyorum."

# game/Scenes/Update20/u20j.rpy:33
translate turkish u20j_09b23034:

    # gg "Fuck, I was so worried about you. I thought you weren't ever coming back."
    gg "Kahretsin, senin için çok endişelendim. Bir daha geri dönmeyeceğini sandım."

# game/Scenes/Update20/u20j.rpy:36
translate turkish u20j_b1adfb65:

    # gg "So you went to another world, for real?"
    gg "Yani gerçekten başka bir dünyaya mı gittin?"

# game/Scenes/Update20/u20j.rpy:37
translate turkish u20j_e5f2498c:

    # pc "Yeah, I did."
    pc "Evet, gittim."

# game/Scenes/Update20/u20j.rpy:38
translate turkish u20j_29a8b357:

    # gg "And you saw your dad?"
    gg "Peki babanı gördün mü?"

# game/Scenes/Update20/u20j.rpy:39
translate turkish u20j_c417e350:

    # pc "Yeah."
    pc "Evet."

# game/Scenes/Update20/u20j.rpy:40
translate turkish u20j_fa6e7016:

    # gg "You have to tell me everything."
    gg "Bana her şeyi anlatmalısın."

# game/Scenes/Update20/u20j.rpy:41
translate turkish u20j_0bb899f2:

    # pc "I will, I promise. Tomorrow."
    pc "Anlatacağım, söz veriyorum. Yarın."

# game/Scenes/Update20/u20j.rpy:44
translate turkish u20j_92c42e64:

    # gg "Right. Tomorrow. I'm just glad you're back!"
    gg "Tamam. Yarın. Geri döndüğüne çok sevindim!"

# game/Scenes/Update20/u20j.rpy:45
translate turkish u20j_d2639c3b:

    # gg "I can't believe you're back."
    gg "Geri döndüğüne inanamıyorum."

# game/Scenes/Update20/u20j.rpy:46
translate turkish u20j_c01c395d:

    # gg "I'm so happy, I can't stand it."
    gg "O kadar mutluyum ki, dayanamıyorum."

# game/Scenes/Update20/u20j.rpy:49
translate turkish u20j_f432b969:

    # "I pull her close and kiss her again, feeling her warmth."
    "Onu kendime çekip tekrar öpüyorum, sıcaklığını hissediyorum."

# game/Scenes/Update20/u20j.rpy:50
translate turkish u20j_bf4f63bf:

    # gg "Good idea. Shut me up with your mouth."
    gg "İyi fikir. Ağzınla beni sustur."

# game/Scenes/Update20/u20j.rpy:51
translate turkish u20j_1530bf0e:

    # gg "I just missed you so much."
    gg "Seni çok özledim."

# game/Scenes/Update20/u20j.rpy:52
translate turkish u20j_9c24a5ca:

    # pc "I missed you too, Adrian."
    pc "Ben de seni özledim, Adrian."

