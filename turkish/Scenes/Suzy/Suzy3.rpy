# game/Scenes/Suzy/Suzy3.rpy:14
translate turkish suzy3_4cd33d0d:

    # "I decide that I need a shower before bed tonight."
    "Bu gece yatmadan önce duş almam gerektiğine karar veriyorum."

# game/Scenes/Suzy/Suzy3.rpy:15
translate turkish suzy3_0aad95b6:

    # "I peek into the bathroom to make sure that Suzy isn't in there, then I go in and start running water."
    "Suzy'nin içeride olmadığından emin olmak için banyoya bir göz atıyorum, sonra içeri girip suyu açıyorum."

# game/Scenes/Suzy/Suzy3.rpy:16
translate turkish suzy3_ef339027:

    # "When the water is warm, I strip down and get in."
    "Su ısındığında, kıyafetlerimi çıkarıp duşa giriyorum."

# game/Scenes/Suzy/Suzy3.rpy:18
translate turkish suzy3_2e55107f:

    # "I stand there, washing myself, closing my eyes and just relaxing, thinking about the day."
    "Orada durup kendimi yıkıyorum, gözlerimi kapatıp sadece rahatlıyorum, günü düşünüyorum."

# game/Scenes/Suzy/Suzy3.rpy:19
translate turkish suzy3_926119ff:

    # "I'm tired and so relaxed, I feel as though I could just fall asleep standing there."
    "Yorgunum ve o kadar rahatlamışım ki, sanki orada ayakta uyuyakalabilirmişim gibi hissediyorum."

# game/Scenes/Suzy/Suzy3.rpy:22
translate turkish suzy3_01439eb0:

    # "I let the water run down over my face, down my body."
    "Suyun yüzümden, vücudumdan aşağı akmasına izin veriyorum."

# game/Scenes/Suzy/Suzy3.rpy:23
translate turkish suzy3_fe18b581:

    # "I rub the soap in with a rag, getting every part of my body."
    "Bir bezle sabunu vücudumun her yerine sürüyorum."

# game/Scenes/Suzy/Suzy3.rpy:25
translate turkish suzy3_88cfebd1:

    # "Then I finally open my eyes again."
    "Sonra nihayet gözlerimi tekrar açıyorum."

# game/Scenes/Suzy/Suzy3.rpy:26
translate turkish suzy3_bd18bade:

    # "I'm startled to see Suzy standing in the doorway to my room, staring at me."
    "Suzy’nin odamın kapısında durup bana bakarken gördüğümde irkiliyorum."

# game/Scenes/Suzy/Suzy3.rpy:28
translate turkish suzy3_34856c07:

    # "She is staring directly at my dick and smiling, enjoying what she is seeing."
    "Doğrudan aletime bakıyor ve gülümsüyor, gördüğü şeyden zevk alıyor."

# game/Scenes/Suzy/Suzy3.rpy:31
translate turkish suzy3_e1d0918a:

    # "I turn off the water and step out of the shower, giving her a full-on view."
    "Suyu kapatıp duştan çıkıyorum, ona tam bir manzara sunuyorum."

# game/Scenes/Suzy/Suzy3.rpy:32
translate turkish suzy3_a9e16441:

    # pc "Like what you see?"
    pc "Gördüğün hoşuna gitti mi?"

# game/Scenes/Suzy/Suzy3.rpy:35
translate turkish suzy3_31664f02:

    # ss "Yeah, I guess I do."
    ss "Evet, sanırım beğendim."

# game/Scenes/Suzy/Suzy3.rpy:36
translate turkish suzy3_c485c150:

    # ss "I have to say, I was just curious, and I'm pretty impressed."
    ss "Şunu söylemeliyim ki, sadece merak etmiştim ve oldukça etkilendim."

# game/Scenes/Suzy/Suzy3.rpy:38
translate turkish suzy3_37501cd5:

    # ss "Anyways, I'll leave you to it."
    ss "Neyse, seni bununla baş başa bırakayım."

# game/Scenes/Suzy/Suzy3.rpy:40
translate turkish suzy3_d41d8cd9:

    # voice 'voices/suzy_seeyoulater1.mp3'
    voice 'voices/suzy_seeyoulater1.mp3'

# game/Scenes/Suzy/Suzy3.rpy:41
translate turkish suzy3_6cc7d33e:

    # ss "See you later!"
    ss "Görüşürüz!"

# game/Scenes/Suzy/Suzy3.rpy:43
translate turkish suzy3_e1d0918a_1:

    # "I turn off the water and step out of the shower, giving her a full-on view."
    "Suyu kapatıp duştan çıkıyorum ve ona tam bir manzara sunuyorum."

# game/Scenes/Suzy/Suzy3.rpy:44
translate turkish suzy3_ac2c6a00:

    # pc "Okay, now you show me yours."
    pc "Tamam, şimdi sen de bana seninkini göster."

# game/Scenes/Suzy/Suzy3.rpy:47
translate turkish suzy3_784d85e4:

    # ss "What now?"
    ss "Ne var şimdi?"

# game/Scenes/Suzy/Suzy3.rpy:48
translate turkish suzy3_6ba12503:

    # pc "I showed you mine, now you show me yours."
    pc "Ben sana benimkini gösterdim, şimdi sen de bana seninkini göster."

# game/Scenes/Suzy/Suzy3.rpy:49
translate turkish suzy3_b18495e6:

    # ss "Oh I don't think so."
    ss "Oh, sanmıyorum."

# game/Scenes/Suzy/Suzy3.rpy:51
translate turkish suzy3_eac5c063:

    # ss "But I have to say, I was just curious, and I'm pretty impressed."
    ss "Ama şunu söylemeliyim ki, sadece merak etmiştim ve oldukça etkilendim."

# game/Scenes/Suzy/Suzy3.rpy:53
translate turkish suzy3_37501cd5_1:

    # ss "Anyways, I'll leave you to it."
    ss "Neyse, seni rahat bırakayım."

# game/Scenes/Suzy/Suzy3.rpy:55
translate turkish suzy3_d41d8cd9_1:

    # voice 'voices/suzy_seeyoulater1.mp3'
    voice 'voices/suzy_seeyoulater1.mp3'

# game/Scenes/Suzy/Suzy3.rpy:56
translate turkish suzy3_6cc7d33e_1:

    # ss "See you later!"
    ss "Görüşürüz!"

# game/Scenes/Suzy/Suzy3.rpy:58
translate turkish suzy3_4c7153f4:

    # "I turn off the water and step out of the shower, trying to cover myself with my hands."
    "Suyu kapatıp duştan çıkıyorum, ellerimle kendimi örtmeye çalışıyorum."

# game/Scenes/Suzy/Suzy3.rpy:59
translate turkish suzy3_d3892dc3:

    # pc "What the hell Suzy?"
    pc "Ne oluyor Suzy?"

# game/Scenes/Suzy/Suzy3.rpy:62
translate turkish suzy3_51defb56:

    # ss "What? I was just curious."
    ss "Ne? Sadece merak etmiştim."

# game/Scenes/Suzy/Suzy3.rpy:64
translate turkish suzy3_5a6d5430:

    # ss "And I have to say, I'm pretty impressed."
    ss "Ve şunu söylemeliyim ki, oldukça etkilendim."

# game/Scenes/Suzy/Suzy3.rpy:65
translate turkish suzy3_f65e93c7:

    # pc "Can I get some privacy?"
    pc "Biraz mahremiyetim olabilir mi?"

# game/Scenes/Suzy/Suzy3.rpy:67
translate turkish suzy3_a0a0b32a:

    # ss "Sure, [bro]. I'll leave you to it."
    ss "Tabii, [bro]. Seni rahat bırakayım."

# game/Scenes/Suzy/Suzy3.rpy:69
translate turkish suzy3_d41d8cd9_2:

    # voice 'voices/suzy_seeyoulater1.mp3'
    voice 'voices/suzy_seeyoulater1.mp3'

# game/Scenes/Suzy/Suzy3.rpy:70
translate turkish suzy3_2d392b49:

    # ss "See you later."
    ss "Görüşürüz."

# game/Scenes/Suzy/Suzy3.rpy:72
translate turkish suzy3_60b55006:

    # "She turns and walks out, through my bedroom, out the hall, and then I hear her going down the stairs."
    "Arkasını dönüp çıkıyor, yatak odamdan geçip koridordan çıkıyor, sonra merdivenlerden indiğini duyuyorum."

# game/Scenes/Suzy/Suzy3.rpy:73
translate turkish suzy3_00f675f5:

    # "Well that was weird."
    "Bu biraz tuhaftı."

# game/Scenes/Suzy/Suzy3.rpy:74
translate turkish suzy3_681abbcd:

    # "I dry off, go back to my bedroom, and put on some boxers."
    "Kendimi kurulayıp yatak odama geri dönüyorum ve bir boxer giyiyorum."

# game/Scenes/Suzy/Suzy3.rpy:75
translate turkish suzy3_e827b6c8:

    # "Seems like Suzy may be interested in me as more than just her [brother]."
    "Görünüşe göre Suzy benden sadece [brother]'sından daha fazlasını bekliyor olabilir."

# game/Scenes/Suzy/Suzy3.rpy:78
translate turkish suzy3_a3202b26:

    # "I'd definitely fuck her if I got the chance."
    "Fırsatım olsaydı kesinlikle onunla yatardım."

# game/Scenes/Suzy/Suzy3.rpy:81
translate turkish suzy3_c85b6a64:

    # "I should put a stop to this next time I talk to her."
    "Bir dahaki sefere onunla konuştuğumda buna bir son vermeliyim."

# game/Scenes/Suzy/Suzy3.rpy:82
translate turkish suzy3_67f022d1:

    # "It can't go any further."
    "Daha ileri gidemez."

# game/Scenes/Suzy/Suzy3.rpy:84
translate turkish suzy3_dc9f2d3c:

    # "Showered and thinking about Suzy, I go to sleep."
    "Duş alıp Suzy’yi düşünerek uykuya dalıyorum."

