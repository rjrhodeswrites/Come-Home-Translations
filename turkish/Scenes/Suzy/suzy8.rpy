# TODO: Translation updated at 2026-08-03 12:42

# game/Scenes/Suzy/suzy8.rpy:20
translate turkish suzy8_eeeec132:

    # "Before bed, I go to the bathroom to wash up and brush my teeth."
    "Yatmadan önce, yüzümü yıkamak ve dişlerimi fırçalamak için banyoya gidiyorum."

# game/Scenes/Suzy/suzy8.rpy:21
translate turkish suzy8_58353284:

    # "As I'm standing in front of the mirror, I hear a whimpering noise coming from Suzy's room. It sounds like she's crying."
    "Aynanın önünde dururken, Suzy'nin odasından gelen hıçkırık sesleri duyuyorum. Sanki ağlıyor gibi."

# game/Scenes/Suzy/suzy8.rpy:22
translate turkish suzy8_c02d22a8:

    # "Worried about her, I put my toothbrush down and crack open the door slightly to peek into her room."
    "Onun için endişelenerek diş fırçamı bırakıp kapıyı biraz aralayıp odasına bakıyorum."

# game/Scenes/Suzy/suzy8.rpy:26
translate turkish suzy8_4c53ab88:

    # "She lies in her bed, her face buried in her pillow, her body trembling as she cries."
    "Yatağında yatıyor, yüzünü yastığa gömmüş, ağlarken vücudu titriyor."

# game/Scenes/Suzy/suzy8.rpy:27
translate turkish suzy8_144a37ee:

    # "What could have gotten her so upset?"
    "Onu bu kadar üzen ne olabilir ki?"

# game/Scenes/Suzy/suzy8.rpy:30
translate turkish suzy8_17528ddd:

    # "I walk into her room and over to her bed, then gently put my hand on her shoulder."
    "Odasına girip yatağına doğru yürüdüm, sonra elimi nazikçe omzuna koydum."

# game/Scenes/Suzy/suzy8.rpy:31
translate turkish suzy8_943a2ff7:

    # pc "Are you okay, [sis]?"
    pc "İyi misin, [sis]?"

# game/Scenes/Suzy/suzy8.rpy:34
translate turkish suzy8_8da8e030:

    # "Suzy startles and rolls over facing me, her face scrunched and wet from crying, her visage of sadness morphing into one of fury."
    "Suzy irkildi ve bana dönerek yattı; yüzü ağlamaktan buruşmuş ve ıslaktı, üzüntü dolu ifadesi öfkeye dönüştü."

# game/Scenes/Suzy/suzy8.rpy:36
translate turkish suzy8_d41d8cd9:

    # voice 'voices/suzy_8_1.mp3'
    voice 'voices/suzy_8_1.mp3'

# game/Scenes/Suzy/suzy8.rpy:37
translate turkish suzy8_9f19b323:

    # ss "What are you doing in here?"
    ss "Burada ne işin var?"

# game/Scenes/Suzy/suzy8.rpy:39
translate turkish suzy8_d41d8cd9_1:

    # voice 'voices/suzy_8_2.mp3'
    voice 'voices/suzy_8_2.mp3'

# game/Scenes/Suzy/suzy8.rpy:40
translate turkish suzy8_ef42fa9f:

    # ss "Leave me alone! Get out of my room!"
    ss "Beni rahat bırak! Odamdan çık!"

# game/Scenes/Suzy/suzy8.rpy:41
translate turkish suzy8_c77c201a:

    # pc "I just heard you crying and..."
    pc "Sadece ağladığını duydum da..."

# game/Scenes/Suzy/suzy8.rpy:43
translate turkish suzy8_d41d8cd9_2:

    # voice 'voices/suzy_8_3.mp3'
    voice 'voices/suzy_8_3.mp3'

# game/Scenes/Suzy/suzy8.rpy:44
translate turkish suzy8_cdd05524:

    # ss "GET OUT!"
    ss "ÇIK DIŞARI!"

# game/Scenes/Suzy/suzy8.rpy:47
translate turkish suzy8_ab5c1d88:

    # "I don't try to talk to her anymore, instead just backing up out of her room and closing the door behind me."
    "Artık onunla konuşmaya çalışmıyorum, bunun yerine odasından geri çekilip arkamdan kapıyı kapatıyorum."

# game/Scenes/Suzy/suzy8.rpy:48
translate turkish suzy8_13d9beec:

    # "Wow. I'm just trying to help here, but I guess she doesn't want to talk about it at the moment."
    "Vay canına. Sadece yardım etmeye çalışıyorum ama sanırım şu anda bu konu hakkında konuşmak istemiyor."

# game/Scenes/Suzy/suzy8.rpy:49
translate turkish suzy8_660f4989:

    # "I lie down in bed and try to get to sleep. I'm having a hard time with it, as I'm both annoyed at and worried about her."
    "Yatağa uzanıp uyumaya çalışıyorum. Hem ona kızgın hem de onun için endişelendiğim için uyumakta zorlanıyorum."

# game/Scenes/Suzy/suzy8.rpy:50
translate turkish suzy8_6e6cee1b:

    # "Then I hear the bathroom door open."
    "Sonra banyo kapısının açıldığını duyuyorum."

# game/Scenes/Suzy/suzy8.rpy:53
translate turkish suzy8_96b85f4c:

    # ss "[bro]?"
    ss "[bro]?"

# game/Scenes/Suzy/suzy8.rpy:54
translate turkish suzy8_b8cf090c:

    # "I look over at her. She's standing, looking at me unsure, tears in her eyes."
    "Ona bakıyorum. Ayakta duruyor, gözlerinde yaşlarla bana kararsızca bakıyor."

# game/Scenes/Suzy/suzy8.rpy:55
translate turkish suzy8_d72509a6:

    # pc "Yeah?"
    pc "Evet?"

# game/Scenes/Suzy/suzy8.rpy:57
translate turkish suzy8_d41d8cd9_3:

    # voice 'voices/suzy_8_4.mp3'
    voice 'voices/suzy_8_4.mp3'

# game/Scenes/Suzy/suzy8.rpy:58
translate turkish suzy8_49cdd518:

    # ss "I'm sorry."
    ss "Özür dilerim."

# game/Scenes/Suzy/suzy8.rpy:60
translate turkish suzy8_d41d8cd9_4:

    # voice 'voices/suzy_8_5.mp3'
    voice 'voices/suzy_8_5.mp3'

# game/Scenes/Suzy/suzy8.rpy:61
translate turkish suzy8_5c597394:

    # ss "I shouldn't have yelled at you."
    ss "Sana bağırmamalıydım."

# game/Scenes/Suzy/suzy8.rpy:63
translate turkish suzy8_d41d8cd9_5:

    # voice 'voices/suzy_8_6.mp3'
    voice 'voices/suzy_8_6.mp3'

# game/Scenes/Suzy/suzy8.rpy:64
translate turkish suzy8_b9711d8f:

    # ss "I've had a bad night, but I know you were just trying to be nice."
    ss "Kötü bir gece geçirdim, ama senin sadece nazik olmaya çalıştığını biliyorum."

# game/Scenes/Suzy/suzy8.rpy:65
translate turkish suzy8_90fab666:

    # pc "It's okay, [sis]. What's wrong?"
    pc "Sorun değil, [sis]. Ne oldu?"

# game/Scenes/Suzy/suzy8.rpy:67
translate turkish suzy8_d41d8cd9_6:

    # voice 'voices/suzy_8_7.mp3'
    voice 'voices/suzy_8_7.mp3'

# game/Scenes/Suzy/suzy8.rpy:68
translate turkish suzy8_4305e5a4:

    # ss "Can I lie next to you?"
    ss "Yanına uzanabilir miyim?"

# game/Scenes/Suzy/suzy8.rpy:69
translate turkish suzy8_61f77a4c:

    # pc "Sure."
    pc "Tabii."

# game/Scenes/Suzy/suzy8.rpy:70
translate turkish suzy8_c4dd6e9c:

    # "I slide over on the bed a little, giving her a space to lie down."
    "Yatağın üzerinde biraz kayarak ona uzanması için yer açtım."

# game/Scenes/Suzy/suzy8.rpy:73
translate turkish suzy8_51a02d64:

    # "She slips into the bed with me, not just lying next to me, but cuddling up against me. I'm a little surprised at the touch of her body pressed against me."
    "Yatağa yanıma süzüldü, sadece yanıma uzanmakla kalmadı, bana sarıldı. Vücudunun bana değmesi beni biraz şaşırttı."

# game/Scenes/Suzy/suzy8.rpy:74
translate turkish suzy8_7a7490da:

    # "She's warm and soft and looks at me with red teary eyes."
    "Sıcak ve yumuşaktı, kırmızı ve yaş dolu gözlerle bana bakıyordu."

# game/Scenes/Suzy/suzy8.rpy:75
translate turkish suzy8_804e854c:

    # ss "Tim and I broke up."
    ss "Tim'le ayrıldık."

# game/Scenes/Suzy/suzy8.rpy:76
translate turkish suzy8_51e926b3:

    # pc "Tim? This is the guy from Whiterock that you've been talking to every night?"
    pc "Tim mi? Her gece konuştuğun Whiterock'taki çocuk mu?"

# game/Scenes/Suzy/suzy8.rpy:77
translate turkish suzy8_b6bbe555:

    # ss "Yeah. We'd been dating since high school."
    ss "Evet. Lise yıllarından beri çıkıyorduk."

# game/Scenes/Suzy/suzy8.rpy:78
translate turkish suzy8_7bf1d93a:

    # ss "But trying to stay together long-distance was stupid. I knew he would do this!"
    ss "Ama uzun mesafeli bir ilişkiyi sürdürmeye çalışmak aptalcaydı. Bunu yapacağını biliyordum!"

# game/Scenes/Suzy/suzy8.rpy:79
translate turkish suzy8_daef8fe7:

    # pc "Do what?"
    pc "Neyi?"

# game/Scenes/Suzy/suzy8.rpy:81
translate turkish suzy8_f1148738:

    # ss "Cheat on me!"
    ss "Beni aldatmayı!"

# game/Scenes/Suzy/suzy8.rpy:82
translate turkish suzy8_233ab277:

    # pc "He cheated on you?"
    pc "Seni mi aldattı?"

# game/Scenes/Suzy/suzy8.rpy:83
translate turkish suzy8_3c1bf98f:

    # ss "Yeah, some skank posted a picture of him with her on Instagram and tagged him in it."
    ss "Evet, Instagram'da bir sürtük onunla çekilmiş bir fotoğrafını paylaşmış ve onu etiketlemiş."

# game/Scenes/Suzy/suzy8.rpy:84
translate turkish suzy8_9196b394:

    # ss "I called Tammy's house to talk to her about it, but she wasn't home. I didn't know what I should do."
    ss "Bu konuyu konuşmak için Tammy'nin evini aradım ama evde değildi. Ne yapmam gerektiğini bilmiyordum."

# game/Scenes/Suzy/suzy8.rpy:85
translate turkish suzy8_3754064d:

    # ss "So I called Tim and questioned him about it and he denied everything, but when I told him that I'd seen the picture he broke down and told me that he had sex with her."
    ss "Ben de Tim'i aradım ve ona bu konuyu sordum; o her şeyi inkar etti, ama fotoğrafı gördüğümü söylediğimde çöktü ve onunla yattığını itiraf etti."

# game/Scenes/Suzy/suzy8.rpy:86
translate turkish suzy8_e7180c58:

    # ss "So I told him to go to hell and hung up on him."
    ss "Ben de ona cehenneme gitmesini söyledim ve telefonu yüzüne kapattım."

# game/Scenes/Suzy/suzy8.rpy:88
translate turkish suzy8_c8c75712:

    # ss "But now, instead of feeling better, I just feel so much worse."
    ss "Ama şimdi, kendimi daha iyi hissetmek yerine, çok daha kötü hissediyorum."

# game/Scenes/Suzy/suzy8.rpy:89
translate turkish suzy8_2fe34243:

    # ss "Our relationship hadn't really worked since he moved away, but now that it's over..."
    ss "O taşındığından beri ilişkimiz pek iyi gitmiyordu, ama artık bittiğine göre..."

# game/Scenes/Suzy/suzy8.rpy:90
translate turkish suzy8_84ce0886:

    # ss "I don't know, [bro]. It just hurts really bad."
    ss "Bilmiyorum, [bro]. Sadece çok acıyor."

# game/Scenes/Suzy/suzy8.rpy:91
translate turkish suzy8_559b9ecc:

    # ss "I've never broken up with anybody before. I didn't expect it to hurt this much."
    ss "Daha önce hiç kimseyle ayrılmamıştım. Bu kadar acıtacağını beklemiyordum."

# game/Scenes/Suzy/suzy8.rpy:93
translate turkish suzy8_a553b71e:

    # "She tucks her head up against my side and trembles as more tears come."
    "Başını yanıma yaslıyor ve gözyaşları akarken titriyor."

# game/Scenes/Suzy/suzy8.rpy:94
translate turkish suzy8_b014b603:

    # pc "I'm sorry, [sis]."
    pc "Üzgünüm, [sis]."

# game/Scenes/Suzy/suzy8.rpy:95
translate turkish suzy8_e08ad0ef:

    # pc "I know it feels bad right now, but it's probably for the best."
    pc "Şu anda kötü hissetmeni anlıyorum, ama muhtemelen en iyisi bu."

# game/Scenes/Suzy/suzy8.rpy:96
translate turkish suzy8_e73cd5d7:

    # pc "Most people don't end up with their high school sweethearts. You'll find somebody that's better for you."
    pc "Çoğu insan lise aşkıyla birlikte kalmaz. Senin için daha uygun birini bulacaksın."

# game/Scenes/Suzy/suzy8.rpy:97
translate turkish suzy8_5eb5f8a8:

    # pc "Then you'll wonder how you ever thought that Tom, or whatever his name is, was the one."
    pc "O zaman Tom'un, ya da adı her neyse, nasıl onun \"hayatının aşkı\" olduğunu düşünebildiğini merak edeceksin."

# game/Scenes/Suzy/suzy8.rpy:98
translate turkish suzy8_7bf6f4af:

    # "She trembles against me, shaking as she weeps."
    "Bana yaslanarak titriyor, ağlarken sallanıyor."

# game/Scenes/Suzy/suzy8.rpy:99
translate turkish suzy8_f047fac6:

    # "I decide it's better if I don't say anything else and just let her cry it out, holding her close."
    "Başka bir şey söylemememin ve onu sıkıca sararak ağlamasına izin vermemin daha iyi olacağına karar veriyorum."

# game/Scenes/Suzy/suzy8.rpy:100
translate turkish suzy8_b99cb9a8:

    # "After a few minutes of silence, except for her occasional whimpers, she pulls back and looks up at me."
    "Birkaç dakikalık sessizliğin ardından — ara sıra çıkan hıçkırıkları dışında — benden uzaklaşıp bana bakıyor."

# game/Scenes/Suzy/suzy8.rpy:103
translate turkish suzy8_d41d8cd9_7:

    # voice 'voices/suzy_8_8.mp3'
    voice 'voices/suzy_8_8.mp3'

# game/Scenes/Suzy/suzy8.rpy:104
translate turkish suzy8_e8f9747e:

    # ss "Thank you for being here for me."
    ss "Benim için burada olduğun için teşekkür ederim."

# game/Scenes/Suzy/suzy8.rpy:105
translate turkish suzy8_3bd2626a:

    # pc "Suzy, I'm always going to be there for you."
    pc "Suzy, ben her zaman senin yanında olacağım."

# game/Scenes/Suzy/suzy8.rpy:107
translate turkish suzy8_3c9076c4:

    # "Something about me saying that seems to completely break her. Her face crumples once again and tears stream out."
    "Bu sözlerimi duyması onu tamamen çökertmiş gibi görünüyor. Yüzü bir kez daha buruşuyor ve gözyaşları sel gibi akıyor."

# game/Scenes/Suzy/suzy8.rpy:109
translate turkish suzy8_1bb37682:

    # "She tucks her head in again and holds me even tighter."
    "Başını tekrar göğsüme gömüyor ve bana daha da sıkı sarılıyor."

# game/Scenes/Suzy/suzy8.rpy:111
translate turkish suzy8_d41d8cd9_8:

    # voice 'voices/suzy_8_9.mp3'
    voice 'voices/suzy_8_9.mp3'

# game/Scenes/Suzy/suzy8.rpy:112
translate turkish suzy8_1696615b:

    # ss "I love you so much."
    ss "Seni çok seviyorum."

# game/Scenes/Suzy/suzy8.rpy:113
translate turkish suzy8_70777701:

    # pc "I love you too, Suzy."
    pc "Ben de seni seviyorum, Suzy."

# game/Scenes/Suzy/suzy8.rpy:114
translate turkish suzy8_f2c77bc3:

    # "She starts crying again and it's like she'll never stop. I just hold her, comforting her. Words won't help anymore."
    "Yine ağlamaya başlıyor ve sanki hiç durmayacakmış gibi. Ben sadece onu kucaklayıp teselli ediyorum. Artık sözler bir işe yaramıyor."

# game/Scenes/Suzy/suzy8.rpy:117
translate turkish suzy8_e9cb8773:

    # "Then eventually, her tremblings stop, her breathing slows down, her muscles relax, and she falls asleep on my tear-soaked shoulder."
    "Sonunda titremeleri duruyor, nefes alışı yavaşlıyor, kasları gevşiyor ve gözyaşlarıyla ıslanmış omzumda uykuya dalıyor."

# game/Scenes/Suzy/suzy8.rpy:118
translate turkish suzy8_8b966f13:

    # "I can't just make her leave now. I guess this is where she's going to be sleeping tonight."
    "Onu şimdi öylece gönderemem. Sanırım bu gece burada uyuyacak."

# game/Scenes/Suzy/suzy8.rpy:120
translate turkish suzy8_c8e2b53e:

    # "I lean in slightly, trying not to wake her as I kiss her forehead."
    "Onu uyandırmamaya çalışarak hafifçe eğilip alnına bir öpücük konduruyorum."

# game/Scenes/Suzy/suzy8.rpy:121
translate turkish suzy8_19c63ea8:

    # pc "Good night, [sis]."
    pc "İyi geceler, [sis]."

# game/Scenes/Suzy/suzy8.rpy:124
translate turkish suzy8_082a9804:

    # "I close my eyes and fall asleep shortly after."
    "Gözlerimi kapatıyorum ve kısa süre sonra uykuya dalıyorum."

# game/Scenes/Suzy/suzy8.rpy:127
translate turkish suzy8_df28f076:

    # "I sleep through the night and wake in the morning to see that Suzy is already gone."
    "Bütün gece uyuyorum ve sabah uyandığımda Suzy’nin çoktan gitmiş olduğunu görüyorum."

# game/Scenes/Suzy/suzy8.rpy:128
translate turkish suzy8_2c293479:

    # "Hungry, I walk down the stairs towards the kitchen. Lisa must be in there cooking, because the lovely aroma of bacon and coffee fills the house."
    "Karnım aç, merdivenlerden aşağı inip mutfağa doğru yürüyorum. Lisa orada yemek pişiriyor olmalı, çünkü evi domuz pastırması ve kahvenin hoş kokusu dolduruyor."

# game/Scenes/Suzy/suzy8.rpy:131
translate turkish suzy8_b3009ba0:

    # "To my surprise, Suzy stands in the kitchen over the stove, finishing up some scrambled eggs."
    "Sürpriz bir şekilde, Suzy mutfakta ocağın başında durmuş, omleti bitiriyor."

# game/Scenes/Suzy/suzy8.rpy:132
translate turkish suzy8_fe0bdf4c:

    # pc "Good morning."
    pc "Günaydın."

# game/Scenes/Suzy/suzy8.rpy:133
translate turkish suzy8_9f60b44f:

    # ss "Oh hey, [bro]. Good morning. I'm just finishing up breakfast, one sec."
    ss "Oh hey, [bro]. Günaydın. Kahvaltıyı bitiriyorum, bir saniye."

# game/Scenes/Suzy/suzy8.rpy:134
translate turkish suzy8_6fd0f2a2:

    # pc "You're making breakfast? Should I be concerned?"
    pc "Kahvaltı mı hazırlıyorsun? Endişelenmeli miyim?"

# game/Scenes/Suzy/suzy8.rpy:135
translate turkish suzy8_74ef00b6:

    # ss "No, dummy. I just wanted to thank you for being there for me last night."
    ss "Hayır, şapşal. Sadece dün gece yanımda olduğun için sana teşekkür etmek istedim."

# game/Scenes/Suzy/suzy8.rpy:136
translate turkish suzy8_68230377:

    # "She moves the skillet off the burner, then turns towards me."
    "Tavayı ocaktan indirip bana doğru dönüyor."

# game/Scenes/Suzy/suzy8.rpy:139
translate turkish suzy8_75c6023a:

    # "She approaches me and wraps her arms around my neck, pressing her body softly against mine as she hugs me."
    "Bana yaklaşıp kollarını boynuma doluyor, sarılırken vücudunu nazikçe bana yaslıyor."

# game/Scenes/Suzy/suzy8.rpy:140
translate turkish suzy8_5a3c462c:

    # ss "Thank you so much for last night, [bro]."
    ss "Dün gece için çok teşekkür ederim, [bro]."

# game/Scenes/Suzy/suzy8.rpy:141
translate turkish suzy8_c346adf7:

    # ss "I needed somebody and you were there for me, being exactly what I needed you to be."
    ss "Birine ihtiyacım vardı ve sen yanımdaydın, tam da ihtiyacım olan kişi oldun."

# game/Scenes/Suzy/suzy8.rpy:142
translate turkish suzy8_a33a0068:

    # ss "You're the best [brother] I could have ever wanted and I'm so glad that you're here for me."
    ss "Sen, [brother] isteyebileceğim en iyi kişisin ve benim için burada olduğun için çok mutluyum."

# game/Scenes/Suzy/suzy8.rpy:143
translate turkish suzy8_f6bdc399:

    # pc "You're welcome, Suzy."
    pc "Rica ederim, Suzy."

# game/Scenes/Suzy/suzy8.rpy:146
translate turkish suzy8_7fc29466:

    # ss "So, I made you breakfast. Bacon, eggs, and toast. Plus there's coffee in the machine."
    ss "Sana kahvaltı hazırladım. Pastırma, yumurta ve kızarmış ekmek. Ayrıca makinede kahve de var."

# game/Scenes/Suzy/suzy8.rpy:147
translate turkish suzy8_436cf0ff:

    # pc "Thanks, [sis]. That sounds great."
    pc "Teşekkürler, [sis]. Kulağa harika geliyor."

# game/Scenes/Suzy/suzy8.rpy:148
translate turkish suzy8_c1cdd033:

    # ss "I hope you enjoy. I have to run though."
    ss "Umarım beğenirsin. Ama acele etmem lazım."

# game/Scenes/Suzy/suzy8.rpy:149
translate turkish suzy8_e16ffc7e:

    # ss "Going to meet Tammy at Java Lava to talk about everything that happened last night."
    ss "Dün gece olan biten her şeyi konuşmak için Java Lava'da Tammy ile buluşacağım."

# game/Scenes/Suzy/suzy8.rpy:150
translate turkish suzy8_34f75a54:

    # pc "Oh, okay."
    pc "Oh, tamam."

# game/Scenes/Suzy/suzy8.rpy:152
translate turkish suzy8_d41d8cd9_9:

    # voice 'voices/suzy_thanks1.mp3'
    voice 'voices/suzy_thanks1.mp3'

# game/Scenes/Suzy/suzy8.rpy:153
translate turkish suzy8_da613814:

    # ss "Thanks again, [bro]. Love you."
    ss "Tekrar teşekkürler, [bro]. Seni seviyorum."

# game/Scenes/Suzy/suzy8.rpy:155
translate turkish suzy8_a4a53c8e:

    # "Then, before I can say anything else, she leans in and kisses me."
