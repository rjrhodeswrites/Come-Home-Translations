    "Tammy aniden yerinden sıçrar."

# game/Scenes/Suzy/suzy11.rpy:313
translate turkish suzy11_440a1583:

    # tm "What time is it!?"
    tm "Saat kaç!?"

# game/Scenes/Suzy/suzy11.rpy:314
translate turkish suzy11_b26ce21e:

    # pc "Alarm goes off at 7."
    pc "Alarm 7'de çalıyor."

# game/Scenes/Suzy/suzy11.rpy:315
translate turkish suzy11_bf43f931:

    # tm "Fuck, I'm late. I'm late. I'm LATE!"
    tm "Kahretsin, geç kaldım. Geç kaldım. GEÇ KALDIM!"

# game/Scenes/Suzy/suzy11.rpy:318
translate turkish suzy11_25d3dce5:

    # "While Tammy frantically dashes to the bathroom, Suzy leans over and presses her lips against mine."
    "Tammy telaşla tuvalete koşarken, Suzy eğilip dudaklarını benimkilere bastırıyor."

# game/Scenes/Suzy/suzy11.rpy:319
translate turkish suzy11_191969e9:

    # ss "Good morning, [bro]."
    ss "Günaydın, [bro]."

# game/Scenes/Suzy/suzy11.rpy:320
translate turkish suzy11_0cf9a8ef:

    # pc "Morning, [sis]."
    pc "Günaydın, [sis]."

# game/Scenes/Suzy/suzy11.rpy:321
translate turkish suzy11_13299fee:

    # ss "I'm going to go get some breakfast before school. Love you."
    ss "Okula gitmeden önce kahvaltı yapacağım. Seni seviyorum."

# game/Scenes/Suzy/suzy11.rpy:322
translate turkish suzy11_ce2ae2bf:

    # pc "Love you too."
    pc "Ben de seni seviyorum."

# game/Scenes/Suzy/suzy11.rpy:325
translate turkish suzy11_c818b3f3:

    # "I sit up in bed, watching Suzy leave, wondering how I ever got so lucky."
    "Yatakta doğrulup Suzy'nin gitmesini izlerken, nasıl bu kadar şanslı olabildiğimi merak ediyorum."

# game/Scenes/Suzy/suzy11.rpy:326
translate turkish suzy11_539dfdf5:

    # "My life is completely ridiculous. But fuck, it's great."
    "Hayatım tamamen saçma sapan. Ama lanet olsun, harika."

# game/Scenes/Suzy/suzy11.rpy:329
translate turkish suzy11_b5fd2979:

    # "Tammy rushes out of the house a few moments later without saying anything else, and I get up and get ready to start another day."
    "Birkaç dakika sonra Tammy başka bir şey söylemeden evden koşar adımlarla çıkar ve ben de kalkıp yeni bir güne başlamak için hazırlanırım."

