# game/Scenes/Suzy/SuzyConversations/suzys7.rpy:14
translate turkish suzys7_279afbbd:

    # ss "Hm... I like going pretty much anywhere."
    ss "Hm... Ben hemen hemen her yere gitmeyi severim."

# game/Scenes/Suzy/SuzyConversations/suzys7.rpy:15
translate turkish suzys7_d78eee80:

    # ss "Food, movies, a concert, the beach - all of that sounds fun to me."
    ss "Yemek, sinema, konser, plaj - hepsi bana eğlenceli geliyor."

# game/Scenes/Suzy/SuzyConversations/suzys7.rpy:16
translate turkish suzys7_f40e77d8:

    # ss "Probably the beach would be my favorite though."
    ss "Ama muhtemelen en sevdiğim yer plaj olurdu."

# game/Scenes/Suzy/SuzyConversations/suzys7.rpy:18
translate turkish suzys7_e58f9a0d:

    # ss "Just a whole day of hanging out, half-naked."
    ss "Bütün gün yarı çıplak takılmak."

# game/Scenes/Suzy/SuzyConversations/suzys7.rpy:19
translate turkish suzys7_ec7049b7:

    # ss "Swimming, tanning, making out in the sand."
    ss "Yüzmek, güneşlenmek, kumda öpüşmek."

# game/Scenes/Suzy/SuzyConversations/suzys7.rpy:21
translate turkish suzys7_2da59617:

    # ss "Then at night, starting a fire, roast some hot dogs or something..."
    ss "Sonra gece, ateş yakıp sosis falan kızartmak..."

# game/Scenes/Suzy/SuzyConversations/suzys7.rpy:23
translate turkish suzys7_a1eafcca:

    # ss "Mess around under the stars."
    ss "Yıldızların altında takılmak."

# game/Scenes/Suzy/SuzyConversations/suzys7.rpy:24
translate turkish suzys7_fb86b185:

    # ss "That sounds like the perfect date to me."
    ss "Bana mükemmel bir randevu gibi geliyor."

# game/Scenes/Suzy/SuzyConversations/suzys7.rpy:25
translate turkish suzys7_c7406192:

    # pc "It does sound amazing."
    pc "Gerçekten harika geliyor."

# game/Scenes/Suzy/SuzyConversations/suzys7.rpy:28
translate turkish suzys7_ee1aba2e:

    # ss "I'm not talking about doing this with you, of course."
    ss "Tabii ki bunu seninle yapmaktan bahsetmiyorum."

# game/Scenes/Suzy/SuzyConversations/suzys7.rpy:29
translate turkish suzys7_c264ecd8:

    # pc "No?"
    pc "Hayır mı?"

# game/Scenes/Suzy/SuzyConversations/suzys7.rpy:30
translate turkish suzys7_5e236ce4:

    # ss "No! Don't be weird! You're my [brother]!"
    ss "Hayır! Garip davranma! Sen benim [brother]'msun!"

# game/Scenes/Suzy/SuzyConversations/suzys7.rpy:31
translate turkish suzys7_d61f286c:

    # pc "Of course. Sorry."
    pc "Tabii ki. Özür dilerim."

# game/Scenes/Suzy/SuzyConversations/suzys7.rpy:32
translate turkish suzys7_c5ca99d7:

    # ss "You're so weird."
    ss "Çok garipsin."

# game/Scenes/Suzy/SuzyConversations/suzys7.rpy:35
translate turkish suzys7_e5c3d854:

    # ss "We should do it sometime."
    ss "Bir ara yapmalıyız."

# game/Scenes/Suzy/SuzyConversations/suzys7.rpy:36
translate turkish suzys7_d72509a6:

    # pc "Yeah?"
    pc "Öyle mi?"

# game/Scenes/Suzy/SuzyConversations/suzys7.rpy:37
translate turkish suzys7_7ec21eae:

    # ss "Yeah, [bro]. I really want to."
    ss "Evet, [bro]. Gerçekten çok istiyorum."

# game/Scenes/Suzy/SuzyConversations/suzys7.rpy:39
translate turkish suzys7_4b248580:

    # ss "Can you imagine, me in a bikini, grinding against you in the water, until you can't take it anymore."
    ss "Düşünebiliyor musun, ben bikinili, suda sana sürtünüyorum, sen artık dayanamayana kadar."

# game/Scenes/Suzy/SuzyConversations/suzys7.rpy:40
translate turkish suzys7_99781cbe:

    # ss "Then we find a nice bit of secluded beach, and you make love to me on the sand."
    ss "Sonra tenha bir plaj buluruz ve sen kumların üzerinde benimle sevişirsin."

# game/Scenes/Suzy/SuzyConversations/suzys7.rpy:41
translate turkish suzys7_daa70775:

    # pc "Yeah, I can imagine."
    pc "Evet, hayal edebiliyorum."

# game/Scenes/Suzy/SuzyConversations/suzys7.rpy:43
translate turkish suzys7_ed37f761:

    # ss "Let's make it happen then."
    ss "O zaman bunu gerçekleştirelim."

# game/Scenes/Suzy/SuzyConversations/suzys7.rpy:44
translate turkish suzys7_13fa20ef:

    # pc "Okay. I'll see what I can do."
    pc "Tamam. Ne yapabileceğime bir bakayım."

