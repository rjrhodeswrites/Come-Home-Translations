# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:15
translate turkish suzys6_b85c3a6f:

    # ss "Tammy? She's just my best friend."
    ss "Tammy mi? O sadece en iyi arkadaşım."

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:16
translate turkish suzys6_2aecd655:

    # ss "Remember when Mom and I moved here? "
    ss "Annemle buraya taşındığımız zamanı hatırlıyor musun? "

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:17
translate turkish suzys6_fb4586c4:

    # pc "Yeah, like a year before I moved away."
    pc "Evet, ben taşınmadan yaklaşık bir yıl önceydi."

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:18
translate turkish suzys6_b65e1d99:

    # ss "Right."
    ss "Doğru."

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:19
translate turkish suzys6_7366b244:

    # ss "Well when Mom made us move here, in my first year of high school, I didn't know anybody. Didn't have any friends."
    ss "Annem lise birinci sınıfta bizi buraya taşınmaya zorladığında kimseyi tanımıyordum. Hiç arkadaşım yoktu."

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:21
translate turkish suzys6_97f68816:

    # ss "And people were really... mean."
    ss "Ve insanlar gerçekten... çok kötüydü."

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:23
translate turkish suzys6_61bbc002:

    # ss "But Tammy offered to be my friend like immediately. And we really connected."
    ss "Ama Tammy hemen arkadaşım olmayı teklif etti. Ve gerçekten çok iyi anlaştık."

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:25
translate turkish suzys6_0850d42d:

    # ss "I seriously couldn't have ever asked for a better friend."
    ss "Cidden daha iyi bir arkadaş isteyemezdim."

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:26
translate turkish suzys6_101d85a4:

    # ss "I trust her to have my back no matter what."
    ss "Ne olursa olsun arkamı kollayacağına güveniyorum."

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:27
translate turkish suzys6_fb1e566c:

    # pc "And you two are {i}just{/i} friends? Not in a relationship together or anything?"
    pc "Peki siz ikiniz {i}sadece{/i} arkadaş mısınız? Bir ilişkiniz falan yok mu?"

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:29
translate turkish suzys6_d5ba910e:

    # ss "What? No! We're just friends!"
    ss "Ne? Hayır! Biz sadece arkadaşız!"

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:32
translate turkish suzys6_ec9e0772:

    # ss "I mean... yeah, we've messed around a little."
    ss "Yani... evet, biraz flört ettik."

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:33
translate turkish suzys6_9b0c7d7c:

    # ss "But I'm more into guys. She is too."
    ss "Ama ben daha çok erkeklerden hoşlanıyorum. O da öyle."

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:34
translate turkish suzys6_1da2427d:

    # ss "Sometimes we play around just to make each other feel good, you know?"
    ss "Bazen sadece birbirimizi mutlu etmek için takılıyoruz, anlarsın ya?"

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:35
translate turkish suzys6_7f8fa094:

    # ss "But we're not \"together\"."
    ss "Ama \"birlikte\" değiliz."

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:37
translate turkish suzys6_f73254cd:

    # ss "Just very close friends."
    ss "Sadece çok yakın arkadaşız."

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:38
translate turkish suzys6_859381b9:

    # ss "She's the best."
    ss "O en iyisi."

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:41
translate turkish suzys6_58218f85:

    # ss "Good. Because her and I are going to be best friends forever. I can't see anything changing that."
    ss "Güzel. Çünkü o ve ben sonsuza kadar en iyi arkadaş olacağız. Bunun değişeceğini sanmıyorum."

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:43
translate turkish suzys6_93bcef24:

    # pc "I don't mind her, but I wish it could just be you and me."
    pc "Ona karşı bir şeyim yok, ama keşke sadece sen ve ben olsaydık."

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:45
translate turkish suzys6_38ad91a5:

    # ss "I'm always going to be friends with her, but I don't think there will be a problem if you want to have some alone time with me."
    ss "Onunla her zaman arkadaş kalacağım, ama benimle baş başa vakit geçirmek istersen bir sorun olacağını sanmıyorum."

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:46
translate turkish suzys6_79beaa9c:

    # ss "We'll have plenty of opportunities for that."
    ss "Bunun için bolca fırsatımız olacak."

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:47
translate turkish suzys6_8bc0e4b2:

    # pc "I'm looking forward to that."
    pc "Bunu sabırsızlıkla bekliyorum."

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:49
translate turkish suzys6_6025131e:

    # pc "Oh okay. I just wasn't sure."
    pc "Ah tamam. Sadece emin olamamıştım."

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:51
translate turkish suzys6_06f182f0:

    # ss "Well stop being weird, asking questions like that."
    ss "O zaman böyle tuhaf sorular sorup garip davranmayı kes."

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:52
translate turkish suzys6_3e0e6bad:

    # pc "I'm not being weird."
    pc "Garip davranmıyorum ki."

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:53
translate turkish suzys6_e3166501:

    # ss "You are! It's weird."
    ss "Evet, garip davranıyorsun! Bu tuhaf."

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:54
translate turkish suzys6_8c25c5d7:

    # pc "Okay, sorry!"
    pc "Tamam, özür dilerim!"

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:55
translate turkish suzys6_4c43a3f7:

    # ss "Okay then."
    ss "Peki o zaman."

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:58
translate turkish suzys6_dd3631f5:

    # ss "What do you mean, [bro]? We talked about this. She's our girlfriend."
    ss "Ne demek istiyorsun, [bro]? Bunu konuşmuştuk. O bizim kız arkadaşımız."

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:59
translate turkish suzys6_e2dda045:

    # ss "She's super sexy and sweet and I love her."
    ss "O çok seksi ve tatlı, onu seviyorum."

# game/Scenes/Suzy/SuzyConversations/suzys6.rpy:60
translate turkish suzys6_624526ec:

    # ss "Just thinking about her is making me hot right now."
    ss "Şu anda sadece onu düşünmek bile beni tahrik ediyor."

translate turkish strings:

    # game/Scenes/Suzy/SuzyConversations/suzys6.rpy:40
    old "Yeah, I think she's great too"
    new "Evet, bence o da harika"

    # game/Scenes/Suzy/SuzyConversations/suzys6.rpy:42
    old "She's okay"
    new "Fena değil"

