# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:16
translate turkish suzytammygrottodate_edef91a3:

    # "We get ready and go out to The Grotto together."
    "Hazırlanıp birlikte The Grotto'ya gidiyoruz."

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:19
translate turkish suzytammygrottodate_a118cb72:

    # ss "I love this place."
    ss "Burayı çok seviyorum."

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:21
translate turkish suzytammygrottodate_f556393a:

    # tm "Me too. Thanks for taking us, [pcname]."
    tm "Ben de. Bizi buraya getirdiğin için teşekkürler, [pcname]."

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:23
translate turkish suzytammygrottodate_ad1121f0:

    # ss "Yeah, thanks [bro]."
    ss "Evet, teşekkürler [bro]."

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:25
translate turkish suzytammygrottodate_a91a4522:

    # "We chat while we eat and enjoy the atmosphere."
    "Yemek yerken sohbet ediyoruz ve atmosferin tadını çıkarıyoruz."

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:33
translate turkish suzytammygrottodate_a306e385:

    # "After we eat, we dance to a couple of songs."
    "Yemeğimizi bitirdikten sonra birkaç şarkı eşliğinde dans ediyoruz."

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:36
translate turkish suzytammygrottodate_ffb49b98:

    # "Fuck, they're gorgeous. I can't help but to stare at them and wonder how I got to be so lucky."
    "Vay canına, ne kadar güzeller. Onlara bakmaktan kendimi alamıyorum ve nasıl bu kadar şanslı olabildiğimi merak ediyorum."

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:39
translate turkish suzytammygrottodate_7909898e:

    # ss "You ready to take us home, [bro]?"
    ss "Bizi eve götürmeye hazır mısın, [bro]?"

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:40
translate turkish suzytammygrottodate_3dae9d31:

    # pc "Uh, yeah... we should go."
    pc "Şey, evet... gitmeliyiz."

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:46
translate turkish suzytammygrottodate_d41d8cd9:

    # voice 'voices/suzy_enditproperly.mp3'
    voice 'voices/suzy_enditproperly.mp3'

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:47
translate turkish suzytammygrottodate_643c2201:

    # ss "Looks like Mom is already asleep. So, do you want to end the date here, or head up to your room and end it properly?"
    ss "Anlaşılan annem çoktan uykuya dalmış. Peki, randevuyu burada bitirmek mi istersin, yoksa odana çıkıp düzgünce bitirmek mi?"

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:50
translate turkish suzytammygrottodate_df8719cf:

    # tm "Fuck yes."
    tm "Kesinlikle evet."

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:53
translate turkish suzytammygrottodate_621e1461:

    # "We quietly walk upstairs together, go into my bedroom, and lock the door."
    "Sessizce birlikte yukarı çıkıyoruz, yatak odama giriyoruz ve kapıyı kilitliyoruz."

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:58
translate turkish suzytammygrottodate_acfb634b:

    # ss "Okay, well I had a fun date, [bro]."
    ss "Tamam, ben eğlenceli bir randevu geçirdim, [bro]."

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:59
translate turkish suzytammygrottodate_be17834a:

    # tm "Yeah, me too."
    tm "Evet, ben de."

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:60
translate turkish suzytammygrottodate_644a5289:

    # ss "Sleep well. See you tomorrow."
    ss "İyi uykular. Yarın görüşürüz."

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:61
translate turkish suzytammygrottodate_d35669a0:

    # tm "Good night, [pcname]."
    tm "İyi geceler, [pcname]."

# game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:64
translate turkish suzytammygrottodate_d747330a:

    # "They go up to Suzy's bedroom, leaving me to decide what I want to do with my night."
    "Suzy'nin yatak odasına çıkıyorlar, geceyi nasıl geçireceğime karar vermek bana kalıyor."

translate turkish strings:

    # game/Scenes/Suzy/SuzyDates/suzytammygrottodate.rpy:2
    old "This date unlocks automatically."
    new "Bu randevu otomatik olarak açılır."

