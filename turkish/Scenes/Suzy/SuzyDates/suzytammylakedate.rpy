translate turkish suzytammylakedate_2a690dca:

    # "When the girls are ready, we drive out to the lake together."
    "Kızlar hazır olduğunda, birlikte göle doğru yola çıkıyoruz."

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:19
translate turkish suzytammylakedate_80ba5381:

    # ss "Wow. We have the whole place to ourselves?"
    ss "Vay canına. Bütün burası bize mi kaldı?"

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:20
translate turkish suzytammylakedate_126ea9d5:

    # pc "Yeah, people don't come out here too often."
    pc "Evet, insanlar buraya pek sık gelmez."

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:21
translate turkish suzytammylakedate_2949eaf8:

    # tm "So we can skinny dip?"
    tm "Yani çıplak yüzebilir miyiz?"

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:22
translate turkish suzytammylakedate_f06980a5:

    # pc "If you want."
    pc "İstersen tabii."

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:23
translate turkish suzytammylakedate_8fc077c4:

    # ss "Fuck yeah!"
    ss "Tabii ki!"

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:27
translate turkish suzytammylakedate_5f7a3d7d:

    # "We go out to the pier and they strip out of their clothes."
    "İskeleye gidiyoruz ve kıyafetlerini çıkarıyorlar."

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:28
translate turkish suzytammylakedate_dfc0bda7:

    # "Goddamn they're gorgeous."
    "Vay canına, ne kadar da güzeller."

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:29
translate turkish suzytammylakedate_9757683f:

    # tm "Well, come on, [pcname]. Take your clothes off."
    tm "Hadi ama, [pcname]. Kıyafetlerini çıkar."

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:30
translate turkish suzytammylakedate_9fdfdc3e:

    # ss "Yeah, [bro]. Let's see those frank and beans."
    ss "Evet, [bro]. Hadi şu sosis ve fasulyeleri görelim."

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:33
translate turkish suzytammylakedate_a648d8e6:

    # tm "Haha, frank and beans? Such a dork."
    tm "Haha, sosis ve fasulye mi? Ne salak."

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:34
translate turkish suzytammylakedate_04dcc7c0:

    # ss "Hey! Don't call me a dork!"
    ss "Hey! Bana salak deme!"

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:35
translate turkish suzytammylakedate_022e3346:

    # tm "What are you going to do about it, skinny?"
    tm "Ne yapacaksın peki, sıska?"

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:38
translate turkish suzytammylakedate_4508b549:

    # tm "Aah!"
    tm "Aah!"

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:41
translate turkish suzytammylakedate_5e934eef:

    # "They hit the water with a huge splash, then come up laughing."
    "Suya büyük bir sıçrama yaparak daldılar, sonra gülerek su yüzüne çıktılar."

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:42
translate turkish suzytammylakedate_a94b5451:

    # tm "Frank and beans!"
    tm "Sosis ve fasulye!"

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:43
translate turkish suzytammylakedate_66181e46:

    # ss "Come on, [bro]! Get in here before I drown this bitch."
    ss "Hadi ama, [bro]! Bu kaltağı boğmadan buraya gel."

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:46
translate turkish suzytammylakedate_d8760576:

    # "I jump into the water with them and we swim together for a while, chatting as we laugh and relax in the water."
    "Onlarla birlikte suya atlıyorum ve bir süre birlikte yüzüyoruz, suda gülüp rahatlarken sohbet ediyoruz."

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:54
translate turkish suzytammylakedate_743c8f80:

    # "When the sun starts to set, we sit on the pier to dry off together."
    "Güneş batmaya başladığında, birlikte kurulanmak için iskeleye oturuyoruz."

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:56
translate turkish suzytammylakedate_f28b8c70:

    # ss "I better not get any splinters in my butt sitting on this thing."
    ss "Bu şeye otururken kıçıma kıymık batmasa iyi olur."

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:57
translate turkish suzytammylakedate_4c128477:

    # tm "Aw, if you do baby, I'll pull them out. With my teeth."
    tm "Ah, batarsa bebeğim, ben çıkarırım. Dişlerimle."

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:58
translate turkish suzytammylakedate_7294518d:

    # ss "I'm not sure if that's sexy or not."
    ss "Bunun seksi olup olmadığından emin değilim."

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:59
translate turkish suzytammylakedate_07157d28:

    # pc "It is."
    pc "Öyle."

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:63
translate turkish suzytammylakedate_4b1e3586:

    # tm "This was really fun."
    tm "Bu gerçekten eğlenceliydi."

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:64
translate turkish suzytammylakedate_ad1121f0:

    # ss "Yeah, thanks [bro]."
    ss "Evet, teşekkürler [bro]."

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:65
translate turkish suzytammylakedate_088b071d:

    # ss "Are you ready to take this date back to the house?"
    ss "Bu randevuyu eve taşımaya hazır mısın?"

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:66
translate turkish suzytammylakedate_a400a310:

    # pc "Sure, let's go home."
    pc "Tabii, hadi eve gidelim."

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:72
translate turkish suzytammylakedate_d41d8cd9:

    # voice 'voices/suzy_enditproperly.mp3'
    voice 'voices/suzy_enditproperly.mp3'

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:73
translate turkish suzytammylakedate_643c2201:

    # ss "Looks like Mom is already asleep. So, do you want to end the date here, or head up to your room and end it properly?"
    ss "Anlaşılan annem çoktan uykuya dalmış. Peki, randevuyu burada bitirmek mi istersin, yoksa odana çıkıp düzgünce bitirmek mi?"

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:76
translate turkish suzytammylakedate_df8719cf:

    # tm "Fuck yes."
    tm "Kesinlikle evet."

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:79
translate turkish suzytammylakedate_60c94072:

    # "We quietly go upstairs together, go into my bedroom, and lock the door."
    "Sessizce birlikte yukarı çıkıyoruz, yatak odama giriyoruz ve kapıyı kilitliyoruz."

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:83
translate turkish suzytammylakedate_acfb634b:

    # ss "Okay, well I had a fun date, [bro]."
    ss "Tamam, ben de eğlenceli bir randevu geçirdim, [bro]."

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:84
translate turkish suzytammylakedate_be17834a:

    # tm "Yeah, me too."
    tm "Evet, ben de."

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:85
translate turkish suzytammylakedate_644a5289:

    # ss "Sleep well. See you tomorrow."
    ss "İyi uykular. Yarın görüşürüz."

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:86
translate turkish suzytammylakedate_d35669a0:

    # tm "Good night, [pcname]."
    tm "İyi geceler, [pcname]."

# game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:89
translate turkish suzytammylakedate_d747330a:

    # "They go up to Suzy's bedroom, leaving me to decide what I want to do with my night."
    "Suzy'nin yatak odasına çıkıyorlar, geceyi nasıl geçireceğime karar vermek bana kalıyor."

translate turkish strings:

    # game/Scenes/Suzy/SuzyDates/suzytammylakedate.rpy:6
    old "Then after Tammy is living with you, you can invite them to the lake in the evening."
