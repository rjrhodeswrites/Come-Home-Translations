# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:18
translate turkish suzytammyicecreamdate_4ffc27b3:

    # "When Suzy is ready, we leave and meet Tammy at the ice cream parlor."
    "Suzy hazır olduğunda çıkıp dondurmacıda Tammy ile buluşuyoruz."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:21
translate turkish suzytammyicecreamdate_52a33e67:

    # ss "Oh my God, they have coconut. I want that please."
    ss "Aman Tanrım, hindistan cevizi var. Lütfen ondan istiyorum."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:22
translate turkish suzytammyicecreamdate_26a56ba4:

    # tm "I'll get the cappuccino chocolate chunk frozen yogurt."
    tm "Ben çikolata parçacıklı kapuçino dondurulmuş yoğurt alacağım."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:23
translate turkish suzytammyicecreamdate_4dc17a69:

    # ss "Don't you get enough coffee at work? I kinda hate the smell of it now."
    ss "İş yerinde yeterince kahve içmiyor musun? Artık kokusundan biraz nefret ediyorum."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:24
translate turkish suzytammyicecreamdate_d1ff38f6:

    # tm "I think I'm the opposite. I love it. The smell, the taste, everything."
    tm "Sanırım ben tam tersiyim. Ben bayılıyorum. Kokusuna, tadına, her şeyine."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:25
translate turkish suzytammyicecreamdate_10f4b187:

    # ss "Blech!"
    ss "İğrenç!"

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:31
translate turkish suzytammyicecreamdate_a716a63e:

    # "We sit down and enjoy our ice cream and chat for a while."
    "Oturup dondurmamızın tadını çıkarır ve bir süre sohbet ederiz."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:39
translate turkish suzytammyicecreamdate_d478079d:

    # "When the ice cream is gone, our conversation slows down."
    "Dondurma bittiğinde sohbetimiz yavaşlar."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:41
translate turkish suzytammyicecreamdate_76de8536:

    # tm "Well, it's getting late. I better head home."
    tm "Eh, geç oluyor. Eve gitsem iyi olacak."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:43
translate turkish suzytammyicecreamdate_6e8b8aa4:

    # ss "Aw, you don't want to come back to the house with us?"
    ss "Ah, bizimle eve gelmek istemiyor musun?"

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:44
translate turkish suzytammyicecreamdate_a1afa737:

    # tm "I can't, baby. Sorry."
    tm "Gelemem, bebeğim. Üzgünüm."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:49
translate turkish suzytammyicecreamdate_7661b3c0:

    # tm "I had fun though. Love you both. Have a good night without me."
    tm "Yine de eğlendim. İkinizi de seviyorum. Bensiz iyi geceler."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:52
translate turkish suzytammyicecreamdate_38516bbc:

    # ss "Oh, we will."
    ss "Oh, olur tabii."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:53
translate turkish suzytammyicecreamdate_fb8e986c:

    # pc "But not as much fun as if you were there too."
    pc "Ama sen de olsaydın daha eğlenceli olurdu."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:56
translate turkish suzytammyicecreamdate_05f57ea7:

    # "Tammy leaves, then Suzy and I drive back home."
    "Tammy ayrılır, sonra Suzy ve ben eve geri döneriz."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:61
translate turkish suzytammyicecreamdate_d41d8cd9:

    # voice 'voices/suzy_enditproperly.mp3'
    voice 'voices/suzy_enditproperly.mp3'

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:62
translate turkish suzytammyicecreamdate_643c2201:

    # ss "Looks like Mom is already asleep. So, do you want to end the date here, or head up to your room and end it properly?"
    ss "Anlaşılan annem çoktan uykuya dalmış. Peki, randevuyu burada bitirmek mi istersin, yoksa odana çıkıp düzgün bir şekilde bitirmek mi?"

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:65
translate turkish suzytammyicecreamdate_b9e9893b:

    # ss "I was hoping you would say that."
    ss "Tam da bunu söyleyeceğini umuyordum."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:68
translate turkish suzytammyicecreamdate_60c94072:

    # "We quietly go upstairs together, go into my bedroom, and lock the door."
    "Sessizce birlikte yukarı çıkarız, yatak odama gireriz ve kapıyı kilitleriz."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:71
translate turkish suzytammyicecreamdate_acfb634b:

    # ss "Okay, well I had a fun date, [bro]."
    ss "Tamam, peki, eğlenceli bir randevuydu, [bro]."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:72
translate turkish suzytammyicecreamdate_1fea12f8:

    # ss "Sleep well. I'll see you tomorrow."
    ss "İyi uykular. Yarın görüşürüz."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:79
translate turkish suzytammyicecreamdate_65007bab:

    # tm "I don't know about you two, but I'm ready to head back home."
    tm "Sizi bilmem ama ben eve dönmeye hazırım."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:80
translate turkish suzytammyicecreamdate_f89287b0:

    # ss "That sounds good to me. You ready to take this date back to the house, [bro]?"
    ss "Bana uyar. Bu randevuyu eve taşımaya hazır mısın, [bro]?"

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:81
translate turkish suzytammyicecreamdate_a400a310:

    # pc "Sure, let's go home."
    pc "Tabii, hadi eve gidelim."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:86
translate turkish suzytammyicecreamdate_d41d8cd9_1:

    # voice 'voices/suzy_enditproperly.mp3'
    voice 'voices/suzy_enditproperly.mp3'

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:87
translate turkish suzytammyicecreamdate_643c2201_1:

    # ss "Looks like Mom is already asleep. So, do you want to end the date here, or head up to your room and end it properly?"
    ss "Anlaşılan annem çoktan uykuya dalmış. Peki, randevuyu burada bitirmek mi istersin, yoksa odana çıkıp düzgünce bitirmek mi?"

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:90
translate turkish suzytammyicecreamdate_df8719cf:

    # tm "Fuck yes."
    tm "Kesinlikle evet."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:93
translate turkish suzytammyicecreamdate_60c94072_1:

    # "We quietly go upstairs together, go into my bedroom, and lock the door."
    "Sessizce birlikte yukarı çıkıyoruz, yatak odama giriyoruz ve kapıyı kilitliyoruz."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:97
translate turkish suzytammyicecreamdate_acfb634b_1:

    # ss "Okay, well I had a fun date, [bro]."
    ss "Tamam, ben eğlenceli bir randevu geçirdim, [bro]."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:98
translate turkish suzytammyicecreamdate_be17834a:

    # tm "Yeah, me too."
    tm "Evet, ben de."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:99
translate turkish suzytammyicecreamdate_644a5289:

    # ss "Sleep well. See you tomorrow."
    ss "İyi uykular. Yarın görüşürüz."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:100
translate turkish suzytammyicecreamdate_d35669a0:

    # tm "Good night, [pcname]."
    tm "İyi geceler, [pcname]."

# game/Scenes/Suzy/SuzyDates/suzytammyicecreamdate.rpy:103
translate turkish suzytammyicecreamdate_d747330a:

    # "They go up to Suzy's bedroom, leaving me to decide what I want to do with my night."
    "Suzy'nin yatak odasına çıkıyorlar ve geceyi nasıl geçireceğime karar vermeyi bana bırakıyorlar."

