# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:36
translate turkish suzytammymovietheaterstartdate_f3860a9d:

    # ss "We're just kidding, [bro]. Of course you're hot."
    ss "Şaka yapıyoruz, [bro]. Tabii ki çok seksisin."

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:37
translate turkish suzytammymovietheaterstartdate_409b3f69:

    # tm "So hot."
    tm "Çok seksisin."

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:38
translate turkish suzytammymovietheaterstartdate_5e79d05d:

    # tm "Come on, stud. Let's go get a seat."
    tm "Hadi ama, yakışıklı. Gidip bir yer bulalım."

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:43
translate turkish suzytammymovietheaterstartdate_34127860:

    # tm "Come on, you two. Let's go get a seat."
    tm "Hadi ama, siz ikiniz. Gidip bir yer bulalım."

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:46
translate turkish suzytammymovietheaterstartdate_1b9a4685:

    # "We go inside, sit in the back, and chat a little while we wait for the movie to start."
    "İçeri girip arkaya oturuyoruz ve film başlamasını beklerken biraz sohbet ediyoruz."

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:51
translate turkish suzytammymovietheaterstartdate_0a5830bf:

    # "When the movie starts, we go quiet."
    "Film başladığında sessizleşiyoruz."

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:52
translate turkish suzytammymovietheaterstartdate_9748f2b9:

    # "It's a fun movie and we all have a good time."
    "Eğlenceli bir film ve hepimiz iyi vakit geçiriyoruz."

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:54
translate turkish suzytammymovietheaterstartdate_bc15d61c:

    # "When it ends, they immediately start chatting again."
    "Film bittiğinde, hemen tekrar sohbet etmeye başlıyorlar."

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:55
translate turkish suzytammymovietheaterstartdate_e583c22e:

    # tm "Oh man, that was fun."
    tm "Vay be, çok eğlenceliydi."

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:57
translate turkish suzytammymovietheaterstartdate_e24f4cc1:

    # ss "Yeah, it wasn't bad."
    ss "Evet, fena değildi."

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:59
translate turkish suzytammymovietheaterstartdate_db07307f:

    # tm "Let's hang around and talk a bit, in case there's something after the credits."
    tm "Jenerik bittikten sonra bir şey çıkarsa diye biraz daha takılıp konuşalım."

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:65
translate turkish suzytammymovietheaterstartdate_324dbe61:

    # "When the credits end, we go outside to the parking lot."
    "Jenerik bittiğinde, dışarıya, otoparka çıkıyoruz."

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:67
translate turkish suzytammymovietheaterstartdate_3bb513f5:

    # tm "Well, I better head home."
    tm "Peki, ben eve gitsem iyi olacak."

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:68
translate turkish suzytammymovietheaterstartdate_6e8b8aa4:

    # ss "Aw, you don't want to come back to the house with us?"
    ss "Ah, bizimle eve gelmek istemiyor musun?"

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:69
translate turkish suzytammymovietheaterstartdate_2850a5f0:

    # tm "I do, but I can't tonight, girl. Sorry."
    tm "İstiyorum, ama bu gece gelemem, kızım. Üzgünüm."

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:70
translate turkish suzytammymovietheaterstartdate_dc29ade0:

    # tm "You know how Steve gets."
    tm "Steve'in nasıl olduğunu bilirsin."

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:71
translate turkish suzytammymovietheaterstartdate_6aa1dad4:

    # ss "Yeah, okay."
    ss "Evet, tamam."

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:72
translate turkish suzytammymovietheaterstartdate_7661b3c0:

    # tm "I had fun though. Love you both. Have a good night without me."
    tm "Yine de eğlendim. İkinizi de seviyorum. Bensiz iyi geceler."

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:74
translate turkish suzytammymovietheaterstartdate_091d5e9d:

    # ss "Oh we will."
    ss "Oh, olur tabii."

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:77
translate turkish suzytammymovietheaterstartdate_fb8e986c:

    # pc "But not as much fun as if you were there too."
    pc "Ama sen de olsaydın daha eğlenceli olurdu."

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:79
translate turkish suzytammymovietheaterstartdate_0603477e:

    # tm "Good night you two."
    tm "İkinize de iyi geceler."

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:82
translate turkish suzytammymovietheaterstartdate_05f57ea7:

    # "Tammy leaves, then Suzy and I drive back home."
    "Tammy ayrılır, sonra Suzy ve ben eve geri döneriz."

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:85
translate turkish suzytammymovietheaterstartdate_65007bab:

    # tm "I don't know about you two, but I'm ready to head back home."
    tm "Sizi bilmem ama ben eve dönmeye hazırım."

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:86
translate turkish suzytammymovietheaterstartdate_f89287b0:

    # ss "That sounds good to me. You ready to take this date back to the house, [bro]?"
    ss "Bana uyar. Bu randevuyu eve taşımaya hazır mısın, [bro]?"

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:87
translate turkish suzytammymovietheaterstartdate_a400a310:

    # pc "Sure, let's go home."
    pc "Tabii, hadi eve gidelim."

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:92
translate turkish suzytammymovietheaterstartdate_d41d8cd9:

    # voice 'voices/suzy_enditproperly.mp3'
    voice 'voices/suzy_enditproperly.mp3'

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:93
translate turkish suzytammymovietheaterstartdate_643c2201:

    # ss "Looks like Mom is already asleep. So, do you want to end the date here, or head up to your room and end it properly?"
    ss "Anlaşılan annem çoktan uykuya dalmış. Peki, randevuyu burada bitirmek mi istersin, yoksa odana çıkıp düzgün bir şekilde bitirmek mi?"

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:96
translate turkish suzytammymovietheaterstartdate_df8719cf:

    # tm "Fuck yes."
    tm "Kesinlikle evet."

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:99
translate turkish suzytammymovietheaterstartdate_60c94072:

    # "We quietly go upstairs together, go into my bedroom, and lock the door."
    "Sessizce birlikte yukarı çıkıyoruz, yatak odama giriyoruz ve kapıyı kilitliyoruz."

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:103
translate turkish suzytammymovietheaterstartdate_acfb634b:

    # ss "Okay, well I had a fun date, [bro]."
    ss "Tamam, ben eğlenceli bir randevu geçirdim, [bro]."

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:104
translate turkish suzytammymovietheaterstartdate_be17834a:

    # tm "Yeah, me too."
    tm "Evet, ben de."

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:105
translate turkish suzytammymovietheaterstartdate_644a5289:

    # ss "Sleep well. See you tomorrow."
    ss "İyi uykular. Yarın görüşürüz."

# game/Scenes/Suzy/SuzyDates/suzytammymoviedate.rpy:106
translate turkish suzytammymovietheaterstartdate_d35669a0:

