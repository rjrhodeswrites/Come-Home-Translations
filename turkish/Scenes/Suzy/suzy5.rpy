# game/Scenes/Suzy/suzy5.rpy:16
translate turkish suzy5_3c671076:

    # "I sit down in the driver's seat and start the car, not yet decided on how I am going to spend the rest of my night."
    "Sürücü koltuğuna oturup arabayı çalıştırıyorum, gecenin geri kalanını nasıl geçireceğime henüz karar vermedim."

# game/Scenes/Suzy/suzy5.rpy:17
translate turkish suzy5_ed1fbe56:

    # "Then my phone starts buzzing."
    "Sonra telefonum titremeye başlıyor."

# game/Scenes/Suzy/suzy5.rpy:21
translate turkish suzy5_702d39f2:

    # "I'm not sure who it is, but it is a local number."
    "Kim olduğunu bilmiyorum ama yerel bir numara."

# game/Scenes/Suzy/suzy5.rpy:25
translate turkish suzy5_bea5e8cb:

    # pc "Hello?"
    pc "Alo?"

# game/Scenes/Suzy/suzy5.rpy:26
translate turkish suzy5_b1036369:

    # ss "Hey [bro], it's me, Suzy."
    ss "Selam [bro], ben Suzy."

# game/Scenes/Suzy/suzy5.rpy:27
translate turkish suzy5_813bfe8e:

    # pc "Oh hey, [sis]."
    pc "Oh selam, [sis]."

# game/Scenes/Suzy/suzy5.rpy:28
translate turkish suzy5_6cfa6df6:

    # ss "Could you help me with something please?"
    ss "Lütfen bana bir konuda yardım eder misin?"

# game/Scenes/Suzy/suzy5.rpy:29
translate turkish suzy5_77c062fa:

    # ss "I'm sitting in the supermarket parking lot and my car won't start."
    ss "Süpermarketin otoparkında oturuyorum ve arabam çalışmıyor."

# game/Scenes/Suzy/suzy5.rpy:30
translate turkish suzy5_0c01ea35:

    # ss "I don't know what to do, can you just come help me?"
    ss "Ne yapacağımı bilmiyorum, gelip bana yardım eder misin?"

# game/Scenes/Suzy/suzy5.rpy:31
translate turkish suzy5_3c4ee749:

    # pc "Sure, I'm close. I'll be there in a minute."
    pc "Tabii, buradayım. Bir dakikaya orada olurum."

# game/Scenes/Suzy/suzy5.rpy:33
translate turkish suzy5_d41d8cd9:

    # voice 'voices/suzy_thanks2.mp3'
    voice 'voices/suzy_thanks2.mp3'

# game/Scenes/Suzy/suzy5.rpy:34
translate turkish suzy5_4ce6f4f0:

    # ss "Thanks."
    ss "Teşekkürler."

# game/Scenes/Suzy/suzy5.rpy:36
translate turkish suzy5_cc61d61a:

    # "I hang up and drive over to the supermarket."
    "Telefonu kapatıp süpermarkete doğru yola çıkıyorum."

# game/Scenes/Suzy/suzy5.rpy:39
translate turkish suzy5_4e12cf19:

    # "I spot Suzy's car pretty quick and park right next to it."
    "Suzy’nin arabasını hemen görüyorum ve hemen yanına park ediyorum."

# game/Scenes/Suzy/suzy5.rpy:42
translate turkish suzy5_a60d89b8:

    # "Suzy runs up to me immediately after I step out of the car."
    "Arabadan iner inmez Suzy hemen bana doğru koşuyor."

# game/Scenes/Suzy/suzy5.rpy:43
translate turkish suzy5_96fd56fd:

    # ss "I don't know what happened!"
    ss "Ne oldu bilmiyorum!"

# game/Scenes/Suzy/suzy5.rpy:44
translate turkish suzy5_4ce21989:

    # ss "I just came out of the store after doing some shopping and it won't start!"
    ss "Alışverişimi yapıp mağazadan çıktım ama araba çalışmıyor!"

# game/Scenes/Suzy/suzy5.rpy:45
translate turkish suzy5_a56c45eb:

    # ss "I can't afford to take it to a mechanic right now. I barely make anything at Java Lava and Mom is broke."
    ss "Şu anda tamirciye götürecek param yok. Java Lava’da zar zor para kazanıyorum ve annem de meteliksiz."

# game/Scenes/Suzy/suzy5.rpy:48
translate turkish suzy5_a9852df6:

    # ss "I hope so. I don't know what I'll do if I don't have my car."
    ss "Umarım öyledir. Arabam olmazsa ne yaparım bilmiyorum."

# game/Scenes/Suzy/suzy5.rpy:50
translate turkish suzy5_1845952a:

    # ss "Will you look at it please?"
    ss "Lütfen bir bakar mısın?"

# game/Scenes/Suzy/suzy5.rpy:53
translate turkish suzy5_da8c2e7f:

    # ss "Yes, please. Fix it, [bro]."
    ss "Evet, lütfen. Tamir et, [bro]."

# game/Scenes/Suzy/suzy5.rpy:56
translate turkish suzy5_f393635e:

    # ss "I don't!"
    ss "Bilmiyorum ki!"

# game/Scenes/Suzy/suzy5.rpy:58
translate turkish suzy5_31115693:

    # ss "Can you just see if you can fix it please?"
    ss "Lütfen bir bakıp düzeltebilir misin?"

# game/Scenes/Suzy/suzy5.rpy:59
translate turkish suzy5_c3f59e51:

    # pc "Yeah, let's see what's up with it."
    pc "Evet, ne sorunu var bir bakalım."

# game/Scenes/Suzy/suzy5.rpy:60
translate turkish suzy5_4103549c:

    # ss "Thank you, [bro]. I'm freaking out."
    ss "Teşekkürler, [bro]. Deliye dönüyorum."

# game/Scenes/Suzy/suzy5.rpy:63
translate turkish suzy5_5aa7230b:

    # "I pop the hood and look inside for any problems."
    "Kaputu açıp içinde bir sorun var mı diye bakıyorum."

# game/Scenes/Suzy/suzy5.rpy:64
translate turkish suzy5_c9096016:

    # "I'm not really a mechanic or anything and only know a little about cars, but after jiggling a few wires around, I find her battery cable had slid off one of the pegs."
    "Aslında tamirci falan değilim ve arabalar hakkında çok az şey biliyorum, ama birkaç kabloyu salladıktan sonra akü kablosunun bir tutamağından kaymış olduğunu fark ettim."

# game/Scenes/Suzy/suzy5.rpy:65
translate turkish suzy5_1ffc433c:

    # "I carefully slide it back down where it is supposed to go and then use one of my keys to tighten the screw so it wouldn't fall off again."
    "Kabloyu dikkatlice olması gereken yere geri kaydırdım ve bir daha düşmemesi için anahtarlarımdan biriyle vidayı sıktım."

# game/Scenes/Suzy/suzy5.rpy:66
translate turkish suzy5_00654239:

    # pc "Go try to start it again."
    pc "Tekrar çalıştırmayı dene."

# game/Scenes/Suzy/suzy5.rpy:67
translate turkish suzy5_5c646e65:

    # ss "Okay."
    ss "Tamam."

# game/Scenes/Suzy/suzy5.rpy:70
translate turkish suzy5_11b9b96f:

    # "She gets into the driver's side and turns the key and her car starts right up again."
    "Kız sürücü koltuğuna oturdu, anahtarı çevirdi ve arabası hemen çalıştı."

# game/Scenes/Suzy/suzy5.rpy:74
translate turkish suzy5_bcd70141:

    # ss "You did it!"
    ss "Başardın!"

# game/Scenes/Suzy/suzy5.rpy:75
translate turkish suzy5_8b9f1772:

    # ss "Oh my God, thank you so much."
    ss "Aman Tanrım, çok teşekkür ederim."

# game/Scenes/Suzy/suzy5.rpy:76
translate turkish suzy5_e161b9ae:

    # ss "Best [brother] ever!"
    ss "Şimdiye kadarki en iyisi!"

# game/Scenes/Suzy/suzy5.rpy:79
translate turkish suzy5_86ca1882:

    # "She rushes up and wraps her arms around me, pulling me into a tight hug."
    "Kız koşarak yanıma geldi, kollarını bana doladı ve beni sıkıca kucakladı."

# game/Scenes/Suzy/suzy5.rpy:82
translate turkish suzy5_7eb555a1:

    # "Then she pulls away, but only slightly, staring up at me with a strange look in her eyes."
    "Sonra biraz uzaklaşır, ama sadece biraz, gözlerinde tuhaf bir bakışla bana bakar."

# game/Scenes/Suzy/suzy5.rpy:85
translate turkish suzy5_842415b0:

    # "Without warning, she leans in and put her lips on mine."
    "Hiç uyarmadan eğilir ve dudaklarını benimkilere değdirir."

# game/Scenes/Suzy/suzy5.rpy:86
translate turkish suzy5_8b1faa90:

    # "It is almost a chaste kiss, but not quite. Her hand is on my chest and there is a passion behind it."
    "Neredeyse masum bir öpücük, ama tam olarak değil. Eli göğsümde ve arkasında bir tutku var."

# game/Scenes/Suzy/suzy5.rpy:87
translate turkish suzy5_8e0321b2:

    # "This isn't just a friendly peck. I feel an urge behind it, like she wants more."
    "Bu sadece dostça bir öpücük değil. Arkasında bir dürtü hissediyorum, sanki daha fazlasını istiyormuş gibi."

# game/Scenes/Suzy/suzy5.rpy:91
translate turkish suzy5_34527ef1:

    # ss "Uh, sorry."
    ss "Ah, pardon."

# game/Scenes/Suzy/suzy5.rpy:92
translate turkish suzy5_b669988f:

    # ss "I shouldn't have done that, huh?"
    ss "Bunu yapmamalıydım, değil mi?"

# game/Scenes/Suzy/suzy5.rpy:96
translate turkish suzy5_6cb7ce9a:

    # ss "Really?"
    ss "Gerçekten mi?"

# game/Scenes/Suzy/suzy5.rpy:97
translate turkish suzy5_8577d189:

    # pc "No, it was nice."
    pc "Hayır, güzeldi."

# game/Scenes/Suzy/suzy5.rpy:98
translate turkish suzy5_721098ed:

    # ss "I thought so too."
    ss "Ben de öyle düşünmüştüm."

# game/Scenes/Suzy/suzy5.rpy:100
translate turkish suzy5_fe4100b4:

    # ss "Anyway, I should go."
    ss "Neyse, gitmem gerek."

# game/Scenes/Suzy/suzy5.rpy:102
translate turkish suzy5_d41d8cd9_1:

    # voice 'voices/suzy_thanks2.mp3'
    voice 'voices/suzy_thanks2.mp3'

# game/Scenes/Suzy/suzy5.rpy:103
translate turkish suzy5_2ec2b18b:

    # ss "Thanks again, [bro]."
    ss "Tekrar teşekkürler, [bro]."

# game/Scenes/Suzy/suzy5.rpy:104
translate turkish suzy5_c46a0b54:

    # pc "Any time."
    pc "Ne zaman istersen."

# game/Scenes/Suzy/suzy5.rpy:106
translate turkish suzy5_bd7daf33:

    # ss "Right. Sorry."
    ss "Tamam. Özür dilerim."

# game/Scenes/Suzy/suzy5.rpy:107
translate turkish suzy5_55a0a639:

    # ss "I should go."
    ss "Gitmem gerek."

# game/Scenes/Suzy/suzy5.rpy:108
translate turkish suzy5_45b1beab:

    # ss "Thanks for fixing my car."
    ss "Arabamı tamir ettiğin için teşekkürler."

# game/Scenes/Suzy/suzy5.rpy:112
translate turkish suzy5_f6f30a26:

    # "With that, she gets into her car and I get into mine and we both drive away."
    "Bunun üzerine o kendi arabasına bindi, ben de benimkine bindim ve ikimiz de uzaklaştık."

# game/Scenes/Suzy/suzy5.rpy:113
translate turkish suzy5_49ed461b:

    # "What was with that kiss?"
    "O öpücük de neydi öyle?"

# game/Scenes/Suzy/suzy5.rpy:115
translate turkish suzy5_78e50149:

    # "She definitely seems like she is interested in me. That kiss felt amazing."
    "Bana kesinlikle ilgi duyuyor gibi görünüyor. O öpücük muhteşemdi."

# game/Scenes/Suzy/suzy5.rpy:116
translate turkish suzy5_2c26c150:

    # "Somehow, her being my [sister] makes it even hotter."
    "Nedense, onun benim [sister]'m olması durumu daha da ateşli hale getiriyor."

# game/Scenes/Suzy/suzy5.rpy:117
translate turkish suzy5_8ea91748:

    # "I wonder if she would go further?"
    "Acaba daha ileri gider mi?"

# game/Scenes/Suzy/suzy5.rpy:119
translate turkish suzy5_47e765a1:

    # "She seems like she is actually interested in me romantically."
    "Bana romantik anlamda gerçekten ilgi duyuyor gibi görünüyor."

# game/Scenes/Suzy/suzy5.rpy:120
translate turkish suzy5_1ec25cb0:

    # "But, she is my [sister], so we can't do anything like that."
    "Ama o benim [sister]'m, bu yüzden böyle bir şey yapamayız."

# game/Scenes/Suzy/suzy5.rpy:121
translate turkish suzy5_32823086:

    # "I need to put a stop to this."
    "Buna bir son vermem lazım."

translate turkish strings:

    # game/Scenes/Suzy/suzy5.rpy:2
    old "A few days after the scene where Tammy comes to your bedroom at night,"
    new "Tammy'nin gece yatak odana geldiği sahneden birkaç gün sonra,"

    # game/Scenes/Suzy/suzy5.rpy:3
    old "Suzy will call you for help in the evening."
    new "Suzy akşamüstü senden yardım isteyecek."

    # game/Scenes/Suzy/suzy5.rpy:47
    old "Don't worry, it'll be fine"
    new "Merak etme, her şey yoluna girecek."

    # game/Scenes/Suzy/suzy5.rpy:51
    old "Let me take a look at it"
    new "Bir bakayım."

    # game/Scenes/Suzy/suzy5.rpy:54
    old "Maybe don't drive like a crazy person?"
    new "Belki de deli gibi araba sürmemelisin?"

    # game/Scenes/Suzy/suzy5.rpy:94
    old "I didn't mind"
    new "Sorun etmedim."

    # game/Scenes/Suzy/suzy5.rpy:105
    old "No, probably not"
    new "Hayır, muhtemelen olmaz."

