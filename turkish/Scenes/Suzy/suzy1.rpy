# game/Scenes/Suzy/suzy1.rpy:13
translate turkish suzy1_b52dca5a:

    # "I go to the kitchen and make a plate with what's left, then sit down across from her at the table."
    "Mutfağa gidip kalanlarla bir tabak hazırlıyorum, sonra masada onun karşısına oturuyorum."

# game/Scenes/Suzy/suzy1.rpy:14
translate turkish suzy1_c4e96a72:

    # "She puts her phone away and looks up at me."
    "Telefonunu kaldırıp bana bakıyor."

# game/Scenes/Suzy/suzy1.rpy:17
translate turkish suzy1_43f2e75d:

    # ss "So how's it been going [bro]?"
    ss "Ee, nasıl gidiyor [bro]?"

# game/Scenes/Suzy/suzy1.rpy:18
translate turkish suzy1_d48b3188:

    # pc "Pretty good, I guess."
    pc "Oldukça iyi, sanırım."

# game/Scenes/Suzy/suzy1.rpy:19
translate turkish suzy1_c84b49b4:

    # ss "Have you found out anything about Dad?"
    ss "Babam hakkında bir şey öğrendin mi?"

# game/Scenes/Suzy/suzy1.rpy:20
translate turkish suzy1_0b7558fc:

    # pc "Not yet."
    pc "Henüz değil."

# game/Scenes/Suzy/suzy1.rpy:22
translate turkish suzy1_e47fa0f8:

    # ss "I miss him."
    ss "Onu özlüyorum."

# game/Scenes/Suzy/suzy1.rpy:23
translate turkish suzy1_0b941cef:

    # pc "You got along with him well?"
    pc "Onunla iyi anlaşıyor muydun?"

# game/Scenes/Suzy/suzy1.rpy:24
translate turkish suzy1_0442c0e0:

    # ss "Yeah."
    ss "Evet."

# game/Scenes/Suzy/suzy1.rpy:25
translate turkish suzy1_d244b907:

    # ss "I mean, we didn't spend a lot of time together. He was down in that basement a lot."
    ss "Yani, birlikte çok fazla zaman geçirmedik. Çoğu zaman bodrumda olurdu."

# game/Scenes/Suzy/suzy1.rpy:26
translate turkish suzy1_34edb007:

    # ss "But he would have breakfast with me every morning before school. He was funny. He'd make me laugh every day."
    ss "Ama her sabah okula gitmeden önce benimle kahvaltı yapardı. Komikti. Beni her gün güldürürdü."

# game/Scenes/Suzy/suzy1.rpy:27
translate turkish suzy1_85af114e:

    # pc "Kind of like this, huh?"
    pc "Tıpkı bu gibi, değil mi?"

# game/Scenes/Suzy/suzy1.rpy:29
translate turkish suzy1_226f4904:

    # ss "I said he was funny, not obnoxious. Plus, he wore pants. Why are you walking around in your boxers?"
    ss "Komik demiştim, sinir bozucu demedim. Üstelik pantolon giyiyordu. Neden boxer şortunla ortalıkta dolaşıyorsun?"

# game/Scenes/Suzy/suzy1.rpy:30
translate turkish suzy1_4cc016bf:

    # pc "It's morning, I don't want to get dressed yet. You can eat breakfast in your underwear if you want."
    pc "Sabahın erken saatleri, henüz giyinmek istemiyorum. İstersen iç çamaşırınla kahvaltı yapabilirsin."

# game/Scenes/Suzy/suzy1.rpy:31
translate turkish suzy1_bd01965a:

    # ss "Yeah, I bet you'd like that. You'd just stare at me the whole time."
    ss "Evet, eminim hoşuna giderdi. Sürekli bana bakıp dururdun."

# game/Scenes/Suzy/suzy1.rpy:35
translate turkish suzy1_d7a0aba4:

    # ss "You're such a perv."
    ss "Ne sapıksın sen."

# game/Scenes/Suzy/suzy1.rpy:38
translate turkish suzy1_0ca3339d:

    # ss "You're such a jerk."
    ss "Ne pisliksin sen."

# game/Scenes/Suzy/suzy1.rpy:39
translate turkish suzy1_a976ce63:

    # pc "Besides, you act like you don't stare at me when I'm in my boxers."
    pc "Hem, ben boxerımla dolaşırken bana bakmıyormuş gibi davranıyorsun."

# game/Scenes/Suzy/suzy1.rpy:40
translate turkish suzy1_23992985:

    # ss "What!? I do not!"
    ss "Ne!? Bakmıyorum ki!"

# game/Scenes/Suzy/suzy1.rpy:41
translate turkish suzy1_25e7a80f:

    # pc "Come on now [sis], I've seen you."
    pc "Hadi ama [sis], seni gördüm."

# game/Scenes/Suzy/suzy1.rpy:43
translate turkish suzy1_873662ce:

    # ss "You're out of your mind. I've never stared at you. Like you have anything to stare at anyways."
    ss "Aklını kaçırmışsın. Sana hiç bakmadım ki. Zaten bakacak bir şeyin de yok."

# game/Scenes/Suzy/suzy1.rpy:44
translate turkish suzy1_6e7bc529:

    # pc "Oh I don't have anything to stare at?"
    pc "Oh, bakacak bir şeyim mi yok?"

# game/Scenes/Suzy/suzy1.rpy:45
translate turkish suzy1_ec7a8238:

    # ss "Nope."
    ss "Hayır."

# game/Scenes/Suzy/suzy1.rpy:48
translate turkish suzy1_7745b76d:

    # ss "Yeah, whatever."
    ss "Tabii, neyse ne."

# game/Scenes/Suzy/suzy1.rpy:51
translate turkish suzy1_24166e5d:

    # ss "No! I don't want to see!"
    ss "Hayır! Görmek istemiyorum!"

# game/Scenes/Suzy/suzy1.rpy:52
translate turkish suzy1_483160a9:

    # ss "Sit down. Stop playing around."
    ss "Otur. Dalga geçmeyi bırak."

# game/Scenes/Suzy/suzy1.rpy:53
translate turkish suzy1_ce7899d2:

    # pc "I'm not playing. I'll show you."
    pc "Dalga geçmiyorum. Göstereceğim."

# game/Scenes/Suzy/suzy1.rpy:54
translate turkish suzy1_626bbd17:

    # ss "I don't want to see it. I believe you have something there, but I don't want to see it."
    ss "Görmek istemiyorum. Orada bir şey olduğuna inanıyorum ama görmek istemiyorum."

# game/Scenes/Suzy/suzy1.rpy:55
translate turkish suzy1_c1226f21:

    # ss "Put it away, sit down."
    ss "Kapa şunu, otur."

# game/Scenes/Suzy/suzy1.rpy:56
translate turkish suzy1_02b8ec2b:

    # pc "Alright, I'm sitting."
    pc "Tamam, oturuyorum."

# game/Scenes/Suzy/suzy1.rpy:58
translate turkish suzy1_c7580a8a:

    # ss "You're such a weirdo."
    ss "Ne tuhaf birisin."

# game/Scenes/Suzy/suzy1.rpy:59
translate turkish suzy1_086a625f:

    # "We spend the rest of the breakfast talking about school and work and joking around."
    "Kahvaltının geri kalanını okul ve iş hakkında konuşarak ve şakalaşarak geçiriyoruz."

# game/Scenes/Suzy/suzy1.rpy:60
translate turkish suzy1_74d7aff9:

    # "Then we finish eating and it's time to go to school."
    "Sonra yemeğimizi bitiriyoruz ve okula gitme vakti geliyor."

# game/Scenes/Suzy/suzy1.rpy:65
translate turkish suzy1_74b357a7:

    # ss "Have a good day [bro]. See you later."
    ss "İyi günler [bro]. Görüşürüz."

# game/Scenes/Suzy/suzy1.rpy:66
translate turkish suzy1_7dee10c4:

    # pc "Bye [sis]."
    pc "Hoşça kal [sis]."

# game/Scenes/Suzy/suzy1.rpy:71
translate turkish suzy1_015cad61:

    # "She leaves for school and I follow right after her."
    "O okula gidiyor ve ben de hemen arkasından çıkıyorum."

translate turkish strings:

    # game/Scenes/Suzy/suzy1.rpy:2
    old "Have breakfast with Suzy again, after you have patched things up with her."
    new "Suzy ile aranızı düzelttikten sonra yine onunla kahvaltı yap."

    # game/Scenes/Suzy/suzy1.rpy:3
    old "She's in the kitchen in the mornings on weekdays."
    new "Hafta içi sabahları mutfakta oluyor."

    # game/Scenes/Suzy/suzy1.rpy:33
    old "I definitely would"
    new "Kesinlikle yapardım"

    # game/Scenes/Suzy/suzy1.rpy:36
    old "You don't have much to stare at."
    new "Bakacak pek bir şey yok."

    # game/Scenes/Suzy/suzy1.rpy:47
    old "Whatever"
    new "Neyse ne"

    # game/Scenes/Suzy/suzy1.rpy:49
    old "You want to see what I have?"
    new "Neyim var görmek ister misin?"

