# game/Scenes/Suzy/SuzyTammyConversations/suzytammys5.rpy:13
translate turkish suzytammys5_6331d31c:

    # ss "I don't know! I know like nothing about cars."
    ss "Bilmiyorum! Arabalar hakkında hiçbir şey bilmiyorum."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammys5.rpy:15
translate turkish suzytammys5_cf74d92a:

    # ss "I like my Jeep."
    ss "Jeep'imi seviyorum."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammys5.rpy:17
translate turkish suzytammys5_440b50a6:

    # ss "When it runs right at least."
    ss "En azından düzgün çalıştığı zaman."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammys5.rpy:19
translate turkish suzytammys5_30d40db8:

    # ss "Oh! I like cute little cars! Like a bug! One of the new ones, like what you're driving. They're really cute."
    ss "Ah! Sevimli küçük arabaları seviyorum! Beetle gibi! Senin sürdüğün gibi yeni modellerden biri. Gerçekten çok sevimli."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammys5.rpy:21
translate turkish suzytammys5_e9ecfd65:

    # ss "But I would want a yellow one."
    ss "Ama sarı bir tane isterdim."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammys5.rpy:23
translate turkish suzytammys5_505d1c69:

    # ss "Or a Fiat! A yellow Fiat. That's my answer."
    ss "Ya da bir Fiat! Sarı bir Fiat. Cevabım bu."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammys5.rpy:25
translate turkish suzytammys5_131e6e55:

    # tm "Those {i}are{/i} cute."
    tm "Onlar {i}çok{/i} sevimli."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammys5.rpy:27
translate turkish suzytammys5_cdbd8cfb:

    # tm "I like strong cars though. Muscle cars. Something with power."
    tm "Ama güçlü arabaları da seviyorum. Muscle car'lar. Güçlü olanları."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammys5.rpy:29
translate turkish suzytammys5_0bbcd30d:

    # tm "That car your dad used to drive was a hot car."
    tm "Babanın eskiden sürdüğü araba çok havalıydı."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammys5.rpy:30
translate turkish suzytammys5_ca8b3c02:

    # pc "Yeah, it's still in the garage. If I could find the keys to it, I'd be driving it."
    pc "Evet, hâlâ garajda duruyor. Anahtarlarını bulabilseydim, onu sürerdim."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammys5.rpy:32
translate turkish suzytammys5_fbbeeee2:

    # tm "You'd look good behind the wheel of that gorgeous beast."
    tm "O muhteşem canavarın direksiyonuna geçsen çok yakışırdın."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammys5.rpy:34
translate turkish suzytammys5_63f0aef3:

    # ss "Meh. I like the bug more."
    ss "Eh. Ben Beetle'ı daha çok seviyorum."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammys5.rpy:36
translate turkish suzytammys5_0f3dcfb4:

    # tm "You're crazy. I want to feel the engine when I'm sitting in a car."
    tm "Sen delisin. Arabada otururken motoru hissetmek istiyorum."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammys5.rpy:38
translate turkish suzytammys5_c435c0ed:

    # tm "I want to feel it vibrating all the way up through my crotch."
    tm "Titremesini kasıklarımdan yukarı doğru hissedebilmek istiyorum."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammys5.rpy:40
translate turkish suzytammys5_ee0a190a:

    # ss "Calling me crazy and you're the one talking about fucking a car."
    ss "Bana deli diyorsun ama arabayla sevişmekten bahseden sensin."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammys5.rpy:42
translate turkish suzytammys5_de5a2634:

    # tm "I'm not going to fuck the car..."
    tm "Arabayla sevişmeyeceğim..."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammys5.rpy:44
translate turkish suzytammys5_bff24910:

    # tm "... but that car definitely makes me want to fuck."
    tm "... ama o araba kesinlikle içimde sevişme isteği uyandırıyor."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammys5.rpy:45
translate turkish suzytammys5_9041ccf8:

    # pc "I need to find that damn key."
    pc "O lanet anahtarı bulmam lazım."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammys5.rpy:47
translate turkish suzytammys5_9b45740c:

    # tm "Yes you do!"
    tm "Evet, bulmalısın!"

