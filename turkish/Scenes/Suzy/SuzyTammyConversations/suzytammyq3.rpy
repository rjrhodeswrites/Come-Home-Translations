translate turkish suzytammyq3_1817dc6b:

    # ss "[pcname], if you had to choose between us, who would you choose?"
    ss "[pcname], bizim aramızdan birini seçmek zorunda kalsan, kimi seçerdin?"

# game/Scenes/Suzy/SuzyTammyConversations/suzytammyq3.rpy:17
translate turkish suzytammyq3_1a787072:

    # tm "I mean, obviously. Who wouldn't?"
    tm "Yani, tabii ki. Kim seçmez ki?"

# game/Scenes/Suzy/SuzyTammyConversations/suzytammyq3.rpy:18
translate turkish suzytammyq3_aa36c5c4:

    # tm "She's so pretty and sweet and funny."
    tm "O çok güzel, tatlı ve komik."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammyq3.rpy:19
translate turkish suzytammyq3_1c722351:

    # pc "Yeah she is."
    pc "Evet, öyle."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammyq3.rpy:21
translate turkish suzytammyq3_715a4836:

    # ss "Aw, you're all those things too though, Tammy."
    ss "Ah, sen de tüm bu özelliklere sahipsin, Tammy."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammyq3.rpy:23
translate turkish suzytammyq3_b9e2f50a:

    # tm "Thanks, babe. Anybody would choose you over me though."
    tm "Teşekkürler, canım. Ama herkes beni sana tercih ederdi."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammyq3.rpy:25
translate turkish suzytammyq3_ac12eba9:

    # ss "That's not true!"
    ss "Bu doğru değil!"

# game/Scenes/Suzy/SuzyTammyConversations/suzytammyq3.rpy:26
translate turkish suzytammyq3_55946d3a:

    # ss "This is a mean conversation. I don't want to keep talking about it."
    ss "Bu çok acımasız bir konuşma. Bu konuda daha fazla konuşmak istemiyorum."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammyq3.rpy:27
translate turkish suzytammyq3_37f942b9:

    # pc "Okay, let's move on then."
    pc "Tamam, o zaman başka bir konuya geçelim."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammyq3.rpy:30
translate turkish suzytammyq3_70d30f23:

    # tm "What, really?"
    tm "Ne, gerçekten mi?"

# game/Scenes/Suzy/SuzyTammyConversations/suzytammyq3.rpy:32
translate turkish suzytammyq3_d001433f:

    # ss "What do you mean \"What, really?\""
    ss "\"Ne, gerçekten mi?\" derken ne demek istiyorsun?"

# game/Scenes/Suzy/SuzyTammyConversations/suzytammyq3.rpy:33
translate turkish suzytammyq3_e1e96118:

    # ss "You're so hot and strong and sexy."
    ss "Sen çok çekicisin, güçlüsün ve seksisin."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammyq3.rpy:34
translate turkish suzytammyq3_4664af7e:

    # pc "For sure."
    pc "Kesinlikle."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammyq3.rpy:36
translate turkish suzytammyq3_75e9486a:

    # tm "So are you though, babe. I can't see how anybody would choose me over you."
    tm "Sen de öylesin canım. Kimsenin seni bana tercih edeceğini anlayamıyorum."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammyq3.rpy:38
translate turkish suzytammyq3_42af3cf3:

    # ss "Face it, cupcake. You're super hot."
    ss "Kabul et artık, tatlım. Sen süper seksi birisin."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammyq3.rpy:40
translate turkish suzytammyq3_17f3d5cb:

    # tm "I don't want to talk about this anymore. It makes me feel bad."
    tm "Artık bu konuyu konuşmak istemiyorum. Kendimi kötü hissettiriyor."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammyq3.rpy:41
translate turkish suzytammyq3_de2782f9:

    # pc "Okay, let's just move on then."
    pc "Tamam, o zaman konuyu kapatalım."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammyq3.rpy:44
translate turkish suzytammyq3_f0d7c9d9:

    # tm "That's the only correct answer."
    tm "Tek doğru cevap bu."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammyq3.rpy:46
translate turkish suzytammyq3_f1bf9299:

    # ss "It's not a real answer though."
    ss "Ama bu gerçek bir cevap değil ki."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammyq3.rpy:47
translate turkish suzytammyq3_37463529:

    # pc "It's all I got."
    pc "Elimden gelen tek şey bu."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammyq3.rpy:48
translate turkish suzytammyq3_9534b5b8:

    # pc "You're both amazing and gorgeous and sexy. I don't want to choose."
    pc "İkiniz de muhteşem, göz alıcı ve seksisiniz. Seçim yapmak istemiyorum."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammyq3.rpy:50
translate turkish suzytammyq3_4bd6ab2e:

    # ss "Aw, I'll accept it, but only because you called me gorgeous."
    ss "Ah, kabul ediyorum, ama sadece bana \"göz alıcı\" dediğin için."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammyq3.rpy:52
translate turkish suzytammyq3_f36f83f0:

    # tm "I'm glad we don't have to choose."
    tm "Seçim yapmak zorunda olmadığımıza sevindim."

# game/Scenes/Suzy/SuzyTammyConversations/suzytammyq3.rpy:54
translate turkish suzytammyq3_3b59b879:

    # ss "Me too. Making decisions sucks. Just do all the things."
    ss "Ben de. Karar vermek berbat bir şey. Hepsini yap gitsin."

