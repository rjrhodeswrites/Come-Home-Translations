# game/Scenes/Kendra/KendraConversations/kendras4.rpy:13
translate turkish kendras4_da33da98:

    # sg "Nah, man. I'm not going to waste my life working at some job that I hate."
    sg "Hayır dostum. Nefret ettiğim bir işte çalışarak hayatımı boşa harcamayacağım."

# game/Scenes/Kendra/KendraConversations/kendras4.rpy:14
translate turkish kendras4_154f33d2:

    # pc "What about money?"
    pc "Peki ya para?"

# game/Scenes/Kendra/KendraConversations/kendras4.rpy:16
translate turkish kendras4_3bdab488:

    # sg "Don't need it."
    sg "İhtiyacım yok."

# game/Scenes/Kendra/KendraConversations/kendras4.rpy:17
translate turkish kendras4_1ea5be82:

    # sg "Why the hell would I need money?"
    sg "Neden paraya ihtiyacım olsun ki?"

# game/Scenes/Kendra/KendraConversations/kendras4.rpy:18
translate turkish kendras4_a5acda19:

    # pc "I don't know. To buy stuff? Food? Clothes?"
    pc "Bilmiyorum. Bir şeyler almak için mi? Yemek? Giysi?"

# game/Scenes/Kendra/KendraConversations/kendras4.rpy:19
translate turkish kendras4_f972c97b:

    # sg "Eh, I get by. I don't need much."
    sg "Eh, idare ediyorum. Fazla bir şeye ihtiyacım yok."

# game/Scenes/Kendra/KendraConversations/kendras4.rpy:21
translate turkish kendras4_45cb15cf:

    # sg "I just value my time much more than anybody could pay me."
    sg "Zamanıma, bana kimsenin ödeyebileceğinden çok daha fazla değer veriyorum."

# game/Scenes/Kendra/KendraConversations/kendras4.rpy:22
translate turkish kendras4_484e8cb5:

    # pc "I guess that makes sense, but I worry about what's going to happen in the future."
    pc "Sanırım bu mantıklı, ama gelecekte ne olacağı konusunda endişeleniyorum."

# game/Scenes/Kendra/KendraConversations/kendras4.rpy:23
translate turkish kendras4_c26abf81:

    # sg "Not me. No point."
    sg "Ben değil. Anlamı yok."

# game/Scenes/Kendra/KendraConversations/kendras4.rpy:24
translate turkish kendras4_a2a6fb65:

    # pc "What do you mean?"
    pc "Ne demek istiyorsun?"

# game/Scenes/Kendra/KendraConversations/kendras4.rpy:26
translate turkish kendras4_4908e6af:

    # sg "I mean who knows if I'm even going to be here tomorrow, so why worry about it?"
    sg "Yani, yarın burada olacağımı kim bilebilir ki, o zaman neden endişelenelim ki?"

# game/Scenes/Kendra/KendraConversations/kendras4.rpy:27
translate turkish kendras4_00f6902e:

    # pc "Why wouldn't you be here tomorrow?"
    pc "Neden yarın burada olmayasın ki?"

# game/Scenes/Kendra/KendraConversations/kendras4.rpy:29
translate turkish kendras4_1ebd7d80:

    # sg "I don't fucking know, [pcname]."
    sg "Bilmiyorum lan, [pcname]."

# game/Scenes/Kendra/KendraConversations/kendras4.rpy:30
translate turkish kendras4_92ebfa3d:

    # sg "Maybe I have a brain aneurysm. Maybe I get hit by a truck."
    sg "Belki beyin anevrizması geçiririm. Belki bir kamyonun altında kalırım."

# game/Scenes/Kendra/KendraConversations/kendras4.rpy:32
translate turkish kendras4_9caef9ae:

    # sg "Maybe a fucking meteor falls from the sky and smashes my head in?"
    sg "Belki de gökyüzünden lanet bir meteor düşer ve kafamı ezip geçer?"

# game/Scenes/Kendra/KendraConversations/kendras4.rpy:34
translate turkish kendras4_47c89f5e:

    # sg "Who knows what's going to happen tomorrow, so why worry about it?"
    sg "Yarın ne olacağını kim bilebilir ki, o zaman neden endişelenelim ki?"

# game/Scenes/Kendra/KendraConversations/kendras4.rpy:35
translate turkish kendras4_99eafc37:

    # pc "I guess so."
    pc "Sanırım haklısın."

