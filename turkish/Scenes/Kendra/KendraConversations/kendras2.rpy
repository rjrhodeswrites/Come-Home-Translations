# game/Scenes/Kendra/KendraConversations/kendras2.rpy:23
translate turkish kendras2_4965b465:

    # sg "Yeah, man. I kind of feel like life should have a background track you know."
    sg "Evet dostum. Hayatın bir arka plan müziği olması gerektiğini hissediyorum, anlarsın ya."

# game/Scenes/Kendra/KendraConversations/kendras2.rpy:24
