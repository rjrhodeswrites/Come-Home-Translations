# game/Scenes/Kendra/KendraConversations/kendraq1.rpy:11
translate turkish kendraq1_c81b1cf7:

    # sg "So what do you do all day, [pcname]? Go to school? Work?"
    sg "Peki bütün gün ne yapıyorsun, [pcname]? Okula mı gidiyorsun? Çalışıyor musun?"

# game/Scenes/Kendra/KendraConversations/kendraq1.rpy:12
translate turkish kendraq1_9538897e:

    # pc "Both."
    pc "İkisi de."

# game/Scenes/Kendra/KendraConversations/kendraq1.rpy:13
translate turkish kendraq1_e4050b39:

    # pc "I go to Skyhill College mornings, and then work at Mills & Gonzales law office in the afternoon."
    pc "Sabahları Skyhill Koleji’ne gidiyorum, öğleden sonraları ise Mills & Gonzales hukuk bürosunda çalışıyorum."

# game/Scenes/Kendra/KendraConversations/kendraq1.rpy:15
translate turkish kendraq1_b8d74c6f:

    # sg "Oh, you stay busy then."
    sg "Demek ki oldukça meşgulsün."

# game/Scenes/Kendra/KendraConversations/kendraq1.rpy:16
translate turkish kendraq1_8e673de2:

    # pc "Yeah, pretty busy most of the time. Usually free in the evenings and on weekends to do whatever, but I do have to study a lot."
    pc "Evet, çoğu zaman oldukça meşgulüm. Genellikle akşamları ve hafta sonları ne istersem yapabilecek kadar boş vaktim oluyor ama çok ders çalışmam gerekiyor."

# game/Scenes/Kendra/KendraConversations/kendraq1.rpy:17
translate turkish kendraq1_5c048a9b:

    # sg "Sounds pretty shitty to me."
    sg "Bana pek berbat geliyor."

# game/Scenes/Kendra/KendraConversations/kendraq1.rpy:18
translate turkish kendraq1_c87c469f:

    # pc "It's not bad. I make the most of my free time."
    pc "Fena değil. Boş zamanımı en iyi şekilde değerlendiriyorum."

# game/Scenes/Kendra/KendraConversations/kendraq1.rpy:20
translate turkish kendraq1_d1bb28ac:

    # sg "Hey that's kind of my motto in life. Make the most of every second."
    sg "Hey, bu benim hayat felsefem sayılır. Her saniyeyi en iyi şekilde değerlendirmek."

# game/Scenes/Kendra/KendraConversations/kendraq1.rpy:21
translate turkish kendraq1_bfe9d757:

    # pc "It's a good motto."
    pc "İyi bir mottosu."

# game/Scenes/Kendra/KendraConversations/kendraq1.rpy:22
translate turkish kendraq1_90826600:

    # sg "I think so."
    sg "Bence de."

