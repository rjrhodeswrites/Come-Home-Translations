# game/Scenes/Kendra/kendra3.rpy:15
translate turkish kendra3_e6819a9b:

    # "I get in my car and start driving, not sure exactly where I'm going to go yet."
    "Arabama binip sürmeye başlıyorum, henüz tam olarak nereye gideceğimi bilmiyorum."

# game/Scenes/Kendra/kendra3.rpy:16
translate turkish kendra3_7762f52e:

    # "I'm kind of tired from the long day and just sort of zoning out a little."
    "Uzun bir günün yorgunluğuyla biraz dalmış durumdayım."

# game/Scenes/Kendra/kendra3.rpy:19
translate turkish kendra3_d0eb2e8d:

    # "When all of a sudden I spot something moving quick in my peripheral vision."
    "Birdenbire gözümün ucunda hızlıca hareket eden bir şey fark ettim."

# game/Scenes/Kendra/kendra3.rpy:21
translate turkish kendra3_f1e9089d:

    # "I slam on the brakes but the figure still thuds against the front of the car."
    "Frene bastım ama o kişi yine de arabanın ön tarafına çarptı."

# game/Scenes/Kendra/kendra3.rpy:22
translate turkish kendra3_9ad52246:

    # "I quickly put the car in park and get out."
    "Hemen vitesi park konumuna aldım ve arabadan indim."

# game/Scenes/Kendra/kendra3.rpy:26
translate turkish kendra3_58b0214e:

    # "I rush to the front of the car and see Kendra lying there."
    "Arabanın önüne koştum ve orada yatan Kendra'yı gördüm."

# game/Scenes/Kendra/kendra3.rpy:29
translate turkish kendra3_d677ec43:

    # sg "OWWW!"
    sg "AHHH!"

# game/Scenes/Kendra/kendra3.rpy:30
translate turkish kendra3_b6b2fb95:

    # pc "You're yelling. That's a good sign."
    pc "Bağırıyorsun. Bu iyiye işaret."

# game/Scenes/Kendra/kendra3.rpy:31
translate turkish kendra3_2496078f:

    # sg "What the fuck? You ran into me!"
    sg "Ne oluyor lan? Sen bana çarptın!"

# game/Scenes/Kendra/kendra3.rpy:32
translate turkish kendra3_62b55de1:

    # pc "I was driving. On the road. Like people do."
    pc "Araba kullanıyordum. Yolda. Herkesin yaptığı gibi."

# game/Scenes/Kendra/kendra3.rpy:33
translate turkish kendra3_903c932a:

    # pc "You rolled out right in front of me."
    pc "Tam önüme yuvarlandın."

# game/Scenes/Kendra/kendra3.rpy:34
translate turkish kendra3_081c6b88:

    # sg "Ugh, help me up."
    sg "Of, kalkmama yardım et."

# game/Scenes/Kendra/kendra3.rpy:36
translate turkish kendra3_dafc27de:

    # sg "I'm skating, what the fuck are you doing?"
    sg "Ben kayıyordum, sen ne halt ediyorsun?"

# game/Scenes/Kendra/kendra3.rpy:37
translate turkish kendra3_62b55de1_1:

    # pc "I was driving. On the road. Like people do."
    pc "Araba kullanıyordum. Yolda. Herkesin yaptığı gibi."

# game/Scenes/Kendra/kendra3.rpy:38
translate turkish kendra3_903c932a_1:

    # pc "You rolled out right in front of me."
    pc "Tam önüme yuvarlandın."

# game/Scenes/Kendra/kendra3.rpy:39
translate turkish kendra3_1353eb18:

    # sg "So, you're saying this is MY fault?"
    sg "Yani, bunun benim hatam olduğunu mu söylüyorsun?"

# game/Scenes/Kendra/kendra3.rpy:40
translate turkish kendra3_a830423f:

    # pc "Yes!"
    pc "Evet!"

# game/Scenes/Kendra/kendra3.rpy:41
translate turkish kendra3_23a2710a:

    # sg "Ugh! Help me up."
    sg "Of! Kalkmama yardım et."

# game/Scenes/Kendra/kendra3.rpy:43
translate turkish kendra3_b5c3864a:

    # sg "Where are you going?"
    sg "Nereye gidiyorsun?"

# game/Scenes/Kendra/kendra3.rpy:44
translate turkish kendra3_61295bf1:

    # sg "Get back here and help me up!"
    sg "Buraya gel de kalkmama yardım et!"

# game/Scenes/Kendra/kendra3.rpy:45
translate turkish kendra3_067e07ea:

    # pc "Well, I guess she's not dead. That's good, I suppose."
    pc "Eh, sanırım ölmemiş. Bu iyi bir şey, sanırım."

# game/Scenes/Kendra/kendra3.rpy:46
translate turkish kendra3_fafb1e2e:

    # sg "You know you're talking out loud, right?"
    sg "Yüksek sesle konuştuğunun farkındasın, değil mi?"

# game/Scenes/Kendra/kendra3.rpy:49
translate turkish kendra3_9f290cbc:

    # "I reach down and help her up off the ground. She has a couple of scrapes, but otherwise looks okay."
    "Eğilip onu yerden kaldırıyorum. Birkaç sıyrığı var ama onun dışında iyi görünüyor."

# game/Scenes/Kendra/kendra3.rpy:50
translate turkish kendra3_615399f4:

    # sg "Ow, ow, OWWWW!"
    sg "Ah, ah, AHHHH!"

# game/Scenes/Kendra/kendra3.rpy:51
translate turkish kendra3_fa75bbc3:

    # pc "Are you okay?"
    pc "İyi misin?"

# game/Scenes/Kendra/kendra3.rpy:52
translate turkish kendra3_45a6e9be:

    # sg "Oh I'm peachy, except for being hit with a fucking car."
    sg "Oh, gayet iyiyim, lanet olası bir arabanın bana çarpması dışında."

# game/Scenes/Kendra/kendra3.rpy:53
translate turkish kendra3_117925e8:

    # pc "I really tried to stop. You just came out of nowhere."
    pc "Gerçekten durmaya çalıştım. Birdenbire ortaya çıktın."

# game/Scenes/Kendra/kendra3.rpy:54
translate turkish kendra3_74d101ab:

    # sg "I must have been daydreaming again. I do that sometimes when I'm skating."
    sg "Yine hayal kuruyor olmalıyım. Kayarken bazen böyle olur."

# game/Scenes/Kendra/kendra3.rpy:55
translate turkish kendra3_86c00ccd:

    # sg "I don't even know where I am right now. What the fuck are these apartments?"
    sg "Şu anda nerede olduğumu bile bilmiyorum. Bu apartmanlar da ne lan?"

# game/Scenes/Kendra/kendra3.rpy:56
translate turkish kendra3_02dfe69f:

    # sg "Where the fuck's my board?"
    sg "Kaykayım nerede lan?"

# game/Scenes/Kendra/kendra3.rpy:59
translate turkish kendra3_798e7f93:

    # sg "Oh no."
    sg "Oh hayır."

# game/Scenes/Kendra/kendra3.rpy:60
translate turkish kendra3_aafa9da5:

    # "Her board is snapped clean in half, partially under my front tires."
    "Kaykayı tam ortadan ikiye kırılmış, bir kısmı ön tekerleklerimin altında kalmış."

# game/Scenes/Kendra/kendra3.rpy:61
translate turkish kendra3_3092625b:

    # sg "Oh no! Keven!"
    sg "Oh hayır! Keven!"

# game/Scenes/Kendra/kendra3.rpy:62
translate turkish kendra3_48a2dfa9:

    # pc "Keven? My name is [pcname]."
    pc "Keven mi? Benim adım [pcname]."

# game/Scenes/Kendra/kendra3.rpy:63
translate turkish kendra3_2a40904c:

    # sg "Not you. My deck. I named it Keven after the first guy I rode in Junior High."
    sg "Sen değil. Kaykayım. Ortaokulda ilk kez birlikte kaymış olduğum çocuğun adını vererek ona Keven adını koydum."

# game/Scenes/Kendra/kendra3.rpy:64
translate turkish kendra3_bf28e1a1:

    # pc "Oh."
    pc "Ah."

# game/Scenes/Kendra/kendra3.rpy:65
translate turkish kendra3_99e26f36:

    # sg "Why God? Why did you do this?"
    sg "Neden Tanrım? Neden bunu yaptın?"

# game/Scenes/Kendra/kendra3.rpy:70
translate turkish kendra3_a38c3d5a:

    # sg "WHY!?"
    sg "NEDEN!?"

# game/Scenes/Kendra/kendra3.rpy:73
translate turkish kendra3_62aa0256:

    # "A few minutes later, I get her into my car, the broken board, Keven, in her lap."
    "Birkaç dakika sonra onu arabama bindirdim; kırık kaykay, Keven, kucağındaydı."

# game/Scenes/Kendra/kendra3.rpy:77
translate turkish kendra3_8e62d7f2:

    # sg "This sucks."
    sg "Bu berbat bir durum."

# game/Scenes/Kendra/kendra3.rpy:78
translate turkish kendra3_12117716:

    # pc "I'm sorry. Is it real expensive?"
    pc "Üzgünüm. Çok mu pahalı?"

# game/Scenes/Kendra/kendra3.rpy:79
translate turkish kendra3_0a31c2a5:

    # sg "Expensive enough that I'm not going to be able to afford it for a while."
    sg "Bir süreliğine param yetmeyecek kadar pahalı."

# game/Scenes/Kendra/kendra3.rpy:80
translate turkish kendra3_63694087:

    # sg "I don't have any money."
    sg "Hiç param yok."

# game/Scenes/Kendra/kendra3.rpy:81
translate turkish kendra3_ed6ef899:

    # pc "What kind is it? Maybe I can keep an eye out for it."
    pc "Ne tür bir şey? Belki gözüm açık tutabilirim."

# game/Scenes/Kendra/kendra3.rpy:82
translate turkish kendra3_84536790:

    # sg "It's a Maria Kruz. Top of the line."
    sg "Maria Kruz. En üst model."

# game/Scenes/Kendra/kendra3.rpy:83
translate turkish kendra3_01ef4db4:

    # pc "How much are they?"
    pc "Ne kadar?"

# game/Scenes/Kendra/kendra3.rpy:84
translate turkish kendra3_ac6e3d6f:

    # sg "I don't fucking know. My Dad bought Keven for me when I was twelve years old. I haven't ever had to buy another."
    sg "Hiç bilmiyorum lan. Babam, ben on iki yaşındayken bana Keven almıştı. O zamandan beri başka bir tane almam gerekmedi."

# game/Scenes/Kendra/kendra3.rpy:85
translate turkish kendra3_7ae9cf5e:

    # pc "That's a long time."
    pc "Uzun bir süre olmuş."

# game/Scenes/Kendra/kendra3.rpy:88
translate turkish kendra3_3f13132b:

    # sg "Yeah."
    sg "Evet."

# game/Scenes/Kendra/kendra3.rpy:89
translate turkish kendra3_a1d21d3d:

    # sg "Anyway, just drop me off here at the park."
    sg "Neyse, beni burada, parkta indir."

# game/Scenes/Kendra/kendra3.rpy:90
translate turkish kendra3_36d7a2b5:

    # sg "I want to be alone for a while."
    sg "Bir süre yalnız kalmak istiyorum."

# game/Scenes/Kendra/kendra3.rpy:91
translate turkish kendra3_63023601:

    # pc "Okay."
    pc "Tamam."

# game/Scenes/Kendra/kendra3.rpy:92
translate turkish kendra3_ed6d9d2d:

    # pc "I'm really sorry about your board."
    pc "Kaykayına olanlara gerçekten üzüldüm."

# game/Scenes/Kendra/kendra3.rpy:93
translate turkish kendra3_3f13132b_1:

    # sg "Yeah."
    sg "Evet."

# game/Scenes/Kendra/kendra3.rpy:94
translate turkish kendra3_0fcd3eab:

    # sg "All right, see you later."
    sg "Tamam, sonra görüşürüz."

# game/Scenes/Kendra/kendra3.rpy:96
translate turkish kendra3_6de3adac:

    # "She gets out of my car and walks away towards the skate park, her head hanging low."
    "Arabamdan inip başını öne eğmiş bir şekilde kaykay parkına doğru uzaklaşıyor."

# game/Scenes/Kendra/kendra3.rpy:99
translate turkish kendra3_abb54c8d:

    # "I feel really bad for her. I mean, it wasn't really my fault, but still."
    "Onun için gerçekten çok üzülüyorum. Yani, aslında benim hatam değildi ama yine de."

# game/Scenes/Kendra/kendra3.rpy:100
translate turkish kendra3_48ac3316:

    # "Maybe I can get her a new board? I don't think there's a place in town that sells them, but I can check the internet."
    "Belki ona yeni bir kaykay alabilirim? Kasabada satan bir yer olduğunu sanmıyorum ama internette bakabilirim."

# game/Scenes/Kendra/kendra3.rpy:101
translate turkish kendra3_91fb525a:

    # "I should get on the laptop in my bedroom and see if I can find anything."
    "Yatak odamdaki dizüstü bilgisayarı açıp bir şey bulabilecek miyim diye bakmalıyım."

translate turkish strings:

    # game/Scenes/Kendra/kendra3.rpy:2
    old "A few days after you meet Kendra,"
    new "Kendra ile tanıştıktan birkaç gün sonra,"

    # game/Scenes/Kendra/kendra3.rpy:3
    old "this scene will happen automatically in the evening when you're driving."
    new "bu sahne akşamları araba sürerken otomatik olarak gerçekleşecek."

    # game/Scenes/Kendra/kendra3.rpy:35
    old "What the hell are you doing?"
    new "Ne halt ediyorsun sen?"

    # game/Scenes/Kendra/kendra3.rpy:42
    old "Oh God, I killed her, time to GTFO."
    new "Aman Tanrım, onu öldürdüm, buradan hemen defolmam lazım."

