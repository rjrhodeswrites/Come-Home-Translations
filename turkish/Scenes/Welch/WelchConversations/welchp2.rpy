    # sst "Never."
    sst "Asla."

# game/Scenes/Welch/WelchConversations/welchp2.rpy:15
translate turkish welchp2_b98d95b5:

    # sst "Well, there was Jeremy, but I only fucked him {i}after{/i} he dropped out."
    sst "Şey, Jeremy vardı ama onunla sadece {i}okulu bıraktıktan sonra{/i} sikiştim."

# game/Scenes/Welch/WelchConversations/welchp2.rpy:16
translate turkish welchp2_a285fe28:

    # sst "And that was only because we bumped into each other at the club and I'd had a bit too much rum."
    sst "Ve o da sadece kulüpte tesadüfen karşılaştığımız ve benim biraz fazla rom içtiğim içindi."

# game/Scenes/Welch/WelchConversations/welchp2.rpy:17
translate turkish welchp2_bc4efacb:

    # sst "I didn't even recognize him until he told me after that he'd always had a crush on me."
    sst "O bana daha sonra her zaman benden hoşlandığını söyleyene kadar onu tanıyamadım bile."

# game/Scenes/Welch/WelchConversations/welchp2.rpy:19
translate turkish welchp2_31a5a00b:

    # sst "You're the only one I've taken a risk with, fucking while you're still in my class."
    sst "Hala sınıfımdayken seninle yatarak risk aldığım tek kişi sensin."

# game/Scenes/Welch/WelchConversations/welchp2.rpy:20
translate turkish welchp2_f1a797a3:

    # sst "Actually fucking {i}in{/i} my classroom."
    sst "Aslında {i}sınıfımda{/i} yattık."

# game/Scenes/Welch/WelchConversations/welchp2.rpy:22
translate turkish welchp2_92a5851e:

    # sst "Which is so stupid. I can't believe I did that."
    sst "Bu çok aptalca. Bunu yaptığıma inanamıyorum."

# game/Scenes/Welch/WelchConversations/welchp2.rpy:24
translate turkish welchp2_b4cc7836:

    # sst "Did you always have a crush on me, like Jeremy did?"
    sst "Jeremy gibi sen de bana hep aşık mıydın?"

# game/Scenes/Welch/WelchConversations/welchp2.rpy:28
translate turkish welchp2_4cb217e1:

    # sst "Honestly, me too."
    sst "Dürüst olmak gerekirse, ben de."

# game/Scenes/Welch/WelchConversations/welchp2.rpy:31
translate turkish welchp2_27f4943f:

    # sst "Yeah, I definitely had a crush on you."
    sst "Evet, sana kesinlikle aşıktım."

# game/Scenes/Welch/WelchConversations/welchp2.rpy:32
translate turkish welchp2_24d4453a:

    # sst "I really wanted to see what you were like outside of the classroom though."
    sst "Ama sınıfın dışında nasıl biri olduğunu gerçekten görmek istiyordum."

# game/Scenes/Welch/WelchConversations/welchp2.rpy:34
translate turkish welchp2_62e36162:

    # sst "That's absolutely why I made you stay late that time to help register voters."
    sst "İşte bu yüzden o zaman seni geç saatlere kadar kalıp seçmen kaydı yapmana yardım ettirdim."

# game/Scenes/Welch/WelchConversations/welchp2.rpy:35
translate turkish welchp2_664052a9:

    # sst "You and Adrian."
    sst "Sen ve Adrian."

# game/Scenes/Welch/WelchConversations/welchp2.rpy:36
translate turkish welchp2_b7e6ebc6:

    # sst "Anyway, I know I should wait until you graduate. It's a {i}really{/i} bad idea to get involved with a student."
    sst "Her neyse, mezun olana kadar beklemem gerektiğini biliyorum. Bir öğrenciyle ilişki kurmak {i}gerçekten{/i} kötü bir fikir."

# game/Scenes/Welch/WelchConversations/welchp2.rpy:38
translate turkish welchp2_637b9991:

    # sst "But I'm weak."
    sst "Ama ben zayıfım."

# game/Scenes/Welch/WelchConversations/welchp2.rpy:39
translate turkish welchp2_2aa85b5e:

    # sst "And you're so fucking hot."
    sst "Ve sen çok seksi birisin."

# game/Scenes/Welch/WelchConversations/welchp2.rpy:41
translate turkish welchp2_7157f619:

    # sst "I feel dumb, but honestly, I just want to be with you."
    sst "Kendimi aptal hissediyorum, ama dürüst olmak gerekirse, sadece seninle birlikte olmak istiyorum."

# game/Scenes/Welch/WelchConversations/welchp2.rpy:42
translate turkish welchp2_8fe3d7fa:

    # sst "I..."
    sst "Ben..."

# game/Scenes/Welch/WelchConversations/welchp2.rpy:44
translate turkish welchp2_35ada172:

    # sst "We should talk about something else. I'm getting emotional and acting stupid."
    sst "Başka bir şeyden konuşmalıyız. Duygusallaşıyorum ve aptalca davranıyorum."

# game/Scenes/Welch/WelchConversations/welchp2.rpy:45
translate turkish welchp2_b9ca7006:

    # pc "You're not stupid. I like being with you too."
    pc "Aptal değilsin. Ben de seninle birlikte olmaktan hoşlanıyorum."

# game/Scenes/Welch/WelchConversations/welchp2.rpy:47
translate turkish welchp2_4d517773:

    # sst "Thanks, [pcname]."
    sst "Teşekkürler, [pcname]."

