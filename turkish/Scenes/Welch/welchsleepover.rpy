# game/Scenes/Welch/welchsleepover.rpy:3
translate turkish welchsleepover_60772138:

    # sst "Good, let's get ready for bed then. I'm exhausted."
    sst "Tamam, o zaman yatmaya hazırlanalım. Çok yorgunum."

# game/Scenes/Welch/welchsleepover.rpy:5
translate turkish welchsleepover_324c58ca:

    # "We brush our teeth and get ready for bed, then lie together, holding each other close."
    "Dişlerimizi fırçalayıp yatmaya hazırlanıyoruz, sonra birbirimize sıkıca sarılarak yan yana uzanıyoruz."

# game/Scenes/Welch/welchsleepover.rpy:7
translate turkish welchsleepover_fa86adb6:

    # sst "Wow... I really like this."
    sst "Vay canına... Bunu gerçekten çok seviyorum."

# game/Scenes/Welch/welchsleepover.rpy:8
translate turkish welchsleepover_85e75757:

    # pc "Yeah? Me too."
    pc "Öyle mi? Ben de."

# game/Scenes/Welch/welchsleepover.rpy:9
translate turkish welchsleepover_51f2ba34:

    # sst "I feel safe with you, like I haven't with any man in a long time."
    sst "Seninleyken kendimi güvende hissediyorum, uzun zamandır hiçbir erkekte hissetmediğim bir his bu."

# game/Scenes/Welch/welchsleepover.rpy:10
translate turkish welchsleepover_309efed4:

    # pc "I'm glad. You are safe with me."
    pc "Buna sevindim. Benimle güvendesin."

# game/Scenes/Welch/welchsleepover.rpy:12
translate turkish welchsleepover_3a6deb7e:

    # sst "I think I'm starting to get feelings for you..."
    sst "Sanırım sana karşı hislerim oluşmaya başlıyor..."

# game/Scenes/Welch/welchsleepover.rpy:13
translate turkish welchsleepover_97a93af4:

    # sst "Like, more than just wanting-to-fuck-you feelings."
    sst "Yani, sadece \"seni becermek istiyorum\" hislerinden daha fazlası."

# game/Scenes/Welch/welchsleepover.rpy:14
translate turkish welchsleepover_eaa69a9a:

    # sst "We can talk about it more later, when I'm not so tired, but..."
    sst "Daha sonra, bu kadar yorgun olmadığımda bu konuyu daha fazla konuşabiliriz, ama..."

# game/Scenes/Welch/welchsleepover.rpy:15
translate turkish welchsleepover_8c55322f:

    # sst "It feels nice."
    sst "Bu çok hoş bir his."

# game/Scenes/Welch/welchsleepover.rpy:18
translate turkish welchsleepover_d41d8cd9:

    # voice 'voices/welch_goodnight1.mp3'
    voice 'voices/welch_goodnight1.mp3'

# game/Scenes/Welch/welchsleepover.rpy:19
translate turkish welchsleepover_a53d3b6c:

    # sst "Good night, [pcname]."
    sst "İyi geceler, [pcname]."

# game/Scenes/Welch/welchsleepover.rpy:20
translate turkish welchsleepover_06ffce5e:

    # pc "Good night, Nora."
    pc "İyi geceler, Nora."

# game/Scenes/Welch/welchsleepover.rpy:23
translate turkish welchsleepover_daeb21c6:

    # "I hold her close and fall asleep quickly, sleeping soundly through the night."
    "Onu sıkıca sarıp çabucak uykuya dalıyorum, bütün gece derin bir uykuya dalıyorum."

# game/Scenes/Welch/welchsleepover.rpy:26
translate turkish welchsleepover_4b3ebb69:

    # "In the morning, I wake up with the sun shining in through the large windows of Nora's bedroom."
    "Sabah, Nora’nın yatak odasının büyük pencerelerinden içeri süzülen güneş ışığıyla uyanıyorum."

# game/Scenes/Welch/welchsleepover.rpy:27
translate turkish welchsleepover_1bb89dc0:

    # "She's not in bed with me anymore, but I smell the scent of fresh coffee coming from downstairs."
    "Artık benimle yatakta değil, ama aşağıdan gelen taze kahve kokusunu alıyorum."

# game/Scenes/Welch/welchsleepover.rpy:31
translate turkish welchcoffee_b61ee1d9:

    # sst "Oh, good morning. I was just about to come up and wake you."
    sst "Ah, günaydın. Tam yukarı çıkıp seni uyandırmak üzereydim."

# game/Scenes/Welch/welchsleepover.rpy:32
translate turkish welchcoffee_0d43b64c:

    # sst "I made coffee."
    sst "Kahve yaptım."

# game/Scenes/Welch/welchsleepover.rpy:35
translate turkish welchcoffee_23486537:

    # sst "See, I'm not just a man-hating feminist."
    sst "Gördün mü, ben sadece erkeklerden nefret eden bir feminist değilim."

# game/Scenes/Welch/welchsleepover.rpy:36
translate turkish welchcoffee_6d96fe98:

    # sst "I can make coffee for a guy if he treats me right. And you treated me so good last night."
    sst "Bana iyi davranırsa bir erkeğe kahve yapabilirim. Ve dün gece bana çok iyi davrandın."

# game/Scenes/Welch/welchsleepover.rpy:39
translate turkish welchcoffee_736796a9:

    # "We sit and drink coffee and chat for a bit."
    "Oturup kahve içip biraz sohbet ediyoruz."

# game/Scenes/Welch/welchsleepover.rpy:40
translate turkish welchcoffee_0f3db852:

    # sst "This was really nice. I actually like waking up with you."
    sst "Bu gerçekten çok hoştu. Aslında seninle uyanmayı seviyorum."

# game/Scenes/Welch/welchsleepover.rpy:41
translate turkish welchcoffee_51eed03e:

    # pc "I like waking up with you too, Nora."
    pc "Ben de seninle uyanmayı seviyorum, Nora."

# game/Scenes/Welch/welchsleepover.rpy:42
translate turkish welchcoffee_828e685e:

    # sst "Well, you can stay over any time you like. It's worth the risk."
    sst "Peki, istediğin zaman kalabilirsin. Bu riske değer."

# game/Scenes/Welch/welchsleepover.rpy:45
translate turkish welchcoffee_550f71f3:

    # "When we finish our coffee, it's time for me to go."
    "Kahvemizi bitirdiğimizde, benim gitme vaktim geldi."

# game/Scenes/Welch/welchsleepover.rpy:47
translate turkish welchcoffee_98c3bb25:

    # sst "Have a good day, [pcname]. Let's do this again soon."
    sst "İyi günler, [pcname]. Bunu yakında tekrar yapalım."

# game/Scenes/Welch/welchsleepover.rpy:50
translate turkish welchcoffee_6799ac6f:

    # "I get in my car and leave Nora's house to go on with the rest of my day."
    "Arabama biniyorum ve günümün geri kalanını geçirmek için Nora’nın evinden ayrılıyorum."

