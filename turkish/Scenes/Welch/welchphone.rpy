translate turkish welchphone_5ad25ed7:

    # sst "Hey, [pcname]. Glad to hear from you."
    sst "Selam, [pcname]. Senden haber aldığıma sevindim."

# game/Scenes/Welch/welchphone.rpy:36
translate turkish welchphone_8fcbff0a:

    # sst "Did you want to meet me somewhere, or just chat?"
    sst "Bir yerde buluşmak mı istiyordun, yoksa sadece sohbet etmek mi?"

# game/Scenes/Welch/welchphone.rpy:47
translate turkish welchphone_ee6a99d8:

    # sst "Did you want to chat... or maybe come stay the night with me? My bed feels so empty right now."
    sst "Sohbet etmek mi istiyordun... yoksa belki de gelip bende kalmak mı? Yatağım şu anda çok boş geliyor."

# game/Scenes/Welch/welchphone.rpy:51
translate turkish welchphone_00c1542e:

    # sst "Good, I'll be waiting for you then."
    sst "Tamam, o zaman seni bekliyor olacağım."

