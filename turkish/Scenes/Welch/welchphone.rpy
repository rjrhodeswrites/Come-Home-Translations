    sst "Selam, [pcname]! Arayacağını umuyordum."

# game/Scenes/Welch/welchphone.rpy:21
translate turkish welchphone_fbdf6074:

    # pc "Of course. Was there something you wanted to talk to me about."
    pc "Tabii ki. Benimle konuşmak istediğin bir şey mi vardı?"

# game/Scenes/Welch/welchphone.rpy:23
translate turkish welchphone_b6013596:

    # sst "No, nothing specific. Just..."
    sst "Hayır, özel bir şey yok. Sadece..."

# game/Scenes/Welch/welchphone.rpy:24
translate turkish welchphone_0e18554b:

    # sst "Well you know I said we'd wait until after you graduated and then see what happened?"
    sst "Hani mezun olana kadar bekleyip sonra ne olacağını göreceğimizi söylemiştim, hatırlıyor musun?"

# game/Scenes/Welch/welchphone.rpy:26
translate turkish welchphone_a2db96f4:

    # sst "I'm just having a hard time waiting."
    sst "Beklemek bana zor geliyor."

# game/Scenes/Welch/welchphone.rpy:27
translate turkish welchphone_5e4b2f9e:

    # sst "I like talking to you. I just wanted to talk."
    sst "Seninle konuşmayı seviyorum. Sadece konuşmak istedim."

# game/Scenes/Welch/welchphone.rpy:28
translate turkish welchphone_6e9ba7f2:

    # sst "I figure talking on the phone at night isn't going to hurt anything? Nobody is going to know about that."
    sst "Sanırım gece telefonda konuşmanın bir zararı olmaz, değil mi? Kimse bunu bilmeyecek."

# game/Scenes/Welch/welchphone.rpy:29
translate turkish welchphone_d0c89101:

    # pc "I guess that's true."
    pc "Sanırım haklısın."

# game/Scenes/Welch/welchphone.rpy:30
translate turkish welchphone_b6bcfe3c:

    # sst "So we can talk about anything you'd like."
    sst "O halde istediğin her konuda konuşabiliriz."

# game/Scenes/Welch/welchphone.rpy:33
