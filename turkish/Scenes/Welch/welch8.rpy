# game/Scenes/Welch/welch8.rpy:11
translate turkish welch8_e370a99a:

    # "Ms. Welch's class goes fairly normally, but she talks a lot about early voting, which started today."
    "Bayan Welch’in dersi oldukça normal geçiyor, ancak bugün başlayan erken oy kullanma hakkında çok konuşuyor."

# game/Scenes/Welch/welch8.rpy:12
translate turkish welch8_ac72d3bc:

    # "When it is time to leave, she approaches and stops me, asking me to stay back for a moment."
    "Ayrılma vakti geldiğinde yanıma yaklaşıp beni durduruyor ve bir an için geride kalmamı istiyor."

# game/Scenes/Welch/welch8.rpy:14
translate turkish welch8_ed639bcf:

    # sst "Hey, [pcname]. I was wondering if you would want to come with me to do our early voting this evening?"
    sst "Selam, [pcname]. Acaba bu akşam benimle birlikte erken oy kullanmaya gelmek ister misin diye merak ediyordum?"

# game/Scenes/Welch/welch8.rpy:15
translate turkish welch8_49f56cb1:

    # pc "I have to work after school."
    pc "Okuldan sonra çalışmam gerekiyor."

# game/Scenes/Welch/welch8.rpy:16
translate turkish welch8_828d6de8:

    # sst "That's fine, so do I. The booths are open until seven."
    sst "Sorun değil, ben de öyle. Oy kabinleri yediye kadar açık."

# game/Scenes/Welch/welch8.rpy:23
translate turkish welch8_7730cc66:

    # sst "Okay, I just thought it would be something you would be into."
    sst "Tamam, sadece senin ilgini çekeceğini düşündüm."

# game/Scenes/Welch/welch8.rpy:24
translate turkish welch8_60af7c4c:

    # sst "No problem. See you around then."
    sst "Sorun değil. O zaman görüşürüz."

# game/Scenes/Welch/welch8.rpy:27
translate turkish welch8_6ef548be:

    # "I leave Ms. Welch's class, knowing that I missed out on something. It's really not a good idea to continue any sort of relationship with her though."
    "Bayan Welch'in dersinden çıkarken, bir şeyi kaçırdığımı biliyorum. Yine de onunla herhangi bir ilişki sürdürmek hiç de iyi bir fikir değil."

# game/Scenes/Welch/welch8.rpy:28
translate turkish welch8_f1418a3f:

    # "It could really only lead to trouble."
    "Bu gerçekten sadece belaya yol açabilir."

# game/Scenes/Welch/welch8.rpy:33
translate turkish welch8_f836da85:

    # sst "Good, I'm glad to hear it!"
    sst "Güzel, bunu duyduğuma sevindim!"

# game/Scenes/Welch/welch8.rpy:34
translate turkish welch8_d1ebe2c4:

    # sst "Just come pick me up here when you get off work."
    sst "İşten çıkınca beni buradan al."

# game/Scenes/Welch/welch8.rpy:35
translate turkish welch8_01937090:

    # pc "Okay. See you then."
    pc "Tamam. O zaman görüşürüz."

# game/Scenes/Welch/welch8.rpy:37
translate turkish welch8_6042819c:

    # sst "Looking forward to it."
    sst "Sabırsızlıkla bekliyorum."

# game/Scenes/Welch/welch8.rpy:38
translate turkish welch8_fc175b3b:

    # "I leave her class and go on to the next, looking forward to hanging out with her again that evening."
    "Onun dersinden çıkıp bir sonrakine geçiyorum, o akşam yine onunla vakit geçirmeyi dört gözle bekliyorum."

# game/Scenes/Welch/welch8.rpy:52
translate turkish welch8date_41e59cbe:

    # "I'm supposed to pick up Ms. Welch to go vote, so I start heading towards the school."
    "Oy vermek için Bayan Welch’i almam gerekiyor, bu yüzden okula doğru yola çıkıyorum."

# game/Scenes/Welch/welch8.rpy:53
translate turkish welch8date_e9477873:

    # "I pull up front of the school and see that she's standing outside waiting for me, looking beautiful."
    "Okulun önüne park ediyorum ve onun dışarıda beni beklediğini görüyorum, çok güzel görünüyor."

# game/Scenes/Welch/welch8.rpy:54
translate turkish welch8date_d46f44ce:

    # "She spots me and walks towards the car."
    "Beni fark ediyor ve arabaya doğru yürüyor."

# game/Scenes/Welch/welch8.rpy:59
translate turkish welch8date_19ccb77a:

    # "She gets in the car, looking excited."
    "Arabaya biniyor, heyecanlı görünüyor."

# game/Scenes/Welch/welch8.rpy:60
translate turkish welch8date_02521388:

    # sst "Woo! Let's vote!"
    sst "Vay canına! Hadi oy verelim!"

# game/Scenes/Welch/welch8.rpy:61
translate turkish welch8date_0f3cf124:

    # pc "Ha! You're ready for this, huh?"
    pc "Ha! Buna hazır mısın, ha?"

# game/Scenes/Welch/welch8.rpy:62
translate turkish welch8date_d1363569:

    # sst "Hell yes I am! I look forward to this every year."
    sst "Tabii ki hazırım! Her yıl bunu iple çekiyorum."

# game/Scenes/Welch/welch8.rpy:63
translate turkish welch8date_2e3ddbf8:

    # sst "This year is extra good though because we can finally vote that FUCK out of office."
    sst "Bu yıl ise ekstra güzel çünkü nihayet o PİÇİ görevden alabileceğiz."

# game/Scenes/Welch/welch8.rpy:64
translate turkish welch8date_cb5d6ca4:

    # "I'm not exactly sure which fuck she's talking about, but I drive towards the courthouse anyway."
    "Tam olarak hangi piçten bahsettiğini bilmiyorum ama yine de adliyeye doğru sürüyorum."

# game/Scenes/Welch/welch8.rpy:67
translate turkish welch8date_65923c3b:

    # "When we get to the voting location, we make our way inside together. I hold the door for her as we walk in."
    "Oy verme yerine vardığımızda, birlikte içeri giriyoruz. İçeri girerken kapıyı onun için tutuyorum."

# game/Scenes/Welch/welch8.rpy:68
translate turkish welch8date_f8aea9e5:

    # sst "Look at how empty this fucking place is."
    sst "Şu lanet yerin ne kadar boş olduğuna bir bak."

# game/Scenes/Welch/welch8.rpy:69
translate turkish welch8date_65a95876:

    # sst "Like nobody cares about voting anymore, so all these old white dudes get to decide what happens in our country."
    sst "Sanki artık kimse oy vermeyi umursamıyor gibi, bu yüzden ülkemizde ne olacağına karar verme işi tamamen bu yaşlı beyaz adamlara kalıyor."

# game/Scenes/Welch/welch8.rpy:70
translate turkish welch8date_ec17810b:

    # sst "It's bullshit."
    sst "Tam bir saçmalık."

# game/Scenes/Welch/welch8.rpy:73
translate turkish welch8date_0a35ac31:

    # "We walk inside and cast our votes. The whole process takes about ten minutes, then we're leaving again."
    "İçeri girip oylarımızı kullanıyoruz. Tüm süreç yaklaşık on dakika sürüyor, sonra tekrar çıkıyoruz."

# game/Scenes/Welch/welch8.rpy:84
translate turkish welch8date_5e208c7b:

    # "When we're done we walk out together once again."
    "İşimiz bittiğinde yine birlikte dışarı çıkıyoruz."

# game/Scenes/Welch/welch8.rpy:85
translate turkish welch8date_0cbc266f:

    # "She's so close to me, I feel this urge to put my arm around her, or grab her hand, but I'm not sure how she would respond to that."
    "Bana o kadar yakın ki, kolumu omzuna atma ya da elini tutma isteği duyuyorum, ama buna nasıl tepki vereceğinden emin değilim."

# game/Scenes/Welch/welch8.rpy:86
translate turkish welch8date_09fa6cb0:

    # sst "See how easy that was? I just will never understand why more people don't just go do it."
    sst "Ne kadar kolay olduğunu gördün mü? Neden daha fazla insan bunu yapmıyor, bunu asla anlayamayacağım."

# game/Scenes/Welch/welch8.rpy:89
translate turkish welch8date_2b774f4b:

    # "Back in the car, she puts her hand on my shoulder."
    "Arabaya geri döndüğümüzde, elini omzuma koyuyor."

# game/Scenes/Welch/welch8.rpy:90
translate turkish welch8date_3487914a:

    # sst "Hey, [pcname]? Before we go back to the school, would you want to maybe grab a bite to eat somewhere? I'm starving!"
    sst "Hey, [pcname]? Okula dönmeden önce, belki bir yerlerde bir şeyler atıştırmak ister misin? Açlıktan ölüyorum!"

# game/Scenes/Welch/welch8.rpy:93
translate turkish welch8date_d251e37e:

    # sst "Cool."
    sst "Harika."

# game/Scenes/Welch/welch8.rpy:95
translate turkish welch8date_edc1e092:

    # sst "It's not like we're going on a date or anything. Just wanted to eat and chat a bit."
    sst "Sanki randevuya çıkıyoruz falan değil ya. Sadece bir şeyler yiyip biraz sohbet etmek istedim."

# game/Scenes/Welch/welch8.rpy:96
translate turkish welch8date_fdc38997:

    # pc "I guess that's okay."
    pc "Sanırım sorun yok."

# game/Scenes/Welch/welch8.rpy:97
translate turkish welch8date_0ad4fc7f:

    # sst "You know where Jackson Burger is?"
    sst "Jackson Burger'ın nerede olduğunu biliyor musun?"

# game/Scenes/Welch/welch8.rpy:98
translate turkish welch8date_f7050fd9:

    # pc "Of course. That's my favorite place."
    pc "Tabii ki. Orası en sevdiğim yer."

# game/Scenes/Welch/welch8.rpy:99
translate turkish welch8date_deca7d0a:

    # sst "Mine too! Kinda surprised we've never seen each other there."
    sst "Benim de! Orada hiç karşılaşmamış olmamıza biraz şaşırdım."

# game/Scenes/Welch/welch8.rpy:102
translate turkish welch8date_a00919c9:

    # "We go into Jackson Burger and sit in the same booth I always sit."
    "Jackson Burger'a girip her zamanki masama oturduk."

# game/Scenes/Welch/welch8.rpy:103
translate turkish welch8date_baa82516:

    # "I'm not sure if Ms. Welch would consider this a date, but man it feels like one to me."
    "Bayan Welch'in bunu bir randevu olarak kabul edip etmeyeceğinden emin değilim, ama bana öyle geliyor."

# game/Scenes/Welch/welch8.rpy:104
translate turkish welch8date_2352f145:

    # sst "So how have you been doing in school? You're doing great in my class, but what about the others?"
    sst "Peki, okulda nasıl gidiyor? Benim dersimde harika gidiyorsun, peki ya diğerleri?"

# game/Scenes/Welch/welch8.rpy:105
translate turkish welch8date_306db6b2:

    # pc "I'm doing well. It's all pretty easy this semester. I did all my hard classes down in Brazil."
    pc "İyi gidiyorum. Bu dönem her şey oldukça kolay. Zor derslerimi Brezilya'da bitirdim."

# game/Scenes/Welch/welch8.rpy:106
translate turkish welch8date_1128d67d:

    # sst "That's good. On track for graduating this summer then?"
    sst "Bu iyi. O zaman bu yaz mezun olmaya hazır mısın?"

# game/Scenes/Welch/welch8.rpy:107
translate turkish welch8date_bd944b53:

    # pc "So far, so good."
    pc "Şu ana kadar her şey yolunda."

# game/Scenes/Welch/welch8.rpy:110
translate turkish welch8date_577cbbfa:

    # "Mari comes over to take our order. I hope she's not upset with seeing me here with another woman."
    "Mari siparişimizi almak için yanımıza geliyor. Umarım beni burada başka bir kadınla görünce kızmaz."

# game/Scenes/Welch/welch8.rpy:112
translate turkish welch8date_7f44914c:

    # "Mari comes over to take our order."
    "Mari siparişimizi almak için yanımıza geliyor."

# game/Scenes/Welch/welch8.rpy:114
translate turkish welch8date_228fccce:

    # "The waitress comes over to take our order."
    "Garson siparişimizi almak için yanımıza geliyor."

# game/Scenes/Welch/welch8.rpy:117
translate turkish welch8date_6490ec61:

    # "She looks so happy, and for a moment I think her smile is aimed at me, but then she turns towards Ms. Welch."
    "Çok mutlu görünüyor ve bir an için gülümsemesinin bana yönelik olduğunu sanıyorum, ama sonra Bayan Welch'e dönüyor."

# game/Scenes/Welch/welch8.rpy:118
translate turkish welch8date_0171813b:

    # fr "Nora! It's so good to see you."
    fr "Nora! Seni görmek ne güzel."

# game/Scenes/Welch/welch8.rpy:119
translate turkish welch8date_adc018c6:

    # sst "Oh hey Mari! Good to see you too. You're looking gorgeous as always."
    sst "Oh hey Mari! Seni de görmek güzel. Her zamanki gibi muhteşem görünüyorsun."

# game/Scenes/Welch/welch8.rpy:120
translate turkish welch8date_98d921ae:

    # fr "Aww, thank you so much! You look amazing yourself."
    fr "Aww, çok teşekkür ederim! Sen de harika görünüyorsun."

# game/Scenes/Welch/welch8.rpy:124
translate turkish welch8date_4802059e:

    # fr "How do you know, [pcname]?"
    fr "Nereden biliyorsun, [pcname]?"

# game/Scenes/Welch/welch8.rpy:125
translate turkish welch8date_eef5640a:

    # sst "Oh, well he's in my class. We just went to go vote and figured we'd get a bite to eat."
    sst "Ah, o benim sınıfımdan. Az önce oy vermeye gittik ve bir şeyler yiyelim dedik."

# game/Scenes/Welch/welch8.rpy:126
translate turkish welch8date_896d0e76:

    # fr "Oh, so not a date or anything?"
    fr "Ah, yani randevu falan değil mi?"

# game/Scenes/Welch/welch8.rpy:127
translate turkish welch8date_9902960f:

    # sst "No, not at all. Just eating and talking as friends."
    sst "Hayır, hiç de değil. Sadece arkadaş olarak yemek yiyip sohbet ediyoruz."

# game/Scenes/Welch/welch8.rpy:128
translate turkish welch8date_3138a93f:

    # pc "Um, how do you two know each other?"
    pc "Şey, siz ikiniz birbirinizi nereden tanıyorsunuz?"

# game/Scenes/Welch/welch8.rpy:129
translate turkish welch8date_ed252a8a:

    # fr "Just from here. She comes in and gets a burger all the time!"
    fr "Buradan. O sürekli buraya gelip hamburger alıyor!"

# game/Scenes/Welch/welch8.rpy:130
translate turkish welch8date_08efffd7:

    # sst "And Mari's the best waitress in the world."
    sst "Ve Mari dünyadaki en iyi garson."

# game/Scenes/Welch/welch8.rpy:131
translate turkish welch8date_64c42d43:

    # fr "Aw, stop!"
    fr "Ah, kes şunu!"

# game/Scenes/Welch/welch8.rpy:135
translate turkish welch8date_c96db39f:

    # sst "Okay, now how do you two know each other?"
    sst "Tamam, peki siz ikiniz nasıl tanıştınız?"

# game/Scenes/Welch/welch8.rpy:137
translate turkish welch8date_31d8233e:

    # fr "Oh nothing. We had a bit of history, but it's over now."
    fr "Oh, hiçbir şey. Biraz geçmişimiz vardı, ama artık bitti."

# game/Scenes/Welch/welch8.rpy:138
translate turkish welch8date_78da6e12:

    # "Have to admit, it stings a little to hear her say that."
    "İtiraf etmeliyim ki, bunu duymak biraz canımı yakıyor."

# game/Scenes/Welch/welch8.rpy:140
translate turkish welch8date_8f0557cc:

    # fr "Oh, we've been dating a bit."
    fr "Oh, bir süredir çıkıyoruz."

# game/Scenes/Welch/welch8.rpy:141
translate turkish welch8date_6d86b8d7:

    # sst "Oh yeah?"
    sst "Öyle mi?"

# game/Scenes/Welch/welch8.rpy:142
translate turkish welch8date_32607601:

    # fr "Yeah."
    fr "Evet."

# game/Scenes/Welch/welch8.rpy:143
translate turkish welch8date_005e936c:

    # sst "Are you two serious?"
    sst "İkiniz ciddi misiniz?"

# game/Scenes/Welch/welch8.rpy:145
translate turkish welch8date_0c4a9fc4:

    # "Mari blushes a little."
    "Mari biraz kızarır."

# game/Scenes/Welch/welch8.rpy:146
translate turkish welch8date_d8e78862:

    # fr "Kinda serious, yeah."
    fr "Biraz ciddiyiz, evet."

# game/Scenes/Welch/welch8.rpy:147
translate turkish welch8date_918ecf60:

    # fr "Not exclusive or anything, but we enjoy each other's company."
    fr "Sadece birbirimize ait değiliz ama birbirimizin şirketinden keyif alıyoruz."

# game/Scenes/Welch/welch8.rpy:148
translate turkish welch8date_fef9522c:

    # sst "Ah, I get it. Say no more."
    sst "Ah, anladım. Daha fazla bir şey söyleme."

# game/Scenes/Welch/welch8.rpy:150
translate turkish welch8date_0c4a9fc4_1:

    # "Mari blushes a little."
    "Mari biraz kızarır."

# game/Scenes/Welch/welch8.rpy:151
translate turkish welch8date_1e997bea:

    # fr "Not yet, but we'll see where things go."
    fr "Henüz değil, ama işler nasıl gelişecek göreceğiz."

# game/Scenes/Welch/welch8.rpy:152
translate turkish welch8date_3b101359:

    # sst "Ooh, a little romance. I like it. Say no more."
    sst "Ooh, biraz romantizm. Hoşuma gitti. Daha fazla bir şey söyleme."

# game/Scenes/Welch/welch8.rpy:154
translate turkish welch8date_59aa8d7d:

    # fr "Oh, he's another frequent customer. I'm surprised you two haven't bumped into each other here."
    fr "Oh, o da sık gelen müşterilerimizden biri. İkinizin burada birbirinize rastlamamış olmanıza şaşırdım."

# game/Scenes/Welch/welch8.rpy:155
translate turkish welch8date_857dd542:

    # sst "That's what I was saying earlier!"
    sst "Ben de az önce bunu söylüyordum!"

# game/Scenes/Welch/welch8.rpy:156
translate turkish welch8date_aa0dc8a1:

    # fr "Well, I'll go get your meals ready. Be back in a bit."
    fr "Peki, gidip yemeklerinizi hazırlayayım. Hemen dönerim."

# game/Scenes/Welch/welch8.rpy:161
translate turkish welch8date_cd2d7012:

    # sst "Man, I can't believe you blew it with her."
    sst "Dostum, onunla işleri mahvettiğine inanamıyorum."

# game/Scenes/Welch/welch8.rpy:162
translate turkish welch8date_52d2fdd9:

    # sst "Big oof there."
    sst "Büyük bir çuvallama olmuş."

# game/Scenes/Welch/welch8.rpy:164
translate turkish welch8date_6ab19db4:

    # sst "Good job with her. She's a sweet girl. Super hot too."
    sst "Onunla iyi iş çıkardın. Çok tatlı bir kız. Bir de süper seksi."

# game/Scenes/Welch/welch8.rpy:165
translate turkish welch8date_1c722351:

    # pc "Yeah she is."
    pc "Evet, öyle."

# game/Scenes/Welch/welch8.rpy:167
translate turkish welch8date_a5af6fb9:

    # "Izzy comes over to take our order."
    "Izzy siparişimizi almak için yanımıza geliyor."

# game/Scenes/Welch/welch8.rpy:170
translate turkish welch8date_0d87a734:

    # gl "Yo, what's up, Nora?"
    gl "Selam, naber Nora?"

# game/Scenes/Welch/welch8.rpy:171
translate turkish welch8date_c73bc40f:

    # sst "Oh hey, Izzy! I didn't even know you worked here!"
    sst "Oh hey, Izzy! Burada çalıştığını bile bilmiyordum!"

# game/Scenes/Welch/welch8.rpy:172
translate turkish welch8date_92415954:

    # gl "Yeah, [pcname] got me the job actually!"
    gl "Evet, [pcname] aslında bana bu işi ayarladı!"

# game/Scenes/Welch/welch8.rpy:173
translate turkish welch8date_cf30c7d8:

    # sst "Really? That's cool! How have you been?"
    sst "Gerçekten mi? Çok güzel! Nasılsın?"

# game/Scenes/Welch/welch8.rpy:174
translate turkish welch8date_36c577be:

    # gl "Ah, you know how it goes. Ups and downs. Doing okay right now though."
    gl "Ah, nasıl olduğunu bilirsin. İnişler çıkışlar. Şu anda fena değil ama."

# game/Scenes/Welch/welch8.rpy:175
translate turkish welch8date_87c52185:

    # sst "I'm glad to hear that."
    sst "Bunu duyduğuma sevindim."

# game/Scenes/Welch/welch8.rpy:178
translate turkish welch8date_ba4b70c8:

    # gl "How do you know [pcname]?"
    gl "[pcname]'i nereden tanıyorsun?"

# game/Scenes/Welch/welch8.rpy:179
translate turkish welch8date_eef5640a_1:

    # sst "Oh, well he's in my class. We just went to go vote and figured we'd get a bite to eat."
    sst "Ah, benim sınıfımdan. Az önce oy vermeye gittik ve bir şeyler yiyelim dedik."

# game/Scenes/Welch/welch8.rpy:180
translate turkish welch8date_6473eb14:

    # gl "Oh, cool."
    gl "Ah, harika."

# game/Scenes/Welch/welch8.rpy:181
translate turkish welch8date_3138a93f_1:

    # pc "Um, how do you two know each other?"
    pc "Şey, siz ikiniz birbirinizi nereden tanıyorsunuz?"

# game/Scenes/Welch/welch8.rpy:182
translate turkish welch8date_d69080bf:

    # sst "We met at a Black Lives Matters protest once and hung out."
    sst "Bir keresinde Black Lives Matter protestosunda tanıştık ve takıldık."

# game/Scenes/Welch/welch8.rpy:183
translate turkish welch8date_75eaadd9:

    # gl "Yeah, man. Sometimes you just gotta march. I got thrown in jail for that one."
    gl "Evet dostum. Bazen yürüyüşe çıkmak lazım. O protesto yüzünden hapse atıldım."

# game/Scenes/Welch/welch8.rpy:184
translate turkish welch8date_3d6983c0:

    # sst "Yeah, it was a fucking mess."
    sst "Evet, tam bir felaketti."

# game/Scenes/Welch/welch8.rpy:187
translate turkish welch8date_5996ac97:

    # sst "So are you two friends?"
    sst "Peki siz ikiniz arkadaş mısınız?"

# game/Scenes/Welch/welch8.rpy:188
translate turkish welch8date_c2319974:

    # gl "Yeah, were really good friends."
    gl "Evet, çok iyi arkadaşız."

# game/Scenes/Welch/welch8.rpy:189
translate turkish welch8date_ef534e8d:

    # sst "That's cool!"
    sst "Harika!"

# game/Scenes/Welch/welch8.rpy:190
translate turkish welch8date_59ad4e63:

    # gl "Well, anyways, it's good seeing you. What do y'all want to eat?"
    gl "Neyse, seni görmek güzel. Ne yemek istersiniz?"

# game/Scenes/Welch/welch8.rpy:191
translate turkish welch8date_f35deb44:

    # "She quickly takes our orders and then rushes to the back."
    "Siparişlerimizi çabucak aldı ve arka tarafa koştu."

# game/Scenes/Welch/welch8.rpy:194
translate turkish welch8date_26f19da2:

    # sst "Izzy's a sweet girl."
    sst "Izzy çok tatlı bir kız."

# game/Scenes/Welch/welch8.rpy:195
translate turkish welch8date_c417e350:

    # pc "Yeah."
    pc "Evet."

# game/Scenes/Welch/welch8.rpy:196
translate turkish welch8date_7288cc24:

    # sst "Super sexy too."
    sst "Ayrıca çok seksi."

# game/Scenes/Welch/welch8.rpy:197
translate turkish welch8date_2951ed74:

    # pc "Definitely."
    pc "Kesinlikle."

# game/Scenes/Welch/welch8.rpy:199
translate turkish welch8date_650af916:

    # sst "So, [pcname], I wanted to talk to you about something."
    sst "Ee, [pcname], seninle bir şey konuşmak istiyordum."

# game/Scenes/Welch/welch8.rpy:200
translate turkish welch8date_3e09ca60:

    # sst "I kind of have a crush on you."
    sst "Sana biraz aşık oldum galiba."

# game/Scenes/Welch/welch8.rpy:201
translate turkish welch8date_65a7cfea:

    # sst "I think you're funny, you're cute, and I love how you actually care about social problems."
    sst "Bence komiksin, sevimlisin ve sosyal sorunları gerçekten önemsemeni çok seviyorum."

# game/Scenes/Welch/welch8.rpy:202
translate turkish welch8date_97bcec87:

    # sst "I was just wondering... do you like me too?"
    sst "Merak ediyordum da... sen de benden hoşlanıyor musun?"

# game/Scenes/Welch/welch8.rpy:205
translate turkish welch8date_51ff6f14:

    # sst "Oh, thank the gods, I was afraid I might have made a big mistake here."
    sst "Oh, şükürler olsun, burada büyük bir hata yapmış olabileceğimden korkuyordum."

# game/Scenes/Welch/welch8.rpy:208
translate turkish welch8date_1f998150:

    # sst "Oh okay. No problem then."
    sst "Oh tamam. O zaman sorun yok."

# game/Scenes/Welch/welch8.rpy:210
translate turkish welch8date_c63e8c62:

    # "Ms. Welch and I have a somewhat uncomfortable dinner, then I take her back to the school and drop her off near her car."
    "Bayan Welch ile biraz rahatsız edici bir akşam yemeği yiyoruz, sonra onu okula geri götürüp arabasının yanına bırakıyorum."

# game/Scenes/Welch/welch8.rpy:211
translate turkish welch8date_070b1822:

    # "It's not a good idea to get involved with her any more than I already am."
    "Onunla şu anda olduğumdan daha fazla ilişki kurmak iyi bir fikir değil."

# game/Scenes/Welch/welch8.rpy:216
translate turkish welch8date_a7710f60:

    # sst "I'm really happy that you feel the same way."
    sst "Senin de aynı şekilde hissetmene gerçekten çok sevindim."

# game/Scenes/Welch/welch8.rpy:217
translate turkish welch8date_2103e901:

    # sst "I should tell you, I'm really bad at controlling my urges. And sometimes my urges get me into trouble."
    sst "Sana söylemeliyim ki, dürtülerimi kontrol etmekte gerçekten çok kötüyüm. Ve bazen bu dürtülerim başımı belaya sokuyor."

# game/Scenes/Welch/welch8.rpy:218
translate turkish welch8date_27c38463:

    # sst "We need to wait until you graduate and you're not in my class before we pursue any kind of relationship, okay?"
    sst "Herhangi bir ilişkiye başlamadan önce, mezun olmanı ve benim sınıfımdan ayrılmanı beklemeliyiz, tamam mı?"

# game/Scenes/Welch/welch8.rpy:219
translate turkish welch8date_4e669a5e:

    # sst "If anybody suspects that our relationship is anything more than friendly, I could lose my job."
    sst "Eğer biri ilişkimizin arkadaşlıktan öte bir şey olduğunu şüphelenirse, işimi kaybedebilirim."

# game/Scenes/Welch/welch8.rpy:220
translate turkish welch8date_e86f9bb1:

    # sst "I like you a lot, but I love my job and I don't want to lose it."
    sst "Senden çok hoşlanıyorum, ama işimi seviyorum ve onu kaybetmek istemiyorum."

# game/Scenes/Welch/welch8.rpy:221
translate turkish welch8date_34b44705:

    # pc "I understand."
    pc "Anlıyorum."

# game/Scenes/Welch/welch8.rpy:223
translate turkish welch8date_4a831597:

    # sst "If we can keep things calm and on the down-low for now though, after you graduate, maybe we could see where things go, okay?"
    sst "Şimdilik işleri sakin ve gizli tutabilirsek, mezun olduktan sonra belki de işlerin nasıl gelişeceğini görebiliriz, tamam mı?"

# game/Scenes/Welch/welch8.rpy:224
translate turkish welch8date_6c48c73f:

    # pc "That sounds good Ms. Welch."
    pc "Kulağa hoş geliyor Bayan Welch."

# game/Scenes/Welch/welch8.rpy:225
translate turkish welch8date_5ff805f3:

    # sst "Please, outside of class, you can call me Nora, okay?"
    sst "Lütfen, ders dışında bana Nora diyebilirsin, tamam mı?"

# game/Scenes/Welch/welch8.rpy:226
translate turkish welch8date_001845b4:

    # pc "Okay, Nora."
    pc "Tamam, Nora."

# game/Scenes/Welch/welch8.rpy:229
translate turkish welch8date_ea33992e:

    # "We chit-chat a little while we eat, just about school and politics. Nothing super interesting."
    "Yemek yerken biraz sohbet ediyoruz, sadece okul ve siyaset hakkında. Çok ilginç bir şey yok."

# game/Scenes/Welch/welch8.rpy:230
translate turkish welch8date_586b1732:

    # "Then, when we're done, I drive her back to her car at the school."
    "Sonra, yemeğimizi bitirdiğimizde, onu okuldaki arabasına kadar arabayla götürüyorum."

# game/Scenes/Welch/welch8.rpy:235
translate turkish welch8date_e684ed1f:

    # sst "Bye, [pcname]. Thanks for hanging out with me tonight. I really enjoyed it."
    sst "Hoşça kal, [pcname]. Bu akşam benimle vakit geçirdiğin için teşekkürler. Gerçekten çok keyif aldım."

# game/Scenes/Welch/welch8.rpy:236
translate turkish welch8date_7ebf0e6b:

    # pc "Me too, Nora."
    pc "Ben de, Nora."

# game/Scenes/Welch/welch8.rpy:237
translate turkish welch8date_3daf6d31:

    # sst "Ooh, something about you saying my name kinda gets me hot."
    sst "Ooh, adımı söylemen beni bir şekilde tahrik ediyor."

# game/Scenes/Welch/welch8.rpy:238
translate turkish welch8date_f13707ef:

    # sst "I wish I could invite you over to my house. I'd love to spend some more time with you. Hear you say my name some more."
    sst "Keşke seni evime davet edebilseydim. Seninle biraz daha vakit geçirmek isterdim. Adımı biraz daha söylemeni duymak isterdim."

# game/Scenes/Welch/welch8.rpy:239
translate turkish welch8date_0ef672f8:

    # sst "But I'll be good."
    sst "Ama uslu duracağım."

# game/Scenes/Welch/welch8.rpy:241
translate turkish welch8date_d41d8cd9:

    # voice 'voices/welch_goodnight2.mp3'
    voice 'voices/welch_goodnight2.mp3'

# game/Scenes/Welch/welch8.rpy:242
translate turkish welch8date_a53d3b6c:

    # sst "Good night, [pcname]."
    sst "İyi geceler, [pcname]."

# game/Scenes/Welch/welch8.rpy:243
translate turkish welch8date_a629b7f0:

    # pc "Bye, Nora."
    pc "Hoşça kal, Nora."

# game/Scenes/Welch/welch8.rpy:247
translate turkish welch8date_8f81c243:

    # "She gets out of the car and I watch her walk over to hers, get in, and drive away."
    "Arabadan iniyor ve ben onun arabasına doğru yürüdüğünü, bindiğini ve uzaklaştığını izliyorum."

# game/Scenes/Welch/welch8.rpy:249
translate turkish welch8date_757b78b4:

    # "I have no idea how I'm going to hold off until graduation with her. She's so fucking hot. I just want her right now."
    "Mezuniyete kadar ona karşı nasıl dayanacağım hiç bilmiyorum. O çok seksi. Onu şu anda istiyorum."

# game/Scenes/Welch/welch8.rpy:250
translate turkish welch8date_6f95dc85:

    # "After taking a few moments to just breathe, I drive off."
    "Birkaç saniye nefes alıp toparlandıktan sonra arabayla uzaklaşıyorum."

translate turkish strings:

    # game/Scenes/Welch/welch8.rpy:4
    old "After the scene where you join her in a protest, this will happen in her next class."
    new "Onunla birlikte protestoya katıldığın sahneden sonra, bu olay bir sonraki dersinde gerçekleşecek."

    # game/Scenes/Welch/welch8.rpy:18
    old "Okay sounds good"
    new "Tamam, kulağa hoş geliyor."

    # game/Scenes/Welch/welch8.rpy:20
    old "I don't think so (End Welch's Story)"
    new "Sanmıyorum. (Welch'in Hikayesinin Sonu)"

    # game/Scenes/Welch/welch8.rpy:94
    old "I'm not sure that's appropriate"
    new "Bunun uygun olduğundan emin değilim."

    # game/Scenes/Welch/welch8.rpy:206
    old "Not like that"
    new "Öyle değil."

