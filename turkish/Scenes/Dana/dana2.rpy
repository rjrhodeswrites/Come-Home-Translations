# TODO: Translation updated at 2026-08-03 12:42

# game/Scenes/Dana/dana2.rpy:9
translate turkish dana2_5cfb9131:

    # "It's a fairly normal day of work. I work in Mrs. Mills office all day."
    "Oldukça sıradan bir iş günü. Bütün gün Bayan Mills’in ofisinde çalışıyorum."

# game/Scenes/Dana/dana2.rpy:10
translate turkish dana2_85a4b54e:

    # "Cleaning all the normal things."
    "Her zamanki işleri temizliyorum."

# game/Scenes/Dana/dana2.rpy:12
translate turkish dana2_f50e7708:

    # "Typing all normal stuff."
    "Her zamanki işleri yazıyorum."

# game/Scenes/Dana/dana2.rpy:13
translate turkish dana2_d80566b6:

    # "Work passes quickly and I'm busy the entire time."
    "İş çabucak geçiyor ve tüm gün boyunca meşgulüm."

# game/Scenes/Dana/dana2.rpy:16
translate turkish dana2_1dfeab57:

    # bs "Thanks for all your help today, [pcname]. You did good work today."
    bs "Bugün yardımlarınız için teşekkürler, [pcname]. Bugün iyi iş çıkardın."

# game/Scenes/Dana/dana2.rpy:17
translate turkish dana2_e8ce3674:

    # pc "Thank you Mrs. Mills."
    pc "Teşekkürler Bayan Mills."

# game/Scenes/Dana/dana2.rpy:18
translate turkish dana2_ed5736f0:

    # bs "I'm going to stay around a little later. You have a good evening."
    bs "Biraz daha kalacağım. İyi akşamlar."

# game/Scenes/Dana/dana2.rpy:19
translate turkish dana2_dd07e1d2:

    # pc "Okay, you too Mrs. Mills."
    pc "Tamam, size de Bayan Mills."

# game/Scenes/Dana/dana2.rpy:20
translate turkish dana2_fe768c71:

    # "I leave her office and start walking down the hall towards the lobby."
    "Ofisinden çıkıp koridordan lobiye doğru yürümeye başlıyorum."

# game/Scenes/Dana/dana2.rpy:25
translate turkish dana2_e92ba526:

    # "Dana's voice stops me in my tracks. She's arguing with somebody on the phone and sounds upset."
    "Dana'nın sesi beni durduruyor. Telefonda biriyle tartışıyor ve sesinden üzgün olduğu anlaşılıyor."

# game/Scenes/Dana/dana2.rpy:26
translate turkish dana2_1edbfb68:

    # "I don't really mean to eavesdrop, but I also don't want to just walk in on their conversation, so I lean against the wall and wait."
    "Aslında kulak misafiri olmak istemiyorum, ama konuşmalarına öylece dalmak da istemiyorum, bu yüzden duvara yaslanıp bekliyorum."

# game/Scenes/Dana/dana2.rpy:27
translate turkish dana2_506f8528:

    # cw "I'm sorry. I'm just like ten minutes late, but I'm coming home soon, I promise."
    cw "Özür dilerim. Sadece on dakika kadar geciktim, ama yakında eve geliyorum, söz veriyorum."

# game/Scenes/Dana/dana2.rpy:28
translate turkish dana2_594beb0b:

    # "There is a pause. I can hear a voice on the other side of the phone yelling, but I can't make out the words."
    "Bir sessizlik oluyor. Telefonun diğer ucundan bir sesin bağırdığını duyabiliyorum, ama ne dediğini anlayamıyorum."

# game/Scenes/Dana/dana2.rpy:29
translate turkish dana2_29f965e7:

    # cw "I try to! It's not that easy. I can't just leave my work half-finished."
    cw "Deniyorum! O kadar kolay değil. İşimi yarıda bırakamam."

# game/Scenes/Dana/dana2.rpy:30
translate turkish dana2_011812d0:

    # "Her voice drops and catches in her throat."
    "Sesi alçalır ve boğazında takılır."

# game/Scenes/Dana/dana2.rpy:31
translate turkish dana2_3ae30315:

    # voice dana_trying
    # cw "I'm trying. I'm sorry."
    voice dana_trying
    cw ""

# game/Scenes/Dana/dana2.rpy:33
translate turkish dana2_8788608a:

    # cw "No, I'm not cheating on you. I don't know how many times I have to tell you that."
    cw "Hayır, seni aldatmıyorum. Bunu sana kaç kez söylemem gerekiyor bilmiyorum."

# game/Scenes/Dana/dana2.rpy:34
translate turkish dana2_d0c4854a:

    # "More yelling comes from the phone receiver."
    "Telefon ahizesinden yine bağırışmalar gelir."

# game/Scenes/Dana/dana2.rpy:35
translate turkish dana2_b30f69a4:

    # cw "That's fine. I'll see you tonight then."
    cw "Sorun değil. O zaman bu akşam görüşürüz."

# game/Scenes/Dana/dana2.rpy:37
translate turkish dana2_e7265cb4:

    # "She hangs up the phone and there's a bang as she slams it against the desk."
    "Telefonu kapattı ve ahizeyi masaya sertçe vurunca bir gümbürtü duyuldu."

# game/Scenes/Dana/dana2.rpy:38
translate turkish dana2_494fc925:

    # "After a moment, I peek around the corner and see her leaning over with her head buried in her hands, her shoulder shaking as she sobs."
    "Bir süre sonra köşeden gizlice baktım ve başını ellerinin arasına gömmüş, hıçkırırken omuzları titreyen halini gördüm."

# game/Scenes/Dana/dana2.rpy:39
translate turkish dana2_a3b7daec:

    # "I probably should just stay out of it, but I can't help it."
    "Muhtemelen bu işe karışmamalıydım, ama kendimi tutamıyorum."

# game/Scenes/Dana/dana2.rpy:40
translate turkish dana2_ca8447bf:

    # "I can't stand to see her upset like this. I have this overwhelming urge to fix things."
    "Onu bu kadar üzgün görmek dayanılmaz. Her şeyi düzeltmek için içimde karşı konulmaz bir dürtü var."

# game/Scenes/Dana/dana2.rpy:43
translate turkish dana2_f041e4b8:

    # "I walk up to her desk and put my hand gently onto her shoulder."
    "Masasına doğru yürüdüm ve elimi nazikçe omzuna koydum."

# game/Scenes/Dana/dana2.rpy:44
translate turkish dana2_fa75bbc3:

    # pc "Are you okay?"
    pc "İyi misin?"

# game/Scenes/Dana/dana2.rpy:46
translate turkish dana2_3619d1fa:

    # "She lifts her head and quickly wipes away her tears."
    "Başını kaldırdı ve gözyaşlarını çabucak sildi."

# game/Scenes/Dana/dana2.rpy:47
translate turkish dana2_a3f56836:

    # voice dana_justfine
    # cw "Yeah, everything's just fine."
    voice dana_justfine
    cw ""

# game/Scenes/Dana/dana2.rpy:49
translate turkish dana2_a794c62f:

    # pc "I sort of overheard your conversation."
    pc "Konuşmanızı biraz duydum da."

# game/Scenes/Dana/dana2.rpy:50
translate turkish dana2_a97815ff:

    # cw "Oh, did you?"
    cw "Oh, öyle mi?"

# game/Scenes/Dana/dana2.rpy:51
translate turkish dana2_efb33164:

    # "She stays silent for a moment, obviously trying to calm herself down."
    "Bir an sessiz kaldı, belli ki kendini sakinleştirmeye çalışıyordu."

# game/Scenes/Dana/dana2.rpy:54
translate turkish dana2_391aa753:

    # "Then suddenly everything seems to burst and she wraps her arms around my waist and buries her face into my stomach."
    "Sonra aniden her şey patlamış gibi oldu ve kollarını belime doladı, yüzünü karnıma gömdü."

# game/Scenes/Dana/dana2.rpy:55
translate turkish dana2_458c8244:

    # voice dana_sofrustrated
    # cw "I'm sorry, [pcname]. I'm just so frustrated with all of it."
    voice dana_sofrustrated
    cw ""

# game/Scenes/Dana/dana2.rpy:57
translate turkish dana2_8921cee5:

    # "I put a hand on her back and rub gently as she cries into my shirt."
    "O gömleğime ağlarken, elimi sırtına koyup nazikçe ovuşturdum."

# game/Scenes/Dana/dana2.rpy:58
translate turkish dana2_77fb0dd9:

    # "After a couple minutes of sobbing, she starts to calm down again and she pulls back away from me."
    "Birkaç dakika hıçkırdıktan sonra tekrar sakinleşmeye başladı ve benden uzaklaştı."

# game/Scenes/Dana/dana2.rpy:61
translate turkish dana2_213acdac:

    # cw "I'm sorry. I got your shirt wet."
    cw "Özür dilerim. Gömleğini ıslattım."

# game/Scenes/Dana/dana2.rpy:62
translate turkish dana2_45a788d3:

    # pc "It'll dry. Feeling better now?"
    pc "Kurur. Şimdi daha iyi misin?"

# game/Scenes/Dana/dana2.rpy:63
translate turkish dana2_5c9ff614:

    # "She nods."
    "Başını sallıyor."

# game/Scenes/Dana/dana2.rpy:64
translate turkish dana2_3bb01968:

    # cw "Better. Not great, but better."
    cw "Daha iyi. Harika değil, ama daha iyi."

# game/Scenes/Dana/dana2.rpy:65
translate turkish dana2_f02c67f3:

    # cw "I'll figure everything out. I'll get my work done faster and get home earlier, so he won't be mad at me."
    cw "Her şeyi halledeceğim. İşimi daha çabuk bitirip eve daha erken döneceğim, böylece bana kızmayacak."

# game/Scenes/Dana/dana2.rpy:66
translate turkish dana2_6831ff3c:

    # pc "If you need anybody to talk to, I'm here okay?"
    pc "Konuşacak birine ihtiyacın olursa, ben buradayım, tamam mı?"

# game/Scenes/Dana/dana2.rpy:67
translate turkish dana2_0518d8da:

    # cw "Thanks, [pcname]. You're so sweet."
    cw "Teşekkürler, [pcname]. Çok tatlısın."

# game/Scenes/Dana/dana2.rpy:68
translate turkish dana2_786b3b21:

    # voice dana_beokay
    # cw "I'll be okay though. I'll see you tomorrow, okay?"
    voice dana_beokay
    cw ""

# game/Scenes/Dana/dana2.rpy:70
translate turkish dana2_d8858bda:

    # pc "Want me to stay and help with anything?"
    pc "Kalıp bir şeye yardım etmemi ister misin?"

# game/Scenes/Dana/dana2.rpy:71
translate turkish dana2_af71dcbc:

    # cw "That's okay. I got it. Thank you though, really."
    cw "Gerek yok. Hallederim. Yine de teşekkürler, gerçekten."

# game/Scenes/Dana/dana2.rpy:72
translate turkish dana2_859c6cd6:

    # pc "Okay, well I'll see you tomorrow then."
    pc "Tamam, o zaman yarın görüşürüz."

# game/Scenes/Dana/dana2.rpy:73
translate turkish dana2_0507fc22:

    # "I give her a final pat on her shoulder before turning and walking outside. I hope she'll be okay. It's a lot to deal with."
    "Dönüp dışarı çıkmadan önce omzuna son bir kez hafifçe dokunuyorum. Umarım iyi olur. Başa çıkması zor bir durum."

# game/Scenes/Dana/dana2.rpy:74
translate turkish dana2_2199c3c0:

    # "I walk through the cool night and get in my car."
    "Serin gece havasında yürüyorum ve arabama biniyorum."

translate turkish strings:

    # game/Scenes/Dana/dana2.rpy:2
    old "Dana has been running late getting home from work."
    new "Dana işten eve gelmekte gecikiyor."

    # game/Scenes/Dana/dana2.rpy:3
    old "This scene will happen automatically a few days after the previous scene."
    new "Bu sahne, bir önceki sahneden birkaç gün sonra otomatik olarak gerçekleşecek."

