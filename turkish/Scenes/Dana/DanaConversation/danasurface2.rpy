# game/Scenes/Dana/DanaConversation/danasurface2.rpy:13
translate turkish danasurface2_adb78891:

    # pc "Do you have any pets?"
    pc "Evcil hayvanın var mı?"

# game/Scenes/Dana/DanaConversation/danasurface2.rpy:14
translate turkish danasurface2_69bf2a77:

    # cw "No, no pets."
    cw "Hayır, evcil hayvanım yok."

# game/Scenes/Dana/DanaConversation/danasurface2.rpy:16
translate turkish danasurface2_f1e7f090:

    # cw "I wouldn't mind having a dog - a big one that I could hug and cuddle with."
    cw "Bir köpeğim olsa fena olmazdı – kucaklayıp sarılabileceğim kocaman bir köpek."

# game/Scenes/Dana/DanaConversation/danasurface2.rpy:17
translate turkish danasurface2_72be5411:

    # cw "I had a big fluffy Great Pyrenees growing up named Khan. He was my favorite thing."
    cw "Çocukken Khan adında kocaman, tüylü bir Great Pyrenees köpeğim vardı. O benim en sevdiğim şeydi."

# game/Scenes/Dana/DanaConversation/danasurface2.rpy:20
translate turkish danasurface2_0084a7fa:

    # cw "But Terry, my fiancé, is allergic to dogs. And cats. So no pets."
    cw "Ama nişanlım Terry’nin köpeklere alerjisi var. Kedilere de. O yüzden evcil hayvanım yok."

# game/Scenes/Dana/DanaConversation/danasurface2.rpy:21
translate turkish danasurface2_e161b952:

    # pc "Maybe one day."
    pc "Belki bir gün olur."

# game/Scenes/Dana/DanaConversation/danasurface2.rpy:23
translate turkish danasurface2_d9e8daa4:

    # cw "Maybe."
    cw "Belki."

# game/Scenes/Dana/DanaConversation/danasurface2.rpy:25
translate turkish danasurface2_4789760b:

    # cw "Although, no, I guess not, since I'm marrying Terry and will be with him forever."
    cw "Gerçi hayır, sanırım olmaz, çünkü Terry ile evleniyorum ve sonsuza kadar onunla birlikte olacağım."

# game/Scenes/Dana/DanaConversation/danasurface2.rpy:26
translate turkish danasurface2_b3875e3a:

    # cw "He's always going to be allergic to dogs, so that means no dogs for me."
    cw "O her zaman köpeklere alerjik olacak, bu da benim için köpek yok demek."

# game/Scenes/Dana/DanaConversation/danasurface2.rpy:28
translate turkish danasurface2_5388797f:

    # cw "That's okay though."
    cw "Ama sorun değil."

# game/Scenes/Dana/DanaConversation/danasurface2.rpy:29
translate turkish danasurface2_75ed006d:

    # pc "Maybe a turtle?"
    pc "Belki bir kaplumbağa?"

# game/Scenes/Dana/DanaConversation/danasurface2.rpy:31
translate turkish danasurface2_5cff00b8:

    # cw "Haha, maybe!"
    cw "Haha, belki!"

