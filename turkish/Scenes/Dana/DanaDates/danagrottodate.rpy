# game/Scenes/Dana/DanaDates/danagrottodate.rpy:23
translate turkish danagrottostartdate_1563db25:

    # "I drive over and pick Dana up. Then we go out to The Grotto together."
    "Arabayla gidip Dana'yı alıyorum. Sonra birlikte The Grotto'ya gidiyoruz."

# game/Scenes/Dana/DanaDates/danagrottodate.rpy:28
translate turkish danagrottostartdate_2095cc55:

    # cw "Wow. This place is amazing."
    cw "Vay canına. Burası muhteşem."

# game/Scenes/Dana/DanaDates/danagrottodate.rpy:29
translate turkish danagrottostartdate_2ba00ab3:

    # cw "I can't believe I get to go out here. It's so beautiful."
    cw "Buraya gelebildiğime inanamıyorum. Burası çok güzel."

# game/Scenes/Dana/DanaDates/danagrottodate.rpy:30
translate turkish danagrottostartdate_05526a72:

    # pc "You're beautiful, Dana. You deserve it."
    pc "Sen çok güzelsin, Dana. Bunu hak ediyorsun."

# game/Scenes/Dana/DanaDates/danagrottodate.rpy:31
translate turkish danagrottostartdate_9c4b6956:

    # cw "Thank you, [pcname]."
    cw "Teşekkür ederim, [pcname]."

# game/Scenes/Dana/DanaDates/danagrottodate.rpy:32
translate turkish danagrottostartdate_37c9d0bf:

    # "We walk in and the host leads us to our seats."
    "İçeri giriyoruz ve garson bizi masamıza götürüyor."

# game/Scenes/Dana/DanaDates/danagrottodate.rpy:38
translate turkish danagrottostartdate_80af549c:

    # cw "You can afford this? On what Mrs. Mills pays you?"
    cw "Buna paranın yetiyor mu? Bayan Mills’in sana ödediği parayla mı?"

# game/Scenes/Dana/DanaDates/danagrottodate.rpy:39
translate turkish danagrottostartdate_0f30c499:

    # pc "Sure. I mean, not every day or anything, but occasionally. I don't have many bills."
    pc "Tabii ki. Yani, her gün falan değil ama ara sıra. Fazla faturam yok."

# game/Scenes/Dana/DanaDates/danagrottodate.rpy:40
translate turkish danagrottostartdate_a4bd3f4d:

    # pc "Don't worry about it though, Dana. I want you to have a great night."
    pc "Ama merak etme, Dana. Senin harika bir gece geçirmeni istiyorum."

# game/Scenes/Dana/DanaDates/danagrottodate.rpy:42
translate turkish danagrottostartdate_617347d3:

    # cw "I already am. This is incredible."
    cw "Zaten çok eğleniyorum. Bu inanılmaz."

# game/Scenes/Dana/DanaDates/danagrottodate.rpy:43
translate turkish danagrottostartdate_ecd9ab22:

    # "The server takes our orders and we chat for a while."
    "Garson siparişlerimizi alıyor ve bir süre sohbet ediyoruz."

# game/Scenes/Dana/DanaDates/danagrottodate.rpy:46
translate turkish danagrottostartdate_ac38448c:

    # "Then we eat and chat some more."
    "Sonra yemek yiyoruz ve biraz daha sohbet ediyoruz."

# game/Scenes/Dana/DanaDates/danagrottodate.rpy:52
translate turkish danagrottostartdate_94d3f64e:

    # "Then we get up and dance a bit to the soft music."
    "Sonra kalkıp hafif müziğe eşlik ederek biraz dans ediyoruz."

# game/Scenes/Dana/DanaDates/danagrottodate.rpy:54
translate turkish danagrottostartdate_d0b4cddc:

    # cw "You're so amazing. This is the best date I've ever been on."
    cw "Sen harikasın. Bu şimdiye kadar çıktığım en güzel randevu."

# game/Scenes/Dana/DanaDates/danagrottodate.rpy:55
translate turkish danagrottostartdate_1ece43ad:

    # cw "I couldn't want anything more."
    cw "Daha fazlasını isteyemezdim."

# game/Scenes/Dana/DanaDates/danagrottodate.rpy:56
translate turkish danagrottostartdate_f6634f6b:

    # pc "Anything to make you happy, Dana. That's all I want."
    pc "Seni mutlu edecek her şey, Dana. Tek istediğim bu."

# game/Scenes/Dana/DanaDates/danagrottodate.rpy:60
translate turkish danagrottostartdate_93db9284:

    # cw "You do make me happy, [pcname]."
    cw "Beni gerçekten mutlu ediyorsun, [pcname]."

# game/Scenes/Dana/DanaDates/danagrottodate.rpy:61
translate turkish danagrottostartdate_8b92acc5:

    # cw "I'm so very happy."
    cw "Çok mutluyum."

# game/Scenes/Dana/DanaDates/danagrottodate.rpy:69
translate turkish danagrottostartdate_c8c4e655:

    # cw "I know a way you can make me even happier though."
    cw "Ama beni daha da mutlu etmenin bir yolunu biliyorum."

# game/Scenes/Dana/DanaDates/danagrottodate.rpy:70
translate turkish danagrottostartdate_ae871f39:

    # pc "Oh yeah?"
    pc "Öyle mi?"

# game/Scenes/Dana/DanaDates/danagrottodate.rpy:71
translate turkish danagrottostartdate_9a5a9a70:

    # cw "Are you ready to take me home?"
    cw "Beni eve götürmeye hazır mısın?"

# game/Scenes/Dana/DanaDates/danagrottodate.rpy:72
translate turkish danagrottostartdate_69a64407:

    # pc "Yes, I think we should."
    pc "Evet, bence gitmeliyiz."

# game/Scenes/Dana/DanaDates/danagrottodate.rpy:76
translate turkish danagrottostartdate_4097bbec:

    # "Fifteen minutes later we're in her bedroom and she's naked on the bed, practically begging me to ravage her."
    "On beş dakika sonra yatak odasındayız ve o yatakta çıplak, adeta onu becermem için yalvarıyor."

# game/Scenes/Dana/DanaDates/danagrottodate.rpy:80
translate turkish danagrottostartdate_ff3293a2:

    # cw "Do you want to continue this back at my place?"
    cw "Bunu benim evimde devam ettirmek ister misin?"

# game/Scenes/Dana/DanaDates/danagrottodate.rpy:83
translate turkish danagrottostartdate_92e63c5d:

    # cw "Great. Let's go. I can't wait to get my mouth on you."
    cw "Harika. Hadi gidelim. Seni ağzıma almak için sabırsızlanıyorum."

# game/Scenes/Dana/DanaDates/danagrottodate.rpy:87
translate turkish danagrottostartdate_4097bbec_1:

    # "Fifteen minutes later we're in her bedroom and she's naked on the bed, practically begging me to ravage her."
    "On beş dakika sonra onun yatak odasındayız ve o yatakta çıplak, adeta onu becermem için yalvarıyor."

# game/Scenes/Dana/DanaDates/danagrottodate.rpy:91
translate turkish danagrottostartdate_627e2bde:

    # cw "Oh, alright."
    cw "Oh, peki."

# game/Scenes/Dana/DanaDates/danagrottodate.rpy:92
translate turkish danagrottostartdate_0128787c:

    # cw "It was still an incredible date. Thank you."
    cw "Yine de inanılmaz bir randevuydu. Teşekkürler."

# game/Scenes/Dana/DanaDates/danagrottodate.rpy:95
translate turkish danagrottostartdate_e8cbe586:

    # "I drive Dana home and we say our goodbyes, then she goes inside and I drive away to continue my night."
    "Dana'yı evine bırakıyorum ve vedalaşıyoruz, sonra o içeri giriyor ve ben gecemi devam ettirmek için arabayla uzaklaşıyorum."

translate turkish strings:

