# game/Scenes/Jamie/JamieConversation/jamies4.rpy:32
translate turkish jamies4_38c5f6ea:

    # gnd "That would be neat, but I'm more into the real New Zealand - especially Maori culture."
    gnd "Bu harika olurdu, ama ben daha çok gerçek Yeni Zelanda'ya ilgi duyuyorum - özellikle de Maori kültürüne."

# game/Scenes/Jamie/JamieConversation/jamies4.rpy:35
translate turkish jamies4_aebe2dc5:

    # gnd "Are you kidding?"
