# game/Scenes/Jamie/JamieConversation/jamies4.rpy:40
translate turkish jamies4_7f7e5330:

    # gnd "But seriously, Australia is cool, but New Zealand is where it's at."
    gnd "Ama cidden, Avustralya harika, ama asıl yer Yeni Zelanda."

