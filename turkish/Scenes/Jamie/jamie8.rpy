# game/Scenes/Jamie/jamie8.rpy:13
translate turkish jamie8_98ca1a51:

    # "My phone buzzes in my pocket."
    "Cebimdeki telefonum titriyor."

# game/Scenes/Jamie/jamie8.rpy:15
translate turkish jamie8_7a608d10:

    # "It's Jamie. I lie on my bed and answer the phone."
    "Arayan Jamie. Yatağımda uzanmış halde telefonu açıyorum."

# game/Scenes/Jamie/jamie8.rpy:19
translate turkish jamie8_80c674d7:

    # pc "Hey, Jamie."
    pc "Selam Jamie."

# game/Scenes/Jamie/jamie8.rpy:20
translate turkish jamie8_3d698c03:

    # gnd "Hey. You busy?"
    gnd "Selam. Meşgul müsün?"

# game/Scenes/Jamie/jamie8.rpy:21
translate turkish jamie8_4474e21b:

    # pc "Nah. What's up?"
    pc "Hayır. Ne var ne yok?"

# game/Scenes/Jamie/jamie8.rpy:22
translate turkish jamie8_34eb8872:

    # gnd "Nothing really. Just wanted to talk to you. Miss you."
    gnd "Aslında bir şey yok. Sadece seninle konuşmak istedim. Seni özledim."

# game/Scenes/Jamie/jamie8.rpy:23
translate turkish jamie8_71edcec9:

    # pc "Well.. you could come over?"
    pc "Peki... buraya gelebilir misin?"

# game/Scenes/Jamie/jamie8.rpy:25
translate turkish jamie8_a38e761a:

    # gnd "You know I can't really do that. My dad would be so mad."
    gnd "Bunu yapamayacağımı biliyorsun. Babam çok kızar."

# game/Scenes/Jamie/jamie8.rpy:26
translate turkish jamie8_9f0961af:

    # pc "Why? You're an adult. Why does he get a say in what you do?"
    pc "Neden? Sen yetişkinsin. Neden yaptıklarına karışıyor ki?"

# game/Scenes/Jamie/jamie8.rpy:27
translate turkish jamie8_57cb5e24:

    # gnd "I know. I just don't want him to be mad."
    gnd "Biliyorum. Sadece kızmasını istemiyorum."

# game/Scenes/Jamie/jamie8.rpy:28
translate turkish jamie8_0833b2b4:

    # gnd "I'll talk to him soon though, I promise."
    gnd "Ama yakında onunla konuşacağım, söz veriyorum."

# game/Scenes/Jamie/jamie8.rpy:29
translate turkish jamie8_b1a2e372:

    # gnd "I know I need to. It's just hard, because I know he's not going to like what I have to say."
    gnd "Konuşmam gerektiğini biliyorum. Sadece zor geliyor, çünkü söyleyeceklerimi beğenmeyeceğini biliyorum."

# game/Scenes/Jamie/jamie8.rpy:30
translate turkish jamie8_6cd88cb3:

    # gnd "And he works so hard, and I love him so much. I just hate to make him upset."
    gnd "Ayrıca çok çalışıyor ve onu çok seviyorum. Onu üzmekten nefret ediyorum."

# game/Scenes/Jamie/jamie8.rpy:32
translate turkish jamie8_dbc86daf:

    # gnd "But you mean so much to me. I don't want to have to keep sneaking around, keeping us a secret."
    gnd "Ama sen benim için çok önemlisin. Gizlice dolaşmak, ilişkimizi saklamak zorunda kalmak istemiyorum."

# game/Scenes/Jamie/jamie8.rpy:33
translate turkish jamie8_aa61dfea:

    # gnd "I just need to build up the courage to do it."
    gnd "Sadece bunu yapmak için cesaretimi toplamam gerekiyor."

# game/Scenes/Jamie/jamie8.rpy:37
translate turkish jamie8_07bcbb36:

    # gnd "Thank you. I'm glad. You've been very patient with me."
    gnd "Teşekkür ederim. Sevindim. Bana karşı çok sabırlı davrandın."

# game/Scenes/Jamie/jamie8.rpy:39
translate turkish jamie8_a5d0737c:

    # gnd "I'll make it worth it for you, I promise."
    gnd "Bunun karşılığını sana vereceğim, söz veriyorum."

# game/Scenes/Jamie/jamie8.rpy:40
translate turkish jamie8_5de186d8:

    # pc "It's already worth it, Jamie."
    pc "Zaten karşılığını aldım, Jamie."

# game/Scenes/Jamie/jamie8.rpy:43
translate turkish jamie8_911c62b3:

    # gnd "You're right. I'm sorry."
    gnd "Haklısın. Özür dilerim."

# game/Scenes/Jamie/jamie8.rpy:44
translate turkish jamie8_d5112d06:

    # gnd "You shouldn't have to deal with all of this drama. I know you're dealing with your own things, with your dad missing and all."
    gnd "Bütün bu dramayla uğraşmak zorunda kalmamalıydın. Biliyorum, babanın kaybolması falan yüzünden kendi sorunlarınla uğraşıyorsun."

# game/Scenes/Jamie/jamie8.rpy:45
translate turkish jamie8_5a747778:

    # gnd "I should be there for you more."
    gnd "Senin yanında daha fazla olmalıyım."

# game/Scenes/Jamie/jamie8.rpy:47
translate turkish jamie8_9d979554:

    # gnd "And I will be. I promise. I'll tell him soon."
    gnd "Ve olacağım. Söz veriyorum. Ona yakında söyleyeceğim."

# game/Scenes/Jamie/jamie8.rpy:49
translate turkish jamie8_d41d8cd9:

    # voice "voices/jamie_022.mp3"        
    voice "voices/jamie_022.mp3"        

# game/Scenes/Jamie/jamie8.rpy:50
translate turkish jamie8_f9831d1e:

    # gnd "I love you, [pcname]."
    gnd "Seni seviyorum, [pcname]."

# game/Scenes/Jamie/jamie8.rpy:56
translate turkish jamie8_b629d4db:

    # gnd "That feels good to say... and to hear."
    gnd "Bunu söylemek... ve duymak çok güzel."

# game/Scenes/Jamie/jamie8.rpy:58
translate turkish jamie8_4d7bfc98:

    # gnd "I really mean it too."
    gnd "Gerçekten de içten söylüyorum."

# game/Scenes/Jamie/jamie8.rpy:60
translate turkish jamie8_d41d8cd9_1:

    # voice "voices/jamie_019.mp3"
    voice "voices/jamie_019.mp3"

# game/Scenes/Jamie/jamie8.rpy:61
translate turkish jamie8_8cee1605:

    # gnd "Ever since you came back, I've been feeling it building up, like my heart is growing bigger and bigger until it's close to bursting."
    gnd "Geri döndüğünden beri, bu duygunun içimde büyüdüğünü hissediyorum, sanki kalbim patlayacak gibi gittikçe büyüyor."

# game/Scenes/Jamie/jamie8.rpy:63
translate turkish jamie8_d41d8cd9_2:

    # voice "voices/jamie_020.mp3"
    voice "voices/jamie_020.mp3"

# game/Scenes/Jamie/jamie8.rpy:64
translate turkish jamie8_55ac6cf8:

    # gnd "I smile every time I think about you, and I find myself thinking about you all the time."
    gnd "Seni her düşündüğümde gülümsüyorum ve kendimi sürekli seni düşünürken buluyorum."

# game/Scenes/Jamie/jamie8.rpy:67
translate turkish jamie8_d41d8cd9_3:

    # voice "voices/jamie_021.mp3"
    voice "voices/jamie_021.mp3"

# game/Scenes/Jamie/jamie8.rpy:68
translate turkish jamie8_a90d9888:

    # gnd "I'm completely in love with you, [pcname]. I just wanted you to know that."
    gnd "Sana tamamen aşığım, [pcname]. Bunu bilmeni istedim."

# game/Scenes/Jamie/jamie8.rpy:69
translate turkish jamie8_9fc0bac9:

    # pc "I feel the same way, Jamie. You're amazing."
    pc "Ben de aynı şekilde hissediyorum, Jamie. Harikasın."

# game/Scenes/Jamie/jamie8.rpy:71
translate turkish jamie8_ff198159:

    # gnd "I'm so happy."
    gnd "Çok mutluyum."

# game/Scenes/Jamie/jamie8.rpy:72
translate turkish jamie8_69aafc54:

    # "We talk a little longer about other less important things, until we're both practically falling asleep on the phone."
    "İkimiz de telefonda neredeyse uykuya dalana kadar, daha az önemli diğer şeyler hakkında biraz daha konuşuyoruz."

# game/Scenes/Jamie/jamie8.rpy:74
translate turkish jamie8_fcdf2655:

    # gnd "I better get some sleep."
    gnd "Artık biraz uyusam iyi olacak."

# game/Scenes/Jamie/jamie8.rpy:75
translate turkish jamie8_fdc5f0f0:

    # pc "Yeah, me too."
    pc "Evet, ben de."

# game/Scenes/Jamie/jamie8.rpy:77
translate turkish jamie8_d41d8cd9_4:

    # voice "voices/jamie_010.mp3"
    voice "voices/jamie_010.mp3"

# game/Scenes/Jamie/jamie8.rpy:78
translate turkish jamie8_63e5a3ef:

    # gnd "Good night, [pcname]. Love you."
    gnd "İyi geceler, [pcname]. Seni seviyorum."

# game/Scenes/Jamie/jamie8.rpy:79
translate turkish jamie8_727173cd:

    # pc "Love you too, Jamie. Good night."
    pc "Ben de seni seviyorum, Jamie. İyi geceler."

# game/Scenes/Jamie/jamie8.rpy:82
translate turkish jamie8_a25f5d31:

    # gnd "I mean it."
    gnd "Ciddiyim."

# game/Scenes/Jamie/jamie8.rpy:84
translate turkish jamie8_d41d8cd9_5:

    # voice "voices/jamie_019.mp3"
    voice "voices/jamie_019.mp3"

# game/Scenes/Jamie/jamie8.rpy:85
translate turkish jamie8_796c0fbd:

    # gnd "Ever since you came back, I've been feeling it building up, like my heart growing bigger and bigger until it's almost bursting now."
    gnd "Geri döndüğünden beri, bu duygunun içimde büyüdüğünü hissediyorum, sanki kalbim gittikçe büyüyor ve şimdi neredeyse patlayacak gibi."

# game/Scenes/Jamie/jamie8.rpy:87
translate turkish jamie8_d41d8cd9_6:

    # voice "voices/jamie_020.mp3"
    voice "voices/jamie_020.mp3"

# game/Scenes/Jamie/jamie8.rpy:88
translate turkish jamie8_0d1296eb:

    # gnd "I smile every time I think about you, and I find myself thinking about you a lot."
    gnd "Seni her düşündüğümde gülümsüyorum ve kendimi seni çok sık düşünürken buluyorum."

# game/Scenes/Jamie/jamie8.rpy:90
translate turkish jamie8_d41d8cd9_7:

    # voice "voices/jamie_021.mp3"
    voice "voices/jamie_021.mp3"

# game/Scenes/Jamie/jamie8.rpy:91
translate turkish jamie8_a90d9888_1:

    # gnd "I'm completely in love with you, [pcname]. I just wanted you to know that."
    gnd "Sana tamamen aşığım, [pcname]. Sadece bunu bilmeni istedim."

# game/Scenes/Jamie/jamie8.rpy:92
translate turkish jamie8_fb4ce796:

    # pc "Oh, okay. Good to know."
    pc "Oh, tamam. Bunu bilmek güzel."

# game/Scenes/Jamie/jamie8.rpy:94
translate turkish jamie8_5b0a7e45:

    # "We talk awkwardly a little bit longer about less important things, then there's just silence between us for a while."
    "Biraz daha önemsiz şeyler hakkında biraz garip bir şekilde konuşuyoruz, sonra bir süre aramızda sessizlik oluyor."

# game/Scenes/Jamie/jamie8.rpy:95
translate turkish jamie8_fcdf2655_1:

    # gnd "I better get some sleep."
    gnd "Biraz uyusam iyi olacak."

# game/Scenes/Jamie/jamie8.rpy:96
translate turkish jamie8_fdc5f0f0_1:

    # pc "Yeah, me too."
    pc "Evet, ben de."

# game/Scenes/Jamie/jamie8.rpy:97
translate turkish jamie8_76e2f41b:

    # gnd "Okay. Good night, [pcname]."
    gnd "Tamam. İyi geceler, [pcname]."

# game/Scenes/Jamie/jamie8.rpy:98
translate turkish jamie8_6fd39c33:

    # pc "Night!"
    pc "İyi geceler!"

# game/Scenes/Jamie/jamie8.rpy:99
translate turkish jamie8_39ca4ede:

    # "I hang up and go to sleep."
    "Telefonu kapatıp uykuya dalıyorum."

