    # voice "voices/jamie_051.mp3"
    voice "voices/jamie_051.mp3"

# game/Scenes/Jamie/JamieSex/jamiesex.rpy:169
translate turkish jamiesexend_73b8eaaa:

    # gnd "Is it okay if I stay the night?"
    gnd "Bu gece burada kalabilir miyim?"

# game/Scenes/Jamie/JamieSex/jamiesex.rpy:172
translate turkish jamiestaythenight_18827db9:

    # gnd "Good. Because I can barely move."
    gnd "İyi. Çünkü zar zor hareket edebiliyorum."

# game/Scenes/Jamie/JamieSex/jamiesex.rpy:175
translate turkish jamiestaythenight_8384e59e:

    # "She texts her dad that she's staying the night with me, then we lie down and close our eyes."
    "Babasına bu gece benimle kalacağını mesaj atıyor, sonra uzanıp gözlerimizi kapatıyoruz."

# game/Scenes/Jamie/JamieSex/jamiesex.rpy:177
translate turkish jamiestaythenight_d41d8cd9:

    # voice "voices/jamie_022.mp3"
    voice "voices/jamie_022.mp3"

# game/Scenes/Jamie/JamieSex/jamiesex.rpy:178
translate turkish jamiestaythenight_f9831d1e:

    # gnd "I love you, [pcname]."
    gnd "Seni seviyorum, [pcname]."

# game/Scenes/Jamie/JamieSex/jamiesex.rpy:179
translate turkish jamiestaythenight_5e3e613a:

    # pc "I love you too, Jamie."
    pc "Ben de seni seviyorum, Jamie."

# game/Scenes/Jamie/JamieSex/jamiesex.rpy:182
translate turkish jamiestaythenight_033d9c0c:

    # "It doesn't take long before we're both asleep."
    "Çok geçmeden ikimiz de uykuya dalıyoruz."

# game/Scenes/Jamie/JamieSex/jamiesex.rpy:185
translate turkish jamiestaythenight_3f766453:

    # "In the morning I wake up to see her beautiful face sleeping next to me."
    "Sabah uyandığımda yanımda uyuyan güzel yüzünü görüyorum."

# game/Scenes/Jamie/JamieSex/jamiesex.rpy:186
translate turkish jamiestaythenight_de28e5a8:

    # "It's almost a shame that I have to wake her."
    "Onu uyandırmak zorunda kalmam neredeyse yazık."

# game/Scenes/Jamie/JamieSex/jamiesex.rpy:189
translate turkish jamiestaythenight_262f9f66:

    # pc "Good morning, gorgeous."
    pc "Günaydın, güzelim."

# game/Scenes/Jamie/JamieSex/jamiesex.rpy:190
translate turkish jamiestaythenight_85dac102:

    # gnd "Good morning."
    gnd "Günaydın."

# game/Scenes/Jamie/JamieSex/jamiesex.rpy:192
translate turkish jamiestaythenight_205787d6:

    # gnd "I guess we better get ready for school, huh?"
    gnd "Sanırım okula hazırlanmalıyız, değil mi?"

# game/Scenes/Jamie/JamieSex/jamiesex.rpy:193
translate turkish jamiestaythenight_c417e350:

    # pc "Yeah."
    pc "Evet."

# game/Scenes/Jamie/JamieSex/jamiesex.rpy:195
translate turkish jamiestaythenight_9c3178c0:

    # gnd "I guess I better get home. Dad will want to go visit my grandmother like we do every weekend."
    gnd "Sanırım eve gitsem iyi olacak. Babam her hafta sonu olduğu gibi büyükannemi ziyarete gitmek isteyecektir."

# game/Scenes/Jamie/JamieSex/jamiesex.rpy:196
translate turkish jamiestaythenight_63023601:

    # pc "Okay."
    pc "Tamam."

# game/Scenes/Jamie/JamieSex/jamiesex.rpy:197
translate turkish jamiestaythenight_420a0bf8:

    # gnd "Last night was fantastic. Let's do it again soon, okay?"
    gnd "Dün gece harikaydı. Yakında tekrar yapalım, olur mu?"

# game/Scenes/Jamie/JamieSex/jamiesex.rpy:198
translate turkish jamiestaythenight_2951ed74:

    # pc "Definitely."
    pc "Kesinlikle."

# game/Scenes/Jamie/JamieSex/jamiesex.rpy:201
translate turkish jamiestaythenight_c787786a:

    # "We kiss goodbye, then she leaves and I get ready to start my day."
    "Veda öpücüğü veriyoruz, sonra o gidiyor ve ben de güne başlamak için hazırlanıyorum."

# game/Scenes/Jamie/JamieSex/jamiesex.rpy:206
translate turkish jamiestaythenight_b3c2ddd1:

    # gnd "Aw, okay."
    gnd "Ah, tamam."

# game/Scenes/Jamie/JamieSex/jamiesex.rpy:209
translate turkish jamiestaythenight_6b295b4c:

    # "I walk her downstairs and kiss her goodbye at the door."
    "Onu aşağıya kadar eşlik ettim ve kapıda vedalaşmak için öptüm."

# game/Scenes/Jamie/JamieSex/jamiesex.rpy:210
translate turkish jamiestaythenight_acb59cd5:

    # "Then she leaves and walks back over to her house."
    "Sonra o ayrıldı ve evine doğru yürüdü."

# game/Scenes/Jamie/JamieSex/jamiesex.rpy:214
translate turkish jamiestaythenight_9af1658a:

    # "When she's gone, I go back up to my room and sleep alone."
    "O gittikten sonra odama geri dönüp tek başıma uyudum."

