# game/Scenes/Jamie/JamieSex/jamiesex.rpy:163
translate turkish jamiesexend_d261cf26:

    # "She goes to the bathroom to get cleaned up and returns after a couple of minutes."
    "Temizlenmek için banyoya gidiyor ve birkaç dakika sonra geri dönüyor."

# game/Scenes/Jamie/JamieSex/jamiesex.rpy:166
translate turkish jamiesexend_90f6d386:

    # gnd "I love this so much."
    gnd "Buna bayılıyorum."

# game/Scenes/Jamie/JamieSex/jamiesex.rpy:168
