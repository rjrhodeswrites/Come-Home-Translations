    # gnd "Sure, I'm sure there's something good playing."
    gnd "Tabii, eminim iyi bir film oynuyordur."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:14
translate turkish jamiemoviedate_ddd48024:

    # gnd "Give me just a few minutes to get ready."
    gnd "Hazırlanmam için bana birkaç dakika ver."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:33
translate turkish jamiemovietheaterstartdate_0f1c479d:

    # "We get to the theater and get seats in the back."
    "Sinemaya varıyoruz ve arkada yer buluyoruz."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:34
translate turkish jamiemovietheaterstartdate_c9878d77:

    # gnd "So what are we watching anyway?"
    gnd "Peki ne izleyeceğiz?"

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:38
translate turkish jamiemovietheaterstartdate_b4720e01:

    # gnd "Oh, I like it."
    gnd "Oh, hoşuma gitti."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:39
translate turkish jamiemovietheaterstartdate_45ba22b9:

    # gnd "Trying to put me in the mood huh?"
    gnd "Beni havaya sokmaya çalışıyorsun, ha?"

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:44
translate turkish jamiemovietheaterstartdate_d41d8cd9:

    # voice "voices/jamie_003.mp3"
    voice "voices/jamie_003.mp3"

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:45
translate turkish jamiemovietheaterstartdate_642253e9:

    # gnd "Oh okay. I guess that's fine."
    gnd "Oh tamam. Sanırım sorun yok."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:49
translate turkish jamiemovietheaterstartdate_b7b6ccce:

    # gnd "Oh okay."
    gnd "Oh tamam."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:50
translate turkish jamiemovietheaterstartdate_984d111e:

    # gnd "Just a warning though. I might be grabbing onto you a lot."
    gnd "Ama bir uyarı yapayım. Sana çok sık sarılabilirim."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:51
translate turkish jamiemovietheaterstartdate_e17b2a96:

    # gnd "Like a lot a lot."
    gnd "Hem de çok çok sık."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:55
translate turkish jamiemovietheaterstartdate_0ae36cfd:

    # gnd "Oh, I like funny movies."
    gnd "Ah, komik filmleri severim."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:56
translate turkish jamiemovietheaterstartdate_a8e40a21:

    # gnd "I hope it's good."
    gnd "Umarım güzel bir filmdir."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:58
translate turkish jamiemovietheaterstartdate_a311ea1d:

    # "There's a little time before the movie starts."
    "Film başlamasına biraz zaman var."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:62
translate turkish jamiemovietheaterstartdate_8da0039f:

    # "We just hang out and chat for a while."
    "Bir süre takılıp sohbet ediyoruz."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:65
translate turkish jamiemovietheaterstartdate_592835a4:

    # "Finally the movie starts up and we go silent."
    "Sonunda film başlıyor ve sessizleşiyoruz."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:67
translate turkish jamiemovietheaterstartdate_b58e95c5:

    # "Jamie leans against me."
    "Jamie bana yaslanıyor."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:69
translate turkish jamiemovietheaterstartdate_d41d8cd9_1:

    # voice "voices/jamie_049.mp3"
    voice "voices/jamie_049.mp3"

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:70
translate turkish jamiemovietheaterstartdate_40bb361a:

    # gnd "Want to mess around some?"
    gnd "Biraz oyalanmak ister misin?"

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:88
translate turkish jamiemovietheaterstartdate_fd60e14c:

    # "She reaches over and holds my hand on top of the arm rest."
    "Elini uzatıp kol dayama yerinin üstünden elimi tutuyor."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:91
translate turkish jamiemovietheaterstartdate_aee76b2d:

    # "The trailers take up about fifteen minutes, then the movie really gets started."
    "Fragmanlar yaklaşık on beş dakika sürüyor, sonra film gerçekten başlıyor."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:95
translate turkish jamiemovietheaterstartdate_f9b1cbb0:

    # "During the movie, she keeps looking over at me."
    "Film sırasında bana bakıp duruyor."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:96
translate turkish jamiemovietheaterstartdate_d6b093f3:

    # pc "You like the movie?"
    pc "Filmi beğendin mi?"

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:97
translate turkish jamiemovietheaterstartdate_18de1f8c:

    # gnd "Yeah, it's good. I just really want to kiss you right now."
    gnd "Evet, güzel. Şu anda seni öpmek istiyorum."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:99
translate turkish jamiemovietheaterstartdate_4cdfc044:

    # "I lean in and kiss her."
    "Ona doğru eğilip onu öptüm."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:100
translate turkish jamiemovietheaterstartdate_22ba9c92:

    # "We hold like that for some time before she finally pulls away."
    "Bir süre öyle kaldık, sonra sonunda o uzaklaştı."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:101
translate turkish jamiemovietheaterstartdate_9e25dd4e:

    # gnd "Okay, that will hold me over."
    gnd "Tamam, bu beni idare eder."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:102
translate turkish jamiemovietheaterstartdate_3784a641:

    # gnd "Back to the movie."
    gnd "Filme geri dönelim."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:105
translate turkish jamiemovietheaterstartdate_43311053:

    # "During the movie, she keeps looking over at me and smiling."
    "Film boyunca bana bakıp gülümsüyor."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:107
translate turkish jamiemovietheaterstartdate_610dce56:

    # "She seems to be liking the movie okay."
    "Filmi fena sayılmayacak kadar beğeniyor gibi görünüyor."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:110
translate turkish jamiemovietheaterstartdate_ffcd1a92:

    # "She seems to lose interest in the movie fairly quickly."
    "Filme olan ilgisini oldukça çabuk kaybediyor gibi görünüyor."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:111
translate turkish jamiemovietheaterstartdate_5973f780:

    # "I don't know. It's pretty fun to me. I guess she just doesn't like this kind of movie."
    "Bilemiyorum. Bana oldukça eğlenceli geliyor. Sanırım o bu tür filmleri sevmiyor."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:114
translate turkish jamiemovietheaterstartdate_4f23a069:

    # "During every scary scene that happens she tenses up and covers her mouth."
    "Her korkutucu sahnede gerginleşiyor ve ağzını kapatıyor."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:115
translate turkish jamiemovietheaterstartdate_603a9a9b:

    # "Sometimes she even puts her hands over her eyes."
    "Bazen ellerini gözlerinin üzerine bile koyuyor."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:116
translate turkish jamiemovietheaterstartdate_288b2f3c:

    # "Then the music goes quiet, and I know that a jumpscare is coming."
    "Sonra müzik sessizleşiyor ve bir “jumpscare” geleceğini anlıyorum."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:119
translate turkish jamiemovietheaterstartdate_e86e1727:

    # "She grabs my arm and tucks her head down into it."
    "Kolumu tutuyor ve başını koluma gömüyor."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:120
translate turkish jamiemovietheaterstartdate_6bdb4e54:

    # "Her fingers dig into my arm, grasping it so tight."
    "Parmakları koluma batıyor, o kadar sıkı tutuyor ki."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:122
translate turkish jamiemovietheaterstartdate_e7200fcd:

    # "For the rest of the movie, I put my arm around her and hold her while we watch."
    "Filmin geri kalanı boyunca, kolumu onun omzuna dolayıp onu sararak izliyoruz."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:125
translate turkish jamiemovietheaterstartdate_ec13a563:

    # "The movie is funny from pretty much the very beginning."
    "Film neredeyse en başından itibaren komik."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:126
translate turkish jamiemovietheaterstartdate_4caf9a58:

    # "And we laugh together all the way through it."
    "Ve başından sonuna kadar birlikte gülüyoruz."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:127
translate turkish jamiemovietheaterstartdate_7ad920fe:

    # "Even some of the scenes that aren't as funny, she laughs at."
    "O kadar komik olmayan bazı sahnelere bile gülüyor."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:128
translate turkish jamiemovietheaterstartdate_0d1cfe15:

    # "And seeing her laugh just makes me laugh too."
    "Onun gülüşünü görmek beni de güldürüyor."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:129
translate turkish jamiemovietheaterstartdate_d855e56b:

    # "Eventually the movie ends and the credits start rolling."
    "Sonunda film biter ve jeneriği akmaya başlar."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:132
translate turkish jamiemovietheaterstartdate_0bcfb0ae:

    # gnd "That was a really sweet movie. Thanks for taking me."
    gnd "Gerçekten çok tatlı bir filmdi. Beni götürdüğün için teşekkürler."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:133
translate turkish jamiemovietheaterstartdate_4de625af:

    # pc "Of course you're welcome."
    pc "Tabii ki, rica ederim."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:136
translate turkish jamiemovietheaterstartdate_f9724275:

    # gnd "That movie wasn't really my thing, but I hope you liked it."
    gnd "O film pek benim tarzım değildi ama umarım sen beğenmişsindir."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:137
translate turkish jamiemovietheaterstartdate_bfe93711:

    # pc "Yeah I though it was pretty cool."
    pc "Evet, bence de oldukça havalıydı."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:138
translate turkish jamiemovietheaterstartdate_045099e4:

    # gnd "I guess so."
    gnd "Sanırım öyle."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:141
translate turkish jamiemovietheaterstartdate_6d2df7c7:

    # gnd "That movie was SO scary!"
    gnd "O film ÇOK korkutucuydu!"

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:142
translate turkish jamiemovietheaterstartdate_5fcae4fe:

    # gnd "Thanks for being there for me though."
    gnd "Yine de yanımda olduğun için teşekkürler."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:143
translate turkish jamiemovietheaterstartdate_737a7b53:

    # gnd "Sorry if I hurt your arm."
    gnd "Kolunu incittiysem özür dilerim."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:144
translate turkish jamiemovietheaterstartdate_00d236b5:

    # pc "It'll heal... eventually."
    pc "İyileşir... eninde sonunda."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:147
translate turkish jamiemovietheaterstartdate_cd12116f:

    # gnd "That movie was SO funny!"
    gnd "O film ÇOK komikti!"

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:148
translate turkish jamiemovietheaterstartdate_e1a20436:

    # gnd "My chest hurts from laughing so much."
    gnd "Çok güldüğüm için göğsüm ağrıyor."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:149
translate turkish jamiemovietheaterstartdate_262d3cf7:

    # gnd "I loved it. Thanks for bringing me."
    gnd "Çok beğendim. Beni buraya getirdiğin için teşekkürler."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:151
translate turkish jamiemovietheaterend_1a39771f:

    # gnd "Want to just sit and chat through the credits?"
    gnd "Jenerik akarken oturup biraz sohbet etmek ister misin?"

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:152
translate turkish jamiemovietheaterend_61f77a4c:

    # pc "Sure."
    pc "Tabii."

# game/Scenes/Jamie/JamieDates/jamiemoviedate.rpy:156
translate turkish jamiemovietheaterend_34bf5b34:

    # "When the credits end, we walk outside together and out to our cars."
    "Jenerik bittiğinde, birlikte dışarı çıkıp arabalarımıza doğru yürüyoruz."

