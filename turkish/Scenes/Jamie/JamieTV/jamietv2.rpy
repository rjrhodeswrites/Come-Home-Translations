# TODO: Translation updated at 2026-08-03 12:42

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:13
translate turkish jamietv2_fd039b16:

    # "I walk up to Jamie's door and knock."
    "Jamie’nin kapısına yaklaşıp kapıyı çaldım."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:14
translate turkish jamietv2_fdad75c4:

    # "I wait a bit for her to answer and after a few moments, I almost walk away thinking that she isn't home or is busy or something."
    "Kapıyı açması için biraz bekledim ve birkaç saniye sonra, evde olmadığını ya da meşgul olduğunu falan düşünerek neredeyse oradan ayrılacaktım."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:19
translate turkish jamietv2_56b288a0:

    # "Then, just when I am about to leave, she opens the door."
    "Tam gitmek üzereyken kapıyı açtı."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:20
translate turkish jamietv2_348b659c:

    # gnd "Hey sorry, I must have fell asleep on the couch."
    gnd "Hey, özür dilerim, kanepede uyuyakalmış olmalıyım."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:21
translate turkish jamietv2_85e15039:

    # pc "Oh I'm sorry, I didn't mean to wake you. Was just wondering if you wanted to hang out?"
    pc "Ah, özür dilerim, seni uyandırmak istemedim. Sadece takılmak ister misin diye merak ediyordum?"

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:22
translate turkish jamietv2_8cddc873:

    # gnd "Sure, want to come watch TV with me?"
    gnd "Tabii, gelip benimle televizyon izlemek ister misin?"

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:23
translate turkish jamietv2_6eafa1e5:

    # pc "Are you sure? You look pretty tired."
    pc "Emin misin? Oldukça yorgun görünüyorsun."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:24
translate turkish jamietv2_d5f53ad3:

    # gnd "I'm exhausted, but I'd still like to spend some time with you."
    gnd "Çok yorgunum, ama yine de seninle biraz vakit geçirmek isterim."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:25
translate turkish jamietv2_35743d5e:

    # pc "Okay then."
    pc "Tamam o zaman."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:26
translate turkish jamietv2_d6443097:

    # "We walk inside and sit down on her couch to watch TV together."
    "İçeri girip kanepesine oturuyoruz ve birlikte televizyon izliyoruz."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:29
translate turkish jamietv2_4eefcd41:

    # pc "You not been sleeping well?"
    pc "İyi uyuyamıyor musun?"

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:30
translate turkish jamietv2_d3a1e5f8:

    # gnd "I've just been studying a lot. It's been tough."
    gnd "Son zamanlarda çok ders çalışıyorum. Zor bir dönem."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:31
translate turkish jamietv2_6d7e76b4:

    # pc "Tell me about it."
    pc "Bana mı söylüyorsun."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:32
translate turkish jamietv2_56872787:

    # gnd "But I'm glad to spend some time with you, even if I'm sleepy."
    gnd "Ama uykum olsa bile seninle vakit geçirmekten memnunum."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:37
translate turkish jamietv2_c7a75159:

    # gnd "Are you implying I'm not cute when I'm not sleepy?"
    gnd "Uykum olmadığında sevimli olmadığımı mı ima ediyorsun?"

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:38
translate turkish jamietv2_4db958a5:

    # pc "What? No."
    pc "Ne? Hayır."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:39
translate turkish jamietv2_cf0825c6:

    # gnd "I'm just kidding. Thanks, you're sweet."
    gnd "Şaka yapıyorum. Teşekkürler, çok tatlısın."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:42
translate turkish jamietv2_175d3768:

    # gnd "What? Are you serious?"
    gnd "Ne? Ciddi misin?"

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:43
translate turkish jamietv2_61f77a4c:

    # pc "Sure."
    pc "Tabii ki."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:44
translate turkish jamietv2_f3a7bdd3:

    # gnd "That's probably not a good idea. My dad might actually kill you."
    gnd "Bu pek iyi bir fikir değil galiba. Babam seni gerçekten öldürebilir."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:45
translate turkish jamietv2_796397b3:

    # pc "It might be worth the risk."
    pc "Bu riske değer olabilir."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:46
translate turkish jamietv2_34f266ea:

    # gnd "You're crazy!"
    gnd "Delisin!"

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:49
translate turkish jamietv2_d13864ee:

    # gnd "But no, let's just watch TV."
    gnd "Ama hayır, hadi sadece televizyon izleyelim."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:52
translate turkish jamietv2_8105064d:

    # "She smiles at me and we both turn towards the TV and watch the show."
    "Bana gülümsüyor ve ikimiz de televizyona dönüp programı izliyoruz."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:55
translate turkish jamietv2_e4b4fe92:

    # "After the first commercial break, I hear her snoring softly and a moment later, she leans over and lays her head on my shoulder."
    "İlk reklam arasından sonra, onun hafifçe horladığını duyuyorum ve bir an sonra, bana doğru eğilip başını omzuma yaslıyor."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:56
translate turkish jamietv2_72d126bc:

    # "I sit there like that, feeling her warm weight against me, smelling the scent of her shampoo. It's nice."
    "Orada öylece oturuyorum, bana yaslanan sıcak ağırlığını hissediyorum, şampuanının kokusunu alıyorum. Çok hoş."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:57
translate turkish jamietv2_a7276863:

    # "I watch the rest of the show, letting her sleep on my shoulder until the credits roll."
    "Programın geri kalanını izliyorum, jeneriği akana kadar omzumda uyumasına izin veriyorum."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:60
translate turkish jamietv2_aced7ae5:

    # "The music playing during the credits wakes her and she opens her eyes and looks up at me, putting her hand on my chest."
    "Jenerik sırasında çalan müzik onu uyandırıyor, gözlerini açıp bana bakıyor ve elini göğsüme koyuyor."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:61
translate turkish jamietv2_222fe902:

    # gnd "Oh man, I missed the whole thing."
    gnd "Hay aksi, hepsini kaçırdım."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:62
translate turkish jamietv2_7289beae:

    # pc "Yeah, I'll have to fill you in later."
    pc "Evet, sana sonra anlatmam gerekecek."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:63
translate turkish jamietv2_d912edc5:

    # gnd "You could have woke me up."
    gnd "Beni uyandırabilirdin."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:66
translate turkish jamietv2_fd8175bb:

    # gnd "I definitely did."
    gnd "Kesinlikle uyandırdım."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:68
translate turkish jamietv2_7b910158:

    # gnd "You're so silly."
    gnd "Çok şapşalsın."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:69
translate turkish jamietv2_d404c590:

    # gnd "Do you really think I'm cute?"
    gnd "Gerçekten sevimli olduğumu mu düşünüyorsun?"

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:70
translate turkish jamietv2_2951ed74:

    # pc "Definitely."
    pc "Kesinlikle."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:71
translate turkish jamietv2_d2d7ae9c:

    # gnd "I think you're cute too."
    gnd "Ben de seni sevimli buluyorum."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:72
translate turkish jamietv2_e8e9a7f7:

    # "Once again, her dad picks the worst moment to open the door and walk in."
    "Bir kez daha, babası kapıyı açıp içeri girmek için en kötü anı seçti."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:73
translate turkish jamietv2_9da07a83:

    # "Jamie leans away from me and stands up."
    "Jamie benden uzaklaşıp ayağa kalktı."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:79
translate turkish jamietv2_d41d8cd9:

    # voice "voices/jamie_011.mp3"
    voice "voices/jamie_011.mp3"

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:80
translate turkish jamietv2_25b98dfa:

    # gnd "Hey, Daddy."
    gnd "Merhaba, baba."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:81
translate turkish jamietv2_20dcad47:

    # jd "Send him home."
    jd "Onu eve gönder."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:82
translate turkish jamietv2_f2596c67:

    # "Her dad doesn't say anything else and instead walks past us and into the kitchen."
    "Babası başka bir şey söylemedi ve yanımızdan geçip mutfağa girdi."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:86
translate turkish jamietv2_84d4365c:

    # gnd "He must have had a bad day."
    gnd "Kötü bir gün geçirmiş olmalı."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:87
translate turkish jamietv2_b44cf649:

    # pc "I should probably go."
    pc "Artık gitmeliyim."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:88
translate turkish jamietv2_a6870bf2:

    # gnd "Yeah, I'm sorry."
    gnd "Evet, özür dilerim."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:89
translate turkish jamietv2_b219d344:

    # pc "It's okay."
    pc "Sorun değil."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:92
translate turkish jamietv2_36b8ae4f:

    # gnd "Thanks for coming over tonight. I had a good time."
    gnd "Bu akşam uğradığın için teşekkürler. İyi vakit geçirdim."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:93
translate turkish jamietv2_041dfd87:

    # pc "More like you had a good nap."
    pc "Daha çok iyi bir şekerleme yapmışsın gibi."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:94
translate turkish jamietv2_b762e00f:

    # gnd "That too. Your shoulder is very comfy."
    gnd "O da var. Omzun çok rahat."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:98
translate turkish jamietv2_4bbcc4b9:

    # gnd "I might take you up on that."
    gnd "Bu teklifini kabul edebilirim."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:100
translate turkish jamietv2_f9097bdf:

    # gnd "I'm sure they'll show re-runs all week."
    gnd "Eminim bütün hafta tekrarlarını yayınlayacaklar."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:101
translate turkish jamietv2_dfc3c586:

    # pc "Alright, well I better head home."
    pc "Tamam, peki, eve gitsem iyi olacak."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:103
translate turkish jamietv2_ecb1e778:

    # gnd "Okay, [pcname]. See you again soon."
    gnd "Tamam, [pcname]. Yakında görüşürüz."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:104
translate turkish jamietv2_209b1712:

    # pc "See ya."
    pc "Görüşürüz."

# game/Scenes/Jamie/JamieTV/jamietv2.rpy:105
translate turkish jamietv2_1557defd:

    # "With that, she goes back inside and I walk back over to my house."
    "Bunun üzerine o içeri giriyor ve ben de evime doğru yürüyorum."

