# game/Scenes/Tammy/tammy2.rpy:12
translate turkish tammy2_58882cf4:

    # "I spend some time working out with Tammy."
    "Bir süre Tammy ile birlikte antrenman yapıyorum."

# game/Scenes/Tammy/tammy2.rpy:13
translate turkish tammy2_f8739613:

    # "First I spot her."
    "Önce ben onu fark ediyorum."

# game/Scenes/Tammy/tammy2.rpy:16
translate turkish tammy2_b03ba21e:

    # "Then she spots me."
    "Sonra o beni fark ediyor."

# game/Scenes/Tammy/tammy2.rpy:20
translate turkish tammy2_f59c8527:

    # "Then we start chatting a bit between reps."
    "Sonra set aralarında biraz sohbet etmeye başlıyoruz."

# game/Scenes/Tammy/tammy2.rpy:21
translate turkish tammy2_e027ab69:

    # tm "You ever think about trying MMA?"
    tm "Hiç MMA denemeyi düşündün mü?"

# game/Scenes/Tammy/tammy2.rpy:22
translate turkish tammy2_08f599b9:

    # pc "MMA? Like fighting?"
    pc "MMA mı? Dövüşmek gibi mi?"

# game/Scenes/Tammy/tammy2.rpy:23
translate turkish tammy2_7ed92c4d:

    # tm "Yeah, like fighting. I train every weekend in the morning."
    tm "Evet, dövüşmek gibi. Her hafta sonu sabahları antrenman yapıyorum."

# game/Scenes/Tammy/tammy2.rpy:24
translate turkish tammy2_690f9781:

    # tm "You could come join me sometime."
    tm "Bir ara gelip bana katılabilirsin."

# game/Scenes/Tammy/tammy2.rpy:25
translate turkish tammy2_50211aa2:

    # pc "You're just looking for an excuse to beat me up."
    pc "Sen sadece beni dövmek için bahane arıyorsun."

# game/Scenes/Tammy/tammy2.rpy:27
translate turkish tammy2_d669bb2f:

    # "She punches me hard in the arm."
    "Koluma sertçe yumruk attı."

# game/Scenes/Tammy/tammy2.rpy:28
translate turkish tammy2_68bd08bc:

    # tm "Ha! I don't need an excuse for that."
    tm "Ha! Bunun için bahaneye ihtiyacım yok."

# game/Scenes/Tammy/tammy2.rpy:29
translate turkish tammy2_dedf8f6f:

    # pc "Ow! Damn."
    pc "Ah! Kahretsin."

# game/Scenes/Tammy/tammy2.rpy:31
translate turkish tammy2_eb4630f0:

    # tm "See that's why you need to come train in MMA. You got a nice body, but you're too soft."
    tm "Gördün mü, işte bu yüzden MMA antrenmanına gelmen gerekiyor. Vücudun güzel ama çok yumuşaksın."

# game/Scenes/Tammy/tammy2.rpy:32
translate turkish tammy2_eb998a13:

    # pc "You think I have a nice body?"
    pc "Vücudumun güzel olduğunu mu düşünüyorsun?"

# game/Scenes/Tammy/tammy2.rpy:33
translate turkish tammy2_9ac6fb46:

    # tm "Well, yeah."
    tm "Şey, evet."

# game/Scenes/Tammy/tammy2.rpy:34
translate turkish tammy2_cce51848:

    # pc "Alright, I'll come wrestle with you some time."
    pc "Tamam, bir ara gelip seninle güreşirim."

# game/Scenes/Tammy/tammy2.rpy:35
translate turkish tammy2_bdefbf8e:

    # tm "Good. I'm looking forward to it. Mornings and Afternoons on the weekends, I'll be here."
    tm "Güzel. Sabırsızlıkla bekliyorum. Hafta sonları sabahları ve öğleden sonraları burada olacağım."

# game/Scenes/Tammy/tammy2.rpy:39
translate turkish tammy2_7cd89556:

    # "We finish our workout and say goodbye to each other."
    "Antrenmanımızı bitirip birbirimize veda ediyoruz."

# game/Scenes/Tammy/tammy2.rpy:41
translate turkish tammy2_d33670c7:

    # "I have to admit, rolling around on the mat with her has a certain appeal."
    "İtiraf etmeliyim ki, onunla minderde yuvarlanmanın kendine has bir cazibesi var."

# game/Scenes/Tammy/tammy2.rpy:42
translate turkish tammy2_bf0d0df4:

    # "For now though, I leave the gym and go out to my car."
    "Ama şimdilik spor salonundan çıkıp arabama gidiyorum."

translate turkish strings:

    # game/Scenes/Tammy/tammy2.rpy:2
    old "Workout with Tammy on the weekend again."
    new "Hafta sonu yine Tammy ile antrenman yap."

    # game/Scenes/Tammy/tammy2.rpy:3
    old "Then she will ask if you want to train MMA with her."
    new "O zaman sana onunla MMA antrenmanı yapmak isteyip istemediğini soracak."

