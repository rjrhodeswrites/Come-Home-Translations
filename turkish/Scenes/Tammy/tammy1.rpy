# game/Scenes/Tammy/tammy1.rpy:12
translate turkish tammy1_61f20ba2:

    # "The café is pretty empty, and Tammy doesn't look very busy, so I walk up to the counter to chat with her."
    "Kafe oldukça boş ve Tammy pek meşgul görünmüyor, bu yüzden onunla sohbet etmek için tezgaha doğru yürüyorum."

# game/Scenes/Tammy/tammy1.rpy:13
translate turkish tammy1_aa8fa217:

    # tm "Hey there, [pcname]. What can I get for you?"
    tm "Selam [pcname]. Ne alırsın?"

# game/Scenes/Tammy/tammy1.rpy:14
translate turkish tammy1_62a25f4d:

    # pc "Nothing for me today. I actually just came in to chat with you."
    pc "Bugün benim için bir şey yok. Aslında sadece seninle sohbet etmek için geldim."

# game/Scenes/Tammy/tammy1.rpy:16
translate turkish tammy1_9e4a79ed:

    # tm "Oh yeah?"
    tm "Öyle mi?"

# game/Scenes/Tammy/tammy1.rpy:17
translate turkish tammy1_561d9a0b:

    # pc "Sure. So how have you been?"
    pc "Tabii. Ee, nasılsın?"

# game/Scenes/Tammy/tammy1.rpy:18
translate turkish tammy1_e9bdc9df:

    # tm "I've been doing really good actually."
    tm "Aslında gerçekten çok iyiyim."

# game/Scenes/Tammy/tammy1.rpy:19
translate turkish tammy1_d0fae397:

    # tm "Been training hard for my next fight."
    tm "Bir sonraki dövüşüm için sıkı antrenman yapıyorum."

# game/Scenes/Tammy/tammy1.rpy:20
translate turkish tammy1_a2fac566:

    # pc "Fight?"
    pc "Dövüş mü?"

# game/Scenes/Tammy/tammy1.rpy:22
translate turkish tammy1_1b5b2325:

    # tm "Yeah, MMA man. I love it."
    tm "Evet, MMA dostum. Bayılıyorum."

# game/Scenes/Tammy/tammy1.rpy:24
translate turkish tammy1_f58a7e3a:

    # tm "Hey, you should come work out with me sometime."
    tm "Hey, bir ara benimle antrenmana gelmelisin."

# game/Scenes/Tammy/tammy1.rpy:27
translate turkish tammy1_dc1221bf:

    # tm "Awesome!"
    tm "Harika!"

# game/Scenes/Tammy/tammy1.rpy:31
translate turkish tammy1_30e63ffa:

    # tm "Oh come on now, don't be a pussy."
    tm "Hadi ama, korkaklık yapma."

# game/Scenes/Tammy/tammy1.rpy:32
translate turkish tammy1_273bbe71:

    # tm "Just give it a try. For me?"
    tm "Sadece bir dene. Benim için mi?"

# game/Scenes/Tammy/tammy1.rpy:33
translate turkish tammy1_2ad4955b:

    # pc "All right, I guess I could use a workout every once in a while."
    pc "Tamam, sanırım ara sıra biraz egzersiz yapmamda fayda var."

# game/Scenes/Tammy/tammy1.rpy:35
translate turkish tammy1_5d2aa8aa:

    # tm "We all need it."
    tm "Hepimizin ihtiyacı var."

# game/Scenes/Tammy/tammy1.rpy:36
translate turkish tammy1_a804b563:

    # tm "So the place I work out at isn't your normal gym."
    tm "Şey, benim spor yaptığım yer sıradan bir spor salonu değil."

# game/Scenes/Tammy/tammy1.rpy:37
translate turkish tammy1_7e8b0ee1:

    # tm "It's the boxing club over on the west side of town."
    tm "Şehrin batı yakasındaki boks kulübü."

# game/Scenes/Tammy/tammy1.rpy:38
translate turkish tammy1_40dda578:

    # pc "Isn't that place pretty rough?"
    pc "Orası epey sert bir yer değil mi?"

# game/Scenes/Tammy/tammy1.rpy:39
translate turkish tammy1_6f117f59:

    # tm "It can be. It's a bunch of high-testosterone guys who like to fight."
    tm "Olabilir. Kavga etmeyi seven, testosteron seviyesi yüksek bir grup erkek var orada."

# game/Scenes/Tammy/tammy1.rpy:40
translate turkish tammy1_851c2c59:

    # tm "But if you go over there with me, there won't be a problem."
    tm "Ama benimle birlikte gidersen sorun çıkmaz."

# game/Scenes/Tammy/tammy1.rpy:41
translate turkish tammy1_c0350021:

    # tm "I'm there in the afternoon every day."
    tm "Her gün öğleden sonra oradayım."

# game/Scenes/Tammy/tammy1.rpy:42
translate turkish tammy1_e3da760c:

    # pc "I work in the afternoons."
    pc "Ben öğleden sonraları çalışıyorum."

# game/Scenes/Tammy/tammy1.rpy:43
translate turkish tammy1_b79833dd:

    # tm "Then come on the weekend."
    tm "O zaman hafta sonu gel."

# game/Scenes/Tammy/tammy1.rpy:44
translate turkish tammy1_f14b89df:

    # pc "I guess I could do that."
    pc "Sanırım yapabilirim."

# game/Scenes/Tammy/tammy1.rpy:45
translate turkish tammy1_26cf52a7:

    # tm "Great! I can't wait to see you there. It's going to be so much fun."
    tm "Harika! Orada seni görmek için sabırsızlanıyorum. Çok eğlenceli olacak."

# game/Scenes/Tammy/tammy1.rpy:46
translate turkish tammy1_a5034e2d:

    # pc "You really think working out is fun?"
    pc "Egzersiz yapmanın gerçekten eğlenceli olduğunu mu düşünüyorsun?"

# game/Scenes/Tammy/tammy1.rpy:48
translate turkish tammy1_fca9b16a:

    # tm "It can be. Especially with me."
    tm "Olabilir. Özellikle benimle."

# game/Scenes/Tammy/tammy1.rpy:49
translate turkish tammy1_195d6734:

    # pc "All right, I'm sold."
    pc "Tamam, ikna oldum."

# game/Scenes/Tammy/tammy1.rpy:50
translate turkish tammy1_4047c36d:

    # "Tammy and I chit-chat for a little bit longer, then a crowd of customers comes in and she has to get back to work."
    "Tammy ile biraz daha sohbet ettik, sonra bir grup müşteri geldi ve o da işine dönmek zorunda kaldı."

# game/Scenes/Tammy/tammy1.rpy:51
translate turkish tammy1_c0781de6:

    # "I tell her goodbye and head out to my car."
    "Ona veda edip arabama doğru yola çıktım."

# game/Scenes/Tammy/tammy1.rpy:52
translate turkish tammy1_13dba231:

    # "Working out with Tammy could be fun. I could be in better shape anyway."
    "Tammy ile spor yapmak eğlenceli olabilir. Zaten formumu biraz daha iyileştirmem de iyi olur."

# game/Scenes/Tammy/tammy1.rpy:53
translate turkish tammy1_6f40d8bb:

    # "I should check out that boxing club in the afternoon on the weekend sometime."
    "Hafta sonu öğleden sonra şu boks kulübünü bir kez denemeliyim."

# game/Scenes/Tammy/tammy1.rpy:57
translate turkish tammy1_7a3c9e8d:

    # "For now, I have to go to class."
    "Şimdilik derse gitmem gerekiyor."

