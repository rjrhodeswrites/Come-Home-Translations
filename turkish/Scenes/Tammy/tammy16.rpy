# game/Scenes/Tammy/tammy16.rpy:20
translate turkish tammy16_39bb639d:

    # tm "Oh hey, [pcname]!"
    tm "Oh hey, [pcname]!"

# game/Scenes/Tammy/tammy16.rpy:22
translate turkish tammy16_c7aa7331:

    # tm "I wanted to let you know that I got another fight!"
    tm "Sana bir dövüşüm daha olduğunu haber vermek istedim!"

# game/Scenes/Tammy/tammy16.rpy:23
translate turkish tammy16_46fcf508:

    # pc "Oh yeah? Awesome!"
    pc "Oh, öyle mi? Harika!"

# game/Scenes/Tammy/tammy16.rpy:25
translate turkish tammy16_537005d0:

    # tm "Yeah! I mean, it's the same opponent. Sara Death."
    tm "Evet! Yani, aynı rakip. Sara Death."

# game/Scenes/Tammy/tammy16.rpy:26
translate turkish tammy16_ff4ca977:

    # tm "They couldn't find anybody else to fight me around here."
    tm "Buralarda benimle dövüşecek başka kimseyi bulamadılar."

# game/Scenes/Tammy/tammy16.rpy:27
translate turkish tammy16_c040e3a2:

    # pc "Still. A rematch! That'll be fun."
    pc "Yine de. Bir rövanş maçı! Çok eğlenceli olacak."

# game/Scenes/Tammy/tammy16.rpy:29
translate turkish tammy16_65a45e79:

    # tm "Yeah, so it's Friday evening. You're going to come, right?"
    tm "Evet, cuma akşamı. Geleceksin, değil mi?"

# game/Scenes/Tammy/tammy16.rpy:30
translate turkish tammy16_a248948f:

    # pc "Of course."
    pc "Tabii ki."

# game/Scenes/Tammy/tammy16.rpy:31
translate turkish tammy16_0d0b0b78:

    # tm "Good. Suzy's coming to this one too."
    tm "Güzel. Suzy de bu maça geliyor."

# game/Scenes/Tammy/tammy16.rpy:33
translate turkish tammy16_a716e406:

    # tm "I'm so fucking excited!"
    tm "Çok heyecanlıyım!"

# game/Scenes/Tammy/tammy16.rpy:34
translate turkish tammy16_c03b2498:

    # tm "Ready to work out?"
    tm "Antrenmana hazır mısın?"

# game/Scenes/Tammy/tammy16.rpy:35
translate turkish tammy16_81e72625:

    # pc "Yeah, let's do it!"
    pc "Evet, hadi yapalım!"

# game/Scenes/Tammy/tammy16.rpy:46
translate turkish tammy16b_d3127e62:

    # "Tonight is Tammy's fight. I better head over to the gym to support her."
    "Bu gece Tammy'nin maçı var. Onu desteklemek için spor salonuna gitsem iyi olacak."

# game/Scenes/Tammy/tammy16.rpy:50
translate turkish tammy16b_fc7a2349:

    # "The place is packed tonight. Even more people than the first fight. I guess everybody wants to see the rematch."
    "Bu gece salon tıklım tıklım dolu. İlk maçtaki kalabalıktan bile fazla insan var. Sanırım herkes rövanş maçını izlemek istiyor."

# game/Scenes/Tammy/tammy16.rpy:51
translate turkish tammy16b_c1a9fded:

    # "I spot Tammy and Suzy hanging out near the ring and walk over to them."
    "Tammy ve Suzy'yi ringin yanında takılırken görüyorum ve yanlarına doğru yürüyorum."

# game/Scenes/Tammy/tammy16.rpy:54
translate turkish tammy16b_ef965655:

    # tm "Hey, [pcname]. You in my corner again?"
    tm "Selam, [pcname]. Yine köşemde misin?"

# game/Scenes/Tammy/tammy16.rpy:55
translate turkish tammy16b_351f8f78:

    # pc "I'm always in your corner, girl."
    pc "Her zaman köşendesin, kızım."

# game/Scenes/Tammy/tammy16.rpy:58
translate turkish tammy16b_7de5fb0a:

    # tm "I know you are. Love you!"
    tm "Biliyorum. Seni seviyorum!"

# game/Scenes/Tammy/tammy16.rpy:59
translate turkish tammy16b_ce2ae2bf:

    # pc "Love you too."
    pc "Ben de seni seviyorum."

# game/Scenes/Tammy/tammy16.rpy:60
translate turkish tammy16b_fbdb8489:

    # "Chuck, the gym owner and referee, steps onto the stage and speaks into a microphone."
    "Spor salonunun sahibi ve hakem olan Chuck sahneye çıkıyor ve mikrofona konuşuyor."

# game/Scenes/Tammy/tammy16.rpy:61
translate turkish tammy16b_03a792fe:

    # "Chuck" "All right, everybody. Fighters to the ring."
    "Chuck" "Pekala millet. Dövüşçüler ringe."

# game/Scenes/Tammy/tammy16.rpy:64
translate turkish tammy16b_bc20373a:

    # tm "Guess I gotta go. Wish me luck."
    tm "Sanırım gitmem lazım. Bana şans dile."

# game/Scenes/Tammy/tammy16.rpy:65
translate turkish tammy16b_70969e05:

    # ss "You don't need it. You're going to wipe the mat with her."
    ss "Şansa ihtiyacın yok. Onu yerden silip süpüreceksin."

# game/Scenes/Tammy/tammy16.rpy:66
translate turkish tammy16b_8407fcdb:

    # pc "You trained so hard. You're a beast."
    pc "Çok sıkı antrenman yaptın. Sen bir canavarsın."

# game/Scenes/Tammy/tammy16.rpy:67
translate turkish tammy16b_0fc82d62:

    # tm "Thanks, guys."
    tm "Teşekkürler çocuklar."

# game/Scenes/Tammy/tammy16.rpy:70
translate turkish tammy16b_4d3281d1:

    # ss "You better get up there in her corner. She needs you."
    ss "Onun köşesine gitsen iyi olur. Sana ihtiyacı var."

# game/Scenes/Tammy/tammy16.rpy:71
translate turkish tammy16b_2cda7690:

    # pc "You don't want to?"
    pc "İstemiyor musun?"

# game/Scenes/Tammy/tammy16.rpy:72
translate turkish tammy16b_2475c65e:

    # ss "No, I'm going to go cheer from the back. I don't like to see her get hit."
    ss "Hayır, arkadan tezahürat yapacağım. Onun darbe almasını görmek istemiyorum."

# game/Scenes/Tammy/tammy16.rpy:73
translate turkish tammy16b_7ebf9a37:

    # ss "But you'll hear me, I'm sure."
    ss "Ama beni duyacaksın, eminim."

# game/Scenes/Tammy/tammy16.rpy:76
translate turkish tammy16b_8ba7b5ed:

    # "I climb up into Tammy's corner as Chuck introduces the fighters."
    "Chuck dövüşçüleri tanıtırken ben de Tammy'nin köşesine tırmanıyorum."

# game/Scenes/Tammy/tammy16.rpy:77
translate turkish tammy16b_263516ea:

    # "Sara Death looks somehow even bigger and more jacked than she did last time they fought."
    "Sara Death, geçen sefer dövüştüklerinden daha iri ve daha kaslı görünüyor."

# game/Scenes/Tammy/tammy16.rpy:78
translate turkish tammy16b_dd7b01f4:

    # "Tammy is so much smaller it's sometimes hard to believe that she can take an opponent like that down."
    "Tammy o kadar küçük ki, bazen böyle bir rakibi yere indirebileceğine inanmak zor geliyor."

# game/Scenes/Tammy/tammy16.rpy:79
translate turkish tammy16b_edae56fc:

    # "Chuck" "... Our return opponent in this rematch, Sara Death!"
    "Chuck" "... Bu rövanş maçında karşımıza çıkan rakibimiz, Sara Death!"

# game/Scenes/Tammy/tammy16.rpy:83
translate turkish tammy16b_a31e4957:

    # "Chuck" "And in this corner, undefeated so far in her amateur fighting career and hoping to continue that streak tonight..."
    "Chuck" "Ve bu köşede, amatör dövüş kariyerinde şu ana kadar yenilgisiz olan ve bu gece de bu serisini sürdürmeyi uman..."

# game/Scenes/Tammy/tammy16.rpy:85
translate turkish tammy16b_83b35d9b:

    # "Chuck" "And in this corner, looking to get revenge on the beating she took last fight..."
    "Chuck" "Ve bu köşede, son maçında aldığı yenilginin intikamını almak isteyen..."

# game/Scenes/Tammy/tammy16.rpy:86
translate turkish tammy16b_96ba703d:

    # "Chuck" "... standing five-foot-six-inches tall and weighing in at 130 pounds..."
    "Chuck" "... boyu beş fit altı inç, ağırlığı 130 pound olan..."

# game/Scenes/Tammy/tammy16.rpy:87
translate turkish tammy16b_ec4b18ff:

    # "Chuck" "Tammy \"Wham! Bam!\" Zamora!"
    "Chuck" "Tammy \"Wham! Bam!\" Zamora!"

# game/Scenes/Tammy/tammy16.rpy:90
translate turkish tammy16b_6f4f75f7:

    # "Chuck takes them to the middle of the ring and goes over the rules with them."
    "Chuck, ikisini ringin ortasına götürüyor ve kuralları anlatıyor."

# game/Scenes/Tammy/tammy16.rpy:91
translate turkish tammy16b_0b6f40cb:

    # "Sara smiles the whole time. I can see Sara and Tammy muttering something to each other and laughing."
    "Sara başından sonuna kadar gülümsüyor. Sara ve Tammy'nin birbirlerine bir şeyler fısıldayıp güldüklerini görebiliyorum."

# game/Scenes/Tammy/tammy16.rpy:92
translate turkish tammy16b_24d8b054:

    # "Even though they're about to beat the crap out of each other, it seems like they're having a good time."
    "Birbirlerini fena halde dövmek üzere olsalar da, eğleniyor gibi görünüyorlar."

# game/Scenes/Tammy/tammy16.rpy:93
translate turkish tammy16b_1b6ae11e:

    # "When they're done, they touch gloves and return to their corners."
    "İşleri bittiğinde, eldivenlerini tokuşturup köşelerine dönüyorlar."

# game/Scenes/Tammy/tammy16.rpy:96
translate turkish tammy16b_fcfdafdf:

    # pc "You got this."
    pc "Başarabilirsin."

# game/Scenes/Tammy/tammy16.rpy:97
translate turkish tammy16b_3caaf546:

    # tm "You're goddamn right."
    tm "Kesinlikle haklısın."

# game/Scenes/Tammy/tammy16.rpy:98
translate turkish tammy16b_0929120c:

    # "Chuck" "Three... Two... One... FIGHT!"
    "Chuck" "Üç... İki... Bir... DÖVÜŞ!"

# game/Scenes/Tammy/tammy16.rpy:101
translate turkish tammy16b_ec9b5571:

    # "They both rush to the middle of the ring and the crowd goes wild."
    "İkisi de ringin ortasına koşuyor ve seyirciler çılgına dönüyor."

# game/Scenes/Tammy/tammy16.rpy:104
translate turkish tammy16b_679f2669:

    # "Even over the yells of all of those around me, I can hear Suzy in the back, cheering loudly for our girlfriend."
    "Etrafımdaki herkesin bağırışlarının üstünden bile, arkada Suzy'nin kız arkadaşımıza yüksek sesle tezahürat ettiğini duyabiliyorum."

# game/Scenes/Tammy/tammy16.rpy:107
translate turkish tammy16b_647f4a54:

    # "They circle around each other a bit, testing out their range, looking for openings."
    "Birbirlerinin etrafında biraz dolanıyorlar, mesafelerini ölçüyorlar, açık arıyorlar."

# game/Scenes/Tammy/tammy16.rpy:110
translate turkish tammy16b_5d7efc88:

    # "Tammy is trying to stay loose, moving in and out quickly to land leg kicks."
    "Tammy rahat kalmaya çalışıyor, bacak vuruşları indirmek için hızla ileri geri hareket ediyor."

# game/Scenes/Tammy/tammy16.rpy:111
translate turkish tammy16b_e3d4107b:

    # "She knows that getting too close would mean that she could be taken down to the ground."
    "Çok yaklaşırsa yere indirilebileceğini biliyor."

# game/Scenes/Tammy/tammy16.rpy:112
translate turkish tammy16b_a88a4b4f:

    # "Having the much larger Sara on top of her could easily lead to her getting overwhelmed."
    "Kendisinden çok daha iri olan Sara’nın üstüne çıkması, kolayca ezilmesine yol açabilir."

# game/Scenes/Tammy/tammy16.rpy:115
translate turkish tammy16b_a3883dc3:

    # "Of course, taking one of those big fists on her chin could knock her down as well."
    "Tabii ki, o kocaman yumruklardan birini çenesine yerse o da yere düşebilir."

# game/Scenes/Tammy/tammy16.rpy:116
translate turkish tammy16b_b3da4826:

    # "Every second she's in this fight, there's more of a chance of her getting hit and knocked out."
    "Bu dövüşte kaldığı her saniye, darbe alıp nakavt olma ihtimali artıyor."

# game/Scenes/Tammy/tammy16.rpy:119
translate turkish tammy16b_cdd3604c:

    # "Tammy is able to land a few good hits, but Sara just takes them and keeps coming."
    "Tammy birkaç iyi vuruş yapabiliyor, ama Sara bunları yiyor ve saldırmaya devam ediyor."

# game/Scenes/Tammy/tammy16.rpy:122
translate turkish tammy16b_248b11e5:

    # "Then the referee calls the end of the round and steps in to separate them back to their corners."
    "Sonra hakem raundun bittiğini ilan ediyor ve ikisini köşelerine ayırmak için araya giriyor."

# game/Scenes/Tammy/tammy16.rpy:125
translate turkish tammy16b_5dca43c0:

    # tm "How am I looking out there?"
    tm "Orada nasıl görünüyorum?"

# game/Scenes/Tammy/tammy16.rpy:126
translate turkish tammy16b_40609e22:

    # pc "You look great. Really fucking sexy."
    pc "Harika görünüyorsun. Gerçekten çok seksi."

# game/Scenes/Tammy/tammy16.rpy:127
translate turkish tammy16b_4586870d:

    # tm "Haha, I need a real coach."
    tm "Haha, gerçek bir koça ihtiyacım var."

# game/Scenes/Tammy/tammy16.rpy:128
translate turkish tammy16b_4e5ec89e:

    # pc "Seriously, you're looking good. Moving fast. Staying on your toes."
    pc "Cidden, iyi görünüyorsun. Hızlı hareket ediyorsun. Ayaklarının üzerinde duruyorsun."

# game/Scenes/Tammy/tammy16.rpy:129
translate turkish tammy16b_eafbc9cd:

    # pc "I liked those leg kicks. They seemed to slow her down a bit. Her being slow is good. You can take advantage of that."
    pc "O bacak vuruşlarını beğendim. Onu biraz yavaşlatmış gibi görünüyor. Onun yavaş olması iyi. Bundan yararlanabilirsin."

# game/Scenes/Tammy/tammy16.rpy:130
translate turkish tammy16b_2d3b068d:

    # pc "Just be careful about her taking you down."
    pc "Sadece seni yere indirmesine dikkat et."

# game/Scenes/Tammy/tammy16.rpy:131
translate turkish tammy16b_ec4282cb:

    # tm "Yeah, that's what I'm scared of. I've never been on the ground with her before."
    tm "Evet, ben de bundan korkuyorum. Onunla daha önce hiç yerde dövüşmedim."

# game/Scenes/Tammy/tammy16.rpy:132
translate turkish tammy16b_6ef7cd76:

    # pc "You got this. I'm pretty sure you won that first round. Just keep moving and stay hard to hit."
    pc "Başarabilirsin. İlk raundu kazandığından eminim. Hareket etmeye devam et ve vurulmaması için dikkatli ol."

# game/Scenes/Tammy/tammy16.rpy:133
translate turkish tammy16b_850254f5:

    # tm "You got it. Thanks, coach."
    tm "Anladım. Teşekkürler, koç."

# game/Scenes/Tammy/tammy16.rpy:136
translate turkish tammy16b_2221ccc4:

    # "When the bell rings, they're right back in the middle of the ring again, trading punches."
    "Zil çaldığında, ikisi hemen ringin ortasına geri dönüyor ve yumruklaşıyorlar."

# game/Scenes/Tammy/tammy16.rpy:137
translate turkish tammy16b_c6a976b0:

    # "Tammy is able to block most of Sara's punches and sneak in a few of her own."
    "Tammy, Sara’nın yumruklarının çoğunu engelliyor ve kendi yumruklarını da aralara sıkıştırıyor."

# game/Scenes/Tammy/tammy16.rpy:140
translate turkish tammy16b_9dbf1b1c:

    # "Then Tammy hops back and gets another hard kick to Sara's leg, the slap of shin on thigh echoing through the gym."
    "Sonra Tammy geriye sıçrayıp Sara’nın bacağına bir sert tekme daha indiriyor; kaval kemiğinin uyluk kemiğine çarpma sesi spor salonunda yankılanıyor."

# game/Scenes/Tammy/tammy16.rpy:141
translate turkish tammy16b_4c60ba4c:

    # "Sara winces. That one hurt."
    "Sara yüzünü buruşturur. Bu seferki acıttı."

# game/Scenes/Tammy/tammy16.rpy:144
translate turkish tammy16b_e41ad8f5:

    # "The pain and the frustration gets to Sara then and she growls in anger as she charges forward."
    "Acı ve hüsran o anda Sara’yı ele geçirir ve öfkeyle kükreyerek ileriye doğru hücum eder."

# game/Scenes/Tammy/tammy16.rpy:145
translate turkish tammy16b_03576045:

    # "She's throwing haymakers now, backing Tammy up towards the ropes."
    "Artık haymaker yumrukları savuruyor ve Tammy’yi iplere doğru geriye sıkıştırıyor."

# game/Scenes/Tammy/tammy16.rpy:146
translate turkish tammy16b_028976a4:

    # "Sara has lost all defense in this moment. If Tammy could take advantage of it, she might be able to end the fight."
    "Sara bu anda tüm savunmasını kaybetmiştir. Eğer Tammy bundan yararlanabilirse, maçı bitirebilir."

# game/Scenes/Tammy/tammy16.rpy:149
translate turkish tammy16b_5dc11d33:

    # "But then one of the punches connects, cracking against Tammy's jaw and rolling her eyes back."
    "Ama sonra yumruklardan biri isabet eder, Tammy’nin çenesine çarpar ve gözlerini geriye yuvarlar."

# game/Scenes/Tammy/tammy16.rpy:150
translate turkish tammy16b_ade70eed:

    # "I hear Suzy in the back cry out in shock as Tammy falls to the mat."
    "Tammy mindere düşerken arkadan Suzy’nin şok içinde çığlık attığını duyuyorum."

# game/Scenes/Tammy/tammy16.rpy:153
translate turkish tammy16b_76769a9d:

    # "At first, I think that's it, that Tammy is knocked out, but she quickly shakes her head and starts fighting back."
    "İlk başta her şeyin bittiğini, Tammy’nin nakavt olduğunu sanıyorum, ama o hızla başını sallayıp karşılık vermeye başlıyor."

# game/Scenes/Tammy/tammy16.rpy:154
translate turkish tammy16b_8cf6bab3:

    # "But now Sara is on top of her, raining punches down onto her."
    "Ancak şimdi Sara onun üstüne çıkmış, üzerine yumruk yağdırıyor."

# game/Scenes/Tammy/tammy16.rpy:155
translate turkish tammy16b_f5522b72:

    # "Chuck is close and I can tell he's about to stop the fight."
    "Chuck çok yakın ve dövüşü durdurmak üzere olduğunu anlayabiliyorum."

# game/Scenes/Tammy/tammy16.rpy:158
translate turkish tammy16b_12ebb29b:

    # "What happens next is so fast that I can barely follow it."
    "Sonrasında olanlar o kadar hızlı ki zar zor takip edebiliyorum."

# game/Scenes/Tammy/tammy16.rpy:159
translate turkish tammy16b_a46fd698:

    # "Tammy grabs Sara's wrist and bucks her hips, moving her legs up towards Sara's head."
    "Tammy, Sara’nın bileğini yakalıyor ve kalçalarını sallayarak bacaklarını Sara’nın kafasına doğru kaldırıyor."

# game/Scenes/Tammy/tammy16.rpy:162
translate turkish tammy16b_14e97ff6:

    # "Then Tammy rotates and has Sara's arm fully stretched out."
    "Sonra Tammy dönüyor ve Sara’nın kolunu tamamen gerginleştiriyor."

# game/Scenes/Tammy/tammy16.rpy:163
translate turkish tammy16b_ca12b0e7:

    # "Sara cries out in pain. If she doesn't tap soon, Tammy could easily break her arm."
    "Sara acı içinde çığlık atıyor. Eğer hemen pes etmezse, Tammy kolunu kolayca kırabilir."

# game/Scenes/Tammy/tammy16.rpy:166
translate turkish tammy16b_f3df8ee4:

    # "She reluctantly taps and the crowd goes insane."
    "İsteksizce pes ediyor ve kalabalık çılgına dönüyor."

# game/Scenes/Tammy/tammy16.rpy:169
translate turkish tammy16b_2d3791c3:

    # "I can't hear anything, the room is so loud and suddenly Suzy is right there, jumping up onto my shoulder."
    "Hiçbir şey duyamıyorum, oda çok gürültülü ve aniden Suzy tam yanımda beliriyor, omzuma atlıyor."

# game/Scenes/Tammy/tammy16.rpy:170
translate turkish tammy16b_be32fa84:

    # "I hold her high while she cheers."
    "O tezahürat yaparken onu havaya kaldırıyorum."

# game/Scenes/Tammy/tammy16.rpy:173
translate turkish tammy16b_411f816b:

    # "Chuck announces the winner, but it's impossible to hear him over the roaring crowd."
    "Chuck kazananı açıklıyor ama gürleyen kalabalığın sesinden onu duymak imkansız."

# game/Scenes/Tammy/tammy16.rpy:174
translate turkish tammy16b_67d97e00:

    # "Tammy and Sara are both crying in the ring. Suzy's crying on my shoulder. Hell, I'm crying a little bit too."
    "Tammy ve Sara ringde ikisi de ağlıyor. Suzy omzumda ağlıyor. Kahretsin, ben de biraz ağlıyorum."

# game/Scenes/Tammy/tammy16.rpy:177
translate turkish tammy16b_09e2a5ca:

    # "Then Tammy runs over and kisses Suzy."
    "Sonra Tammy koşup Suzy’yi öpüyor."

# game/Scenes/Tammy/tammy16.rpy:178
translate turkish tammy16b_5354153a:

    # ss "You're a fucking queen! I love you!"
    ss "Sen tam bir kraliçesin! Seni seviyorum!"

# game/Scenes/Tammy/tammy16.rpy:179
translate turkish tammy16b_4039bf0e:

    # tm "I love both of you so fucking much!"
    tm "İkinizi de çok ama çok seviyorum!"

# game/Scenes/Tammy/tammy16.rpy:182
translate turkish tammy16b_c191fa62:

    # "The next half hour passes by in a blur as everybody congratulates Tammy and wants to talk to her and Sara."
    "Sonraki yarım saat, herkes Tammy'yi tebrik edip onunla ve Sara'yla konuşmak isterken bir çırpıda geçiyor."

