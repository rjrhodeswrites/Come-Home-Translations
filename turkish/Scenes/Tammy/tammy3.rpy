# TODO: Translation updated at 2026-08-03 12:42

# game/Scenes/Tammy/tammy3.rpy:15
translate turkish tammy3_57a68160:

    # tm "Today we're going to learn about grappling."
    tm "Bugün grappling hakkında bilgi edineceğiz."

# game/Scenes/Tammy/tammy3.rpy:16
translate turkish tammy3_8bbac2a1:

    # tm "In a fight, 90 percent of the time the two combatants will end up on the mat."
    tm "Bir dövüşte, yüzde 90 oranında iki dövüşçü de matın üzerine düşer."

# game/Scenes/Tammy/tammy3.rpy:17
translate turkish tammy3_ac91ad7e:

    # tm "When that happens, you need to know how to grapple, or you'll get a limb broken or get choked out."
    tm "Bu olduğunda, grappling yapmayı bilmelisin, yoksa bir uzvun kırılır ya da boğulursun."

# game/Scenes/Tammy/tammy3.rpy:18
translate turkish tammy3_d672444d:

    # pc "What if I just don't go to the ground."
    pc "Ya yere düşmezsem ne olur?"

# game/Scenes/Tammy/tammy3.rpy:19
translate turkish tammy3_ad2a727b:

    # tm "Not an option."
    tm "Bu bir seçenek değil."

# game/Scenes/Tammy/tammy3.rpy:20
translate turkish tammy3_3b2e0784:

    # pc "Sure it is, if I don't want you to take me to the ground--"
    pc "Elbette bir seçenek, eğer beni yere düşürmeni istemiyorsam..."

# game/Scenes/Tammy/tammy3.rpy:23
translate turkish tammy3_d5995587:

    # "What was I saying? All thought is knocked out of my mind as Tammy slams into me like a bullet."
    "Ne diyordum ben? Tammy bir mermi gibi üzerime çarptığında aklımdan tüm düşünceler silindi."

# game/Scenes/Tammy/tammy3.rpy:24
translate turkish tammy3_6c3dcce2:

    # "I feel myself falling backwards."
    "Kendimi geriye doğru düşerken hissediyorum."

# game/Scenes/Tammy/tammy3.rpy:27
translate turkish tammy3_2f96182c:

    # "Then I hit the mat hard. Tammy is on top of me in an instant."
    "Sonra matın üzerine sertçe çarptım. Tammy bir anda üstüme çıktı."

# game/Scenes/Tammy/tammy3.rpy:28
translate turkish tammy3_c46fa0c1:

    # pc "Ouch."
    pc "Ah."

# game/Scenes/Tammy/tammy3.rpy:29
translate turkish tammy3_cd6347a1:

    # tm "Now you're on the ground and you can't do anything."
    tm "Artık yerde yatıyorsun ve hiçbir şey yapamazsın."

# game/Scenes/Tammy/tammy3.rpy:32
translate turkish tammy3_dae4a999:

    # "I attempt to push her off me, but I can't get any leverage from the position I'm in."
    "Onu üstümden itmeye çalışıyorum, ama bulunduğum pozisyondan hiçbir güç uygulayamıyorum."

# game/Scenes/Tammy/tammy3.rpy:33
translate turkish tammy3_81be8aeb:

    # tm "Not going to happen."
    tm "Olmaz."

# game/Scenes/Tammy/tammy3.rpy:35
translate turkish tammy3_a4fdb823:

    # tm "Good, I'm glad you understand."
    tm "Güzel, anladığına sevindim."

# game/Scenes/Tammy/tammy3.rpy:37
translate turkish tammy3_03220617:

    # tm "Focus. Pretend I'm a 200-pound hairy man."
    tm "Odaklan. Beni 200 poundluk kıllı bir adam olarak hayal et."

# game/Scenes/Tammy/tammy3.rpy:38
translate turkish tammy3_6d1ff706:

    # pc "I'd rather not."
    pc "Hayır, istemem."

# game/Scenes/Tammy/tammy3.rpy:39
translate turkish tammy3_938b0434:

    # tm "This position is called a full mount."
    tm "Bu pozisyona “full mount” denir."

# game/Scenes/Tammy/tammy3.rpy:40
translate turkish tammy3_ba765fb2:

    # tm "I have my knees bracing myself on both sides of your body and I keep your back pressed against the mat."
    tm "Dizlerim vücudunun iki yanına dayalı ve sırtını matın üzerine bastırıyorum."

# game/Scenes/Tammy/tammy3.rpy:41
translate turkish tammy3_c6c5a568:

    # tm "It negates all of your strength and puts me in a position where I can do pretty much whatever I want."
    tm "Bu, tüm gücünü etkisiz hale getiriyor ve beni istediğim her şeyi yapabileceğim bir konuma getiriyor."

# game/Scenes/Tammy/tammy3.rpy:44
translate turkish tammy3_04908dac:

    # tm "See. Nothing you can do to stop me."
    tm "Gördün mü? Beni durdurmak için yapabileceğin hiçbir şey yok."

# game/Scenes/Tammy/tammy3.rpy:47
translate turkish tammy3_d9fe7a04:

    # tm "I'm a 200-pound hairy man, remember?"
    tm "Ben 200 poundluk kıllı bir erkeğim, unuttun mu?"

# game/Scenes/Tammy/tammy3.rpy:48
translate turkish tammy3_7c4a85b3:

    # pc "My imagination is not that good."
    pc "Hayal gücüm o kadar da iyi değil."

# game/Scenes/Tammy/tammy3.rpy:50
translate turkish tammy3_65ea559e:

    # tm "Sorry, you're right. I'll focus on the fighting."
    tm "Pardon, haklısın. Dövüşe odaklanacağım."

# game/Scenes/Tammy/tammy3.rpy:53
translate turkish tammy3_9e2865cc:

    # tm "Okay, let's switch positions now. You're on top and I'm on bottom."
    tm "Tamam, şimdi pozisyonları değiştirelim. Sen üstte, ben altta olacağım."

# game/Scenes/Tammy/tammy3.rpy:56
translate turkish tammy3_90afe576:

    # "She lies down on her back and allows me to get on top of her."
    "Sırt üstü uzanıyor ve üstüne çıkmama izin veriyor."

# game/Scenes/Tammy/tammy3.rpy:57
translate turkish tammy3_c97236f5:

    # tm "You can use your full weight, it's okay. I can take it."
    tm "Tüm ağırlığını kullanabilirsin, sorun değil. Ben dayanabilirim."

# game/Scenes/Tammy/tammy3.rpy:58
translate turkish tammy3_66eb4b07:

    # tm "Okay, now I want you to do your best to hold me in this position and I'll show you how to escape it."
    tm "Tamam, şimdi beni bu pozisyonda tutmak için elinden geleni yapmanı istiyorum, ben de sana bu pozisyondan nasıl kurtulacağını göstereceğim."

# game/Scenes/Tammy/tammy3.rpy:61
translate turkish tammy3_d4c215db:

    # "She grabs my arm and then suddenly slams her hips upwards."
    "Kolumu tutuyor ve aniden kalçalarını yukarı doğru sertçe itiyor."

# game/Scenes/Tammy/tammy3.rpy:64
translate turkish tammy3_b72fcb07:

    # "Then she rolls, knocking me onto my back once again."
    "Sonra yuvarlanıyor ve beni tekrar sırt üstü yere deviriyor."

# game/Scenes/Tammy/tammy3.rpy:65
translate turkish tammy3_d9c1adb2:

    # tm "See? Easy."
    tm "Gördün mü? Kolay."

# game/Scenes/Tammy/tammy3.rpy:66
translate turkish tammy3_6a40f515:

    # tm "You just grab the arm to stop the person on top from posting up with it."
    tm "Üstteki kişinin kolunu kullanarak kendini sabitlemesini engellemek için kolunu tutman yeterli."

# game/Scenes/Tammy/tammy3.rpy:67
translate turkish tammy3_46422fcf:

    # tm "You slam your hips upwards to create space, then roll."
    tm "Boşluk yaratmak için kalçalarını yukarı doğru sertçe it, sonra yuvarlan."

# game/Scenes/Tammy/tammy3.rpy:68
translate turkish tammy3_e870d3d9:

    # tm "Got it?"
    tm "Anladın mı?"

# game/Scenes/Tammy/tammy3.rpy:69
translate turkish tammy3_1e770403:

    # pc "I think so."
    pc "Sanırım."

# game/Scenes/Tammy/tammy3.rpy:70
translate turkish tammy3_d4d7a636:

    # tm "Let's practice."
    tm "Hadi alıştırma yapalım."

# game/Scenes/Tammy/tammy3.rpy:73
translate turkish tammy3_72164a62:

    # "We return to the previous position."
    "Önceki pozisyona geri dönüyoruz."

# game/Scenes/Tammy/tammy3.rpy:74
translate turkish tammy3_a8e28fcc:

    # "Then I do what she said. I grab her arm and slam my hips upwards, then roll."
    "Sonra onun dediğini yapıyorum. Kolunu tutuyorum ve kalçalarımı yukarı doğru sertçe itip yuvarlanıyorum."

# game/Scenes/Tammy/tammy3.rpy:75
translate turkish tammy3_b74e68d2:

    # "It takes a couple of tries to get the movements right, but then..."
    "Hareketleri doğru yapabilmek için birkaç deneme gerekiyor, ama sonra..."

# game/Scenes/Tammy/tammy3.rpy:78
translate turkish tammy3_004dfbf8:

    # "I knock her on her back and I'm on top of her."
    "Onu sırt üstü deviriyorum ve üstüne çıkıyorum."

# game/Scenes/Tammy/tammy3.rpy:79
translate turkish tammy3_591f67d4:

    # tm "That was perfect! Good job!"
    tm "Mükemmeldi! Aferin!"

# game/Scenes/Tammy/tammy3.rpy:80
translate turkish tammy3_7d946eb7:

    # pc "Thanks. I think I got it."
    pc "Teşekkürler. Sanırım anladım."

# game/Scenes/Tammy/tammy3.rpy:81
translate turkish tammy3_7c97e1b9:

    # tm "Now that you got me in this position, you could do a lot of different things to me."
    tm "Artık beni bu pozisyona getirdiğine göre, bana pek çok farklı şey yapabilirsin."

# game/Scenes/Tammy/tammy3.rpy:84
translate turkish tammy3_e35118d4:

    # tm "Right now, you're in what we call closed guard."
    tm "Şu anda, bizim \"kapalı gard\" dediğimiz pozisyondasın."

# game/Scenes/Tammy/tammy3.rpy:85
translate turkish tammy3_14f2bacf:

    # tm "You could pass into a half-guard, or even a full mount."
    tm "Yarım gard pozisyonuna geçebilirsin, hatta tam üst pozisyonuna bile."

# game/Scenes/Tammy/tammy3.rpy:86
translate turkish tammy3_4b84023a:

    # tm "You could go for a leg-hold. Or you could just stand up and go back to trading blows."
    tm "Bacak tutuşu yapabilirsin. Ya da sadece ayağa kalkıp tekrar yumruklaşmaya devam edebilirsin."

# game/Scenes/Tammy/tammy3.rpy:88
translate turkish tammy3_9e4a79ed:

    # tm "Oh yeah?"
    tm "Öyle mi?"

# game/Scenes/Tammy/tammy3.rpy:89
translate turkish tammy3_ecca25fc:

    # tm "I think I can guess what you're thinking about."
    tm "Sanırım ne düşündüğünü tahmin edebiliyorum."

# game/Scenes/Tammy/tammy3.rpy:90
translate turkish tammy3_ba505d9b:

    # tm "You're really going to have to start wearing a cup when we do this."
    tm "Bunu yaparken gerçekten bir koruyucu takmaya başlaman gerekecek."

# game/Scenes/Tammy/tammy3.rpy:91
translate turkish tammy3_ef242433:

    # tm "I can see pretty much your whole thing flopping around there."
    tm "Orada her şeyin sallanıp durduğunu gayet iyi görebiliyorum."

# game/Scenes/Tammy/tammy3.rpy:92
translate turkish tammy3_b2395364:

    # pc "Sorry."
    pc "Üzgünüm."

# game/Scenes/Tammy/tammy3.rpy:93
translate turkish tammy3_532ec656:

    # tm "Nah, it's alright."
    tm "Hayır, sorun değil."

# game/Scenes/Tammy/tammy3.rpy:94
translate turkish tammy3_54238a64:

    # tm "Okay, let me up."
    tm "Tamam, bırak da kalkayım."

# game/Scenes/Tammy/tammy3.rpy:98
translate turkish tammy3_742a8c61:

    # tm "You did good today. We'll keep practicing and teach you more grappling and you'll get even better."
    tm "Bugün iyi iş çıkardın. Antrenmanlara devam edip sana daha fazla grappling öğreteceğiz, böylece daha da iyi olacaksın."

# game/Scenes/Tammy/tammy3.rpy:101
translate turkish tammy3_00868774:

    # tm "You're welcome."
    tm "Rica ederim."

# game/Scenes/Tammy/tammy3.rpy:104
translate turkish tammy3_6ce6700e:

    # tm "I had fun too. Any time you want to roll around, you just let me know."
    tm "Ben de eğlendim. Ne zaman güreşmek istersen, bana haber ver."

# game/Scenes/Tammy/tammy3.rpy:105
translate turkish tammy3_5bc44b07:

    # pc "I will."
    pc "Veririm."

# game/Scenes/Tammy/tammy3.rpy:106
translate turkish tammy3_efc77bf1:

    # tm "Alright, well I'm going to wash up and head out."
    tm "Tamam, ben gidip duş alıp çıkacağım."

# game/Scenes/Tammy/tammy3.rpy:107
translate turkish tammy3_63a1cf3a:

    # tm "I'll see you next time, [pcname]."
    tm "Bir dahaki sefere görüşürüz, [pcname]."

# game/Scenes/Tammy/tammy3.rpy:108
translate turkish tammy3_67f3ea81:

    # pc "Okay. Bye, Tammy."
    pc "Tamam. Hoşça kal, Tammy."

# game/Scenes/Tammy/tammy3.rpy:109
translate turkish tammy3_15a8a240:

    # "With that, I go to the showers and clean up, then leave the gym."
    "Bunun üzerine duşa girip temizleniyorum, sonra spor salonundan çıkıyorum."

