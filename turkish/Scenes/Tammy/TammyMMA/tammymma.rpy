# game/Scenes/Tammy/TammyMMA/tammymma.rpy:17
translate turkish tammymmanormal_55eb3e45:

    # tm "All right! I'm glad you came. Let's get to business."
    tm "Tamam! Geldiğine sevindim. İşe koyulalım."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:18
translate turkish tammymmanormal_095f6c6f:

    # tm "We're going to start with some stand-up. Get you started on the base punching and kicking technique."
    tm "Stand-up ile başlayacağız. Temel yumruk ve tekme tekniklerine giriş yapacağız."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:19
translate turkish tammymmanormal_bccaba74:

    # pc "You're going to punch me, aren't you?"
    pc "Bana yumruk atacaksın, değil mi?"

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:21
translate turkish tammymmanormal_e526c3d8:

    # tm "Oh definitely."
    tm "Oh, kesinlikle."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:23
translate turkish tammymmanormal_98c55581:

    # "I get up into the ring with Tammy and she demonstrates punching."
    "Tammy ile ringe çıkıyorum ve o bana yumruk atmayı gösteriyor."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:24
translate turkish tammymmanormal_65f9479a:

    # "I try to block, but I just don't have the motions down yet."
    "Engellemeye çalışıyorum, ama hareketleri henüz tam olarak kavrayamadım."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:26
translate turkish tammymmanormal_295f5a57:

    # "And kicking."
    "Ve tekme."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:27
translate turkish tammymmanormal_70863c7f:

    # "It hurts, but I can tell she's not going full-strength."
    "Acıtıyor, ama tam güçle vurmadığını anlayabiliyorum."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:29
translate turkish tammymmanormal_8aa64221:

    # "Then she gives me a chance to try to hit her."
    "Sonra bana ona vurmayı denemem için bir şans veriyor."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:30
translate turkish tammymmanormal_90068145:

    # "But she blocks every punch I throw."
    "Ama attığım her yumruğu engelliyor."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:32
translate turkish tammymmanormal_dd5027d0:

    # tm "Focus on technique. Don't worry about actually hitting me, just make sure that your movements are correct."
    tm "Tekniğe odaklan. Beni gerçekten vurup vurmadığını dert etme, sadece hareketlerinin doğru olduğundan emin ol."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:35
translate turkish tammymmanormal_bfe308ae:

    # "Tammy and I spar in the ring for a while."
    "Tammy ve ben ringde bir süre sparring yapıyoruz."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:39
translate turkish tammymmanormal_0bc42d9a:

    # tm "You did good for a first session."
    tm "İlk seans için iyi idare ettin."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:42
translate turkish tammymmanormal_a242518d:

    # tm "Good job. Keep training with me and you'll be a fighting machine in no time."
    tm "Aferin. Benimle antrenman yapmaya devam edersen, çok geçmeden bir dövüş makinesi olacaksın."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:45
translate turkish tammymmanormal_cc85c375:

    # "Now I need to hurry and get to school."
    "Şimdi acele edip okula gitmem lazım."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:48
translate turkish tammymmanormal_7844d429:

    # tm "Want to hit the showers with me?"
    tm "Benimle duşa girmek ister misin?"

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:52
translate turkish tammymmanormal_f7e04aed:

    # "I feel sore and tired, but it was fun and I did learn a lot."
    "Vücudum ağrıyor ve yorgunum, ama eğlenceliydi ve çok şey öğrendim."

# game/Scenes/Tammy/TammyMMA/tammymma.rpy:53
translate turkish tammymmanormal_37ff6d3e:

    # "We say our goodbyes and go our separate ways."
    "Vedalaşıp ayrılıyoruz."

