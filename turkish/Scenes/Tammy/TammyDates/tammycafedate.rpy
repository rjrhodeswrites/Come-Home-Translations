# game/Scenes/Tammy/TammyDates/tammycafedate.rpy:10
translate turkish tammycafedate_761abafa:

    # "A little while later, we leave together and drive over to Skyhill Cafe."
    "Bir süre sonra birlikte çıkıp Skyhill Cafe’ye gidiyoruz."

# game/Scenes/Tammy/TammyDates/tammycafedate.rpy:23
translate turkish tammycafestartdate_34cf15cf:

    # "We order coffee and sit at the table and chat."
    "Kahve sipariş edip masaya oturup sohbet ediyoruz."

# game/Scenes/Tammy/TammyDates/tammycafedate.rpy:27
translate turkish tammycafestartdate_3bd70c3d:

    # tm "I like this place. The coffee isn't quite as good as what we make, but the atmosphere is a little more upbeat, you know?"
    tm "Burası hoşuma gidiyor. Kahve bizim yaptığımız kadar iyi değil ama atmosfer biraz daha neşeli, anlarsın ya?"

# game/Scenes/Tammy/TammyDates/tammycafedate.rpy:28
translate turkish tammycafestartdate_d957fd81:

    # tm "I guess just because there's so many college kids that hang out here."
    tm "Sanırım burada takılan çok fazla üniversiteli olduğu için."

# game/Scenes/Tammy/TammyDates/tammycafedate.rpy:29
translate turkish tammycafestartdate_cfe5cfd9:

    # tm "Java Lava is all business people. People getting their coffee on the way to work or something."
    tm "Java Lava’da ise hep iş adamları var. İşe giderken falan kahve alan insanlar."

# game/Scenes/Tammy/TammyDates/tammycafedate.rpy:35
translate turkish tammycafestartdate_d91a9226:

    # "We sit and chat and drink our coffee."
    "Oturup sohbet ediyor ve kahvemizi içiyoruz."

# game/Scenes/Tammy/TammyDates/tammycafedate.rpy:37
translate turkish tammycafestartdate_c45a6676:

    # tm "This was nice."
    tm "Bu çok hoştu."

# game/Scenes/Tammy/TammyDates/tammycafedate.rpy:40
translate turkish tammycafestartdate_08d5d909:

    # tm "I feel like I need quiet time like this every once in a while, you know?"
    tm "Arada bir böyle sessiz zamanlara ihtiyacım olduğunu hissediyorum, anlarsın ya?"

# game/Scenes/Tammy/TammyDates/tammycafedate.rpy:42
translate turkish tammycafestartdate_067f3278:

    # tm "Feels like I'm so busy all the time."
    tm "Sanki sürekli çok meşgulüm gibi geliyor."

# game/Scenes/Tammy/TammyDates/tammycafedate.rpy:43
translate turkish tammycafestartdate_6bfbd889:

    # pc "Well, any time you want to just take a break and chill with somebody, I'm here for you."
    pc "Neyse, ne zaman bir mola verip biriyle takılmak istersen, ben buradayım."

# game/Scenes/Tammy/TammyDates/tammycafedate.rpy:45
translate turkish tammycafestartdate_61b43eaf:

    # tm "Thanks, [pcname]."
    tm "Teşekkürler, [pcname]."

# game/Scenes/Tammy/TammyDates/tammycafedate.rpy:46
translate turkish tammycafestartdate_94e049d1:

    # tm "Looks like they're going to close up soon. I guess we better take off."
    tm "Görünüşe göre yakında kapanacaklar. Sanırım gitsen iyi olur."

# game/Scenes/Tammy/TammyDates/tammycafedate.rpy:51
translate turkish tammycafestartdate_4dfe2e92:

    # tm "How about you take me home now and we see if Suzy is up for some fun?"
    tm "Şimdi beni eve götürsen ve Suzy'nin biraz eğlenmeye ne dersin?"

# game/Scenes/Tammy/TammyDates/tammycafedate.rpy:56
translate turkish tammycafestartdate_52151c73:

