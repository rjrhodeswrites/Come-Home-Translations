# TODO: Translation updated at 2026-08-03 12:42

# game/Scenes/Tammy/tammy5.rpy:23
translate turkish tammy5_8fc5eaa3:

    # tm "Hey, [pcname]. I was hoping that you would show up today."
    tm "Hey, [pcname]. Bugün gelmeni umuyordum."

# game/Scenes/Tammy/tammy5.rpy:24
translate turkish tammy5_0a01ae52:

    # tm "I have a favor to ask you."
    tm "Senden bir ricam var."

# game/Scenes/Tammy/tammy5.rpy:25
translate turkish tammy5_1c87ad9d:

    # tm "If you have time this week, could you put in a little extra hours and help me train?"
    tm "Bu hafta vaktin varsa, biraz fazla mesai yapıp antrenmanımda bana yardım edebilir misin?"

# game/Scenes/Tammy/tammy5.rpy:26
translate turkish tammy5_2a86d305:

    # tm "I have a fight one week from today and I feel like I need some extra sparring to get into the right rhythm and mindset, you know?"
    tm "Bir hafta sonra bir dövüşüm var ve doğru ritmi ve zihniyete girebilmek için biraz daha sparring yapmam gerektiğini hissediyorum, anlarsın ya?"

# game/Scenes/Tammy/tammy5.rpy:27
translate turkish tammy5_6290e18b:

    # tm "I even took evenings off from Java Lava, so I can spend more time up here."
    tm "Hatta burada daha fazla zaman geçirebilmek için Java Lava’daki akşam vardiyalarımı bile bıraktım."

# game/Scenes/Tammy/tammy5.rpy:28
translate turkish tammy5_73b1ac92:

    # tm "You good with helping me spar?"
    tm "Sparring yapmama yardım eder misin?"

# game/Scenes/Tammy/tammy5.rpy:32
translate turkish tammy5_4f9b80dd:

    # tm "That's what I like to hear!"
    tm "İşte duymak istediğim de bu!"

# game/Scenes/Tammy/tammy5.rpy:33
translate turkish tammy5_2425bb2b:

    # tm "Now get your fine ass up in that ring so I can kick it."
    tm "Hadi şimdi o güzel kıçını ringe çıkar da tekmeleyebileyim."

# game/Scenes/Tammy/tammy5.rpy:36
translate turkish tammy5_0fc31211:

    # tm "Great, let's get started then."
    tm "Harika, o zaman başlayalım."

# game/Scenes/Tammy/tammy5.rpy:39
translate turkish tammy5_669580a7:

    # tm "I mean, yeah. It is a lot of work."
    tm "Yani, evet. Çok yorucu bir iş."

# game/Scenes/Tammy/tammy5.rpy:40
translate turkish tammy5_265faf02:

    # tm "That's kind of the point though. That's why they call it \"working\" out."
    tm "Ama asıl mesele de bu zaten. Bu yüzden buna “antrenman” diyorlar."

# game/Scenes/Tammy/tammy5.rpy:41
translate turkish tammy5_1135a251:

    # tm "Anyway, if you're not into it, that's fine. I'll be here though if you want to help."
    tm "Her neyse, eğer ilgilenmiyorsan sorun değil. Ama yardım etmek istersen ben buradayım."

# game/Scenes/Tammy/tammy5.rpy:48
translate turkish tammyspar0_90680151:

    # "We get into the ring and train hard for three hours straight."
    "Ring'e çıkıp üç saat boyunca aralıksız sıkı antrenman yapıyoruz."

# game/Scenes/Tammy/tammy5.rpy:49
translate turkish tammyspar0_832dc317:

    # "We practice different positions, practice stand up fighting and movements."
    "Farklı pozisyonlar, ayakta dövüş ve hareketler üzerinde çalışıyoruz."

# game/Scenes/Tammy/tammy5.rpy:52
translate turkish tammyspar0_4d620108:

    # "Until finally, we stop and collapse onto the mat in exhaustion."
    "Ta ki sonunda durup yorgunluktan matın üzerine yığılana kadar."

# game/Scenes/Tammy/tammy5.rpy:53
translate turkish tammyspar0_535745d5:

    # tm "I think that's enough for now."
    tm "Sanırım şimdilik bu kadar yeter."

# game/Scenes/Tammy/tammy5.rpy:54
translate turkish tammyspar0_cb9c08ec:

    # pc "Yeah, I don't know how many more punches I could take."
    pc "Evet, daha kaç yumruk daha alabilirim bilmiyorum."

# game/Scenes/Tammy/tammy5.rpy:55
translate turkish tammyspar0_67943849:

    # tm "Aw, you're fine."
    tm "Ah, bir şeyin yok."

# game/Scenes/Tammy/tammy5.rpy:56
translate turkish tammyspar0_22fdacf8:

    # tm "Thanks for sparring with me though. I felt like it really helped."
    tm "Yine de benimle antrenman yaptığın için teşekkürler. Gerçekten çok faydası oldu gibi hissettim."

# game/Scenes/Tammy/tammy5.rpy:57
translate turkish tammyspar0_0e1da4af:

    # pc "You think you're ready?"
    pc "Hazır olduğunu mu düşünüyorsun?"

# game/Scenes/Tammy/tammy5.rpy:58
translate turkish tammyspar0_e746934f:

    # tm "No, not at all. I need a couple more sessions like this."
    tm "Hayır, hiç de değil. Bunun gibi birkaç seansa daha ihtiyacım var."

# game/Scenes/Tammy/tammy5.rpy:59
translate turkish tammyspar0_62a75dd2:

    # tm "Think you could come back sometime during the week to spar more? I'll be here in the evening."
    tm "Hafta içinde bir ara gelip biraz daha antrenman yapabilir misin? Akşamları burada olacağım."

# game/Scenes/Tammy/tammy5.rpy:60
translate turkish tammyspar0_61f77a4c:

    # pc "Sure."
    pc "Tabii."

# game/Scenes/Tammy/tammy5.rpy:61
translate turkish tammyspar0_56e3b38a:

    # tm "Also, I'd love to have you in my corner during the fight."
    tm "Ayrıca, kavga sırasında senin de benim tarafımda olmanı çok isterim."

# game/Scenes/Tammy/tammy5.rpy:62
translate turkish tammyspar0_d48d741a:

    # pc "I could do that."
    pc "Bunu yapabilirim."

# game/Scenes/Tammy/tammy5.rpy:63
translate turkish tammyspar0_2c10d237:

    # tm "You're kind of good at this stuff you know. You could fight too if you wanted."
    tm "Bu işlerde epey iyisin, biliyor musun? İstersen sen de kavga edebilirsin."

# game/Scenes/Tammy/tammy5.rpy:64
translate turkish tammyspar0_97747303:

    # pc "I'm more of a lover."
    pc "Ben daha çok sevgi dolu biriyim."

# game/Scenes/Tammy/tammy5.rpy:65
translate turkish tammyspar0_7c210bb3:

    # tm "Oh is that right?"
    tm "Öyle mi?"

# game/Scenes/Tammy/tammy5.rpy:66
translate turkish tammyspar0_1fcc5232:

    # tm "Well, you better hit the showers, lover-boy."
    tm "Pekala, duşa gitsen iyi olur, aşkım."

# game/Scenes/Tammy/tammy5.rpy:67
translate turkish tammyspar0_efb5c0de:

    # tm "I'm going to clean up and head home. I'm so tired."
    tm "Temizlenip eve gideceğim. Çok yorgunum."

# game/Scenes/Tammy/tammy5.rpy:68
translate turkish tammyspar0_f91621b1:

    # tm "Thanks again. It was fun."
    tm "Tekrar teşekkürler. Eğlenceliydi."

# game/Scenes/Tammy/tammy5.rpy:71
translate turkish tammyspar0_8dc2f452:

    # "She grabs her things and heads to the ladies' showers, while I head to the men's showers."
    "O eşyalarını toplayıp kadınlar duşuna giderken, ben de erkekler duşuna gidiyorum."

# game/Scenes/Tammy/tammy5.rpy:72
translate turkish tammyspar0_7d804453:

    # "By the time I'm done, she's already gone."
    "Ben işimi bitirdiğimde, o çoktan gitmiş."

# game/Scenes/Tammy/tammy5.rpy:73
translate turkish tammyspar0_37a6f478:

    # "It was a fun sparring session though. I'll have to come back and help her spar more before her fight."
    "Yine de eğlenceli bir antrenman seansıydı. Maçından önce gelip ona daha fazla antrenman yapmasına yardım etmeliyim."

# game/Scenes/Tammy/tammy5.rpy:79
translate turkish tammyspar0_cc85c375:

    # "Now I need to hurry and get to school."
    "Şimdi acele edip okula gitmem lazım."

# game/Scenes/Tammy/tammy5.rpy:87
translate turkish tammyspar0_08c4d45a:

    # tm "Did you change your mind? Going to help me train?"
    tm "Fikrini mi değiştirdin? Antrenmanıma yardım edecek misin?"

# game/Scenes/Tammy/tammy5.rpy:90
translate turkish tammyspar0_72f2c360:

    # tm "I'm glad. Alright, get in the ring so I can beat you up."
    tm "Sevindim. Tamam, ringe çık da seni döveyim."

# game/Scenes/Tammy/tammy5.rpy:94
translate turkish tammyspar0_8399f090:

    # tm "Then why are you bothering me? I have to train."
    tm "O zaman neden beni rahatsız ediyorsun? Antrenman yapmam lazım."

# game/Scenes/Tammy/tammy5.rpy:103
translate turkish tammyspar1_6f0ed0c2:

    # tm "Hey, [pcname]. Ready to help me train?"
    tm "Hey, [pcname]. Antrenmanıma yardım etmeye hazır mısın?"

# game/Scenes/Tammy/tammy5.rpy:104
translate turkish tammyspar1_f420071e:

    # pc "Yeah, let's do this."
    pc "Evet, hadi yapalım şunu."

# game/Scenes/Tammy/tammy5.rpy:107
translate turkish tammyspar1_7329cae6:

    # "We get into the ring and train hard for a couple of hours."
    "Ring'e çıkıp birkaç saat boyunca sıkı antrenman yapıyoruz."

# game/Scenes/Tammy/tammy5.rpy:108
translate turkish tammyspar1_91f2a02c:

    # "She holds back on her punches and kicks, but man after a few hundred of them they really start to hurt."
    "Yumruklarını ve tekmelerini hafifletiyor ama birkaç yüz taneden sonra gerçekten acıtmaya başlıyorlar."

# game/Scenes/Tammy/tammy5.rpy:109
translate turkish tammyspar1_cc658c83:

    # "We practice all of the movements, holds, and attacks that she wants to focus on for the fight."
    "Maçta odaklanmak istediği tüm hareketleri, tutuşları ve saldırıları çalışıyoruz."

# game/Scenes/Tammy/tammy5.rpy:112
translate turkish tammyspar1_3589480a:

    # "And by the end, we are lying in puddles of our own sweat on the mat."
    "Ve sonunda, matın üzerinde kendi terimizden oluşan su birikintilerinin içinde yatıyoruz."

# game/Scenes/Tammy/tammy5.rpy:113
translate turkish tammyspar1_5031ce49:

    # pc "My everything hurts."
    pc "Her yerim ağrıyor."

# game/Scenes/Tammy/tammy5.rpy:114
translate turkish tammyspar1_65be1fb3:

    # tm "Good. That's how I want my opponent to feel."
    tm "Güzel. Rakibimin de böyle hissetmesini istiyorum."

# game/Scenes/Tammy/tammy5.rpy:115
translate turkish tammyspar1_209b5ba6:

    # pc "You feeling good about the fight now?"
    pc "Maç konusunda şimdi kendini iyi hissediyor musun?"

# game/Scenes/Tammy/tammy5.rpy:116
translate turkish tammyspar1_a82bf39b:

    # tm "Better for sure. I feel like I'm almost in the zone."
    tm "Kesinlikle daha iyi. Neredeyse \"zone\" moduna girmiş gibi hissediyorum."

# game/Scenes/Tammy/tammy5.rpy:117
translate turkish tammyspar1_3b41957d:

    # tm "One more sparring session should do it."
    tm "Bir sparring seansı daha yeterli olmalı."

# game/Scenes/Tammy/tammy5.rpy:118
translate turkish tammyspar1_de22b3bd:

    # tm "You up for it?"
    tm "Hazır mısın?"

# game/Scenes/Tammy/tammy5.rpy:119
translate turkish tammyspar1_c4a56d2f:

    # pc "My heart is willing, but my body is bruised."
    pc "Kalbim istekli ama vücudum morarmış durumda."

# game/Scenes/Tammy/tammy5.rpy:120
translate turkish tammyspar1_e5162b79:

    # tm "Aw, you'll be okay."
    tm "Ah, bir şey olmaz."

# game/Scenes/Tammy/tammy5.rpy:121
translate turkish tammyspar1_45351dd0:

    # tm "Might be something good in it for you too."
    tm "Belki senin için de iyi bir şey çıkar."

# game/Scenes/Tammy/tammy5.rpy:122
translate turkish tammyspar1_ae871f39:

    # pc "Oh yeah?"
    pc "Öyle mi?"

# game/Scenes/Tammy/tammy5.rpy:123
translate turkish tammyspar1_3aaffb9d:

    # tm "After the fight, I could see some good things going your way."
    tm "Maçtan sonra, senin için iyi şeyler olacağını görebiliyorum."

# game/Scenes/Tammy/tammy5.rpy:124
translate turkish tammyspar1_d93e675a:

    # tm "Assuming I win of course."
    tm "Tabii ki kazanırsam."

# game/Scenes/Tammy/tammy5.rpy:125
translate turkish tammyspar1_6d5412f5:

    # pc "You'll win. You're a great fighter."
    pc "Kazanacaksın. Harika bir dövüşçüsün."

# game/Scenes/Tammy/tammy5.rpy:126
translate turkish tammyspar1_ade4dc1d:

    # tm "Thanks."
    tm "Teşekkürler."

# game/Scenes/Tammy/tammy5.rpy:127
translate turkish tammyspar1_7c0189e9:

    # tm "I'm going to go clean up. I'll see you next time."
    tm "Gidip temizleneceğim. Bir dahaki sefere görüşürüz."

# game/Scenes/Tammy/tammy5.rpy:128
translate turkish tammyspar1_e08706c1:

    # pc "Alright. Bye, Tammy."
    pc "Tamam. Hoşça kal, Tammy."

# game/Scenes/Tammy/tammy5.rpy:131
translate turkish tammyspar1_9ae56f74:

    # "She goes to the showers. I clean up too and then leave the gym for the day."
    "O duşlara gidiyor. Ben de temizlenip spor salonundan ayrılıyorum."

# game/Scenes/Tammy/tammy5.rpy:137
translate turkish tammyspar1_cc85c375:

    # "Now I need to hurry and get to school."
    "Şimdi acele edip okula gitmem lazım."

# game/Scenes/Tammy/tammy5.rpy:149
translate turkish tammyspar2_6f0ed0c2:

    # tm "Hey, [pcname]. Ready to help me train?"
    tm "Hey, [pcname]. Antrenmanımda bana yardım etmeye hazır mısın?"

# game/Scenes/Tammy/tammy5.rpy:150
translate turkish tammyspar2_c640c08c:

    # pc "I'm still sore from last time, but sure."
    pc "Geçen seferden beri hâlâ ağrım var ama tabii ki."

# game/Scenes/Tammy/tammy5.rpy:152
translate turkish tammyspar2_d4e6c2a5:

    # tm "Aw, look at you, toughing it out for me."
    tm "Ah, şuna bak, benim için dişini sıkıyorsun."

# game/Scenes/Tammy/tammy5.rpy:153
translate turkish tammyspar2_48881b94:

    # pc "I want you to win this thing. Especially if I'm going to be in your corner."
    pc "Bu maçı kazanmanı istiyorum. Özellikle de ben köşende olacaksam."

# game/Scenes/Tammy/tammy5.rpy:154
translate turkish tammyspar2_bfe1fd8b:

    # tm "Then let's get training. I want to win this thing too."
    tm "O zaman antrenmana başlayalım. Ben de bu maçı kazanmak istiyorum."

# game/Scenes/Tammy/tammy5.rpy:156
translate turkish tammyspar2_374feca3:

    # "We go over everything one more time, working even harder than the previous sessions."
    "Her şeyi bir kez daha gözden geçiriyoruz, önceki seanslardan bile daha sıkı çalışıyoruz."

# game/Scenes/Tammy/tammy5.rpy:157
translate turkish tammyspar2_20006225:

    # "By the end, Tammy is moving like a machine, every dodge and punch, every grappling movement, all just instinct and muscle memory."
    "Sonunda Tammy bir makine gibi hareket ediyor; her kaçış ve yumruk, her güreş hareketi, hepsi sadece içgüdü ve kas hafızasıyla oluyor."

# game/Scenes/Tammy/tammy5.rpy:159
translate turkish tammyspar2_4e4c5a23:

    # "Until finally, we can't take any more and we collapse together onto the mat."
    "Ta ki sonunda daha fazla dayanamayana kadar ve ikimiz de matın üzerine yığılana kadar."

# game/Scenes/Tammy/tammy5.rpy:160
translate turkish tammyspar2_a068ca78:

    # tm "I feel really good about this fight now."
    tm "Artık bu maç hakkında gerçekten iyi hissediyorum."

# game/Scenes/Tammy/tammy5.rpy:161
translate turkish tammyspar2_51b8a4f7:

    # tm "Thanks for all the training. You've been a huge help."
    tm "Tüm antrenmanlar için teşekkürler. Bana çok yardımcı oldun."

# game/Scenes/Tammy/tammy5.rpy:162
translate turkish tammyspar2_c46a0b54:

    # pc "Any time."
    pc "Ne zaman istersen."

# game/Scenes/Tammy/tammy5.rpy:163
translate turkish tammyspar2_60bd297a:

    # pc "Actually, I take that back. I'm going to need a little while to recuperate from this."
    pc "Aslında, sözümü geri alıyorum. Bundan sonra toparlanmak için biraz zamana ihtiyacım olacak."

# game/Scenes/Tammy/tammy5.rpy:164
translate turkish tammyspar2_310e49e5:

    # tm "Ha!"
    tm "Ha!"

# game/Scenes/Tammy/tammy5.rpy:165
translate turkish tammyspar2_0fdae2e9:

    # tm "Well the fight is coming up."
    tm "Maç yaklaşıyor."

# game/Scenes/Tammy/tammy5.rpy:166
translate turkish tammyspar2_8f754bdf:

    # pc "I'll be there in your corner."
    pc "Köşende olacağım."

# game/Scenes/Tammy/tammy5.rpy:167
translate turkish tammyspar2_29a4fcc0:

    # tm "Good. I want you to have a front-row seat to me kicking this chick's ass."
    tm "Güzel. Bu kızın canına okuduğumu en ön sıradan izlemeni istiyorum."

# game/Scenes/Tammy/tammy5.rpy:168
translate turkish tammyspar2_a2038558:

    # pc "I wouldn't miss it."
    pc "Kaçırmam."

# game/Scenes/Tammy/tammy5.rpy:169
translate turkish tammyspar2_e296303f:

    # tm "Thanks again, [pcname]. You're the best."
    tm "Tekrar teşekkürler, [pcname]. Sen en iyisisin."

# game/Scenes/Tammy/tammy5.rpy:170
translate turkish tammyspar2_4cac4a98:

    # tm "And I'll be sure to pay you back somehow after the fight."
    tm "Ve dövüşten sonra sana bir şekilde borcumu ödeyeceğim."

# game/Scenes/Tammy/tammy5.rpy:171
translate turkish tammyspar2_6dcf86da:

    # pc "Can't wait."
    pc "Sabırsızlanıyorum."

# game/Scenes/Tammy/tammy5.rpy:172
translate turkish tammyspar2_65346d04:

    # tm "Alright, I'm going to head out."
    tm "Tamam, ben çıkıyorum."

# game/Scenes/Tammy/tammy5.rpy:173
translate turkish tammyspar2_1523472a:

    # pc "Me too. See ya Tammy."
    pc "Ben de. Görüşürüz Tammy."

# game/Scenes/Tammy/tammy5.rpy:174
translate turkish tammyspar2_6471f1e5:

    # tm "Bye, [pcname]."
    tm "Hoşça kal, [pcname]."

# game/Scenes/Tammy/tammy5.rpy:176
translate turkish tammyspar2_a23552f4:

    # "We get cleaned up and then leave the gym."
    "Duş alıp spor salonundan çıkıyoruz."

# game/Scenes/Tammy/tammy5.rpy:177
translate turkish tammyspar2_89763f7f:

    # "Tammy's fight is coming up this weekend. I can't wait to see her win this thing."
    "Tammy'nin dövüşü bu hafta sonu. Onun kazanmasını görmek için sabırsızlanıyorum."

# game/Scenes/Tammy/tammy5.rpy:183
translate turkish tammyspar2_cc85c375:

    # "Now I need to hurry and get to school."
    "Şimdi acele edip okula gitmem lazım."

