# game/Scenes/Tammy/tammy6.rpy:30
translate turkish tammy6_63345545:

    # "Tonight is Tammy's fight. I better head over to the gym."
    "Bu gece Tammy'nin maçı var. Spor salonuna gitsem iyi olacak."

# game/Scenes/Tammy/tammy6.rpy:34
translate turkish tammy6_b1905243:

    # "The place is crowded when I walk in. More people than I've ever seen here."
    "İçeri girdiğimde salon tıklım tıklımdı. Burada daha önce hiç bu kadar insan görmemiştim."

# game/Scenes/Tammy/tammy6.rpy:35
translate turkish tammy6_39c74365:

    # "Tammy spots me almost immediately and walks up to me."
    "Tammy beni hemen fark etti ve yanıma geldi."

# game/Scenes/Tammy/tammy6.rpy:37
translate turkish tammy6_d0eb5014:

    # tm "You made it! Good, I was worried you weren't coming."
    tm "Gelmişsin! İyi ki, gelmeyeceğinden endişelenmiştim."

# game/Scenes/Tammy/tammy6.rpy:38
translate turkish tammy6_9d3f76f5:

    # pc "I told you I wouldn't miss it."
    pc "Kaçırmayacağımı söylemiştim."

# game/Scenes/Tammy/tammy6.rpy:39
translate turkish tammy6_e9f9fafe:

    # pc "Got to see my girl kick some ass."
    pc "Kızımın rakibini fena halde pataklamasını izlemem lazım."

# game/Scenes/Tammy/tammy6.rpy:41
translate turkish tammy6_b3d3b98d:

    # tm "I'm your girl?"
    tm "Ben senin kızın mıyım?"

# game/Scenes/Tammy/tammy6.rpy:45
translate turkish tammy6_28ee4347:

    # tm "I like that."
    tm "Bu hoşuma gitti."

# game/Scenes/Tammy/tammy6.rpy:47
translate turkish tammy6_d7451422:

    # tm "Alright then, come watch your girl beat up this other chick."
    tm "Tamam o zaman, gel de kızının şu diğer kızı pataklamasını izle."

# game/Scenes/Tammy/tammy6.rpy:50
translate turkish tammy6_010b3b6b:

    # tm "I knew it! You're such a slut."
    tm "Biliyordum! Tam bir sürtüksün."

# game/Scenes/Tammy/tammy6.rpy:51
translate turkish tammy6_5805f097:

    # tm "Alright then, let's go. Time to beat this chick up."
    tm "Tamam o zaman, gidelim. Bu kızı pataklama zamanı."

# game/Scenes/Tammy/tammy6.rpy:54
translate turkish tammy6_9f0b363f:

    # tm "Oh, right."
    tm "Ah, tabii."

# game/Scenes/Tammy/tammy6.rpy:55
translate turkish tammy6_17a053a9:

    # tm "I thought you meant something else."
    tm "Başka bir şey demek istediğini sanmıştım."

# game/Scenes/Tammy/tammy6.rpy:57
translate turkish tammy6_4b9a047c:

    # tm "Alright, let's go. Time to beat this chick up."
    tm "Tamam, gidelim. Bu kızı pataklama zamanı."

# game/Scenes/Tammy/tammy6.rpy:61
translate turkish tammy6_3ebb793a:

    # "We walk over to her corner and look over at her opponent."
    "Onun köşesine doğru yürüyoruz ve rakibine bakıyoruz."

# game/Scenes/Tammy/tammy6.rpy:62
translate turkish tammy6_601d23fa:

    # "She's taller than Tammy and bulkier and definitely looks like she's been in a few fights."
    "Tammy'den daha uzun ve daha iri; kesinlikle birkaç kavgaya karışmış gibi görünüyor."

# game/Scenes/Tammy/tammy6.rpy:63
translate turkish tammy6_09dc05cf:

    # pc "Are you two even in the same weight class?"
    pc "İkiniz aynı sıklet sınıfında mısınız ki?"

# game/Scenes/Tammy/tammy6.rpy:64
translate turkish tammy6_2e9991a8:

    # tm "Weight class? Hah, listen to you."
    tm "Sıklet sınıfı mı? Hah, şuna bak."

# game/Scenes/Tammy/tammy6.rpy:65
translate turkish tammy6_cb74d3bb:

    # tm "This isn't the UFC. She outweighs me by like 25 pounds. Doesn't mean I'm not going to whip her ass though."
    tm "Burası UFC değil ki. Benden yaklaşık 25 pound daha ağır. Ama bu onu fena halde pataklamayacağım anlamına gelmez."

# game/Scenes/Tammy/tammy6.rpy:66
translate turkish tammy6_af8d612f:

    # tm "You outweigh me too, but I could choke you out in ten seconds."
    tm "Sen de benden ağırsın, ama seni on saniyede boğazlayabilirim."

# game/Scenes/Tammy/tammy6.rpy:67
translate turkish tammy6_4d3dfadb:

    # pc "You got me there."
    pc "Bu konuda haklısın."

# game/Scenes/Tammy/tammy6.rpy:68
translate turkish tammy6_836f375c:

    # tm "It's all about technique baby. I got this."
    tm "Her şey teknikle ilgili bebeğim. Hallederim."

# game/Scenes/Tammy/tammy6.rpy:69
translate turkish tammy6_65c40087:

    # pc "Yeah you do. Take her down."
    pc "Evet, halledersin. Onu yere indir."

# game/Scenes/Tammy/tammy6.rpy:72
translate turkish tammy6_fa4677bd:

    # "A man takes the center of the ring and calls out for everybody to be quiet as the fight is about to begin."
    "Bir adam ringin ortasına geçer ve dövüş başlamak üzereyken herkese sessiz olmasını söyler."

# game/Scenes/Tammy/tammy6.rpy:73
translate turkish tammy6_5b25dae0:

    # "Man" "Hello everybody and welcome!"
    "Man" "Herkese merhaba ve hoş geldiniz!"

# game/Scenes/Tammy/tammy6.rpy:74
translate turkish tammy6_b1a6c7f2:

    # "Chuck" "Most of you know me as Chuck Johnson, but I see a few new faces out there in the crowd that might not recognize me."
    "Chuck" "Çoğunuz beni Chuck Johnson olarak tanıyorsunuz, ama kalabalığın arasında beni tanımayabilecek birkaç yeni yüz görüyorum."

# game/Scenes/Tammy/tammy6.rpy:75
translate turkish tammy6_4cf3cb93:

    # "Chuck" "I am the owner of this gym and the organizer for Skyhill's sanctioned MMA tournaments, and I'll be serving as referee for this fight."
    "Chuck" "Bu spor salonunun sahibiyim ve Skyhill'in onaylı MMA turnuvalarının organizatörüyüm; ayrıca bu dövüşte hakemlik yapacağım."

# game/Scenes/Tammy/tammy6.rpy:76
translate turkish tammy6_ccb970c9:

    # "Chuck" "We don't have many fighters, but the ones we have are amazing."
    "Chuck" "Çok fazla dövüşçümüz yok, ama olanlar muhteşem."

# game/Scenes/Tammy/tammy6.rpy:77
translate turkish tammy6_daeb5613:

    # "Chuck" "And the two that are in the ring for you tonight are two of the best in the area."
    "Chuck" "Ve bu gece ringde karşınızda olan ikisi, bölgenin en iyilerinden ikisi."

# game/Scenes/Tammy/tammy6.rpy:78
translate turkish tammy6_1c244dcc:

    # "Chuck" "Yet this is the first time they've ever fought! We're in for a treat tonight ladies and gentlemen."
    "Chuck" "Oysa bu, ikisinin ilk kez karşı karşıya gelmesi! Bu gece bizi harika bir maç bekliyor, bayanlar ve baylar."

# game/Scenes/Tammy/tammy6.rpy:80
translate turkish tammy6_af62ead9:

    # "Chuck" "In this corner, we have one of the best fighters from my gym, standing five-foot-six-inches tall and weighing in at 125 pounds..."
    "Chuck" "Bu köşede, spor salonumun en iyi dövüşçülerinden biri var; boyu beş fit altı inç, ağırlığı 125 pound..."

# game/Scenes/Tammy/tammy6.rpy:81
translate turkish tammy6_9d0ff825:

    # "Chuck" "Tammy Zamora!"
    "Chuck" "Tammy Zamora!"

# game/Scenes/Tammy/tammy6.rpy:83
translate turkish tammy6_5671ddb8:

    # "Chuck" "And in this corner, from Anderson Sanders' gym in Whiterock, standing five-foot-nine-inches tall and weighing in at 150 pounds..."
    "Chuck" "Ve bu köşede, Whiterock’taki Anderson Sanders spor salonundan, boyu beş fit dokuz inç, ağırlığı 150 pound..."

# game/Scenes/Tammy/tammy6.rpy:84
translate turkish tammy6_5b101262:

    # "Chuck" "Sara Death!"
    "Chuck" "Sara Death!"

# game/Scenes/Tammy/tammy6.rpy:87
translate turkish tammy6_051eef13:

    # "The referee calls both the fighters over to the middle of the ring where he lays down the rules for the fight."
    "Hakem, her iki dövüşçüyü de ringin ortasına çağırır ve dövüş kurallarını açıklar."

# game/Scenes/Tammy/tammy6.rpy:88
translate turkish tammy6_fc42a57b:

    # "Chuck" "I want a nice clean fight. No eye-poking, hair pulling, nipple-twisting, or pussy-grabbing, got it?"
    "Chuck" "Temiz ve adil bir dövüş istiyorum. Gözlere parmak sokmak, saç çekmek, meme ucunu bükmek ya da vajinaya dokunmak yok, anlaşıldı mı?"

# game/Scenes/Tammy/tammy6.rpy:89
translate turkish tammy6_2b25ff3d:

    # "They both nod, then they touch gloves and return to their corners."
    "İkisi de başlarını sallar, sonra eldivenlerini tokuşturur ve köşelerine dönerler."

# game/Scenes/Tammy/tammy6.rpy:92
translate turkish tammy6_4015a27c:

    # "The referee counts down as the crowd leans forward ready for this to begin."
    "Seyirciler başlama anını bekleyerek öne doğru eğilirken hakem geri sayım yapar."

# game/Scenes/Tammy/tammy6.rpy:93
translate turkish tammy6_d40bb16a:

    # "Referee" "Three... Two.... One... FIGHT!"
    "Referee" "Üç... İki... Bir... DÖVÜŞ!"

# game/Scenes/Tammy/tammy6.rpy:95
translate turkish tammy6_235f0e0e:

    # "Tammy and Sara move towards the center of the ring and begin circling each other, jabbing to test distance, looking for openings."
    "Tammy ve Sara ringin ortasına doğru ilerler ve birbirlerinin etrafında dönmeye başlarlar; mesafeyi ölçmek için jablar atar, açıklar ararlar."

# game/Scenes/Tammy/tammy6.rpy:97
translate turkish tammy6_b47540db:

    # "Sara moves in first, throwing a series of punches that Tammy is able to dodge."
    "Sara ilk hamleyi yapar ve Tammy’nin kaçabildiği bir dizi yumruk savurur."

# game/Scenes/Tammy/tammy6.rpy:98
translate turkish tammy6_4daf0031:

    # "Each one has some power behind it, but Tammy's able to stay out of her range and keep moving out of the way just before they land."
    "Her birinin arkasında bir güç vardır, ancak Tammy onun menzilinden uzak kalmayı başarır ve yumruklar isabet etmeden hemen önce kenara çekilir."

# game/Scenes/Tammy/tammy6.rpy:102
translate turkish tammy6_e57db1fb:

    # "Then Tammy counter-attacks, landing a big punch directly in Sara's face."
    "Ardından Tammy karşı atağa geçer ve Sara’nın yüzüne doğrudan güçlü bir yumruk indirir."

# game/Scenes/Tammy/tammy6.rpy:103
translate turkish tammy6_16073005:

    # "The larger woman wobbles a bit, but stays on her feet."
    "Daha iri olan kadın biraz sallanır, ancak ayakta kalır."

# game/Scenes/Tammy/tammy6.rpy:105
translate turkish tammy6_35659495:

    # "Again Sara comes in with a flurry of punches as Tammy moves her head and body trying to dodge them all."
    "Tammy, tüm yumruklardan kaçınmaya çalışarak başını ve vücudunu hareket ettirirken, Sara yine bir yumruk yağmuruyla saldırıyor."

# game/Scenes/Tammy/tammy6.rpy:108
translate turkish tammy6_282065a5:

    # "One lands hard though, slamming into the side of Tammy's head."
    "Ancak bir yumruk sert bir şekilde isabet ediyor ve Tammy’nin başının yan tarafına çarpıyor."

# game/Scenes/Tammy/tammy6.rpy:109
translate turkish tammy6_5d999c2c:

    # "Tammy recovers quickly though. She's so tough."
    "Yine de Tammy çabucak toparlanıyor. O çok dayanıklı."

# game/Scenes/Tammy/tammy6.rpy:111
translate turkish tammy6_f503d86e:

    # "Tammy rushes in this time, putting Sara on the defense as she unleashes a series of attacks."
    "Bu sefer Tammy hücuma geçiyor ve bir dizi saldırı başlatarak Sara’yı savunmaya zorluyor."

# game/Scenes/Tammy/tammy6.rpy:113
translate turkish tammy6_ee10b215:

    # "She got a little too aggressive though, and left herself open."
    "Ancak biraz fazla agresif davrandı ve kendini savunmasız bıraktı."

# game/Scenes/Tammy/tammy6.rpy:116
translate turkish tammy6_78eff14d:

    # "Sara breaks away a bit, then spins and kicks Tammy hard in the side with a smack of skin-on-skin that echoes throughout the gym."
    "Sara biraz uzaklaşıyor, sonra dönüp Tammy’nin yan tarafına sert bir tekme atıyor; derinin deriye çarpmasıyla çıkan ses spor salonunda yankılanıyor."

# game/Scenes/Tammy/tammy6.rpy:117
translate turkish tammy6_e7d0fc5c:

    # "I know that hurt. I hope she's okay."
    "Bunun acıttığını biliyorum. Umarım iyidir."

# game/Scenes/Tammy/tammy6.rpy:119
translate turkish tammy6_892f6b25:

    # "Sara can't keep up with the defense and Tammy starts slipping some punches through."
    "Sara savunmaya yetişemiyor ve Tammy birkaç yumruk sızdırmaya başlıyor."

# game/Scenes/Tammy/tammy6.rpy:120
translate turkish tammy6_1b9b0e94:

    # "I'd seen this attack before during our sparring sessions. Tammy is waiting for Sara to duck one of her punches."
    "Bu saldırıyı daha önce antrenmanlarımızda görmüştüm. Tammy, Sara’nın yumruklarından birinden kaçmasını bekliyor."

# game/Scenes/Tammy/tammy6.rpy:123
translate turkish tammy6_0d2230f2:

    # "And as soon as she does, Tammy is ready, bringing her leg up quick, slamming her shin into the side of Sara's head."
    "Ve Sara bunu yapar yapmaz, Tammy hazırdır; bacağını hızla kaldırır ve kaval kemiğini Sara’nın başının yan tarafına sertçe vurur."

# game/Scenes/Tammy/tammy6.rpy:124
translate turkish tammy6_7646cb1e:

    # "The crowd groans in pain, but somehow Sara stays standing."
    "Seyirciler acı içinde inler, ama Sara bir şekilde ayakta kalır."

# game/Scenes/Tammy/tammy6.rpy:126
translate turkish tammy6_57d35f0a:

    # "They circle again."
    "Yine birbirlerinin etrafında dolanırlar."

# game/Scenes/Tammy/tammy6.rpy:128
translate turkish tammy6_9e44b398:

    # "Sara is looking for a way to finish this off."
    "Sara bu maçı bitirmenin bir yolunu arıyor."

# game/Scenes/Tammy/tammy6.rpy:130
translate turkish tammy6_2f27fbba:

    # "She starts another series of attacks that Tammy is barely able to block."
    "Tammy’nin zar zor engelleyebildiği bir dizi saldırıya daha başlar."

# game/Scenes/Tammy/tammy6.rpy:131
translate turkish tammy6_7b2fc7b8:

    # "But on the defensive like this Tammy isn't able to hold the larger woman back."
    "Ancak bu şekilde savunmada kalan Tammy, kendisinden daha iri olan rakibini durduramaz."

# game/Scenes/Tammy/tammy6.rpy:134
translate turkish tammy6_72f39416:

    # "And then Sara is inside her guard and able to grab her and slam her to the ground."
    "Sonra Sara, Tammy’nin gardının içine girip onu yakalıyor ve yere çarpıyor."

# game/Scenes/Tammy/tammy6.rpy:137
translate turkish tammy6_572ed5eb:

    # "It doesn't take long from there for Sara to get in top and start dropping bombs into Tammy's face."
    "Oradan sonra Sara’nın üst pozisyona geçip Tammy’nin yüzüne yumruk yağdırmaya başlaması çok uzun sürmüyor."

# game/Scenes/Tammy/tammy6.rpy:140
translate turkish tammy6_14c8ab9e:

    # "I can barely watch as Tammy's head bounces off the mat with every punch."
    "Her yumrukta Tammy’nin kafasının mindere çarpmasını izlemeye zar zor dayanabiliyorum."

# game/Scenes/Tammy/tammy6.rpy:143
translate turkish tammy6_d7aed926:

    # "Sara is relentless. She smells blood and Tammy can't hold her back at all."
    "Sara acımasız. Kan kokusunu alıyor ve Tammy onu hiç durduramıyor."

# game/Scenes/Tammy/tammy6.rpy:146
translate turkish tammy6_254afe34:

    # "Then one of her punches knocks Tammy out cold."
    "Sonra attığı yumruklardan biri Tammy’yi bayılttı."

# game/Scenes/Tammy/tammy6.rpy:147
translate turkish tammy6_86dca21f:

    # "Finally Chuck pulls her off of Tammy, who lies there motionless."
    "Sonunda Chuck, hareketsiz bir şekilde yerde yatan Tammy’nin üstünden onu çekip alıyor."

# game/Scenes/Tammy/tammy6.rpy:149
translate turkish tammy6_0e6878c3:

    # "I rush into the ring and over to where Tammy is laying."
    "Hemen ringe koşup Tammy’nin yattığı yere gidiyorum."

# game/Scenes/Tammy/tammy6.rpy:150
translate turkish tammy6_5bfc5c9c:

    # "She's already starting to come to, but she's pretty beat up."
    "Zaten kendine gelmeye başlamış, ama epey hırpalanmış durumda."

# game/Scenes/Tammy/tammy6.rpy:151
translate turkish tammy6_28b167a4:

    # tm "Did I lose?"
    tm "Kaybettim mi?"

# game/Scenes/Tammy/tammy6.rpy:152
translate turkish tammy6_e6dd1df7:

    # pc "Yeah you went out cold."
    pc "Evet, bayıldın."

# game/Scenes/Tammy/tammy6.rpy:153
translate turkish tammy6_51259234:

    # tm "Damn."
    tm "Kahretsin."

# game/Scenes/Tammy/tammy6.rpy:154
translate turkish tammy6_fa75bbc3:

    # pc "Are you okay?"
    pc "İyi misin?"

# game/Scenes/Tammy/tammy6.rpy:155
translate turkish tammy6_10f92484:

    # tm "Face hurts pretty bad, but I'm alright."
    tm "Yüzüm epey acıyor, ama iyiyim."

# game/Scenes/Tammy/tammy6.rpy:157
translate turkish tammy6_16f47c61:

    # "Tammy rises up and stands next to the ref as he raises Sara's hand and announces her the winner."
    "Tammy ayağa kalkıyor ve hakem Sara’nın elini kaldırıp onu galip ilan ederken hakemin yanına geçiyor."

# game/Scenes/Tammy/tammy6.rpy:158
translate turkish tammy6_a6c4c2eb:

    # "I know this was heartbreaking for Tammy."
    "Bunun Tammy için çok üzücü olduğunu biliyorum."

# game/Scenes/Tammy/tammy6.rpy:162
translate turkish tammy6_35b2ec02:

    # "Tammy is looking for a way to finish this off."
    "Tammy maçı bitirmenin bir yolunu arıyor."

# game/Scenes/Tammy/tammy6.rpy:164
translate turkish tammy6_9a90d6b8:

    # "After testing a few more jabs, she goes in for the take-down."
    "Birkaç jab daha denedikten sonra, takedown için harekete geçiyor."

# game/Scenes/Tammy/tammy6.rpy:166
translate turkish tammy6_d01b8451:

    # "And she gets it, slamming into Sara's legs hard and knocking her to the mat."
    "Ve başarıyor; Sara'nın bacaklarına sertçe çarpıp onu mindere deviriyor."

# game/Scenes/Tammy/tammy6.rpy:167
translate turkish tammy6_e95109c5:

    # "Tammy's on top of her in an instant."
    "Tammy bir anda üstüne çıkıyor."

# game/Scenes/Tammy/tammy6.rpy:170
translate turkish tammy6_57739c36:

    # "Then Tammy starts slamming her fists into Sara's face."
    "Sonra Tammy, yumruklarını Sara'nın yüzüne indirmeye başlıyor."

# game/Scenes/Tammy/tammy6.rpy:173
translate turkish tammy6_75418c8b:

    # "Over and over again."
    "Tekrar tekrar."

# game/Scenes/Tammy/tammy6.rpy:175
translate turkish tammy6_e7e3f662:

    # "Sara tries to break free, or at least block the punches."
    "Sara kurtulmaya ya da en azından yumrukları engellemeye çalışıyor."

# game/Scenes/Tammy/tammy6.rpy:178
translate turkish tammy6_fa4e7436:

    # "But it's too late now. Tammy's got her down and is hammering on her relentlessly."
    "Ama artık çok geç. Tammy onu yere serdi ve acımasızca yumruk yağdırıyor."

# game/Scenes/Tammy/tammy6.rpy:183
translate turkish tammy6_60c45283:

    # "Then with one final punch, it's all over."
    "Sonra son bir yumrukla her şey bitiyor."

# game/Scenes/Tammy/tammy6.rpy:184
translate turkish tammy6_f1a5240e:

    # "Chuck pulls her off of Sara, but Tammy's already realized that her opponent is out cold and has stopped throwing punches."
    "Chuck onu Sara'nın üstünden çekiyor, ama Tammy rakibinin bayıldığını çoktan fark etmiş ve yumruk atmayı bırakmış."

# game/Scenes/Tammy/tammy6.rpy:186
translate turkish tammy6_e2908206:

    # "Chuck leans down to check on Sara, while Tammy runs over to me and pulls me up to wrap her arms around me through the ropes."
    "Chuck, Sara’nın durumunu kontrol etmek için eğilirken, Tammy bana doğru koşar ve beni ayağa kaldırıp iplerin arasından kollarıyla sarılır."

# game/Scenes/Tammy/tammy6.rpy:187
translate turkish tammy6_ab84ef87:

    # pc "You did great!"
    pc "Harika iş çıkardın!"

# game/Scenes/Tammy/tammy6.rpy:188
translate turkish tammy6_c308982e:

    # tm "Wouldn't have been able to without you. Thanks so much."
    tm "Sen olmasaydın başaramazdım. Çok teşekkürler."

# game/Scenes/Tammy/tammy6.rpy:190
