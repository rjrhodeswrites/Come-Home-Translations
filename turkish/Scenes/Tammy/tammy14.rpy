# game/Scenes/Tammy/tammy14.rpy:18
translate turkish tammy14_7a4e2492:

    # "I'm getting ready for bed, in the kitchen filling a glass with water, when the front door suddenly bursts open."
    "Yatmaya hazırlanıyorum, mutfakta bir bardağa su doldururken, aniden ön kapı güm diye açılıyor."

# game/Scenes/Tammy/tammy14.rpy:19
translate turkish tammy14_173b7903:

    # "Tammy and Suzy stomp in, talking loudly."
    "Tammy ve Suzy içeri girip yüksek sesle konuşuyorlar."

# game/Scenes/Tammy/tammy14.rpy:20
translate turkish tammy14_ac6f9215:

    # tm "... stupid fuck, I'm gonna kick his ass!"
    tm "... aptal pislik, onu fena halde pataklayacağım!"

# game/Scenes/Tammy/tammy14.rpy:21
translate turkish tammy14_6284e2b4:

    # ss "You can't do that, baby."
    ss "Bunu yapamazsın, bebeğim."

# game/Scenes/Tammy/tammy14.rpy:22
translate turkish tammy14_56984c71:

    # tm "Yeah I can. He's bigger, but I can take him down and break his arm."
    tm "Evet, yapabilirim. O benden iri ama onu yere serip kolunu kırabilirim."

# game/Scenes/Tammy/tammy14.rpy:23
translate turkish tammy14_37a2cc30:

    # ss "No, I mean you can't, you'll go to jail."
    ss "Hayır, yapamazsın demek istedim, hapse girersin."

# game/Scenes/Tammy/tammy14.rpy:24
translate turkish tammy14_08d01644:

    # tm "I don't care! {i}He{/i} should be in jail!"
    tm "Umurumda değil! {i}O{/i} hapiste olmalı!"

# game/Scenes/Tammy/tammy14.rpy:27
translate turkish tammy14_1c2669de:

    # ss "I know, but you can't do anything about that."
    ss "Biliyorum ama bu konuda yapabileceğin bir şey yok."

# game/Scenes/Tammy/tammy14.rpy:28
translate turkish tammy14_98f83cc0:

    # tm "I just don't know what to do. I can't go back there."
    tm "Ne yapacağımı bilmiyorum. Oraya geri dönemem."

# game/Scenes/Tammy/tammy14.rpy:31
translate turkish tammy14_7704ce42:

    # sp "Is everything okay?"
    sp "Her şey yolunda mı?"

# game/Scenes/Tammy/tammy14.rpy:32
translate turkish tammy14_dbcf64d2:

    # ss "Her step-dad is being awful again."
    ss "Üvey babası yine çok kötü davranıyor."

# game/Scenes/Tammy/tammy14.rpy:33
translate turkish tammy14_c999da2a:

    # tm "I'm sorry if I woke you up, Lisa. We'll be quieter."
    tm "Uyandırdıysam özür dilerim Lisa. Daha sessiz olacağız."

# game/Scenes/Tammy/tammy14.rpy:36
translate turkish tammy14_34283699:

    # sp "Oh, no honey, I just want to make sure you're okay."
    sp "Hayır tatlım, sadece iyi olup olmadığını kontrol etmek istedim."

# game/Scenes/Tammy/tammy14.rpy:37
translate turkish tammy14_cf7fba88:

    # sp "Are you okay?"
    sp "İyi misin?"

# game/Scenes/Tammy/tammy14.rpy:38
translate turkish tammy14_71ed8e31:

    # "At that point, Tammy's tough exterior shatters."
    "O anda, Tammy’nin sert görünüşü paramparça olur."

# game/Scenes/Tammy/tammy14.rpy:42
translate turkish tammy14_4c6ab0b0:

    # tm "No, I'm not okay."
    tm "Hayır, iyi değilim."

# game/Scenes/Tammy/tammy14.rpy:43
translate turkish tammy14_8a3ebac6:

    # tm "I wish my mom would leave him, but I don't know if she ever will."
    tm "Keşke annem ondan ayrılsa, ama ayrılacak mı bilmiyorum."

# game/Scenes/Tammy/tammy14.rpy:44
translate turkish tammy14_ceb95749:

    # tm "He's so awful. I don't ever want to go back there."
    tm "O çok kötü. Oraya bir daha asla dönmek istemiyorum."

# game/Scenes/Tammy/tammy14.rpy:45
translate turkish tammy14_b95023cd:

    # ss "I've been telling her that she can move in with us, Mom."
    ss "Ona bizimle birlikte yaşayabileceğini söylüyorum, anne."

# game/Scenes/Tammy/tammy14.rpy:48
translate turkish tammy14_6d319373:

    # sp "You should, honey. You need to get out of that environment."
    sp "Öyle yapmalısın, tatlım. O ortamdan uzaklaşman gerekiyor."

# game/Scenes/Tammy/tammy14.rpy:49
translate turkish tammy14_3fad3cef:

    # sp "You could stay in Suzy's room, or you could set up down in the basement, if you'd rather have your own space."
    sp "Suzy’nin odasında kalabilirsin ya da kendi alanını tercih edersen bodrumda bir yer ayarlayabilirsin."

# game/Scenes/Tammy/tammy14.rpy:50
translate turkish tammy14_2f672715:

    # sp "Either way, we'd love to have you here."
    sp "Her halükarda, seni burada ağırlamaktan mutluluk duyarız."

# game/Scenes/Tammy/tammy14.rpy:51
translate turkish tammy14_1c64185f:

    # tm "Really? I wouldn't be a burden?"
    tm "Gerçekten mi? Yük olmaz mıyım?"

# game/Scenes/Tammy/tammy14.rpy:52
translate turkish tammy14_08156915:

    # sp "No, honey, you'd never be a burden. I love you."
    sp "Hayır, tatlım, asla yük olmazsın. Seni seviyorum."

# game/Scenes/Tammy/tammy14.rpy:55
translate turkish tammy14_24587f81:

    # tm "God, I wish you were my mom. You're the best ever."
    tm "Tanrım, keşke sen annem olsaydın. Sen dünyanın en iyisisin."

# game/Scenes/Tammy/tammy14.rpy:56
translate turkish tammy14_6511bc47:

    # sp "I've made my share of mistakes too. It's hard to get out of them sometimes."
    sp "Ben de payıma düşen hataları yaptım. Bazen onlardan kurtulmak zor oluyor."

# game/Scenes/Tammy/tammy14.rpy:57
translate turkish tammy14_80ccefda:

    # sp "Hopefully your mom will come around eventually."
    sp "Umarım annen eninde sonunda fikrini değiştirir."

# game/Scenes/Tammy/tammy14.rpy:58
translate turkish tammy14_4207618e:

    # sp "Until then, why don't you stay here, please?"
    sp "O zamana kadar, lütfen burada kalmaya ne dersin?"

# game/Scenes/Tammy/tammy14.rpy:61
translate turkish tammy14_457c6c40:

    # tm "You're serious, then?"
    tm "Ciddi misin peki?"

# game/Scenes/Tammy/tammy14.rpy:62
translate turkish tammy14_11137790:

    # sp "Absolutely."
    sp "Kesinlikle."

# game/Scenes/Tammy/tammy14.rpy:65
translate turkish tammy14_b63b6db1:

    # tm "And you two don't mind? I won't be getting in the way here?"
    tm "Peki siz ikiniz için sorun olmaz mı? Burada ayak altında dolaşmayacağım, değil mi?"

# game/Scenes/Tammy/tammy14.rpy:66
translate turkish tammy14_2a08fdcb:

    # ss "Of course not, dummy! I've been trying to get you to move in for months!"
    ss "Tabii ki hayır, şapşal! Aylardır seni buraya taşınmaya ikna etmeye çalışıyorum!"

# game/Scenes/Tammy/tammy14.rpy:67
translate turkish tammy14_68c0a7e7:

    # pc "I don't mind at all."
    pc "Hiç sorun değil."

# game/Scenes/Tammy/tammy14.rpy:68
translate turkish tammy14_0ba1ce31:

    # tm "Okay. I'll move in."
    tm "Tamam. Taşınacağım."

# game/Scenes/Tammy/tammy14.rpy:69
translate turkish tammy14_8d935799:

    # tm "Just for a while. Until things settle down."
    tm "Sadece bir süreliğine. İşler yoluna girene kadar."

# game/Scenes/Tammy/tammy14.rpy:70
translate turkish tammy14_7b787768:

    # sp "However long you need, honey."
    sp "Ne kadar süreye ihtiyacın olursa olsun, tatlım."

# game/Scenes/Tammy/tammy14.rpy:73
translate turkish tammy14_a723e4f9:

    # tm "Thank you so much!"
    tm "Çok teşekkür ederim!"

# game/Scenes/Tammy/tammy14.rpy:74
translate turkish tammy14_5cee14df:

    # tm "I'll go get my stuff tomorrow while he's at work. There's not much."
    tm "Yarın o işteyken eşyalarımı almaya gideceğim. Fazla bir şey yok."

# game/Scenes/Tammy/tammy14.rpy:75
translate turkish tammy14_c31d0d41:

    # tm "And I'll pay you rent too."
    tm "Ve sana kira da ödeyeceğim."

# game/Scenes/Tammy/tammy14.rpy:76
translate turkish tammy14_380d34b5:

    # sp "That's not necessary. Save your money, okay?"
    sp "Gerek yok. Paranı biriktir, tamam mı?"

# game/Scenes/Tammy/tammy14.rpy:77
translate turkish tammy14_03746258:

    # sp "Just focus on yourself for a while."
    sp "Bir süreliğine sadece kendine odaklan."

# game/Scenes/Tammy/tammy14.rpy:79
translate turkish tammy14_01c8cdc6:

    # "I know that Lisa is struggling to pay all the bills. Even then, she wouldn't accept payment for helping Tammy."
    "Lisa’nın tüm faturaları ödemekte zorlandığını biliyorum. Öyle olsa bile, Tammy’ye yardım ettiği için para kabul etmezdi."

# game/Scenes/Tammy/tammy14.rpy:80
translate turkish tammy14_423f725c:

    # "It just isn't in her nature."
    "Bu onun doğasında yok."

# game/Scenes/Tammy/tammy14.rpy:82
translate turkish tammy14_06e37fea:

    # "With all the money in the safe, Lisa would not have to worry about bills anymore. At least, not for a long time."
    "Kasadaki onca parayla, Lisa artık faturalar konusunda endişelenmek zorunda kalmazdı. En azından uzun bir süre için."

# game/Scenes/Tammy/tammy14.rpy:85
translate turkish tammy14_a7518ba2:

    # sp "Now, I have to get to bed. Work in the morning."
    sp "Şimdi yatmam lazım. Sabah işim var."

# game/Scenes/Tammy/tammy14.rpy:86
translate turkish tammy14_6bfe5e7b:

    # sp "Let me know if you need anything though."
    sp "Bir şeye ihtiyacın olursa haber ver."

# game/Scenes/Tammy/tammy14.rpy:87
translate turkish tammy14_2d169360:

    # tm "Okay. Thanks again, Lisa."
    tm "Tamam. Tekrar teşekkürler, Lisa."

# game/Scenes/Tammy/tammy14.rpy:88
translate turkish tammy14_dfbbd1a7:

    # sp "Good night, you three."
    sp "İyi geceler, siz üçüne."

# game/Scenes/Tammy/tammy14.rpy:89
translate turkish tammy14_092737ee:

    # ss "Good night, Mom!"
    ss "İyi geceler, anne!"

# game/Scenes/Tammy/tammy14.rpy:90
translate turkish tammy14_ffdf8a5b:

    # tm "Good night, Mom!"
    tm "İyi geceler, anne!"

# game/Scenes/Tammy/tammy14.rpy:91
translate turkish tammy14_da82243e:

    # pc "Good night, [mom]!"
    pc "İyi geceler, [mom]!"

# game/Scenes/Tammy/tammy14.rpy:94
translate turkish tammy14_d79ef8d0:

    # tm "Well, I guess you got a new roommate."
    tm "Eh, sanırım yeni bir oda arkadaşın oldu."

# game/Scenes/Tammy/tammy14.rpy:95
translate turkish tammy14_d9ac07ff:

    # ss "Yay! I'm so glad you finally gave in!"
    ss "Yaşasın! Sonunda pes ettiğine çok sevindim!"

# game/Scenes/Tammy/tammy14.rpy:96
translate turkish tammy14_a522539f:

    # ss "Do you feel a little better now?"
    ss "Şimdi biraz daha iyi hissediyor musun?"

# game/Scenes/Tammy/tammy14.rpy:97
translate turkish tammy14_282d6942:

    # tm "A little, yeah. Your mom is so nice."
    tm "Biraz, evet. Annen çok iyi biri."

# game/Scenes/Tammy/tammy14.rpy:98
translate turkish tammy14_13fb3cd3:

    # pc "Do you want to talk about what happened?"
    pc "Olanları konuşmak ister misin?"

# game/Scenes/Tammy/tammy14.rpy:101
translate turkish tammy14_9bd84187:

    # tm "Ugh, not really. Just my step-dad being a toolbag again."
    tm "Of, pek değil. Üvey babam yine tam bir ahmak gibi davrandı."

# game/Scenes/Tammy/tammy14.rpy:102
translate turkish tammy14_a309b747:

    # ss "One of his friends saw me and Tammy kissing at the ice cream parlor the other day and told him."
    ss "Geçen gün dondurmacıda bir arkadaşı beni ve Tammy'yi öpüşürken görmüş ve ona söylemiş."

# game/Scenes/Tammy/tammy14.rpy:103
translate turkish tammy14_7b955f80:

    # ss "And now he's gone all strict mode, calling her names and yelling at her mom for \"raising a dyke.\""
    ss "Şimdi de birdenbire katı bir tavır takındı, ona hakaretler yağdırıyor ve annesine \"lezbiyen yetiştirdiği\" için bağırıyor."

# game/Scenes/Tammy/tammy14.rpy:104
translate turkish tammy14_9d57193f:

    # pc "Fuck, that's awful. I'm sorry."
    pc "Kahretsin, bu çok kötü. Üzüldüm."

# game/Scenes/Tammy/tammy14.rpy:105
translate turkish tammy14_9f68ab72:

    # tm "It's fine. I don't care if he calls me names. But he treats my mom like shit too and she just takes it."
    tm "Sorun değil. Bana hakaret etmesi umurumda değil. Ama anneme de çok kötü davranıyor ve annem de bunu sessizce kabul ediyor."

# game/Scenes/Tammy/tammy14.rpy:106
translate turkish tammy14_d9857395:

    # tm "And I got fed up with it tonight and got in his face."
    tm "Ve bu gece artık bıktım, yüzüne karşı çıktım."

# game/Scenes/Tammy/tammy14.rpy:109
translate turkish tammy14_c6134a41:

    # tm "He actually put his hands on me. I didn't mean to, but I reacted by putting him in an armbar."
    tm "Aslında bana el kaldırdı. Niyetim o değildi ama tepki olarak ona kol kilidi yaptım."

# game/Scenes/Tammy/tammy14.rpy:110
translate turkish tammy14_050d517c:

    # tm "Then my mom hit me and yelled at me to get off of him... so I let him go."
    tm "Sonra annem bana vurdu ve ondan uzaklaşmam için bağırdı... ben de onu bıraktım."

# game/Scenes/Tammy/tammy14.rpy:111
translate turkish tammy14_087ad477:

    # tm "And I left."
    tm "Ve oradan ayrıldım."

# game/Scenes/Tammy/tammy14.rpy:112
translate turkish tammy14_14e5199b:

    # tm "I should have broke his fucking arm."
    tm "O lanet kolunu kırmalıydım."

# game/Scenes/Tammy/tammy14.rpy:113
translate turkish tammy14_33602524:

    # ss "No, you shouldn't have. You did good."
    ss "Hayır, kırmamalıydın. Doğru yaptın."

# game/Scenes/Tammy/tammy14.rpy:114
translate turkish tammy14_7e6cd6fb:

    # tm "It was so hard to hold back."
    tm "Kendimi tutmak çok zordu."

# game/Scenes/Tammy/tammy14.rpy:115
translate turkish tammy14_823afdc5:

    # pc "I'm sorry you're having to deal with all that. That sucks."
    pc "Tüm bunlarla uğraşmak zorunda kaldığın için üzgünüm. Çok kötü bir durum."

# game/Scenes/Tammy/tammy14.rpy:116
translate turkish tammy14_1bc3d8ea:

    # pc "If I could help with anything, you just have to ask, you know?"
    pc "Eğer herhangi bir konuda yardımcı olabilirsem, sadece söylemen yeterli, tamam mı?"

# game/Scenes/Tammy/tammy14.rpy:119
translate turkish tammy14_db58cf54:

    # tm "Want to make some popcorn? I kinda want to just chill and watch a movie or something."
    tm "Biraz patlamış mısır yapar mısın? Biraz rahatlayıp film falan izlemek istiyorum."

# game/Scenes/Tammy/tammy14.rpy:120
translate turkish tammy14_230676b3:

    # pc "I think I can manage that."
    pc "Sanırım bunu halledebilirim."

# game/Scenes/Tammy/tammy14.rpy:123
translate turkish tammy14_7fcae3d7:

    # "I go to the kitchen and make us a big bowl of popcorn and some drinks."
    "Mutfağa gidip bize kocaman bir kase patlamış mısır ve içecekler hazırlıyorum."

# game/Scenes/Tammy/tammy14.rpy:126
translate turkish tammy14_8774a9ea:

    # "And a few minutes later, we sit together on the couch, watching a movie."
    "Birkaç dakika sonra, kanepede yan yana oturup film izliyoruz."

# game/Scenes/Tammy/tammy14.rpy:127
translate turkish tammy14_8e0bf432:

    # ss "What is this anyway? The acting is so bad."
    ss "Bu ne böyle ki? Oyunculuk çok kötü."

# game/Scenes/Tammy/tammy14.rpy:128
translate turkish tammy14_4a5effb9:

    # tm "We're not watching it for the acting. We're watching it because Donnie Yen and Cynthia Khan are badasses."
    tm "Oyunculuk için izlemiyoruz ki. Donnie Yen ve Cynthia Khan çok havalı olduğu için izliyoruz."

# game/Scenes/Tammy/tammy14.rpy:129
translate turkish tammy14_1915a42f:

    # ss "Could they be badasses who can act?"
    ss "Hem havalı hem de iyi oynayanlar olabilir mi?"

# game/Scenes/Tammy/tammy14.rpy:132
translate turkish tammy14_636b6f2c:

    # tm "Donnie Yen can act! We watched Ip Man, remember?"
    tm "Donnie Yen iyi oynar! Ip Man'i izlemiştik, hatırladın mı?"

# game/Scenes/Tammy/tammy14.rpy:133
translate turkish tammy14_f27e8653:

    # ss "Is that the one with the guy who fought with the big caligraphy brush?"
    ss "O, büyük kaligrafi fırçasıyla dövüşen adamın olduğu film mi?"

# game/Scenes/Tammy/tammy14.rpy:134
translate turkish tammy14_17b93ba5:

    # tm "No, that was Tony Leung in Hero. Donnie Yen was in that too though. He had that badass fight in the courtyard with Jet Li."
    tm "Hayır, o Hero’daki Tony Leung’du. Gerçi Donnie Yen de o filmde oynuyordu. Jet Li ile avluda o havalı dövüş sahnesini yapmıştı."

# game/Scenes/Tammy/tammy14.rpy:135
translate turkish tammy14_00ddbddc:

    # ss "I don't remember. The acting in that one was pretty good though."
    ss "Hatırlamıyorum. Gerçi o filmdeki oyunculuk oldukça iyiydi."

# game/Scenes/Tammy/tammy14.rpy:138
translate turkish tammy14_b5dbc1b2:

    # "We eat popcorn and chat and cuddle throughout the whole movie."
    "Film boyunca patlamış mısır yiyip, sohbet edip, birbirimize sarılıyoruz."

# game/Scenes/Tammy/tammy14.rpy:139
translate turkish tammy14_7e9fe87d:

    # "It's nice to just spend time with the girls and relax. I think Tammy needed that."
    "Kızlarla vakit geçirmek ve rahatlamak çok güzel. Bence Tammy'nin buna ihtiyacı vardı."

# game/Scenes/Tammy/tammy14.rpy:140
translate turkish tammy14_6459b26b:

    # "By the time the movie is over, all three of us are tired and ready for bed."
    "Film bittiğinde üçümüz de yorgun ve yatmaya hazırız."

# game/Scenes/Tammy/tammy14.rpy:143
translate turkish tammy14_f0ea57e0:

    # "Sleeping arrangements are not even discussed. All three of us go to my bed together."
    "Kimin nerede yatacağı konusu bile tartışılmıyor. Üçümüz birlikte benim yatağıma gidiyoruz."

# game/Scenes/Tammy/tammy14.rpy:144
translate turkish tammy14_8f8ef515:

    # "Both Suzy and I wrap our arms around Tammy, holding her close."
    "Hem Suzy hem de ben kollarımızı Tammy'nin etrafına dolayarak onu sıkıca sarıyoruz."

# game/Scenes/Tammy/tammy14.rpy:145
translate turkish tammy14_ca686a0f:

    # ss "You know you're loved, right?"
    ss "Sevildiğini biliyorsun, değil mi?"

# game/Scenes/Tammy/tammy14.rpy:146
translate turkish tammy14_dda6128b:

    # tm "Yeah. I love you too."
    tm "Evet. Ben de seni seviyorum."

# game/Scenes/Tammy/tammy14.rpy:147
translate turkish tammy14_02e5361e:

    # tm "Both of you."
    tm "İkinizi de."

# game/Scenes/Tammy/tammy14.rpy:148
translate turkish tammy14_5346a3b9:

    # tm "Thanks for tonight."
    tm "Bu gece için teşekkürler."

# game/Scenes/Tammy/tammy14.rpy:151
translate turkish tammy14_b5ba8a4e:

    # pc "Any time you need anything, I'll be here for you."
    pc "Ne zaman bir şeye ihtiyacın olursa, ben senin için burada olacağım."

# game/Scenes/Tammy/tammy14.rpy:152
translate turkish tammy14_68ef5b0d:

    # tm "Thanks, [pcname]. Really."
    tm "Teşekkürler, [pcname]. Gerçekten."

# game/Scenes/Tammy/tammy14.rpy:153
translate turkish tammy14_450f2c68:

    # tm "You guys mean the world to me."
    tm "Sizler benim için her şeysiniz."

# game/Scenes/Tammy/tammy14.rpy:156
translate turkish tammy14_0aaa364a:

    # tm "Ahh! You're squishing me!"
    tm "Ahh! Beni eziyorsun!"

# game/Scenes/Tammy/tammy14.rpy:157
translate turkish tammy14_ee137836:

    # ss "Good! Squish her, [bro]! Squish her!"
    ss "Güzel! Ez onu, [bro]! Ez onu!"

# game/Scenes/Tammy/tammy14.rpy:158
translate turkish tammy14_c86d70b8:

    # tm "You're such a dork! I'm going to pinch your nipples off!"
    tm "Ne salaksın sen! Meme uçlarını koparacağım!"

# game/Scenes/Tammy/tammy14.rpy:159
translate turkish tammy14_08d29a8b:

    # ss "Don't threaten me with a good time!"
    ss "Bana eğlenmekle tehdit etme!"

# game/Scenes/Tammy/tammy14.rpy:162
translate turkish tammy14_3ce42e73:

    # tm "Haha, I'm too tired for this right now."
    tm "Haha, şu anda bunun için çok yorgunum."

# game/Scenes/Tammy/tammy14.rpy:163
translate turkish tammy14_a37cc2d4:

    # ss "Yeah, me too."
    ss "Evet, ben de."

# game/Scenes/Tammy/tammy14.rpy:166
translate turkish tammy14_7019ac31:

    # tm "But there will be plenty of chances for us to mess around with me living here now, I guess."
    tm "Ama artık burada yaşadığım için, sanırım eğlenmek için bolca fırsatımız olacak."

# game/Scenes/Tammy/tammy14.rpy:167
translate turkish tammy14_ebcc9f51:

    # ss "It's so sexy, all three of us being able to sleep together like this any night we want to."
    ss "İstediğimiz her gece üçümüzün böyle birlikte uyuyabilmesi çok seksi."

# game/Scenes/Tammy/tammy14.rpy:168
translate turkish tammy14_494fc97b:

    # pc "Yeah, it's amazing."
    pc "Evet, harika bir şey."

# game/Scenes/Tammy/tammy14.rpy:171
translate turkish tammy14_e8b49386:

    # "It doesn't take long, lying like that, for Tammy to fall asleep."
    "O şekilde uzanınca, Tammy'nin uykuya dalması uzun sürmüyor."

# game/Scenes/Tammy/tammy14.rpy:172
translate turkish tammy14_815d66b7:

    # "And as soon as she's asleep, she immediately begins snoring loudly."
    "Ve uykuya dalar dalmaz, hemen yüksek sesle horlamaya başlıyor."

# game/Scenes/Tammy/tammy14.rpy:175
translate turkish tammy14_055d080f:

    # ss "Dang, she's loud, huh?"
    ss "Vay be, sesi çok yüksek, değil mi?"

# game/Scenes/Tammy/tammy14.rpy:176
translate turkish tammy14_593f6724:

    # "I nod, trying to stay quiet."
    "Sessiz kalmaya çalışarak başımı sallıyorum."

# game/Scenes/Tammy/tammy14.rpy:177
translate turkish tammy14_536bf33b:

    # ss "When she's really tired like this, she passes out hard. You could shake her and she's not going to wake up."
    ss "Böyle çok yorgun olduğunda, derin bir uykuya dalıyor. Onu sallasan bile uyanmaz."

# game/Scenes/Tammy/tammy14.rpy:178
translate turkish tammy14_20e84dbf:

    # pc "She deserves a good night sleep."
    pc "İyi bir gece uykusunu hak ediyor."

# game/Scenes/Tammy/tammy14.rpy:179
translate turkish tammy14_e51a7dc2:

    # ss "Yeah. Thanks for being a good boyfriend tonight, [bro]."
    ss "Evet. Bu gece iyi bir erkek arkadaş olduğun için teşekkürler, [bro]."

# game/Scenes/Tammy/tammy14.rpy:180
translate turkish tammy14_a248948f:

    # pc "Of course."
    pc "Tabii ki."

# game/Scenes/Tammy/tammy14.rpy:181
translate turkish tammy14_53a16996:

    # ss "Love you."
    ss "Seni seviyorum."

# game/Scenes/Tammy/tammy14.rpy:182
translate turkish tammy14_3213fe29:

    # pc "Love you too, [sis]."
    pc "Ben de seni seviyorum, [sis]."

# game/Scenes/Tammy/tammy14.rpy:185
translate turkish tammy14_87d1006f:

    # "Suzy lies back down again and falls asleep."
    "Suzy tekrar uzanıyor ve uykuya dalıyor."

# game/Scenes/Tammy/tammy14.rpy:188
translate turkish tammy14_da5d00b9:

    # "Shortly after, despite Tammy's loud snoring, I fall asleep too."
    "Kısa bir süre sonra, Tammy'nin yüksek sesli horlamasına rağmen ben de uykuya dalıyorum."

# game/Scenes/Tammy/tammy14.rpy:189
translate turkish tammy14_2af8e2e3:

    # "I have great dreams all night, but somehow they don't even compare to my waking life."
    "Bütün gece harika rüyalar görüyorum, ama nedense uyanık hayatımla kıyaslanamazlar bile."

# game/Scenes/Tammy/tammy14.rpy:192
translate turkish tammy14_d8050fd9:

    # "I must have slept hard as well, because I don't wake up through the entire night."
    "Çok derin uyumuş olmalıyım ki, bütün gece boyunca uyanmıyorum."

# game/Scenes/Tammy/tammy14.rpy:195
translate turkish tammy14_6e97274e:

    # "And when I look around in the morning, they are both gone."
    "Sabah etrafa baktığımda ikisi de gitmiş."

# game/Scenes/Tammy/tammy14.rpy:201
translate turkish tammy14_d1a14932:

    # "I get up and go to the bathroom, then walk downstairs."
    "Kalkıp tuvalete gidiyorum, sonra aşağı iniyorum."

# game/Scenes/Tammy/tammy14.rpy:204
translate turkish tammy14_7279822b:

    # "In the dining room, Suzy greets me with a kiss."
    "Yemek odasında Suzy beni bir öpücükle karşılıyor."

# game/Scenes/Tammy/tammy14.rpy:205
translate turkish tammy14_ce46d3ed:

    # ss "There's some breakfast in the kitchen if you want any. Mom made way too much before she left."
    ss "İstersen mutfakta kahvaltılık bir şeyler var. Annem çıkmadan önce çok fazla hazırlamış."

# game/Scenes/Tammy/tammy14.rpy:206
translate turkish tammy14_03e500eb:

    # pc "Where's Tammy?"
    pc "Tammy nerede?"

# game/Scenes/Tammy/tammy14.rpy:207
translate turkish tammy14_6a080cce:

    # ss "She had to leave early for work. I doubt we'll be seeing her for breakfast very often."
    ss "İşe erken gitmek zorunda kaldı. Kahvaltıda onu çok sık göreceğimizi sanmıyorum."

# game/Scenes/Tammy/tammy14.rpy:208
translate turkish tammy14_34f75a54:

    # pc "Oh, okay."
    pc "Ah, tamam."

# game/Scenes/Tammy/tammy14.rpy:211
translate turkish tammy14_eef7b49f:

    # ss "Did you want to eat breakfast with me... or maybe mess around some?"
    ss "Benimle kahvaltı etmek mi istiyordun... yoksa biraz vakit geçirmek mi?"

# game/Scenes/Tammy/tammy14.rpy:215
translate turkish tammy14_6ae50746:

    # ss "Oh, alright then."
    ss "Ah, peki o zaman."

# game/Scenes/Tammy/tammy14.rpy:218
translate turkish tammy14_b9e9893b:

    # ss "I was hoping you would say that."
    ss "Öyle demeni umuyordum."

# game/Scenes/Tammy/tammy14.rpy:222
translate turkish tammy14_ca91b2cf:

    # ss "Oh, okay. See you later then, [bro]."
    ss "Ah, tamam. Görüşürüz o zaman, [bro]."

translate turkish strings:

    # game/Scenes/Tammy/tammy14.rpy:2
    old "After you have gone out on a few dates with Tammy and Suzy together, including going to the ice-cream parlor,"
    new "Tammy ve Suzy ile birlikte birkaç kez dışarı çıktıktan sonra, dondurmacıya gitmek de dahil olmak üzere,"

    # game/Scenes/Tammy/tammy14.rpy:3
    old "and you have talked to them about Tammy moving out of her parents house, this will happen automatically at home at night."
    new "ve Tammy'nin ailesinin evinden taşınması hakkında onlarla konuştuktan sonra, bu durum gece evde otomatik olarak gerçekleşecek."

