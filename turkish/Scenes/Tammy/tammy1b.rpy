# game/Scenes/Tammy/tammy1b.rpy:11
translate turkish tammy1b_e3683166:

    # "Tammy is supposed to be here, so I park and walk up to the boxing club."
    "Tammy'nin burada olması gerekiyordu, ben de arabayı park edip boks kulübüne doğru yürüdüm."

# game/Scenes/Tammy/tammy1b.rpy:12
translate turkish tammy1b_645ac8a9:

    # "The place is not very busy, with only a few people training."
    "Mekan pek kalabalık değildi, sadece birkaç kişi antrenman yapıyordu."

# game/Scenes/Tammy/tammy1b.rpy:13
translate turkish tammy1b_4394a883:

    # "As soon as I walk in, all eyes turn to me though. They stare at me, unwelcoming."
    "İçeri girer girmez tüm gözler bana çevrildi. Hoş karşılanmadığımı hissettirecek şekilde bana bakıyorlardı."

# game/Scenes/Tammy/tammy1b.rpy:14
translate turkish tammy1b_29926d95:

    # "Until Tammy speaks up."
    "Ta ki Tammy konuşana kadar."

# game/Scenes/Tammy/tammy1b.rpy:17
translate turkish tammy1b_9f753069:

    # tm "Don't worry guys, he's with me."
    tm "Merak etmeyin çocuklar, o benimle birlikte."

# game/Scenes/Tammy/tammy1b.rpy:18
translate turkish tammy1b_671e6fc9:

    # tm "Hey, [pcname]. Glad you came. Ready to get your workout on?"
    tm "Selam, [pcname]. Geldiğine sevindim. Antrenmana hazır mısın?"

# game/Scenes/Tammy/tammy1b.rpy:19
translate turkish tammy1b_bcae12a9:

    # pc "Sure, let's do this."
    pc "Tabii, hadi yapalım."

# game/Scenes/Tammy/tammy1b.rpy:20
translate turkish tammy1b_249f802e:

    # tm "Locker room is in the back. Go change into your workout gear and meet me by the bench press."
    tm "Soyunma odası arkada. Gidip spor kıyafetlerini giy ve beni bench press'in yanında bekle."

# game/Scenes/Tammy/tammy1b.rpy:23
translate turkish tammy1b_9d33ab78:

    # "I do as she says and head to the locker room in the back of the place. I change into my gym shorts and a muscle shirt and walk back up front to join her."
    "Dediği gibi yapıp mekanın arkasındaki soyunma odasına gidiyorum. Spor şortumu ve kas tişörtümü giyip ona katılmak için öne geri yürüyorum."

# game/Scenes/Tammy/tammy1b.rpy:26
translate turkish tammy1b_5c6e9d09:

    # tm "Alright, looking good there, [pcname]. You're not in bad shape, but look like you could use a little more muscle."
    tm "Tamam, iyi görünüyorsun, [pcname]. Fizik olarak fena değilsin, ama biraz daha kas yapman gerekebilir gibi görünüyor."

# game/Scenes/Tammy/tammy1b.rpy:27
translate turkish tammy1b_40793a0e:

    # tm "How much do you lift?"
    tm "Ne kadar ağırlık kaldırıyorsun?"

# game/Scenes/Tammy/tammy1b.rpy:28
translate turkish tammy1b_cf4776aa:

    # pc "I'm not sure. I haven't been to the gym since high school."
    pc "Emin değilim. Liseden beri spor salonuna gitmedim."

# game/Scenes/Tammy/tammy1b.rpy:29
translate turkish tammy1b_68f22cd1:

    # tm "Wow, how do you keep a body like that without working out?"
    tm "Vay canına, egzersiz yapmadan böyle bir vücudu nasıl koruyorsun?"

# game/Scenes/Tammy/tammy1b.rpy:30
translate turkish tammy1b_a5cfcbe8:

    # pc "I don't know, just stay busy I guess?"
    pc "Bilmiyorum, sanırım sadece meşgul olmaktan kaynaklanıyor?"

# game/Scenes/Tammy/tammy1b.rpy:31
translate turkish tammy1b_ccc6b955:

    # tm "Well, good job on that."
    tm "Eh, bu konuda iyi iş çıkarmışsın."

# game/Scenes/Tammy/tammy1b.rpy:32
translate turkish tammy1b_4f70adfd:

    # tm "Here, spot me and I'll show you the proper way to do this, just as a reminder. Then we can figure out how much you can bench."
    tm "Gel, bana destek ol da sana bunu doğru şekilde nasıl yapacağını göstereyim, hatırlatma olsun diye. Sonra ne kadar bench press yapabileceğini hesaplayabiliriz."

# game/Scenes/Tammy/tammy1b.rpy:35
translate turkish tammy1b_c0d9e914:

    # "I stand over her while she demonstrates the proper bench press technique."
    "O doğru bench press tekniğini gösterirken ben onun yanında duruyorum."

# game/Scenes/Tammy/tammy1b.rpy:36
translate turkish tammy1b_806df103:

    # "She breathes in and out as she pushes the weight up and down, her triceps bulging."
    "Ağırlığı yukarı aşağı iterken nefes alıp veriyor, triceps kasları şişiyor."

# game/Scenes/Tammy/tammy1b.rpy:37
translate turkish tammy1b_e6fef3d7:

    # "Everything about Tammy is hard and tight - her whole body is a muscle for her to flex."
    "Tammy’nin her yeri sert ve sıkı – tüm vücudu, kaslarını gösterebileceği bir kas yığını."

# game/Scenes/Tammy/tammy1b.rpy:38
translate turkish tammy1b_33c443c8:

    # "When she has finished ten reps, I help her put the weight back on its hook."
    "On tekrar bitirdiğinde, ağırlığı kancasına geri koymasına yardım ediyorum."

# game/Scenes/Tammy/tammy1b.rpy:42
translate turkish tammy1b_c0183d90:

    # tm "Alright, now your turn."
    tm "Tamam, şimdi sıra sende."

# game/Scenes/Tammy/tammy1b.rpy:43
translate turkish tammy1b_4a711d57:

    # tm "Start with what I was lifting. You should be able to handle that, given how much bigger than me you are."
    tm "Benim kaldırdığım ağırlıkla başla. Benden ne kadar daha iri olduğunu düşünürsek, bunu halledebilmen gerekir."

# game/Scenes/Tammy/tammy1b.rpy:44
translate turkish tammy1b_63023601:

    # pc "Okay."
    pc "Tamam."

# game/Scenes/Tammy/tammy1b.rpy:47
translate turkish tammy1b_5ddf218a:

    # "We switch positions to where now I am on the bench and she is standing over me."
    "Pozisyonlarımızı değiştiriyoruz; şimdi ben bankta yatıyorum, o da üzerimde duruyor."

# game/Scenes/Tammy/tammy1b.rpy:48
translate turkish tammy1b_388a95d1:

    # "I imitate her technique and lift the weight."
    "Onun tekniğini taklit edip ağırlığı kaldırıyorum."

# game/Scenes/Tammy/tammy1b.rpy:49
translate turkish tammy1b_1d8c9a1b:

    # "I am surprised at how heavy it is. She hadn't seemed to have much trouble lifting it, but I find myself struggling."
    "Ağırlığın bu kadar ağır olmasına şaşırıyorum. O kaldırırken pek zorlanmamış gibi görünüyordu, ama ben zorlanıyorum."

# game/Scenes/Tammy/tammy1b.rpy:50
translate turkish tammy1b_0188fccb:

    # tm "Remember your breathing. Push."
    tm "Nefesini unutma. İt."

# game/Scenes/Tammy/tammy1b.rpy:51
translate turkish tammy1b_61239f96:

    # "I try to control my breathing, try to push myself. My muscles ache after only a few reps."
    "Nefesimi kontrol etmeye çalışıyorum, kendimi zorlamaya çalışıyorum. Sadece birkaç tekrarın ardından kaslarım ağrıyor."

# game/Scenes/Tammy/tammy1b.rpy:52
translate turkish tammy1b_d6ccb3fd:

    # "I keep pushing, barely making it to 10. Then she pulls the weight back onto the hook for me."
    "Zorlamaya devam ediyorum, zar zor 10'a ulaşıyorum. Sonra o, ağırlığı benim için kancaya geri asıyor."

# game/Scenes/Tammy/tammy1b.rpy:56
translate turkish tammy1b_37c438ac:

    # tm "Well you're definitely more out of shape than you look. We're going to need to do a lot more of this."
    tm "Göründüğünden çok daha formdan düşmüşsün. Bunu çok daha fazla yapmamız gerekecek."

# game/Scenes/Tammy/tammy1b.rpy:57
translate turkish tammy1b_cf997fe8:

    # pc "You're telling me. Man, I'm hurting."
    pc "Bana mı söylüyorsun? Tanrım, her yerim ağrıyor."

# game/Scenes/Tammy/tammy1b.rpy:58
translate turkish tammy1b_76be2251:

    # tm "Take a breather and then we'll get started on the other exercises."
    tm "Biraz nefes al, sonra diğer egzersizlere başlayalım."

# game/Scenes/Tammy/tammy1b.rpy:59
translate turkish tammy1b_2df16e27:

    # pc "Other?"
    pc "Diğer mi?"

# game/Scenes/Tammy/tammy1b.rpy:62
translate turkish tammy1b_e32e4b37:

    # tm "Uh, yeah. You can't just workout your arms. Gotta do the whole body."
    tm "Evet. Sadece kollarını çalıştıramazsın. Tüm vücudu çalıştırmalısın."

# game/Scenes/Tammy/tammy1b.rpy:65
translate turkish tammy1b_774f99cb:

    # "I take a rest, then we get back to it, moving around the gym to different areas to do a full-body workout."
    "Biraz dinleniyorum, sonra tekrar başlıyoruz; spor salonunda farklı alanlara geçerek tam vücut antrenmanı yapıyoruz."

# game/Scenes/Tammy/tammy1b.rpy:66
translate turkish tammy1b_07f4d546:

    # "By the end, I am exhausted. Tammy is sweating, but is feeling good. I feel like I might die."
    "Sonunda bitkin düşüyorum. Tammy terliyor ama kendini iyi hissediyor. Ben ölür gibi hissediyorum."

# game/Scenes/Tammy/tammy1b.rpy:69
translate turkish tammy1b_ecf18d91:

    # tm "You did good today for a first gym day in a long time."
    tm "Uzun zamandır ilk kez spor salonuna geldiğin bir gün için bugün iyi iş çıkardın."

# game/Scenes/Tammy/tammy1b.rpy:70
translate turkish tammy1b_bac72fc8:

    # tm "It'll get easier the more you do it. Then you'll have to start looking for new ways to build muscle."
    tm "Ne kadar çok yaparsan o kadar kolaylaşır. O zaman kas geliştirmek için yeni yollar aramaya başlaman gerekecek."

# game/Scenes/Tammy/tammy1b.rpy:71
translate turkish tammy1b_2643738c:

    # pc "I don't know about that."
    pc "O konuda emin değilim."

# game/Scenes/Tammy/tammy1b.rpy:72
translate turkish tammy1b_c1b44fe4:

    # tm "Well, I had fun today. You're a pretty good workout partner."
    tm "Eh, bugün eğlendim. Oldukça iyi bir antrenman partnerisin."

# game/Scenes/Tammy/tammy1b.rpy:73
translate turkish tammy1b_644168c9:

    # tm "Come back and do it again with me sometime. I'm here every afternoon."
    tm "Bir ara tekrar gelip benimle birlikte yap. Her öğleden sonra buradayım."

# game/Scenes/Tammy/tammy1b.rpy:74
translate turkish tammy1b_67cf3c55:

    # tm "Or you can come back by yourself. The guys will let you in, now that they know you're with me."
    tm "Ya da tek başına gelebilirsin. Artık benimle olduğunu bildiklerine göre çocuklar seni içeri alacaklar."

# game/Scenes/Tammy/tammy1b.rpy:75
translate turkish tammy1b_e43cb525:

    # pc "Okay, I'll do that."
    pc "Tamam, öyle yapacağım."

# game/Scenes/Tammy/tammy1b.rpy:76
translate turkish tammy1b_e4873b3d:

    # tm "Build up that muscle, [pcname]. Girls love it. You're looking real sexy with that post-workout shine."
    tm "Kaslarını geliştir, [pcname]. Kızlar buna bayılır. Egzersiz sonrası parıltınla gerçekten çok seksi görünüyorsun."

# game/Scenes/Tammy/tammy1b.rpy:79
translate turkish tammy1b_1df8eb68:

    # tm "Anyway, I gotta go shower and get to work."
    tm "Neyse, duş alıp işe gitmem lazım."

# game/Scenes/Tammy/tammy1b.rpy:80
translate turkish tammy1b_2c74ab1f:

    # tm "I'll see you later, [pcname]."
    tm "Sonra görüşürüz, [pcname]."

# game/Scenes/Tammy/tammy1b.rpy:81
translate turkish tammy1b_53fa2ef6:

    # pc "Okay, see ya."
    pc "Tamam, görüşürüz."

# game/Scenes/Tammy/tammy1b.rpy:84
translate turkish tammy1b_85f2c0dc:

    # "We head to the back, to separate showers."
    "Arkaya, ayrı duşlara yöneliyoruz."

# game/Scenes/Tammy/tammy1b.rpy:85
translate turkish tammy1b_43779587:

    # "By the time I am done washing up, she is already gone."
    "Ben yıkanmayı bitirene kadar o çoktan gitmiş."

# game/Scenes/Tammy/tammy1b.rpy:86
translate turkish tammy1b_00b69932:

    # "I leave the gym, my whole body sore, and get in my car."
    "Tüm vücudum ağrıyarak spor salonundan çıkıp arabama biniyorum."

translate turkish strings:

    # game/Scenes/Tammy/tammy1b.rpy:2
    old "Tammy wants you to meet her at the gym on the weekend."
    new "Tammy, hafta sonu spor salonunda buluşmanı istiyor."

    # game/Scenes/Tammy/tammy1b.rpy:3
    old "She'll be there during the morning and afternoon."
    new "Sabah ve öğleden sonra orada olacak."

