translate turkish tammy7_44df5233:

    # "She returns the kiss eagerly, holding on to me like she doesn't want to ever let go."
    "O da öpücüğü hevesle karşılık verir, sanki beni asla bırakmak istemiyormuş gibi bana sarılır."

# game/Scenes/Tammy/tammy7.rpy:155
translate turkish tammy7_3c91317b:

    # "But finally, she does."
    "Ama sonunda bırakır."

# game/Scenes/Tammy/tammy7.rpy:158
translate turkish tammy7_0326b7de:

    # tm "I'm never going to be able to get enough of that."
    tm "Buna doyamayacağım."

# game/Scenes/Tammy/tammy7.rpy:159
translate turkish tammy7_5a210eeb:

    # tm "But I need to go."
    tm "Ama gitmem lazım."

# game/Scenes/Tammy/tammy7.rpy:160
translate turkish tammy7_c219a352:

    # pc "Do you need a ride?"
    pc "Seni bırakayım mı?"

# game/Scenes/Tammy/tammy7.rpy:161
translate turkish tammy7_90f9f472:

    # tm "Nah, that's okay. My house is pretty close, I'll just run over there."
    tm "Hayır, gerek yok. Evim oldukça yakın, oraya kadar koşarım."

# game/Scenes/Tammy/tammy7.rpy:162
translate turkish tammy7_edad2437:

    # pc "Okay, see you later then."
    pc "Tamam, o zaman görüşürüz."

# game/Scenes/Tammy/tammy7.rpy:163
translate turkish tammy7_795eb20f:

    # tm "See ya, [pcname]."
    tm "Görüşürüz, [pcname]."

# game/Scenes/Tammy/tammy7.rpy:166
translate turkish tammy7_c72b26e9:

    # "What a day. I feel like I've learned more about her in the last hour than in all the other time that I've known her."
    "Ne gün ama. Onu tanıdığım tüm zaman boyunca öğrendiklerimden daha fazlasını son bir saatte öğrenmiş gibi hissediyorum."

# game/Scenes/Tammy/tammy7.rpy:167
translate turkish tammy7_537d36fc:

    # "And I really like her. And Suzy. And the idea of the two of them and me together."
    "Ve ondan gerçekten hoşlanıyorum. Suzy'den de. Ve ikisinin de benimle birlikte olması fikrinden."

# game/Scenes/Tammy/tammy7.rpy:168
translate turkish tammy7_ab930a7e:

    # "Just wow."
    "Vay canına."

translate turkish strings:

